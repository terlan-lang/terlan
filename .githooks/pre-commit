#!/usr/bin/env bash
set -euo pipefail
# Use the staged driver, including when its working copy is only partly staged.
driver=$(mktemp "$(git rev-parse --git-path pre-commit).XXXXXX")
trap 'rm -f "$driver"' EXIT
git show :scripts/git_hooks.sh > "$driver"
# Until the cumulative compiler baseline is green, local commits must execute
# the complete affected validation plan instead of deferring it to hosted CI.
TERLAN_HOOK_MODE=full bash "$driver" check
