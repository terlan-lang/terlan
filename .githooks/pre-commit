#!/usr/bin/env bash
set -euo pipefail
# Use the staged driver, including when its working copy is only partly staged.
driver=$(mktemp "$(git rev-parse --git-path pre-commit).XXXXXX")
trap 'rm -f "$driver"' EXIT
git show :scripts/git_hooks.sh > "$driver"
# Full admission remains the default until the repository has a green compiler
# baseline. An explicit fast mode is available only for workflows that already
# own complete candidate validation.
TERLAN_HOOK_MODE="${TERLAN_HOOK_MODE:-full}" bash "$driver" check
