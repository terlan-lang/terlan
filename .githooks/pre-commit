#!/usr/bin/env bash
set -euo pipefail
# Use the staged driver, including when its working copy is only partly staged.
driver=$(mktemp "$(git rev-parse --git-path pre-commit).XXXXXX")
trap 'rm -f "$driver"' EXIT
git show :scripts/git_hooks.sh > "$driver"
# Fast admission is the local default after a complete green compiler baseline.
# Release and hosted validation select full mode explicitly.
TERLAN_HOOK_MODE="${TERLAN_HOOK_MODE:-fast}" bash "$driver" check
