    repeat_fixed_header(1) and repeat_fixed_header(1) and repeat_fixed_header(1).

@test
pub fixed_header_protocol_benchmark_10_warm(): Bool ->
    repeat_fixed_header(10) and repeat_fixed_header(10) and repeat_fixed_header(10).

