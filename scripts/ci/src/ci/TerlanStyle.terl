/**
 * Selects the Terlan sources whose style contract changed.
 */
module ci.TerlanStyle.

import std.collections.List.
import std.core.String.

pub is_source(path: String): Bool ->
    not String.starts_with(path, "compiler/self_host/corpus/")
        and (String.ends_with(path, ".terl")
    or String.ends_with(path, ".terli")
    or String.ends_with(path, ".terls")).

pub sources(paths: List[String]): List[String] ->
    case paths {
        [] -> [];
        [path | rest] ->
            if {
                is_source(path) -> [path | sources(rest)];
                true -> sources(rest)
            }
    }.

pub select(changed: List[String], tracked: List[String], force_all: Bool): List[String] ->
    if {
        force_all -> sources(tracked);
        true -> sources(changed)
    }.

pub required(paths: List[String], force_all: Bool): Bool ->
    force_all or sources(paths) != [].

pub batch(paths: List[String], maximum: Int): {List[String], List[String]} ->
    batch_into(paths, maximum, []).

batch_into(
    paths: List[String],
    remaining: Int,
    mut selected: List[String],
): {List[String], List[String]} ->
    if {
        remaining <= 0 -> {selected, paths};
        true -> case paths {
            [] -> {selected, []};
            [path | rest] ->
                let _pushed = selected.push(path);
                batch_into(rest, remaining - 1, selected)
        }
    }.
