module ci.HostedFormattingContractTest.

import std.core.Result.{Ok}.
import std.core.String.
import std.io.File.

@test
pub local_and_hosted_formatting_share_changed_input_ownership(): Bool ->
    let {
        Ok(ci) <- File.read_text(".github/workflows/ci.yml");
        Ok(preflight) <- File.read_text(".github/workflows/source-preflight.yml");
        Ok(hook) <- File.read_text("scripts/git_hooks/check.sh");
        Ok(plan) <- File.read_text("scripts/git_hooks/src/git_hooks/Plan.terl")
    } else {
        _ -> false
    };
    String.contains(ci, "rust-format: \${{ steps.classify.outputs.rust-format }}")
        and String.contains(ci, "rust_format: \${{ needs.changes.outputs.rust-format == 'true' }}")
        and String.contains(preflight, "if: \${{ inputs.rust_format }}")
        and String.contains(preflight, "scripts/ci/scripts/CheckRustFormatting.terls")
        and String.contains(hook, "CheckRustFormatting.terls -- --paths-file \"$changes\"")
        and String.contains(plan, "RustFormatting.required(paths, false)")
        and not String.contains(preflight, "cargo fmt --all")
        and not String.contains(hook, "cargo fmt --all").
