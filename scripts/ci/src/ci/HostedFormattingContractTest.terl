module ci.HostedFormattingContractTest.

import std.core.Result.{Ok}.
import std.core.String.
import std.io.File.

@test
pub local_and_hosted_formatting_share_changed_input_ownership(): Bool ->
    let {
        Ok(ci) <- File.read_text(".github/workflows/ci.yml");
        Ok(preflight) <- File.read_text(".github/workflows/source-preflight.yml");
        Ok(runner) <- File.read_text(".github/actions/setup-terlan-script-runner/action.yml");
        Ok(hook) <- File.read_text("scripts/git_hooks/check.sh");
        Ok(plan) <- File.read_text("scripts/git_hooks/src/git_hooks/Plan.terl")
    } else {
        _ -> false
    };
    String.contains(ci, "rust-format: \${{ steps.classify.outputs.rust-format }}")
        and String.contains(ci, "rust_format: \${{ needs.changes.outputs.rust-format == 'true' }}")
        and String.contains(preflight, "if: \${{ inputs.rust_format }}")
        and String.contains(preflight, "scripts/ci/scripts/CheckRustFormatting.terls")
        and String.contains(ci, "terlan-style: \${{ steps.classify.outputs.terlan-style }}")
        and String.contains(ci, "terlan_style: \${{ needs.changes.outputs.terlan-style == 'true' }}")
        and String.contains(preflight, "if: \${{ inputs.terlan_style }}")
        and String.contains(preflight, "scripts/ci/scripts/CheckTerlanStyle.terls")
        and String.contains(preflight, "if: \${{ inputs.editor }}")
        and String.contains(preflight, "if: \${{ inputs.inventory }}")
        and String.contains(preflight, "if: \${{ inputs.release_tooling }}")
        and String.contains(preflight, "if: \${{ inputs.hooks }}")
        and String.contains(preflight, "if: \${{ inputs.workflow }}")
        and String.contains(hook, "CheckRustFormatting.terls -- --paths-file \"$changes\"")
        and String.contains(plan, "RustFormatting.required(paths, false)")
        and String.contains(runner, "restore-keys:")
        and String.contains(runner, "steps.restored.outputs.usable != 'true'")
        and not String.contains(preflight, "cargo fmt --all")
        and not String.contains(preflight, "terlan-readability-canonicalization-check")
        and not String.contains(preflight, "sudo apt-get")
        and not String.contains(hook, "cargo fmt --all").
