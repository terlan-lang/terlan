module ci.ChangeClassifierTest.

import ci.ChangeClassifier.

@test
pub workflow_and_documentation_changes_avoid_compiler_validation(): Bool ->
    let result = ChangeClassifier.classify([".github/workflows/ci.yml", "docs/release.md"], false);
    not result.compiler
        and not result.source
        and not result.dependencies
        and not result.generated
        and not result.rust_format
        and not result.rust_format_all
        and not result.terlan_style
        and not result.terlan_style_all
        and result.ci_contracts
        and not result.editor
        and not result.inventory
        and not result.release_tooling
        and not result.hooks
        and result.workflow
        and result.changed_count == 2.

@test
pub compiler_sources_select_compiler_validation(): Bool ->
    let result = ChangeClassifier.classify(["crates/terlan/src/main.rs", "std/core/Int.terl"], false);
    result.compiler
        and result.source
        and not result.dependencies
        and result.generated
        and result.generated_summaries
        and not result.generated_js_bindings
        and result.generated_native_artifacts
        and result.generated_release_manifest
        and not result.generated_tree_sitter
        and result.rust_format
        and not result.rust_format_all
        and result.terlan_style
        and not result.terlan_style_all
        and result.inventory
        and not result.editor
        and not result.release_tooling.

@test
pub dependency_manifests_select_dependency_and_compiler_validation(): Bool ->
    let result =
        ChangeClassifier.classify(
            ["crates/terlan/Cargo.toml", "tools/css/package-lock.json"],
            false,
        );
    result.compiler
        and result.source
        and result.dependencies
        and not result.generated
        and not result.generated_summaries
        and not result.generated_js_bindings
        and not result.generated_native_artifacts
        and not result.generated_release_manifest
        and not result.generated_tree_sitter
        and not result.rust_format
        and not result.rust_format_all
        and not result.terlan_style
        and not result.terlan_style_all
        and not result.ci_contracts
        and not result.editor
        and not result.inventory
        and not result.release_tooling
        and not result.hooks
        and not result.workflow
        and ChangeClassifier.is_dependency_file("scripts/peers/requirements.txt").

@test
pub manual_and_indeterminate_dispatches_force_all_validation(): Bool ->
    let result = ChangeClassifier.classify([], true);
    result.compiler
        and result.source
        and result.dependencies
        and result.generated
        and result.generated_summaries
        and result.generated_js_bindings
        and result.generated_native_artifacts
        and result.generated_release_manifest
        and result.generated_tree_sitter
        and result.rust_format
        and result.rust_format_all
        and result.terlan_style
        and result.terlan_style_all
        and result.ci_contracts
        and result.editor
        and result.inventory
        and result.release_tooling
        and result.hooks
        and result.workflow
        and result.changed_count == 0.

@test
pub classification_ignores_duplicate_and_empty_paths(): Bool ->
    let result =
        ChangeClassifier.classify(
            ["Makefile", "", "Makefile", "editors/vscode/package.json"],
            false,
        );
    result.source
        and not result.compiler
        and not result.dependencies
        and not result.generated
        and not result.rust_format
        and not result.rust_format_all
        and not result.terlan_style
        and not result.terlan_style_all
        and result.release_tooling
        and result.editor
        and not result.hooks
        and result.changed_count == 2.

@test
pub root_and_prefix_contracts_are_explicit(): Bool ->
    ChangeClassifier.is_product_file("Cargo.lock")
        and ChangeClassifier.is_compiler_file("Cargo.lock")
        and ChangeClassifier.is_product_file("tree-sitter-terlan/grammar.js")
        and not ChangeClassifier.is_product_file("docs/compiler.md")
        and not ChangeClassifier.is_compiler_file("scripts/release_control/Main.terl")
        and ChangeClassifier.is_dependency_file("Cargo.lock")
        and not ChangeClassifier.is_dependency_file("README.md").

@test
pub release_tooling_receives_source_checks_without_compiler_replay(): Bool ->
    let result = ChangeClassifier.classify(["Makefile", "scripts/release_control/Main.terl"], false);
    result.source
        and not result.compiler
        and not result.dependencies
        and not result.generated
        and not result.rust_format
        and not result.rust_format_all
        and result.terlan_style
        and not result.terlan_style_all
        and result.release_tooling
        and not result.inventory.

@test
pub rust_formatting_scope_is_independent_of_compiler_scope(): Bool ->
    let source = ChangeClassifier.classify(["tools/example.rs"], false);
    let configuration = ChangeClassifier.classify(["rustfmt.toml"], false);
    source.rust_format
        and not source.rust_format_all
        and configuration.rust_format
        and configuration.rust_format_all.

@test
pub terlan_style_scope_is_independent_of_source_scope(): Bool ->
    let source = ChangeClassifier.classify(["docs/example.terl"], false);
    let configuration = ChangeClassifier.classify(["crates/terlan/src/commands/lint/rules.rs"], false);
    source.terlan_style
        and not source.terlan_style_all
        and not source.source
        and configuration.terlan_style
        and configuration.terlan_style_all.

@test
pub generated_artifact_scope_excludes_unrelated_automation(): Bool ->
    let automation =
        ChangeClassifier.classify(
            ["scripts/ci/src/ci/ChangeClassifier.terl", ".github/workflows/ci.yml"],
            false,
        );
    let generator = ChangeClassifier.classify(["std/core/Int.terl"], false);
    not automation.generated
        and automation.source
        and generator.generated
        and ChangeClassifier.is_generated_artifact_input(
    "scripts/self_validation/stdlib_interfaces/src/stdlib_interfaces/Build.terl",
)
        and ChangeClassifier.is_generated_artifact_input("tree-sitter-terlan/grammar.js")
        and ChangeClassifier.is_generated_artifact_input("crates/terlan/src/compiler/typeck/expression.rs")
        and not ChangeClassifier.is_generated_artifact_input("crates/terlan/src/runtime/vm.rs").

@test
pub generated_artifact_owners_are_selected_independently(): Bool ->
    let summary = ChangeClassifier.classify(["crates/terlan/src/compiler/typeck/expression.rs"], false);
    let javascript = ChangeClassifier.classify(["std/js/manifests/std_js_dom_inputs.json"], false);
    let tree = ChangeClassifier.classify(["tree-sitter-terlan/grammar.js"], false);
    summary.generated_summaries
        and not summary.generated_js_bindings
        and not summary.generated_native_artifacts
        and not summary.generated_release_manifest
        and not summary.generated_tree_sitter
        and not javascript.generated_summaries
        and javascript.generated_js_bindings
        and not javascript.generated_native_artifacts
        and not javascript.generated_release_manifest
        and not javascript.generated_tree_sitter
        and tree.generated_tree_sitter
        and not tree.generated_summaries
        and not tree.generated_js_bindings
        and not tree.generated_native_artifacts
        and not tree.generated_release_manifest.

@test
pub generated_orchestration_uses_contracts_without_regeneration(): Bool ->
    let orchestration = ChangeClassifier.classify(["Makefile", "std/stdlib.mk"], false);
    orchestration.ci_contracts
        and not orchestration.generated
        and not orchestration.generated_summaries
        and not orchestration.generated_js_bindings
        and not orchestration.generated_native_artifacts
        and not orchestration.generated_release_manifest
        and not orchestration.generated_tree_sitter.

@test
pub preflight_domains_are_selected_by_their_own_inputs(): Bool ->
    let ci = ChangeClassifier.classify(["scripts/ci/src/ci/ChangeClassifier.terl"], false);
    let editor = ChangeClassifier.classify(["editors/vscode/package.json"], false);
    let inventory = ChangeClassifier.classify(["tools/example.py"], false);
    let release = ChangeClassifier.classify(["mk/hermetic-support.mk"], false);
    let hooks = ChangeClassifier.classify(["scripts/git_hooks/check.sh"], false);
    let workflow = ChangeClassifier.classify([".github/workflows/security.yml"], false);
    ci.ci_contracts
        and not ci.editor
        and editor.editor
        and inventory.inventory
        and release.release_tooling
        and hooks.hooks
        and workflow.workflow
        and ChangeClassifier.is_ci_contract_file(".github/actions/setup-terlan-script-runner/action.yml")
        and ChangeClassifier.is_editor_file("tree-sitter-terlan/grammar.js")
        and ChangeClassifier.is_inventory_file("crates/terlan/src/main.rs")
        and ChangeClassifier.is_release_tooling_file(".github/workflows/release.yml")
        and ChangeClassifier.is_hook_file(".githooks/pre-commit")
        and ChangeClassifier.is_workflow_file(".github/actions/security-audit/action.yml")
        and not ChangeClassifier.is_ci_contract_file("README.md")
        and not ChangeClassifier.is_editor_file("README.md")
        and not ChangeClassifier.is_inventory_file("README.md")
        and not ChangeClassifier.is_release_tooling_file("README.md")
        and not ChangeClassifier.is_hook_file("README.md")
        and not ChangeClassifier.is_workflow_file("README.md").

@test
pub revisions_are_strict_and_indeterminate_bases_fail_closed(): Bool ->
    ChangeClassifier.valid_revision("0123456789abcdef0123456789abcdef01234567")
        and not ChangeClassifier.valid_revision("0123456789ABCDEF0123456789abcdef01234567")
        and not ChangeClassifier.valid_revision("short")
        and ChangeClassifier.indeterminate_base("")
        and ChangeClassifier.indeterminate_base("0000000000000000000000000000000000000000")
        and not ChangeClassifier.indeterminate_base("0123456789abcdef0123456789abcdef01234567").

@test
pub github_outputs_are_complete_and_stable(): Bool ->
    ChangeClassifier.render_outputs(
    ChangeClassifier.classify(["crates/terlan/src/main.rs", "Cargo.lock"], false),
) == "source=true\ncompiler=true\ndependencies=true\ngenerated=false\ngenerated-summaries=false\ngenerated-js-bindings=false\ngenerated-native-artifacts=false\ngenerated-release-manifest=false\ngenerated-tree-sitter=false\nrust-format=true\nrust-format-all=false\nterlan-style=false\nterlan-style-all=false\nci-contracts=false\neditor=false\ninventory=true\nrelease-tooling=false\nhooks=false\nworkflow=false\nchanged-count=2\n".
