#!/usr/bin/env -S terlc run
import ci.{FormattingTools, TerlanStyle}.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.String.
import std.io.Console.{eprintln, println}.
import std.system.{Arguments, Process}.

import type std.collections.List.
import type std.core.Option.
import type std.system.Process.{BatchCompletion, Command}.

lines(text: String): List[String] ->
    let trimmed = String.trim(text);
    if {
        trimmed == "" -> [];
        true -> String.split(trimmed, "\n")
    }.

git_paths(arguments: List[String]): Option[List[String]] ->
    case Process.run(Process.with_arguments(Process.command("git"), arguments)) {
        Ok(output) ->
            if {
                output.status == 0 -> Some(lines(output.stdout));
                true -> None
            };
        Err(_reason) -> None
    }.

tracked_sources(): Option[List[String]] ->
    git_paths(["ls-files", "--", "*.terl", "*.terli", "*.terls"]).

changed_sources(base: String, head: String): Option[List[String]] ->
    git_paths(
        [
            "diff",
            "--diff-filter=ACMR",
            "--name-only",
            base,
            head,
            "--",
            "*.terl",
            "*.terli",
            "*.terls",
        ],
    ).

check_commands(
    compiler: String,
    paths: List[String],
    mut commands: List[Command],
): List[Command] ->
    case paths {
        [] -> commands;
        _ ->
            let {batch, remaining} = TerlanStyle.batch(paths, 48);
            let _lint =
                commands
                    .push(
                        Process.with_output_limit_bytes(
                            Process.with_timeout_ms(
                                Process.with_arguments(
                                    Process.command(compiler),
                                    ["lint", "--only", "TL0009", "--only", "TL0010"].concat(batch),
                                ),
                                FormattingTools.timeout_ms(),
                            ),
                            FormattingTools.output_limit_bytes(),
                        ),
                    );
            let _format =
                commands
                    .push(
                        Process.with_output_limit_bytes(
                            Process.with_timeout_ms(
                                Process.with_arguments(
                                    Process.command(compiler),
                                    ["fmt", "--check"].concat(batch),
                                ),
                                FormattingTools.timeout_ms(),
                            ),
                            FormattingTools.output_limit_bytes(),
                        ),
                    );
            check_commands(compiler, remaining, commands)
    }.

completion_valid(completion: BatchCompletion): Bool ->
    case {completion.output, completion.error} {
        {Some(output), None} ->
            if {
                output.status == 0 -> true;
                true -> let _stdout = eprintln(output.stdout);
                let _stderr = eprintln(output.stderr);
                false
            };
        {None, Some(reason)} ->
            let _printed = eprintln(reason.message);
            false;
        _ -> false
    }.

completions_valid(completions: List[BatchCompletion]): Bool ->
    case completions {
        [] -> true;
        [completion | rest] -> completion_valid(completion) and completions_valid(rest)
    }.

check_batches(compiler: String, paths: List[String]): Bool ->
    let commands = check_commands(compiler, paths, []);
    case Process.run_many(Process.batch(commands, 8)) {
        Ok(output) -> completions_valid(output.completions);
        Err(reason) ->
            let _printed = eprintln(reason.message);
            false
    }.

check(compiler: String, paths: List[String]): Bool ->
    if {
        paths == [] -> let _printed = println("Terlan style skipped: no Terlan sources changed");
        true;
        true -> check_batches(compiler, paths)
    }.

entry(): Bool ->
    when {
        Some(base) <- Arguments.get(0);
        Some(head) <- Arguments.get(1);
        Some(force_all) <- Arguments.get(2);
        Some(compiler) <- Arguments.get(3);
        Some(paths) <-
            if {
                force_all == "true" -> tracked_sources();
                true -> changed_sources(base, head)
            }
    } else {
        _ -> false
    };
    check(compiler, TerlanStyle.sources(paths)).

assert(entry());
Unit.
