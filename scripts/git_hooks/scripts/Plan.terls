#!/usr/bin/env -S terlc run
import git_hooks.Plan.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.String.
import std.io.Console.{println}.
import std.io.File.
import std.system.Arguments.

entry(): Bool ->
    when {
        Some(path) <- Arguments.get(0);
        Ok(source) <- File.read_text(path)
    } else {
        _ -> false
    };
    (let paths = String.split(source, "\n");
let hosted =
    case Arguments.get(1) {
        Some("--hosted-source-preflight") -> true;
        _ -> false
    };
let preflight =
    if {
        hosted -> Plan.prefixed_hosted_preflight_lanes(paths);
        true -> Plan.prefixed_preflight_lanes(paths)
    };
let lanes =
    if {
        hosted -> Plan.hosted_lanes(paths);
        true -> Plan.lanes(paths)
    };
let _preflight = println(String.join(preflight, "\n"));
let _specialized = println(String.join(Plan.prefixed_specialized_terlan_tests(paths), "\n"));
let _lanes = println(String.join(lanes, "\n"));
true).

assert(entry());
Unit.
