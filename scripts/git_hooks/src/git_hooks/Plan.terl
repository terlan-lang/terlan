/**
 * Selects local gates from staged paths, including deleted and renamed inputs.
 */
module git_hooks.Plan.

import std.collections.List.
import std.core.String.

pub affected(paths: List[String], prefix: String, suffix: String): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.starts_with(path, prefix) and String.ends_with(path, suffix)
                or affected(rest, prefix, suffix)
    }.

pub rust_security(paths: List[String]): Bool ->
    affected(paths, "", "Cargo.toml")
        or affected(paths, "", "Cargo.lock")
        or affected(paths, "", "rust-toolchain.toml").

pub node_security(paths: List[String]): Bool ->
    affected(paths, "", "package.json")
        or affected(paths, "", "package-lock.json")
        or affected(paths, "", "npm-shrinkwrap.json").

pub editor_release(paths: List[String]): Bool ->
    affected(paths, "editors/", "") or affected(paths, "tree-sitter-terlan/", "").

pub artifact_bootstrap(paths: List[String]): Bool ->
    affected(paths, "Makefile", "")
        or affected(paths, "mk/", "")
        or affected(paths, "scripts/build_artifact_bootstrap_test.sh", "")
        or affected(paths, "scripts/build_typed_validator.sh", "").

pub grammar(paths: List[String]): Bool ->
    syntax(paths) or affected(paths, "scripts/self_validation/EbnfValidator.terls", "").

pub js_bindings(paths: List[String]): Bool ->
    syntax(paths)
        or affected(paths, "std/js/", "")
        or affected(paths, "scripts/self_validation/JsBindingsDriftTest.terl", "")
        or affected(paths, "crates/terlan/src/commands/bind/ts_", "").

pub negative_api(paths: List[String]): Bool ->
    syntax(paths)
        or compiler(paths)
        or affected(paths, "std/core/", "")
        or affected(paths, "std/io/", "")
        or affected(paths, "std/test/", "")
        or affected(paths, "std/vm/", "")
        or affected(paths, "scripts/self_validation/StdlibValidation.terls", "").

pub artifact_budget(paths: List[String]): Bool ->
    rust_security(paths)
        or affected(paths, "scripts/self_validation/BuildArtifactBudgetTest.terl", "")
        or affected(paths, "scripts/build_artifact_budget", "").

pub release_manifest(paths: List[String]): Bool ->
    affected(paths, "std/", ".terl")
        or affected(paths, "std/", ".terli")
        or affected(paths, "std/scripts/ReleaseManifestTest.terl", "")
        or affected(paths, "tests/std/RELEASE_API_TESTS.tsv", "").

pub rust_docs(paths: List[String]): Bool ->
    rust_security(paths) or affected(paths, "", ".rs").

pub preparation(paths: List[String]): Bool ->
    affected(paths, "Makefile", "")
        or affected(paths, "mk/", "")
        or affected(paths, "scripts/self_validation/release_promotion/", "")
        or affected(paths, "scripts/build_typed_validator.sh", "").

pub hook_policy(paths: List[String]): Bool ->
    affected(paths, ".githooks/", "")
        or affected(paths, "scripts/git_hooks", "")
        or affected(paths, "scripts/git_commit_message", "")
        or affected(paths, "scripts/publication_process_preflight_test.sh", "").

pub platform_workflow_contract(paths: List[String]): Bool ->
    affected(paths, ".github/workflows/", "")
        or affected(paths, ".github/actions/", "")
        or affected(paths, "scripts/self_validation/tvm_aot_platform_matrix/", "").

pub terlan_format(paths: List[String]): Bool ->
    affected(paths, "", ".terl")
        or affected(paths, "", ".terli")
        or affected(paths, "", ".terls")
        or affected(paths, "crates/terlan/src/compiler/syntax/formatter", "")
        or affected(paths, "crates/terlan/cli.mk", "").

selected(condition: Bool, name: String, lanes: List[String]): List[String] ->
    if {
        condition -> [name | lanes];
        true -> lanes
    }.

pub preflight_lanes(paths: List[String]): List[String] ->
    ["inventory" | selected(
    platform_workflow_contract(paths),
    "workflow-contract",
    selected(
        rust_security(paths),
        "rust-security",
        selected(
            node_security(paths),
            "node-security",
            selected(
                editor_release(paths),
                "editor-release",
                selected(
                    artifact_bootstrap(paths),
                    "artifact-bootstrap",
                    selected(
                        grammar(paths),
                        "grammar",
                        selected(
                            js_bindings(paths),
                            "js-bindings",
                            selected(
                                negative_api(paths),
                                "negative-api",
                                selected(
                                    artifact_budget(paths),
                                    "artifact-budget",
                                    selected(
                                        release_manifest(paths),
                                        "release-manifest",
                                        selected(
                                            rust_docs(paths),
                                            "rust-docs",
                                            selected(
                                                preparation(paths),
                                                "preparation",
                                                selected(
                                                    hook_policy(paths),
                                                    "hook-policy",
                                                    selected(
                                                        terlan_format(paths),
                                                        "terlan-format",
                                                        List.new[String](),
                                                    ),
                                                ),
                                            ),
                                        ),
                                    ),
                                ),
                            ),
                        ),
                    ),
                ),
            ),
        ),
    ),
)].

pub prefixed_preflight_lanes(paths: List[String]): List[String] ->
    prefix_preflight_lanes(preflight_lanes(paths)).

prefix_preflight_lanes(values: List[String]): List[String] ->
    case values {
        [] -> List.new[String]();
        [value | rest] -> [String.append("preflight:", value) | prefix_preflight_lanes(rest)]
    }.

pub workspace(paths: List[String]): Bool ->
    affected(paths, "", "Cargo.toml")
        or affected(paths, "", "Cargo.lock")
        or affected(paths, "", "rust-toolchain.toml")
        or affected(paths, ".cargo/", "")
        or general_fixtures(paths)
        or non_compiler_rust(paths).

general_fixtures(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.starts_with(path, "tests/fixtures/")
    and not String.starts_with(path, "tests/fixtures/phase_contract/")
                or general_fixtures(rest)
    }.

non_compiler_rust(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.ends_with(path, ".rs")
    and not String.starts_with(path, "crates/terlan/src/compiler/")
    and not String.starts_with(path, "crates/terlan/src/commands/")
    and not String.starts_with(path, "tools/rust_boundary_audit/")
    and not String.starts_with(path, "tree-sitter-terlan/")
                or non_compiler_rust(rest)
    }.

pub rust_boundary_audit(paths: List[String]): Bool ->
    affected(paths, "tools/rust_boundary_audit/", "").

pub commands(paths: List[String]): Bool ->
    affected(paths, "crates/terlan/src/commands/", ".rs").

pub command_lanes(paths: List[String]): List[String] ->
    selected(
        affected(paths, "crates/terlan/src/commands/test/", ".rs"),
        "commands-test",
        selected(
            affected(paths, "crates/terlan/src/commands/clean/", ".rs"),
            "commands-clean",
            selected(
                affected(paths, "crates/terlan/src/commands/doctor/", ".rs"),
                "commands-doctor",
                selected(
                    affected(paths, "crates/terlan/src/commands/init/", ".rs"),
                    "commands-init",
                    selected(other_commands(paths), "commands", List.new[String]()),
                ),
            ),
        ),
    ).

other_commands(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.starts_with(path, "crates/terlan/src/commands/")
    and String.ends_with(path, ".rs")
    and not String.starts_with(path, "crates/terlan/src/commands/test/")
    and not String.starts_with(path, "crates/terlan/src/commands/clean/")
    and not String.starts_with(path, "crates/terlan/src/commands/doctor/")
    and not String.starts_with(path, "crates/terlan/src/commands/init/")
                or other_commands(rest)
    }.

pub syntax(paths: List[String]): Bool ->
    affected(paths, "crates/terlan/src/compiler/syntax/", "")
        or affected(paths, "docs/grammar/", "")
        or affected(paths, "tree-sitter-terlan/", "").

pub native_bindings(paths: List[String]): Bool ->
    syntax(paths)
        or affected(paths, "", "Cargo.toml")
        or affected(paths, "", "Cargo.lock")
        or affected(paths, "", "rust-toolchain.toml")
        or affected(paths, "crates/terlan/src/commands/bind/", "")
        or affected(paths, "crates/terlan/src/runtime/vm/package_native_helper", "")
        or affected(paths, "crates/terlan/src/runtime/native_boundary/adapter_abi", "")
        or affected(paths, "crates/terlan/tests/fixtures/c_abi_native_boundary/", "")
        or affected(paths, "crates/terlan/tests/fixtures/cpp_native_boundary/", "")
        or affected(paths, "std/native/", "").

pub compiler(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.starts_with(path, "crates/terlan/src/compiler/")
    and not String.starts_with(path, "crates/terlan/src/compiler/syntax/")
                or compiler(rest)
    }.

has_non_native_lowering(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            path != ""
    and not String.starts_with(path, "crates/terlan/src/compiler/native_ir/")
    and path != "crates/terlan/src/compiler/native_ir.rs"
                or has_non_native_lowering(rest)
    }.

pub native_lowering(paths: List[String]): Bool ->
    compiler(paths) and not has_non_native_lowering(paths).

pub phase(paths: List[String]): Bool ->
    syntax(paths) or compiler(paths) or affected(paths, "tests/fixtures/phase_contract/", "").

pub editor(paths: List[String]): Bool ->
    syntax(paths) or affected(paths, "editors/", "").

pub terlan(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            (String.ends_with(path, ".terl")
    or String.ends_with(path, ".terls")
    or String.ends_with(path, ".terli")
    or String.ends_with(path, "terlan.toml"))
    and not String.starts_with(path, "tests/fixtures/")
    and not String.starts_with(path, "docs/grammar/fixtures/")
                or terlan(rest)
    }.

pub workflow(paths: List[String]): Bool ->
    affected(paths, ".github/workflows/", "") or affected(paths, ".github/actions/", "").

pub release_contract(paths: List[String]): Bool ->
    workflow(paths)
        or affected(paths, "Makefile", "")
        or affected(paths, "mk/", "")
        or release_script(paths)
        or affected(paths, "scripts/self_validation/RepositoryValidation.terls", "")
        or affected(paths, "scripts/self_validation/tvm_aot_platform_matrix/", "")
        or affected(paths, "editors/editor.mk", "")
        or affected(paths, "rust-toolchain.toml", "").

release_script(paths: List[String]): Bool ->
    case paths {
        [] -> false;
        [path | rest] ->
            String.starts_with(path, "scripts/")
    and String.ends_with(path, ".sh")
    and path != "scripts/git_hooks/check.sh"
                or release_script(rest)
    }.

pub bootstrap(paths: List[String]): Bool ->
    not workspace(paths)
        and (affected(paths, "mk/hermetic-support.mk", "")
    or affected(paths, "Makefile", "")
    or affected(paths, "scripts/git_hooks/check.sh", "")).

pub clippy(paths: List[String]): Bool ->
    workspace(paths)
        or compiler(paths)
        or syntax(paths)
        or affected(paths, "", ".rs")
        or affected(paths, "", "clippy.toml")
        or affected(paths, "", "Makefile")
        or affected(paths, "mk/", "").

pub reports(paths: List[String]): Bool ->
    clippy(paths) and has_non_native_lowering(paths)
        or affected(paths, "docs/quality/", "")
        or affected(paths, "scripts/self_validation/rust_quality/", "")
        or affected(paths, "scripts/git_hooks/rust_reports.sh", "").

pub summaries(paths: List[String]): Bool ->
    workspace(paths)
        or compiler(paths) and has_non_native_lowering(paths)
        or syntax(paths)
        or affected(paths, "std/", ".terl")
        or affected(paths, "std/", ".terli")
        or affected(paths, "std/summaries/", "")
        or affected(paths, "std/js/manifests/", "")
        or affected(paths, "scripts/self_validation/BuildInterfacesTest.terl", "")
        or affected(paths, "scripts/self_validation/SummaryDriftTest.terl", "")
        or affected(paths, "scripts/self_validation/JsBindingsDriftTest.terl", "")
        or affected(paths, "scripts/git_hooks/stdlib_summaries.sh", "").

pub proofs(paths: List[String]): Bool ->
    syntax(paths)
        or affected(paths, "proofs/lean/", "")
        or affected(paths, "docs/compiler/", "")
        or affected(paths, "docs/runtime/", "")
        or affected(paths, "std/", "")
        or affected(paths, "crates/terlan/src/runtime/native_boundary/", "")
        or affected(paths, "crates/terlan/src/backends/wasm/README.md", "")
        or affected(paths, "scripts/self_validation/LeanProof", "")
        or affected(paths, "scripts/self_validation/LalrpopGrammarContractTest.terl", "")
        or affected(paths, "scripts/git_hooks/proofs.sh", "").

pub lanes(paths: List[String]): List[String] ->
    let rust =
        if {
            workspace(paths) -> ["workspace"];
            rust_boundary_audit(paths) -> ["rust-boundary-audit"];
            commands(paths) -> command_lanes(paths);
            native_lowering(paths) -> ["native-ir", "phase"];
            compiler(paths) -> ["compiler", "phase"];
            syntax(paths) -> ["syntax", "phase"];
            phase(paths) -> ["phase"];
            true -> List.new[String]()
        };
    let workflows =
        if {
            workflow(paths) -> ["workflow"];
            true -> List.new[String]()
        };
    let sources =
        if {
            terlan(paths) -> ["terlan" | workflows];
            true -> workflows
        };
    let tooling =
        if {
            editor(paths) -> ["editor" | sources];
            true -> sources
        };
    let summarized_rust =
        if {
            summaries(paths) -> ["summaries" | rust];
            true -> rust
        };
    let reported_rust =
        if {
            reports(paths) -> ["rust-reports" | summarized_rust];
            true -> summarized_rust
        };
    let checked_rust =
        if {
            clippy(paths) -> ["clippy" | reported_rust];
            true -> reported_rust
        };
    let bootstrapped =
        if {
            bootstrap(paths) -> ["bootstrap" | checked_rust];
            true -> checked_rust
        };
    let contracted =
        if {
            release_contract(paths) -> ["release-contract" | tooling];
            true -> tooling
        };
    let proved =
        if {
            proofs(paths) -> ["proofs" | bootstrapped];
            true -> bootstrapped
        };
    let native =
        if {
            native_bindings(paths) -> ["native-bindings"];
            true -> List.new[String]()
        };
    append(["shell" | native], append(proved, contracted)).

append(left: List[String], right: List[String]): List[String] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.
