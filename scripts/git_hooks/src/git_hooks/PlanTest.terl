module git_hooks.PlanTest.

import git_hooks.Plan.

@test
pub grammar_requires_phase_goldens(): Bool ->
    Plan.lanes(["docs/grammar/TERLAN_SYNTAX_SPEC.ebnf"])
        == ["shell", "clippy", "syntax", "phase", "editor"].

@test
pub syntax_test_changes_include_cross_phase_contracts(): Bool ->
    Plan.lanes(["crates/terlan/src/compiler/syntax/lexer_test.rs"])
        == ["shell", "clippy", "syntax", "phase", "editor"].

@test
pub lowering_changes_run_compiler_and_phase_tests(): Bool ->
    Plan.lanes(["crates/terlan/src/compiler/native_ir.rs"])
        == ["shell", "clippy", "compiler", "phase"].

@test
pub runtime_changes_use_workspace_fallback(): Bool ->
    Plan.lanes(["crates/terlan/src/runtime/vm.rs"]) == ["shell", "clippy", "workspace"].

@test
pub lockfile_changes_use_workspace_fallback(): Bool ->
    Plan.lanes(["Cargo.lock"]) == ["shell", "clippy", "workspace"].

@test
pub fixture_only_changes_are_tested(): Bool ->
    Plan.lanes(["tests/fixtures/phase_contract/phase_basic.core.golden"])
        == ["shell", "phase"].

@test
pub renamed_old_paths_still_trigger_checks(): Bool ->
    Plan.lanes(["docs/grammar/TERLAN_SYNTAX_SPEC.ebnf", "archive/grammar.txt"])
        == ["shell", "clippy", "syntax", "phase", "editor"].

@test
pub terlan_changes_are_checked(): Bool ->
    Plan.lanes(["std/http/Request.terl"]) == ["shell", "terlan"].

@test
pub ordinary_docs_avoid_test_suites(): Bool ->
    Plan.lanes(["README.md"]) == ["shell"].

@test
pub terlan_manifests_trigger_package_validation(): Bool ->
    Plan.lanes(["scripts/git_hooks/terlan.toml"]) == ["shell", "terlan"].

@test
pub negative_phase_sources_use_their_owning_test(): Bool ->
    Plan.lanes(["tests/fixtures/phase_contract/phase_summary_type_debt.terl"])
        == ["shell", "phase"].

@test
pub other_negative_fixtures_use_workspace_tests(): Bool ->
    Plan.lanes(["tests/fixtures/example/invalid.terl"]) == ["shell", "clippy", "workspace"].

@test
pub interface_changes_are_checked(): Bool ->
    Plan.lanes(["std/example/Api.terli"]) == ["shell", "terlan"].

@test
pub rust_build_scripts_require_clippy(): Bool ->
    Plan.lanes(["crates/terlan/build.rs"]) == ["shell", "clippy", "workspace"].

@test
pub clippy_configuration_changes_are_checked(): Bool ->
    Plan.lanes([".clippy.toml"]) == ["shell", "clippy"].

@test
pub make_quality_changes_require_clippy(): Bool ->
    Plan.lanes(["mk/code-quality.mk", "Makefile"]) == ["shell", "clippy"].

@test
pub mixed_rust_changes_run_clippy_once(): Bool ->
    Plan.lanes(["Cargo.toml", "crates/terlan/src/compiler/syntax/lexer.rs"])
        == ["shell", "clippy", "workspace", "editor"].
