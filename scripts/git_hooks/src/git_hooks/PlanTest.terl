module git_hooks.PlanTest.

import git_hooks.Plan.
import std.core.Result.{Ok}.
import std.core.String.
import std.io.File.

manifest_paths_are_checked(paths: List[String]): Bool ->
    case paths {
        [] -> true;
        [path | rest] -> Plan.proofs([path]) and manifest_paths_are_checked(rest)
    }.

artifact_rows_are_checked(rows: List[String]): Bool ->
    case rows {
        [] -> true;
        ["" | rest] -> artifact_rows_are_checked(rest);
        [row | rest] ->
            case String.split(row, "\t") {
                ["path" | _] -> artifact_rows_are_checked(rest);
                [_path, _status, _scope, manifests, _exit, _stderr, _digest, _metadata, _remediation] ->
                    manifest_paths_are_checked(String.split(manifests, ";"))
                        and artifact_rows_are_checked(rest);
                _ -> false
            }
    }.

@test
pub every_inventory_manifest_triggers_proof_validation(): Bool ->
    case File.read_text("proofs/lean/ci/lean-proof-artifacts.tsv") {
        Ok(source) -> source != "" and artifact_rows_are_checked(String.split(source, "\n"));
        _ -> false
    }.

@test
pub grammar_requires_phase_goldens(): Bool ->
    Plan.lanes(["docs/grammar/TERLAN_SYNTAX_SPEC.ebnf"]) == [
    "shell",
    "native-bindings",
    "proofs",
    "clippy",
    "rust-reports",
    "summaries",
    "syntax",
    "phase",
    "editor",
].

@test
pub proof_metadata_changes_replay_proofs(): Bool ->
    Plan.lanes(["proofs/lean/artifacts/shape-implication.json"]) == ["shell", "proofs"].

@test
pub proof_sources_and_dependency_files_replay_proofs(): Bool ->
    Plan.proofs(["proofs/lean/parser_shape/ParserShape.lean"])
        and Plan.proofs(["proofs/lean/lake-manifest.json"])
        and Plan.proofs(["proofs/lean/lean-toolchain"])
        and Plan.proofs(["proofs/lean/ci/lean-proof-artifacts.tsv"]).

@test
pub proof_manifest_changes_are_checked_without_grammar_edits(): Bool ->
    Plan.proofs(["std/data/Json.terl"])
        and Plan.proofs(["std/summaries/std.data.Json.native_boundary.json"])
        and Plan.proofs(["docs/compiler/TERLAN_CORE_TYPING_SPEC.md"])
        and Plan.proofs(["docs/runtime/TERLAN_VM_RUNTIME_CONCEPTS.md"])
        and Plan.proofs(["crates/terlan/src/runtime/native_boundary/dispatch/value.rs"])
        and Plan.proofs(["crates/terlan/src/backends/wasm/README.md"]).

@test
pub proof_runner_changes_execute_proof_checks(): Bool ->
    Plan.lanes(["scripts/git_hooks/proofs.sh"]) == ["shell", "proofs", "release-contract"].

@test
pub unrelated_documents_do_not_require_lean(): Bool ->
