native_paths_are_checked(paths: List[String]): Bool ->
    case paths {
        [] -> true;
        [path | rest] -> Plan.native_bindings([path]) and native_paths_are_checked(rest)
    }.

@test
pub native_templates_protocols_and_reviewed_outputs_share_a_gate(): Bool ->
    native_paths_are_checked(
    [
        "crates/terlan/src/commands/bind/c_abi_binding_generator/generator/worker_rendering/native_helper_template.rs",
        "crates/terlan/src/commands/bind/cpp_binding_generator/generator/native_helper/template.rs",
        "crates/terlan/src/runtime/vm/package_native_helper/transport.rs",
        "crates/terlan/src/runtime/vm/package_native_helper/legacy_reply.rs",
        "crates/terlan/src/runtime/native_boundary/adapter_abi.rs",
        "std/native/libpq/native-binding.json",
        "std/native/libpq/generated/native/rust/src/bin/native_boundary_helper.rs",
        "crates/terlan/tests/fixtures/cpp_native_boundary/native-binding.json",
    ],
)
        and not Plan.native_bindings(["README.md", "crates/terlan/src/compiler/native_ir.rs"]).
