        and Plan.prefixed_specialized_terlan_tests(["scripts/self_validation/JsonEvidenceContractTest.terl"]) == ["specialized-test:scripts/self_validation/JsonEvidenceContractTest.terl"].

@test
pub ordinary_docs_avoid_artifact_workloads(): Bool ->
    Plan.preflight_lanes(["README.md"]) == ["inventory"]
        and not Plan.artifact_budget(["README.md"])
        and not Plan.release_manifest(["README.md"])
        and not Plan.rust_docs(["README.md"]).

@test
pub workflow_changes_validate_platform_contracts_early(): Bool ->
    Plan.preflight_lanes([".github/actions/setup-rust/action.yml"]) == ["inventory", "workflow-contract"]
        and not Plan.release_contract([".github/workflows/ci.yml"])
        and not Plan.release_contract([".github/workflows/source-preflight.yml"])
        and Plan.release_contract([".github/workflows/release.yml"])
        and Plan.release_contract([".github/workflows/publish.yml"]).

@test
pub hosted_compiler_validation_omits_parallel_source_duplicates(): Bool ->
    Plan.hosted_preflight_lanes([".github/workflows/ci.yml"]) == ["workflow-contract"]
        and Plan.hosted_lanes([".github/workflows/ci.yml"]) == ["shell"]
        and Plan.hosted_preflight_lanes(["std/core/Int.terl"]) == ["negative-api", "release-manifest"]
        and Plan.hosted_lanes(["std/core/Int.terl"]) == ["shell", "proofs", "terlan"]
        and Plan.hosted_preflight_lanes(["crates/terlan/src/compiler/native_ir.rs"]) == ["compiler-build", "negative-api", "rust-docs"]
        and Plan.hosted_lanes(["crates/terlan/src/compiler/native_ir.rs"]) == ["shell", "clippy", "native-ir", "phase"].

