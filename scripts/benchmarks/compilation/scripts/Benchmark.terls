#!/usr/bin/env -S terlc run
import compilation_benchmark.Runner.
import std.core.Int.
import std.core.Option.{Some}.
import std.system.Arguments.{get}.

entry(): Bool ->
    let {
        Some(compiler) <- get(0);
        Some(directory) <- get(1);
        Some(count_text) <- get(2);
        Some(width_text) <- get(3);
        Some(workload) <- get(4);
        Some(count) <- Int.from_string(count_text);
        Some(width) <- Int.from_string(width_text)
    } else {
        _ -> false
    };
    (workload == "scalar" or workload == "records")
        and Runner.run(compiler, directory, count, width, workload == "records").

assert(entry());
Unit.
