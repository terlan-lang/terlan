/**
 * Statistical edge cases and fail-closed suite ownership.
 */
module compilation_benchmark.SuiteTest.

import compilation_benchmark.{Comparison, Suite}.
import std.core.Option.{None, Some}.
import std.core.Result.{Ok}.
import std.core.{String, Unit}.
import std.io.Directory.{create_temporary, remove_all}.
import std.io.File.{exists}.

@test
pub median_preserves_units_and_handles_unordered_samples(): Bool ->
    Suite.median([]) == None
        and Suite.median([42]) == Some(42)
        and Suite.median([9_000_000_000, 1_000_000_000, 5_000_000_000]) == Some(5_000_000_000)
        and Suite.median([7, 2, 7, 7, 9]) == Some(7).

@test
pub invalid_repetition_count_never_starts_work(): Bool ->
    when {
        Ok(directory) <- create_temporary("terlan-compilation-suite-")
    } else {
        _ -> false
    };
    (let path = String.append(directory, "/samples");
let rejected =
    not Suite.run("missing-compiler", path, 1, 1, 0)
        and not Suite.run("missing-compiler", path, 1, 1, 2)
        and not Suite.run("missing-compiler", path, 1, 1, 33)
        and not Comparison.run("missing-compiler", path, 1, 1, 0)
        and not Comparison.run("missing-compiler", path, 1, 1, 2)
        and not Comparison.run("missing-compiler", directory, 1, 1, 1);
let untouched = not exists(path);
let removed = remove_all(directory) == Ok(Unit);
rejected and untouched and removed).
