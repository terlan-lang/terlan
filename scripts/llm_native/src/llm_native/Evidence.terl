/**
 * Validates independent schema and compiler test evidence without accepting
 * an empty inventory or a stale input closure as a successful gate.
 */
module llm_native.Evidence.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.String.
import std.crypto.Hash.
import std.data.Json.

import type std.core.Option.
import type std.data.Json.

/**
 * Exact string membership for fixed evidence inventories.
 */
pub contains(values: List[String], value: String): Bool ->
    case values {
        [] -> false;
        [head | tail] -> head == value or contains(tail, value)
    }.

/**
 * Returns a required JSON string or a sentinel that cannot satisfy a contract.
 */
pub text(value: Json, key: String): String ->
    if {
        Ok(field) <- value.get(key);
        Ok(result) <- field.as_string()
    } else {
        _ -> ""
    };
    result.

/**
 * Returns a required JSON integer, with -1 for missing or incorrectly typed data.
 */
pub number(value: Json, key: String): Int ->
    if {
        Ok(field) <- value.get(key);
        Ok(result) <- field.as_int()
    } else {
        _ -> -1
    };
    result.

/**
 * Explicit independent-peer inputs, in bytewise label order.
 */
pub peer_paths(): List[String] ->
    [
        "compiler/semantic/contract.json",
        "compiler/semantic/schemas/diagnostic.schema.json",
        "compiler/semantic/schemas/entity.schema.json",
        "compiler/semantic/schemas/proposal.schema.json",
        "compiler/semantic/schemas/provenance.schema.json",
        "compiler/semantic/schemas/query-error.schema.json",
        "compiler/semantic/schemas/query-result.schema.json",
        "compiler/semantic/schemas/query.schema.json",
        "compiler/semantic/schemas/snapshot.schema.json",
        "compiler/semantic/schemas/transaction.schema.json",
        "compiler/semantic/schemas/verification.schema.json",
        "scripts/llm_native/peers/requirements.txt",
        "scripts/llm_native/peers/schema_peer.py",
        "tests/fixtures/llm_native/contracts/cases.json",
        "tests/fixtures/llm_native/mcp/spec.LICENSE",
        "tests/fixtures/llm_native/mcp/spec.provenance.json",
        "tests/fixtures/llm_native/mcp/spec.schema.json",
        "tests/fixtures/llm_native/mcp/wire-cases.json",
    ].

/**
 * Gate implementation inputs are distinct from the independent schema closure.
 */
pub gate_paths(): List[String] ->
    List.concat(
        List.concat(
            peer_paths(),
            [
                "docs/compiler/LLM_NATIVE_COMPILER_CONTRACT.md",
                "scripts/llm_native/terlan.toml",
                "scripts/llm_native/scripts/Gate.terls",
                "scripts/llm_native/src/llm_native/Evidence.terl",
                "scripts/llm_native/src/llm_native/Gate.terl",
                "scripts/llm_native/src/llm_native/GateTest.terl",
                "scripts/llm_native/src/llm_native/Baseline.terl",
                "scripts/llm_native/src/llm_native/LegacyLsp.terl",
                "scripts/llm_native/src/llm_native/SnapshotGate.terl",
                "scripts/llm_native/src/llm_native/QueryGate.terl",
                "scripts/llm_native/src/llm_native/QueryGateTest.terl",
                "scripts/llm_native/src/llm_native/QueryInventory.terl",
                "tests/fixtures/llm_native/semantic/query-gate.json",
                "scripts/llm_native/README.md",
                "scripts/llm_native/scripts/Baseline.terls",
                "scripts/benchmarks/compilation/scripts/Generate.terls",
                "scripts/benchmarks/compilation/scripts/Edit.terls",
                "scripts/benchmarks/compilation/src/compilation_benchmark/Corpus.terl",
                "tests/fixtures/llm_native/property-cases.json",
            ],
        ),
        semantic_paths(),
    ).

digest_fields(root: String, paths: List[String]): Option[List[String]] ->
    case paths {
        [] -> Some([]);
        [path | rest] ->
            if {
                Ok(digest) <- Hash.sha256_file(String.concat([root, "/", path]));
                Some(tail) <- digest_fields(root, rest)
            } else {
                _ -> None
            };
            Some([path | [digest | tail]])
    }.

/**
 * Hashes labels and streaming file digests with the peer's length framing.
 */
pub source_digest(root: String, paths: List[String]): Option[String] ->
    case digest_fields(root, paths) {
        Some(fields) -> Some(Hash.sha256_framed(fields));
        None -> None
    }.

/**
 * Reads a nonempty, duplicate-free inventory of object IDs.
 */
pub ids(rows: Json, key: String): Option[List[String]] ->
    case rows.length() {
        Ok(count) ->
            if {
                count > 0 -> collect_ids(rows, key, 0, count, []);
                true -> None
            };
        Err(_) -> None
    }.

collect_ids(
    rows: Json,
    key: String,
    index: Int,
    count: Int,
    seen: List[String],
): Option[List[String]] ->
    if {
        index == count -> Some(seen);
        true -> if {
            Ok(row) <- rows.at(index)
        } else {
            _ -> None
        };
        (let id = text(row, key);
if {
    id == "" or contains(seen, id) -> None;
    true -> collect_ids(rows, key, index + 1, count, [id | seen])
})
    }.

all_passed(rows: Json, index: Int, count: Int): Bool ->
    if {
        index == count -> true;
        true -> case rows.at(index) {
            Ok(row) -> text(row, "status") == "passed" and all_passed(rows, index + 1, count);
            Err(_) -> false
        }
    }.

/**
 * Requires the exact registered cases and input digest from the schema peer.
 */
pub schema_report(report: Json, expected_digest: String, expected_ids: List[String]): Bool ->
    if {
        Ok(rows) <- report.get("cases");
        Some(actual_ids) <- ids(rows, "case_id");
        Ok(peers) <- report.get("peer_versions")
    } else {
        _ -> false
    };
    text(report, "schema") == "terlan.semantic.contract-evidence.v1"
        and text(report, "status") == "passed"
        and text(report, "kind") == "schema_validation"
        and text(report, "source_closure_digest") == expected_digest
        and text(report, "mcp_protocol_version") == "2025-11-25"
        and text(peers, "jsonschema") == "4.25.1"
        and text(peers, "mcp") == "1.30.0"
        and not List.is_empty(expected_ids)
        and List.length(actual_ids) == List.length(expected_ids)
        and List.is_empty(List.subtract(actual_ids, expected_ids))
        and number(report, "case_count") == List.length(expected_ids)
        and all_passed(rows, 0, List.length(expected_ids)).

/**
 * Rejects empty test selections, missing cases, and skipped or failed tests.
 */
pub test_report(report: Json, expected_names: List[String]): Bool ->
    if {
        Ok(rows) <- report.get("tests");
        Some(actual_names) <- ids(rows, "name")
    } else {
        _ -> false
    };
    not List.is_empty(expected_names)
        and number(report, "failed") == 0
        and number(report, "not_executed") == 0
        and number(report, "passed") == List.length(expected_names)
        and List.length(actual_names) == List.length(expected_names)
        and List.is_empty(List.subtract(actual_names, expected_names))
        and all_passed(rows, 0, List.length(expected_names)).

compiled_rows(rows: Json, expected_source: String, index: Int, count: Int, seen: Bool): Bool ->
    if {
        index == count -> seen;
        true -> if {
            Ok(row) <- rows.at(index)
        } else {
            _ -> false
        };
        (let source = text(row, "source_file");
if {
    source == "" -> compiled_rows(rows, expected_source, index + 1, count, seen);
    true -> let digest = text(row, "source_sha256");
    digest != ""
        and Hash.sha256_file(source) == Ok(digest)
        and compiled_rows(rows, expected_source, index + 1, count, seen or source == expected_source)
})
    }.

/**
 * All retained source hashes must be current, including the authored suite.
 */
pub compiled_sources(report: Json, expected_source: String): Bool ->
    if {
        Ok(evidence) <- report.get("native_callable_evidence");
        Ok(rows) <- evidence.get("declarations");
        Ok(count) <- rows.length()
    } else {
        _ -> false
    };
    text(evidence, "schema") == "terlan.native-callable-evidence/v1"
        and count > 0
        and count <= 65_536
        and compiled_rows(rows, expected_source, 0, count, false).

pub matching_cases(rows: Json, expected_ids: List[String], key: String): Bool ->
    if {
        Some(actual) <- ids(rows, key)
    } else {
        _ -> false
    };
    not List.is_empty(expected_ids)
        and List.length(actual) == List.length(expected_ids)
        and List.is_empty(List.subtract(actual, expected_ids))
        and all_passed(rows, 0, List.length(actual)).

/**
 * Validates the independently SDK-checked wire/model fixture inventory.
 */
pub wire_report(report: Json, expected_ids: List[String]): Bool ->
    if {
        Ok(rows) <- report.get("wire_cases");
        Some(actual_ids) <- ids(rows, "case_id")
    } else {
        _ -> false
    };
    not List.is_empty(expected_ids)
        and List.length(actual_ids) == List.length(expected_ids)
        and List.is_empty(List.subtract(actual_ids, expected_ids))
        and number(report, "wire_case_count") == List.length(expected_ids)
        and all_passed(rows, 0, List.length(expected_ids)).

