#!/usr/bin/env -S terlc run
/**
 * Qualifies a clean source-only checkout before repository self-validation.
 */
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String, Unit}.
import std.io.Console.{eprintln, println}.
import std.io.{Directory, File}.
import std.system.Arguments.

import type std.core.Option.
import type std.io.File.FileError.

failure(message: String): Bool ->
    let _printed = eprintln(String.append("error[self_validation.checkout]: ", message));
    false.

child(parent: String, name: String): String ->
    if {
        String.ends_with(parent, "/") -> String.append(parent, name);
        true -> String.append(parent, String.append("/", name))
    }.

python_artifact(path: String): Bool ->
    String.ends_with(path, ".py")
        or String.ends_with(path, ".pyc")
        or String.ends_with(path, ".pyo").

retained_python_peer(path: String): Bool ->
    let normalized = String.replace(path, "\\", "/");
    String.ends_with(
    normalized,
    "/docs/roadmap/evidence/llm-native/M1/binding-types-3fb8a509fa69/structured-type-oracle.py",
)
        or String.ends_with(
    normalized,
    "/docs/roadmap/evidence/llm-native/M1/call-origins-5680298d78c4/multi-provider-oracle.py",
)
        or String.ends_with(
    normalized,
    "/docs/roadmap/evidence/llm-native/M1/query-mcp-a05ae1adafcb/console-probe.py",
)
        or String.ends_with(normalized, "/scripts/llm_native/peers/mcp_peer.py")
        or String.ends_with(normalized, "/scripts/llm_native/peers/schema_peer.py")
        or String.ends_with(normalized, "/scripts/llm_native/peers/semantic_peer.py").

llm_native_python_documentation(path: String): Bool ->
    let normalized = String.replace(path, "\\", "/");
    String.ends_with(normalized, "/scripts/llm_native/README.md")
        or String.ends_with(normalized, "/docs/roadmap/evidence/llm-native/README.md").

command_surface(path: String): Bool ->
    String.ends_with(path, "/Makefile")
        or String.ends_with(path, "/Dockerfile")
        or String.ends_with(path, "/Justfile")
        or String.ends_with(path, ".mk")
        or String.ends_with(path, ".sh")
        or String.ends_with(path, ".bash")
        or String.ends_with(path, ".zsh")
        or String.ends_with(path, ".fish")
        or String.ends_with(path, ".yml")
        or String.ends_with(path, ".yaml")
        or String.ends_with(path, ".toml")
        or String.ends_with(path, ".json")
        or String.ends_with(path, ".jsonc")
        or String.ends_with(path, ".nix")
        or String.ends_with(path, ".ps1")
        or String.ends_with(path, ".bat")
        or String.ends_with(path, ".cmd")
        or String.ends_with(path, ".gradle")
        or String.ends_with(path, ".properties")
        or String.ends_with(path, ".xml").

json_command_surface(path: String): Bool ->
    String.ends_with(path, ".json") or String.ends_with(path, ".jsonc").

documentation_surface(path: String): Bool ->
    String.ends_with(path, ".md") and not String.contains(path, "/docs/roadmap/archive/").

collect_command_surfaces(paths: List[String], output: List[String]): List[String] ->
    case paths {
        [] -> output;
        [path | rest] ->
            collect_command_surfaces(
                rest,
                if {
                    command_surface(path) or documentation_surface(path) -> [path | output];
                    true -> output
                },
            )
    }.

first_python_artifact(paths: List[String]): Option[String] ->
    case paths {
        [] -> None;
        [path | rest] ->
            if {
                python_artifact(path) and not retained_python_peer(path) -> Some(path);
                true -> first_python_artifact(rest)
            }
    }.

host_self_validation_artifact(path: String): Bool ->
    let normalized = String.replace(path, "\\", "/");
    (String.contains(normalized, "/scripts/self_validation/")
    or String.starts_with(normalized, "scripts/self_validation/"))
        and (String.ends_with(normalized, ".py") or String.ends_with(normalized, ".sh")).

first_host_self_validation_artifact(paths: List[String]): Option[String] ->
    case paths {
        [] -> None;
        [path | rest] ->
            if {
                host_self_validation_artifact(path) -> Some(path);
                true -> first_host_self_validation_artifact(rest)
            }
    }.

python_command(contents: String): Bool ->
    let normalized = String.lowercase(contents);
    String.contains(normalized, "python3")
        or String.contains(normalized, "python ")
        or String.contains(normalized, "python\t")
        or String.contains(normalized, "$(python)")
        or String.contains(normalized, "/usr/bin/python")
        or String.contains(normalized, "env python")
        or String.contains(normalized, "pip install").

python_json_command(contents: String): Bool ->
    let normalized = String.lowercase(contents);
    String.contains(normalized, "\"python\"")
        or String.contains(normalized, "\"python3\"")
        or String.contains(normalized, "\": \"python ")
        or String.contains(normalized, "\":\"python ")
        or String.contains(normalized, "\": \"python3 ")
        or String.contains(normalized, "\":\"python3 ")
        or String.contains(normalized, "/bin/python")
        or String.contains(normalized, "env python")
        or String.contains(normalized, "pip install").

python_documentation_command(contents: String): Bool ->
    let normalized = String.lowercase(contents);
    String.contains(normalized, "python3")
        or String.contains(normalized, "`python ")
        or String.contains(normalized, "$ python")
        or String.contains(normalized, "> python")
        or String.contains(normalized, "python -m")
        or String.contains(normalized, "/usr/bin/python")
        or String.contains(normalized, "env python")
        or String.contains(normalized, "pip install").

first_python_command(paths: List[String]): Result[Option[String], FileError] ->
    case paths {
        [] -> Ok(None);
        [path | rest] ->
            case File.read_text(path) {
                Err(reason) -> Err(reason);
                Ok(contents) ->
                    if {
                        documentation_surface(path)
                            and not llm_native_python_documentation(path)
                            and python_documentation_command(contents) -> Ok(Some(path));
                        json_command_surface(path) and python_json_command(contents) -> Ok(Some(path));
                        command_surface(path)
                            and not json_command_surface(path)
                            and python_command(contents) -> Ok(Some(path));
                        true -> first_python_command(rest)
                    }
            }
    }.

scan(checkout: String): Bool ->
    case Directory.files_recursive_excluding(checkout, []) {
        Err(reason) -> failure(reason.message);
        Ok(paths) ->
            case first_host_self_validation_artifact(paths) {
                Some(path) ->
                    failure(
                        String.append(
                            "host-language script remains in Terlan self-validation: ",
                            path,
                        ),
                    );
                None ->
                    case first_python_artifact(paths) {
                        Some(path) ->
                            failure(
                                String.append(
                                    "unapproved Python artifact remains in clean checkout: ",
                                    path,
                                ),
                            );
                        None ->
                            case first_python_command(
                                collect_command_surfaces(paths, List.new[String]()),
                            ) {
                                Err(reason) -> failure(reason.message);
                                Ok(Some(path)) ->
                                    failure(
                                        String.append(
                                            "Python command remains in clean checkout: ",
                                            path,
                                        ),
                                    );
                                Ok(None) ->
                                    let _printed =
                                        println(
                                            String.concat(
                                                [
                                                    "clean source checkout qualified ",
                                                    Int.to_string(List.length(paths)),
                                                    " files without unapproved Python and with Terlan-owned self-validation",
                                                ],
                                            ),
                                        );
                                    true
                            }
                    }
            }
    }.

run(root: String): Bool ->
    case Directory.create_temporary("terlan-self-validation-checkout.") {
        Err(reason) -> failure(reason.message);
        Ok(temporary) ->
            let checkout = child(temporary, "source");
            let copied =
                Directory.copy_tree_excluding(
                    root,
                    checkout,
                    [
                        ".git",
                        ".terlan",
                        "_build",
                        "build",
                        "dist",
                        "node_modules",
                        "target",
                        "vendor",
                        "__pycache__",
                    ],
                );
            let valid =
                case copied {
                    Err(reason) -> failure(reason.message);
                    Ok(Unit) -> scan(checkout)
                };
            case Directory.remove_all(temporary) {
                Err(reason) -> failure(reason.message);
                Ok(Unit) -> valid
            }
    }.

policy_is_exact(): Bool ->
    retained_python_peer("/workspace/scripts/llm_native/peers/mcp_peer.py")
        and retained_python_peer(
    "/workspace/docs/roadmap/evidence/llm-native/M1/query-mcp-a05ae1adafcb/console-probe.py",
)
        and not retained_python_peer("/workspace/scripts/llm_native/peers/other.py")
        and not retained_python_peer("/workspace/scripts/llm_native/peers/mcp_peer.pyc")
        and llm_native_python_documentation("/workspace/scripts/llm_native/README.md")
        and not llm_native_python_documentation("/workspace/docs/README.md")
        and python_json_command("{\"command\": \"python tool.py\"}")
        and python_json_command("{\"argv\": [\"python3\", \"tool.py\"]}")
        and not python_json_command("{\"scope\": \"pinned Python environment\"}").

entry(): Bool ->
    case {Arguments.get(0), Arguments.count()} {
        {Some(root), 1} -> run(root);
        _ -> failure("expected one repository-root argument")
    }.

assert(policy_is_exact());
assert(entry());
Unit.
