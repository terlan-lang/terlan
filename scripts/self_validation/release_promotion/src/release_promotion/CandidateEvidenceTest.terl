/**
 * Mutation checks inside the promotion verifier's disposable sealed fixture.
 */
module release_promotion.CandidateEvidenceTest.

import release_promotion.{CandidateEvidence, OwnerStorage}.
import std.collections.List.
import std.core.Result.{Err, Ok}.
import std.core.String.{append}.
import std.io.{Directory, File}.

write(root: String, path: String, contents: String): Bool ->
    case File.write_text(OwnerStorage.child(root, path), contents) {
        Ok(_written) -> true;
        Err(_reason) -> false
    }.

remove(root: String, paths: List[String]): Bool ->
    case paths {
        [] -> true;
        [path | rest] ->
            let Ok(_deleted) <- File.delete(OwnerStorage.child(root, path)) else {
                _ -> false
            };
            remove(root, rest)
    }.

create_bookkeeping(root: String): Bool ->
    let {
        Ok(_owner) <-
            Directory.create_all(
                OwnerStorage.child(root, "target/quality/preparation/candidate/owner.work"),
            );
        true <-
            write(
                root,
                "target/quality/preparation/candidate/owner.json",
                "{\"outcome\":\"running\"}\n",
            );
        true <-
            write(
                root,
                "target/quality/preparation/candidate/owner.work/output.json",
                "partial scratch",
            );
        true <-
            write(
                root,
                "target/quality/hosted-source-coverage.json",
                "{\"decision\":\"running\"}\n",
            );
        true <- write(root, "target/quality/release-status.json", "{\"state\":\"preparing\"}\n");
        true <- write(root, "target/quality/rust-cargo-metadata.json", "{\"packages\":[]}\n");
        true <-
            write(
                root,
                "target/quality/rust-cargo-metadata.json.attempt.json",
                "{\"outcome\":\"running\"}\n",
            )
    } else {
        _ -> false
    };
    publication_scratch(root).

publication_scratch(root: String): Bool ->
    let {
        Ok(_scratch) <- Directory.create_all(OwnerStorage.child(root, "target/quality/publication.pending"));
        true <- write(root, "target/quality/publication.pending/publication-plan.json", "");
        true <- write(root, "target/quality/publication.pending/release.json", "{}\n");
        true <- write(root, "target/quality/publication.pending/releases.json", "[]\n")
    } else {
        _ -> false
    };
    true.

bookkeeping(root: String, original: List[String]): Bool ->
    let {
        true <- create_bookkeeping(root);
        Ok(created) <- CandidateEvidence.paths(root);
        true <- created == original;
        true <-
            write(
                root,
                "target/quality/preparation/candidate/owner.json",
                "{\"outcome\":\"pass\"}\n",
            );
        true <-
            write(
                root,
                "target/quality/rust-cargo-metadata.json.attempt.json",
                "{\"outcome\":\"failed\"}\n",
            );
        true <- write(root, "target/quality/hosted-source-coverage.json", "{\"decision\":\"pass\"}\n");
        true <- write(root, "target/quality/release-status.json", "{\"state\":\"publishing\"}\n");
        true <-
            write(
                root,
                "target/quality/publication.pending/publication-plan.json",
                "{\"schema\":\"terlan.publication-plan.v1\"}\n",
            );
        Ok(changed) <- CandidateEvidence.paths(root)
    } else {
        _ -> false
    };
    changed == original.

genuine_reports(root: String, original: List[String]): Bool ->
    let genuine =
        [
            "target/quality/preparation-report.json",
            "target/quality/rust-cargo-metadata-report.json",
            "target/quality/nested/rust-cargo-metadata.json",
            "target/quality/nested/preparation/evidence.json",
            "target/quality/hosted-candidate-validation.json",
            "target/quality/hosted-source-coverage-report.json",
            "target/quality/nested/hosted-source-coverage.json",
            "target/quality/nested/release-status.json",
            "target/quality/publication.pending/evidence.json",
        ];
    let {
        Ok(_nested) <- Directory.create_all(OwnerStorage.child(root, "target/quality/nested/preparation"));
        true <- write(root, "target/quality/preparation-report.json", "{}\n");
        true <- write(root, "target/quality/rust-cargo-metadata-report.json", "{}\n");
        true <- write(root, "target/quality/nested/rust-cargo-metadata.json", "{}\n");
        true <- write(root, "target/quality/nested/preparation/evidence.json", "{}\n");
        true <- write(root, "target/quality/hosted-candidate-validation.json", "{}\n");
        true <- write(root, "target/quality/hosted-source-coverage-report.json", "{}\n");
        true <- write(root, "target/quality/nested/hosted-source-coverage.json", "{}\n");
        true <- write(root, "target/quality/nested/release-status.json", "{}\n");
        true <- write(root, "target/quality/publication.pending/evidence.json", "{}\n");
        Ok(added) <- CandidateEvidence.paths(root);
        true <- List.length(added) == List.length(original) + List.length(genuine);
        true <- List.subtract(genuine, added) == [];
        true <- remove(root, genuine);
        Ok(restored) <- CandidateEvidence.paths(root)
    } else {
        _ -> false
    };
    restored == original.

/**
 * Leaves only excluded bookkeeping beside the original evidence. The caller
 * then verifies the original candidate seal using the real payload builder.
 */
pub self_test(root: String): Bool ->
    let {
        true <- CandidateEvidence.relative_root_self_test();
        Ok(original) <- CandidateEvidence.paths(root);
        true <- original == ["target/quality/self-test-report.json"];
        Ok(trailing_slash) <- CandidateEvidence.paths(append(root, "/"));
        true <- trailing_slash == original;
        Err(_missing) <- CandidateEvidence.paths(OwnerStorage.child(root, "missing"))
    } else {
        _ -> false
    };
    bookkeeping(root, original) and genuine_reports(root, original).

/**
 * Runs the inventory regression directly through the ordinary test runner.
 */
@test
pub mutable_bookkeeping_preserves_bound_gate_inventory(): Bool ->
    case Directory.create_temporary("terlan-candidate-evidence-") {
        Err(_reason) -> false;
        Ok(root) ->
            let prepared =
                case Directory.create_all(OwnerStorage.child(root, "target/quality")) {
                    Ok(_created) -> write(root, "target/quality/self-test-report.json", "{}\n");
                    Err(_reason) -> false
                };
            let valid = prepared and self_test(root);
            let removed =
                case Directory.remove_all(root) {
                    Ok(_removed) -> true;
                    Err(_reason) -> false
                };
            valid and removed
    }.
