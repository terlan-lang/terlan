/**
 * Proves a complete offline release closure against one candidate.
 */
module release_promotion.Preflight.

import release_promotion.PreflightReport.
import std.collections.List.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.io.Console.{eprintln}.
import std.io.File.

import type std.io.File.TextFile.

@pure
child(parent: String, relative: String): String ->
    if {
        String.ends_with(parent, "/") -> String.append(parent, relative);
        true -> String.concat([parent, "/", relative])
    }.

@pure
outcome_reports(): List[String] ->
    [
        "target/quality/release-example-projects-report.json",
        "target/quality/release-project-upgrade-matrix-report.json",
        "target/quality/release-reference-app-suite-report.json",
        "target/quality/release-diagnostic-catalog-report.json",
        "target/quality/release-compatibility-baseline-report.json",
        "target/quality/release-notes-accuracy-report.json",
        "target/quality/release-supply-chain-provenance-report.json",
        "target/quality/release-security-hardening-report.json",
        "target/quality/release-support-bundle-report.json",
        "target/quality/release-performance-baseline-report.json",
        "target/quality/release-adversarial-corpus-report.json",
        "target/quality/release-mutation-check-report.json",
        "target/quality/release-fault-injection-report.json",
        "target/quality/vm-release-artifact-matrix-report.json",
        "target/quality/vm-multicore-release-closeout.json",
        "target/quality/release-readiness-attestation-report.json",
        "target/quality/release-staged-distribution-verification-report.json",
    ].

@pure
loaded_text(files: List[TextFile], relative: String): String ->
    case files {
        [] -> "";
        [file | rest] ->
            if {
                String.ends_with(File.text_file_path(file), relative) -> File.text_file_contents(file);
                true -> loaded_text(rest, relative)
            }
    }.

@pure
reports_pass(files: List[TextFile], paths: List[String]): Bool ->
    case paths {
        [] -> true;
        [path | rest] ->
            let source = loaded_text(files, path);
            source != ""
                and String.contains(source, "\"decision\": \"pass\"")
                and reports_pass(files, rest)
    }.

@pure
platforms_hold(source: String): Bool ->
    String.contains(source, "\"target_count\": 6")
        and String.contains(source, "x86_64-unknown-linux-gnu")
        and String.contains(source, "aarch64-unknown-linux-gnu")
        and String.contains(source, "x86_64-apple-darwin")
        and String.contains(source, "aarch64-apple-darwin")
        and String.contains(source, "x86_64-pc-windows-msvc")
        and String.contains(source, "aarch64-pc-windows-msvc").

@pure
recipe_is_offline(makefile: String): Bool ->
    let {
        [_before, suffix] <- String.split(makefile, "release-preflight:");
        [recipe | _rest] <- String.split(suffix, "\n\n")
    } else {
        _ -> false
    };
    not String.contains(recipe, "curl ")
        and not String.contains(recipe, "wget ")
        and not String.contains(recipe, " gh ")
        and not String.contains(recipe, "publish")
        and not String.contains(recipe, " seal").

@pure
recipe_is_composition_only(makefile: String): Bool ->
    let {
        [_before, suffix] <- String.split(makefile, "release-preflight:");
        [recipe | _rest] <- String.split(suffix, "\n\n")
    } else {
        _ -> false
    };
    not String.contains(recipe, "$(MAKE)")
        and not String.contains(recipe, "$(CARGO)")
        and not String.contains(recipe, "$(RUST_TEST)")
        and not String.contains(recipe, "terlc build").

@pure
absolute_paths(root: String, paths: List[String], output: List[String]): List[String] ->
    case paths {
        [] -> reverse_strings(output, []);
        [path | rest] -> absolute_paths(root, rest, [child(root, path) | output])
    }.

@pure
reverse_strings(values: List[String], output: List[String]): List[String] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_strings(rest, [value | output])
    }.

@pure
input_paths(root: String): List[String] ->
    List.concat([child(root, "Makefile")], absolute_paths(root, outcome_reports(), [])).

validate_loaded(
    root: String,
    version: String,
    candidate_seal: String,
    files: List[TextFile],
): Bool ->
    let makefile = loaded_text(files, "Makefile");
    if {
        not reports_pass(files, outcome_reports()) -> failure(
            "reports",
            "a required outcome report is missing or failing; reproduce with its owning gate",
        );
        candidate_seal == "" -> failure(
            "candidate",
            "candidate seal is missing; run `make release-readiness-attestation-check`",
        );
        not String.contains(
    loaded_text(files, "target/quality/release-readiness-attestation-report.json"),
    candidate_seal,
) -> failure(
            "candidate",
            "readiness evidence belongs to another candidate; run `make release-readiness-attestation-check`",
        );
        not String.contains(
    loaded_text(files, "target/quality/release-staged-distribution-verification-report.json"),
    candidate_seal,
) -> failure(
            "candidate",
            "staged evidence belongs to another candidate; run `make release-staged-distribution-verification-check`",
        );
        not platforms_hold(loaded_text(files, "target/quality/vm-release-artifact-matrix-report.json")) -> failure(
            "platform",
            "six platform attestations are incomplete; run `make vm-release-artifact-matrix-check`",
        );
        not recipe_is_offline(makefile) -> failure(
            "offline",
            "preflight contains a network, publication, or second-seal command; run `make release-preflight`",
        );
        not recipe_is_composition_only(makefile) -> failure(
            "composition",
            "preflight must consume existing evidence without make, Cargo, Rust-test, or compiler-build work",
        );
        true -> PreflightReport.write(root, version, candidate_seal, List.length(outcome_reports()))
    }.

/**
 * Consumes, but never rebuilds or reseals, the verified candidate.
 */
pub run(root: String, version: String, candidate_seal: String): Bool ->
    case File.read_text_many(input_paths(root)) {
        Ok(files) -> validate_loaded(root, version, candidate_seal, files);
        Err(_reason) ->
            failure(
                "inputs",
                "preflight inputs are missing; reproduce with `make release-preflight`",
            )
    }.

/**
 * Exercises every fail-closed preflight policy without external state.
 */
pub self_test(): Bool ->
    let platform = "{\"target_count\": 6,\"targets\":[\"x86_64-unknown-linux-gnu\",\"aarch64-unknown-linux-gnu\",\"x86_64-apple-darwin\",\"aarch64-apple-darwin\",\"x86_64-pc-windows-msvc\",\"aarch64-pc-windows-msvc\"]}";
    platforms_hold(platform)
        and not platforms_hold(String.replace(platform, "aarch64-pc-windows-msvc", "unsupported"))
        and not reports_pass([], outcome_reports())
        and recipe_is_offline("release-preflight:\n\tlocal-check\n\n")
        and not recipe_is_offline("release-preflight:\n\tcurl example.invalid\n\n")
        and not recipe_is_offline("release-preflight:\n\tsecond seal\n\n")
        and recipe_is_composition_only("release-preflight:\n\tverify evidence\n\n")
        and not recipe_is_composition_only("release-preflight:\n\t$(MAKE) check\n\n")
        and not recipe_is_composition_only("release-preflight:\n\tterlc build validator.terls\n\n").

failure(code: String, message: String): Bool ->
    let _printed = eprintln(String.concat(["error[release_preflight.", code, "]: ", message]));
    false.
