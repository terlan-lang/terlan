/**
 * Validates that one sealed release candidate owns all local closeout evidence.
 */
module release_promotion.Readiness.

import release_promotion.EvidenceReports.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{String, Unit}.
import std.crypto.Hash.
import std.data.Json.
import std.io.Console.{eprintln}.
import std.io.{Directory, File}.
import std.system.Environment.

import type std.data.Json.
import type std.data.Json.RequiredFieldRow.

required_reports(): List[{String, String}] ->
    EvidenceReports.readiness_reports().

child(parent: String, relative: String): String ->
    if {
        String.ends_with(parent, "/") -> String.append(parent, relative);
        true -> String.concat([parent, "/", relative])
    }.

text(root: String, relative: String): String ->
    case File.read_text(child(root, relative)) {
        Ok(value) -> value;
        Err(_reason) -> ""
    }.

sealed_report(rows: List[RequiredFieldRow], path: String, digest: String, found: Bool): Bool ->
    case rows {
        [] -> found;
        [row | rest] ->
            case Json.required_field_row_strings(row) {
                [entry, actual] ->
                    if {
                        entry == path -> not found and actual == digest and sealed_report(rest, path, digest, true);
                        true -> sealed_report(rest, path, digest, found)
                    };
                _ -> false
            }
    }.

reports_valid(root: String, rows: List[{String, String}], sealed: List[RequiredFieldRow]): Bool ->
    case rows {
        [] -> true;
        [{path, schema} | rest] ->
            let source = text(root, path);
            EvidenceReports.passes(source, schema)
                and sealed_report(sealed, path, String.append("sha256:", Hash.sha256(source)), false)
                and reports_valid(root, rest, sealed)
    }.

report_paths(rows: List[{String, String}], output: Json): Json ->
    case rows {
        [] -> output;
        [{path, _schema} | rest] -> report_paths(rest, output.push(Json.string(path)))
    }.

string_field(document: Json, name: String): String ->
    let {
        Ok(value) <- document.get(name);
        Ok(text) <- value.as_string()
    } else {
        _ -> ""
    };
    text.

seal_digest(candidate: Json): String ->
    case candidate.get("seal") {
        Ok(seal) -> string_field(seal, "digest");
        Err(_reason) -> ""
    }.

archive_row(rows: List[RequiredFieldRow], expected: String): {String, String} ->
    case rows {
        [] -> {"", ""};
        [row | rest] ->
            case Json.required_field_row_strings(row) {
                [path, digest] ->
                    if {
                        path == expected -> {path, digest};
                        true -> archive_row(rest, expected)
                    };
                _ -> archive_row(rest, expected)
            }
    }.

candidate_archive(root: String, candidate: Json): {String, String} ->
    let {
        Ok(metadata) <- Json.parse(text(root, "dist/terlan-release.json"));
        Ok(artifacts) <- candidate.get("artifacts");
        Ok(rows) <- Json.required_field_rows(artifacts, ["path", "sha256"], [], [])
    } else {
        _ -> {"", ""}
    };
    (let os = string_field(metadata, "os");
let suffix =
    if {
        os == "windows" -> ".zip";
        true -> ".tar.gz"
    };
let expected = String.concat(["dist/terlc-", os, "-", string_field(metadata, "arch"), suffix]);
archive_row(rows, expected)).

/**
 * Local evidence must bind the installed platform, not the first sorted archive.
 */
pub archive_selection_self_test(): Bool ->
    let {
        Ok(document) <-
            Json.string_object_rows(
                ["path", "sha256"],
                [
                    ["dist/terlc-linux-aarch64.tar.gz", "arm"],
                    ["dist/terlc-linux-x86_64.tar.gz.sha256", "sidecar"],
                    ["dist/terlc-linux-x86_64.tar.gz", "x86"],
                    ["dist/terlc-windows-aarch64.zip", "windows"],
                ],
            );
        Ok(rows) <- Json.required_field_rows(document, ["path", "sha256"], [], [])
    } else {
        _ -> false
    };
    archive_row(rows, "dist/terlc-linux-x86_64.tar.gz") == {"dist/terlc-linux-x86_64.tar.gz", "x86"}
        and archive_row(rows, "dist/terlc-windows-aarch64.zip") == {"dist/terlc-windows-aarch64.zip", "windows"}
        and archive_row(rows, "dist/terlc-macos-x86_64.tar.gz") == {"", ""}.

metadata_identity(root: String): String ->
    case Json.parse(text(root, "dist/terlan-release.json")) {
        Ok(document) -> string_field(document, "release_candidate_id");
        Err(_reason) -> ""
    }.

cross_hashes_hold(root: String, path: String, digest: String): Bool ->
    let raw =
        if {
            String.starts_with(digest, "sha256:") -> digest.utf8_slice(7, digest.byte_size() - 7);
            true -> digest
        };
    case Hash.sha256_file(child(root, path)) {
        Ok(actual) ->
            actual == raw
                and EvidenceReports.supply_chain_matches(
    text(root, "target/quality/release-supply-chain-provenance-report.json"),
    raw,
)
                and EvidenceReports.matrix_archive_matches(
    text(root, "target/quality/vm-release-artifact-matrix-report.json"),
    path,
    raw,
);
        Err(_reason) -> false
    }.

write_report(root: String, candidate: Json, archive: String, digest: String): Bool ->
    let output =
        case Environment.get("TERLAN_READINESS_OUTPUT") {
            Some(path) -> path;
            None -> child(root, "target/quality/release-readiness-attestation-report.json")
        };
    let report =
        Json.object()
            .put("schema", Json.string("terlan.release-readiness-attestation.v1"))
            .put("decision", Json.string("pass"))
            .put("version", Json.string(string_field(candidate, "version")))
            .put("candidate_seal", Json.string(seal_digest(candidate)))
            .put("release_candidate_id", Json.string(metadata_identity(root)))
            .put("artifact", Json.string(archive))
            .put("artifact_sha256", Json.string(digest))
            .put("required_reports", report_paths(required_reports(), Json.array()))
            .put("offline", Json.bool(true))
            .put("publication_required", Json.bool(false));
    let {
        Ok(Unit) <- Directory.create_all(child(root, "target/quality"));
        Ok(rendered) <- Json.stringify_pretty(report);
        Ok(Unit) <- File.write_text(output, String.append(rendered, "\n"))
    } else {
        _ -> false
    };
    true.

/**
 * Binds all required local reports and candidate surfaces to one seal.
 */
pub attest(root: String, candidate: Json): Bool ->
    let {
        Ok(reports) <- candidate.get("gate_reports");
        Ok(sealed) <- Json.required_field_rows(reports, ["path", "sha256"], [], [])
    } else {
        _ -> failure("inventory", "candidate gate report inventory is missing or malformed")
    };
    (let rows = required_reports();
let {archive, digest} = candidate_archive(root, candidate);
if {
    string_field(candidate, "schema") != "terlan.release-candidate.v1" -> failure("schema", "candidate schema is not terlan.release-candidate.v1");
    not metadata_version_matches(root, string_field(candidate, "version")) -> failure("version", "candidate version does not match release metadata");
    seal_digest(candidate) == "" -> failure("seal", "candidate seal is missing");
    metadata_identity(root) == "" -> failure("identity", "release candidate identity is missing");
    archive == "" or digest == "" -> failure("artifact", "sealed archive row is missing");
    not reports_valid(root, rows, sealed) -> failure(
        "reports",
        "a required release report is missing, stale, failing, or not uniquely sealed",
    );
    not cross_hashes_hold(root, archive, digest) -> failure("hash", "archive, supply-chain, and matrix hashes do not agree");
    true -> write_report(root, candidate, archive, digest)
}).

metadata_version_matches(root: String, version: String): Bool ->
    let Ok(metadata) <- Json.parse(text(root, "dist/terlan-release.json")) else {
        _ -> false
    };
    version != "" and EvidenceReports.string_field(metadata, "version") == Some(version).

failure(code: String, message: String): Bool ->
    let _printed = eprintln(String.concat(["error[release_readiness.", code, "]: ", message]));
    false.
