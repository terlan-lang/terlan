/**
 * Structural admission of release outcomes and their candidate/artifact bindings.
 * Unrelated strings and nested decisions never establish a passing outcome.
 */
module release_promotion.EvidenceReports.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Ok}.
import std.data.Json.

import type std.core.Option.
import type std.data.Json.

@pure
pub readiness_reports(): List[{String, String}] ->
    [
        {"target/quality/tvm-aot-platform-matrix-report.json", "terlan.tvm-aot-platform-matrix.v3"},
        {
            "target/quality/tvm-aot-thread-sanitizer-report.json",
            "terlan.tvm-aot-thread-sanitizer.v1",
        },
        {
            "target/quality/vm-multicore-thread-sanitizer-report.json",
            "terlan.vm-multicore-thread-sanitizer.v1",
        },
        {
            "target/quality/vm-multicore-memory-model-tsan.json",
            "terlan.vm-multicore-memory-model.v1",
        },
        {"target/quality/vm-multicore-memory-model.json", "terlan.vm-multicore-memory-model.v1"},
        {
            "target/quality/vm-multicore-release-closeout.json",
            "terlan.vm-multicore-release-closeout.v4",
        },
    ].

@pure
pub preflight_reports(): List[{String, String}] ->
    List.concat(
        readiness_reports(),
        [
            {
                "target/quality/release-readiness-attestation-report.json",
                "terlan.release-readiness-attestation.v1",
            },
            {
                "target/quality/release-staged-distribution-verification-report.json",
                "terlan.release-staged-distribution-verification.v1",
            },
        ],
    ).

pub string_field(document: Json, key: String): Option[String] ->
    when {
        Ok(value) <- document.get(key);
        Ok(text) <- value.as_string()
    } else {
        _ -> None
    };
    Some(text).

pub admitted(source: String, schema: String): Option[Json] ->
    when {
        Ok(document) <- Json.parse(source);
        Some(actual) <- string_field(document, "schema");
        true <- actual == schema;
        Some("pass") <- string_field(document, "decision")
    } else {
        _ -> None
    };
    Some(document).

pub passes(source: String, schema: String): Bool ->
    case admitted(source, schema) {
        Some(_document) -> true;
        None -> false
    }.

pub seal_matches(source: String, schema: String, seal: String): Bool ->
    when {
        true <- seal != "";
        Some(document) <- admitted(source, schema);
        Some(actual) <- string_field(document, "candidate_seal")
    } else {
        _ -> false
    };
    actual == seal.

@pure
pub targets(): List[String] ->
    [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
    ].
