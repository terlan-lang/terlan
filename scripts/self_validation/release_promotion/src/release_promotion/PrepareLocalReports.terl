/**
 * First production graph: managed-list evidence and multicore composition.
 * The preceding correctness gates retain their Make owners and still execute.
 */
module release_promotion.PrepareLocalReports.

import release_promotion.{PreparationContext, PreparationGraph, PrepareManagedList, PrepareMulticoreRelease}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.io.Console.

import type release_promotion.PreparationGraph.Summary.

/**
 * Runs the owned local reports after Make has completed their prerequisite gates.
 */
pub run_locked(root: String, vm: String, image: String): Bool ->
    let {
        Ok(context) <-
            PreparationContext.capture(
                root,
                ["PATH", "HOME", "CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
            );
        Ok(multicore) <- PrepareMulticoreRelease.declare(root, vm, image, context);
        Ok(managed) <- PrepareManagedList.declare(root, context)
    } else {
        Err(reason) ->
            let _printed = Console.eprintln(reason);
            false
    };
    (let result =
    PreparationGraph.run_locked(
        root,
        "local-reports",
        [PreparationGraph.declare_node(managed, []), PreparationGraph.declare_node(multicore, [])],
    );
let _printed = Console.println(message(result));
result.valid).

message(result: Summary): String ->
    if {
        result.valid -> String.concat(
            [
                "[preparation] local reports: completed=",
                Int.to_string(result.completed),
                " reused=",
                Int.to_string(result.reused),
            ],
        );
        true -> result.message
    }.
