/**
 * Proof replay and semantic consumers share fresh source/tool admission.
 * Consumers cannot execute a missing proof and publish only through their owner.
 */
module release_promotion.PrepareProofKernels.

import release_promotion.{OwnerStorage, OwnerTools, PreparationContext, PreparationGraph, PreparationOwner, PrepareProofTrack, ProofInputs}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.io.{Console, File}.
import std.system.Process.{environment_entry}.

import type release_promotion.PreparationContext.Context.
import type release_promotion.PreparationGraph.Summary.
import type release_promotion.PreparationOwner.Owner.
import type std.core.Result.

semantic_owner(root: String, vm: String, image: String, context: Context, replay: Owner): Owner ->
    PreparationOwner.owner(
        "proof-semantic-kernels",
        context.revision,
        "x86_64-unknown-linux-gnu",
        "proof-semantic-consumer",
        replay.tool_identity,
        replay.inputs,
        [vm | [image | replay.dependencies]],
        OwnerStorage.child(root, vm),
        ["run", OwnerStorage.child(root, image), "--script-eval", "--", "check-cached"],
        [environment_entry("TERLAN_SEMANTIC_KERNEL_ROOT", root) | [environment_entry("TERLAN_PROOF_QUALITY_EXECUTABLE", replay.program) | replay.environment]],
        "target/quality/proof-artifacts/lean-semantic-kernels.json",
        "TERLAN_PROOF_SEMANTIC_OUTPUT",
        "terlan.lean-semantic-kernels.v1",
        "Lean semantic kernels passed:",
        1800000,
    ).

image_size(root: String, image: String): Result[Int, String] ->
    case File.size(OwnerStorage.child(root, image)) {
        Ok(size) -> Ok(size);
        Err(reason) -> Err(File.message(reason))
    }.

run_graph(
    root: String,
    quality: String,
    vm: String,
    image: String,
    context: Context,
    workspace: String,
): Result[Summary, String] ->
    let {
        Ok(inputs) <- ProofInputs.replay(root);
        Ok(digest) <- PrepareProofTrack.admit_tools(root, quality, context, workspace)
    } else {
        Err(reason) -> Err(reason)
    };
    (let replay =
    PrepareProofTrack.declare(
        root,
        quality,
        context,
        inputs,
        String.append(workspace, "/tools.json"),
        digest,
    );
let semantic = semantic_owner(root, vm, image, context, replay);
Ok(
    PreparationGraph.run_locked(
        root,
        "proof-kernels",
        [
            PreparationGraph.declare_node(replay, []),
            PreparationGraph.declare_node(semantic, ["proof-track"]),
        ],
    ),
)).

/**
 * Coverage endpoint identity is explicit: a different canonical test admission
 * cannot inherit a semantic report that claims the previous suite's ownership.
 */
pub prepare(root: String, quality: String, vm: String, image: String): Result[Summary, String] ->
    let {
        true <-
            PreparationContext.tool_path(quality)
                and PreparationContext.tool_path(vm)
                and PreparationContext.tool_path(image);
        Ok(context) <-
            PreparationContext.capture(
                root,
                [
                    "PATH",
                    "HOME",
                    "ELAN_HOME",
                    "CARGO_HOME",
                    "RUSTUP_HOME",
                    "RUSTUP_TOOLCHAIN",
                    "TERLAN_RUST_COVERAGE_CONTEXT",
                    "TERLAN_RUST_COVERAGE_SCOPE",
                ],
            );
        Ok(size) <- image_size(root, image);
        true <- size > 0;
        Ok(_version) <- OwnerTools.run(root, OwnerStorage.child(root, vm), ["--version"], context.environment)
    } else {
        Err(reason) -> Err(reason);
        _ -> Err("proof pipeline tools must be inside target/")
    };
    (let workspace = String.concat(["target/quality/preparation/", context.revision, "/proof-tools.work"]);
let result = run_graph(root, quality, vm, image, context, workspace);
if {
    OwnerStorage.clean_workspace(root, workspace) -> result;
    true -> Err("proof pipeline admission workspace cleanup failed")
}).

pub run_locked(root: String, quality: String, vm: String, image: String): Bool ->
    let Ok(result) <- prepare(root, quality, vm, image) else {
        Err(reason) ->
            let _printed = Console.eprintln(reason);
            false
    };
    (let _printed =
    Console.println(
        String.concat(
            [
                "[preparation] proof kernels: completed=",
                Int.to_string(result.completed),
                " reused=",
                Int.to_string(result.reused),
                " ",
                result.message,
            ],
        ),
    );
result.valid).
