/**
 * One source/tool admission and dependency graph for publication's local reports.
 * Correctness gates remain owned by the enclosing live Make coverage graph.
 */
module release_promotion.PrepareReleaseReports.

import release_promotion.{OwnerStorage, OwnerTools, PreparationContext, PreparationGraph, PrepareAotRelease, PrepareManagedList, PrepareMulticoreRelease}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.io.Console.

import type release_promotion.PreparationGraph.Node.
import type std.core.Result.

pub declare(root: String, vm: String, image: String): Result[List[Node], String] ->
    let true <- PreparationContext.tool_path(vm) and PreparationContext.tool_path(image) else {
        _ -> Err("preparation tools must be inside target/")
    };
    (let {
    Ok(context) <-
        PreparationContext.capture(
            root,
            ["PATH", "HOME", "CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
        );
    Ok(version) <- OwnerTools.run(root, OwnerStorage.child(root, vm), ["--version"], context.environment);
    Ok(tools) <- OwnerTools.build_identity(root, context.environment, context.runtime_tools);
    Ok(managed) <- PrepareManagedList.declare_with_tools(context, tools);
    Ok(multicore) <- PrepareMulticoreRelease.declare_with_version(root, vm, image, context, version);
    Ok(aot) <- PrepareAotRelease.declare_with_tools(root, vm, image, context, version, tools)
} else {
    Err(reason) -> Err(reason)
};
Ok(
    [
        PreparationGraph.declare_node(managed, []),
        PreparationGraph.declare_node(multicore, []),
        PreparationGraph.declare_node(aot, [managed.name]),
    ],
)).

pub run_locked(root: String, vm: String, image: String): Bool ->
    let Ok(nodes) <- declare(root, vm, image) else {
        Err(reason) ->
            let _printed = Console.eprintln(reason);
            false
    };
    (let result = PreparationGraph.run_locked(root, "release-reports", nodes);
let _printed =
    Console.println(
        if {
            result.valid -> String.concat(
                [
                    "[preparation] release reports: completed=",
                    Int.to_string(result.completed),
                    " reused=",
                    Int.to_string(result.reused),
                ],
            );
            true -> result.message
        },
    );
result.valid).
