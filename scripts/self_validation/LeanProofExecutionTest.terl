/**
 * Executes one repository Lean proof through a bounded typed process request.
 */
module scripts.self_validation.LeanProofExecutionTest.

import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.io.Console.{println}.
import std.system.{Environment, Process}.

import type std.system.Process.{Command, Output}.

environment_or(name: String, fallback: String): String ->
    case Environment.get(name) {
        Some(value) -> value;
        None -> fallback
    }.

@pure
child(root: String, relative: String): String ->
    if {
        root == "." -> relative;
        String.ends_with(root, "/") -> String.append(root, relative);
        true -> String.append(root, String.append("/", relative))
    }.

@pure
proof_path_is_safe(path: String): Bool ->
    path != ""
        and String.ends_with(path, ".lean")
        and not String.starts_with(path, "/")
        and not String.contains(path, "..")
        and not String.contains(path, "\\").

proof_command(root: String, proof_path: String): Command ->
    let configured =
        Process.command(child(root, "target/debug/terlan-quality"))
            .with_arguments(["lean-proof-replay", String.append("proofs/lean/", proof_path)]);
    configured.with_working_directory(root).with_timeout_ms(600000).with_output_limit_bytes(8388608).

report_failure(message: String): Bool ->
    let _reported = println(message);
    false.

proof_output_holds(output: Output): Bool ->
    if {
        Process.status(output) == 0 -> true;
        true -> report_failure(
            String.concat(
                [
                    "Lean proof failed with status ",
                    Int.to_string(Process.status(output)),
                    "\nstdout:\n",
                    Process.stdout(output),
                    "\nstderr:\n",
                    Process.stderr(output),
                ],
            ),
        )
    }.

proof_holds(root: String, proof_path: String): Bool ->
    if {
        not proof_path_is_safe(proof_path) -> false;
        true -> case Process.run(proof_command(root, proof_path)) {
            Ok(output) -> proof_output_holds(output);
            Err(reason) ->
                report_failure(
                    String.concat(
                        [
                            "Lean proof process failed: ",
                            Process.error_message(reason),
                            " (program: ",
                            Process.error_program(reason),
                            ")",
                        ],
                    ),
                )
        }
    }.

@test
pub selected_lean_task_holds(): Bool ->
    let root = environment_or("TERLAN_LEAN_PROOF_ROOT", ".");
    proof_holds(root, environment_or("TERLAN_LEAN_PROOF_PATH", "parser_shape/ParserShape.lean")).

@test
pub proof_paths_cannot_escape_the_lean_workspace(): Bool ->
    proof_path_is_safe("Terlan/Type/ShapeImplication.lean")
        and not proof_path_is_safe("../outside.lean")
        and not proof_path_is_safe("/tmp/outside.lean")
        and not proof_path_is_safe("not-a-proof.txt").
