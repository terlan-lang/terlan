#!/usr/bin/env -S terlc run
/**
 * Dispatches the typed TVM AOT platform target and aggregation checks.
 */
import std.core.Option.{None, Some}.
import std.core.{String, Unit}.
import std.io.Console.{eprintln}.
import std.system.Arguments.{get}.
import tvm_aot_platform_matrix.AotThreadSanitizer.{run as run_tsan, self_test as tsan_self_test}.
import tvm_aot_platform_matrix.Core.{aggregate, run_target}.
import tvm_aot_platform_matrix.ErlSuiteAudit.{check as check_erl_suite, self_test as erl_suite_self_test}.
import tvm_aot_platform_matrix.MulticoreRelease.{record as record_multicore_release, self_test as multicore_release_self_test, verify as verify_multicore_release}.
import tvm_aot_platform_matrix.MulticoreThreadSanitizer.{run as run_multicore_tsan, self_test as multicore_tsan_self_test}.
import tvm_aot_platform_matrix.ReleaseArtifact.{adversarial as adversarial_release_artifact, describe as describe_release_artifact, installer_smoke as smoke_release_installer, matrix as release_artifact_matrix, metadata as release_artifact_metadata, package as package_release_artifact, repository_root, self_test as release_artifact_self_test, smoke as smoke_release_artifact}.
import tvm_aot_platform_matrix.ReleaseCloseout.{record_local as record_release, self_test as release_self_test, verify_local as verify_release}.
import tvm_aot_platform_matrix.ReleaseGeneratedArtifacts.{finalize as finalize_release_generated_artifacts, record as record_release_generated_artifacts, self_test as release_generated_artifacts_self_test}.
import tvm_aot_platform_matrix.ReleaseInstallerSmoke.{staged as verify_staged_distribution}.
import tvm_aot_platform_matrix.RuntimeReleaseDependencies.{check as check_runtime_release_dependencies, self_test as runtime_release_dependencies_self_test}.
import tvm_aot_platform_matrix.SelfTest.{self_test}.
import tvm_aot_platform_matrix.VmHttpAotConcurrency.{check as check_vm_http_aot_concurrency, self_test as vm_http_aot_concurrency_self_test}.

failure(message: String): Bool ->
    let _printed = eprintln(String.append("error[tvm_aot_platform_matrix.arguments]: ", message));
    false.

entry(): Bool ->
    case get(0) {
        Some("target") -> run_target();
        Some("self-test") -> self_test();
        Some("tsan-run") -> run_tsan();
        Some("tsan-self-test") -> tsan_self_test();
        Some("release-record") -> record_release();
        Some("release-verify") -> verify_release();
        Some("release-self-test") -> release_self_test();
        Some("multicore-tsan-run") -> run_multicore_tsan();
        Some("multicore-tsan-self-test") -> multicore_tsan_self_test();
        Some("multicore-release-record") -> record_multicore_release();
        Some("multicore-release-verify") -> verify_multicore_release();
        Some("multicore-release-self-test") -> multicore_release_self_test();
        Some("release-artifact-describe") -> describe_release_artifact();
        Some("release-artifact-metadata") -> release_artifact_metadata();
        Some("release-artifact-package") -> package_release_artifact();
        Some("release-artifact-smoke") -> smoke_release_artifact();
        Some("release-artifact-installer-smoke") -> smoke_release_installer();
        Some("release-staged-distribution") ->
            let root = repository_root();
            verify_staged_distribution(root);
        Some("release-artifact-matrix") -> release_artifact_matrix();
        Some("release-artifact-adversarial") -> adversarial_release_artifact();
        Some("release-artifact-self-test") -> release_artifact_self_test();
        Some("runtime-release-dependency-check") ->
            let root = repository_root();
            check_runtime_release_dependencies(root);
        Some("runtime-release-dependency-self-test") -> runtime_release_dependencies_self_test();
        Some("release-generated-artifacts-record") ->
            let root = repository_root();
            record_release_generated_artifacts(root);
        Some("release-generated-artifacts-finalize") ->
            let root = repository_root();
            finalize_release_generated_artifacts(root);
        Some("release-generated-artifacts-self-test") -> release_generated_artifacts_self_test();
        Some("vm-http-aot-concurrency-check") ->
            let root = repository_root();
            check_vm_http_aot_concurrency(root);
        Some("vm-http-aot-concurrency-self-test") -> vm_http_aot_concurrency_self_test();
        Some("erl-suite-audit-check") ->
            let root = repository_root();
            check_erl_suite(root);
        Some("erl-suite-audit-self-test") -> erl_suite_self_test();
        Some("aggregate") ->
            case get(1) {
                Some(root) -> aggregate(root);
                None -> failure("aggregate requires REPORT_ROOT")
            };
        Some(value) -> failure(String.append("unknown command `", String.append(value, "`")));
        None -> failure("expected a TVM AOT platform, sanitizer, release, or self-test command")
    }.

assert(entry());
Unit.
