/**
 * Validates and records the distributed multicore VM release closeout.
 */
module tvm_aot_platform_matrix.MulticoreRelease.

import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.String.
import std.crypto.Hash.{sha256, sha256_domain_framed, sha256_file}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.Directory.{create_all}.
import std.io.File.{read_text}.
import std.regex.Regex.
import std.system.Environment.
import std.vcs.Git.{clean, revision, sha256 as source_sha256, source_tree_identity}.
import tvm_aot_platform_matrix.Core.{child, fragments_present, is_sha256, json_bool, json_equals, json_string, json_value, load_json, occurrences, string_array, write_json}.
import tvm_aot_platform_matrix.ReleaseCloseout.{list_equal, make_list_variable}.

import type std.core.Option.
import type std.data.Json.

pub schema(): String -> "terlan.vm-multicore-release-closeout.v4".

invariant_schema(): String -> "terlan.tvm-multicore-invariant-inventory.v1".

is_revision(value: String): Bool ->
    case Regex.compile("^[0-9a-f]{40}$") {
        Ok(pattern) -> Regex.is_match(pattern, value);
        Err(_reason) -> false
    }.

pub local_gates(): List[String] ->
    [
        "vm-multicore-invariant-inventory-check",
        "vm-actor-mutator-ownership-check",
        "vm-multicore-mailbox-publication-check",
        "vm-multicore-fixed-placement-check",
        "tvm-aot-multicore-migration-check",
        "vm-multicore-work-stealing-check",
        "vm-multicore-runtime-cleanup-check",
        "vm-multicore-runtime-integration-check",
        "vm-epmd-discovery-check",
        "vm-multicore-replay-observability-check",
        "vm-multicore-memory-model-check",
        "vm-scheduler-fairness-check",
        "tvm-aot-runtime-transition-check",
        "tvm-managed-memory-check",
        "rust-quality-check",
    ].

failure(message: String): Bool ->
    let _printed = eprintln(String.append("error[vm.multicore.release]: ", message));
    false.

json_clone(value: Json): Option[Json] ->
    let {
        Ok(source) <- Json.stringify(value);
        Ok(copy) <- Json.parse(source)
    } else {
        _ -> None
    };
    Some(copy).

gates_source(values: List[String]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.concat([value, "\n", gates_source(rest)])
    }.

local_gate_graph_sha256(): String ->
    sha256(gates_source(local_gates())).

invariant_revision(inventory: String, contract: String): String ->
    sha256_domain_framed("terlan.vm-multicore-invariants.v1", [inventory, contract]).

release_target(): String ->
    "vm-multicore-release-check: vm-multicore-release-contract-check\n\t$(MAKE) $(VM_MULTICORE_RELEASE_LOCAL_GATES)\n\t$(MAKE) vm-multicore-release-record\n".

pub validate_makefile(makefile: String): Bool ->
    case make_list_variable(makefile, "VM_MULTICORE_RELEASE_LOCAL_GATES") {
        None -> false;
        Some(gates) ->
            if {
                not list_equal(gates, local_gates()) -> false;
                list_equal(gates, []) -> false;
                makefile
                    .contains(
                        "VM_MULTICORE_RELEASE_LOCAL_GATES := \\\n\tvm-multicore-performance-check",
                    ) -> false;
                makefile
                    .contains(
                        "VM_MULTICORE_RELEASE_LOCAL_GATES := \\\n\tvm-multicore-thread-sanitizer-check",
                    ) -> false;
                not makefile.contains(release_target()) -> false;
                not makefile.contains("vm-multicore-publish-evidence-refresh: vm-multicore-release-contract-check") -> false;
                not makefile.contains("vm-multicore-publish-check:") -> false;
                not makefile.contains("$(MAKE) $(VM_MULTICORE_PUBLISH_LOCAL_GATES)") -> false;
                not makefile.contains("$(MAKE) --no-print-directory vm-multicore-publish-check") -> false;
                not makefile.contains("$(TERLAN_TVM_PLATFORM_MATRIX) multicore-release-verify") -> false;
                not makefile.contains("publish-evidence-plan-check:") -> false;
                true -> fragments_present(
                    makefile,
                    [
                        "rustup toolchain list | grep -Eq '^nightly-2026-07-16-'",
                        "rustup target list --installed --toolchain 1.96.0 2>/dev/null | grep -Fqx 'x86_64-unknown-linux-gnutsan'",
                        "error[aot.tsan]: pinned nightly ThreadSanitizer toolchain is mandatory in CI",
                        "error[vm.multicore.tsan]: pinned Rust 1.96.0 ThreadSanitizer target is mandatory in CI",
                    ],
                )
            }
    }.

count_requirements(workflow: String, requirements: List[{String, Int}]): Bool ->
    case requirements {
        [] -> true;
        [{fragment, count} | rest] ->
            occurrences(workflow, fragment) == count and count_requirements(workflow, rest)
    }.

final_check_ordered(workflow: String): Bool ->
    case String.split_once(
    workflow,
    "run: make vm-multicore-release-contract-check tvm-aot-release-closeout-contract-check",
) {
        None -> false;
        Some({prefix, suffix}) ->
            prefix.contains("Download hosted multicore ThreadSanitizer evidence")
                and suffix.contains("Upload hosted release evidence")
    }.

pub validate_workflow(workflow: String): Bool ->
    if {
        not count_requirements(
    workflow,
    [
        {"multicore-evidence:", 0},
        {"multicore-performance:", 0},
        {"run: make vm-multicore-performance-check", 0},
        {"self-hosted", 0},
        {"Install pinned Rust ThreadSanitizer toolchain", 1},
        {"rustup toolchain install nightly-2026-07-16 --profile minimal --component rust-src", 1},
        {"context: \"release-validation/run\"", 2},
        {"      - name: Install release utilities\n", 3},
        {"run: make vm-multicore-thread-sanitizer-check", 1},
        {"name: release-vm-multicore-thread-sanitizer", 2},
        {"run: make vm-multicore-release-contract-check tvm-aot-release-closeout-contract-check", 1},
    ],
) -> false;
        not fragments_present(
    workflow,
    [
        "statuses: write",
        "release-validation-identity:",
        "multicore-thread-sanitizer:",
        "release-hosted-validation-evidence",
        "target/quality/vm-multicore-thread-sanitizer-report.json",
        "target/quality/vm-multicore-memory-model-tsan.json",
        "release-validation-result:",
        "const targetUrl =",
        "/actions/runs/${context.runId}",
        "needs: validate",
        "if: always()",
    ],
) -> false;
        true -> final_check_ordered(workflow)
    }.

pub validate_repository(root: String): Bool ->
    let {
        Ok(makefile) <- read_text(child(root, "Makefile"));
        Ok(workflow) <- read_text(child(root, ".github/workflows/release.yml"))
    } else {
        _ -> false
    };
    if {
        not validate_makefile(makefile) -> false;
        true -> validate_workflow(workflow)
    }.

validate_invariants(inventory: Json): Bool ->
    let {
        Some(report_schema) <- json_string(inventory, "schema");
        Some(contract) <- json_string(inventory, "contract_document");
        Some(upstream) <- json_value(inventory, "upstream");
        Some(upstream_revision) <- json_string(upstream, "revision");
        Some(product_dependency) <- json_bool(upstream, "product_dependency")
    } else {
        _ -> false
    };
    if {
        report_schema != invariant_schema() -> false;
        contract != "docs/runtime/TVM_MULTICORE_CONCURRENCY_CONTRACT.md" -> false;
        not is_revision(upstream_revision) -> false;
        true -> not product_dependency
    }.

mode_valid(mode: String): Bool ->
    mode == "composed".

digest_field_valid(value: Json, field: String): Bool ->
    case json_string(value, field) {
        Some(digest) -> is_sha256(digest);
        None -> false
    }.

string_field_is(value: Json, field: String, expected: String): Bool ->
    case json_string(value, field) {
        Some(actual) -> actual == expected;
        None -> false
    }.

pub validate_closeout(report: Json): Bool ->
    let {
        Some(report_schema) <- json_string(report, "schema");
        Some(decision) <- json_string(report, "decision");
        Some(scope) <- json_string(report, "evidence_scope");
        Some(source_revision) <- json_string(report, "source_revision");
        Some(mode) <- json_string(report, "provenance_mode");
        Some(_source_clean) <- json_bool(report, "source_tree_clean");
        Some(source_digest) <- json_string(report, "source_tree_sha256");
        Some(gate_graph) <- json_value(report, "local_gate_graph");
        Some(gates) <- json_value(gate_graph, "gates");
        Some(invariants) <- json_value(report, "runtime_invariants");
        Some(inventory) <- json_value(invariants, "inventory");
        Some(contract) <- json_value(invariants, "contract");
        Some(evidence) <- json_value(report, "evidence");
        Some(memory_model) <- json_value(evidence, "memory_model");
        Some(thread_sanitizer) <- json_value(evidence, "thread_sanitizer")
    } else {
        _ -> false
    };
    if {
        report_schema != schema() or decision != "pass" -> false;
        scope != "technical" or not mode_valid(mode) -> false;
        not is_revision(source_revision) or not is_sha256(source_digest) -> false;
        not json_equals(gates, string_array(local_gates())) -> false;
        not string_field_is(gate_graph, "sha256", local_gate_graph_sha256()) -> false;
        not digest_field_valid(invariants, "revision") -> false;
        not digest_field_valid(inventory, "sha256") -> false;
        not digest_field_valid(contract, "sha256") -> false;
        not digest_field_valid(memory_model, "sha256") -> false;
        true -> digest_field_valid(thread_sanitizer, "sha256")
    }.

gate_graph_report(): Json ->
    Json.object()
        .put("gates", string_array(local_gates()))
        .put("sha256", Json.string(local_gate_graph_sha256())).

inventory_report(inventory_source: String): Json ->
    Json.object()
        .put("path", Json.string("docs/runtime/TVM_MULTICORE_INVARIANT_INVENTORY.json"))
        .put("schema", Json.string(invariant_schema()))
        .put("sha256", Json.string(sha256(inventory_source))).

contract_report(contract_source: String): Json ->
    Json.object()
        .put("path", Json.string("docs/runtime/TVM_MULTICORE_CONCURRENCY_CONTRACT.md"))
        .put("sha256", Json.string(sha256(contract_source))).

runtime_invariants_report(inventory_source: String, contract_source: String): Json ->
    let inventory = inventory_report(inventory_source);
    let contract = contract_report(contract_source);
    Json.object()
        .put("revision", Json.string(invariant_revision(inventory_source, contract_source)))
        .put("inventory", inventory)
        .put("contract", contract).

memory_model_report(memory_model_digest: String): Json ->
    Json.object()
        .put("path", Json.string("target/quality/vm-multicore-memory-model.json"))
        .put("schema", Json.string("terlan.vm-multicore-memory-model.v1"))
        .put("sha256", Json.string(memory_model_digest)).

thread_sanitizer_report(thread_sanitizer_digest: String): Json ->
    Json.object()
        .put("path", Json.string("target/quality/vm-multicore-thread-sanitizer-report.json"))
        .put("schema", Json.string("terlan.vm-multicore-thread-sanitizer.v1"))
        .put("sha256", Json.string(thread_sanitizer_digest)).

release_report(
    source_revision: String,
    source_digest: String,
    source_clean: Bool,
    inventory_source: String,
    contract_source: String,
    memory_model_digest: String,
    thread_sanitizer_digest: String,
): Json ->
    let gate_graph = gate_graph_report();
    let invariants = runtime_invariants_report(inventory_source, contract_source);
    let evidence =
        Json.object()
            .put("memory_model", memory_model_report(memory_model_digest))
            .put("thread_sanitizer", thread_sanitizer_report(thread_sanitizer_digest));
    Json.object()
        .put("schema", Json.string(schema()))
        .put("decision", Json.string("pass"))
        .put("source_revision", Json.string(source_revision))
        .put("source_tree_sha256", Json.string(source_digest))
        .put("evidence_scope", Json.string("technical"))
        .put("provenance_mode", Json.string("composed"))
        .put("source_tree_clean", Json.bool(source_clean))
        .put("local_gate_graph", gate_graph)
        .put("runtime_invariants", invariants)
        .put("evidence", evidence).

pub build_closeout(
    memory_model: Json,
    thread_sanitizer: Json,
    inventory: Json,
    inventory_source: String,
    contract_source: String,
    source_revision: String,
    source_digest: String,
    source_clean: Bool,
    memory_model_digest: String,
    thread_sanitizer_digest: String,
): Option[Json] ->
    let {
        Some(memory_schema) <- json_string(memory_model, "schema");
        Some(memory_decision) <- json_string(memory_model, "decision");
        Some(sanitizer_schema) <- json_string(thread_sanitizer, "schema");
        Some(sanitizer_decision) <- json_string(thread_sanitizer, "decision");
        Some(sanitizer_revision) <- json_string(thread_sanitizer, "source_revision");
        Some(sanitizer_digest) <- json_string(thread_sanitizer, "source_tree_sha256")
    } else {
        _ -> None
    };
    if {
        memory_schema != "terlan.vm-multicore-memory-model.v1" or memory_decision != "pass" -> None;
        sanitizer_schema != "terlan.vm-multicore-thread-sanitizer.v1"
            or sanitizer_decision != "pass" -> None;
        sanitizer_revision != source_revision or sanitizer_digest != source_digest -> None;
        not validate_invariants(inventory) -> None;
        not is_sha256(memory_model_digest) or not is_sha256(thread_sanitizer_digest) -> None;
        true -> let report =
            release_report(
                source_revision,
                source_digest,
                source_clean,
                inventory_source,
                contract_source,
                memory_model_digest,
                thread_sanitizer_digest,
            );
        if {
            validate_closeout(report) -> Some(report);
            true -> None
        }
    }.

pub record(): Bool ->
    let root = Environment.current_directory();
    let memory_model_path = child(root, "target/quality/vm-multicore-memory-model.json");
    let thread_sanitizer_path = child(root, "target/quality/vm-multicore-thread-sanitizer-report.json");
    let inventory_path = child(root, "docs/runtime/TVM_MULTICORE_INVARIANT_INVENTORY.json");
    let contract_path = child(root, "docs/runtime/TVM_MULTICORE_CONCURRENCY_CONTRACT.md");
    let {
        Some(memory_model) <- load_json(memory_model_path);
        Some(thread_sanitizer) <- load_json(thread_sanitizer_path);
        Ok(inventory_source) <- read_text(inventory_path);
        Ok(inventory) <- Json.parse(inventory_source);
        Ok(contract_source) <- read_text(contract_path);
        Ok(identity) <- source_tree_identity(root);
        Ok(memory_model_digest) <- sha256_file(memory_model_path);
        Ok(thread_sanitizer_digest) <- sha256_file(thread_sanitizer_path);
        Some(report) <-
            build_closeout(
                memory_model,
                thread_sanitizer,
                inventory,
                inventory_source,
                contract_source,
                revision(identity),
                source_sha256(identity),
                clean(identity),
                memory_model_digest,
                thread_sanitizer_digest,
            );
        Ok(_created) <- create_all(child(root, "target/quality"))
    } else {
        _ -> false
    };
    if {
        not write_json(child(root, "target/quality/vm-multicore-release-closeout.json"), report) -> false;
        true -> let _printed = println(String.append("VM multicore release closeout passed: ", revision(identity)));
        true
    }.

/**
 * Verifies the sealed closeout against the current clean source identity and
 * every file digest used to construct it. This is intentionally read-only so
 * publication retries cannot silently replace candidate evidence.
 */
pub verify(): Bool ->
    let root = Environment.current_directory();
    let report_path = child(root, "target/quality/vm-multicore-release-closeout.json");
    let memory_model_path = child(root, "target/quality/vm-multicore-memory-model.json");
    let thread_sanitizer_path = child(root, "target/quality/vm-multicore-thread-sanitizer-report.json");
    let inventory_path = child(root, "docs/runtime/TVM_MULTICORE_INVARIANT_INVENTORY.json");
    let contract_path = child(root, "docs/runtime/TVM_MULTICORE_CONCURRENCY_CONTRACT.md");
    let {
        Some(actual) <- load_json(report_path);
        Some(memory_model) <- load_json(memory_model_path);
        Some(thread_sanitizer) <- load_json(thread_sanitizer_path);
        Ok(inventory_source) <- read_text(inventory_path);
        Ok(inventory) <- Json.parse(inventory_source);
        Ok(contract_source) <- read_text(contract_path);
        Ok(identity) <- source_tree_identity(root);
        Ok(memory_model_digest) <- sha256_file(memory_model_path);
        Ok(thread_sanitizer_digest) <- sha256_file(thread_sanitizer_path);
        Some(expected) <-
            build_closeout(
                memory_model,
                thread_sanitizer,
                inventory,
                inventory_source,
                contract_source,
                revision(identity),
                source_sha256(identity),
                clean(identity),
                memory_model_digest,
                thread_sanitizer_digest,
            )
    } else {
        _ -> failure("sealed publication evidence is missing or malformed")
    };
    if {
        not clean(identity) -> failure("publication evidence requires a clean source tree");
        not validate_closeout(actual) -> failure("sealed publication evidence is invalid");
        not json_equals(actual, expected) -> failure("sealed publication evidence is stale");
        true -> let _printed =
            println(
                String.append("VM multicore publication evidence verified: ", revision(identity)),
            );
        true
    }.

mutation_rejected(report: Json, field: String, value: Json): Bool ->
    case json_clone(report) {
        None -> false;
        Some(copy) ->
            let changed = copy.put(field, value);
            not validate_closeout(changed)
    }.

pub self_test(): Bool ->
    let root = Environment.current_directory();
    let {
        Ok(makefile) <- read_text(child(root, "Makefile"));
        Ok(workflow) <- read_text(child(root, ".github/workflows/release.yml"));
        Ok(inventory_source) <- read_text(child(root, "docs/runtime/TVM_MULTICORE_INVARIANT_INVENTORY.json"));
        Ok(inventory) <- Json.parse(inventory_source);
        Ok(contract_source) <- read_text(child(root, "docs/runtime/TVM_MULTICORE_CONCURRENCY_CONTRACT.md"));
        Some(closeout) <-
            build_closeout(
                Json.object()
                    .put("schema", Json.string("terlan.vm-multicore-memory-model.v1"))
                    .put("decision", Json.string("pass")),
                Json.object()
                    .put("schema", Json.string("terlan.vm-multicore-thread-sanitizer.v1"))
                    .put("decision", Json.string("pass"))
                    .put("source_revision", Json.string("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
                    .put(
                        "source_tree_sha256",
                        Json.string(
                            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
                        ),
                    ),
                inventory,
                inventory_source,
                contract_source,
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
                true,
                "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
                "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            )
    } else {
        _ -> false
    };
    if {
        not validate_makefile(makefile) -> failure("release Make contract drifted");
        not validate_workflow(workflow) -> failure("release workflow contract drifted");
        not validate_closeout(closeout) -> failure("valid release closeout was rejected");
        not mutation_rejected(closeout, "source_tree_sha256", Json.string("not-a-digest")) -> failure("invalid source digest was accepted");
        invariant_revision(inventory_source, contract_source) == invariant_revision(inventory_source, String.append(contract_source, "\nchanged")) -> failure("invariant revision ignored a contract change");
        true -> let _printed = println("VM multicore release composition self-test passed");
        true
    }.
