/**
 * Produces and aggregates executable target-native TVM AOT attestations.
 */
module tvm_aot_platform_matrix.Core.

import std.collections.List.{length}.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.Directory.{create_all, files_recursive}.
import std.io.File.{read_text, write_text}.
import std.regex.Regex.
import std.system.{Environment, Platform, Process}.
import tvm_aot_platform_matrix.ReleaseInstallerSmoke.{smoke as smoke_release_installer}.
import tvm_aot_platform_matrix.ReleasePackage.{package as package_release}.
import tvm_aot_platform_matrix.ReleaseSmoke.{smoke as smoke_release}.

import type std.core.Option.
import type std.data.Json.
import type std.system.Process.Output.

pub struct Target {
    id: String,
    os: String,
    arch: String,
    triple: String,
    object_format: String,
    operating_system: String,
    calling_convention: String,
    runner: String,
}.

pub struct Report {
    target_id: String,
    value: Json,
}.

pub struct ProvenanceInput {
    actions: Bool,
    repository: String,
    workflow_ref: String,
    run_id: String,
    run_attempt: String,
    commit_sha: String,
}.

pub report(target_id: String, value: Json): Report ->
    Report(target_id = target_id, value = value).

pub provenance_input(
    actions: Bool,
    repository: String,
    workflow_ref: String,
    run_id: String,
    run_attempt: String,
    commit_sha: String,
): ProvenanceInput ->
    ProvenanceInput(
        actions = actions,
        repository = repository,
        workflow_ref = workflow_ref,
        run_id = run_id,
        run_attempt = run_attempt,
        commit_sha = commit_sha,
    ).

pub target_schema(): String -> "terlan.tvm-aot-platform-target.v2".

pub matrix_schema(): String -> "terlan.tvm-aot-platform-matrix.v2".

pub official_repository(): String -> "terlan-lang/terlan".

pub child(parent: String, name: String): String ->
    if {
        parent == "." -> name;
        String.ends_with(parent, "/") -> String.append(parent, name);
        true -> String.append(parent, String.append("/", name))
    }.

failure(code: String, message: String): Bool ->
    let _printed =
        eprintln(
            String.append(
                "error[tvm_aot_platform_matrix.",
                String.append(code, String.append("]: ", message)),
            ),
        );
    false.

json_failure(code: String, message: String): Option[Json] ->
    let _failed = failure(code, message);
    None.

reports_failure(code: String, message: String): Option[List[Report]] ->
    let _failed = failure(code, message);
    None.

output_failure(code: String, message: String): Option[Output] ->
    let _failed = failure(code, message);
    None.

