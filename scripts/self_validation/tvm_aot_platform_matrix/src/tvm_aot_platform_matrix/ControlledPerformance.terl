/**
 * Serializes performance evidence owners and rejects a busy measurement host.
 */
module tvm_aot_platform_matrix.ControlledPerformance.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String, Unit}.
import std.io.Console.{eprintln, println}.
import std.system.{Arguments, Environment, Process}.

import type std.core.Option.
import type std.system.Process.Output.

struct CpuSample {
    runnable: Int,
    busy_percent: Int,
}.

failure(message: String): Bool ->
    let _printed = eprintln(String.append("error[performance.control]: ", message));
    false.

arguments_from(index: Int, count: Int): List[String] ->
    if {
        index >= count -> [];
        true -> case Arguments.get(index) {
            Some(value) -> [value | arguments_from(index + 1, count)];
            None -> []
        }
    }.

reverse(values: List[String], output: List[String]): List[String] ->
    case values {
        [] -> output;
        [value | rest] -> reverse(rest, [value | output])
    }.

nonempty(values: List[String], output: List[String]): List[String] ->
    case values {
        [] -> reverse(output, []);
        [value | rest] ->
            if {
                String.trim(value) == "" -> nonempty(rest, output);
                true -> nonempty(rest, [String.trim(value) | output])
            }
    }.

last_nonempty(values: List[String], current: String): String ->
    case values {
        [] -> current;
        [value | rest] ->
            last_nonempty(
                rest,
                if {
                    String.trim(value) == "" -> current;
                    true -> String.trim(value)
                },
            )
    }.

parse_cpu_sample(source: String): Option[CpuSample] ->
    let row = last_nonempty(String.split(source, "\n"), "");
    case nonempty(String.split(row, " "), []) {
        [runnable, _blocked, _swapd, _free, _buff, _cache, _si, _so, _bi, _bo, _interrupts, _switches, user, system, _idle, wait, _steal] ->
            let {
                Some(runnable_count) <- Int.from_string(runnable);
                Some(user_percent) <- Int.from_string(user);
                Some(system_percent) <- Int.from_string(system);
                Some(wait_percent) <- Int.from_string(wait)
            } else {
                _ -> None
            };
            Some(
                CpuSample(
                    runnable = runnable_count,
                    busy_percent = user_percent + system_percent + wait_percent,
                ),
            );
        _ -> None
    }.

run_output(program: String, arguments: List[String], timeout_ms: Int): Option[Output] ->
    let command =
        Process.with_output_limit_bytes(
            Process.with_timeout_ms(
                Process.with_arguments(Process.command(program), arguments),
                timeout_ms,
            ),
            16777216,
        );
    case Process.run(command) {
        Ok(output) -> Some(output);
        Err(reason) ->
            let _printed = eprintln(Process.error_message(reason));
            None
    }.

successful_text(program: String, arguments: List[String], timeout_ms: Int): Option[String] ->
    case run_output(program, arguments, timeout_ms) {
        Some(output) where Process.status(output) == 0 -> Some(String.trim(Process.stdout(output)));
        _ -> None
    }.

flag_requests_dry_run(flag: String): Bool ->
    if {
        flag == "--dry-run" or flag == "--just-print" or flag == "--recon" -> true;
        String.starts_with(flag, "--") -> false;
        true -> String.contains(flag, "n")
    }.

flags_request_dry_run(flags: List[String]): Bool ->
    case flags {
        [] -> false;
        [flag | rest] -> flag_requests_dry_run(flag) or flags_request_dry_run(rest)
    }.

make_requests_dry_run(): Bool ->
    case Environment.get("MAKEFLAGS") {
        Some(flags) -> flags_request_dry_run(nonempty(String.split(flags, " "), []));
        None -> false
    }.

runtime_root(): String ->
    case Environment.get("XDG_RUNTIME_DIR") {
        Some(value) where String.trim(value) != "" -> String.trim(value);
        _ -> "/tmp"
    }.

print_completion(output: Output): Unit ->
    let _stdout =
        if {
            Process.stdout(output) == "" -> Unit;
            true -> println(String.trim_end(Process.stdout(output)))
        };
    if {
        Process.stderr(output) == "" -> Unit;
        true -> eprintln(String.trim_end(Process.stderr(output)))
    }.

execute(program: String, arguments: List[String], locked: Bool): Bool ->
    let lock_path = String.append(runtime_root(), "/terlan-controlled-performance.lock");
    let executable =
        if {
            locked -> "flock";
            true -> program
        };
    let executable_arguments =
        if {
            locked -> List.concat(
                ["--exclusive", "--nonblock", "--conflict-exit-code", "75", lock_path, program],
                arguments,
            );
            true -> arguments
        };
    case run_output(executable, executable_arguments, 600000) {
        Some(output) ->
            let _printed = print_completion(output);
            if {
                Process.status(output) == 0 -> true;
                Process.status(output) == 75 -> failure(String.append("another performance owner holds ", lock_path));
                true -> failure(
                    String.concat(
                        [program, " exited with status ", Int.to_string(Process.status(output))],
                    ),
                )
            };
        None -> failure(String.append("could not execute ", executable))
    }.

host_is_quiet(): Bool ->
    let {
        Some(cpu_text) <- successful_text("getconf", ["_NPROCESSORS_ONLN"], 5000);
        Some(cpu_count) <- Int.from_string(cpu_text);
        Some(vmstat) <- successful_text("vmstat", ["1", "3"], 10000);
        Some(sample) <- parse_cpu_sample(vmstat)
    } else {
        _ -> failure("could not measure host quiescence with getconf and vmstat")
    };
    (let maximum_runnable =
    if {
        cpu_count > 2 -> cpu_count / 2;
        true -> 1
    };
if {
    sample.busy_percent > 20 or sample.runnable > maximum_runnable -> failure(
        String.concat(
            [
                "host is busy (r=",
                Int.to_string(sample.runnable),
                ", busy=",
                Int.to_string(sample.busy_percent),
                "%, cpus=",
                Int.to_string(cpu_count),
                "); retry after competing work finishes",
            ],
        ),
    );
    true -> let _printed =
        println(
            String.concat(
                [
                    "[performance.lease] host is quiet (r=",
                    Int.to_string(sample.runnable),
                    ", busy=",
                    Int.to_string(sample.busy_percent),
                    "%, cpus=",
                    Int.to_string(cpu_count),
                    ")",
                ],
            ),
        );
    true
}).

pub run(): Bool ->
    let arguments = arguments_from(2, Arguments.count());
    case arguments {
        [] -> failure("controlled-performance requires a command after --");
        [program | command_arguments] ->
            if {
                make_requests_dry_run() -> execute(program, command_arguments, false);
                host_is_quiet() -> execute(program, command_arguments, true);
                true -> false
            }
    }.

pub self_test(): Bool ->
    let sample = "procs -----------memory---------- ---swap-- -----io---- -system-- ------cpu-----\n r  b   swpd   free   buff  cache   si   so    bi    bo   in   cs us sy id wa st\n 1  0      0 100000  10000 200000    0    0     0     0  100  200  5  3 90  2  0\n";
    let parsed = parse_cpu_sample(sample);
    case parsed {
        Some(value) ->
            value.runnable == 1
                and value.busy_percent == 10
                and not flags_request_dry_run(["--no-print-directory"])
                and flags_request_dry_run(["n", "--no-print-directory"])
                and flags_request_dry_run(["krn", "--jobserver-auth=3,4"])
                and flags_request_dry_run(["--dry-run"]);
        None -> false
    }.
