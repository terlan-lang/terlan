module tvm_aot_platform_matrix.WorkflowContractTest.

import std.core.Result.{Err, Ok}.
import std.core.String.
import std.io.File.{read_text}.
import tvm_aot_platform_matrix.Core.{compiled_cache_text_valid, compiler_before_platform_text_valid, release_audit_before_platform_text_valid, source_preflight_text_valid}.
import tvm_aot_platform_matrix.MulticoreRelease.{validate_workflow as multicore_release_workflow_valid}.

@test
pub current_release_workflow_is_accepted_by_every_validator(): Bool ->
    when {
        Ok(source) <- read_text(".github/workflows/release.yml")
    } else {
        Err(_reason) -> false
    };
    (let normalized = String.replace(source, "\r\n", "\n");
release_audit_before_platform_text_valid(normalized)
    and multicore_release_workflow_valid(normalized)).

@test
pub release_platforms_cannot_bypass_dependency_auditing(): Bool ->
    when {
        Ok(source) <- read_text(".github/workflows/release.yml")
    } else {
        Err(_reason) -> false
    };
    (let normalized = String.replace(source, "\r\n", "\n");
let bypassed = String.replace(normalized, "needs: [revision, dependency-audit]", "needs: revision");
normalized != bypassed
    and not release_audit_before_platform_text_valid(bypassed)
    and not multicore_release_workflow_valid(bypassed)).

@test
pub generated_artifact_selection_is_statically_complete(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/source-preflight.yml");
        Ok(makefile) <- read_text("Makefile")
    } else {
        Err(_reason) -> false
    };
    source_preflight_text_valid(workflow, makefile)
        and not source_preflight_text_valid(
    String.replace(
        workflow,
        "TERLAN_GENERATED_JS_BINDINGS:",
        "TERLAN_GENERATED_JS_BINDINGS_MISSING:",
    ),
    makefile,
).

@test
pub script_runner_cache_is_compact_and_versioned(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-terlan-script-runner/action.yml")
    } else {
        Err(_reason) -> false
    };
    action.contains("terlan-script-runner-v4-")
        and action.contains("allow-compatible-fallback:")
        and action.contains("default: \"false\"")
        and action.contains("Compile current change classifier")
        and action.contains("scripts_ClassifyChanges.tvm")
        and action.contains("classifier-image=")
        and action.contains("terlan-ci-programs-v1-")
        and action.contains("scripts_CheckRustFormatting.tvm")
        and action.contains("scripts_CheckTerlanStyle.tvm")
        and action.contains("rust-format-image=")
        and action.contains("terlan-style-image=")
        and action.contains("strip --strip-unneeded target/script-runner/terlc target/script-runner/terlan-vm")
        and action.contains("target/script-runner/terlc)\" -le 157286400")
        and action.contains("target/script-runner/terlan-vm)\" -le 125829120").

@test
pub compiled_dependency_cache_survives_source_only_commits(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-rust/action.yml")
    } else {
        Err(_reason) -> false
    };
    compiled_cache_text_valid(action)
        and not action.contains("\"$GITHUB_SHA\"")
        and action.contains("terlan-rust-dependencies-v1-")
        and not action.contains("terlan-rust-build-v4-").

@test
pub source_preflight_never_compiles_rust_tests(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/source-preflight.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("terlc }} test scripts/self_validation/InventoryTest.terl")
        and not workflow.contains("cargo test")
        and not workflow.contains("cache-build: \"true\"")
        and workflow.contains("cache-registry: \"false\"")
        and workflow.contains("steps.script-runner.outputs.rust-format-image")
        and workflow.contains("steps.script-runner.outputs.terlan-style-image")
        and workflow.contains("--script-eval --").

@test
pub compiler_validation_starts_beside_source_preflight(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/ci.yml");
        Ok(hook) <- read_text("scripts/git_hooks/check.sh")
    } else {
        Err(_reason) -> false
    };
    compiler_before_platform_text_valid(workflow)
        and workflow.contains("TERLAN_HOSTED_SOURCE_PREFLIGHT: \"1\"")
        and hook.contains("TERLAN_HOSTED_SOURCE_PREFLIGHT:-0")
        and hook.contains("planner_arguments+=(--hosted-source-preflight)")
        and hook.contains("[[ \"$hosted_source_preflight\" == 0 ]]")
        and hook.contains("local validation plan omitted source inventory")
        and hook.contains("run_affected_rust_lane")
        and hook.contains("early affected Rust lane passed")
        and hook.contains("mv \"$remaining_plan\" \"$plan\"")
        and not compiler_before_platform_text_valid(
    workflow
        .replace(
            "needs: changes\n    name: Compiler check and test",
            "needs: [changes, source-preflight]\n    name: Compiler check and test",
        ),
).

@test
pub script_runner_never_relabels_an_old_compiler_as_current(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-terlan-script-runner/action.yml");
        Ok(workflow) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    action.contains("terlan-script-runner-v4-")
        and action.contains("key: \${{ steps.identity.outputs.key }}")
        and action.contains("if: \${{ steps.restored.outputs.usable != 'true' }}")
        and occurrences(workflow, "allow-compatible-fallback: \"true\"") == 1.

@test
pub cancelled_main_validation_is_accumulated_by_the_next_run(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("actions: read")
        and workflow.contains("github.rest.actions.listWorkflowRuns")
        and workflow.contains("github.rest.actions.listJobsForWorkflowRun")
        and workflow.contains("const batchSize = 10")
        and workflow.contains("const jobsByRun = await Promise.all")
        and workflow.contains("job.name === \"Compiler check and test\"")
        and workflow.contains("compiler?.conclusion === \"success\"")
        and workflow.contains("git merge-base --is-ancestor \"$base\" \"$GITHUB_SHA\"")
        and workflow.contains("validation-base: \${{ steps.validation-base.outputs.revision }}")
        and occurrences(workflow, "needs.changes.outputs.validation-base") == 2.

@test
pub release_reuse_requires_full_dispatched_compiler_evidence(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/release.yml");
        Ok(compiler) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("run.event !== \"workflow_dispatch\"")
        and workflow.contains("github.rest.actions.listJobsForWorkflowRun")
        and workflow.contains("\"Locked dependency security audit\"")
        and workflow.contains("\"Compiler check and test\"")
        and workflow.contains("compiler_run_id lacks successful required job")
        and compiler
    .contains(
        "if: \${{ github.event_name == 'workflow_dispatch' }}\n        run: make release-candidate-check",
    )
        and compiler
    .contains(
        "if: \${{ github.event_name != 'workflow_dispatch' }}\n        env:\n          BASE_REVISION:",
    )
        and compiler.contains("TERLAN_HOOK_MODE=full")
        and compiler
    .contains(
        "if: \${{ github.ref == 'refs/heads/main' && github.event_name == 'workflow_dispatch' }}",
    ).
