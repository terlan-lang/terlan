module tvm_aot_platform_matrix.WorkflowContractTest.

import std.core.Result.{Err, Ok}.
import std.core.String.
import std.io.File.{read_text}.
import tvm_aot_platform_matrix.Core.{compiled_cache_text_valid, compiler_before_platform_text_valid, hosted_release_graph_valid, release_audit_before_platform_text_valid, source_preflight_text_valid}.
import tvm_aot_platform_matrix.MulticoreRelease.{validate_makefile as multicore_release_makefile_valid, validate_repository as multicore_release_repository_valid, validate_workflow as multicore_release_workflow_valid}.

@test
pub current_release_workflow_is_accepted_by_every_validator(): Bool ->
    when {
        Ok(source) <- read_text(".github/workflows/release.yml")
    } else {
        Err(_reason) -> false
    };
    (let normalized = String.replace(source, "\r\n", "\n");
release_audit_before_platform_text_valid(normalized)
    and multicore_release_workflow_valid(normalized)).

@test
pub current_multicore_contract_uses_the_composed_make_graph(): Bool ->
    when {
        Ok(root_makefile) <- read_text("Makefile")
    } else {
        Err(_reason) -> false
    };
    not multicore_release_makefile_valid(root_makefile) and multicore_release_repository_valid(".").

@test
pub release_platforms_cannot_bypass_dependency_auditing(): Bool ->
    when {
        Ok(source) <- read_text(".github/workflows/release.yml")
    } else {
        Err(_reason) -> false
    };
    (let normalized = String.replace(source, "\r\n", "\n");
let bypassed = String.replace(normalized, "needs: [revision, dependency-audit]", "needs: revision");
normalized != bypassed
    and not release_audit_before_platform_text_valid(bypassed)
    and not multicore_release_workflow_valid(bypassed)).

@test
pub hosted_release_graph_requires_every_publication_owner(): Bool ->
    when {
        Ok(makefile) <- read_text("mk/release-publish.mk")
    } else {
        Err(_reason) -> false
    };
    hosted_release_graph_valid(makefile)
        and not hosted_release_graph_valid(String.replace(makefile, " release-hosted-publication-verifier", "")).

@test
pub generated_artifact_selection_is_statically_complete(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/source-preflight.yml");
        Ok(makefile) <- read_text("Makefile")
    } else {
        Err(_reason) -> false
    };
    source_preflight_text_valid(workflow, makefile)
        and not source_preflight_text_valid(
    String.replace(
        workflow,
        "TERLAN_GENERATED_JS_BINDINGS:",
        "TERLAN_GENERATED_JS_BINDINGS_MISSING:",
    ),
    makefile,
).

@test
pub script_runner_cache_is_compact_and_versioned(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-terlan-script-runner/action.yml")
    } else {
        Err(_reason) -> false
    };
    action.contains("terlan-script-runner-v5-")
        and action.contains("allow-compatible-fallback:")
        and action.contains("default: \"false\"")
        and action.contains("!crates/**/*_test.rs")
        and action.contains("!crates/**/*_test/**/*.rs")
        and action.contains("terlan-ci-classifier-v1-")
        and action.contains("target/ci-classifier")
        and action.contains("steps.restore.outputs.cache-matched-key")
        and action.contains("CANDIDATE_RUNNER_KEY")
        and action.contains("Compile current change classifier")
        and action.contains("scripts_ClassifyChanges.tvm")
        and action.contains("classifier-image=")
        and action.contains("terlan-ci-programs-v3-")
        and action.contains("scripts_CheckRustFormatting.tvm")
        and action.contains("scripts_CheckTerlanStyle.tvm")
        and action.contains("rust-format-image=")
        and action.contains("terlan-style-image=")
        and action.contains("rust-quality-image=")
        and action.contains("scripts_RustQuality.tvm")
        and action.contains("strip --strip-unneeded target/script-runner/terlc target/script-runner/terlan-vm")
        and action.contains("target/script-runner/terlc)\" -le 157286400")
        and action.contains("target/script-runner/terlan-vm)\" -le 125829120").

@test
pub compiled_dependency_cache_survives_source_only_commits(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-rust/action.yml")
    } else {
        Err(_reason) -> false
    };
    compiled_cache_text_valid(action)
        and not action.contains("\"$GITHUB_SHA\"")
        and action.contains("terlan-rust-dependencies-v1-")
        and not action.contains("terlan-rust-build-v4-").

@test
pub source_preflight_never_compiles_rust_tests(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/source-preflight.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("name: Check Rust lint allowance policy")
        and workflow.contains("name: Check Rust lint allowance policy\n        if: $")
        and workflow.contains("allow-compatible-fallback: \"true\"")
        and workflow.contains("name: Check changed Rust file sizes\n        if: $")
        and workflow.contains("steps.script-runner.outputs.rust-quality-image")
        and workflow.contains("lint-allowance-check")
        and workflow.contains("lint-allowance-changed-check")
        and workflow.contains("git diff --name-only -z --diff-filter=ACMR")
        and workflow.contains("docs/quality/RUST_LINT_ALLOWANCES.tsv")
        and workflow.contains("scripts/ci/scripts/CheckRustFileSizes.terls")
        and workflow.contains("--revisions \"$BASE_REVISION\" \"$HEAD_REVISION\" \"$FORMAT_ALL\"")
        and not workflow.contains("cargo test")
        and not workflow.contains("cache-build: \"true\"")
        and workflow.contains("cache-registry: \"false\"")
        and workflow.contains("steps.script-runner.outputs.rust-format-image")
        and workflow.contains("steps.script-runner.outputs.terlan-style-image")
        and workflow.contains("--script-eval --").

@test
pub source_contracts_gate_compiler_validation(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/ci.yml");
        Ok(hook) <- read_text("scripts/git_hooks/check.sh");
        Ok(quality) <- read_text("mk/code-quality.mk")
    } else {
        Err(_reason) -> false
    };
    compiler_before_platform_text_valid(workflow)
        and workflow.contains("TERLAN_HOSTED_SOURCE_PREFLIGHT: \"1\"")
        and workflow.contains("TERLAN_HOSTED_DEPENDENCY_AUDIT: \"1\"")
        and workflow.contains("TERLAN_RUST_LINT_ALLOWANCE_PRECHECKED: \"1\"")
        and quality.contains("ifeq ($(TERLAN_RUST_LINT_ALLOWANCE_PRECHECKED),1)")
        and quality.contains("[rust-lint-allowances] reused early source-preflight result")
        and not quality
    .contains("rust-lint-allowance-check: rust-cargo-metadata-report terlan-rust-quality-bootstrap")
        and hook.contains("TERLAN_HOSTED_SOURCE_PREFLIGHT:-0")
        and hook.contains("TERLAN_HOSTED_DEPENDENCY_AUDIT:-0")
        and hook.contains("planner_arguments+=(--hosted-source-preflight)")
        and hook.contains("[[ \"$hosted_dependency_audit\" == 1 ]]")
        and hook.contains("Rust dependency security audit owned by dedicated hosted job")
        and hook.contains("locked Node dependency security audit owned by dedicated hosted job")
        and hook.contains("run_affected_rust_lane")
        and hook.contains("early affected Rust lane passed")
        and hook.contains("mv \"$remaining_plan\" \"$plan\"")
        and not compiler_before_platform_text_valid(
    workflow
        .replace(
            "needs: [changes, source-preflight]\n    name: Compiler check and test",
            "needs: changes\n    name: Compiler check and test",
        ),
).

@test
pub compiler_order_contract_is_line_ending_independent(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    (let windows = workflow.replace("\n", "\r\n");
compiler_before_platform_text_valid(workflow)
    and compiler_before_platform_text_valid(windows)
    and not compiler_before_platform_text_valid(
    windows
        .replace(
            "needs: [changes, source-preflight]\r\n    name: Compiler check and test",
            "needs: changes\r\n    name: Compiler check and test",
        ),
)).

@test
pub script_runner_never_relabels_an_old_compiler_as_current(): Bool ->
    when {
        Ok(action) <- read_text(".github/actions/setup-terlan-script-runner/action.yml");
        Ok(workflow) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    action.contains("terlan-script-runner-v5-")
        and action.contains("key: \${{ steps.identity.outputs.key }}")
        and action.contains("if: \${{ steps.restored.outputs.usable != 'true' }}")
        and occurrences(workflow, "allow-compatible-fallback: \"true\"") == 1.

@test
pub cancelled_main_validation_is_accumulated_by_the_next_run(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("actions: read")
        and workflow.contains("github.rest.actions.listWorkflowRuns")
        and workflow.contains("github.rest.actions.listJobsForWorkflowRun")
        and workflow.contains("retries: 3")
        and workflow.contains("for (const run of candidates)")
        and not workflow.contains("const jobsByRun = await Promise.all")
        and workflow.contains("job.name === \"Compiler check and test\"")
        and workflow.contains("compiler?.conclusion === \"success\"")
        and workflow.contains("git merge-base --is-ancestor \"$base\" \"$GITHUB_SHA\"")
        and workflow.contains("MANUAL_VALIDATED_REVISION: \${{ inputs.validated_revision || '' }}")
        and workflow.contains("git merge-base --is-ancestor \"$MANUAL_VALIDATED_REVISION\" \"$GITHUB_SHA\"")
        and workflow.contains("validation-base: \${{ steps.validation-base.outputs.revision }}")
        and occurrences(workflow, "needs.changes.outputs.validation-base") == 3.

@test
pub release_reuse_requires_exact_compiler_evidence(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/release.yml");
        Ok(compiler) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("run.event !== \"workflow_dispatch\"")
        and workflow.contains("github.rest.actions.listJobsForWorkflowRun")
        and not workflow.contains("\"Locked dependency security audit\"")
        and workflow.contains("\"Compiler check and test\"")
        and workflow.contains("compiler_run_id lacks successful required job")
        and compiler.contains("validated_revision:")
        and compiler.contains("description: Exact ancestor already validated by the normal local hook")
        and compiler.contains("timeout-minutes: 15")
        and compiler.contains("Reuse unchanged compiler validation")
        and compiler
    .contains(
        "if: \${{ github.event_name == 'workflow_dispatch' && needs.changes.outputs.compiler == 'true' }}\n        run: make release-candidate-check",
    )
        and compiler.contains("TERLAN_TEST_PHASE_TIMEOUT_SECONDS: \"600\"")
        and compiler
    .contains(
        "if: \${{ github.event_name == 'workflow_dispatch' && needs.changes.outputs.compiler != 'true' }}",
    )
        and compiler.contains("Compiler inputs unchanged since validated revision $VALIDATED_REVISION")
        and compiler
    .contains(
        "if: \${{ github.event_name != 'workflow_dispatch' }}\n        env:\n          BASE_REVISION:",
    )
        and compiler.contains("TERLAN_HOOK_MODE=full")
        and compiler.contains("github.event_name == 'push' || github.event_name == 'workflow_dispatch'")
        and compiler.contains("always() && needs.changes.outputs.compiler == 'true'")
        and compiler
    .contains(
        "if: \${{ github.ref == 'refs/heads/main' && github.event_name == 'workflow_dispatch' && needs.changes.outputs.compiler == 'true' }}",
    )
        and workflow.contains("validated_release_run_id:")
        and workflow.contains("name: reuse validated release evidence")
        and workflow.contains("validated release evidence cannot cross compiler inputs")
        and workflow.contains("validated release evidence diff exceeds the bounded admission window")
        and workflow.contains("run-id: \${{ inputs.validated_release_run_id }}")
        and workflow.contains("needs.revision.outputs.reuse-release-evidence != 'true'")
        and workflow.contains("needs.reuse-validation.result == 'success'").

@test
pub scheduled_type_fuzzing_is_bounded_and_rotating(): Bool ->
    when {
        Ok(workflow) <- read_text(".github/workflows/type-fuzz.yml");
        Ok(compiler) <- read_text(".github/workflows/ci.yml")
    } else {
        Err(_reason) -> false
    };
    workflow.contains("schedule:")
        and workflow.contains("timeout-minutes: 15")
        and workflow.contains("permissions:\n  contents: read")
        and workflow.contains("cancel-in-progress: false")
        and workflow.contains("make --no-print-directory terlan-compiler-bootstrap")
        and workflow.contains("ROTATION: \${{ inputs.rotation || github.run_number }}")
        and workflow.contains("fuzz profile scheduled")
        and workflow.contains("--rotation \"$ROTATION\"")
        and workflow.contains("if: \${{ always() }}")
        and workflow.contains("target/fuzz/profile/scheduled")
        and workflow.contains("if-no-files-found: ignore")
        and not workflow.contains("date +")
        and not workflow.contains("sha256")
        and occurrences(compiler, "\".github/workflows/type-fuzz.yml\"") == 2.
