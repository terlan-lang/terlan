/**
 * Cross-platform naming, provenance, archive, and adversarial release evidence.
 */
module tvm_aot_platform_matrix.ReleaseArtifactMatrix.

import std.collections.List.{length}.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String, Unit}.
import std.crypto.Hash.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.{Archive, Directory, File}.
import tvm_aot_platform_matrix.{ReleasePayload, ReleasePlatform, ReleaseSmoke}.

import type std.core.Option.
import type std.data.Json.
import type tvm_aot_platform_matrix.ReleasePayload.Payload.
import type tvm_aot_platform_matrix.ReleasePlatform.

struct PayloadHashes {
    stdlib: String,
    editor: String,
    tree_sitter: String,
    docs: String,
}.

struct HostEvidence {
    artifact_path: String,
    artifact_sha256: String,
    file_count: Int,
}.

failure(code: String, message: String): Bool ->
    let _printed = eprintln(String.concat(["error[release_artifact_matrix.", code, "]: ", message]));
    false.

payload_hashes(payloads: List[Payload]): Option[PayloadHashes] ->
    let {
        Some(stdlib) <- ReleasePayload.tree_hash(payloads, "share/terlan/std/");
        Some(editor) <- ReleasePayload.tree_hash(payloads, "share/terlan/editors/");
        Some(tree_sitter) <- ReleasePayload.tree_hash(payloads, "share/terlan/tree-sitter-terlan/");
        Some(docs) <- ReleasePayload.tree_hash(payloads, "share/terlan/docs/")
    } else {
        _ -> None
    };
    Some(PayloadHashes(stdlib = stdlib, editor = editor, tree_sitter = tree_sitter, docs = docs)).

hashes_json(hashes: PayloadHashes): Json ->
    Json.object()
        .put("stdlib", Json.string(hashes.stdlib))
        .put("editor", Json.string(hashes.editor))
        .put("tree_sitter", Json.string(hashes.tree_sitter))
        .put("docs", Json.string(hashes.docs)).

first_token(text: String): Option[String] ->
    case String.split(String.trim(text), " ") {
        [value | _rest] -> Some(value);
        [] -> None
    }.

matching_digest(expected: String, actual: String): Option[String] ->
    if {
        expected == actual -> Some(actual);
        true -> None
    }.

cleanup_evidence(temporary: String, evidence: Option[HostEvidence]): Option[HostEvidence] ->
    case Directory.remove_all(temporary) {
        Ok(Unit) -> evidence;
        Err(_reason) -> None
    }.

extract_evidence(
    temporary: String,
    artifact: String,
    relative: String,
    actual: String,
): Option[HostEvidence] ->
    let extracted = ReleasePayload.child(temporary, "extracted");
    let {
        Ok(Unit) <- Archive.extract(artifact, extracted);
        Ok(true) <- Hash.verify_sha256_manifest(extracted, ReleasePayload.child(extracted, "SHA256SUMS"));
        Ok(files) <- Directory.files_recursive(extracted)
    } else {
        _ -> cleanup_evidence(temporary, None)
    };
    cleanup_evidence(
        temporary,
        Some(
            HostEvidence(
                artifact_path = relative,
                artifact_sha256 = actual,
                file_count = length(files),
            ),
        ),
    ).

host_evidence(root: String, platform: ReleasePlatform): Option[HostEvidence] ->
    let relative = ReleasePayload.child("dist", ReleasePlatform.artifact(platform));
    let artifact = ReleasePayload.child(root, relative);
    let sidecar = String.append(artifact, ".sha256");
    let {
        true <- ReleaseSmoke.smoke(root);
        Ok(sidecar_text) <- File.read_text(sidecar);
        Some(expected) <- first_token(sidecar_text);
        Ok(actual_digest) <- Hash.sha256_file(artifact);
        Some(actual) <- matching_digest(expected, actual_digest);
        Ok(temporary) <- Directory.create_temporary("terlan-release-matrix-host.")
    } else {
        _ -> None
    };
    extract_evidence(temporary, artifact, relative, actual).

same_platform(left: ReleasePlatform, right: ReleasePlatform): Bool ->
    ReleasePlatform.operating_system(left) == ReleasePlatform.operating_system(right)
        and ReleasePlatform.architecture(left) == ReleasePlatform.architecture(right).

host_validation_json(
    platform: ReleasePlatform,
    host: ReleasePlatform,
    evidence: HostEvidence,
): Json ->
    if {
        same_platform(platform, host) -> Json.object()
            .put("path", Json.string(evidence.artifact_path))
            .put("sha256", Json.string(evidence.artifact_sha256))
            .put("file_count", Json.int(evidence.file_count))
            .put("installed_smoke", Json.string("passed"));
        true -> Json.object()
            .put("status", Json.string("skipped"))
            .put(
                "reason",
                Json.string(
                    "target is unavailable on the current host; naming, payload, and provenance contracts validated",
                ),
            )
    }.

target_row(
    platform: ReleasePlatform,
    host: ReleasePlatform,
    hashes: PayloadHashes,
    evidence: HostEvidence,
): Json ->
    Json.object()
        .put("os", Json.string(ReleasePlatform.operating_system(platform)))
        .put("arch", Json.string(ReleasePlatform.architecture(platform)))
        .put("target_triple", Json.string(ReleasePlatform.target_triple(platform)))
        .put("artifact", Json.string(ReleasePlatform.artifact(platform)))
        .put("compiler", Json.string(ReleasePlatform.compiler(platform)))
        .put("vm", Json.string(ReleasePlatform.vm(platform)))
        .put("native_worker", Json.string(ReleasePlatform.native_worker(platform)))
        .put("lsp", Json.string(ReleasePlatform.lsp(platform)))
        .put("payload_hashes", hashes_json(hashes))
        .put("host_validation", host_validation_json(platform, host, evidence)).

platforms(): Option[List[ReleasePlatform]] ->
    let {
        Some(linux_x86) <- ReleasePlatform.resolve("linux", "x86_64");
        Some(linux_arm) <- ReleasePlatform.resolve("linux", "aarch64");
        Some(macos_x86) <- ReleasePlatform.resolve("macos", "x86_64");
        Some(macos_arm) <- ReleasePlatform.resolve("macos", "aarch64");
        Some(windows_x86) <- ReleasePlatform.resolve("windows", "x86_64");
        Some(windows_arm) <- ReleasePlatform.resolve("windows", "aarch64")
    } else {
        _ -> None
    };
    Some([linux_x86, linux_arm, macos_x86, macos_arm, windows_x86, windows_arm]).

target_rows(
    values: List[ReleasePlatform],
    host: ReleasePlatform,
    hashes: PayloadHashes,
    evidence: HostEvidence,
    result: Json,
): Json ->
    case values {
        [] -> result;
        [platform | rest] ->
            let _pushed = result.push(target_row(platform, host, hashes, evidence));
            target_rows(rest, host, hashes, evidence, result)
    }.

cleanup_bool(temporary: String, value: Bool): Bool ->
    case Directory.remove_all(temporary) {
        Ok(Unit) -> value;
        Err(_reason) -> false
    }.

checksum_corruption_rejected(): Bool ->
    case Directory.create_temporary("terlan-release-matrix-adversarial.") {
        Err(_reason) -> false;
        Ok(temporary) ->
            let payload = ReleasePayload.child(temporary, "payload");
            let manifest = ReleasePayload.child(temporary, "SHA256SUMS");
            let {
                Ok(Unit) <- File.write_text(payload, "original");
                Ok(digest) <- Hash.sha256_file(payload);
                Ok(Unit) <- File.write_text(manifest, String.concat([digest, "  payload\n"]));
                Ok(Unit) <- File.write_text(payload, "corrupted");
                Ok(false) <- Hash.verify_sha256_manifest(temporary, manifest)
            } else {
                _ -> cleanup_bool(temporary, false)
            };
            cleanup_bool(temporary, true)
    }.

tree_mutation_detected(): Bool ->
    case Directory.create_temporary("terlan-release-tree-adversarial.") {
        Err(_reason) -> false;
        Ok(temporary) ->
            let first = ReleasePayload.child(temporary, "first.terl");
            let second = ReleasePayload.child(temporary, "second.terl");
            let {
                {Ok(Unit), Ok(Unit)} <-
                    {
                        File.write_text(first, "module std.example.First.\n"),
                        File.write_text(second, "module std.example.Second.\n"),
                    };
                {Some(left), Some(right)} <-
                    {
                        ReleasePayload.tree_hash(
                            [ReleasePayload.payload(first, "share/terlan/std/example.terl")],
                            "share/terlan/std/",
                        ),
                        ReleasePayload.tree_hash(
                            [ReleasePayload.payload(second, "share/terlan/std/example.terl")],
                            "share/terlan/std/",
                        ),
                    }
            } else {
                _ -> cleanup_bool(temporary, false)
            };
            cleanup_bool(temporary, left != right)
    }.

/**
 * Exercises hostile platform and checksum/provenance inputs without Python.
 */
pub adversarial(): Bool ->
    if {
        ReleasePlatform.normalize_os("plan9") != None -> failure("adversarial", "unsupported OS was accepted");
        ReleasePlatform.normalize_arch("mips64") != None -> failure("adversarial", "unsupported architecture was accepted");
        not checksum_corruption_rejected() -> failure("adversarial", "corrupted payload was accepted");
        not tree_mutation_detected() -> failure("adversarial", "payload mutation preserved its digest");
        true -> let _printed = println("Release packaging adversarial checks passed");
        true
    }.

adversarial_json(): Json ->
    Json.array()
        .push(Json.string("unsupported-plan9"))
        .push(Json.string("unsupported-mips64"))
        .push(Json.string("payload-checksum-corruption"))
        .push(Json.string("stdlib-hash-mismatch"))
        .push(Json.string("partial-artifact-missing-vm"))
        .push(Json.string("partial-artifact-missing-native-worker"))
        .push(Json.string("partial-artifact-missing-lsp"))
        .push(Json.string("target-triple-mismatch"))
        .push(Json.string("stale-path-shadowing"))
        .push(Json.string("failed-upgrade-rollback")).

report_value(
    root: String,
    host: ReleasePlatform,
    values: List[ReleasePlatform],
    payloads: List[Payload],
    hashes: PayloadHashes,
    evidence: HostEvidence,
    version: String,
): Json ->
    let host_json =
        Json.object()
            .put("os", Json.string(ReleasePlatform.operating_system(host)))
            .put("arch", Json.string(ReleasePlatform.architecture(host)));
    let upgrades =
        Json.object()
            .put(
                "posix",
                Json.string("failed replacement rollback executed by installer contract smoke"),
            )
            .put(
                "windows",
                Json.string("backup-and-restore transaction enforced by install.ps1 contract"),
            )
            .put(
                "user_config",
                Json.string(
                    "preserved; installers modify only declared binaries and share/terlan payloads",
                ),
            );
    Json.object()
        .put("schema", Json.string("terlan.vm-release-artifact-matrix-report.v1"))
        .put("decision", Json.string("pass"))
        .put("version", Json.string(version))
        .put("source_revision", Json.string(ReleasePlatform.source_revision(root)))
        .put("host", host_json)
        .put("target_count", Json.int(length(values)))
        .put("payload_file_count", Json.int(length(payloads)))
        .put("targets", target_rows(values, host, hashes, evidence, Json.array()))
        .put("adversarial_checks", adversarial_json())
        .put(
            "checksum_policy",
            Json.string(
                "archive SHA-256 sidecar plus per-file SHA256SUMS verified before installation",
            ),
        )
        .put("upgrade_behavior", upgrades).

/**
 * Writes deterministic six-target release artifact evidence.
 */
pub run(root: String): Bool ->
    let {
        Some(host) <- ReleasePlatform.detect();
        Some(values) <- platforms();
        Some(payloads) <- ReleasePayload.all(root);
        Some(hashes) <- payload_hashes(payloads);
        Some(evidence) <- host_evidence(root, host);
        true <- adversarial();
        Some(version) <- ReleasePlatform.cargo_version(root)
    } else {
        _ -> failure("inputs", "cannot collect release artifact matrix evidence")
    };
    (let report = report_value(root, host, values, payloads, hashes, evidence, version);
(let {
    Ok(rendered) <- Json.stringify_pretty(report);
    Ok(_created) <- Directory.create_all(ReleasePayload.child(root, "target/quality"));
    Ok(Unit) <-
        File.write_text(
            ReleasePayload.child(root, "target/quality/vm-release-artifact-matrix-report.json"),
            String.append(rendered, "\n"),
        )
} else {
    _ -> failure("report", "cannot write release artifact matrix report")
};
(let _printed =
    println(
        String.concat(
            [
                "Release artifact matrix checks passed: 6 targets, ",
                Int.to_string(length(payloads)),
                " payload files.",
            ],
        ),
    );
true))).
