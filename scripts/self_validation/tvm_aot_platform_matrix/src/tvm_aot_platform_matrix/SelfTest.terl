/**
 * Adversarial fixtures for the TVM AOT platform matrix contract.
 */
module tvm_aot_platform_matrix.SelfTest.

import std.core.Option.{None, Some}.
import std.core.Result.{Ok}.
import std.core.String.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.File.{read_text}.
import std.system.Environment.
import tvm_aot_platform_matrix.Core.{build_matrix, compiled_cache_preservation_text_valid, compiled_cache_text_valid, hosted_matrix_valid, json_string, matrix_schema, native_setup_text_valid, official_repository, platform_runner_text_valid, provenance, provenance_input, put_execution_fields, put_target_artifact, put_target_identity, release_trigger_valid, report, string_array, targets, workflow_contract, workflow_text_valid}.

import type std.core.Option.
import type std.data.Json.
import type tvm_aot_platform_matrix.Core.{ProvenanceInput, Report, Target}.

failure(message: String): Bool ->
    let _printed = eprintln(String.append("error[tvm_aot_platform_matrix.self_test]: ", message));
    false.

fixture_report(target: Target): Json ->
    let identity = put_target_identity(Json.object(), target);
    let artifact =
        put_target_artifact(
            identity,
            "self-test",
            "self-test-revision",
            "abababababababababababababababababababababababababababababababab",
            "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
            Json.array().push(Json.int(1)),
            2,
        );
    put_execution_fields(
        artifact,
        Json.string("github-actions"),
        Json.string(official_repository()),
        Json.string("terlan-lang/terlan/.github/workflows/ci.yml@refs/heads/main"),
        Json.int(100),
        Json.int(1),
        Json.string("self-test-revision-full-sha"),
    ).

reverse_reports(values: List[Report], reversed: List[Report]): List[Report] ->
    case values {
        [] -> reversed;
        [value | rest] -> reverse_reports(rest, [value | reversed])
    }.

fixture_reports_at(values: List[Target], reversed: List[Report]): List[Report] ->
    case values {
        [] -> reverse_reports(reversed, []);
        [target | rest] ->
            let value = fixture_report(target);
            let entry = report(target.id, value);
            fixture_reports_at(rest, [entry | reversed])
    }.

fixture_reports(values: List[Target]): List[Report] ->
    fixture_reports_at(values, []).

replace_last_with(field: String, value: Json): Option[List[Report]] ->
    case targets() {
        [one, two, three, four, five, six] ->
            Some(
                [
                    report(one.id, fixture_report(one)),
                    report(two.id, fixture_report(two)),
                    report(three.id, fixture_report(three)),
                    report(four.id, fixture_report(four)),
                    report(five.id, fixture_report(five)),
                    report(six.id, fixture_report(six).put(field, value)),
                ],
            );
        _ -> None
    }.

matrix_present(reports: List[Report]): Bool ->
    case build_matrix(reports) {
        Some(_matrix) -> true;
        None -> false
    }.

matrix_rejects(field: String, value: Json): Bool ->
    case replace_last_with(field, value) {
        Some(reports) -> not matrix_present(reports);
        None -> false
    }.

matrix_accepts(field: String, value: Json): Bool ->
    case replace_last_with(field, value) {
        Some(reports) -> matrix_present(reports);
        None -> false
    }.

json_option_present(value: Option[Json]): Bool ->
    case value {
        Some(_json) -> true;
        None -> false
    }.

matrix_schema_valid(value: Json): Bool ->
    case json_string(value, "schema") {
        Some(schema) -> schema == matrix_schema();
        None -> false
    }.

github_input(repository: String, run_id: String, commit: String): ProvenanceInput ->
    provenance_input(true, repository, "workflow", run_id, "1", commit).

provenance_self_test(): Bool ->
    let local = provenance("local-revision", provenance_input(false, "", "", "", "", ""));
    if {
        not json_option_present(local) -> false;
        not json_option_present(
    provenance(
        "self-test-revision",
        github_input(official_repository(), "100", "self-test-revision-full-sha"),
    ),
) -> false;
        json_option_present(
            provenance(
                "self-test-revision",
                github_input(official_repository(), "not-numeric", "self-test-revision-full-sha"),
            ),
        ) -> false;
        json_option_present(
            provenance(
                "self-test-revision",
                github_input("fork/terlan", "100", "self-test-revision-full-sha"),
            ),
        ) -> false;
        true -> not json_option_present(
    provenance("self-test-revision", github_input(official_repository(), "100", "unrelated-commit")),
)
    }.

self_test_assertions(
    ci: String,
    native_setup: String,
    rust_setup: String,
    platform_runner: String,
    valid_matrix: Json,
    incomplete: List[Report],
): Bool ->
    let normalized_ci = String.replace(ci, "\r\n", "\n");
    let crlf_ci = String.replace(normalized_ci, "\n", "\r\n");
    let shared_aggregation =
        String.replace(
            normalized_ci,
            "make tvm-aot-platform-aggregate-check",
            "make release-hosted-validation-check",
        );
    let missing_aggregation =
        String.replace(
            shared_aggregation,
            "make release-hosted-validation-check",
            "make unrelated-check",
        );
    let missing_dispatch = String.replace(normalized_ci, "  workflow_dispatch:\n", "");
    let wrong_runner = String.replace(normalized_ci, "runner: windows-11-arm", "runner: windows-2025");
    let missing_row = String.replace(normalized_ci, "          - target: linux-x86_64\n", "");
    let missing_install =
        String.replace(
            normalized_ci,
            "        uses: ./.github/actions/setup-native-dependencies\n",
            "",
        );
    let missing_pkgconf = String.replace(native_setup, " \"pkgconf:$triplet\"", "");
    let masked_installer_failure = String.replace(native_setup, "$LASTEXITCODE -ne 0", "$false");
    let missing_lean_fallback =
        String.replace(
            native_setup,
            "repos/leanprover/lean4/releases/tags/$lean_tag",
            "github.com/leanprover/lean4/releases/download/$lean_tag",
        );
    let missing_lean_retry = String.replace(native_setup, "lean_download_attempts=4", "lean_download_attempts=1");
    let missing_lean_checksum =
        String.replace(
            native_setup,
            "07a633cc8d9151cbc08825ea4cdda50d4b02a2c9cb852c0131b13046f49cad7f",
            "unchecked",
        );
    let missing_lean_arm_checksum =
        String.replace(
            native_setup,
            "b1bf1d3c586b76cf4a86212a595d8b9edd99f438a41cce85d5780fa9347c811b",
            "unchecked",
        );
    let missing_lean_link =
        String.replace(
            native_setup,
            "elan toolchain link \"$lean_toolchain\" \"$lean_root\"",
            "true",
        );
    let missing_authenticated_fallback =
        String.replace(
            native_setup,
            "https://api.github.com/repos/lexxmark/winflexbison/releases/tags/v2.5.24",
            "https://github.com/lexxmark/winflexbison/releases/download/v2.5.24",
        );
    let missing_prefetch_retry = String.replace(native_setup, "$prefetchAttempts = 4", "$prefetchAttempts = 1");
    let missing_install_retry = String.replace(native_setup, "$installAttempts = 4", "$installAttempts = 1");
    let missing_flex_checksum =
        String.replace(
            native_setup,
            "dc89fcdaa7071fbbf88b0755b799d69223240c28736924b4c30968c08e7e0b116c7e05ae98a9257be26a1dfb4aa70a628808a6b6018706bf857555c5b4335018",
            "unchecked",
        );
    let missing_compiled_cache = String.replace(rust_setup, "target/release/deps", "target/release/omitted");
    let missing_cache_preservation =
        String.replace(
            normalized_ci,
            "uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
            "uses: actions/cache/omitted@55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
        );
    let isolated_platform_runner = String.append(platform_runner, "\ntarget/self-validation/tvm-aot-platform-cargo");
    if {
        not workflow_contract() -> false;
        not workflow_text_valid(crlf_ci) -> failure("workflow checker rejected Windows line endings");
        not workflow_text_valid(shared_aggregation) -> failure("workflow checker rejected shared aggregation");
        workflow_text_valid(missing_aggregation) -> failure("workflow checker admitted missing aggregation");
        workflow_text_valid(missing_dispatch)
            or workflow_text_valid(wrong_runner)
            or workflow_text_valid(missing_row)
            or workflow_text_valid(missing_install) -> failure("workflow checker admitted invalid input");
        not native_setup_text_valid(native_setup) -> failure("native dependency action rejected valid input");
        native_setup_text_valid(missing_pkgconf)
            or native_setup_text_valid(masked_installer_failure)
            or native_setup_text_valid(missing_lean_fallback)
            or native_setup_text_valid(missing_lean_retry)
            or native_setup_text_valid(missing_lean_checksum)
            or native_setup_text_valid(missing_lean_arm_checksum)
            or native_setup_text_valid(missing_lean_link)
            or native_setup_text_valid(missing_authenticated_fallback)
            or native_setup_text_valid(missing_prefetch_retry)
            or native_setup_text_valid(missing_install_retry)
            or native_setup_text_valid(missing_flex_checksum) -> failure("native dependency checker admitted invalid input");
        not compiled_cache_text_valid(rust_setup) -> failure("compiled cache action rejected valid input");
        compiled_cache_text_valid(missing_compiled_cache) -> failure("compiled cache checker admitted incomplete inputs");
        not compiled_cache_preservation_text_valid(normalized_ci) -> failure("compiled cache preservation rejected valid input");
        compiled_cache_preservation_text_valid(missing_cache_preservation) -> failure("compiled cache preservation admitted incomplete inputs");
        not platform_runner_text_valid(platform_runner) -> failure("platform runner rejected the shared build target");
        platform_runner_text_valid(isolated_platform_runner) -> failure("platform runner admitted an isolated duplicate build target");
        not provenance_self_test() -> failure("provenance checker admitted invalid input");
        not matrix_schema_valid(valid_matrix) -> failure("valid matrix did not aggregate");
        not hosted_matrix_valid(valid_matrix, "self-test-revision-full-sha") -> failure("hosted matrix rejected its exact candidate revision");
        hosted_matrix_valid(valid_matrix, "unrelated-revision") -> failure("hosted matrix admitted another candidate revision");
        hosted_matrix_valid(
            valid_matrix.put("decision", Json.string("failure")),
            "self-test-revision-full-sha",
        ) -> failure("hosted matrix admitted changed aggregate metadata");
        hosted_matrix_valid(
            valid_matrix.put("targets", Json.array()),
            "self-test-revision-full-sha",
        ) -> failure("hosted matrix admitted an empty target set");
        hosted_matrix_valid(
            valid_matrix.put("targets", Json.array().push(Json.object())),
            "self-test-revision-full-sha",
        ) -> failure("hosted matrix admitted a malformed target row");
        matrix_present(incomplete) -> failure("incomplete executable checks passed");
        not matrix_rejects("decision", Json.string("skipped")) -> failure("skipped row passed");
        not matrix_rejects("calling_convention", Json.string("forged")) -> failure("forged ABI passed");
        not matrix_rejects("source_revision", Json.string("mixed-revision")) -> failure("mixed revision passed");
        not matrix_rejects("execution_environment", Json.string("local")) -> failure("local row passed");
        not matrix_rejects("run_id", Json.int(101)) -> failure("mixed run passed");
        not matrix_rejects("run_attempt", Json.int(0)) -> failure("non-positive run attempt passed");
        not matrix_accepts("run_attempt", Json.int(2)) -> failure("independent retry attempt was rejected");
        not matrix_rejects("commit_sha", Json.string("unrelated-commit")) -> failure("unrelated commit passed");
        not matrix_rejects("descriptor_digest", Json.string("not-a-digest")) -> failure("invalid descriptor digest passed");
        not matrix_rejects("image_sha256", Json.string("CDCD")) -> failure("invalid image digest passed");
        not matrix_rejects("continuation_ids", Json.array()) -> failure("empty continuations passed");
        not matrix_rejects("native_debug_record_count", Json.int(1)) -> failure("missing debug records passed");
        true -> let _printed = println("TVM AOT platform matrix self-test passed");
        true
    }.

self_test_with_matrix(
    ci: String,
    native_setup: String,
    rust_setup: String,
    platform_runner: String,
    valid_matrix: Json,
): Bool ->
    case replace_last_with("executed_checks", string_array(["compiler-generated-image"])) {
        Some(incomplete) ->
            self_test_assertions(
                ci,
                native_setup,
                rust_setup,
                platform_runner,
                valid_matrix,
                incomplete,
            );
        None -> failure("cannot construct incomplete fixture")
    }.

self_test_with_ci(
    ci: String,
    native_setup: String,
    rust_setup: String,
    platform_runner: String,
): Bool ->
    let fixture_targets = targets();
    let reports = fixture_reports(fixture_targets);
    case build_matrix(reports) {
        Some(valid_matrix) ->
            self_test_with_matrix(ci, native_setup, rust_setup, platform_runner, valid_matrix);
        None -> failure("cannot construct valid matrix fixture")
    }.

pub self_test(): Bool ->
    let root = Environment.current_directory();
    case {
        read_text(String.append(root, "/.github/workflows/ci.yml")),
        read_text(String.append(root, "/.github/workflows/release.yml")),
        read_text(String.append(root, "/.github/actions/setup-native-dependencies/action.yml")),
        read_text(String.append(root, "/.github/actions/setup-rust/action.yml")),
        read_text(
            String.append(
                root,
                "/scripts/self_validation/tvm_aot_platform_matrix/src/tvm_aot_platform_matrix/Core.terl",
            ),
        ),
    } {
        {Ok(ci), Ok(release), Ok(native_setup), Ok(rust_setup), Ok(platform_runner)} ->
            let missing_compiler_evidence =
                String.replace(
                    release,
                    "name: Reuse exact Compiler CI evidence",
                    "name: Omitted evidence",
                );
            let duplicate_preflight =
                String.append(
                    release,
                    "\n  duplicate:\n    uses: ./.github/workflows/source-preflight.yml\n",
                );
            if {
                not release_trigger_valid(release) -> failure("release workflow rejected exact Compiler CI evidence reuse");
                release_trigger_valid(missing_compiler_evidence) -> failure("release workflow admitted missing Compiler CI evidence reuse");
                release_trigger_valid(duplicate_preflight) -> failure("release workflow admitted duplicate source preflight");
                true -> self_test_with_ci(ci, native_setup, rust_setup, platform_runner)
            };
        _ -> failure("cannot read platform workflow fixtures")
    }.
