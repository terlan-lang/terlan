performance_policy_fields(mut policy: Json): Json ->
    policy
        .put("schema", Json.string(performance_policy_schema()))
        .put("dedicated_runner_label", Json.string(dedicated_runner()))
        .put("requested_runner_label", Json.string(dedicated_runner()))
        .put("enforced", Json.bool(true))
        .put("status", Json.string("passed"))
        .put("record_only_reason", Json.null())
        .put("observed_two_scheduler_median_speedup", fixture_float(1.75))
        .put("observed_two_scheduler_confidence_lower_bound", fixture_float(1.5))
        .put("mixed_tail", mixed_tail_fixture()).

performance_policy_fixture(): Json ->
    performance_policy_fields(Json.object()).

scheduler_measurement(width: Int): Json ->
    Json.object()
        .put("requested_schedulers", Json.int(width))
        .put("overlap_proven", Json.bool(true))
        .put("maximum_simultaneously_active_schedulers", Json.int(width)).

measurements_fixture(): Json ->
    Json.array()
        .push(scheduler_measurement(1))
        .push(scheduler_measurement(2))
        .push(scheduler_measurement(4)).

performance_overlap_fixture(mut report: Json): Json ->
    report
        .put("measurements", measurements_fixture())
        .put(
            "mixed_load_tail",
            Json.object()
                .put("cpu_overlap_proven", Json.bool(true))
                .put("maximum_simultaneously_active_schedulers", Json.int(2)),
        ).

pub synthetic_performance(): Json ->
    performance_overlap_fixture(
        performance_digests_fixture(performance_identity_fixture())
            .put("performance_policy", performance_policy_fixture()),
    ).

sanitizer_header_fixture(): Json ->
    Json.object()
        .put("schema", Json.string(Sanitizer.schema()))
        .put("decision", Json.string("pass"))
        .put("host", Json.string("linux-x86_64"))
        .put("toolchain", Json.string(Sanitizer.toolchain()))
        .put(
            "rustc",
            Json.string(
                String.concat(["rustc ", Sanitizer.toolchain(), " (pinned)\nbinary: rustc"]),
            ),
        )
        .put("instrumented_target", Json.string(Sanitizer.target()))
        .put("test_name", Json.string(Sanitizer.test_name()))
        .put("seed_count", Json.int(Sanitizer.seed_count())).

sanitizer_evidence_fixture(mut report: Json): Json ->
    report
        .put(
            "stress_report_sha256",
            Json.string("cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"),
        )
        .put("source_revision", Json.string("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
        .put("source_tree_clean", Json.bool(true))
        .put(
            "source_tree_sha256",
            Json.string("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"),
        ).

sanitizer_provenance_fixture(mut report: Json): Json ->
    report
        .put("execution_environment", Json.string("github-actions"))
        .put("repository", Json.string(official_repository()))
        .put(
            "workflow_ref",
            Json.string("terlan-lang/terlan/.github/workflows/release.yml@refs/tags/v0.0.7"),
        )
        .put("run_id", Json.int(7))
        .put("run_attempt", Json.int(1))
        .put("commit_sha", Json.string("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")).

pub synthetic_sanitizer(): Json ->
    sanitizer_provenance_fixture(sanitizer_evidence_fixture(sanitizer_header_fixture())).

local_provenance(): Json ->
    Json.object()
        .put("execution_environment", Json.string("local"))
        .put("source_tree_clean", Json.bool(false))
        .put("repository", Json.null())
        .put("workflow_ref", Json.null())
        .put("run_id", Json.null())
        .put("run_attempt", Json.null())
        .put("commit_sha", Json.null())
        .put("runner_name", Json.null())
        .put("runner_environment", Json.null()).

contract_files_valid(root: String): Bool ->
    let {
        Ok(makefile) <- read_text(child(root, "Makefile"));
        Ok(release) <- read_text(child(root, ".github/workflows/release.yml"))
    } else {
        _ -> false
    };
    makefile.contains("vm-multicore-mc9-evidence-contract-check:")
        and makefile.contains("vm-multicore-mc9-evidence-check:")
        and makefile.contains("vm-multicore-mc9-local-evidence-check:")
        and makefile.contains("vm-multicore-publish-evidence-refresh: vm-multicore-release-contract-check")
        and makefile.contains("vm-multicore-publish-check:")
        and makefile.contains("$(TERLAN_TVM_PLATFORM_MATRIX) multicore-mc9-seal")
        and makefile.contains("bash scripts/run_controlled_performance.sh --")
        and makefile.contains("$(MAKE) vm-multicore-mc9-local-evidence-check")
        and makefile.contains("$(MAKE) --no-print-directory vm-multicore-publish-check")
        and release.contains("run: make vm-multicore-thread-sanitizer-check")
        and release.contains("release-hosted-validation-evidence")
        and not release.contains("self-hosted")
        and not release.contains("multicore-runner-watchdog:")
        and not release.contains("run: make vm-multicore-performance-check").

mutation_rejected(performance: Json, sanitizer: Json, field: String, value: Json): Bool ->
    case json_clone(performance) {
        None -> false;
        Some(copy) ->
            let changed = copy.put(field, value);
            case build_closeout(
    changed,
    sanitizer,
    "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
    "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
) {
                None -> true;
                Some(_value) -> false
            }
    }.

pub self_test(): Bool ->
    let performance = synthetic_performance();
    let sanitizer = synthetic_sanitizer();
    let {
        Some(closeout) <-
            build_closeout(
                performance,
                sanitizer,
                "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
                "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            );
        Some(rerun_sanitizer) <- json_clone(sanitizer);
        Some(rerun_closeout) <-
            build_closeout(
                performance,
                rerun_sanitizer.put("run_attempt", Json.int(2)),
                "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
                "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            );
        Some(local_performance) <- json_clone(performance);
        Some(local_sanitizer) <- json_clone(sanitizer)
    } else {
        _ -> false
    };
    (let updated_local_performance = local_performance.put("provenance", local_provenance());
let local_sanitizer_source =
    local_sanitizer
        .put("source_tree_clean", Json.bool(false))
        .put("execution_environment", Json.string("local"));
let local_sanitizer_identity =
    local_sanitizer_source
        .put("repository", Json.null())
        .put("workflow_ref", Json.null())
        .put("run_id", Json.null())
        .put("run_attempt", Json.null())
        .put("commit_sha", Json.null());
case build_closeout(
    updated_local_performance,
    local_sanitizer_identity,
    "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
    "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
) {
    None -> failure("valid local MC-9 evidence was rejected");
    Some(local_closeout) ->
        if {
            not validate_closeout(closeout) -> failure("valid MC-9 closeout was rejected");
            not string_field_is(closeout, "provenance_mode", "github-single-attempt") -> failure("same-attempt evidence was misclassified");
            not string_field_is(rerun_closeout, "provenance_mode", "distributed") -> failure("partial rerun was misclassified");
            not string_field_is(local_closeout, "provenance_mode", "local") -> failure("local evidence was misclassified");
            not mutation_rejected(performance, sanitizer, "eligible_for_parallel_assertion", Json.bool(false)) -> failure("record-only evidence was accepted");
            not mutation_rejected(performance, sanitizer, "rustc_version", Json.string("rustc stable")) -> failure("unfixed compiler was accepted");
            not contract_files_valid(Environment.current_directory()) -> failure("repository MC-9 contract drifted");
            true -> let _printed = println("VM multicore MC-9 evidence self-test passed");
            true
        }
}).
