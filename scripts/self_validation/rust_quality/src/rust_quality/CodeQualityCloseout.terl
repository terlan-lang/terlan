/**
 * Validates the permanent 0.0.7 code-quality closeout contract.
 */
module rust_quality.CodeQualityCloseout.

import rust_quality.{CargoMetadata, SourceInventory}.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.File.

import type std.data.Json.

@pure
required_slices(): List[String] -> ["CQ-0", "CQ-1", "CQ-2", "CQ-3", "CQ-4", "CQ-5"].

@pure
required_gates(): List[String] ->
    [
        "rust-code-quality-preflight-check",
        "rust-structure-census-check",
        "rust-module-structure-check",
        "rust-file-headroom-check",
        "rust-build-graph-boundary-check",
        "rust-dependency-impact-check",
        "rust-api-boundary-quality-check",
        "rust-canonical-type-ownership-check",
        "test-hierarchy-check",
        "shared-helper-check",
        "dormant-runtime-code-check",
        "safe-rust-runtime-check",
        "roadmap-gate-integrity-check",
        "release-code-hygiene-check",
        "code-quality-0-0-7-feedback-loop-check",
        "rust-structure-closeout-timings-check",
        "code-quality-0-0-7-closeout-check",
    ].

@pure
slice_checked(source: String, name: String): Bool ->
    let heading = String.append("## ", String.append(name, ":"));
    case String.split_once(source, heading) {
        None -> false;
        Some({_before, tail}) ->
            case String.split_once(tail, "\n## ") {
                None -> String.contains(tail, "\n- [x] ");
                Some({section, _rest}) -> String.contains(section, "\n- [x] ")
            }
    }.

@pure
all_slices_checked(source: String, slices: List[String]): Bool ->
    case slices {
        [] -> true;
        [slice | rest] -> slice_checked(source, slice) and all_slices_checked(source, rest)
    }.

@pure
make_target_present(source: String, target: String): Bool ->
    String.starts_with(source, String.append(target, ":"))
        or String.contains(source, String.concat(["\n", target, ":"])).

@pure
all_targets_present(source: String, targets: List[String]): Bool ->
    case targets {
        [] -> true;
        [target | rest] ->
            make_target_present(source, target) and all_targets_present(source, rest)
    }.

@pure
uncommented_rows(lines: List[String], count: Int): Int ->
    case lines {
        [] -> count;
        [line | rest] ->
            let trimmed = String.trim(line);
            uncommented_rows(
                rest,
                if {
                    trimmed == "" or String.starts_with(trimmed, "#") -> count;
                    true -> count + 1
                },
            )
    }.

zero_baseline(root: String, relative: String): Bool ->
    case File.read_text(SourceInventory.child(root, relative)) {
        Err(_reason) -> false;
        Ok(source) -> uncommented_rows(String.split(source, "\n"), 0) == 0
    }.

lint_inventory_empty(root: String): Bool ->
    case File.read_text(SourceInventory.child(root, "docs/quality/RUST_LINT_ALLOWANCES.tsv")) {
        Err(_reason) -> false;
        Ok(source) -> uncommented_rows(String.split(source, "\n"), 0) == 1
    }.

string_array(document: Json, field: String): List[String] ->
    let {
        Ok(value) <- document.get(field);
        Some(values) <- CargoMetadata.string_array(value)
    } else {
        _ -> List.new[String]()
    };
    values.

all_zero(values: List[Int]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> value == 0 and all_zero(rest)
    }.

zero_debt(document: Json): Bool ->
    let {
        Ok(value) <- document.get("zero_debt");
        Ok(fields) <-
            value
                .required_fields(
                    [],
                    [
                        "lint_allowances",
                        "oversized_files",
                        "numbered_fragments",
                        "handwritten_includes",
                        "cross_tree_paths",
                        "unsafe_without_safety_comment",
                        "rustdoc_baseline_rows",
                        "inline_test_baseline_rows",
                        "file_size_baseline_rows",
                    ],
                    [],
                )
    } else {
        _ -> false
    };
    all_zero(Json.required_field_ints(fields)).

report_valid(document: Json): Bool ->
    let {
        Ok(schema_value) <- document.get("schema_version");
        Ok(schema) <- schema_value.as_int();
        Ok(decision_value) <- document.get("decision");
        Ok(decision) <- decision_value.as_string();
        Ok(canonical) <- document.get("canonical_types");
        Ok(canonical_fields) <- canonical.required_fields([], ["parse_failures", "exact_normalized_duplicates"], [])
    } else {
        _ -> false
    };
    schema == 1
        and decision == "pass"
        and string_array(document, "completed_slices") == required_slices()
        and string_array(document, "gates") == required_gates()
        and all_zero(Json.required_field_ints(canonical_fields))
        and zero_debt(document).

pub check(root: String): Bool ->
    let {
        Ok(roadmap) <-
            File.read_text(
                SourceInventory.child(root, "docs/roadmap/ROADMAP_0_0_7_CODE_QUALITY.md"),
            );
        Ok(makefile) <- File.read_text(SourceInventory.child(root, "Makefile"));
        Ok(quality_makefile) <- File.read_text(SourceInventory.child(root, "mk/code-quality.mk"));
        Ok(report_source) <-
            File.read_text(
                SourceInventory.child(root, "docs/quality/RUST_CODE_QUALITY_CLOSEOUT.json"),
            );
        Ok(report) <- Json.parse(report_source)
    } else {
        _ ->
            let _printed =
                eprintln(
                    "Code-quality 0.0.7 closeout failed: required evidence is missing or invalid",
                );
            false
    };
    (let make_source = String.concat([makefile, "\n", quality_makefile]);
let valid =
    all_slices_checked(roadmap, required_slices())
        and all_targets_present(make_source, required_gates())
        and report_valid(report)
        and lint_inventory_empty(root)
        and zero_baseline(root, "tools/quality/rust_file_size_baseline.tsv")
        and zero_baseline(root, "tools/quality/rust_inline_test_baseline.txt")
        and zero_baseline(root, "tools/quality/rustdoc_missing_baseline.tsv");
if {
    valid -> let _printed =
        println(
            "Code-quality 0.0.7 closeout passed: typed gates own current structure and historical evidence is intact",
        );
    true;
    true -> let _printed =
        eprintln(
            "Code-quality 0.0.7 closeout failed: roadmap, gate, zero-debt, or historical evidence drifted",
        );
    false
}).

pub self_test(): Bool ->
    let roadmap = "## CQ-0: A\n\n- [x] done\n## CQ-1: B\n\n- [ ] pending\n";
    slice_checked(roadmap, "CQ-0")
        and not slice_checked(roadmap, "CQ-1")
        and make_target_present("alpha:\n\ttrue\nbeta: alpha\n", "alpha")
        and make_target_present("alpha:\n\ttrue\nbeta: alpha\n", "beta")
        and not make_target_present("alpha:\n", "missing")
        and uncommented_rows(["# comment", "", "value"], 0) == 1.
