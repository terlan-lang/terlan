/**
 * Records median-backed recurring Rust structure timing evidence.
 */
module rust_quality.StructureTimingRegression.

import rust_quality.{CompilationInputs, SourceInventory, StructureTimings}.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Float, Int, String}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.File.
import std.system.{Environment, Platform}.
import std.vcs.Git.

import type rust_quality.StructureTimings.{Measurements, TimingRow}.
import type std.core.Option.
import type std.data.Json.

struct ReferenceRow {
    name: String,
    milliseconds: Int,
}.

struct Reference {
    valid: Bool,
    policy: Json,
    rows: List[ReferenceRow],
    message: String,
}.

struct HostState {
    valid: Bool,
    affinity: List[Int],
    governor: String,
    load_1m: Float,
    load_5m: Float,
    load_15m: Float,
    kernel: String,
    operating_system: String,
    cpu_model: String,
    memory_bytes: Int,
    available_memory_bytes: Int,
    message: String,
}.

@pure
host_failure(message: String): HostState ->
    HostState(
        valid = false,
        affinity = List.new[Int](),
        governor = "",
        load_1m = 0.0,
        load_5m = 0.0,
        load_15m = 0.0,
        kernel = "",
        operating_system = "",
        cpu_model = "",
        memory_bytes = 0,
        available_memory_bytes = 0,
        message = message,
    ).

@pure
reverse_references(values: List[ReferenceRow], output: List[ReferenceRow]): List[ReferenceRow] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_references(rest, [value | output])
    }.

host_state(root: String): HostState ->
    let metrics = Platform.current_metrics();
    let valid =
        metrics.available
            and List.length(metrics.cpu_affinity) > 0
            and metrics.cpu_governor != ""
            and metrics.load_1m * 2.0 <= float_from_int(List.length(metrics.cpu_affinity));
    if {
        not metrics.available -> host_failure(
            String.append(
                String.append("dedicated host evidence is unavailable under ", root),
                String.append(": ", metrics.message),
            ),
        );
        true -> HostState(
            valid = valid,
            affinity = metrics.cpu_affinity,
            governor = metrics.cpu_governor,
            load_1m = metrics.load_1m,
            load_5m = metrics.load_5m,
            load_15m = metrics.load_15m,
            kernel = metrics.kernel,
            operating_system = metrics.operating_system,
            cpu_model = metrics.cpu_model,
            memory_bytes = metrics.memory_bytes,
            available_memory_bytes = metrics.available_memory_bytes,
            message = if {
                valid -> "";
                true -> "dedicated host affinity, governor, or normalized load policy failed"
            },
        )
    }.

reference_rows(
    values: List[std.data.Json.RequiredFieldRow],
    output: List[ReferenceRow],
): List[ReferenceRow] ->
    case values {
        [] -> reverse_references(output, List.new[ReferenceRow]());
        [value | rest] ->
            case {Json.required_field_row_strings(value), Json.required_field_row_ints(value)} {
                {[name], [milliseconds]} ->
                    reference_rows(
                        rest,
                        [ReferenceRow(name = name, milliseconds = milliseconds) | output],
                    );
                _ -> List.new[ReferenceRow]()
            }
    }.

load_reference(root: String): Reference ->
    let {
        Ok(source) <-
            File.read_text(
                SourceInventory.child(root, "docs/quality/RUST_STRUCTURE_TIMINGS_CLOSEOUT.json"),
            );
        Ok(document) <- Json.parse(source);
        Ok(policy) <- document.get("policy");
        Ok(values) <- document.get("scenarios");
        Ok(rows) <- Json.required_field_rows(values, ["name"], ["wall_time_ms"], [])
    } else {
        _ ->
            Reference(
                valid = false,
                policy = Json.null(),
                rows = List.new[ReferenceRow](),
                message = "closeout timing reference is missing or invalid",
            )
    };
    (let parsed = reference_rows(rows, List.new[ReferenceRow]());
Reference(
    valid = List.length(parsed) == 7,
    policy = policy,
    rows = parsed,
    message = if {
        List.length(parsed) == 7 -> "";
        true -> "closeout timing reference has incomplete scenarios"
    },
)).

@pure
median(first: Int, second: Int, third: Int): Int ->
    first + second + third - Int.min(first, Int.min(second, third)) - Int.max(first, Int.max(second, third)).

@pure
float_from_int(value: Int): Float ->
    case Float.from_string(Int.to_string(value)) {
        Some(number) -> number;
        None -> 0.0
    }.

@pure
sqrt_at(value: Float, estimate: Float, remaining: Int): Float ->
    if {
        remaining == 0 -> estimate;
        true -> sqrt_at(value, (estimate + value / estimate) / 2.0, remaining - 1)
    }.

@pure
coefficient(first: Int, second: Int, third: Int): Float ->
    let one = float_from_int(first);
    let two = float_from_int(second);
    let three = float_from_int(third);
    let mean = (one + two + three) / 3.0;
    let variance = ((one - mean) * (one - mean) + (two - mean) * (two - mean) + (three - mean) * (three - mean)) / 3.0;
    if {
        mean == 0.0 -> 0.0;
        true -> sqrt_at(
    variance,
    if {
        variance > 1.0 -> variance / 2.0;
        true -> 1.0
    },
    16,
) / mean
    }.

float_json(value: Float): Json ->
    case Json.float(value) {
        Ok(json) -> json;
        Err(_reason) -> Json.null()
    }.

ints_json(values: List[Int], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> ints_json(rest, output.push(Json.int(value)))
    }.

sample_artifacts(rows: List[TimingRow], output: Json): Json ->
    case rows {
        [] -> output;
        [row | rest] ->
            sample_artifacts(
                rest,
                output
                    .push(
                        Json.object()
                            .put("artifact", Json.string(row.artifact))
                            .put("sha256", Json.string(row.digest)),
                    ),
            )
    }.

find_timing(rows: List[TimingRow], name: String): Option[TimingRow] ->
    case rows {
        [] -> None;
        [row | rest] ->
            if {
                row.name == name -> Some(row);
                true -> find_timing(rest, name)
            }
    }.

find_reference(rows: List[ReferenceRow], name: String): Option[ReferenceRow] ->
    case rows {
        [] -> None;
        [row | rest] ->
            if {
                row.name == name -> Some(row);
                true -> find_reference(rest, name)
            }
    }.

@pure
maximum_ratio(name: String): String ->
    if {
        name == "clean" or name == "focused-test" or name == "full-test" -> "1.2";
        true -> "1.3"
    }.

number_json(value: String): Json ->
    case Json.parse(value) {
        Ok(json) -> json;
        Err(_reason) -> Json.null()
    }.

@pure
ratio_text(numerator: Int, denominator: Int): String ->
    Float.to_string(float_from_int(numerator) / float_from_int(denominator)).

build_rows(
    first: List[TimingRow],
    second: List[TimingRow],
    third: List[TimingRow],
    references: List[ReferenceRow],
    scenarios: Json,
    regressions: Json,
    valid: Bool,
): {Json, Json, Bool} ->
    case first {
        [] -> {scenarios, regressions, valid};
        [row | rest] ->
            let {
                Some(two) <- find_timing(second, row.name);
                Some(three) <- find_timing(third, row.name);
                Some(reference) <- find_reference(references, row.name)
            } else {
                _ -> {scenarios, regressions, false}
            };
            (let middle = median(row.wall_time_ms, two.wall_time_ms, three.wall_time_ms);
let cv = coefficient(row.wall_time_ms, two.wall_time_ms, three.wall_time_ms);
let limit = maximum_ratio(row.name);
let ratio = ratio_text(middle, reference.milliseconds);
let sample_evidence =
    Json.array()
        .push(
            Json.object()
                .put("artifact", Json.string(row.artifact))
                .put("sha256", Json.string(row.digest)),
        )
        .push(
            Json.object()
                .put("artifact", Json.string(two.artifact))
                .put("sha256", Json.string(two.digest)),
        )
        .push(
            Json.object()
                .put("artifact", Json.string(three.artifact))
                .put("sha256", Json.string(three.digest)),
        );
let scenario =
    Json.object()
        .put("name", Json.string(row.name))
        .put("command", Json.string(row.command))
        .put("wall_time_ms", Json.int(middle))
        .put("cargo_timing_artifact", Json.string(row.artifact))
        .put("cargo_timing_sha256", Json.string(row.digest))
        .put("sample_count", Json.int(3))
        .put(
            "samples_ms",
            ints_json([row.wall_time_ms, two.wall_time_ms, three.wall_time_ms], Json.array()),
        )
        .put(
            "minimum_ms",
            Json.int(Int.min(row.wall_time_ms, Int.min(two.wall_time_ms, three.wall_time_ms))),
        )
        .put(
            "maximum_ms",
            Json.int(Int.max(row.wall_time_ms, Int.max(two.wall_time_ms, three.wall_time_ms))),
        )
        .put("coefficient_of_variation", float_json(cv))
        .put("cargo_timing_samples", sample_evidence);
let regression =
    Json.object()
        .put("name", Json.string(row.name))
        .put("reference_ms", Json.int(reference.milliseconds))
        .put("current_ms", Json.int(middle))
        .put("ratio", number_json(ratio))
        .put("maximum_ratio", number_json(limit));
build_rows(
    rest,
    second,
    third,
    references,
    scenarios.push(scenario),
    regressions.push(regression),
    valid and cv <= 0.1 and number_not_greater(ratio, limit),
))
    }.

@pure
number_not_greater(value: String, limit: String): Bool ->
    case {Float.from_string(value), Float.from_string(limit)} {
        {Some(actual), Some(maximum)} -> actual <= maximum;
        _ -> false
    }.

affinity_json(values: List[Int], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> affinity_json(rest, output.push(Json.int(value)))
    }.

provenance(root: String, host: HostState): Json ->
    let digest = CompilationInputs.digest(root);
    let identity = Git.source_tree_identity(root);
    let base =
        Json.object()
            .put("compilation_input_sha256", Json.string(CompilationInputs.result_digest(digest)))
            .put("kernel", Json.string(host.kernel))
            .put("operating_system", Json.string(host.operating_system))
            .put("cpu_model", Json.string(host.cpu_model))
            .put("memory_bytes", Json.int(host.memory_bytes))
            .put("available_memory_bytes", Json.int(host.available_memory_bytes))
            .put("cpu_affinity", affinity_json(host.affinity, Json.array()))
            .put("cpu_governor", Json.string(host.governor))
            .put(
                "load_average",
                Json.array()
                    .push(float_json(host.load_1m))
                    .push(float_json(host.load_5m))
                    .push(float_json(host.load_15m)),
            );
    case identity {
        Err(_reason) ->
            base.put("git_commit", Json.null()).put("git_worktree_dirty", Json.bool(true));
        Ok(value) ->
            base
                .put("git_commit", Json.string(Git.revision(value)))
                .put("git_worktree_dirty", Json.bool(not Git.clean(value)))
                .put("source_tree_sha256", Json.string(Git.sha256(value)))
    }.

write_current(root: String, report: Json): Bool ->
    case Json.stringify_pretty(report) {
        Err(reason) ->
            let _printed = eprintln(Json.error_message(reason));
            false;
        Ok(rendered) ->
            case File.write_text(
    SourceInventory.child(root, "target/quality/rust-structure-timings-current.json"),
    String.append(rendered, "\n"),
) {
                Err(reason) ->
                    let _printed = eprintln(File.message(reason));
                    false;
                Ok(_written) -> true
            }
    }.

pub measure(root: String): Bool ->
    case Environment.get("TERLAN_RUST_TIMING_DEDICATED") {
        Some("1") ->
            let before = host_state(root);
            let reference = load_reference(root);
            if {
                not before.valid -> let _printed = eprintln(before.message);
                false;
                not reference.valid -> let _printed = eprintln(reference.message);
                false;
                true -> let sample_one =
                    StructureTimings.measure(
                        root,
                        "target/quality/rust-structure-timings-current/sample-01",
                    );
                let sample_two =
                    StructureTimings.measure(
                        root,
                        "target/quality/rust-structure-timings-current/sample-02",
                    );
                let sample_three =
                    StructureTimings.measure(
                        root,
                        "target/quality/rust-structure-timings-current/sample-03",
                    );
                let host_after = host_state(root);
                if {
                    not sample_one.valid or not sample_two.valid or not sample_three.valid -> let _printed = eprintln("recurring timing scenario execution failed");
                    false;
                    not host_after.valid
                        or host_after.affinity != before.affinity
                        or host_after.governor != before.governor -> let _printed = eprintln("recurring timing host controls changed during measurement");
                    false;
                    true -> let built =
                        build_rows(
                            sample_one.rows,
                            sample_two.rows,
                            sample_three.rows,
                            reference.rows,
                            Json.array(),
                            Json.array(),
                            true,
                        );
                    case built {
                        {scenarios, regressions, valid} ->
                            let policy =
                                reference.policy
                                    .put("sample_count", Json.int(3))
                                    .put("statistic", Json.string("median"))
                                    .put("maximum_normalized_load_1m", number_json("0.5"))
                                    .put("maximum_coefficient_of_variation", number_json("0.1"))
                                    .put("isolated_target_retained", Json.bool(false));
                            let report =
                                Json.object()
                                    .put("schema_version", Json.int(3))
                                    .put("provenance", provenance(root, host_after))
                                    .put("policy", policy)
                                    .put("scenarios", scenarios)
                                    .put(
                                        "regression",
                                        Json.object()
                                            .put(
                                                "reference_report",
                                                Json.string(
                                                    "docs/quality/RUST_STRUCTURE_TIMINGS_CLOSEOUT.json",
                                                ),
                                            )
                                            .put("scenarios", regressions),
                                    );
                            let written = write_current(root, report);
                            if {
                                valid and written -> let _printed =
                                    println(
                                        "wrote passing target/quality/rust-structure-timings-current.json",
                                    );
                                true;
                                true -> let _printed =
                                    eprintln(
                                        "Rust structure recurring timings failed regression or noise budgets",
                                    );
                                false
                            }
                    }
                }
            };
        _ ->
            let _printed = eprintln("recurring timing measurement requires TERLAN_RUST_TIMING_DEDICATED=1");
            false
    }.

pub self_test(): Bool ->
    median(100, 90, 110) == 100
        and coefficient(95, 100, 105) < 0.1
        and coefficient(50, 100, 150) > 0.1.
