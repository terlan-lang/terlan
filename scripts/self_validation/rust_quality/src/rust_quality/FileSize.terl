/**
 * Enforces absolute Rust source-size limits on files changed by one commit.
 *
 * No checked-in inventory is involved: unchanged legacy files cannot break a
 * later commit, while every newly changed file is checked directly.
 */
module rust_quality.FileSize.

import rust_quality.SourceInventory.
import std.collections.List.
import std.core.Option.{with_default}.
import std.core.{Int, String}.
import std.io.Console.{eprintln, println}.

import type rust_quality.SourceInventory.RustSource.

@pure
finding(source: RustSource): String ->
    String.concat(
        [
            source.path,
            ": ",
            Int.to_string(source.physical_lines),
            " lines exceeds the ",
            Int.to_string(source.line_limit),
            "-line ",
            source.category,
            " limit",
        ],
    ).

@pure
validate_at(sources: List[RustSource], output: List[String]): List[String] ->
    case sources {
        [] -> SourceInventory.reverse(output);
        [source | rest] ->
            if {
                source.category == "generated" or source.physical_lines <= source.line_limit -> validate_at(rest, output);
                true -> validate_at(rest, [finding(source) | output])
            }
    }.

@pure
validate(sources: List[RustSource]): List[String] ->
    validate_at(sources, List.new[String]()).

print_findings(findings: List[String]): Bool ->
    case findings {
        [] -> false;
        [message | rest] ->
            let _printed = eprintln(String.concat(["  - ", message]));
            print_findings(rest)
    }.

check_paths_at(root: String, paths: List[String], checked: Int): Bool ->
    case paths {
        [] ->
            let _printed =
                println(
                    String.concat(
                        ["Rust file size passed: ", Int.to_string(checked), " changed files"],
                    ),
                );
            true;
        _ ->
            let batch = SourceInventory.load_next(root, paths);
            if {
                not batch.valid -> let _printed = eprintln(String.append("Rust file size failed: ", batch.message));
                false;
                true -> let findings = validate(batch.sources);
                if {
                    List.length(findings) > 0 -> let _printed = eprintln("Rust file size failed:");
                    print_findings(findings);
                    true -> check_paths_at(root, batch.remaining, checked + List.length(batch.sources))
                }
            }
    }.

pub check_changed(root: String, paths: List[String]): Bool ->
    check_paths_at(root, paths, 0).

pub self_test(): Bool ->
    let accepted =
        SourceInventory.fixture_source(
            "crates/example/src/small.rs",
            "",
            "implementation",
            1_000,
            1_000,
        );
    let rejected =
        SourceInventory.fixture_source(
            "crates/example/src/large.rs",
            "",
            "implementation",
            1_001,
            1_000,
        );
    let generated =
        SourceInventory.fixture_source(
            "crates/example/src/generated.rs",
            "",
            "generated",
            2_000,
            1_000,
        );
    let findings = validate([accepted, rejected, generated]);
    if {
        List.length(findings) == 1
            and String.contains(
    List.first(findings).with_default(""),
    "large.rs: 1001 lines exceeds the 1000-line implementation limit",
) -> let _printed = println("Rust file-size self-test passed");
        true;
        true -> let _printed = eprintln("error[rust_quality.file_size.self_test]: changed-file limit was not enforced");
        false
    }.
