/**
 * Computes one deterministic digest over Rust compilation inputs.
 */
module rust_quality.CompilationInputs.

import rust_quality.SourceInventory.
import std.collections.List.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.crypto.Hash.

import type std.crypto.Hash.LabeledFile.

pub struct DigestResult {
    /**
     * Whether the compilation input inventory was read successfully.
     */
    valid: Bool,
    /**
     * Deterministic digest of the compilation input contents.
     */
    digest: String,
    /**
     * Number of files contributing to the input digest.
     */
    file_count: Int,
    /**
     * Diagnostic explaining an input inventory failure.
     */
    message: String,
}.

@pure
candidate(path: String): Bool ->
    let name = SourceInventory.basename(path);
    String.ends_with(name, ".rs")
        or name == "Cargo.toml"
        or name == "Cargo.lock"
        or name == "rustfmt.toml"
        or name == "clippy.toml".

@pure
select(root: String, files: List[String], output: List[LabeledFile]): List[LabeledFile] ->
    case files {
        [] -> SourceInventory.reverse(output);
        [path | rest] ->
            if {
                candidate(path) -> select(
                    root,
                    rest,
                    [Hash.labeled_file(SourceInventory.child(root, path), path) | output],
                );
                true -> select(root, rest, output)
            }
    }.

pub digest(root: String): DigestResult ->
    let discovery =
        SourceInventory.discover_visible(
            root,
            ["*.rs", "Cargo.toml", "Cargo.lock", "rustfmt.toml", "clippy.toml"],
        );
    if {
        not discovery.valid -> DigestResult(valid = false, digest = "", file_count = 0, message = discovery.message);
        true -> let selected = select(root, discovery.paths, List.new[LabeledFile]());
        if {
            List.length(selected) == 0 -> DigestResult(
                valid = false,
                digest = "",
                file_count = 0,
                message = "Rust compilation input inventory is empty",
            );
            true -> case Hash.sha256_labeled_file_contents(selected) {
                Err(reason) ->
                    DigestResult(
                        valid = false,
                        digest = "",
                        file_count = 0,
                        message = reason.message,
                    );
                Ok(value) ->
                    DigestResult(
                        valid = true,
                        digest = value,
                        file_count = List.length(selected),
                        message = "",
                    )
            }
        }
    }.

pub self_test(): Bool ->
    candidate("crates/a/src/lib.rs")
        and candidate("Cargo.lock")
        and candidate("crates/a/Cargo.toml")
        and not candidate("target/data.json").
