/**
 * Typed Cargo metadata loading and workspace-graph projection.
 *
 * Cargo remains the authority for dependency resolution. The Make producer
 * queries it once; consumers validate and project the same resolved document.
 */
module rust_quality.CargoMetadata.

import rust_quality.CargoMetadataReceipt.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Ordering.{Lt}.
import std.core.Result.{Err, Ok}.
import std.core.String.{compare}.
import std.data.Json.

import type std.core.Option.
import type std.data.Json.
import type std.data.Json.RequiredFieldRow.

pub struct Metadata {
    valid: Bool,
    document: Json,
    message: String,
}.

pub struct GraphNode {
    name: String,
    dependencies: List[String],
}.

pub struct Graph {
    valid: Bool,
    nodes: List[GraphNode],
    message: String,
}.

@pure
pub graph_node(name: String, dependencies: List[String]): GraphNode ->
    GraphNode(name = name, dependencies = dependencies).

struct PackageName {
    id: String,
    name: String,
}.

metadata_failure(message: String): Metadata ->
    Metadata(valid = false, document = Json.null(), message = message).

@pure
graph_failure(message: String): Graph ->
    Graph(valid = false, nodes = List.new[GraphNode](), message = message).

/**
 * Loads the completed Make-owned handoff after verifying its generation and bytes.
 * This does not authorize reuse against a different current source or toolchain.
 */
pub load_precomputed(root: String): Metadata ->
    case CargoMetadataReceipt.read(root) {
        Err(reason) -> metadata_failure(reason);
        Ok(document) -> Metadata(valid = true, document = document, message = "")
    }.

/**
 * Selects precisely Cargo's resolved workspace members, excluding dependencies.
 * Missing or repeated members are errors, not an incomplete source inventory.
 */
pub workspace_packages(metadata: Json): Option[Json] ->
    let {
        Ok(version_value) <- metadata.get("version");
        Ok(1) <- version_value.as_int();
        Some(members) <- object_string_array(metadata, "workspace_members");
        true <- List.length(members) > 0 and List.length(members) <= 256;
        true <- List.length(sort_unique(members)) == List.length(members);
        Ok(packages) <- metadata.get("packages");
        Ok(count) <- packages.length();
        true <- count <= 16384
    } else {
        _ -> None
    };
    workspace_packages_at(packages, 0, count, members, [], Json.array()).

workspace_packages_at(
    packages: Json,
    index: Int,
    count: Int,
    members: List[String],
    seen: List[String],
    output: Json,
): Option[Json] ->
    if {
        index == count -> if {
            List.length(seen) == List.length(members) -> Some(output);
            true -> None
        };
        true -> let {
            Ok(package) <- packages.at(index);
            Ok(id_value) <- package.get("id");
            Ok(id) <- id_value.as_string();
            true <- id != ""
        } else {
            _ -> None
        };
        if {
            not contains(members, id) -> workspace_packages_at(packages, index + 1, count, members, seen, output);
            contains(seen, id) -> None;
            true -> workspace_packages_at(
                packages,
                index + 1,
                count,
                members,
                [id | seen],
                output.push(package),
            )
        }
    }.

@pure
pub contains(values: List[String], expected: String): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value == expected or contains(rest, expected)
    }.

@pure
pub insert_sorted_unique(value: String, values: List[String]): List[String] ->
    case values {
        [] -> [value];
        [current | rest] ->
            if {
                value == current -> values;
                compare(value, current) == Lt -> [value | values];
                true -> [current | insert_sorted_unique(value, rest)]
            }
    }.

@pure
pub sort_unique(values: List[String]): List[String] ->
    sort_unique_at(values, List.new[String]()).

@pure
sort_unique_at(values: List[String], output: List[String]): List[String] ->
    case values {
        [] -> output;
        [value | rest] -> sort_unique_at(rest, insert_sorted_unique(value, output))
    }.

string_array_at(value: Json, index: Int, output: List[String]): Option[List[String]] ->
    if {
        index < 0 -> Some(output);
        true -> let {
            Ok(item) <- Json.at(value, index);
            Ok(text) <- Json.as_string(item)
        } else {
            _ -> None
        };
        string_array_at(value, index - 1, [text | output])
    }.

pub string_array(value: Json): Option[List[String]] ->
    case Json.length(value) {
        Err(_reason) -> None;
        Ok(count) -> string_array_at(value, count - 1, List.new[String]())
    }.

pub object_string_array(value: Json, field: String): Option[List[String]] ->
    case Json.get(value, field) {
        Err(_reason) -> None;
        Ok(array) -> string_array(array)
    }.

@pure
package_name(id: String, packages: List[PackageName]): Option[String] ->
    case packages {
        [] -> None;
        [package | rest] ->
            if {
                package.id == id -> Some(package.name);
                true -> package_name(id, rest)
            }
    }.

@pure
insert_package(package: PackageName, values: List[PackageName]): List[PackageName] ->
    case values {
        [] -> List[PackageName](package);
        [current | rest] ->
            if {
                compare(package.name, current.name) == Lt -> [package | values];
                true -> [current | insert_package(package, rest)]
            }
    }.

package_page(
    packages: Json,
    members: List[String],
    offset: Int,
    output: List[PackageName],
): Option[List[PackageName]] ->
    case Json.required_field_rows_page(packages, offset, 256, ["id", "name"], [], []) {
        Err(_reason) -> None;
        Ok(rows) ->
            if {
                List.length(rows) == 0 -> Some(output);
                true -> package_rows(packages, members, rows, offset, output)
            }
    }.

package_rows(
    packages: Json,
    members: List[String],
    rows: List[RequiredFieldRow],
    offset: Int,
    output: List[PackageName],
): Option[List[PackageName]] ->
    case rows {
        [] -> package_page(packages, members, offset, output);
        [row | rest] ->
            case Json.required_field_row_strings(row) {
                [id, name] ->
                    let next =
                        if {
                            contains(members, id) -> insert_package(PackageName(id = id, name = name), output);
                            true -> output
                        };
                    package_rows(packages, members, rest, offset + 1, next);
                _ -> None
            }
    }.

node_dependencies(nodes: Json, index: Int, packages: List[PackageName]): Option[List[String]] ->
    let {
        Ok(node) <- Json.at(nodes, index);
        Some(ids) <- object_string_array(node, "dependencies")
    } else {
        _ -> None
    };
    dependency_names(ids, packages, List.new[String]()).

@pure
dependency_names(
    ids: List[String],
    packages: List[PackageName],
    output: List[String],
): Option[List[String]] ->
    case ids {
        [] -> Some(output);
        [id | rest] ->
            case package_name(id, packages) {
                None -> dependency_names(rest, packages, output);
                Some(name) -> dependency_names(rest, packages, insert_sorted_unique(name, output))
            }
    }.

@pure
insert_node(node: GraphNode, values: List[GraphNode]): List[GraphNode] ->
    case values {
        [] -> List[GraphNode](node);
        [current | rest] ->
            if {
                compare(node.name, current.name) == Lt -> [node | values];
                true -> [current | insert_node(node, rest)]
            }
    }.

nodes_at(
    nodes: Json,
    index: Int,
    count: Int,
    packages: List[PackageName],
    output: List[GraphNode],
): Option[List[GraphNode]] ->
    if {
        index == count -> Some(output);
        true -> let {
            Ok(node) <- Json.at(nodes, index);
            Ok(id_value) <- Json.get(node, "id");
            Ok(id) <- Json.as_string(id_value)
        } else {
            _ -> None
        };
        case package_name(id, packages) {
            None -> nodes_at(nodes, index + 1, count, packages, output);
            Some(name) ->
                case node_dependencies(nodes, index, packages) {
                    None -> None;
                    Some(dependencies) ->
                        nodes_at(
                            nodes,
                            index + 1,
                            count,
                            packages,
                            insert_node(GraphNode(name = name, dependencies = dependencies), output),
                        )
                }
        }
    }.

pub workspace_graph(metadata: Json): Graph ->
    let {
        Ok(members_value) <- Json.get(metadata, "workspace_members");
        Some(members) <- string_array(members_value);
        Ok(packages_value) <- Json.get(metadata, "packages");
        Some(packages) <- package_page(packages_value, members, 0, List.new[PackageName]());
        Ok(resolve) <- Json.get(metadata, "resolve");
        Ok(nodes) <- Json.get(resolve, "nodes");
        Ok(node_count) <- Json.length(nodes);
        Some(graph_nodes) <- nodes_at(nodes, 0, node_count, packages, List.new[GraphNode]())
    } else {
        _ -> graph_failure("cargo metadata does not match the supported format-version 1 shape")
    };
    Graph(valid = true, nodes = graph_nodes, message = "").

@pure
pub node_names(nodes: List[GraphNode]): List[String] ->
    case nodes {
        [] -> List.new[String]();
        [node | rest] -> [node.name | node_names(rest)]
    }.

@pure
pub find_node(name: String, nodes: List[GraphNode]): Option[GraphNode] ->
    case nodes {
        [] -> None;
        [node | rest] ->
            if {
                node.name == name -> Some(node);
                true -> find_node(name, rest)
            }
    }.

pub self_test(): Bool ->
    sort_unique(["b", "a", "b"]) == ["a", "b"]
        and contains(["a", "b"], "b")
        and not contains(["a", "b"], "c")
        and CargoMetadataReceipt.self_test()
        and workspace_projection_self_test().

workspace_projection_self_test(): Bool ->
    let {
        Ok(metadata) <-
            Json.parse(
                "{\"version\":1,\"workspace_members\":[\"member-a\",\"member-b\"],\"packages\":[{\"id\":\"registry-dep\",\"manifest_path\":\"/registry/dep/Cargo.toml\"},{\"id\":\"member-b\",\"manifest_path\":\"/workspace/b/Cargo.toml\"},{\"id\":\"excluded-local\",\"manifest_path\":\"/workspace/excluded/Cargo.toml\"},{\"id\":\"member-a\",\"manifest_path\":\"/workspace/a/Cargo.toml\"}]}",
            );
        Some(packages) <- workspace_packages(metadata);
        Ok(2) <- packages.length();
        Ok(first) <- packages.at(0);
        Ok(first_id) <- first.get("id");
        Ok("member-b") <- first_id.as_string();
        Ok(second) <- packages.at(1);
        Ok(second_id) <- second.get("id");
        Ok("member-a") <- second_id.as_string()
    } else {
        _ -> false
    };
    rejected_workspaces(
        [
            "{}",
            "{\"version\":2,\"workspace_members\":[\"a\"],\"packages\":[{\"id\":\"a\"}]}",
            "{\"version\":1,\"workspace_members\":[],\"packages\":[]}",
            "{\"version\":1,\"workspace_members\":[\"a\",\"a\"],\"packages\":[{\"id\":\"a\"}]}",
            "{\"version\":1,\"workspace_members\":[\"a\",\"missing\"],\"packages\":[{\"id\":\"a\"}]}",
            "{\"version\":1,\"workspace_members\":[\"a\"],\"packages\":[{\"id\":\"a\"},{\"id\":\"a\"}]}",
            "{\"version\":1,\"workspace_members\":[\"a\"],\"packages\":[{\"id\":12}]}",
            "{\"version\":1,\"workspace_members\":[\"\"],\"packages\":[{\"id\":\"\"}]}",
        ],
    ).

rejected_workspaces(sources: List[String]): Bool ->
    case sources {
        [] -> true;
        [source | rest] ->
            let {
                Ok(metadata) <- Json.parse(source);
                None <- workspace_packages(metadata)
            } else {
                _ -> false
            };
            rejected_workspaces(rest)
    }.
