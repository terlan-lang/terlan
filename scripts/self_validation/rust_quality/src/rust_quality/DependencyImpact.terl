@pure
timings_at(values: List[TimingRow], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let row =
                String.concat(
                    [
                        "{\"cq6_ms\":",
                        Int.to_string(value.milliseconds),
                        ",\"domain\":",
                        Json.quote_string(value.domain),
                        ",\"scenario\":",
                        Json.quote_string(value.scenario),
                        "}",
                    ],
                );
            timings_at(rest, append_item(output, row))
    }.

@pure
timings_json(values: List[TimingRow]): String ->
    timings_at(values, "").

edited_domain(row: Json): String ->
    case Json.get(row, "edited_file") {
        Err(_reason) -> "workspace";
        Ok(value) ->
            if {
                Json.is_null(value) -> "workspace";
                true -> case Json.as_string(value) {
                    Err(_reason) -> "workspace";
                    Ok(path) ->
                        if {
                            String.starts_with(path, "crates/terlan/src/") -> DependencyImpactSource.source_domain(path);
                            true -> "workspace"
                        }
                }
            }
    }.

timing_rows(values: Json, index: Int, count: Int, output: List[TimingRow]): TimingResult ->
    if {
        index == count -> TimingResult(valid = true, rows = SourceInventory.reverse(output), message = "");
        true -> let {
            Ok(row) <- Json.at(values, index);
            Ok(name_value) <- Json.get(row, "name");
            Ok(name) <- Json.as_string(name_value);
            Ok(time_value) <- Json.get(row, "wall_time_ms");
            Ok(wall_time_ms) <- Json.as_int(time_value)
        } else {
            _ ->
                TimingResult(
                    valid = false,
                    rows = [],
                    message = "Rust structure timing scenarios have an unsupported shape",
                )
        };
        (let domain = edited_domain(row);
timing_rows(
    values,
    index + 1,
    count,
    [TimingRow(scenario = name, domain = domain, milliseconds = wall_time_ms) | output],
))
    }.

load_timings(root: String): TimingResult ->
    case File.read_text(SourceInventory.child(root, "docs/quality/RUST_STRUCTURE_TIMINGS_CLOSEOUT.json")) {
        Err(reason) -> TimingResult(valid = false, rows = [], message = File.message(reason));
        Ok(source) ->
            case Json.parse(source) {
                Err(reason) ->
                    TimingResult(valid = false, rows = [], message = Json.error_message(reason));
                Ok(document) ->
                    let {
                        Ok(values) <- Json.get(document, "scenarios");
                        Ok(count) <- Json.length(values)
                    } else {
                        _ ->
                            TimingResult(
                                valid = false,
                                rows = [],
                                message = "Rust structure timing report lacks scenarios",
                            )
                    };
                    timing_rows(values, 0, count, List.new[TimingRow]())
            }
    }.

load_ast(root: String): DocumentResult ->
    case File.read_text(SourceInventory.child(root, "target/quality/rust-structural-input.json")) {
        Err(reason) -> document_failure(File.message(reason));
        Ok(source) ->
            case Json.parse(source) {
                Err(reason) -> document_failure(Json.error_message(reason));
                Ok(document) -> DocumentResult(valid = true, document = document, message = "")
            }
    }.

ast_parse_diagnostics(report: Json): List[String] ->
    let {
        Ok(primary) <- Json.get(report, "parse_failures");
        Ok(primary_count) <- Json.length(primary);
        Ok(boundary) <- Json.get(report, "source_boundary_parse_failures");
        Ok(boundary_count) <- Json.length(boundary)
    } else {
        _ -> ["Rust boundary AST report lacks parse-failure evidence"]
    };
    if {
        primary_count == 0 and boundary_count == 0 -> List.new[String]();
        true -> ["Rust boundary AST report contains parse failures"]
    }.

@pure
budget_diagnostics(
    direct_dependencies: Int,
    duplicate_count: Int,
    integration_targets: List[String],
    workspace_cycle_count: Int,
    domain_cycle_count: Int,
    maximum_blast: Int,
    timing_count: Int,
    source: SourceAnalysis,
    enforce_milestone: Bool,
): List[String] ->
    let diagnostics = List.new[String]();
    let workspace =
        if {
            workspace_cycle_count == 0 -> diagnostics;
            true -> ["workspace dependency graph contains a cycle" | diagnostics]
        };
    let dependencies =
        if {
            direct_dependencies <= 56 -> workspace;
            true -> [String.concat(
    [
        "main-package non-optional normal dependency count ",
        Int.to_string(direct_dependencies),
        " exceeds 56",
    ],
) | workspace]
        };
    let duplicates =
        if {
            duplicate_count <= 30 -> dependencies;
            true -> [String.concat(
    ["resolved duplicate-version family count ", Int.to_string(duplicate_count), " exceeds 30"],
) | dependencies]
        };
    let integrations =
        if {
            List.length(integration_targets) <= 12
                and integration_targets == CargoMetadata.sort_unique(integration_targets) -> duplicates;
            true -> ["integration-test target inventory exceeds its unique sorted budget" | duplicates]
        };
    let evidence =
        if {
            List.length(DependencyImpactSource.analysis_production_domains(source)) > 0
                and timing_count > 0 -> integrations;
            true -> ["dependency-impact report lacks domain or timing evidence" | integrations]
        };
    let cycles =
        if {
            domain_cycle_count == 0 -> evidence;
            true -> [String.concat(["domain cycle count ", Int.to_string(domain_cycle_count), " exceeds 0"]) | evidence]
        };
    let blast_diagnostics =
        if {
            maximum_blast <= 13 -> cycles;
            true -> [String.concat(["domain blast radius exceeds budget: maximum=", Int.to_string(maximum_blast)]) | cycles]
        };
    let semantic =
        if {
            List.length(DependencyImpactSource.analysis_production_domains(source)) > 0 -> blast_diagnostics;
            true -> ["dependency-impact report lacks semantic fanout evidence" | blast_diagnostics]
        };
    let milestone_dependencies =
        if {
            enforce_milestone and direct_dependencies > 50 -> ["0.0.8 main dependency target 50 not met" | semantic];
            true -> semantic
        };
    let milestone_duplicates =
        if {
            enforce_milestone and duplicate_count > 24 -> ["0.0.8 duplicate-family target 24 not met" | milestone_dependencies];
            true -> milestone_dependencies
        };
    if {
        enforce_milestone and maximum_blast > 9 -> [String.concat(
    ["0.0.8 production blast-radius target 9 not met (actual ", Int.to_string(maximum_blast), ")"],
) | milestone_duplicates];
        true -> milestone_duplicates
    }.

@pure
build_report(
    compilation_digest: String,
    cargo: CargoAnalysis,
    classifications: ClassificationResult,
    source: SourceAnalysis,
    timings: TimingResult,
    workspace_cycles: List[Cycle],
    domain_cycles: List[Cycle],
    blast: List[BlastRadius],
): String ->
    let integration_policy =
        String.concat(
            [
                "{\"maximum_targets\":12,\"targets\":",
                strings_json(DependencyImpactCargo.analysis_integration_targets(cargo)),
                "}",
            ],
        );
    let fanout_policy =
        String.concat(
            [
                "{\"maximum_non_optional_normal_dependencies\":56,",
                "\"maximum_resolved_duplicate_families\":30,",
                "\"milestone\":\"0.0.8\",",
                "\"non_optional_normal_dependencies\":",
                Int.to_string(DependencyImpactCargo.analysis_direct_dependency_count(cargo)),
                ",\"package\":\"terlan\",",
                "\"target_non_optional_normal_dependencies\":50,",
                "\"target_resolved_duplicate_families\":24}",
            ],
        );
    let cycle_policy = String.concat(["{\"cycles\":", cycles_json(domain_cycles), ",\"maximum_cycles\":0}"]);
    let blast_policy = "{\"maximum_dependents\":13,\"milestone\":\"0.0.8\",\"target_dependents\":9}";
    String.concat(
        [
            "{\"blast_radius_policy\":",
            blast_policy,
            ",\"compilation_input_sha256\":",
            Json.quote_string(compilation_digest),
            ",\"dependency_fanout_policy\":",
            fanout_policy,
            ",\"domain_api_fan_in\":",
            fan_in_json(
                DependencyImpactSource.analysis_production_domains(source),
                DependencyImpactSource.analysis_production_edges(source),
            ),
            ",\"domain_change_blast_radius\":",
            blast_json(blast),
            ",\"domain_cycle_policy\":",
            cycle_policy,
            ",\"duplicate_dependency_classifications\":",
            classifications_json(DependencyClassifications.result_rows(classifications)),
            ",\"incremental_scenarios\":",
            timings_json(timings.rows),
            ",\"integration_test_policy\":",
            integration_policy,
            ",\"production_cross_domain_edges\":",
            edges_json(DependencyImpactSource.analysis_production_edges(source)),
            ",\"production_domains\":",
            domains_json(DependencyImpactSource.analysis_production_domains(source)),
            ",\"resolved_dependency_duplicates\":",
            versions_json(DependencyImpactCargo.analysis_duplicates(cargo)),
            ",\"schema_version\":4,",
            "\"test_cross_domain_edges\":",
            edges_json(DependencyImpactSource.analysis_test_edges(source)),
            ",\"test_domains\":",
            domains_json(DependencyImpactSource.analysis_test_domains(source)),
            ",\"workspace_cycles\":",
            cycles_json(workspace_cycles),
            ",\"workspace_feature_fanout\":",
            fanout_json(DependencyImpactCargo.analysis_feature_fanout(cargo)),
            ",\"workspace_packages\":",
            workspace_packages_json(DependencyImpactCargo.analysis_nodes(cargo)),
            "}",
        ],
    ).

build(root: String, enforce_milestone: Bool): Model ->
    let metadata = CargoMetadata.load_precomputed(root);
    if {
        not metadata.valid -> model_failure(metadata.message);
        true -> let cargo = DependencyImpactCargo.analyze(metadata.document);
        if {
            not DependencyImpactCargo.analysis_valid(cargo) -> model_failure(DependencyImpactCargo.analysis_message(cargo));
            true -> let ast = load_ast(root);
            if {
                not ast.valid -> model_failure(ast.message);
                true -> let source = DependencyImpactSource.analyze(ast.document);
                if {
                    not DependencyImpactSource.analysis_valid(source) -> model_failure(DependencyImpactSource.analysis_message(source));
                    true -> let classifications =
                        DependencyClassifications.check(
                            root,
                            DependencyImpactCargo.analysis_duplicates(cargo),
                        );
                    if {
                        not DependencyClassifications.result_valid(classifications) -> model_failure(DependencyClassifications.result_message(classifications));
                        true -> let compilation = CompilationInputs.digest(root);
                        if {
                            not CompilationInputs.result_valid(compilation) -> model_failure(CompilationInputs.result_message(compilation));
                            true -> let timings = load_timings(root);
                            if {
                                not timings.valid -> model_failure(timings.message);
                                true -> let workspace_cycles =
                                    DependencyImpactGraph.cycles(
                                        DependencyImpactCargo.analysis_nodes(cargo),
                                    );
                                let domain_graph =
                                    DependencyImpactGraph.domain_graph(
                                        DependencyImpactSource.analysis_production_domains(source),
                                        DependencyImpactSource.analysis_production_edges(source),
                                    );
                                let domain_cycles = DependencyImpactGraph.cycles(domain_graph);
                                let blast = DependencyImpactGraph.blast_radius(domain_graph);
                                let policy =
                                    budget_diagnostics(
                                        DependencyImpactCargo.analysis_direct_dependency_count(
                                            cargo,
                                        ),
                                        List.length(
                                            DependencyImpactCargo.analysis_duplicates(cargo),
                                        ),
                                        DependencyImpactCargo.analysis_integration_targets(cargo),
                                        List.length(workspace_cycles),
                                        List.length(domain_cycles),
                                        DependencyImpactGraph.maximum_blast(blast, 0),
                                        List.length(timings.rows),
                                        source,
                                        enforce_milestone,
                                    );
                                let parsed = ast_parse_diagnostics(ast.document);
                                let reviewed =
                                    List.concat(
                                        DependencyClassifications.result_diagnostics(
                                            classifications,
                                        ),
                                        parsed,
                                    );
                                let diagnostics = List.concat(policy, reviewed);
                                Model(
                                    valid = true,
                                    document = build_report(
                                        CompilationInputs.result_digest(compilation),
                                        cargo,
                                        classifications,
                                        source,
                                        timings,
                                        workspace_cycles,
                                        domain_cycles,
                                        blast,
                                    ),
                                    diagnostics = diagnostics,
                                    production_domains = List.length(
                                        DependencyImpactSource.analysis_production_domains(source),
                                    ),
                                    production_edges = List.length(
                                        DependencyImpactSource.analysis_production_edges(source),
                                    ),
                                    test_edges = List.length(DependencyImpactSource.analysis_test_edges(source)),
                                    integration_targets = List.length(
                                        DependencyImpactCargo.analysis_integration_targets(cargo),
                                    ),
                                    message = "",
                                )
                            }
                        }
                    }
                }
            }
        }
    }.

print_diagnostics(values: List[String]): Bool ->
    case values {
        [] -> false;
        [value | rest] ->
            let _printed = eprintln(String.append("  - ", value));
            print_diagnostics(rest)
    }.

canonical_json(source: String): Option[String] ->
    let {
        Ok(document) <- Json.parse(source);
        Ok(rendered) <- Json.stringify(document)
    } else {
        _ -> None
    };
    Some(rendered).

same_json(left: String, right: String): Bool ->
    let {
        Some(left_text) <- canonical_json(left);
        Some(right_text) <- canonical_json(right)
    } else {
        _ -> false
    };
    left_text == right_text.

checked_diagnostics(root: String, current: String): List[String] ->
    case File.read_text(SourceInventory.child(root, "docs/quality/RUST_DEPENDENCY_IMPACT.json")) {
        Err(_reason) -> ["missing docs/quality/RUST_DEPENDENCY_IMPACT.json"];
        Ok(source) ->
            if {
                same_json(current, source) -> List.new[String]();
                true -> ["checked dependency-impact report is stale"]
            }
    }.

write_report(root: String, source: String): Bool ->
    case Json.parse(source) {
        Err(reason) ->
            let _printed = eprintln(Json.error_message(reason));
            false;
        Ok(document) ->
            case Json.stringify_pretty(document) {
                Err(reason) ->
                    let _printed = eprintln(Json.error_message(reason));
                    false;
                Ok(rendered) ->
                    case File.write_text(
    SourceInventory.child(root, "docs/quality/RUST_DEPENDENCY_IMPACT.json"),
    String.append(rendered, "\n"),
) {
                        Err(reason) ->
                            let _printed = eprintln(File.message(reason));
                            false;
                        Ok(_written) -> true
                    }
            }
    }.

pub check(root: String, enforce_milestone: Bool): Bool ->
    let model = build(root, enforce_milestone);
    if {
        not model.valid -> let _printed = eprintln(String.append("Rust dependency impact failed: ", model.message));
        false;
        true -> let stale = checked_diagnostics(root, model.document);
        let diagnostics = List.concat(model.diagnostics, stale);
        if {
            List.length(diagnostics) > 0 -> let _printed = eprintln("Rust dependency impact failed:");
            print_diagnostics(diagnostics);
            true -> let _printed =
                println(
                    String.concat(
                        [
                            "Rust dependency impact passed: ",
                            Int.to_string(model.production_domains),
                            " production domains, ",
                            Int.to_string(model.production_edges),
                            " production coupling edges, ",
                            Int.to_string(model.test_edges),
                            " test coupling edges, ",
                            Int.to_string(model.integration_targets),
                            " integration-test targets",
                        ],
                    ),
                );
            true
        }
    }.

pub record(root: String): Bool ->
    let model = build(root, false);
    if {
        not model.valid -> let _printed = eprintln(String.append("Rust dependency impact failed: ", model.message));
        false;
        List.length(model.diagnostics) > 0 -> let _printed = eprintln("Rust dependency impact failed:");
        print_diagnostics(model.diagnostics);
        true -> let written = write_report(root, model.document);
        if {
            written -> let _printed = println("Recorded docs/quality/RUST_DEPENDENCY_IMPACT.json");
            true;
            true -> false
        }
    }.

pub self_test(): Bool ->
    CompilationInputs.self_test()
        and DependencyClassifications.self_test()
        and DependencyImpactCargo.self_test()
        and DependencyImpactGraph.self_test()
        and DependencyImpactSource.self_test()
        and Json.quote_string("a\n\"b") == "\"a\\u000a\\\"b\"".
