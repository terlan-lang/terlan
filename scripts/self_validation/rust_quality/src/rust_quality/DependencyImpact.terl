                        ",\"versions\":",
                        strings_json(DependencyClassifications.duplicate_versions(value)),
                        "}",
                    ],
                );
            versions_at(rest, append_item(output, row))
    }.

@pure
versions_json(values: List[Duplicate]): String ->
