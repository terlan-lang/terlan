/**
 * Builds and validates the deterministic Rust dependency-impact report.
 */
module rust_quality.DependencyImpact.

import rust_quality.{CargoMetadata, CompilationInputs, DependencyClassifications, DependencyImpactCargo, DependencyImpactGraph, DependencyImpactSource, SourceInventory}.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.File.

import type rust_quality.CargoMetadata.GraphNode.
import type rust_quality.DependencyClassifications.{Classification, ClassificationResult, Duplicate}.
import type rust_quality.DependencyImpactCargo.{CargoAnalysis, DependencyFeature, PackageFanout}.
import type rust_quality.DependencyImpactGraph.{BlastRadius, Cycle}.
import type rust_quality.DependencyImpactSource.{DomainMetric, Edge, SourceAnalysis}.
import type std.core.Option.
import type std.data.Json.

struct TimingRow {
    scenario: String,
    domain: String,
    milliseconds: Int,
}.

struct TimingResult {
    valid: Bool,
    rows: List[TimingRow],
    message: String,
}.

struct DocumentResult {
    valid: Bool,
    document: Json,
    message: String,
}.

struct Model {
    valid: Bool,
    document: String,
    diagnostics: List[String],
    production_domains: Int,
    production_edges: Int,
    test_edges: Int,
    integration_targets: Int,
    message: String,
}.

model_failure(message: String): Model ->
    Model(
        valid = false,
        document = "",
        diagnostics = List.new[String](),
        production_domains = 0,
        production_edges = 0,
        test_edges = 0,
        integration_targets = 0,
        message = message,
    ).

document_failure(message: String): DocumentResult ->
    DocumentResult(valid = false, document = Json.null(), message = message).

@pure
append_item(output: String, item: String): String ->
    if {
        output == "" -> item;
        true -> String.concat([output, ",", item])
    }.

@pure
json_bool(value: Bool): String ->
    if {
        value -> "true";
        true -> "false"
    }.

@pure
strings_at(values: List[String], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] -> strings_at(rest, append_item(output, Json.quote_string(value)))
    }.

@pure
strings_json(values: List[String]): String ->
    strings_at(values, "").

@pure
domains_at(values: List[DomainMetric], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let row =
                String.concat(
                    [
                        "{\"name\":",
                        Json.quote_string(DependencyImpactSource.domain_name(value)),
                        ",\"physical_lines\":",
                        Int.to_string(DependencyImpactSource.domain_physical_lines(value)),
                        ",\"rust_files\":",
                        Int.to_string(DependencyImpactSource.domain_rust_files(value)),
                        "}",
                    ],
                );
            domains_at(rest, append_item(output, row))
    }.

@pure
domains_json(values: List[DomainMetric]): String ->
    domains_at(values, "").

@pure
edges_at(values: List[Edge], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let row =
                String.concat(
                    [
                        "{\"from\":",
                        Json.quote_string(DependencyImpactSource.edge_source(value)),
                        ",\"reference_sites\":",
                        Int.to_string(DependencyImpactSource.edge_reference_sites(value)),
                        ",\"to\":",
                        Json.quote_string(DependencyImpactSource.edge_target(value)),
                        "}",
                    ],
                );
            edges_at(rest, append_item(output, row))
    }.

@pure
edges_json(values: List[Edge]): String ->
    edges_at(values, "").

@pure
workspace_packages_at(values: List[GraphNode], all: List[GraphNode], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let reverse = DependencyImpactGraph.direct_dependents(value.name, all, List.new[String]());
            let row =
                String.concat(
                    [
                        "{\"direct_dependencies\":",
                        strings_json(value.dependencies),
                        ",\"name\":",
                        Json.quote_string(value.name),
                        ",\"reverse_dependents\":",
                        strings_json(reverse),
                        "}",
                    ],
                );
            workspace_packages_at(rest, all, append_item(output, row))
    }.

@pure
workspace_packages_json(values: List[GraphNode]): String ->
    workspace_packages_at(values, values, "").

@pure
cycles_at(values: List[Cycle], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            cycles_at(
                rest,
                append_item(output, strings_json(DependencyImpactGraph.cycle_path(value))),
            )
    }.

@pure
cycles_json(values: List[Cycle]): String ->
    cycles_at(values, "").

@pure
blast_at(values: List[BlastRadius], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let row =
                String.concat(
                    [
                        "{\"dependent_count\":",
                        Int.to_string(List.length(DependencyImpactGraph.blast_dependents(value))),
                        ",\"dependent_domains\":",
                        strings_json(DependencyImpactGraph.blast_dependents(value)),
                        ",\"domain\":",
                        Json.quote_string(DependencyImpactGraph.blast_domain(value)),
                        "}",
                    ],
                );
            blast_at(rest, append_item(output, row))
    }.

@pure
blast_json(values: List[BlastRadius]): String ->
    blast_at(values, "").

@pure
fan_in_sources(domain: String, edges: List[Edge], output: List[String]): List[String] ->
    case edges {
        [] -> output;
        [edge | rest] ->
            fan_in_sources(
                domain,
                rest,
                if {
                    DependencyImpactSource.edge_target(edge) == domain -> CargoMetadata.insert_sorted_unique(
                        DependencyImpactSource.edge_source(edge),
                        output,
                    );
                    true -> output
                },
            )
    }.

@pure
fan_in_sites(domain: String, edges: List[Edge], count: Int): Int ->
    case edges {
        [] -> count;
        [edge | rest] ->
            fan_in_sites(
                domain,
                rest,
                if {
                    DependencyImpactSource.edge_target(edge) == domain -> count + DependencyImpactSource.edge_reference_sites(edge);
                    true -> count
                },
            )
    }.

@pure
fan_in_at(domains: List[DomainMetric], edges: List[Edge], output: String): String ->
    case domains {
        [] -> String.concat(["[", output, "]"]);
        [domain | rest] ->
            let row =
                String.concat(
                    [
                        "{\"domain\":",
                        Json.quote_string(DependencyImpactSource.domain_name(domain)),
                        ",\"reference_sites\":",
                        Int.to_string(
                            fan_in_sites(DependencyImpactSource.domain_name(domain), edges, 0),
                        ),
                        ",\"source_domains\":",
                        strings_json(
                            fan_in_sources(
                                DependencyImpactSource.domain_name(domain),
                                edges,
                                List.new[String](),
                            ),
                        ),
                        "}",
                    ],
                );
            fan_in_at(rest, edges, append_item(output, row))
    }.

@pure
fan_in_json(domains: List[DomainMetric], edges: List[Edge]): String ->
    fan_in_at(domains, edges, "").

@pure
versions_at(values: List[Duplicate], output: String): String ->
