@pure
fanout_at(values: List[PackageFanout], output: String): String ->
    case values {
        [] -> String.concat(["[", output, "]"]);
        [value | rest] ->
            let row =
                String.concat(
                    [
                        "{\"dependencies\":",
                        features_json(DependencyImpactCargo.fanout_dependencies(value)),
