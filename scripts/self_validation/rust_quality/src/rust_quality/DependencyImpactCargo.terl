/**
 * Projects Cargo metadata required by the dependency-impact report.
 */
module rust_quality.DependencyImpactCargo.

import rust_quality.{CargoMetadata, DependencyClassifications, SourceInventory}.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Ordering.{Lt}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.data.Json.

import type rust_quality.CargoMetadata.GraphNode.
import type rust_quality.DependencyClassifications.Duplicate.
import type std.core.Option.
import type std.data.Json.

struct PackageVersions {
    name: String,
    versions: List[String],
}.

pub struct DependencyFeature {
    name: String,
    default_features: Bool,
    features: List[String],
    kind: String,
    optional: Bool,
}.

pub struct PackageFanout {
    name: String,
    dependencies: List[DependencyFeature],
}.

struct State {
    versions: List[PackageVersions],
    fanout: List[PackageFanout],
    integration_targets: List[String],
    direct_dependency_count: Int,
    found_terlan: Bool,
}.

pub struct CargoAnalysis {
    valid: Bool,
    nodes: List[GraphNode],
    integration_targets: List[String],
    direct_dependency_count: Int,
    duplicates: List[Duplicate],
    feature_fanout: List[PackageFanout],
    message: String,
}.

@pure
pub analysis_valid(value: CargoAnalysis): Bool ->
    value.valid.

@pure
pub analysis_message(value: CargoAnalysis): String ->
    value.message.

@pure
pub analysis_nodes(value: CargoAnalysis): List[GraphNode] ->
    value.nodes.

@pure
pub analysis_integration_targets(value: CargoAnalysis): List[String] ->
    value.integration_targets.

@pure
pub analysis_direct_dependency_count(value: CargoAnalysis): Int ->
    value.direct_dependency_count.

@pure
pub analysis_duplicates(value: CargoAnalysis): List[Duplicate] ->
    value.duplicates.

@pure
pub analysis_feature_fanout(value: CargoAnalysis): List[PackageFanout] ->
    value.feature_fanout.

@pure
pub feature_name(value: DependencyFeature): String ->
    value.name.

@pure
pub feature_default_features(value: DependencyFeature): Bool ->
    value.default_features.

@pure
pub feature_features(value: DependencyFeature): List[String] ->
    value.features.

@pure
pub feature_kind(value: DependencyFeature): String ->
    value.kind.

@pure
pub feature_optional(value: DependencyFeature): Bool ->
    value.optional.

@pure
pub fanout_name(value: PackageFanout): String ->
    value.name.

@pure
pub fanout_dependencies(value: PackageFanout): List[DependencyFeature] ->
    value.dependencies.

@pure
empty_state(): State ->
    State(
        versions = List.new[PackageVersions](),
        fanout = List.new[PackageFanout](),
        integration_targets = List.new[String](),
        direct_dependency_count = 0,
        found_terlan = false,
    ).

failure(message: String): CargoAnalysis ->
    CargoAnalysis(
        valid = false,
        nodes = List.new[GraphNode](),
        integration_targets = List.new[String](),
        direct_dependency_count = 0,
        duplicates = List.new[Duplicate](),
        feature_fanout = List.new[PackageFanout](),
        message = message,
    ).

@pure
insert_version_at(
    name: String,
    version: String,
    values: List[PackageVersions],
    prefix: List[PackageVersions],
): List[PackageVersions] ->
    case values {
        [] ->
            List.concat(
                SourceInventory.reverse(prefix),
                List[PackageVersions](PackageVersions(name = name, versions = [version])),
            );
        [current | rest] ->
            if {
                current.name == name -> List.concat(
                    SourceInventory.reverse(prefix),
                    [PackageVersions(
    name = name,
    versions = CargoMetadata.insert_sorted_unique(version, current.versions),
) | rest],
                );
                String.compare(name, current.name) == Lt -> List.concat(
                    SourceInventory.reverse(prefix),
                    [PackageVersions(name = name, versions = [version]) | values],
                );
                true -> insert_version_at(name, version, rest, [current | prefix])
            }
    }.

@pure
insert_version(
    name: String,
    version: String,
    values: List[PackageVersions],
): List[PackageVersions] ->
    insert_version_at(name, version, values, List.new[PackageVersions]()).

@pure
join(values: List[String], output: String): String ->
    case values {
        [] -> output;
        [value | rest] -> join(rest, String.concat([output, "\t", value]))
    }.

@pure
feature_before(value: DependencyFeature, current: DependencyFeature): Bool ->
    if {
        String.compare(value.kind, current.kind) == Lt -> true;
        value.kind != current.kind -> false;
        String.compare(value.name, current.name) == Lt -> true;
        value.name != current.name -> false;
        true -> String.compare(join(value.features, ""), join(current.features, "")) == Lt
    }.

@pure
insert_feature_at(
    value: DependencyFeature,
    values: List[DependencyFeature],
    prefix: List[DependencyFeature],
): List[DependencyFeature] ->
    case values {
        [] -> List.concat(SourceInventory.reverse(prefix), List[DependencyFeature](value));
        [current | rest] ->
            if {
                feature_before(value, current) -> List.concat(SourceInventory.reverse(prefix), [value | values]);
                true -> insert_feature_at(value, rest, [current | prefix])
            }
    }.

@pure
insert_feature(
    value: DependencyFeature,
    values: List[DependencyFeature],
): List[DependencyFeature] ->
    insert_feature_at(value, values, List.new[DependencyFeature]()).

optional_string(value: Json, field: String, fallback: String): Option[String] ->
    case Json.get(value, field) {
        Err(_reason) -> None;
        Ok(member) ->
            if {
                Json.is_null(member) -> Some(fallback);
                true -> case Json.as_string(member) {
                    Err(_reason) -> None;
                    Ok(text) -> Some(text)
                }
            }
    }.

dependency_at(value: Json): Option[DependencyFeature] ->
    let {
        Ok(name_value) <- Json.get(value, "name");
        Ok(original_name) <- Json.as_string(name_value);
        Some(name) <- optional_string(value, "rename", original_name);
        Some(kind) <- optional_string(value, "kind", "normal");
        Ok(default_value) <- Json.get(value, "uses_default_features");
        Ok(default_features) <- Json.as_bool(default_value);
        Ok(optional_value) <- Json.get(value, "optional");
        Ok(optional) <- Json.as_bool(optional_value);
        Some(features) <- CargoMetadata.object_string_array(value, "features")
    } else {
        _ -> None
    };
    Some(
        DependencyFeature(
            name = name,
            default_features = default_features,
            features = CargoMetadata.sort_unique(features),
            kind = kind,
            optional = optional,
        ),
    ).

dependencies_at(
    values: Json,
    index: Int,
    count: Int,
    output: List[DependencyFeature],
): Option[List[DependencyFeature]] ->
    if {
        index == count -> Some(output);
        true -> let {
            Ok(value) <- Json.at(values, index);
            Some(dependency) <- dependency_at(value)
        } else {
            _ -> None
        };
        dependencies_at(values, index + 1, count, insert_feature(dependency, output))
    }.

package_dependencies(package: Json): Option[List[DependencyFeature]] ->
    let {
        Ok(values) <- Json.get(package, "dependencies");
        Ok(count) <- Json.length(values)
    } else {
        _ -> None
    };
    dependencies_at(values, 0, count, List.new[DependencyFeature]()).

@pure
normal_dependency_count(values: List[DependencyFeature], count: Int): Int ->
    case values {
        [] -> count;
        [value | rest] ->
            normal_dependency_count(
                rest,
                if {
                    value.kind == "normal" and not value.optional -> count + 1;
                    true -> count
                },
            )
    }.

target_names_at(
    targets: Json,
    index: Int,
    count: Int,
    output: List[String],
): Option[List[String]] ->
    if {
        index == count -> Some(output);
        true -> let {
            Ok(target) <- Json.at(targets, index);
            Ok(name_value) <- Json.get(target, "name");
            Ok(name) <- Json.as_string(name_value);
            Some(kinds) <- CargoMetadata.object_string_array(target, "kind")
        } else {
            _ -> None
        };
        target_names_at(
            targets,
            index + 1,
            count,
            if {
                kinds == ["test"] -> CargoMetadata.insert_sorted_unique(name, output);
                true -> output
            },
        )
    }.

integration_targets(package: Json): Option[List[String]] ->
    let {
        Ok(targets) <- Json.get(package, "targets");
        Ok(count) <- Json.length(targets)
    } else {
        _ -> None
    };
    target_names_at(targets, 0, count, List.new[String]()).

@pure
insert_fanout_at(
    value: PackageFanout,
    values: List[PackageFanout],
    prefix: List[PackageFanout],
): List[PackageFanout] ->
    case values {
        [] -> List.concat(SourceInventory.reverse(prefix), List[PackageFanout](value));
        [current | rest] ->
            if {
                String.compare(value.name, current.name) == Lt -> List.concat(SourceInventory.reverse(prefix), [value | values]);
                true -> insert_fanout_at(value, rest, [current | prefix])
            }
    }.

@pure
insert_fanout(value: PackageFanout, values: List[PackageFanout]): List[PackageFanout] ->
    insert_fanout_at(value, values, List.new[PackageFanout]()).

package_state(
    package: Json,
    name: String,
    version: String,
    workspace: Bool,
    state: State,
): Option[State] ->
    let versions = insert_version(name, version, state.versions);
    if {
        not workspace and name != "terlan" -> Some(
            State(
                versions = versions,
                fanout = state.fanout,
                integration_targets = state.integration_targets,
                direct_dependency_count = state.direct_dependency_count,
                found_terlan = state.found_terlan,
            ),
        );
        true -> case package_dependencies(package) {
            None -> None;
            Some(dependencies) ->
                if {
                    name == "terlan" -> case integration_targets(package) {
                        None -> None;
                        Some(targets) ->
                            Some(
                                State(
                                    versions = versions,
                                    fanout = insert_fanout(
                                        PackageFanout(name = name, dependencies = dependencies),
                                        state.fanout,
                                    ),
                                    integration_targets = targets,
                                    direct_dependency_count = normal_dependency_count(dependencies, 0),
                                    found_terlan = true,
                                ),
                            )
                    };
                    true -> Some(
                        State(
                            versions = versions,
                            fanout = insert_fanout(
                                PackageFanout(name = name, dependencies = dependencies),
                                state.fanout,
                            ),
                            integration_targets = state.integration_targets,
                            direct_dependency_count = state.direct_dependency_count,
                            found_terlan = state.found_terlan,
                        ),
                    )
                }
        }
    }.

packages_at(
    packages: Json,
    index: Int,
    count: Int,
    members: List[String],
    state: State,
): Option[State] ->
    if {
        index == count -> Some(state);
        true -> let {
            Ok(package) <- Json.at(packages, index);
            Ok(fields) <- Json.required_fields(package, ["id", "name", "version"], [], [])
        } else {
            _ -> None
        };
        case Json.required_field_strings(fields) {
            [id, name, version] ->
                let workspace = CargoMetadata.contains(members, id);
                case package_state(package, name, version, workspace, state) {
                    None -> None;
                    Some(next) -> packages_at(packages, index + 1, count, members, next)
                };
            _ -> None
        }
    }.

@pure
duplicates_at(values: List[PackageVersions], output: List[Duplicate]): List[Duplicate] ->
    case values {
        [] -> SourceInventory.reverse(output);
        [value | rest] ->
            duplicates_at(
                rest,
                if {
                    List.length(value.versions) > 1 -> [DependencyClassifications.duplicate(value.name, value.versions) | output];
                    true -> output
                },
            )
    }.

pub analyze(metadata: Json): CargoAnalysis ->
    let graph = CargoMetadata.workspace_graph(metadata);
    if {
        not graph.valid -> failure(graph.message);
        true -> let {
            Ok(member_values) <- Json.get(metadata, "workspace_members");
            Some(members) <- CargoMetadata.string_array(member_values);
            Ok(packages) <- Json.get(metadata, "packages");
            Ok(count) <- Json.length(packages);
            Some(state) <- packages_at(packages, 0, count, members, empty_state())
        } else {
            _ -> failure("Cargo package metadata has an unsupported dependency shape")
        };
        if {
            not state.found_terlan -> failure("Cargo metadata lacks the `terlan` package");
            true -> CargoAnalysis(
                valid = true,
                nodes = graph.nodes,
                integration_targets = state.integration_targets,
                direct_dependency_count = state.direct_dependency_count,
                duplicates = duplicates_at(state.versions, List.new[Duplicate]()),
                feature_fanout = state.fanout,
                message = "",
            )
        }
    }.

pub self_test(): Bool ->
    normal_dependency_count(
    [
        DependencyFeature(
            name = "a",
            default_features = true,
            features = [],
            kind = "normal",
            optional = false,
        ),
        DependencyFeature(
            name = "b",
            default_features = true,
            features = [],
            kind = "dev",
            optional = false,
        ),
    ],
    0,
) == 1.
