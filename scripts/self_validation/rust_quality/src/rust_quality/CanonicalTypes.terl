/**
 * Validates canonical Rust type invariants directly from the AST audit.
 *
 * Same-name and equal-shape candidates remain available in the generated
 * structural report for analysis. They are not admitted through a manually
 * maintained hash allowlist: source changes must not require opaque evidence
 * identifiers to be copied into the repository.
 */
module rust_quality.CanonicalTypes.

import rust_quality.SourceInventory.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String}.
import std.data.Json.
import std.io.File.

import type std.core.Option.
import type std.data.Json.

pub struct CanonicalResult {
    valid: Bool,
    diagnostics: List[String],
    message: String,
}.

array_length(report: Json, field: String): Option[Int] ->
    when {
        Ok(rows) <- Json.get(report, field);
        Ok(count) <- Json.length(rows)
    } else {
        _ -> None
    };
    Some(count).

@pure
report_diagnostics(parse_count: Int, exact_count: Int): List[String] ->
    let parse_diagnostics =
        if {
            parse_count == 0 -> List.new[String]();
            true -> ["Rust boundary AST inventory contains parse failures"]
        };
    if {
        exact_count == 0 -> parse_diagnostics;
        true -> ["exact normalized Rust type duplicates remain" | parse_diagnostics]
    }.

load(root: String): CanonicalResult ->
    case File.read_text(SourceInventory.child(root, "target/quality/rust-structural-input.json")) {
        Err(_reason) ->
            CanonicalResult(
                valid = false,
                diagnostics = [],
                message = "target/quality/rust-structural-input.json is missing",
            );
        Ok(report_source) ->
            case Json.parse(report_source) {
                Err(reason) ->
                    CanonicalResult(valid = false, diagnostics = [], message = reason.message);
                Ok(report) ->
                    when {
                        Some(parse_count) <- array_length(report, "parse_failures");
                        Some(exact_count) <- array_length(report, "exact_normalized_duplicates")
                    } else {
                        _ ->
                            CanonicalResult(
                                valid = false,
                                diagnostics = [],
                                message = "Rust boundary AST report has an unsupported shape",
                            )
                    };
                    CanonicalResult(
                        valid = true,
                        diagnostics = report_diagnostics(parse_count, exact_count),
                        message = "",
                    )
            }
    }.

pub check(root: String): CanonicalResult ->
    load(root).

pub self_test(): Bool ->
    List.length(report_diagnostics(0, 0)) == 0
        and List.length(report_diagnostics(1, 0)) == 1
        and List.length(report_diagnostics(0, 1)) == 1
        and List.length(report_diagnostics(1, 1)) == 2.
