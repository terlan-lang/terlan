/**
 * Validates compiler-emitted accelerator package metadata and writes evidence.
 */
module scripts.self_validation.AcceleratorPackageMetadata.

import std.core.Option.{None, Some}.
import std.core.Result.{Ok}.
import std.core.{String, Unit}.
import std.crypto.Hash.
import std.data.Json.
import std.io.Directory.{create_all, create_temporary, remove_all}.
import std.io.File.{read_text, write_text}.
import std.io.Path.
import std.system.{Environment, Process}.

import type std.core.Option.
import type std.data.Json.

struct CapabilityOwner {
    capability: String,
    package: String,
}.

struct StringListResult {
    valid: Bool,
    values: List[String],
}.

struct PackageScan {
    valid: Bool,
    owners: List[CapabilityOwner],
    root_matches: Int,
}.

struct JsonWork {
    valid: Bool,
    pending: List[Json],
}.

/**
 * Validates one parsed package-build document and constructs normalized evidence.
 */
pub validate_metadata(metadata: Json): Option[String] ->
    case {
    string_field(metadata, "schema"),
    object_field(metadata, "package"),
    object_field(metadata, "accelerator"),
    object_field(metadata, "accelerator_closure"),
} {
        {Some("terlan-package-build-v1"), Some(package), Some(root), Some(closure)} ->
            validate_closure(metadata, package, root, closure);
        _ -> invalid_result()
    }.

validate_closure(metadata: Json, package: Json, root: Json, closure: Json): Option[String] ->
    case {
    string_field(package, "name"),
    array_field(closure, "packages"),
    object_field(closure, "capability_owners"),
    Json.stringify(root),
} {
        {Some(root_name), Some(packages), Some(owner_index), Ok(root_text)} ->
            let count = array_length(packages);
            let normalized = Json.array();
            let scan = scan_packages(packages, 0, count, root_name, root_text, [], 0, normalized);
            if {
                count == 0
                    or not scan.valid
                    or scan.root_matches != 1
                    or not owner_index_matches(owner_index, scan.owners)
                    or not metadata_is_safe(metadata) -> invalid_result();
                true -> valid_result(root_name, closure, owner_index, normalized)
            };
        _ -> invalid_result()
    }.

scan_packages(
    packages: Json,
    index: Int,
    count: Int,
    root_name: String,
    root_text: String,
    owners: List[CapabilityOwner],
    root_matches: Int,
    mut normalized: Json,
): PackageScan ->
    if {
        index == count -> PackageScan(
            valid = requirements_are_owned(normalized, 0, count, owners),
            owners = owners,
            root_matches = root_matches,
        );
        true -> case packages.at(index) {
            Ok(entry) ->
                scan_package(
                    packages,
                    entry,
                    index,
                    count,
                    root_name,
                    root_text,
                    owners,
                    root_matches,
                    normalized,
                );
            _ -> invalid_package_scan(owners, root_matches)
        }
    }.

scan_package(
    packages: Json,
    entry: Json,
    index: Int,
    count: Int,
    root_name: String,
    root_text: String,
    owners: List[CapabilityOwner],
    root_matches: Int,
    mut normalized: Json,
): PackageScan ->
    let {
        {Some(name), Some(source), Some(descriptor)} <-
            {
                string_field(entry, "package"),
                string_field(entry, "source"),
                object_field(entry, "descriptor"),
            };
        {Some(1), Some(targets), Some(capabilities), Some(requirements)} <-
            {
                int_field(descriptor, "schema"),
                array_field(descriptor, "targets"),
                array_field(descriptor, "capabilities"),
                array_field(descriptor, "requirements"),
            }
    } else {
        _ -> invalid_package_scan(owners, root_matches)
    };
    (let capability_values = json_string_list(capabilities);
let requirement_values = json_string_list(requirements);
let next_owners = append_capability_owners(capability_values.values, name, owners);
if {
    name == ""
        or not relative_path(source)
        or array_length(targets) == 0
        or not targets_are_valid(targets, 0, array_length(targets))
        or not capability_values.valid
        or not requirement_values.valid
        or not next_owners.valid -> invalid_package_scan(owners, root_matches);
    true -> let row = normalized_package(entry, descriptor, name, source, targets, capabilities, requirements);
    let _push = normalized.push(row);
    let next_root_matches = root_matches + root_match(name, root_name, descriptor, root_text);
    scan_packages(
        packages,
        index + 1,
        count,
        root_name,
        root_text,
        next_owners.owners,
        next_root_matches,
        normalized,
    )
}).

struct OwnerAppendResult {
    valid: Bool,
    owners: List[CapabilityOwner],
}.

@pure
append_capability_owners(
    capabilities: List[String],
    package: String,
    owners: List[CapabilityOwner],
): OwnerAppendResult ->
    case capabilities {
        [] -> OwnerAppendResult(valid = true, owners = owners);
        [capability | rest] ->
            if {
                capability == "" or owner_exists(owners, capability) -> OwnerAppendResult(valid = false, owners = owners);
                true -> append_capability_owners(
                    rest,
                    package,
                    [CapabilityOwner(capability = capability, package = package) | owners],
                )
            }
    }.

@pure
owner_exists(owners: List[CapabilityOwner], capability: String): Bool ->
    case owners {
        [] -> false;
        [owner | rest] -> owner.capability == capability or owner_exists(rest, capability)
    }.

owner_index_matches(index: Json, owners: List[CapabilityOwner]): Bool ->
    case index.keys() {
        Ok(keys) ->
            string_count(keys) == owner_count(owners) and indexed_owners_match(owners, index);
        _ -> false
    }.

indexed_owners_match(owners: List[CapabilityOwner], index: Json): Bool ->
    case owners {
        [] -> true;
        [owner | rest] ->
            case string_field(index, owner.capability) {
                Some(actual) -> actual == owner.package and indexed_owners_match(rest, index);
                None -> false
            }
    }.

requirements_are_owned(
    packages: Json,
    index: Int,
    count: Int,
    owners: List[CapabilityOwner],
): Bool ->
    if {
        index == count -> true;
        true -> let {
            Ok(package) <- packages.at(index);
            Some(requirements) <- array_field(package, "requirements")
        } else {
            _ -> false
        };
        requirements_owned(requirements, 0, array_length(requirements), owners)
            and requirements_are_owned(packages, index + 1, count, owners)
    }.

requirements_owned(
    requirements: Json,
    index: Int,
    count: Int,
    owners: List[CapabilityOwner],
): Bool ->
    if {
        index == count -> true;
        true -> let {
            Ok(value) <- requirements.at(index);
            Ok(requirement) <- value.as_string()
        } else {
            _ -> false
        };
        owner_exists(owners, requirement)
            and requirements_owned(requirements, index + 1, count, owners)
    }.

targets_are_valid(targets: Json, index: Int, count: Int): Bool ->
    if {
        index == count -> true;
        true -> case targets.at(index) {
            Ok(target) ->
                availability_is_valid(string_field(target, "availability"))
                    and targets_are_valid(targets, index + 1, count);
            _ -> false
        }
    }.

@pure
availability_is_valid(value: Option[String]): Bool ->
    case value {
        Some("supported") -> true;
        Some("experimental") -> true;
        Some("unsupported") -> true;
        _ -> false
    }.

relative_path(source: String): Bool ->
    if {
        source == "" -> false;
        true -> case Path.from_string(source) {
            Ok(path) -> not path.is_absolute();
            _ -> false
        }
    }.

root_match(name: String, root_name: String, descriptor: Json, root_text: String): Int ->
    case Json.stringify(descriptor) {
        Ok(text) ->
            if {
                name == root_name and text == root_text -> 1;
                true -> 0
            };
        _ -> 0
    }.

normalized_package(
    entry: Json,
    descriptor: Json,
    name: String,
    source: String,
    targets: Json,
    capabilities: Json,
    requirements: Json,
): Json ->
    let row = Json.object();
    let _backend = row.put("backend", field_or_null(descriptor, "backend"));
    let _capabilities = row.put("capabilities", capabilities);
    let _package = row.put("package", Json.string(name));
    let _requirements = row.put("requirements", requirements);
    let _source = row.put("source", Json.string(source));
    let _targets = row.put("targets", targets);
    let _version = row.put("version", field_or_null(entry, "version"));
    row.

valid_result(root_name: String, closure: Json, owners: Json, packages: Json): Option[String] ->
    case Json.stringify(closure) {
        Ok(encoded_closure) ->
            let report = Json.object();
            let _owners = report.put("capability_owners", owners);
            let _digest =
                report
                    .put(
                        "closure_sha256",
                        Json.string(Hash.sha256(String.append(encoded_closure, "\n"))),
                    );
            let _packages = report.put("packages", packages);
            let _root = report.put("root_package", Json.string(root_name));
            let _schema = report.put("schema", Json.string("terlan.accelerator-package-metadata.v1"));
            let _status = report.put("status", Json.string("passed"));
            let _validation = report.put("validation", validation_evidence());
            case Json.stringify_pretty(report) {
                Ok(encoded) -> Some(encoded);
                _ -> None
            };
        _ -> invalid_result()
    }.

validation_evidence(): Json ->
    let validation = Json.object();
    let _cycles = validation.put("capability_cycles", Json.string("rejected-by-compiler"));
    let _owners = validation.put("duplicate_owners", Json.string("rejected-by-compiler"));
    let _requirements = validation.put("missing_requirements", Json.string("rejected-by-compiler"));
    let _target = validation.put("target_mismatch", Json.string("rejected-by-compiler"));
    let _schema = validation.put("unknown_schema", Json.string("rejected-before-native-load"));
    validation.

metadata_is_safe(value: Json): Bool ->
    scan_json_values([value]).

scan_json_values(values: List[Json]): Bool ->
    case values {
        [] -> true;
        [value | pending] ->
            case value.keys() {
                Ok(keys) ->
                    let work = prepend_object_children(value, keys, pending);
                    work.valid and scan_json_values(work.pending);
                _ ->
                    case value.length() {
                        Ok(count) ->
                            let work = prepend_array_children(value, 0, count, pending);
                            work.valid and scan_json_values(work.pending);
                        _ -> scan_json_values(pending)
                    }
            }
    }.

prepend_object_children(value: Json, keys: List[String], pending: List[Json]): JsonWork ->
    case keys {
        [] -> JsonWork(valid = true, pending = pending);
        [key | rest] ->
            if {
                unsafe_key(key) -> JsonWork(valid = false, pending = pending);
                true -> case value.get(key) {
                    Ok(child) -> prepend_object_children(value, rest, [child | pending]);
                    _ -> JsonWork(valid = false, pending = pending)
                }
            }
    }.

prepend_array_children(value: Json, index: Int, count: Int, pending: List[Json]): JsonWork ->
    if {
        index == count -> JsonWork(valid = true, pending = pending);
        true -> case value.at(index) {
            Ok(child) -> prepend_array_children(value, index + 1, count, [child | pending]);
            _ -> JsonWork(valid = false, pending = pending)
        }
    }.

@pure
unsafe_key(key: String): Bool ->
    key == "address"
        or key == "handle"
        or key == "pointer"
        or key == "raw_address"
        or key == "raw_handle"
        or key == "raw_pointer".

json_string_list(value: Json): StringListResult ->
    json_string_list_at(value, 0, array_length(value), []).

json_string_list_at(
    value: Json,
    index: Int,
    count: Int,
    reversed: List[String],
): StringListResult ->
    if {
        index == count -> StringListResult(valid = true, values = reverse_strings(reversed, []));
        true -> let {
            Ok(item) <- value.at(index);
            Ok(text) <- item.as_string()
        } else {
            _ -> StringListResult(valid = false, values = [])
        };
        json_string_list_at(value, index + 1, count, [text | reversed])
    }.

@pure
reverse_strings(values: List[String], accumulated: List[String]): List[String] ->
    case values {
        [] -> accumulated;
        [value | rest] -> reverse_strings(rest, [value | accumulated])
    }.

@pure
string_count(values: List[String]): Int ->
    case values {
        [] -> 0;
        [_ | rest] -> 1 + string_count(rest)
    }.

@pure
owner_count(values: List[CapabilityOwner]): Int ->
    case values {
        [] -> 0;
        [_ | rest] -> 1 + owner_count(rest)
    }.

@pure
string_member(values: List[String], expected: String): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value == expected or string_member(rest, expected)
    }.

@pure
keys_are_safe(values: List[String]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> not unsafe_key(value) and keys_are_safe(rest)
    }.

object_field(value: Json, name: String): Option[Json] ->
    let {
        Ok(field) <- value.get(name);
        Ok(_) <- field.keys()
    } else {
        _ -> None
    };
    Some(field).

array_field(value: Json, name: String): Option[Json] ->
    let {
        Ok(field) <- value.get(name);
        Ok(_) <- field.length()
    } else {
        _ -> None
    };
    Some(field).

string_field(value: Json, name: String): Option[String] ->
    let {
        Ok(field) <- value.get(name);
        Ok(text) <- field.as_string()
    } else {
        _ -> None
    };
    Some(text).

int_field(value: Json, name: String): Option[Int] ->
    let {
        Ok(field) <- value.get(name);
        Ok(number) <- field.as_int()
    } else {
        _ -> None
    };
    Some(number).

field_or_null(value: Json, name: String): Json ->
    case value.get(name) {
        Ok(field) -> field;
        _ -> Json.null()
    }.

array_length(value: Json): Int ->
    case value.length() {
        Ok(count) -> count;
        _ -> 0
    }.

invalid_package_scan(owners: List[CapabilityOwner], root_matches: Int): PackageScan ->
    PackageScan(valid = false, owners = owners, root_matches = root_matches).

invalid_result(): Option[String] ->
    None.

/**
 * Builds package metadata through `terlc`, validates it, and writes a report.
 */
pub generate_report(package_dir: String, compiler: String, output: String): Bool ->
    case create_temporary("terlan-accelerator-metadata") {
        Ok(temporary) ->
            case build_and_validate(package_dir, compiler, temporary) {
                Some(report) ->
                    let cleaned = remove_succeeds(temporary);
                    if {
                        cleaned -> write_report(report, output);
                        true -> false
                    };
                None ->
                    let _cleaned = remove_succeeds(temporary);
                    false
            };
        _ -> false
    }.

build_and_validate(package_dir: String, compiler: String, temporary: String): Option[String] ->
    let command =
        Process.with_output_limit_bytes(
            Process.with_timeout_ms(
                Process.with_arguments(
                    Process.command(compiler),
                    ["build", package_dir, "--out-dir", temporary],
                ),
                120000,
            ),
            4194304,
        );
    case Process.run(command) {
        Ok(completed) ->
            if {
                Process.status(completed) != 0 -> invalid_result();
                true -> let {
                    Ok(text) <- read_text(child(temporary, "terlan-package-build.json"));
                    Ok(metadata) <- Json.parse(text)
                } else {
                    _ -> invalid_result()
                };
                validate_metadata(metadata)
            };
        _ -> invalid_result()
    }.

write_report(encoded: String, output: String): Bool ->
    let contents = String.append(encoded, "\n");
    let created = create_all("target/quality");
    let written = write_text(output, contents);
    let {
        {Ok(Unit), Ok(Unit)} <- {created, written};
        Ok(written) <- read_text(output)
    } else {
        _ -> false
    };
    written == contents.

remove_succeeds(path: String): Bool ->
    case remove_all(path) {
        Ok(Unit) -> true;
        _ -> false
    }.

@pure
child(root: String, name: String): String ->
    String.append(root, String.append("/", name)).

environment_or(name: String, fallback: String): String ->
    case Environment.get(name) {
        Some(value) -> value;
        None -> fallback
    }.

synthetic_metadata(owner: String, unsafe_identity: Bool): String ->
    let unsafe_field =
        if {
            unsafe_identity -> ",\"raw_handle\":7";
            true -> ""
        };
    String.append(
        "{\"accelerator\":{\"backend\":\"vector-test\",\"capabilities\":[\"vector.execute\"],\"requirements\":[],\"schema\":1,\"targets\":[{\"availability\":\"experimental\",\"triple\":\"x86_64-unknown-linux-gnu\"}]},\"accelerator_closure\":{\"capability_owners\":{\"vector.execute\":\"",
        String.append(
            owner,
            String.append(
                "\"},\"packages\":[{\"descriptor\":{\"backend\":\"vector-test\",\"capabilities\":[\"vector.execute\"],\"requirements\":[],\"schema\":1,\"targets\":[{\"availability\":\"experimental\",\"triple\":\"x86_64-unknown-linux-gnu\"}]},\"package\":\"synthetic\",\"source\":\"synthetic/accelerator.toml\",\"version\":\"1.0.0\"}]},\"package\":{\"name\":\"synthetic\"},\"schema\":\"terlan-package-build-v1\"",
                String.append(unsafe_field, "}"),
            ),
        ),
    ).

metadata_text_is_valid(text: String): Bool ->
    let {
        Ok(metadata) <- Json.parse(text);
        Some(_) <- validate_metadata(metadata)
    } else {
        _ -> false
    };
    true.

@test
pub synthetic_metadata_is_normalized(): Bool ->
    let text = synthetic_metadata("synthetic", false);
    metadata_text_is_valid(text).

@test
pub forged_capability_owner_is_rejected(): Bool ->
    let text = synthetic_metadata("impostor", false);
    if {
        metadata_text_is_valid(text) -> false;
        true -> true
    }.

@test
pub unsafe_native_identity_is_rejected_recursively(): Bool ->
    let text = synthetic_metadata("synthetic", true);
    if {
        metadata_text_is_valid(text) -> false;
        true -> true
    }.

@test
pub unsafe_native_identity_name_is_classified(): Bool ->
    unsafe_key("raw_handle").

@test
pub unsafe_native_identity_is_found_at_the_document_root(): Bool ->
    case Json.parse("{\"safe\":1,\"raw_handle\":7}") {
        Ok(metadata) -> not metadata_is_safe(metadata);
        _ -> false
    }.

@test
pub unsafe_synthetic_fixture_contains_the_native_identity(): Bool ->
    let {
        Ok(metadata) <- Json.parse(synthetic_metadata("synthetic", true));
        Ok(value) <- metadata.get("raw_handle");
        Ok(7) <- value.as_int()
    } else {
        _ -> false
    };
    true.

@test
pub unsafe_synthetic_fixture_fails_the_recursive_safety_scan(): Bool ->
    case Json.parse(synthetic_metadata("synthetic", true)) {
        Ok(metadata) -> not metadata_is_safe(metadata);
        _ -> false
    }.

@test
pub unsafe_synthetic_fixture_lists_the_native_identity_key(): Bool ->
    let {
        Ok(metadata) <- Json.parse(synthetic_metadata("synthetic", true));
        Ok(keys) <- metadata.keys()
    } else {
        _ -> false
    };
    string_member(keys, "raw_handle").

@test
pub unsafe_synthetic_fixture_key_list_fails_safety_scan(): Bool ->
    let {
        Ok(metadata) <- Json.parse(synthetic_metadata("synthetic", true));
        Ok(keys) <- metadata.keys()
    } else {
        _ -> false
    };
    not keys_are_safe(keys).

@test
pub repository_package_metadata_report_is_written_by_terlan(): Bool ->
    generate_report(
        environment_or("TERLAN_ACCELERATOR_PACKAGE_DIR", "../terlan-cuda"),
        environment_or("TERLAN_COMPILER", "target/debug/terlc"),
        environment_or(
            "TERLAN_ACCELERATOR_METADATA_OUTPUT",
            "target/quality/accelerator-package-metadata.json",
        ),
    ).
