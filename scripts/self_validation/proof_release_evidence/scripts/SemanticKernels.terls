#!/usr/bin/env -S terlc run
/**
 * Validates proof-visible semantic kernels against their typed runtime oracles.
 */
import proof_release_evidence.{SemanticKernelRecord, Support}.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String, Unit}.
import std.data.Json.
import std.io.Console.{eprintln, println}.
import std.io.File.{read_text}.
import std.system.{Arguments, Environment, Process}.

import type std.core.Option.
import type std.data.Json.
import type std.system.Process.Output.

struct KernelResult {
    valid: Bool,
    message: String,
    evidence: Json,
}.

pass(evidence: Json): KernelResult ->
    KernelResult(valid = true, message = "", evidence = evidence).

reject(message: String): KernelResult ->
    KernelResult(valid = false, message = message, evidence = Json.null()).

root(): String ->
    case Environment.get("TERLAN_SEMANTIC_KERNEL_ROOT") {
        Some(value) -> value;
        None -> Environment.current_directory()
    }.

text(root_path: String, relative: String): Option[String] ->
    case read_text(Support.root_path(root_path, relative)) {
        Ok(source) -> Some(source);
        Err(_reason) -> None
    }.

nth(values: List[String], index: Int): Option[String] ->
    case values {
        [] -> None;
        [value | rest] ->
            if {
                index == 0 -> Some(value);
                true -> nth(rest, index - 1)
            }
    }.

tsv_field_at(lines: List[String], path: String, index: Int): Option[String] ->
    case lines {
        [] -> None;
        [line | rest] ->
            case String.split(line, "\t") {
                [first | _remaining] ->
                    if {
                        first == path -> nth(String.split(line, "\t"), index);
                        true -> tsv_field_at(rest, path, index)
                    };
                _ -> tsv_field_at(rest, path, index)
            }
    }.

tsv_field(
    root_path: String,
    relative: String,
    header: String,
    path: String,
    index: Int,
): Option[String] ->
    let {
        Some(source) <- text(root_path, relative);
        [actual | rows] <- String.split(source, "\n")
    } else {
        _ -> None
    };
    if {
        actual != header -> None;
        true -> tsv_field_at(rows, path, index)
    }.

last(values: List[String]): Option[String] ->
    case values {
        [] -> None;
        [value] -> Some(value);
        [_value | rest] -> last(rest)
    }.

theorems_present(source: String, theorems: List[String]): Option[String] ->
    case theorems {
        [] -> None;
        [theorem | rest] ->
            case last(String.split(theorem, ".")) {
                Some(short) ->
                    if {
                        String.contains(source, String.append("theorem ", short)) -> theorems_present(source, rest);
                        true -> Some(theorem)
                    };
                None -> Some(theorem)
            }
    }.

find_binding(records: Json, slice: String, index: Int, count: Int): Option[Json] ->
    if {
        index >= count -> None;
        true -> let {
            Ok(record) <- records.at(index);
            Some(candidate) <- Support.json_string(record, "slice_id")
        } else {
            _ -> None
        };
        if {
            candidate == slice -> Some(record);
            true -> find_binding(records, slice, index + 1, count)
        }
    }.

binding_is_current(index: Json, slice: String, family: String): Bool ->
    let {
        Some(records) <- Support.json_member(index, "records");
        Ok(count) <- records.length();
        Some(binding) <- find_binding(records, slice, 0, count);
        Some(status) <- Support.json_string(binding, "coverage_status");
        Some(proof_ids_value) <- Support.json_member(binding, "proof_family_ids");
        Some(proof_ids) <- Support.json_array_strings(proof_ids_value)
    } else {
        _ -> false
    };
    status == "proof_current" and Support.same_strings(proof_ids, [family]).

run_command(root_path: String, working: String, values: List[String]): KernelResult ->
    case values {
        [] -> reject("runtime command is empty");
        [program | arguments] ->
            let base = Process.with_arguments(Process.command(program), arguments);
            let located = Process.with_working_directory(base, Support.root_path(root_path, working));
            let configured =
                Process.with_environment(
                    Process.without_environment(located, ["LEAN_PATH"]),
                    [Process.environment_entry("ELAN_NO_UPDATE_CHECK", "1")],
                );
            let bounded =
                if {
                    program == "cargo" -> Process.with_timeout_ms(configured, 300000);
                    true -> Process.with_timeout_ms(configured, 600000)
                }
                    .with_output_limit_bytes(8388608);
            case Process.run(bounded) {
                Ok(output) -> command_result(program, output);
                Err(reason) -> reject(Process.error_message(reason))
            }
    }.

command_result(program: String, output: Output): KernelResult ->
    if {
        Process.status(output) != 0 -> reject(
            String.concat(
                ["command failed: ", program, "\n", Process.stdout(output), Process.stderr(output)],
            ),
        );
        program == "cargo" and not exact_rust_test_output_holds(Process.stdout(output)) -> reject("Rust oracle did not execute exactly one passing, non-ignored test");
        true -> pass(Json.null())
    }.

exact_rust_test_output_holds(output: String): Bool ->
    let normalized = String.replace(output, "\r\n", "\n");
    String.contains(normalized, "running 1 test\n")
        and String.contains(normalized, "test result: ok. 1 passed; 0 failed; 0 ignored;").

rust_runtime_owned_by_canonical_suite(values: List[String]): Bool ->
    let {
        ["cargo" | arguments] <- values;
        ["test" | _remaining] <- arguments
    } else {
        _ -> false
    };
    true.

rust_coverage_requested(): Bool ->
    case Environment.get("TERLAN_RUST_COVERAGE_CONTEXT") {
        Some(_endpoint) -> true;
        _ -> false
    }.

request_rust_coverage(root_path: String, values: List[String]): KernelResult ->
    let {
        ["cargo" | tail] <- values;
        ["test" | arguments] <- tail
    } else {
        _ -> reject("coverage request is not a Rust test command")
    };
    (let program = Support.root_path(root_path, "target/validation-tools/terlan-test-orchestrator");
let request =
    Process.command(program)
        .with_arguments(["--coverage-request" | arguments])
        .with_working_directory(root_path)
        .with_timeout_ms(30000)
        .with_output_limit_bytes(131072);
case Process.run(request) {
    Ok(output) -> command_result(program, output);
    Err(reason) -> reject(Process.error_message(reason))
}).

hosted_source_coverage(): Bool ->
    case Environment.get("TERLAN_RUST_COVERAGE_SCOPE") {
        Some("hosted-source") -> true;
        _ -> false
    }.

selected_proof_paths(
    families: Json,
    selected: String,
    position: Int,
    count: Int,
): Option[List[String]] ->
    if {
        position >= count -> Some([]);
        true -> let {
            Ok(family) <- families.at(position);
            Some(family_id) <- Support.json_string(family, "family");
            Some(proof) <- Support.json_string(family, "proof");
            Some(rest) <- selected_proof_paths(families, selected, position + 1, count)
        } else {
            _ -> None
        };
        if {
            selected == "" or selected == family_id -> Some([proof | rest]);
            true -> Some(rest)
        }
    }.

family_evidence(root_path: String, family: Json, index: Json): KernelResult ->
    let {
        Some(slice) <- Support.json_string(family, "slice");
        Some(family_id) <- Support.json_string(family, "family");
        Some(proof) <- Support.json_string(family, "proof");
        Some(theorem_values) <- Support.json_member(family, "theorems");
        Some(theorems) <- Support.json_array_strings(theorem_values);
        Some(runtime_value) <- Support.json_member(family, "runtime");
        Some(runtime) <- Support.json_array_strings(runtime_value);
        Some(source) <- text(root_path, proof);
        Some(actual_digest) <- Support.file_digest(root_path, proof);
        Some(inventory_status) <-
            tsv_field(
                root_path,
                "docs/compiler/proof_track/lean_proof_inventory.tsv",
                "path\tstatus\tsource_contract\tterlan_version\tgate\tnotes",
                proof,
                1,
            );
        Some(recorded_digest) <-
            tsv_field(
                root_path,
                "proofs/lean/ci/lean-proof-artifacts.tsv",
                "path\tstatus\ttheorem_scope\ttargeted_manifests\texpected_exit\tstderr_class\tproof_digest\treplay_metadata\tremediation_plan",
                proof,
                6,
            )
    } else {
        _ -> reject("semantic kernel input is missing or malformed")
    };
    case theorems_present(source, theorems) {
        Some(missing) ->
            reject(
                String.append(
                    proof,
                    String.append(": missing theorem `", String.append(missing, "`")),
                ),
            );
        None ->
            if {
                inventory_status != "current" -> reject(String.append(proof, ": current inventory row missing"));
                recorded_digest != actual_digest -> reject(String.append(proof, ": artifact digest is stale"));
                not binding_is_current(index, slice, family_id) -> reject(String.append(slice, ": feature binding is not proof-current"));
                true -> let runtime_reused = rust_coverage_requested() and rust_runtime_owned_by_canonical_suite(runtime);
                let runtime_result =
                    if {
                        runtime_reused -> request_rust_coverage(root_path, runtime);
                        true -> run_command(root_path, ".", runtime)
                    };
                let runtime_owner =
                    if {
                        runtime_reused and hosted_source_coverage() -> "hosted-canonical-source-tests";
                        runtime_reused -> "rust-test-suite";
                        true -> "semantic-kernel"
                    };
                if {
                    not runtime_result.valid -> runtime_result;
                    true -> pass(
                        Json.object()
                            .put("slice", Json.string(slice))
                            .put("family", Json.string(family_id))
                            .put("proof", Json.string(proof))
                            .put("proof_digest", Json.string(actual_digest))
                            .put("theorems", theorem_values)
                            .put("runtime_oracle", runtime_value)
                            .put("runtime_oracle_owner", Json.string(runtime_owner))
                            .put("runtime_oracle_reused", Json.bool(runtime_reused))
                            .put("positive_and_rejection_witnesses", Json.bool(true)),
                    )
                }
            }
    }.

check_families(
    root_path: String,
    families: Json,
    index_document: Json,
    selected: String,
    position: Int,
    count: Int,
    evidence: Json,
): KernelResult ->
    if {
        position >= count -> pass(evidence);
        true -> case families.at(position) {
            Ok(family) ->
                case Support.json_string(family, "family") {
                    Some(family_id) ->
                        if {
                            selected != "" and selected != family_id -> check_families(
                                root_path,
                                families,
                                index_document,
                                selected,
                                position + 1,
                                count,
                                evidence,
                            );
                            true -> let checked = family_evidence(root_path, family, index_document);
                            if {
                                not checked.valid -> checked;
                                true -> let _pushed = evidence.push(checked.evidence);
                                check_families(
                                    root_path,
                                    families,
                                    index_document,
                                    selected,
                                    position + 1,
                                    count,
                                    evidence,
                                )
                            }
                        };
                    None -> reject("semantic kernel family has no ID")
                };
            Err(_reason) -> reject("semantic kernel family is unreadable")
        }
    }.

family_exists(families: Json, expected: String, position: Int, count: Int): Bool ->
    if {
        position >= count -> false;
        true -> let {
            Ok(family) <- families.at(position);
            Some(value) <- Support.json_string(family, "family")
        } else {
            _ -> false
        };
        value == expected or family_exists(families, expected, position + 1, count)
    }.

proof_program(root_path: String): String ->
    case Environment.get("TERLAN_PROOF_QUALITY_EXECUTABLE") {
        Some(path) -> path;
        None -> Support.root_path(root_path, "target/debug/terlan-quality")
    }.

run_check(root_path: String, selected: String, completed_only: Bool): Bool ->
    let {
        Some(config) <- Support.load_json(root_path, "proofs/lean/semantic-kernels.json");
        Some(schema) <- Support.json_string(config, "schema");
        Some(families) <- Support.json_member(config, "families");
        Ok(count) <- families.length();
        Some(proof_paths) <- selected_proof_paths(families, selected, 0, count);
        Some(index_document) <-
            Support.load_json(
                root_path,
                "proofs/lean/feature_binding/lean_feature_slice_index.json",
            )
    } else {
        _ -> failure("semantic kernel configuration is malformed")
    };
    if {
        schema != "terlan.lean-semantic-kernel-config.v1" -> failure("semantic kernel configuration has the wrong schema");
        selected != "" and not family_exists(families, selected, 0, count) -> failure(String.append("unknown semantic kernel family `", String.append(selected, "`")));
        true -> let proofs =
            run_command(
                root_path,
                ".",
                [proof_program(root_path) | [if {
    completed_only -> "lean-proof-replay-cached";
    true -> "lean-proof-replay"
} | proof_paths]],
            );
        let result =
            if {
                proofs.valid -> check_families(
                    root_path,
                    families,
                    index_document,
                    selected,
                    0,
                    count,
                    Json.array(),
                );
                true -> proofs
            };
        if {
            not result.valid -> failure(result.message);
            true -> let report =
                Json.object()
                    .put("schema", Json.string("terlan.lean-semantic-kernels.v1"))
                    .put("families", result.evidence)
                    .put("external_protocol_or_database_isolation_claims", Json.bool(false))
                    .put("placeholder_theorems", Json.bool(false));
            if {
                not Support.write_json(root_path, "target/quality/proof-artifacts/lean-semantic-kernels.json", report) -> failure("semantic kernel report could not be written");
                true -> case result.evidence.length() {
                    Ok(checked_count) ->
                        let message =
                            String.append(
                                "Lean semantic kernels passed: ",
                                String.append(Int.to_string(checked_count), " families"),
                            );
                        let _printed = println(message);
                        true;
                    Err(_reason) -> failure("semantic kernel report is unreadable")
                }
            }
        }
    }.

self_test(root_path: String): Bool ->
    let {
        Some(config) <- Support.load_json(root_path, "proofs/lean/semantic-kernels.json");
        Some(families) <- Support.json_member(config, "families");
        Ok(count) <- families.length()
    } else {
        _ -> failure("self-test: semantic kernel configuration is malformed")
    };
    if {
        count != 6 -> failure("self-test: exactly six semantic kernel families are required");
        not selection_contract_holds() -> failure("self-test: selected proof batch is incomplete or unfiltered");
        exact_rust_test_output_holds(
            "running 0 tests\ntest result: ok. 0 passed; 0 failed; 0 ignored;",
        ) -> failure("self-test: zero-test oracle was accepted");
        exact_rust_test_output_holds(
            "running 1 test\ntest result: ok. 0 passed; 0 failed; 1 ignored;",
        ) -> failure("self-test: ignored oracle was accepted");
        not exact_rust_test_output_holds("running 1 test\r\ntest result: ok. 1 passed; 0 failed; 0 ignored;") -> failure("self-test: passing oracle was rejected");
        not rust_runtime_owned_by_canonical_suite(["cargo", "test", "--locked"]) -> failure("self-test: canonical Cargo test ownership was not recognized");
        rust_runtime_owned_by_canonical_suite(["target/debug/terlc", "test", "suite.terl"]) -> failure("self-test: Terlan runtime oracle was assigned to the Rust suite");
        true -> let _printed = println("Lean semantic kernel self-test passed");
        true
    }.

selection_contract_holds(): Bool ->
    let families =
        Json.array()
            .push(selection_fixture("first", "proofs/lean/First.lean"))
            .push(selection_fixture("second", "proofs/lean/Second.lean"));
    case {
    selected_proof_paths(families, "", 0, 2),
    selected_proof_paths(families, "second", 0, 2),
    selected_proof_paths(Json.array().push(Json.object()), "", 0, 1),
} {
        {Some(["proofs/lean/First.lean", "proofs/lean/Second.lean"]), Some(["proofs/lean/Second.lean"]), None} ->
            true;
        _ -> false
    }.

selection_fixture(family: String, proof: String): Json ->
    Json.object().put("family", Json.string(family)).put("proof", Json.string(proof)).

failure(message: String): Bool ->
    let _printed = eprintln(String.append("Lean semantic kernel failure: ", message));
    false.

run(root_path: String, command: String, selected: String): Bool ->
    if {
        command == "record" -> let result = SemanticKernelRecord.record(root_path);
        if {
            result.valid -> true;
            true -> failure(result.message)
        };
        command == "self-test" -> self_test(root_path);
        command == "check" -> run_check(root_path, "", false);
        command == "check-cached" -> self_test(root_path) and run_check(root_path, "", true);
        command == "check-family" -> run_check(root_path, selected, false);
        true -> failure(
            "usage: SemanticKernels.terls <record|self-test|check|check-cached|check-family FAMILY>",
        )
    }.

entry(): Bool ->
    let repository = root();
    let command =
        case Arguments.get(0) {
            Some(value) -> value;
            None -> ""
        };
    let selected =
        case Arguments.get(1) {
            Some(value) -> value;
            None -> ""
        };
    run(repository, command, selected).

assert(entry());
Unit.
