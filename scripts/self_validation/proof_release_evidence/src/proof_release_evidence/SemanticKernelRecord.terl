/**
 * Deterministic semantic-kernel metadata and inventory recording.
 */
module proof_release_evidence.SemanticKernelRecord.

import proof_release_evidence.Support.
import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Int, String, Unit}.
import std.crypto.Hash.
import std.data.Json.
import std.io.File.{read_text, write_text}.

import type std.core.Option.
import type std.data.Json.

pub struct RecordResult {
    valid: Bool,
    message: String,
}.

struct State {
    valid: Bool,
    message: String,
    inventory: List[String],
    artifacts: List[String],
    index: Json,
}.

passed(): RecordResult ->
    RecordResult(valid = true, message = "").

rejected(message: String): RecordResult ->
    RecordResult(valid = false, message = message).

invalid_state(message: String): State ->
    let inventory = List.new[String]();
    let artifacts = List.new[String]();
    let index = Json.null();
    State(
        valid = false,
        message = message,
        inventory = inventory,
        artifacts = artifacts,
        index = index,
    ).

nonempty(values: List[String], collected: List[String]): List[String] ->
    case values {
        [] -> Support.reverse_strings(collected);
        [value | rest] ->
            nonempty(
                rest,
                if {
                    value == "" -> collected;
                    true -> [value | collected]
                },
            )
    }.

remove_path(values: List[String], path: String, collected: List[String]): List[String] ->
    case values {
        [] -> Support.reverse_strings(collected);
        [value | rest] ->
            case String.split(value, "\t") {
                [first | _fields] ->
                    remove_path(
                        rest,
                        path,
                        if {
                            first == path -> collected;
                            true -> [value | collected]
                        },
                    );
                _ -> remove_path(rest, path, collected)
            }
    }.

upsert(values: List[String], path: String, row: String): List[String] ->
    let retained = remove_path(values, path, []);
    Support.sort_strings([row | retained]).

join(values: List[String], separator: String): String ->
    case values {
        [] -> "";
        [value] -> value;
        [value | rest] -> String.append(value, String.append(separator, join(rest, separator)))
    }.

read_rows(root: String, relative: String, header: String): Option[List[String]] ->
    let {
        Ok(source) <- read_text(Support.root_path(root, relative));
        [actual | rows] <- String.split(source, "\n")
    } else {
        _ -> None
    };
    if {
        actual == header -> Some(nonempty(rows, []));
        true -> None
    }.

write_rows(root: String, relative: String, header: String, rows: List[String]): Bool ->
    let body = join(rows, "\n");
    let source = String.append(header, String.append("\n", String.append(body, "\n")));
    case write_text(Support.root_path(root, relative), source) {
        Ok(Unit) -> true;
        Err(_reason) -> false
    }.

dependency_source(
    root: String,
    paths: List[String],
    separator: String,
    collected: List[String],
): Option[String] ->
    case paths {
        [] -> Some(concat(Support.reverse_strings(collected)));
        [path | rest] ->
            case read_text(Support.root_path(root, path)) {
                Ok(source) ->
                    dependency_source(
                        root,
                        rest,
                        separator,
                        [String.append(path, String.append(separator, source)) | collected],
                    );
                Err(_reason) -> None
            }
    }.

concat(values: List[String]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.append(value, concat(rest))
    }.

dependency_digest(root: String, paths: List[String]): Option[String] ->
    let {
        Ok(value) <- Json.parse("\"\\u0000\"");
        Ok(separator) <- value.as_string();
        Some(source) <- dependency_source(root, Support.sort_strings(paths), separator, [])
    } else {
        _ -> None
    };
    Some(String.append("sha256:", Hash.sha256(source))).

fingerprints(root: String, manifests: List[String], result: Json): Option[Json] ->
    case manifests {
        [] -> Some(result);
        [path | rest] ->
            case Support.file_digest(root, path) {
                Some(digest) ->
                    let _put = result.put(path, Json.string(digest));
                    fingerprints(root, rest, result);
                None -> None
            }
    }.

proof_relative(path: String): Option[String] ->
    case String.split_once(path, "proofs/lean/") {
        Some({_prefix, relative}) -> Some(relative);
        None -> None
    }.

metadata(
    root: String,
    family: String,
    proof: String,
    theorem_values: Json,
    manifests: List[String],
    dependencies: List[String],
    dependency_hash: String,
    proof_digest: String,
): Option[Json] ->
    let {
        Some(manifest_values) <- fingerprints(root, manifests, Json.object());
        Some(relative) <- proof_relative(proof)
    } else {
        _ -> None
    };
    Some(
        Json.object()
            .put("schema", Json.string("terlan.lean-proof-replay.v1"))
            .put("family", Json.string(family))
            .put("theorem_names", theorem_values)
            .put("manifest_fingerprints", manifest_values)
            .put("dependency_files", Support.json_string_array(Support.sort_strings(dependencies)))
            .put("proof_dependency_set_hash", Json.string(dependency_hash))
            .put("source_digest", Json.string(proof_digest))
            .put("execution_command", Support.json_string_array(["lake", "env", "lean", relative]))
            .put("working_directory", Json.string("proofs/lean"))
            .put("deterministic_timestamp_strategy", Json.string("none-content-addressed"))
            .put(
                "output_signature",
                Json.object()
                    .put("stdout_class", Json.string("empty"))
                    .put("stderr_class", Json.string("empty"))
                    .put("exit_class", Json.string("success")),
            )
            .put(
                "toolchain",
                Json.object()
                    .put("lean_version", Json.string("4.31.0"))
                    .put("elan_channel", Json.string("leanprover/lean4:v4.31.0"))
                    .put("lake_flags", Support.json_string_array(["env", "lean"])),
            ),
    ).

update_binding(records: Json, slice: String, family: String, position: Int, count: Int): Bool ->
    if {
        position >= count -> false;
        true -> let {
            Ok(record) <- records.at(position);
            Some(candidate) <- Support.json_string(record, "slice_id")
        } else {
            _ -> false
        };
        if {
            candidate != slice -> update_binding(records, slice, family, position + 1, count);
            true -> let _proofs = record.put("proof_family_ids", Support.json_string_array([family]));
            let _gaps = record.put("gap_ids", Json.array());
            let _coverage = record.put("coverage_status", Json.string("proof_current"));
            let _hash = record.put("blocker_hash", Json.string("none"));
            let _reason = record.put("blocker_reason", Json.string("none"));
            let _expiry = record.put("blocker_expiry", Json.string("none"));
            let _gate = record.put("planned_fix_gate", Json.string("lean-proof-semantic-kernels-check"));
            let _record = records.set(position, record);
            true
        }
    }.

record_families(
    root: String,
    families: Json,
    dependencies: List[String],
    dependency_hash: String,
    position: Int,
    count: Int,
    state: State,
): State ->
    if {
        not state.valid or position >= count -> state;
        true -> case families.at(position) {
            Ok(value) ->
                let {
                    Some(slice) <- Support.json_string(value, "slice");
                    Some(family) <- Support.json_string(value, "family");
                    Some(proof) <- Support.json_string(value, "proof");
                    Some(scope) <- Support.json_string(value, "scope");
                    Some(manifest_values) <- Support.json_member(value, "manifests");
                    Some(manifests) <- Support.json_array_strings(manifest_values);
                    Some(theorems) <- Support.json_member(value, "theorems");
                    Some(proof_digest) <- Support.file_digest(root, proof);
                    Some(replay) <-
                        metadata(
                            root,
                            family,
                            proof,
                            theorems,
                            manifests,
                            dependencies,
                            dependency_hash,
                            proof_digest,
                        );
                    Some(records) <- Support.json_member(state.index, "records");
                    Ok(record_count) <- records.length()
                } else {
                    _ -> invalid_state("semantic kernel record is malformed")
                };
                (let metadata_path = String.append("proofs/lean/artifacts/", String.append(family, ".json"));
let inventory_row =
    join(
        [
            proof,
            "current",
            String.append("0.0.7 ", String.append(family, " semantic kernel")),
            "0.0.7",
            "lean-proof-track-check",
            "Executable positive and rejection witnesses paired with a typed runtime oracle.",
        ],
        "\t",
    );
let artifact_row =
    join(
        [
            proof,
            "current",
            scope,
            join(manifests, ";"),
            "0",
            "none",
            proof_digest,
            metadata_path,
            "none",
        ],
        "\t",
    );
if {
    not Support.write_json(root, metadata_path, replay) -> invalid_state(String.append("could not write ", metadata_path));
    not update_binding(records, slice, family, 0, record_count) -> invalid_state(String.append("missing feature binding: ", slice));
    true -> let _records = state.index.put("records", records);
    record_families(
        root,
        families,
        dependencies,
        dependency_hash,
        position + 1,
        count,
        State(
            valid = true,
            message = "",
            inventory = upsert(state.inventory, proof, inventory_row),
            artifacts = upsert(state.artifacts, proof, artifact_row),
            index = state.index,
        ),
    )
});
            Err(_reason) -> invalid_state("semantic kernel record is unreadable")
        }
    }.

pub record(root: String): RecordResult ->
    let inventory_header = "path\tstatus\tsource_contract\tterlan_version\tgate\tnotes";
    let artifact_header = "path\tstatus\ttheorem_scope\ttargeted_manifests\texpected_exit\tstderr_class\tproof_digest\treplay_metadata\tremediation_plan";
    let {
        Some(config) <- Support.load_json(root, "proofs/lean/semantic-kernels.json");
        Some(families) <- Support.json_member(config, "families");
        Some(dependency_values) <- Support.json_member(config, "dependencies");
        Some(dependencies) <- Support.json_array_strings(dependency_values);
        Some(dependency_hash) <- dependency_digest(root, dependencies);
        Some(inventory) <- read_rows(root, "docs/compiler/proof_track/lean_proof_inventory.tsv", inventory_header);
        Some(artifacts) <- read_rows(root, "proofs/lean/ci/lean-proof-artifacts.tsv", artifact_header);
        Some(index) <- Support.load_json(root, "proofs/lean/feature_binding/lean_feature_slice_index.json");
        Ok(count) <- families.length()
    } else {
        _ -> rejected("semantic kernel record inputs are malformed")
    };
    (let state =
    record_families(
        root,
        families,
        dependencies,
        dependency_hash,
        0,
        count,
        State(
            valid = true,
            message = "",
            inventory = inventory,
            artifacts = artifacts,
            index = index,
        ),
    );
if {
    not state.valid -> rejected(state.message);
    not write_rows(
    root,
    "docs/compiler/proof_track/lean_proof_inventory.tsv",
    inventory_header,
    state.inventory,
) -> rejected("could not write Lean proof inventory");
    not write_rows(root, "proofs/lean/ci/lean-proof-artifacts.tsv", artifact_header, state.artifacts) -> rejected("could not write Lean proof artifacts");
    not Support.write_json(root, "proofs/lean/feature_binding/lean_feature_slice_index.json", state.index) -> rejected("could not write Lean feature binding index");
    true -> passed()
}).
