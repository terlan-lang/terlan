/**
 * Offline release state-machine regressions.
 */
module release_control.Tests.

import release_control.{Status, Support, Tag, Version}.
import std.core.Result.{Err, Ok}.
import std.data.Json.

import type std.data.Json.

job(name: String, status: String, conclusion: String): Json ->
    Json.object()
        .put("name", Json.string(name))
        .put("status", Json.string(status))
        .put("conclusion", Json.string(conclusion)).

workflow_with_jobs(state: String, jobs: Json): Json ->
    Json.object().put("state", Json.string(state)).put("jobs", jobs).

@test
pub required_release_job_must_run_and_pass(): Bool ->
    let passed =
        Status.require_job(
            workflow_with_jobs(
                "success",
                Json.array()
                    .push(job("other", "completed", "success"))
                    .push(job("Compiler check and test", "completed", "success")),
            ),
            "Compiler check and test",
        );
    let skipped =
        Status.require_job(
            workflow_with_jobs(
                "success",
                Json.array().push(job("Compiler check and test", "completed", "skipped")),
            ),
            "Compiler check and test",
        );
    let running =
        Status.require_job(
            workflow_with_jobs(
                "waiting",
                Json.array().push(job("Compiler check and test", "in_progress", "")),
            ),
            "Compiler check and test",
        );
    let failed =
        Status.require_job(
            workflow_with_jobs(
                "success",
                Json.array().push(job("Compiler check and test", "completed", "failure")),
            ),
            "Compiler check and test",
        );
    Support.text(passed, "state") == "success"
        and Support.text(skipped, "state") == "missing"
        and Support.text(running, "state") == "waiting"
        and Support.text(failed, "state") == "failed"
        and Support.text(
    Status.require_job(workflow_with_jobs("success", Json.array()), "Compiler check and test"),
    "state",
) == "missing"
        and Support.text(Status.require_job(workflow_with_jobs("success", Json.array()), ""), "state") == "success"
        and Support.text(Status.require_job(Json.object(), "Compiler check and test"), "state") == "failed".

row_event(revision: String, event: String, status: String, conclusion: String): Json ->
    Json.array()
        .push(
            Json.object()
                .put("headSha", Json.string(revision))
                .put("event", Json.string(event))
                .put("databaseId", Json.int(17))
                .put("url", Json.string("https://github.com/terlan-lang/terlan/actions/runs/17"))
                .put("status", Json.string(status))
                .put("conclusion", Json.string(conclusion)),
        ).

row(revision: String, status: String, conclusion: String): Json ->
    row_event(revision, "workflow_dispatch", status, conclusion).

state(status: String, conclusion: String): Json ->
    case Status.workflow(row("candidate", status, conclusion), "candidate", "ci.yml") {
        Ok(value) -> value;
        Err(_reason) -> Json.null()
    }.

/**
 * Covers pending, missing, failed, malformed, stale, and complete workflow evidence.
 */
pub run(): Bool ->
    let success = state("completed", "success");
    let pending = state("in_progress", "");
    let failed = state("completed", "failure");
    let cancelled = state("completed", "cancelled");
    required_release_job_must_run_and_pass()
        and Version.valid("0.0.9")
        and Tag.version_matches("[workspace.package]\nversion = \"0.0.9\"\n", "0.0.9")
        and not Tag.version_matches("[workspace.package]\nversion = \"0.0.8\"\n", "0.0.9")
        and not Tag.version_matches("[package]\nversion = \"0.0.9\"\n", "0.0.9")
        and not Tag.version_matches("[workspace.package]\n[package]\nversion = \"0.0.9\"\n", "0.0.9")
        and Version.valid("1.20.3")
        and not Version.valid("v0.0.9")
        and not Version.valid("0.0.09")
        and not Version.valid("0.-1.9")
        and not Version.valid("0.0")
        and not Status.assets_available(Json.array())
        and not Status.assets_available(
    Json.array()
        .push(
            Json.object()
                .put("name", Json.string("release-distribution"))
                .put("expired", Json.bool(true)),
        )
        .push(
            Json.object()
                .put("name", Json.string("release-hosted-validation-evidence"))
                .put("expired", Json.bool(false)),
        )
        .push(
            Json.object()
                .put("name", Json.string("release-publication-bundle"))
                .put("expired", Json.bool(false)),
        ),
)
        and Status.decision(success, pending) == "waiting"
        and Status.decision(pending, success) == "waiting"
        and Status.decision(success, failed) == "failed"
        and Status.decision(cancelled, success) == "failed"
        and Status.decision(success, success) == "ready"
        and Status.publishable(Json.object().put("state", Json.string("ready")))
        and Status.publishable(Json.object().put("state", Json.string("published")))
        and not Status.publishable(Json.object().put("state", Json.string("waiting")))
        and not Status.publishable(Json.object())
        and case Status.workflow(Json.array(), "candidate", "ci.yml") {
    Ok(value) -> Support.text(value, "state") == "missing";
    _ -> false
}
        and case Status.workflow(row("stale", "completed", "success"), "candidate", "ci.yml") {
    Err(_reason) -> true;
    _ -> false
}
        and case Status.workflow(Json.object(), "candidate", "ci.yml") {
    Err(_reason) -> true;
    _ -> false
}
        and case Status.workflow(row("candidate", "unexpected", "success"), "candidate", "ci.yml") {
    Err(_reason) -> true;
    _ -> false
}
        and case Status.workflow(row_event("candidate", "push", "completed", "success"), "candidate", "ci.yml") {
    Err(_reason) -> true;
    _ -> false
}.
