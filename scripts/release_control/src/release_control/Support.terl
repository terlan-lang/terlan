/**
 * Bounded child processes and JSON access for release control.
 */
module release_control.Support.

import std.core.Result.{Err, Ok}.
import std.core.String.
import std.data.Json.
import std.system.Process.

import type std.core.Result.
import type std.data.Json.

/**
 * Runs a child with closed stdin and bounded captured output.
 */
pub run(program: String, arguments: List[String], timeout: Int): Result[String, String] ->
    let command =
        Process.with_output_limit_bytes(
            Process.with_timeout_ms(
                Process.with_arguments(Process.command(program), arguments),
                timeout,
            ),
            8_388_608,
        );
    case Process.run(command) {
        Err(reason) -> Err(reason.message);
        Ok(output) ->
            if {
                output.status == 0 -> Ok(String.trim(output.stdout));
                true -> Err(String.concat([program, " failed: ", output.stderr, "\n", output.stdout]))
            }
    }.

retryable(
    program: String,
    arguments: List[String],
    timeout: Int,
    attempts: Int,
): Result[String, String] ->
    case run(program, arguments, timeout) {
        Ok(output) -> Ok(output);
        Err(reason) ->
            if {
                attempts <= 1 -> Err(reason);
                true -> case run("sleep", ["5"], 10_000) {
                    Err(_sleep_reason) -> Err(reason);
                    Ok(_slept) -> retryable(program, arguments, timeout, attempts - 1)
                }
            }
    }.

/**
 * Retries an idempotent external observation three times. Mutating operations
 * such as workflow dispatch, tag creation, and pushes must continue using
 * `run` so an uncertain result cannot be repeated.
 */
pub run_retryable(program: String, arguments: List[String], timeout: Int): Result[String, String] ->
    retryable(program, arguments, timeout, 3).

/**
 * Parses a successful GitHub CLI response as JSON.
 */
pub github(arguments: List[String]): Result[Json, String] ->
    case run_retryable("gh", arguments, 60_000) {
        Err(reason) -> Err(reason);
        Ok(source) ->
            case Json.parse(source) {
                Ok(document) -> Ok(document);
                Err(reason) -> Err(reason.message)
            }
    }.

/**
 * Reads a string field; absent or malformed fields remain visibly empty.
 */
pub text(document: Json, key: String): String ->
    when {
        Ok(value) <- document.get(key);
        Ok(text) <- value.as_string()
    } else {
        _ -> ""
    };
    text.

/**
 * Reads an integer field; invalid values cannot become valid workflow identifiers.
 */
pub number(document: Json, key: String): Int ->
    when {
        Ok(value) <- document.get(key);
        Ok(number) <- value.as_int()
    } else {
        _ -> -1
    };
    number.

/**
 * Formats one stable machine-readable document.
 */
pub render(document: Json): Result[String, String] ->
    case Json.stringify_pretty(document) {
        Ok(source) -> Ok(source);
        Err(reason) -> Err(reason.message)
    }.
