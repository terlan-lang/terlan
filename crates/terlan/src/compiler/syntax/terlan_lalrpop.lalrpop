};

GeneratedTraitMember: LalrpopSyntaxNode = {
    GeneratedTraitConstant,
    GeneratedTraitMethod,
};

GeneratedTraitConstant: LalrpopSyntaxNode = {
    <start:@L> "const" <name_start:@L> "upper-ident" <name_end:@R> ":"
        <annotation:TypeExpression> <default:("="<AssignmentExpression>)?> "." <end:@R>
        => {
            let mut children = vec![annotation];
            children.extend(default);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ConstantDeclaration,
                start,
                end,
                Some(source_index.text(source, name_start, name_end).to_string()),
                children,
            )
        },
};

GeneratedTraitMethod: LalrpopSyntaxNode = {
    <annotations:GeneratedAnnotation*>
        <start:@L> <name_start:@L> NameToken <name_end:@R>
        <type_parameters:GeneratedCallableTypeParameters?>
        <head_constraints:GeneratedHeadConstraintList?>
        "(" <parameters:Comma<GeneratedParameter>> ")"
        <constraints:GeneratedConstraintList?> ":"
        <return_type:TypeExpression>
        <body:(BodyArrow <Expression>)?> "." <end:@R>
        => {
            let annotation_count = annotations.len();
            let generic_count = type_parameters.as_ref().map_or(0, Vec::len);
            let head_constraint_count = head_constraints.as_ref().map_or(0, Vec::len);
            let parameter_count = parameters.len();
            let constraint_count = constraints.as_ref().map_or(0, Vec::len);
            let has_body = body.is_some();
            let mut children = annotations;
            children.extend(type_parameters.unwrap_or_default());
            children.extend(head_constraints.unwrap_or_default());
            children.extend(parameters);
            children.extend(constraints.unwrap_or_default());
            children.push(return_type);
            children.extend(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::FunctionDeclaration,
                start,
                end,
                Some(format!(
                    "{};annotations:{annotation_count};generics:{generic_count};head_constraints:{head_constraint_count};params:{parameter_count};constraints:{constraint_count};body:{has_body}",
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedTraitImplementationDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "impl" <negative:"negative-impl-not"?>
        <trait_ref:TypeExpression>
        <body:GeneratedTraitImplementationBody> <end:@R>
        => {
            let has_body = !body.is_empty();
            let mut children = vec![trait_ref];
            children.extend(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::TraitImplementationDeclaration,
                start,
                end,
                Some(format!(
                    "{}{}impl;body:{}",
                    if public.is_some() { "pub " } else { "" },
                    if negative.is_some() { "not " } else { "" },
                    has_body,
                )),
                children,
            )
        },
};

GeneratedTraitImplementationBody: Vec<LalrpopSyntaxNode> = {
    "." => Vec::new(),
    "for" <for_type:TypeExpression>
        "{" <members:GeneratedTraitImplementationMember*> "}" "."
        => {
            let mut children = vec![for_type];
            children.extend(members);
            children
        },
};

GeneratedTraitImplementationMember: LalrpopSyntaxNode = {
    GeneratedImplementationConstant,
    GeneratedFunctionDeclaration,
};

GeneratedImplementationConstant: LalrpopSyntaxNode = {
    <start:@L> "const" <name_start:@L> "upper-ident" <name_end:@R>
        <annotation:(":" <TypeExpression>)?> "=" <value:AssignmentExpression> "." <end:@R>
        => {
            let mut children = annotation.into_iter().collect::<Vec<_>>();
            children.push(value);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ConstantDeclaration,
                start,
                end,
                Some(source_index.text(source, name_start, name_end).to_string()),
                children,
            )
        },
};

GeneratedTemplateDeclaration: LalrpopSyntaxNode = {
    <start:@L> "template" <name_start:@L> TypeName <name_end:@R>
        "from" <path_start:@L> "string" <path_end:@R>
        "{" <properties:Comma<GeneratedStructField>> "}" "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TemplateDeclaration,
            start,
            end,
            Some(format!(
                "{} from {}",
                source_index.text(source, name_start, name_end),
                source_index.text(source, path_start, path_end),
            )),
            properties,
        ),
};

GeneratedShapeDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "shape"
        <name_start:@L> TypeName <name_end:@R>
        "(" <parameters:Comma<Pattern>> ")" "="
        <body:Pattern> <guard:("where" <AssignmentExpression>)?> "." <end:@R>
        => {
            let parameter_count = parameters.len();
            let has_guard = guard.is_some();
            let mut children = parameters;
            children.push(body);
            children.extend(guard);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ShapeDeclaration,
                start,
                end,
                Some(format!(
                    "{}{};params:{parameter_count};guard:{has_guard}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedStructField: LalrpopSyntaxNode = {
    <start:@L> <private:"#"? > <name_start:@L> NameToken <name_end:@R> ":"
        <annotation:TypeExpression> <default:("=" <AssignmentExpression>)?> <end:@R>
        => {
            let mut children = vec![annotation];
            children.extend(default);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::StructField,
                start,
                end,
                Some(format!(
                    "{}{}",
                    if private.is_some() { "#" } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedFunctionDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> <macro_token:"macro"?>
        <name_start:@L> NameToken <name_end:@R>
        <type_parameters:GeneratedCallableTypeParameters?>
        <head_constraints:GeneratedHeadConstraintList?>
        "(" <parameters:Comma<GeneratedParameter>> ")"
        <constraints:GeneratedConstraintList?> ":"
        <return_type:TypeExpression>
        <body:(BodyArrow <Expression>)?> "." <end:@R>
        => {
            let generic_count = type_parameters.as_ref().map_or(0, Vec::len);
            let head_constraint_count = head_constraints.as_ref().map_or(0, Vec::len);
            let parameter_count = parameters.len();
            let constraint_count = constraints.as_ref().map_or(0, Vec::len);
            let has_body = body.is_some();
            let mut children = type_parameters.unwrap_or_default();
            children.extend(head_constraints.unwrap_or_default());
            children.extend(parameters);
            children.extend(constraints.unwrap_or_default());
            children.push(return_type);
            children.extend(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::FunctionDeclaration,
                start,
                end,
                Some(format!(
                    "{}{}{};generics:{generic_count};head_constraints:{head_constraint_count};params:{parameter_count};constraints:{constraint_count};body:{has_body}",
                    if public.is_some() { "pub " } else { "" },
                    if macro_token.is_some() { "macro " } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedClauseFunctionDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> <first:GeneratedFunctionClause>
        <rest:(";" <GeneratedFunctionClause>)*> "." <end:@R>
        => {
            let mut clauses = Vec::with_capacity(rest.len() + 1);
            clauses.push(first);
            clauses.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::FunctionDeclaration,
                start,
                end,
                Some(format!(
                    "{}clauses",
                    if public.is_some() { "pub " } else { "" },
                )),
                clauses,
            )
        },
};

GeneratedFunctionClause: LalrpopSyntaxNode = {
    <start:@L> <name_start:@L> NameToken <name_end:@R>
        "function-clause-(" <patterns:Comma<Pattern>> ")"
        <guard:("where" <AssignmentExpression>)?>
        "->" <body:AssignmentExpression> <end:@R>
        => {
            let pattern_count = patterns.len();
            let has_guard = guard.is_some();
            let mut children = patterns;
            children.extend(guard);
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Clause,
                start,
                end,
                Some(format!(
                    "{};patterns:{pattern_count};guard:{has_guard}",
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedMethodDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "(" <mutable:"mut"?>
        <receiver_start:@L> NameToken <receiver_name_end:@R> ":"
        <receiver_type:TypeExpression> ")"
        <name_start:@L> NameToken <name_end:@R>
        <type_parameters:GeneratedCallableTypeParameters?>
        <head_constraints:GeneratedHeadConstraintList?>
        "(" <parameters:Comma<GeneratedParameter>> ")"
        <constraints:GeneratedConstraintList?> ":"
        <return_type:TypeExpression> <body:(BodyArrow <Expression>)?> "." <end:@R>
        => {
            let generic_count = type_parameters.as_ref().map_or(0, Vec::len);
            let head_constraint_count = head_constraints.as_ref().map_or(0, Vec::len);
            let parameter_count = parameters.len();
            let constraint_count = constraints.as_ref().map_or(0, Vec::len);
            let has_body = body.is_some();
            let receiver_end = receiver_type.span.end;
            let receiver = LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Receiver,
                receiver_start,
                receiver_end,
                Some(format!(
                    "{}{}",
                    if mutable.is_some() { "mut " } else { "" },
                    source_index.text(source, receiver_start, receiver_name_end),
                )),
                vec![receiver_type],
            );
            let mut children = vec![receiver];
            children.extend(type_parameters.unwrap_or_default());
            children.extend(head_constraints.unwrap_or_default());
            children.extend(parameters);
            children.extend(constraints.unwrap_or_default());
            children.push(return_type);
            children.extend(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::MethodDeclaration,
                start,
                end,
                Some(format!(
                    "{}{};generics:{generic_count};head_constraints:{head_constraint_count};params:{parameter_count};constraints:{constraint_count};body:{has_body}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedConstraintList: Vec<LalrpopSyntaxNode> = {
    "[" <constraints:NonEmptyComma<TypeExpression>> "]" => constraints,
};

GeneratedHeadConstraintList: Vec<LalrpopSyntaxNode> = {
    <start:@L> "head-constraints" <end:@R> => vec![
        LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Type,
            source,
            source_index,
            start,
            end,
        )
    ],
};

GeneratedCallableTypeParameters: Vec<LalrpopSyntaxNode> = {
    GeneratedTypeParameters,
    "<" <parameters:NonEmptyComma<GeneratedAngleTypeParameter>> ">" => parameters,
};

GeneratedAngleTypeParameter: LalrpopSyntaxNode = {
    <start:@L> TypeName <bounds:(":" <GeneratedAngleTypeBounds>)?> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
