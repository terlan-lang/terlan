};

GeneratedAnnotationSchemaDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "annotation"
        <path_start:@L> AnnotationPath <path_end:@R>
        "{" <entries:Semicolon<GeneratedAnnotationSchemaEntry>> "}" "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Annotation,
            start,
            end,
            Some(format!(
                "{}schema {}",
                if public.is_some() { "pub " } else { "" },
                source_index.text(source, path_start, path_end),
            )),
            entries,
        ),
};

GeneratedAnnotationSchemaEntry: LalrpopSyntaxNode = {
    <start:@L> <key_start:@L> AnnotationPath <key_end:@R> ":"
        <value:GeneratedAnnotationValue>
        <options:GeneratedAnnotationSchemaOptions?> <end:@R>
        => {
            let mut children = vec![value];
            children.extend(options.unwrap_or_default());
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::AnnotationValue,
                start,
                end,
                Some(source_index.text(source, key_start, key_end).to_string()),
                children,
            )
        },
};

GeneratedAnnotationSchemaOptions: Vec<LalrpopSyntaxNode> = {
    "{" <entries:Semicolon<GeneratedAnnotationItem>> "}" => entries,
    "nominal-keyed-{" <entries:Semicolon<GeneratedAnnotationItem>> "}" => entries,
};

GeneratedAnnotation: LalrpopSyntaxNode = {
    <start:@L> "@" <path_start:@L> AnnotationPath <path_end:@R>
        <values:GeneratedAnnotationBlock?> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Annotation,
            start,
            end,
            Some(source_index.text(source, path_start, path_end).to_string()),
            values.unwrap_or_default(),
        ),
};

AnnotationPath: () = {
    AnnotationName ("tight-dot" AnnotationName)*,
};

AnnotationName: () = {
    NameToken,
    "module",
    "import",
    "type",
    "struct",
    "constructor",
    "trait",
    "impl",
    "template",
};

GeneratedAnnotationBlock: Vec<LalrpopSyntaxNode> = {
    "{" <items:Semicolon<GeneratedAnnotationItem>> "}" => items,
};

GeneratedAnnotationItem: LalrpopSyntaxNode = {
    <start:@L> <left:GeneratedAnnotationValue>
        <right:(":" <GeneratedAnnotationValue>)?> <end:@R>
        => {
            let mut children = vec![left];
            children.extend(right);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::AnnotationValue,
                start,
                end,
                Some(if children.len() == 2 { "entry" } else { "value" }.to_string()),
                children,
            )
        },
};

GeneratedAnnotationValue: LalrpopSyntaxNode = {
    <start:@L> AnnotationPath <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::AnnotationValue,
            source,
            source_index,
            start,
            end,
        ),
    <start:@L> "int" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::AnnotationValue,
            source,
            source_index,
            start,
            end,
        ),
    <start:@L> "float" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::AnnotationValue,
            source,
            source_index,
            start,
            end,
        ),
    <start:@L> "string" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::AnnotationValue,
            source,
            source_index,
            start,
            end,
        ),
    <start:@L> "[" <items:Comma<GeneratedAnnotationValue>> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::AnnotationValue,
            start,
            end,
            Some("list".to_string()),
            items,
        ),
    <start:@L> "{" <items:Semicolon<GeneratedAnnotationItem>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::AnnotationValue,
            start,
            end,
            Some("object".to_string()),
            items,
        ),
};

GeneratedImportDeclaration: LalrpopSyntaxNode = {
    <start:@L> "import" <body_start:@L> GeneratedImportBody <body_end:@R> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ImportDeclaration,
            start,
            end,
            Some(source_index.text(source, body_start, body_end).to_string()),
            Vec::new(),
        ),
};

GeneratedImportBody: () = {
    "type" GeneratedModuleSelector <("as" NameToken)?>,
    GeneratedModuleSelector <("as" NameToken)?>,
    <GeneratedAssetKind> "string" "as" NameToken,
};

GeneratedModuleSelector: () = {
    ModulePathRoot GeneratedModuleSelectorTail,
};

GeneratedModuleSelectorTail: () = {
    "tight-dot" ModulePathSegment GeneratedModuleSelectorTail,
    "selector-dot" "{" GeneratedImportSelections "}",
    => (),
};

GeneratedImportSelections: () = {
    "*",
    NonEmptyComma<GeneratedImportSelection>,
};

GeneratedImportSelection: () = {
    NameToken <("as" NameToken)?>,
};

GeneratedAssetKind: () = {
    "asset-file",
    "asset-css",
    "asset-markdown",
};

GeneratedConstantDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "const" <name_start:@L> "upper-ident" <name_end:@R>
        ":" <annotation:TypeExpression> "=" <value:AssignmentExpression> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ConstantDeclaration,
            start,
            end,
            Some(format!(
                "{}{}",
                if public.is_some() { "pub " } else { "" },
                source_index.text(source, name_start, name_end),
            )),
            vec![annotation, value],
        ),
};

GeneratedConstantFunctionDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "const" <name_start:@L> NameToken <name_end:@R>
        "(" <parameters:Comma<GeneratedParameter>> ")" ":"
        <return_type:TypeExpression> BodyArrow <body:AssignmentExpression> "." <end:@R>
        => {
            let mut children = parameters;
            children.push(return_type);
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::FunctionDeclaration,
                start,
                end,
                Some(format!(
                    "{}const {};params:{}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                    children.len().saturating_sub(2),
                )),
                children,
            )
        },
};

GeneratedTypeDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "type" <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?>
        <implements:("implements" <NonEmptyComma<TypeExpression>>)? >
        <representation:("=" <TypeExpression>)?> "." <end:@R>
        => {
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let implement_count = implements.as_ref().map_or(0, Vec::len);
            let has_representation = representation.is_some();
            LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeDeclaration,
            start,
            end,
            Some(format!(
                "{}{};params:{parameter_count};implements:{implement_count};representation:{has_representation}",
                if public.is_some() { "pub " } else { "" },
                source_index.text(source, name_start, name_end),
            )),
            {
                let mut children = parameters.unwrap_or_default();
                children.extend(implements.unwrap_or_default());
                children.extend(representation);
                children
            },
            )
        },
};

GeneratedValuedUnionDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "type"
        <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?> ":"
        <base:TypeExpression> "=" <first:GeneratedValuedUnionArm>
        <rest:("|" <GeneratedValuedUnionArm>)*> "." <end:@R>
        => {
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let mut children = parameters.unwrap_or_default();
            children.push(base);
            children.push(first);
            children.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::TypeDeclaration,
                start,
                end,
                Some(format!(
                    "{}valued {};params:{parameter_count};arms:{}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                    children.len().saturating_sub(parameter_count + 1),
                )),
                children,
            )
        },
};

GeneratedValuedUnionArm: LalrpopSyntaxNode = {
    <start:@L> <name_start:@L> "upper-ident" <name_end:@R>
        "=" <value:AssignmentExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ValuedUnionArm,
            start,
            end,
            Some(source_index.text(source, name_start, name_end).to_string()),
            vec![value],
        ),
};

GeneratedOpaqueTypeDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "opaque" "type"
        <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?>
        <representation:("=" <TypeExpression>)?> "." <end:@R>
        => {
            let has_representation = representation.is_some();
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let mut children = parameters.unwrap_or_default();
            children.extend(representation);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::TypeDeclaration,
                start,
                end,
                Some(format!(
                    "{}opaque {};params:{};representation:{}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                    parameter_count,
                    has_representation,
                )),
                children,
            )
        },
};

GeneratedTypeParameters: Vec<LalrpopSyntaxNode> = {
    "[" <parameters:NonEmptyComma<GeneratedTypeParameter>> "]" => parameters,
};

GeneratedTypeParameter: LalrpopSyntaxNode = {
    <start:@L> <variance:GeneratedVariance?> TypeName
        <higher_kind:("[" <NonEmptyComma<GeneratedHigherKindSlot>> "]")?>
        <implication:("=>" <GeneratedStructuralEvidenceShape>)?> <end:@R>
        => {
            let mut children = higher_kind.unwrap_or_default();
            children.extend(implication);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Type,
                start,
                end,
                variance,
                children,
            )
        },
    <start:@L> "const" "upper-ident" ":" TypeName <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Type,
            source,
            source_index,
            start,
            end,
        ),
};

GeneratedHigherKindSlot: LalrpopSyntaxNode = {
    <start:@L> <variance:GeneratedVariance?> "placeholder" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            variance,
            Vec::new(),
        ),
};

GeneratedVariance: String = {
    "+" => "+".to_string(),
    "-" => "-".to_string(),
};

GeneratedStructuralEvidenceShape: LalrpopSyntaxNode = {
    <start:@L> "{" <fields:NonEmptyComma<TypeField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeMap,
            start,
            end,
            Some("structural_evidence".to_string()),
            fields,
        ),
};

GeneratedStructDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "struct" <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?>
        <includes:("includes" <NonEmptyComma<TypeExpression>>)? >
        <implements:("implements" <NonEmptyComma<TypeExpression>>)? >
        "{" <fields:Comma<GeneratedStructField>> "}" "." <end:@R>
        => {
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let include_count = includes.as_ref().map_or(0, Vec::len);
            let implement_count = implements.as_ref().map_or(0, Vec::len);
            LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::StructDeclaration,
            start,
            end,
            Some(format!(
                "{}{};params:{parameter_count};includes:{include_count};implements:{implement_count};fields:{}",
                if public.is_some() { "pub " } else { "" },
                source_index.text(source, name_start, name_end),
                fields.len(),
            )),
            {
                let mut children = parameters.unwrap_or_default();
                children.extend(includes.unwrap_or_default());
                children.extend(implements.unwrap_or_default());
                children.extend(fields);
                children
            },
            )
        },
};

GeneratedConstructorDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "constructor"
        <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?>
        "{" <clauses:Semicolon<GeneratedConstructorClause>> "}" "." <end:@R>
        => {
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let clause_count = clauses.len();
            let mut children = parameters.unwrap_or_default();
            children.extend(clauses);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ConstructorDeclaration,
                start,
                end,
                Some(format!(
                    "{}{};params:{parameter_count};clauses:{clause_count}",
                    if public.is_some() { "pub " } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
};

GeneratedConstructorClause: LalrpopSyntaxNode = {
    <start:@L> "(" <parameters:Comma<GeneratedParameter>> ")" ":"
        <return_type:TypeExpression> BodyArrow <body:AssignmentExpression> <end:@R>
        => {
            let parameter_count = parameters.len();
            let mut children = parameters;
            children.push(return_type);
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ConstructorClause,
                start,
                end,
                Some(format!("params:{parameter_count}")),
                children,
            )
        },
};

GeneratedTraitDeclaration: LalrpopSyntaxNode = {
    <start:@L> <public:"pub"?> "trait"
        <name_start:@L> TypeName <name_end:@R>
        <parameters:GeneratedTypeParameters?>
        <super_traits:("extends" <NonEmptyComma<TypeExpression>>)? >
        "{" <members:GeneratedTraitMember*> "}" "." <end:@R>
        => {
            let parameter_count = parameters.as_ref().map_or(0, Vec::len);
            let super_count = super_traits.as_ref().map_or(0, Vec::len);
            let mut children = parameters.unwrap_or_default();
            children.extend(super_traits.unwrap_or_default());
            children.extend(members);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::TraitDeclaration,
                start,
                end,
