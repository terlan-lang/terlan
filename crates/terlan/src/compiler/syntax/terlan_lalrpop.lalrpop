            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            Vec::new(),
        ),
    <start:@L> "target" <target_start:@L> NameToken <target_end:@R>
        "with" <adapter_start:@L> AnnotationPath <adapter_end:@R> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ConfigDeclaration,
            start,
            end,
            Some(format!(
                "{} with {}",
                source_index.text(source, target_start, target_end),
                source_index.text(source, adapter_start, adapter_end),
            )),
            Vec::new(),
        ),
    <start:@L> <kind_start:@L> "target" <kind_end:@R> NameToken "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ConfigDeclaration,
            start,
            end,
            Some(source_index.text(source, kind_start, kind_end).to_string()),
