    LambdaConstructorBody,
};

LambdaConstructorBody: LalrpopSyntaxNode = {
    <first:ConstructorChainExpression>
        <rest:("lambda-sequence-semicolon" <LambdaSequenceElement>)*>
        => {
            if rest.is_empty() {
                first
            } else {
                let start = first.span.start;
                let end = rest.last().map_or(first.span.end, |node| node.span.end);
                let mut children = Vec::with_capacity(rest.len() + 1);
                children.push(first);
                children.extend(rest);
