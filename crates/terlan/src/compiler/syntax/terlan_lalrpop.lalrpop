        ),
};

GeneratedAngleTypeBounds: Vec<LalrpopSyntaxNode> = {
    <first:TypeExpression> <rest:("+" <TypeExpression>)*> => {
        let mut bounds = Vec::with_capacity(rest.len() + 1);
        bounds.push(first);
        bounds.extend(rest);
