GeneratedParameter: LalrpopSyntaxNode = {
    <start:@L> <varargs:"..."?> <mutable:"mut"?> <name_start:@L> NameToken <name_end:@R> ":"
        <annotation:TypeExpression> <default:("=" <AssignmentExpression>)?> <end:@R>
        => {
            let mut children = vec![annotation];
            children.extend(default);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Parameter,
                start,
                end,
                Some(format!(
                    "{}{}{}",
                    if varargs.is_some() { "..." } else { "" },
                    if mutable.is_some() { "mut " } else { "" },
                    source_index.text(source, name_start, name_end),
                )),
                children,
            )
        },
    <start:@L> <pattern:StructuralParameterPattern> "="
        <name_start:@L> NameToken <name_end:@R> ":"
        <annotation:TypeExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Parameter,
            start,
            end,
            Some(source_index.text(source, name_start, name_end).to_string()),
            vec![pattern, annotation],
        ),
    <start:@L> <pattern:StructuralParameterPattern>
        <annotation:(":" <TypeExpression>)?>
        <default:("=" <AssignmentExpression>)?> <end:@R>
        => {
            let pattern_text = source_index
                .text(source, pattern.span.start, pattern.span.end)
                .to_string();
            let mut children = vec![pattern];
            children.extend(annotation);
            children.extend(default);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Parameter,
                start,
                end,
                Some(pattern_text),
                children,
            )
        },
};

StructuralParameterPattern: LalrpopSyntaxNode = {
    <start:@L> "placeholder" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Pattern,
            source,
            source_index,
            start,
            end,
        ),
    ParameterTuplePattern,
    BinaryLayoutSyntax,
    NominalKeyedSyntax,
    <start:@L> "{" <fields:Comma<PatternField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternMap,
            start,
            end,
            None,
            fields,
        ),
    <start:@L> <name_start:@L> NameToken <name_end:@R>
        "(" <arguments:Comma<Pattern>> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternConstructor,
            start,
            end,
            Some(source_index.text(source, name_start, name_end).to_string()),
            arguments,
        ),
    <start:@L> "[" <items:PatternListBody> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            items.0,
            start,
            end,
            None,
            items.1,
        ),
    <start:@L> "string" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::String,
            source,
            source_index,
            start,
            end,
        ),
};

ParameterTuplePattern: LalrpopSyntaxNode = {
    <start:@L> "{" <first:Pattern> "," <second:Pattern>
        <rest:("," <Pattern>)*> "}" <end:@R> => {
            let mut children = Vec::with_capacity(rest.len() + 2);
            children.push(first);
            children.push(second);
            children.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::PatternTuple,
                start,
                end,
                None,
                children,
            )
        },
};

Expression: LalrpopSyntaxNode = {
    <first:AssignmentExpression>
    <rest:(";" <AssignmentExpression>)*>
    => {
        if rest.is_empty() {
            first
        } else {
            let start = first.span.start;
            let end = rest.last().map_or(first.span.end, |node| node.span.end);
            let mut children = Vec::with_capacity(rest.len() + 1);
            children.push(first);
            children.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Sequence,
                start,
                end,
                None,
                children,
            )
        }
    },
};

AssignmentExpression: LalrpopSyntaxNode = {
    LambdaExpression,
    LetExpression,
    NonLetAssignmentExpression,
};

LambdaExpression: LalrpopSyntaxNode = {
    <start:@L> "lambda-(" <patterns:Comma<LambdaPattern>> ")" "->"
        <body:LambdaBody> <end:@R>
        => {
            let mut children = patterns;
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Lambda,
                start,
                end,
                None,
                children,
            )
        },
};

LambdaPattern: LalrpopSyntaxNode = {
    <start:@L> "typed-lambda-pattern" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Pattern,
            start,
            end,
            Some(
                source_index
                    .text(source, start, end)
                    .split(':')
                    .next()
                    .unwrap_or_default()
                    .trim()
                    .to_string(),
            ),
            Vec::new(),
        ),
    Pattern,
};

LetExpression: LalrpopSyntaxNode = {
    <start:@L> "let" <binding:RefutableLetBinding>
        "else" "{" <first_fallback:CaseClause>
        <fallbacks:(";" <CaseClause>)*> "closing-semicolon"? "}" ";"
        <body:AssignmentExpression> <end:@R>
        => {
            let mut children = Vec::with_capacity(3 + fallbacks.len());
            children.push(binding);
            children.push(first_fallback);
            children.extend(fallbacks);
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Let,
                start,
                end,
                Some("refutable_group".to_string()),
                children,
            )
        },
    <start:@L> "let" "{"
        <first:RefutableLetBinding>
        <rest:(";" <RefutableLetBinding>)*> "closing-semicolon"?
        "}" "else" "{" <first_fallback:CaseClause>
        <fallbacks:(";" <CaseClause>)*> "closing-semicolon"? "}" ";"
        <body:AssignmentExpression> <end:@R>
        => {
            let mut children =
                Vec::with_capacity(3 + rest.len() + fallbacks.len());
            children.push(first);
            children.extend(rest);
            children.push(first_fallback);
            children.extend(fallbacks);
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Let,
                start,
                end,
                Some("refutable_group".to_string()),
                children,
            )
        },
    <start:@L> "let" <pattern:Pattern> "=" <value:AssignmentExpression>
        ";" <body:AssignmentExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Let,
            start,
            end,
            None,
            vec![pattern, value, body],
        ),
};

NonLetAssignmentExpression: LalrpopSyntaxNode = {
    QuoteExpression,
    <left:ConstructorChainExpression> "=" <right:AssignmentExpression>
        => {
            let start = left.span.start;
            let end = right.span.end;
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::IndexAssign,
                start,
                end,
                Some("=".to_string()),
                vec![left, right],
            )
        },
    ConstructorChainExpression,
};

QuoteExpression: LalrpopSyntaxNode = {
    <start:@L> "quote" <value:AssignmentExpression>
        => {
            let end = value.span.end;
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Quote,
                start,
                end,
                None,
                vec![value],
            )
        },
};

LambdaBody: LalrpopSyntaxNode = {
    LambdaRefutableLetExpression,
    LambdaLeadingLetExpression,
    LambdaExpression,
    QuoteExpression,
    LambdaIndexAssignment,
    LambdaConstructorBody,
};

