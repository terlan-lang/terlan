        "}" "else" "{" <first_fallback:CaseClause>
        <fallbacks:(";" <CaseClause>)*> "closing-semicolon"? "}" ";"
        <body:LambdaLeadingLetBody> <end:@R>
        => {
            let mut children =
                Vec::with_capacity(3 + rest.len() + fallbacks.len());
            children.push(first);
            children.extend(rest);
            children.push(first_fallback);
            children.extend(fallbacks);
            children.push(body);
            LalrpopSyntaxNode::branch(
