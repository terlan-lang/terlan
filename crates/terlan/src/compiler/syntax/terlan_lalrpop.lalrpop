LambdaSequenceElement: LalrpopSyntaxNode = {
    ConstructorChainExpression,
};

RefutableLetBinding: LalrpopSyntaxNode = {
    <start:@L> <pattern:Pattern> "<-" <value:AssignmentExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Let,
            start,
            end,
            Some("refutable_binding".to_string()),
            vec![pattern, value],
        ),
};

ConstructorChainExpression: LalrpopSyntaxNode = {
    <base:PipeExpression> <extensions:("with" <PipeExpression>)*> => {
        if extensions.is_empty() {
            base
        } else {
            let start = base.span.start;
            let end = extensions.last().map_or(base.span.end, |node| node.span.end);
            let mut children = Vec::with_capacity(extensions.len() + 1);
            children.push(base);
            children.extend(extensions);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ConstructorChain,
                start,
                end,
                Some("with".to_string()),
                children,
            )
        }
    },
};

PipeExpression: LalrpopSyntaxNode = {
    <left:OrExpression> <tail:("|>" <OrExpression>)*>
        => LalrpopSyntaxNode::fold_binary(
            left,
            tail.into_iter().map(|right| ("|>".to_string(), right)).collect(),
        ),
};

OrExpression: LalrpopSyntaxNode = {
    <left:AndExpression> <tail:("or" <AndExpression>)*>
        => LalrpopSyntaxNode::fold_binary(
            left,
            tail.into_iter().map(|right| ("or".to_string(), right)).collect(),
        ),
};

AndExpression: LalrpopSyntaxNode = {
    <left:CompareExpression> <tail:("and" <CompareExpression>)*>
        => LalrpopSyntaxNode::fold_binary(
            left,
            tail.into_iter().map(|right| ("and".to_string(), right)).collect(),
        ),
};

CompareExpression: LalrpopSyntaxNode = {
    <left:AddExpression> <tail:(<CompareOperator> <AddExpression>)*>
        => LalrpopSyntaxNode::fold_binary(left, tail),
};

CompareOperator: String = {
    "==" => "==".to_string(),
    "!=" => "!=".to_string(),
    ">=" => ">=".to_string(),
    ">" => ">".to_string(),
    "<=" => "<=".to_string(),
    "<" => "<".to_string(),
    "in" => "in".to_string(),
};

AddExpression: LalrpopSyntaxNode = {
    <left:MultiplyExpression> <tail:(<AddOperator> <MultiplyExpression>)*>
        => LalrpopSyntaxNode::fold_binary(left, tail),
};

AddOperator: String = {
    "+" => "+".to_string(),
    "-" => "-".to_string(),
    ".." => "..".to_string(),
};

MultiplyExpression: LalrpopSyntaxNode = {
    <left:CastExpression> <tail:(<MultiplyOperator> <CastExpression>)*>
        => LalrpopSyntaxNode::fold_binary(left, tail),
};

MultiplyOperator: String = {
    "*" => "*".to_string(),
    "/" => "/".to_string(),
    "div" => "div".to_string(),
    "rem" => "rem".to_string(),
};

CastExpression: LalrpopSyntaxNode = {
    <value:UnaryExpression> <casts:("as" <CastTypePrimary>)*> => {
        let mut value = value;
        for target in casts {
            let start = value.span.start;
            let end = target.span.end;
            value = LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Cast,
                start,
                end,
                Some("as".to_string()),
                vec![value, target],
            );
        }
        value
    },
};

CastTypePrimary: LalrpopSyntaxNode = {
    <start:@L> TypeReferencePath "cast-type-["
        <arguments:NonEmptyComma<TypeExpression>> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            arguments,
        ),
    <start:@L> TypeReferencePath <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            Vec::new(),
        ),
    <start:@L> "[" <item:CastTypePrimary> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeList,
            start,
            end,
            Some("list".to_string()),
            vec![item],
        ),
};

TypeExpression: LalrpopSyntaxNode = {
    <start:@L> "exists" <variables:NonEmptyComma<TypeNameNode>>
        "." <body:TypeExpression> <end:@R> => {
        let mut children = variables;
        children.push(body);
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeExistential,
            start,
            end,
            Some("exists".to_string()),
            children,
        )
    },
    TypeArrow,
};

TypeArrow: LalrpopSyntaxNode = {
    <start:@L> "lambda-(" <arguments:Comma<TypeExpression>> ")" "->"
        <return_type:TypeArrow> <end:@R> => {
        let mut children = arguments;
        children.push(return_type);
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeArrow,
            start,
            end,
            Some("->".to_string()),
            children,
        )
    },
    TypeImplication,
};

TypeImplication: LalrpopSyntaxNode = {
    <left:TypeUnion> <evidence:("=>" <GeneratedStructuralEvidenceShape>)?> => {
        if let Some(evidence) = evidence {
            let start = left.span.start;
            let end = evidence.span.end;
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Type,
                start,
                end,
                Some("=>".to_string()),
                vec![left, evidence],
            )
        } else {
            left
        }
    },
};

TypeUnion: LalrpopSyntaxNode = {
    <left:TypePrimary> <rest:("|" <TypePrimary>)*> => {
        if rest.is_empty() {
            left
        } else {
            let start = left.span.start;
            let end = rest.last().map_or(left.span.end, |node| node.span.end);
            let mut children = Vec::with_capacity(rest.len() + 1);
            children.push(left);
            children.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::TypeUnion,
                start,
                end,
                Some("|".to_string()),
                children,
            )
        }
    },
};

TypePrimary: LalrpopSyntaxNode = {
    <start:@L> "atom" "(" <fields:NonEmptyComma<TypeField>> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeTuple,
            start,
            end,
            Some("named".to_string()),
            fields,
        ),
    <start:@L> "atom" "(" <arguments:NonEmptyComma<TypeExpression>> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            arguments,
        ),
    <start:@L> TypeName "(" <fields:Comma<TypeField>> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeTuple,
            start,
            end,
            Some("named".to_string()),
            fields,
        ),
    <start:@L> TypeReferencePath <args:TypeArguments?> <end:@R> => {
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            args.unwrap_or_default(),
        )
    },
    <start:@L> "[" <item:TypeExpression> "]" <end:@R> => {
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeList,
            start,
            end,
            Some("list".to_string()),
            vec![item],
        )
    },
    <start:@L> "{" <first:TypeExpression> <rest:TypeTupleTail> "}" <end:@R> => {
        let mut children = Vec::with_capacity(rest.len() + 1);
        children.push(first);
        children.extend(rest);
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeTuple,
            start,
            end,
            None,
            children,
        )
    },
    <start:@L> "{" <fields:Comma<TypeField>> "}" <end:@R> => {
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeMap,
            start,
            end,
            None,
            fields,
        )
    },
    <start:@L> "(" <value:TypeExpression> ")" <end:@R> => {
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some("group".to_string()),
            vec![value],
        )
    },
    <start:@L> "int" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
    <start:@L> "float" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
    <start:@L> "string" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
    <start:@L> "legacy-atom" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
    <start:@L> "placeholder" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
};

TypeTupleTail: Vec<LalrpopSyntaxNode> = {
    => Vec::new(),
    "," <first:TypeField> <rest:("," <TypeField>)*> => {
        let mut fields = Vec::with_capacity(rest.len() + 1);
        fields.push(first);
        fields.extend(rest);
        fields
    },
    "," <second:TypeExpression> <rest:("," <TypeExpression>)*> => {
        let mut items = Vec::with_capacity(rest.len() + 1);
        items.push(second);
        items.extend(rest);
        items
    },
};

TypeArguments: Vec<LalrpopSyntaxNode> = {
    "[" <items:NonEmptyComma<TypeArgument>> "]" => items,
    "<" <items:NonEmptyComma<TypeArgument>> ">" => items,
};

TypeArgument: LalrpopSyntaxNode = {
    <start:@L> <left:TypeExpression> "+" <right:TypeExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Type,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            vec![left, right],
        ),
    TypeExpression,
};

TypeReferencePath: () = {
    TypeReferenceRoot ("tight-dot" TypeReferenceSegment)*,
};

TypeReferenceRoot: () = {
    ModulePathRoot,
    TypeName,
};

TypeReferenceSegment: () = {
    ModulePathSegment,
};

TypeNameNode: LalrpopSyntaxNode = {
    <start:@L> TypeName <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Type, source, source_index, start, end),
};

TypeField: LalrpopSyntaxNode = {
    <start:@L> <key:MapKey> ":" <value:TypeExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::TypeField,
            start,
            end,
            Some(key),
            vec![value],
        ),
};

TypeName: () = {
    "upper-ident",
    "Bool",
    "Float",
    "Int",
    "Name",
    "String",
    "Type",
};

BodyArrow: () = {
    "->",
    "function-body-arrow",
};

UnaryExpression: LalrpopSyntaxNode = {
    <start:@L> <operator:UnaryOperator> <operator_end:@R> <operand:UnaryExpression>
        => LalrpopSyntaxNode::unary(source, source_index, start, operator_end, operand),
    PostfixExpression,
};

UnaryOperator: () = {
    "-",
    "!",
    "not",
};

PostfixExpression: LalrpopSyntaxNode = {
    <primary:PrimaryExpression> <suffixes:PostfixSuffix*>
        => LalrpopSyntaxNode::apply_postfix(primary, suffixes),
};

PostfixSuffix: LalrpopPostfixSyntax = {
    "(" <args:Comma<AssignmentExpression>> ")" <end:@R>
        => LalrpopPostfixSyntax::Call { args, end },
    "generic-call-[" <type_args:NonEmptyComma<TypeExpression>> "]"
        "(" <args:Comma<AssignmentExpression>> ")" <end:@R>
        => LalrpopPostfixSyntax::GenericCall { type_args, args, end },
    "[" <index:Expression> "]" <end:@R>
        => LalrpopPostfixSyntax::Index { index, end },
    "tight-dot" <start:@L> NameToken <end:@R>
        => LalrpopPostfixSyntax::Field {
            field: source_index.text(source, start, end).to_string(),
            end,
        },
    "tight-dot" "#" <start:@L> NameToken <end:@R>
        => LalrpopPostfixSyntax::Field {
            field: format!("#{}", source_index.text(source, start, end)),
            end,
        },
    "#" <record_start:@L> NameToken <record_end:@R> RecordAccessDot
        <field_start:@L> NameToken <field_end:@R>
        => LalrpopPostfixSyntax::RecordAccess {
            record: source_index.text(source, record_start, record_end).to_string(),
            field: source_index.text(source, field_start, field_end).to_string(),
            end: field_end,
        },
    "#" <record_start:@L> NameToken <record_end:@R>
        RecordUpdateOpen <fields:Comma<RecordUpdateField>> "}" <end:@R>
        => LalrpopPostfixSyntax::RecordUpdate {
            record: source_index.text(source, record_start, record_end).to_string(),
            fields,
            end,
        },
};

RecordAccessDot: () = {
    ".",
    "tight-dot",
};

RecordUpdateOpen: () = {
    "{",
    "nominal-keyed-{",
};

RecordUpdateField: LalrpopSyntaxNode = {
    <start:@L> <private:"#"? > <key:MapKey> RecordUpdateSeparator
        <value:AssignmentExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::MapField,
            start,
            end,
            Some(format!("{}{}", if private.is_some() { "#" } else { "" }, key)),
            vec![value],
        ),
};

RecordUpdateSeparator: () = {
    ":",
    "=",
};

PrimaryExpression: LalrpopSyntaxNode = {
    <start:@L> <remote_start:@L> NameToken <remote_end:@R> "remote-call-colon"
        <function_start:@L> NameToken <function_end:@R>
        <type_args:CallTypeArguments?>
        "(" <args:Comma<AssignmentExpression>> ")" <end:@R> => {
            let type_args = type_args.unwrap_or_default();
            let type_arg_count = type_args.len();
            let callee = LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Binding,
                function_start,
                function_end,
                Some(source_index.text(source, function_start, function_end).to_string()),
                Vec::new(),
            );
            let mut children = Vec::with_capacity(1 + type_arg_count + args.len());
            children.push(callee);
            children.extend(type_args);
            children.extend(args);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Call,
                start,
                end,
                Some(format!(
                    "remote:{};generic:{}",
                    source_index.text(source, remote_start, remote_end),
                    type_arg_count,
                )),
                children,
            )
        },
    <start:@L> "case" <value:AssignmentExpression>
        "{" <clauses:Semicolon<CaseClause>> "}" <end:@R>
        => {
            let mut children = Vec::with_capacity(clauses.len() + 1);
            children.push(value);
            children.extend(clauses);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Case,
                start,
                end,
                None,
                children,
            )
        },
    <start:@L> "try" <body:AssignmentExpression>
        "{" <of_clauses:Semicolon<CaseClause>>
        <catch_clauses:("catch" <Semicolon<CaseClause>>)? >
        <after_clause:(
            "after" <AssignmentExpression> "->" <AssignmentExpression>
        )? >
        "}" <end:@R>
        => {
            let of_count = of_clauses.len();
            let catch_count = catch_clauses.as_ref().map_or(0, Vec::len);
            let has_after = after_clause.is_some();
            let after_count = usize::from(has_after) * 2;
            let mut children =
                Vec::with_capacity(1 + of_clauses.len() + catch_count + after_count);
            children.push(body);
            children.extend(of_clauses);
            if let Some(catch_clauses) = catch_clauses {
                children.extend(catch_clauses);
            }
            if let Some((trigger, after_body)) = after_clause {
                children.push(trigger);
                children.push(after_body);
            }
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Try,
                start,
                end,
                Some(format!(
                    "of:{};catch:{};after:{}",
                    of_count,
                    catch_count,
                    has_after,
                )),
                children,
            )
        },
    <start:@L> "if" "{" <clauses:IfClauses> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::If,
            start,
            end,
            None,
            clauses,
        ),
    <start:@L> "?" <name_start:@L> NameToken <name_end:@R>
        <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::MacroCall,
            start,
            end,
            Some(source_index.text(source, name_start, name_end).to_string()),
            Vec::new(),
        ),
    <start:@L> "unquote" "(" <value:Expression> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Unquote,
            start,
            end,
            None,
            vec![value],
        ),
    <start:@L> "expression-raw-macro" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::RawMacro,
            start,
            end,
            Some(source_index.text(source, start, end).to_string()),
            Vec::new(),
        ),
    <start:@L> "legacy-atom" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::AtomLiteral,
            start,
            end,
            Some(source_index.text(source, start + 1, end).to_string()),
            Vec::new(),
        ),
    <start:@L> "int" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Int, source, source_index, start, end),
    <start:@L> "float" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Float, source, source_index, start, end),
    <start:@L> "string" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::String, source, source_index, start, end),
    <start:@L> "binary" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::BinaryLiteral, source, source_index, start, end),
    <start:@L> "html" "html-raw-block" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::RawMacro,
            start,
            end,
            Some("html".to_string()),
            Vec::new(),
        ),
    BinaryLayoutSyntax,
    NominalKeyedSyntax,
    <start:@L> NameToken <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Binding, source, source_index, start, end),
    <start:@L> "(" <value:Expression> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Group,
            start,
            end,
            None,
            vec![value],
        ),
    <start:@L> "{" <first:AssignmentExpression> ","
        <second:AssignmentExpression> <rest:("," <AssignmentExpression>)*> ","? "}" <end:@R>
        => {
            let mut children = Vec::with_capacity(rest.len() + 2);
            children.push(first);
            children.push(second);
            children.extend(rest);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Tuple,
                start,
                end,
                None,
                children,
            )
        },
    <start:@L> "{" <fields:Comma<MapField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Map,
            start,
            end,
            None,
            fields,
        ),
    <start:@L> "[" <items:ExpressionListBody> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            items.0,
            start,
            end,
            None,
            items.1,
        ),
    <start:@L> "#" "[" <items:Comma<AssignmentExpression>> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::FixedArray,
            start,
            end,
            None,
            items,
        ),
};

LegacyAtomValue: () = {
    NameToken,
    "string",
};

CallTypeArguments: Vec<LalrpopSyntaxNode> = {
    "generic-call-[" <items:NonEmptyComma<TypeExpression>> "]" => items,
};

ExpressionListBody: (LalrpopSyntaxNodeKind, Vec<LalrpopSyntaxNode>) = {
    => (LalrpopSyntaxNodeKind::List, Vec::new()),
    <first:AssignmentExpression> <tail:ExpressionListTail> => {
        let mut children = Vec::with_capacity(tail.1.len() + 1);
        children.push(first);
        children.extend(tail.1);
        (tail.0, children)
    },
};

ExpressionListTail: (LalrpopSyntaxNodeKind, Vec<LalrpopSyntaxNode>) = {
    => (LalrpopSyntaxNodeKind::List, Vec::new()),
    "," <rest:Comma<AssignmentExpression>>
        => (LalrpopSyntaxNodeKind::List, rest),
    "|" <first:ComprehensionGenerator>
        <rest:("," <ComprehensionQualifier>)*>
        => {
            let mut qualifiers = Vec::with_capacity(rest.len() + 1);
            qualifiers.push(first);
            qualifiers.extend(rest);
            (LalrpopSyntaxNodeKind::ListComprehension, qualifiers)
        },
    "|" <tail:AssignmentExpression>
        => (LalrpopSyntaxNodeKind::ListCons, vec![tail]),
};

ComprehensionQualifier: LalrpopSyntaxNode = {
    ComprehensionGenerator,
    AssignmentExpression,
};

ComprehensionGenerator: LalrpopSyntaxNode = {
    <start:@L> <pattern:AssignmentExpression> "<-"
        <source_expression:AssignmentExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Generator,
            start,
            end,
            None,
            vec![pattern, source_expression],
        ),
};

CaseClause: LalrpopSyntaxNode = {
    <start:@L> <patterns:NonEmptyComma<Pattern>>
        <guard:(GuardKeyword <AssignmentExpression>)?>
        "->" <body:AssignmentExpression> <end:@R> => {
            let pattern_count = patterns.len();
            let has_guard = guard.is_some();
            let mut children = patterns;
            if let Some(guard) = guard {
                children.push(guard);
            }
            children.push(body);
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Clause,
                start,
                end,
                Some(format!("patterns:{pattern_count};guard:{has_guard}")),
                children,
            )
        },
};

GuardKeyword: () = {
    "where",
    "when",
};

IfClause: LalrpopSyntaxNode = {
    <start:@L> <guard:IfGuard> "->" <body:Expression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Clause,
            start,
            end,
            Some("if".to_string()),
            vec![guard, body],
        ),
};

IfGuard: LalrpopSyntaxNode = {
    AssignmentExpression,
    <start:@L> "placeholder" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Binding,
            start,
            end,
            Some("_".to_string()),
            Vec::new(),
        ),
};

IfClauses: Vec<LalrpopSyntaxNode> = {
    <first:IfClause> <rest:("if-clause-semicolon" <IfClause>)*>
        "closing-semicolon"? => {
            let mut clauses = Vec::with_capacity(rest.len() + 1);
            clauses.push(first);
            clauses.extend(rest);
            clauses
        },
};

MapField: LalrpopSyntaxNode = {
    <start:@L> <private:"#"? > <key:MapKey> ":"
        <value:MapFieldValue> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::MapField,
            start,
            end,
            Some(format!("{}{}", if private.is_some() { "#" } else { "" }, key)),
            vec![value],
        ),
};

MapFieldValue: LalrpopSyntaxNode = {
    AssignmentExpression,
    <start:@L> "placeholder" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Pattern,
            source,
            source_index,
            start,
            end,
        ),
};

BinaryLayoutSyntax: LalrpopSyntaxNode = {
    <start:@L> <name_start:@L> NameToken <name_end:@R>
        "binary-layout-[" <endian_start:@L> NameToken <endian_end:@R> "]"
        "{" <fields:Comma<BinaryLayoutField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::BinaryLayout,
            start,
            end,
            Some(format!(
                "{}[{}]",
                source_index.text(source, name_start, name_end),
                source_index.text(source, endian_start, endian_end),
            )),
            fields,
        ),
};

BinaryLayoutField: LalrpopSyntaxNode = {
    <start:@L> <key:MapKey> ":" <descriptor:TypeExpression> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::BinaryLayoutField,
            start,
            end,
            Some(key),
            vec![descriptor],
        ),
};

NominalKeyedSyntax: LalrpopSyntaxNode = {
    <start:@L> <name_start:@L> NameToken <name_end:@R>
        "nominal-keyed-{" <fields:Comma<MapField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternConstructor,
            start,
            end,
            Some(source_index.text(source, name_start, name_end).to_string()),
            fields,
        ),
};

MapKey: String = {
    <start:@L> NameToken <end:@R> => source_index.text(source, start, end).to_string(),
    <start:@L> "template" <end:@R> => source_index.text(source, start, end).to_string(),
    <start:@L> "string" <end:@R> => source_index.text(source, start, end).to_string(),
    <start:@L> "placeholder" <end:@R> => source_index.text(source, start, end).to_string(),
};

Pattern: LalrpopSyntaxNode = {
    <start:@L> "placeholder" <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Pattern,
            source,
            source_index,
            start,
            end,
        ),
    BinaryLayoutSyntax,
    NominalKeyedSyntax,
    <start:@L> NameToken ("tight-dot" NameToken)+ <end:@R>
        => LalrpopSyntaxNode::leaf(
            LalrpopSyntaxNodeKind::Pattern,
            source,
            source_index,
            start,
            end,
        ),
    <start:@L> TypeName "[" <value_start:@L> "string" <value_end:@R> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Pattern,
            start,
            end,
            Some(source_index.text(source, value_start, value_end).to_string()),
            Vec::new(),
        ),
    <start:@L> <name:PatternName> <args:PatternArguments?> <end:@R> => {
        if let Some(args) = args {
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::PatternConstructor,
                start,
                end,
                Some(name),
                args,
            )
        } else {
            LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::Pattern,
                start,
                end,
                Some(name),
                Vec::new(),
            )
        }
    },
    <start:@L> "int" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Pattern, source, source_index, start, end),
    <start:@L> "float" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Pattern, source, source_index, start, end),
    <start:@L> "string" <end:@R>
        => LalrpopSyntaxNode::leaf(LalrpopSyntaxNodeKind::Pattern, source, source_index, start, end),
    <start:@L> "{" <first:Pattern> "," <second:Pattern>
        <rest:("," <Pattern>)*> ","? "}" <end:@R> => {
        let mut children = Vec::with_capacity(rest.len() + 2);
        children.push(first);
        children.push(second);
        children.extend(rest);
        LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternTuple,
            start,
            end,
            None,
            children,
        )
    },
    <start:@L> "{" <fields:Comma<MapField>> "}" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternMap,
            start,
            end,
            None,
            fields,
        ),
    <start:@L> "[" <items:PatternListBody> "]" <end:@R>
        => LalrpopSyntaxNode::branch(
            items.0,
            start,
            end,
            None,
            items.1,
        ),
    <start:@L> "(" <value:Pattern> ")" <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::Pattern,
            start,
            end,
            Some("group".to_string()),
            vec![value],
        ),
};

PatternListBody: (LalrpopSyntaxNodeKind, Vec<LalrpopSyntaxNode>) = {
    => (LalrpopSyntaxNodeKind::PatternList, Vec::new()),
    <first:Pattern> <tail:PatternListTail> => {
        let mut children = Vec::with_capacity(tail.1.len() + 1);
        children.push(first);
        children.extend(tail.1);
        (tail.0, children)
    },
};

PatternListTail: (LalrpopSyntaxNodeKind, Vec<LalrpopSyntaxNode>) = {
    => (LalrpopSyntaxNodeKind::PatternList, Vec::new()),
    "," <rest:NonEmptyComma<Pattern>>
        => (LalrpopSyntaxNodeKind::PatternList, rest),
    "|" <tail:Pattern>
        => (LalrpopSyntaxNodeKind::PatternListCons, vec![tail]),
};

PatternArguments: Vec<LalrpopSyntaxNode> = {
    "(" <args:Comma<Pattern>> ")" => args,
};

PatternField: LalrpopSyntaxNode = {
    <start:@L> <private:"#"? > <key:MapKey> ":" <value:Pattern> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::PatternField,
            start,
            end,
            Some(format!("{}{}", if private.is_some() { "#" } else { "" }, key)),
            vec![value],
        ),
};

PatternName: String = {
    <start:@L> NameToken <end:@R> => source_index.text(source, start, end).to_string(),
};

// Canonical comma lists accept the trailing separator emitted by `terlc fmt`.
Comma<T>: Vec<T> = {
    <mut items:(<T> ",")*> <last:T?> => {
        if let Some(last) = last {
            items.push(last);
        }
        items
    },
};

NonEmptyComma<T>: Vec<T> = {
    <first:T> <rest:("," <T>)*> => {
        let mut items = Vec::with_capacity(rest.len() + 1);
        items.push(first);
        items.extend(rest);
        items
    },
};

Semicolon<T>: Vec<T> = {
    => Vec::new(),
    <first:T> <rest:(";" <T>)*> "closing-semicolon"? => {
        let mut items = Vec::with_capacity(rest.len() + 1);
        items.push(first);
        items.extend(rest);
        items
    },
};

