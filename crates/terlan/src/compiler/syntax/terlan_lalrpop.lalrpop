        ),
    <start:@L> <kind_start:@L> "machine" <kind_end:@R> NameToken "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ConfigDeclaration,
            start,
            end,
            Some(source_index.text(source, kind_start, kind_end).to_string()),
            Vec::new(),
        ),
    <start:@L> <kind_start:@L> "static" <kind_end:@R> NameToken "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ConfigDeclaration,
            start,
            end,
            Some(source_index.text(source, kind_start, kind_end).to_string()),
            Vec::new(),
