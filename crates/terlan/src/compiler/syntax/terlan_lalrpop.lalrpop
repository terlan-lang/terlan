// canonical-ebnf-sha256: f15e5e3b8d546024312cb9e097495f268c179e272e341e26c04fe2811fd53405
//
// This fingerprint is checked by `make lalrpop-parser-parity-check`. Any
// canonical EBNF edit therefore requires an explicit generated-grammar audit.
use crate::compiler::syntax::lalrpop_boundary::{
    LalrpopLexicalError,
    LalrpopModuleHeaderOutput,
    LalrpopSyntaxOutput,
    LalrpopSyntaxTokenOutput,
    LalrpopToken,
};
use super::LalrpopContextualKeyword;
use crate::compiler::syntax::lalrpop_syntax::{
    LalrpopExpressionOutput,
    LalrpopFragmentOutput,
    LalrpopModuleSyntaxOutput,
    LalrpopPostfixSyntax,
    LalrpopSourceIndex,
    LalrpopSyntaxNode,
    LalrpopSyntaxNodeKind,
    LALRPOP_PATTERN_OUTPUT_SCHEMA,
    LALRPOP_TYPE_OUTPUT_SCHEMA,
};
use crate::compiler::syntax::span::Span;
use super::TokenKind;

grammar(source: &str, source_index: &LalrpopSourceIndex, grammar_identity: &str);

pub TokenSyntaxOutput: LalrpopSyntaxOutput = {
    <tokens:SpannedToken*> => LalrpopSyntaxOutput::new(grammar_identity, tokens),
};

pub ModuleHeaderOutput: LalrpopModuleHeaderOutput = {
    Trivia*
    <start:@L> "module"
    <path_start:@L> ModulePathRoot
    <(path_end, end):ModulePathTail>
    SpannedToken*
    => LalrpopModuleHeaderOutput {
        module_name: source_index.text(source, path_start, path_end).to_string(),
        span: Span::new(start, end),
    },
};

pub ExpressionOutput: LalrpopExpressionOutput = {
    <root:Expression> => LalrpopExpressionOutput::new(grammar_identity, root),
};

pub TypeOutput: LalrpopFragmentOutput = {
    <root:TypeExpression>
        => LalrpopFragmentOutput::new(LALRPOP_TYPE_OUTPUT_SCHEMA, grammar_identity, root),
};

pub PatternOutput: LalrpopFragmentOutput = {
    <root:Pattern>
        => LalrpopFragmentOutput::new(LALRPOP_PATTERN_OUTPUT_SCHEMA, grammar_identity, root),
};

pub ModuleSyntaxOutput: LalrpopModuleSyntaxOutput = {
    <header:GeneratedModuleDeclaration> <declarations:GeneratedDeclaration*>
        => LalrpopModuleSyntaxOutput::new(
            grammar_identity,
            header.0,
            header.1,
            declarations,
        ),
};

GeneratedModuleDeclaration: (String, LalrpopSyntaxNode) = {
    <start:@L> "module" <name_start:@L> ModulePathRoot
        ("tight-dot" ModulePathSegment)* <name_end:@R> "." <end:@R>
        => {
            let name = source_index.text(source, name_start, name_end).to_string();
            let node = LalrpopSyntaxNode::branch(
                LalrpopSyntaxNodeKind::ModuleDeclaration,
                start,
                end,
                Some(name.clone()),
                Vec::new(),
            );
            (name, node)
        },
};

GeneratedDeclaration: LalrpopSyntaxNode = {
    <annotations:GeneratedAnnotation*> <mut declaration:GeneratedDeclarationCore> => {
        if let Some(first) = annotations.first() {
            declaration.span.start = first.span.start;
            let mut children = Vec::with_capacity(annotations.len() + declaration.children.len());
            children.extend(annotations);
            children.append(&mut declaration.children);
            declaration.children = children;
        }
        declaration
    },
};

GeneratedDeclarationCore: LalrpopSyntaxNode = {
    GeneratedExportDeclaration,
    GeneratedNativeRawDeclaration,
    GeneratedImportDeclaration,
    GeneratedConfigDeclaration,
    GeneratedAnnotationSchemaDeclaration,
    GeneratedConstantFunctionDeclaration,
    GeneratedConstantDeclaration,
    GeneratedValuedUnionDeclaration,
    GeneratedTypeDeclaration,
    GeneratedOpaqueTypeDeclaration,
    GeneratedStructDeclaration,
    GeneratedConstructorDeclaration,
    GeneratedTraitDeclaration,
    GeneratedTraitImplementationDeclaration,
    GeneratedTemplateDeclaration,
    GeneratedStaticDeclaration,
    GeneratedShapeDeclaration,
    GeneratedMethodDeclaration,
    GeneratedClauseFunctionDeclaration,
    GeneratedFunctionDeclaration,
};

GeneratedExportDeclaration: LalrpopSyntaxNode = {
    <start:@L> "export" "type" "(" NonEmptyComma<TypeName> ")" "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ExportDeclaration,
            start,
            end,
            Some("type".to_string()),
            Vec::new(),
        ),
    <start:@L> "export" "type" NonEmptyComma<TypeName> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ExportDeclaration,
            start,
            end,
            Some("type".to_string()),
            Vec::new(),
        ),
    <start:@L> "export" <items:NonEmptyComma<GeneratedExportItem>> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ExportDeclaration,
            start,
            end,
            None,
            items,
        ),
};

GeneratedExportItem: LalrpopSyntaxNode = {
    <start:@L> <name_start:@L> NameToken <name_end:@R> "/"
        <arity_start:@L> "int" <arity_end:@R> <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::ExportItem,
            start,
            end,
            Some(format!(
                "{}/{}",
                source_index.text(source, name_start, name_end),
                source_index.text(source, arity_start, arity_end),
            )),
            Vec::new(),
        ),
};

GeneratedStaticDeclaration: LalrpopSyntaxNode = {
    <start:@L> "static" NameToken "string" "->" <body:AssignmentExpression> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::RawMacro,
            start,
            end,
            Some("static".to_string()),
            vec![body],
        ),
    <start:@L> "static" NameToken ":" <annotation:TypeExpression>
        "=" <body:AssignmentExpression> "." <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::RawMacro,
            start,
            end,
            Some("static".to_string()),
            vec![annotation, body],
        ),
};

GeneratedNativeRawDeclaration: LalrpopSyntaxNode = {
    <start:@L> "native-raw-declaration" "."? <end:@R>
        => LalrpopSyntaxNode::branch(
            LalrpopSyntaxNodeKind::RawMacro,
            start,
            end,
            Some("native".to_string()),
            Vec::new(),
        ),
};

