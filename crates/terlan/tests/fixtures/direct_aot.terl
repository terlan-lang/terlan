pub spawn_call_capture(entry: Entry[Int], value: Int): Int ->
    let child = spawn_only(entry);
    value + 1.

pub spawn_then_send(): Bool ->
    let child = Process.spawn[Int](Process.entry[Int](1));
    let received = Process.receive_int();
    received == 73.

pub spawn_invalid_entry(): Bool ->
    let child = Process.spawn[Int](Process.entry[Int](9999));
