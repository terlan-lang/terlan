module direct_aot.

import std.vm.Process.{ActorMessage}.
import std.vm.{Message, Process}.

import type std.vm.Message.
import type std.vm.Process.{Entry, ExitReason, Monitor, Process, Resource, ResourceKind, SchedulingClass, Timer}.

pub type Ready.

pub atom_identity(value: Ready): Ready ->
    value.

pub struct Pair {
    left: Int,
    right: Int,
}.

pub constructor Pair {
    (left: Int, right: Int): Pair ->
        Pair {left: left, right: right}
}.

pub pair_identity(pair: Pair): Pair ->
    pair.

pub map_identity(values: Map[String, Int]): Map[String, Int] ->
    values.

pub set_identity(values: Set[String]): Set[String] ->
    values.

pub managed_constructed(): Bool ->
    let pair = Pair(20, 22);
    let carried = pair_identity(pair);
    true.

pub managed_returned(): Pair ->
    Pair(20, 22).

pub managed_yielded(): Bool ->
    let pair = Pair(20, 22);
    Process.yield_now();
    let carried = pair_identity(pair);
    true.

pub managed_yield_value(value: Pair): Pair ->
    Process.yield_now();
    value.

pub managed_entry_resume(): Pair ->
    managed_yield_value(Pair(20, 22)).

pub managed_branch_resume(flag: Bool): Pair ->
    let pair = Pair(20, 22);
    if {
        flag -> (Process.yield_now(); pair);
        true -> (Process.yield_now(); pair)
    }.

pub managed_branch_left(): Pair ->
    managed_branch_resume(true).

pub managed_branch_right(): Pair ->
    managed_branch_resume(false).

pub managed_nested_resume(flag: Bool): Pair ->
    let pair = Pair(20, 22);
    if {
        flag -> if {
            flag -> (Process.yield_now(); Process.yield_now(); pair);
            true -> pair
        };
        true -> pair
    }.

pub managed_nested(): Pair ->
    managed_nested_resume(true).

pub managed_repeated(): Pair ->
    let pair = Pair(20, 22);
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    pair.

pub managed_tail_resume(value: Pair): Pair ->
    managed_yield_value(value).

pub managed_tail(): Pair ->
    managed_tail_resume(Pair(20, 22)).

pub managed_non_tail(): Pair ->
    let pair = Pair(20, 22);
    let resumed = managed_yield_value(pair);
    pair_identity(resumed).

pub managed_non_tail_repeated(): Pair ->
    let pair = Pair(20, 22);
    let first = managed_yield_value(pair);
    let second = managed_yield_value(first);
    pair_identity(second).

pub spawn_1(): Bool ->
    Process.send_int(1, 73);
    true.

pub spawn_2(): Bool ->
    1 div 0 == 0.

pub spawn_4(): Bool -> true.

pub spawn_5(): Bool -> true.

pub spawn_6(): Bool ->
    Process.fail(Process.exit_reason(7));
    true.

pub spawn_7(): Bool ->
    Process.fail(Process.exit_reason(9));
    true.

pub spawn_8(): Bool ->
    managed_constructed().

pub spawn_managed_child(): Bool ->
    let child = Process.spawn[Pair](Process.entry[Pair](8));
    true.

pub add(x: Int, y: Int): Int ->
    x + y.

pub subtract(x: Int, y: Int): Int ->
    x - y.

pub multiply(x: Int, y: Int): Int ->
    x * y.

pub divide(x: Int, y: Int): Int ->
    x div y.

pub remainder(x: Int, y: Int): Int ->
    x rem y.

pub negate(x: Int): Int ->
    -x.

pub add_twice(x: Int, y: Int): Int ->
    add(add(x, y), y).

pub float_add(x: Float, y: Float): Float ->
    x + y.

pub float_mixed(x: Int, y: Float): Float ->
    x + y.

pub float_compare(x: Float, y: Int): Bool ->
    x > y.

pub float_divide(x: Float, y: Float): Float ->
    x / y.

pub classify(x: Int): Int ->
    let doubled = x * 2;
    if {
        doubled > 10 -> doubled + 1;
        true -> 0
    }.

pub choose(flag: Bool): Int ->
    if {
        flag -> 1;
        true -> 0
    }.

pub only_true(flag: Bool): Int ->
    if {
        flag -> 1
    }.

pub bool_not(flag: Bool): Bool ->
    not flag.

pub bool_and(left: Bool, right: Bool): Bool ->
    left and right.

pub bool_or(left: Bool, right: Bool): Bool ->
    left or right.

pub short_and(): Bool ->
    false and 1 div 0 == 0.

pub short_or(): Bool ->
    true or 1 div 0 == 0.

pub yielded(): Bool ->
    Process.yield_now();
    true.

pub yield_only(): Unit ->
    Process.yield_now().

pub send_to_self(): Bool ->
    Process.send_int(1, 73);
    true.

pub send_capture_to_self(value: Int): Int ->
    Process.send_int(1, value);
    value + 1.

pub send_unit(recipient: Int, payload: Int): Unit ->
    Process.send_int(recipient, payload).

pub send_call_capture_to_self(value: Int): Int ->
    let delivered = send_unit(1, value);
    value + 1.

pub receive_capture(value: Int): Int ->
    let received = Process.receive_int();
    received + value.

pub receive_int_only(): Int ->
    Process.receive_int().

pub receive_call_capture(value: Int): Int ->
    let received = receive_int_only();
    received + value.

pub send_then_receive_call(): Bool ->
    Process.send_int(1, 41);
    let received = receive_int_only(); received == 41.

pub spawn_capture(entry: Entry[Int], value: Int): Int ->
