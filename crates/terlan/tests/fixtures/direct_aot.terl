pub branch_yield(flag: Bool): Int ->
    if {
        flag -> (Process.yield_now(); 41);
        true -> 7
    }.

pub branch_yield_local(flag: Bool, value: Int): Int ->
    if {
        flag -> let next = value + 1;
        Process.yield_now();
        next + 1;
        true -> value
    }.

pub branch_yield_both(flag: Bool): Int ->
    if {
        flag -> (Process.yield_now(); 1);
        true -> (Process.yield_now(); 2)
    }.

pub nested_branch_yield(outer: Bool, inner: Bool): Int ->
    if {
        outer -> if {
            inner -> (Process.yield_now(); 11);
            true -> 12
        };
        true -> 13
    }.

pub short_circuit_yield(left: Bool, right: Bool): Bool ->
    left and (Process.yield_now(); right).

pub yield_then_branch(flag: Bool): Int ->
    Process.yield_now();
    if {
    flag -> (Process.yield_now(); 21);
    true -> 22
}.

pub branch_capture_pair(flag: Bool, left: Int, right: Int): Int ->
    if {
        flag -> (Process.yield_now(); left + right);
        true -> 0
    }.

pub branch_yield_only(flag: Bool): Int ->
    if {
        flag -> (Process.yield_now(); 1)
    }.

pub yield_condition(flag: Bool): Int ->
    if {
        (Process.yield_now(); flag) -> 31;
        true -> 32
    }.

pub yield_later_condition(first: Bool, second: Bool): Int ->
    if {
        first -> 33;
        (Process.yield_now(); second) -> 34;
        true -> 35
    }.

pub yield_condition_capture(flag: Bool, left: Int, right: Int): Int ->
