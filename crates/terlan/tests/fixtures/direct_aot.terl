        (Process.yield_now(); flag) -> left + right;
        true -> left - right
    }.

pub yield_condition_local(value: Int): Int ->
    if {
        (let adjusted = value + 1; let unused = value + 100; (Process.yield_now(); adjusted > 10)) -> value;
        true -> 0
    }.

pub yield_condition_prefix_error(divisor: Int): Int ->
    if {
        (let checked = 1 div divisor; (Process.yield_now(); checked > 0)) -> 1;
        true -> 0
    }.

pub yield_condition_twice(flag: Bool): Int ->
    if {
        (Process.yield_now(); Process.yield_now(); flag) -> 36;
        true -> 37
    }.

pub yield_condition_then_body(flag: Bool): Int ->
    if {
        (Process.yield_now(); flag) -> (Process.yield_now(); 38);
        true -> 39
    }.

pub nested_yield_condition(outer: Bool, inner: Bool): Int ->
    if {
        outer -> if {
            (Process.yield_now(); inner) -> 40;
            true -> 41
        };
        true -> 42
    }.

pub yield_short_circuit_left(left: Bool, right: Bool): Bool ->
    (Process.yield_now(); left) and right.

pub yield_short_circuit_left_guard(left: Bool): Bool ->
    (Process.yield_now(); left) and 1 div 0 == 0.

pub yield_short_circuit_or_left(left: Bool, right: Bool): Bool ->
    (Process.yield_now(); left) or right.

pub yield_short_circuit_or_guard(left: Bool): Bool ->
    (Process.yield_now(); left) or 1 div 0 == 0.

pub yield_condition_only(flag: Bool): Int ->
    if {
        (Process.yield_now(); flag) -> 43
    }.

pub yield_comparison_condition(value: Int): Int ->
    if {
        (Process.yield_now(); value) > 10 -> 51;
        true -> 52
    }.

pub yield_not_condition(flag: Bool): Int ->
    if {
        not (Process.yield_now(); flag) -> 53;
        true -> 54
    }.

pub yield_and_rhs(left: Bool, right: Bool): Int ->
    if {
        left and (Process.yield_now(); right) -> 55;
        true -> 56
    }.

pub yield_or_rhs(left: Bool, right: Bool): Int ->
    if {
        left or (Process.yield_now(); right) -> 57;
        true -> 58
    }.

pub yield_and_rhs_only(left: Bool, right: Bool): Int ->
    if {
        left and (Process.yield_now(); right) -> 59
    }.

pub yield_and_rhs_then_body(left: Bool, right: Bool): Int ->
    if {
        left and (Process.yield_now(); right) -> (Process.yield_now(); 60);
        true -> 61
    }.

pub yield_or_rhs_then_body(left: Bool, right: Bool): Int ->
    if {
        left or (Process.yield_now(); right) -> (Process.yield_now(); 74);
        true -> 75
    }.

pub yield_nested_and_rhs(first: Bool, second: Bool, third: Bool): Int ->
    if {
        first and (second and (Process.yield_now(); third)) -> 62;
        true -> 63
    }.

pub checked_before_yield_rhs(divisor: Int, flag: Bool): Int ->
    if {
        1 div divisor > 0 and (Process.yield_now(); flag) -> 64;
        true -> 65
    }.

pub yield_eager_right_condition(divisor: Int, value: Int): Int ->
    if {
        1 div divisor > (Process.yield_now(); value) -> 68;
        true -> 69
    }.

pub yield_eager_value(divisor: Int, value: Int): Int ->
    1 div divisor + (Process.yield_now(); value).

pub yield_unary_value(value: Int): Int ->
    -(Process.yield_now(); value).

pub yield_second_call_argument(divisor: Int, value: Int): Int ->
    add(1 div divisor, (Process.yield_now(); value)).

pub yield_first_call_argument(value: Int, divisor: Int): Int ->
    add((Process.yield_now(); value), 1 div divisor).

pub call_yielding(flag: Bool): Int ->
    branch_yield(flag).

pub tail_yielding_local(flag: Bool, value: Int): Int ->
    branch_yield_local(flag, value).

pub tail_yielding_branch(which: Bool, flag: Bool): Int ->
    if {
        which -> branch_yield(flag);
        true -> yielded_add(41)
    }.

pub tail_yielding_chain(flag: Bool): Int ->
    call_yielding(flag).

pub tail_yielding_bool(flag: Bool): Bool ->
    yielded_bool(flag).

pub non_tail_yielding(flag: Bool): Int ->
    branch_yield(flag) + 1.

pub non_tail_yielding_offset(flag: Bool, offset: Int): Int ->
    branch_yield(flag) + offset.

pub non_tail_nested(flag: Bool): Int ->
    (branch_yield(flag) + 1) * 2.

pub non_tail_negated(flag: Bool): Int ->
    -branch_yield(flag).

pub non_tail_call_argument(flag: Bool): Int ->
    add(branch_yield(flag), 1).

pub non_tail_second_call_argument(divisor: Int, flag: Bool): Int ->
    add(1 div divisor, branch_yield(flag)).

pub non_tail_let(flag: Bool): Int ->
    let value = branch_yield(flag);
    value + 2.

pub non_tail_later_let(divisor: Int, flag: Bool): Int ->
    let checked = 1 div divisor;
    let value = branch_yield(flag);
    checked + value.

pub non_tail_local_capture(flag: Bool, value: Int, offset: Int): Int ->
    branch_yield_local(flag, value) + offset.

pub non_tail_bool(flag: Bool): Bool ->
    not yielded_bool(flag).

pub non_tail_condition(flag: Bool): Int ->
    if {
        yielded_bool(flag) -> 70;
        true -> 71
    }.

pub non_tail_checked_argument(divisor: Int): Int ->
    branch_yield(1 div divisor > 0) + 3.

pub non_tail_branch(which: Bool, flag: Bool): Int ->
    if {
        which -> branch_yield(flag) + 4;
        true -> 5
    }.

pub tail_composed_call(flag: Bool): Int ->
    non_tail_yielding(flag).

pub non_tail_multi_stage(): Int ->
    yielded_add_twice(1) + 1.

pub non_tail_multi_stage_offset(value: Int, offset: Int): Int ->
    yielded_add_twice(value) + offset.

pub non_tail_multi_stage_nested(value: Int): Int ->
    (yielded_add_twice(value) + 1) * 2.

pub non_tail_multi_stage_bool(flag: Bool): Bool ->
    not yielded_bool_twice(flag).

pub non_tail_multi_stage_condition(flag: Bool): Int ->
    if {
        yielded_bool_twice(flag) -> 72;
        true -> 73
    }.

pub non_tail_multi_stage_branch(which: Bool, value: Int): Int ->
    if {
        which -> yielded_add_twice(value) + 4;
        true -> 5
    }.

pub non_tail_multi_stage_checked(divisor: Int): Int ->
    yielded_add_twice(1 div divisor) + 1.

pub tail_multi_stage_composed(value: Int, offset: Int): Int ->
    non_tail_multi_stage_offset(value, offset).

pub yielded_eight(value: Int): Int ->
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    Process.yield_now();
    value.

pub non_tail_eight(value: Int): Int ->
    yielded_eight(value) + 1.

pub non_tail_eager_right(divisor: Int, flag: Bool): Int ->
    1 div divisor + branch_yield(flag).

pub non_tail_two_calls(first: Bool, second: Bool): Int ->
    branch_yield(first) + branch_yield(second).

pub call_then_direct_yield(flag: Bool, value: Int): Int ->
    branch_yield(flag) + (Process.yield_now(); value).

pub call_then_direct_yield_completes(): Bool ->
    branch_yield(false) + (Process.yield_now(); 3) == 10.

pub call_then_direct_yield_suspends(): Bool ->
    branch_yield(true) + (Process.yield_now(); 3) == 44.

pub direct_yield_then_call(value: Int, flag: Bool): Int ->
    (Process.yield_now(); value) + branch_yield(flag).

pub non_tail_eight_calls(
    a: Bool,
    b: Bool,
    c: Bool,
    d: Bool,
    e: Bool,
    f: Bool,
    g: Bool,
    h: Bool,
): Int ->
    add(
        branch_yield(a),
        add(
            branch_yield(b),
            add(
                branch_yield(c),
                add(
                    branch_yield(d),
                    add(
                        branch_yield(e),
                        add(branch_yield(f), add(branch_yield(g), branch_yield(h))),
                    ),
                ),
            ),
        ),
    ).

local_shard_transition_roots(): Bool ->
    yielded();
    yielded_twice();
    send_to_self();
    send_then_receive_call();
    spawn_then_send();
    timer_then_true();
    resource_then_true();
    schedule_priority_then_true();
    schedule_background_then_true();
    call_then_direct_yield_completes();
    call_then_direct_yield_suspends();
    true.

managed_continuation_roots(): Bool ->
    managed_entry_resume();
    managed_branch_left();
    managed_branch_right();
    managed_nested();
    managed_repeated();
    managed_tail();
    managed_non_tail();
    managed_non_tail_repeated();
    true.

pub main(): Bool ->
    if {
        false -> (local_shard_transition_roots(); managed_continuation_roots());
        true -> classify(6) == 13
    }.

