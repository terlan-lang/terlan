module std.native.collections.VectorTest.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.native.collections.Vector.
import std.test.Test.{assert_equal}.

import type std.native.collections.Vector.

empty_vector(): Vector[Int] ->
    Vector.new().

@test
pub constructor_packs_values(): Bool ->
    let values = Vector(1, 2, 3);
    assert_equal(3, values.len()).

@test
pub new_starts_empty(): Bool ->
    assert_equal(0, empty_vector().length()).

@test
pub from_list_and_to_list_roundtrip(): Bool ->
    let values =
        1
        |> List(2, 3)
        |> Vector.from_list();
    assert_equal(3, values.to_list().length()).

@test
pub get_at_reads_indexed_value(): Bool ->
    let values = Vector(10, 20, 30);
    assert_equal(20, values.get_at(1)).

@test
pub get_returns_some_for_valid_index(): Bool ->
    let values = Vector(10, 20, 30);
    assert_equal(Some(20), values.get(1)).

@test
pub get_returns_none_for_negative_index(): Bool ->
    let values = Vector(10, 20, 30);
    assert_equal(None, values.get(-1)).

@test
pub get_returns_none_for_index_at_or_beyond_length(): Bool ->
    let values = Vector(10, 20, 30);
    assert_equal(None, values.get(3)) and assert_equal(None, values.get(30)).

@test
pub index_get_reads_with_bracket_syntax(): Bool ->
    let values = Vector(10, 20, 30);
    assert_equal(20, values[1]).

@test
pub set_at_updates_indexed_value(): Bool ->
    let values = Vector(10, 20, 30);
    values.set_at(1, 99);
    assert_equal(99, values.get_at(1)).

@test
pub index_set_updates_with_bracket_syntax(): Bool ->
    let values = Vector(10, 20, 30);
    values[1] = 99;
    assert_equal(99, values[1]).

@test
pub swap_exchanges_values(): Bool ->
    let values = Vector(1, 2, 3);
    values.swap(0, 2);
    assert_equal(3, values[0]).

@test
pub push_appends_value(): Bool ->
    let values = empty_vector();
    values.push(7);
    assert_equal(7, values[0]).
