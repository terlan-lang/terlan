/**
 * The replaced content is sized to maintain its aspect ratio while filling the element's entire
 * content box. If the object's aspect ratio does not match the aspect ratio of its box, then the
 * object will be clipped to fit.
 */
pub type Cover.

/**
 * The replaced content is sized to fill the element's content box. This is the `initial` value. The
 * entire object will completely fill the box. If the object's `aspect ratio` does not match the
 * aspect ratio of its box, then the object will be stretched to fit.
 */
pub type Fill.

/**
 * The replaced content is not resized.
 */
pub type None.

/**
 * The content is sized as if `none` or `contain` were specified, whichever would result in a
 * smaller concrete object size.
 */
pub type ScaleDown = Atom["scale-down"].

