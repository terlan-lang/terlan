/**
 * Forces a page break right before the principal box. Breaking through all possible fragmentation
 * contexts. So a break inside a multicol container, which was inside a page container would force a
 * column and page break.
 */
pub type All.

/**
 * Forces a page break right before the principal box. The type of this break is that of the
 * immediately-containing fragmentation context. If we are inside a multicol container then it would
 * force a column break, inside paged media (but not inside a multicol container) a page break.
 */
pub type Always.

/**
 * Allows, but does not force, any break (page, column, or region) to be inserted right before the
 * principal box.
 */
pub type Auto.

/**
 * Avoids any break (page, column, or region) from being inserted right before the principal box.
 */
pub type Avoid.

/**
 * Avoids any column break right before the principal box.
