import type std.css.Values.{Inherit, Initial, Revert, RevertLayer, Unset}.

/**
 * Allows the default behavior at a scroll boundary. Scrolling may continue in another scroll
 * container.
 */
pub type Auto.

/**
 * Allows scrolling to continue outside the scroll container, but prevents overscroll "bounce"
 * effects.
 */
pub type Chain.

/**
 * Prevents scrolling from continuing outside the scroll container. "Bounce" effects may still
