module std.css.properties.BackgroundAttachment.

import type std.css.Values.{Inherit, Initial, Revert, RevertLayer, Unset}.

/**
 * The background is fixed relative to the viewport. Even if an element has a scrolling mechanism,
 * the background doesn't move with the element. If set, the `background-origin` property is
 * ignored.
 */
pub type Fixed.

/**
 * The background is fixed relative to the element's contents. If the element has a scrolling
 * mechanism, the background scrolls with the element's contents, and the background painting area
 * and background positioning area are relative to the scrollable area of the element rather than to
 * the border framing them.
 */
