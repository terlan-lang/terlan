/**
 * The background is fixed relative to the element itself and does not scroll with its contents. (It
 * is effectively attached to the element's border.)
 */
pub type Scroll.

pub struct Property {
    background_attachment: Scroll | Fixed | Local | Inherit | Initial | Unset | Revert | RevertLayer,
}.
