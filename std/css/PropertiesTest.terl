module std.css.PropertiesTest.

import std.core.Option.{None, Some}.
import std.css.Values.
import std.css.Values.{Inherit}.
import std.css.properties.Margin.{Auto as MarginAuto}.
import type std.css.properties.MarginLeft.{Property as MarginProperty}.
import type std.css.properties.Width.{Property as WidthProperty}.
import std.css.properties.Width.{Auto as WidthAuto}.
import std.css.properties.{Border, Gap, Height, Margin, MarginLeft, Padding, Width}.
import std.test.Test.{assert_equal}.

pub struct MarginStyle includes MarginProperty {}.
pub struct WidthStyle includes WidthProperty {}.

@test
pub negative_sizes_and_gaps_are_rejected(): Bool ->
    assert_equal(None, Width.length(Values.px(-1.0)))
        and assert_equal(None, Height.percentage(Values.percent(-1.0)))
        and assert_equal(None, Gap.length(Values.px(-0.5))).

@test
pub zero_sizes_and_positive_percentages_are_accepted(): Bool ->
    case {Width.length(Values.px(0.0)), Height.percentage(Values.percent(100.0))} {
        {Some(_), Some(_)} -> true;
        _ -> false
    }.

@test
pub negative_margins_remain_valid_css_values(): Bool ->
    let style = MarginStyle {margin_left: Values.px(-10.0)};
    assert_equal(style.margin_left, Values.px(-10.0)).

@test
pub shorthand_components_keep_their_numeric_constraints(): Bool ->
    assert_equal(None, Padding.component_length(Values.px(-1.0)))
        and assert_equal(None, Padding.component_percentage(Values.percent(-1.0)))
        and case Padding.component_length(Values.px(0.0)) {
    Some(_) -> true;
    None -> false
}.

@test
pub border_width_parts_reject_negative_lengths(): Bool ->
    assert_equal(None, Border.line_width_length(Values.px(-1.0)))
        and case Border.line_width_length(Values.px(0.0)) {
    Some(_) -> true;
    None -> false
}.

@test
pub keyword_enums_accept_property_and_css_wide_choices(): Bool ->
    let automatic = WidthStyle {width: WidthAuto};
    let inherited = WidthStyle {width: Inherit};
    automatic != inherited.
