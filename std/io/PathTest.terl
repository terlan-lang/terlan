/**
 * Executable release checks for `std.io.Path`.
 *
 * These tests exercise the VM-owned lexical Path std bridge over the Rust
 * `std::path` adapter and keep public Result/Error/opaque-value shapes visible
 * to release coverage.
 */
module std.io.PathTest.

import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.io.Path.
import std.test.Test.{assert_equal}.

import type std.core.{Option, Result}.
import type std.io.Path.{Path, PathError}.

/**
 * Accepts one Path value and returns it unchanged.
 *
 * Input: one opaque `Path`.
 * Output: the same path value.
 * Transformation: proves the public Path type is importable and usable in
 * signatures without exposing native adapter internals.
 */
pub accepts_path(value: Path): Path ->
    value.

/**
 * Accepts one Path error value and returns it unchanged.
 *
 * Input: one portable `PathError`.
 * Output: the same error value.
 * Transformation: proves the public Path error shape is importable and usable
 * in signatures without exposing native adapter internals.
 */
pub accepts_path_error(value: PathError): PathError ->
    value.

/**
 * Accepts one Path result and returns it unchanged.
 *
 * Input: one `Result[Path, PathError]`.
 * Output: the same result value.
 * Transformation: proves path-producing operations expose the expected
 * portable result shape.
 */
pub accepts_path_result(value: Result[Path, PathError]): Result[Path, PathError] ->
    value.

pub option_equals(value: Option[String], expected: String): Bool ->
    case value {
        Some(text) -> assert_equal(expected, text);
        None -> false
    }.

pub option_path_to_string_equals(value: Option[Path], expected: String): Bool ->
    case value {
        Some(path) -> assert_equal(expected, path.to_string());
        None -> false
    }.

@test
pub parse_and_to_string_roundtrip_relative_path(): Bool ->
    case accepts_path_result(Path.from_string("src/main.terl")) {
        Ok(path) -> assert_equal("src/main.terl", accepts_path(path).to_string());
        Err(_reason) -> false
    }.

@test
pub join_and_components_are_lexical(): Bool ->
    let {
        Ok(base) <- Path.from_string("src");
        Ok(joined) <- base.join("main.terl")
    } else {
        _ -> false
    };
    assert_equal("src/main.terl", joined.to_string())
        and option_equals(joined.file_name(), "main.terl")
        and option_equals(joined.extension(), "terl")
        and option_path_to_string_equals(joined.parent(), "src").

@test
pub absolute_paths_are_classified_without_io(): Bool ->
    case Path.from_string("/tmp/terlan") {
        Ok(path) -> assert_equal(true, path.is_absolute());
        Err(_reason) -> false
    }.

@test
pub relative_paths_are_not_absolute(): Bool ->
    case Path.from_string("tmp/terlan") {
        Ok(path) -> assert_equal(false, path.is_absolute());
        Err(_reason) -> false
    }.

@test
pub normalization_and_component_prefixes_are_lexical(): Bool ->
    case {Path.from_string("/tmp/site/api/../index.html"), Path.from_string("/tmp/site")} {
        {Ok(path), Ok(root)} ->
            assert_equal("/tmp/site/index.html", path.normalize().to_string())
                and path.normalize().starts_with(root.normalize())
                and case path.normalize().strip_prefix(root.normalize()) {
    Some(relative) -> relative.to_string() == "index.html";
    None -> false
};
        _ -> false
    }.

@test
pub normalization_rejects_false_textual_prefixes(): Bool ->
    case {Path.from_string("/tmp/site-other/index.html"), Path.from_string("/tmp/site")} {
        {Ok(path), Ok(root)} -> not path.normalize().starts_with(root.normalize());
        _ -> false
    }.
