/**
 * Portable console output.
 *
 * `std.io.Console` exposes target-neutral console operations. Backends own
 * the concrete runtime calls needed to implement these operations.
 */
module std.io.Console.

import std.core.Result.{Err}.
import std.core.{Error, Unit}.

import type std.core.{Error, Option, Result}.

/**
 * Writes a string followed by one line terminator.
 *
 * Input: one UTF-8 `String` value.
 * Output: `Unit`.
 * Transformation: lowers through the compiler-owned
 * `runtime.console.println` capability for each selected target. Portable
 * Terlan source must call this function instead of runtime-private console
 * modules.
 *
 * ```terlan
 * module console_println_example.
 *
 * pub demo(): Unit ->
 *    std.io.Console.println("hello").
 * ```
 */
@compiler.intrinsic
pub println(value: String): Unit ->
    Unit.

/**
 * Writes a diagnostic string followed by one line terminator to standard error.
 *
 * Input: one UTF-8 `String` value.
 * Output: `Unit` after the diagnostic has been written.
 * Transformation: lowers through the compiler-owned
 * `runtime.console.eprintln` capability so portable command-line tools can
 * keep diagnostics separate from machine-readable standard output.
 */
@compiler.intrinsic
pub eprintln(value: String): Unit ->
    Unit.

/**
 * Reads one bounded UTF-8 line from the application's standard input.
 *
 * Returns `Ok(Some(line))` without the LF or CRLF terminator, `Ok(None)` at
 * EOF, or a typed error. `max_bytes` bounds content bytes and must be between
 * 1 and 1 MiB. A final unterminated line is returned before EOF. After an
 * input/encoding/limit error, callers should close the stream. This operation
 * can wait for input and is VM-owned; it never reads a helper's RPC channel.
 */
@compiler.intrinsic
pub read_line(max_bytes: Int): Result[Option[String], Error] ->
    Err(Error.new(Atom["console.unavailable"], "Console input is unavailable on this target.")).
