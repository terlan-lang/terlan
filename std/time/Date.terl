/**
 * Portable UTC civil dates for validation, release evidence, and applications.
 */
module std.time.Date.

import std.core.Option.{None, Some}.
import std.core.{Int, String}.
import std.time.Clock.

import type std.core.Option.

/**
 * One proleptic-Gregorian calendar date.
 */
pub struct Date {
    year: Int,
    month: Int,
    day: Int,
}.

/**
 * Constructs a validated date between years 1 and 9999.
 */
@pure
pub new(year: Int, month: Int, day: Int): Option[Date] ->
    if {
        valid_components(year, month, day) -> Some(Date(year = year, month = month, day = day));
        true -> None
    }.

/**
 * Returns the calendar year.
 */
@pure
pub year(date: Date): Int ->
    date.year.

/**
 * Returns the one-based calendar month.
 */
@pure
pub month(date: Date): Int ->
    date.month.

/**
 * Returns the one-based day of month.
 */
@pure
pub day(date: Date): Int ->
    date.day.

/**
 * Parses an exact `YYYY-MM-DD` date.
 */
pub parse_iso(source: String): Option[Date] ->
    case String.split(source, "-") {
        [year_source, month_source, day_source] ->
            let {
                Some(year_value) <- Int.from_string(year_source);
                Some(month_value) <- Int.from_string(month_source);
                Some(day_value) <- Int.from_string(day_source);
                Some(date) <- new(year_value, month_value, day_value)
            } else {
                _ -> None
            };
            if {
                to_iso(date) == source -> Some(date);
                true -> None
            };
        _ -> None
    }.

/**
 * Renders a canonical `YYYY-MM-DD` date.
 */
@pure
pub to_iso(date: Date): String ->
    String.append(
        padded_year(date.year),
        String.append(
            "-",
            String.append(padded_pair(date.month), String.append("-", padded_pair(date.day))),
        ),
    ).

/**
 * Returns today's date in UTC through the VM-owned wall clock.
 */
pub today_utc(): Date ->
    from_epoch_days(floor_div(Clock.unix_time_ns(), 86400000000000)).

/**
 * Returns signed whole days from `start` to `end`.
 */
@pure
pub days_between(start: Date, end: Date): Int ->
    to_epoch_days(end) - to_epoch_days(start).

/**
 * Returns whether `left` is earlier than `right`.
 */
@pure
pub is_before(left: Date, right: Date): Bool ->
    to_epoch_days(left) < to_epoch_days(right).

/**
 * Returns whether both dates identify the same civil day.
 */
@pure
pub equal(left: Date, right: Date): Bool ->
    left.year == right.year and left.month == right.month and left.day == right.day.

@pure
valid_components(year_value: Int, month_value: Int, day_value: Int): Bool ->
    year_value >= 1
        and year_value <= 9999
        and month_value >= 1
        and month_value <= 12
        and day_value >= 1
        and day_value <= days_in_month(year_value, month_value).

@pure
days_in_month(year_value: Int, month_value: Int): Int ->
    if {
        month_value == 2 and leap_year(year_value) -> 29;
        month_value == 2 -> 28;
        month_value == 4 or month_value == 6 or month_value == 9 or month_value == 11 -> 30;
        true -> 31
    }.

@pure
leap_year(year_value: Int): Bool ->
    year_value rem 4 == 0 and (year_value rem 100 != 0 or year_value rem 400 == 0).

@pure
padded_pair(value: Int): String ->
    if {
        value < 10 -> String.append("0", Int.to_string(value));
        true -> Int.to_string(value)
    }.

@pure
padded_year(value: Int): String ->
    if {
        value < 10 -> String.append("000", Int.to_string(value));
        value < 100 -> String.append("00", Int.to_string(value));
        value < 1000 -> String.append("0", Int.to_string(value));
        true -> Int.to_string(value)
    }.

@pure
floor_div(value: Int, divisor: Int): Int ->
    let quotient = value / divisor;
    if {
        value rem divisor < 0 -> quotient - 1;
        true -> quotient
    }.

@pure
to_epoch_days(date: Date): Int ->
    let adjusted_year =
        if {
            date.month <= 2 -> date.year - 1;
            true -> date.year
        };
    let era = floor_div(adjusted_year, 400);
    let year_of_era = adjusted_year - era * 400;
    let adjusted_month =
        if {
            date.month > 2 -> date.month - 3;
            true -> date.month + 9
        };
    let day_of_year = (153 * adjusted_month + 2) / 5 + date.day - 1;
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    era * 146097 + day_of_era - 719468.

@pure
from_epoch_days(days: Int): Date ->
    let shifted = days + 719468;
    let era = floor_div(shifted, 146097);
    let day_of_era = shifted - era * 146097;
    let year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    let base_year = year_of_era + era * 400;
    let day_of_year = day_of_era - (year_of_era * 365 + year_of_era / 4 - year_of_era / 100);
    let month_part = (5 * day_of_year + 2) / 153;
    let day_value = day_of_year - (153 * month_part + 2) / 5 + 1;
    let month_value =
        if {
            month_part < 10 -> month_part + 3;
            true -> month_part - 9
        };
    let year_value =
        if {
            month_value <= 2 -> base_year + 1;
            true -> base_year
        };
    Date(year = year_value, month = month_value, day = day_value).
