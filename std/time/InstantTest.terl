module std.time.InstantTest.

import std.time.Instant.{Instant}.

@test
pub constructor_stores_milliseconds(): Bool ->
    std.test.Test.assert_equal(1000.5, Instant(1000.5).to_milliseconds()).

@test
pub from_milliseconds_preserves_payload(): Bool ->
    std.test.Test.assert_equal(42.25, std.time.Instant.from_milliseconds(42.25).to_milliseconds()).

@test
pub add_duration_advances_instant(): Bool ->
    let instant = std.time.Instant.from_milliseconds(100.0); duration = std.time.Duration.from_milliseconds(25.5); std.test.Test.assert_equal(125.5, std.time.Instant.add_duration(instant, duration).to_milliseconds()).

@test
pub subtract_duration_moves_instant_backward(): Bool ->
    let instant = std.time.Instant.from_milliseconds(100.0); duration = std.time.Duration.from_milliseconds(25.5); std.test.Test.assert_equal(74.5, std.time.Instant.subtract_duration(instant, duration).to_milliseconds()).

@test
pub duration_since_returns_millisecond_difference(): Bool ->
    let later = std.time.Instant.from_milliseconds(110.25); earlier = std.time.Instant.from_milliseconds(100.0); std.test.Test.assert_equal(10.25, std.time.Instant.duration_since(later, earlier).to_milliseconds()).
