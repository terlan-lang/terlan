/**
 * Executable release checks for `std.net.Uri`.
 *
 * These tests exercise the Terlan URI value and its package-owned `url` parser.
 * Public Result/Error shapes and component accessors remain release-tested.
 */
module std.net.UriTest.

import std.core.Atom.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok, is_err}.
import std.net.Uri.
import std.test.Test.{assert, assert_equal}.

import type std.core.{Option, Result}.
import type std.net.Uri.{Uri, UriError}.

/**
 * Accepts one URI value and returns it unchanged.
 *
 * Input: one `Uri` with private component fields.
 * Output: the same URI value.
 * Transformation: proves the public URI type is importable and usable in
 * signatures without exposing native adapter internals.
 */
pub accepts_uri(value: Uri): Uri ->
    value.

/**
 * Accepts one URI error value and returns it unchanged.
 *
 * Input: one portable `UriError`.
 * Output: the same error value.
 * Transformation: proves the public URI error shape is importable and usable
 * in signatures without exposing native adapter internals.
 */
pub accepts_uri_error(value: UriError): UriError ->
    value.

/**
 * Accepts one URI parse result and returns it unchanged.
 *
 * Input: one `Result[Uri, UriError]`.
 * Output: the same result value.
 * Transformation: proves URI parsing exposes the expected portable result
 * shape.
 */
pub accepts_uri_result(value: Result[Uri, UriError]): Result[Uri, UriError] ->
    value.

pub option_equals(value: Option[String], expected: String): Bool ->
    case value {
        Some(text) -> assert_equal(expected, text);
        None -> false
    }.

pub option_is_none(value: Option[String]): Bool ->
    case value {
        None -> true;
        Some(_text) -> false
    }.

@test
pub parse_and_to_string_roundtrip_normalized_uri(): Bool ->
    case accepts_uri_result(Uri.parse("https://example.com/docs?q=terlan#intro")) {
        Ok(uri) ->
            assert_equal("https://example.com/docs?q=terlan#intro", accepts_uri(uri).to_string());
        Err(_reason) -> false
    }.

@test
pub component_accessors_read_expected_parts(): Bool ->
    case Uri.parse("https://example.com/docs?q=terlan#intro") {
        Ok(uri) ->
            assert_equal("https", uri.scheme())
                and option_equals(uri.host(), "example.com")
                and assert_equal("/docs", uri.path())
                and option_equals(uri.query(), "q=terlan")
                and option_equals(uri.fragment(), "intro");
        Err(_reason) -> false
    }.

@test
pub optional_components_return_none_when_absent(): Bool ->
    case Uri.parse("https://example.com/docs") {
        Ok(uri) -> option_is_none(uri.query()) and option_is_none(uri.fragment());
        Err(_reason) -> false
    }.

@test
pub parse_reports_invalid_uri_text(): Bool ->
    assert(is_err(Uri.parse("not a uri"))).

@test
pub query_pairs_preserve_order_duplicates_and_decoding(): Bool ->
    Uri.query_pairs("") == []
        and Uri.query_pairs("a=1&a=2&room=a%2Bb+c&empty") == [{"a", "1"}, {"a", "2"}, {"room", "a+b c"}, {"empty", ""}].

@test
pub parse_builds_portable_error_in_terlan(): Bool ->
    case Uri.parse("https://[::1") {
        Err(reason) ->
            Atom.to_string(reason.code) == "uri.parse"
                and reason.offset == 0
                and reason.message != "";
        Ok(_uri) -> false
    }.

@test
pub empty_components_differ_from_absent_components(): Bool ->
    case Uri.parse("https://example.com/?#") {
        Ok(uri) -> option_equals(uri.query(), "") and option_equals(uri.fragment(), "");
        Err(_reason) -> false
    }.

@test
pub hostless_uri_is_an_ordinary_managed_value(): Bool ->
    case Uri.parse("mailto:user@example.com") {
        Ok(uri) ->
            uri.scheme() == "mailto"
                and option_is_none(uri.host())
                and uri.path() == "user@example.com";
        Err(_reason) -> false
    }.
