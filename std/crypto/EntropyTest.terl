/**
 * Executable checks for the package-owned OS entropy boundary.
 */
module std.crypto.EntropyTest.

import std.crypto.Entropy.
import std.test.Test.{assert_equal, each, row}.
import std.vm.Bytes.

@test
pub entropy_returns_exact_requested_byte_counts(): Bool ->
    each(
        [row("minimum", 1, 1), row("session", 32, 32), row("maximum", 4_096, 4_096)],
        (current) ->
            case current {
                {_name, count, expected} -> assert_equal(expected, Entropy.bytes(count).length())
            },
    ).
