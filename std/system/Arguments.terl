/**
 * Immutable command-line arguments for one Terlan VM application run.
 *
 * `terlc run ... -- value` and packaged launchers place values after `--` in
 * this application-owned argument vector. Compiler and VM options are never
 * visible through this module.
 */
module std.system.Arguments.

import type std.core.Option.

/**
 * Returns the number of application arguments.
 */
@compiler.intrinsic
pub count(): Int -> 0.

/**
 * Returns one argument or `None` when the index is outside the run vector.
 */
@compiler.intrinsic
pub get(index: Int): Option[String] ->
    None.
