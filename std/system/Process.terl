/**
 * Bounded external-process orchestration for trusted Terlan tooling.
 */
module std.system.Process.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err}.

import type std.core.{Option, Result}.

/**
 * One environment variable overlaid on the child process environment.
 */
pub struct EnvironmentEntry {
    key: String,
    value: String,
}.

/**
 * Constructs one typed child environment overlay entry.
 */
pub environment_entry(key: String, value: String): EnvironmentEntry ->
    EnvironmentEntry(key = key, value = value).

/**
 * A fully bounded child-process request.
 */
pub struct Command {
    program: String,
    arguments: List[String],
    working_directory: Option[String],
    environment: List[EnvironmentEntry],
    removed_environment: List[String],
    stdin: String,
    timeout_ms: Int,
    output_limit_bytes: Int,
}.

/**
 * Captured child completion. A nonzero status is still a successful launch.
 */
pub struct Output {
    /**
     * Child status code, or `-1` for signal termination.
     */
    status: Int,
    /**
     * Captured standard output.
     */
    stdout: String,
    /**
     * Captured standard error.
     */
    stderr: String,
}.

/**
 * One ordered batch completion; exactly one optional field is populated.
 */
pub struct BatchCompletion {
    /**
     * Successful output for a batch entry when present.
     */
    output: Option[Output],
    /**
     * Typed process error for a batch entry when present.
     */
    error: Option[ProcessError],
}.

/**
 * Ordered child completions returned by `run_many`.
 */
pub struct BatchOutput {
    /**
     * Ordered completions from a bounded batch.
     */
    completions: List[BatchCompletion],
}.

/**
 * Nominal request envelope used by the fixed VM capability protocol.
 */
pub struct BatchRequest {
    commands: List[Command],
    max_concurrency: Int,
}.

/**
 * One write/read phase in a length-framed child protocol.
 */
pub struct FramedExchange {
    input: String,
    expected_frames: Int,
}.

/**
 * A bounded, phased child protocol using a named byte-length header.
 */
pub struct FramedRequest {
    command: Command,
    exchanges: List[FramedExchange],
    length_header: String,
}.

/**
 * Ordered frame bodies and child completion from a framed session.
 */
pub struct FramedOutput {
    /**
     * Child status code from a framed session.
     */
    status: Int,
    /**
     * Ordered response frame bodies from a framed session.
     */
    frames: List[String],
    /**
     * Captured standard error from a framed session.
     */
    stderr: String,
}.

/**
 * Runtime-owned resource ceilings for bounded process orchestration.
 */
pub struct Limits {
    /**
     * Maximum accepted wall-clock timeout in milliseconds.
     */
    maximum_timeout_ms: Int,
    /**
     * Maximum accepted combined stdout/stderr capture bound.
     */
    maximum_output_bytes: Int,
    /**
     * Maximum accepted UTF-8 standard-input size.
     */
    maximum_stdin_bytes: Int,
    /**
     * Maximum number of commands accepted by one batch.
     */
    maximum_batch_commands: Int,
    /**
     * Maximum worker concurrency accepted by one batch.
     */
    maximum_batch_concurrency: Int,
    /**
     * Maximum number of write/read phases in one framed session.
     */
    maximum_framed_exchanges: Int,
    /**
     * Maximum total response frames in one framed session.
     */
    maximum_framed_responses: Int,
}.

pub type InvalidRequest.

pub type SpawnFailed.

pub type TimedOut.

pub type Cancelled.

pub type OutputLimitExceeded.

pub type InvalidFrame.

/**
 * Stable failures before a bounded child completion can be returned.
 */
pub type ProcessErrorCode =
      InvalidRequest
    | SpawnFailed
    | TimedOut
    | Cancelled
    | OutputLimitExceeded
    | InvalidFrame.

/**
 * Portable process failure with the attempted program attached.
 */
pub struct ProcessError {
    /**
     * Stable process error category.
     */
    code: ProcessErrorCode,
    /**
     * Process error diagnostic.
     */
    message: String,
    /**
     * Attempted program.
     */
    program: String,
}.

/**
 * Reads the authoritative process resource ceilings from the active runtime.
 *
 * Tooling should use this value rather than embedding VM implementation
 * limits. The returned values are positive and apply to `run`, `run_many`, and
 * `run_length_framed`.
 */
@compiler.intrinsic
pub limits(): Limits ->
    Limits(
        maximum_timeout_ms = 1,
        maximum_output_bytes = 1,
        maximum_stdin_bytes = 1,
        maximum_batch_commands = 1,
        maximum_batch_concurrency = 1,
        maximum_framed_exchanges = 1,
        maximum_framed_responses = 1,
    ).

/**
 * Constructs a command with conservative validator defaults.
 */
pub command(program: String): Command ->
    Command(
        program = program,
        arguments = List.new[String](),
        working_directory = None,
        environment = List.new[EnvironmentEntry](),
        removed_environment = List.new[String](),
        stdin = "",
        timeout_ms = 60_000,
        output_limit_bytes = 1_048_576,
    ).

/**
 * Replaces the ordered child argument vector.
 */
pub with_arguments(command: Command, arguments: List[String]): Command ->
    Command(
        program = command.program,
        arguments = arguments,
        working_directory = command.working_directory,
        environment = command.environment,
        removed_environment = command.removed_environment,
        stdin = command.stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Selects the child working directory.
 */
pub with_working_directory(command: Command, path: String): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = Some(path),
        environment = command.environment,
        removed_environment = command.removed_environment,
        stdin = command.stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Replaces the environment overlay without clearing inherited variables.
 */
pub with_environment(command: Command, environment: List[EnvironmentEntry]): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = command.working_directory,
        environment = environment,
        removed_environment = command.removed_environment,
        stdin = command.stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Replaces the environment keys removed from the inherited child context.
 * Entries supplied by `with_environment` are applied afterward and therefore
 * remain authoritative when the same key appears in both lists.
 */
pub without_environment(command: Command, keys: List[String]): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = command.working_directory,
        environment = command.environment,
        removed_environment = keys,
        stdin = command.stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Supplies bounded UTF-8 standard input.
 */
pub with_stdin(command: Command, stdin: String): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = command.working_directory,
        environment = command.environment,
        removed_environment = command.removed_environment,
        stdin = stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Selects a wall-clock timeout from 1 through `maximum_timeout_ms(limits())`.
 */
pub with_timeout_ms(command: Command, timeout_ms: Int): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = command.working_directory,
        environment = command.environment,
        removed_environment = command.removed_environment,
        stdin = command.stdin,
        timeout_ms = timeout_ms,
        output_limit_bytes = command.output_limit_bytes,
    ).

/**
 * Selects a capture bound from 1 through `maximum_output_bytes(limits())`.
 */
pub with_output_limit_bytes(command: Command, limit: Int): Command ->
    Command(
        program = command.program,
        arguments = command.arguments,
        working_directory = command.working_directory,
        environment = command.environment,
        removed_environment = command.removed_environment,
        stdin = command.stdin,
        timeout_ms = command.timeout_ms,
        output_limit_bytes = limit,
    ).

/**
 * Executes one bounded command through the VM-owned process capability.
 * On Linux/macOS, background children in the command's process group are
 * terminated when the command exits or the request fails. This is not a
 * daemon-launch API or a sandbox for programs that deliberately detach.
 * The request deadline also covers draining standard streams after child exit.
 * A peer in another process group cannot keep those pipe reads/writes blocked
 * beyond the deadline; terminating that peer is not guaranteed by this API.
 */
@compiler.intrinsic
pub run(command: Command): Result[Output, ProcessError] ->
    Err(
        ProcessError(
            code = InvalidRequest,
            message = "process capability unavailable",
            program = command.program,
        ),
    ).

/**
 * Executes commands concurrently with a caller-selected positive bound.
 *
 * Results retain input order even when children complete out of order. Each
 * command keeps its own timeout and output bound; an invalid command therefore
 * produces an inner `Err` without cancelling unrelated commands. An invalid
 * batch bound produces the outer `Err` before any child is started.
 */
pub batch(commands: List[Command], max_concurrency: Int): BatchRequest ->
    BatchRequest(commands = commands, max_concurrency = max_concurrency).

/**
 * Executes one nominal bounded batch request through the VM capability.
 */
@compiler.intrinsic
pub run_many(request: BatchRequest): Result[BatchOutput, ProcessError] ->
    Err(
        ProcessError(
            code = InvalidRequest,
            message = "process batch capability unavailable",
            program = "",
        ),
    ).

/**
 * Constructs one phased write followed by an exact response-frame count.
 */
pub exchange(input: String, expected_frames: Int): FramedExchange ->
    FramedExchange(input = input, expected_frames = expected_frames).

/**
 * Constructs a bounded length-framed protocol request.
 *
 * The VM writes and flushes each exchange input, waits for that exchange's
 * response count, then advances to the next exchange. Standard input closes
 * after the last exchange. `length_header` names the case-insensitive decimal
 * byte-length header; header blocks use CRLF and terminate with an empty line.
 */
pub length_framed(
    command: Command,
    exchanges: List[FramedExchange],
    length_header: String,
): FramedRequest ->
    FramedRequest(command = command, exchanges = exchanges, length_header = length_header).

/**
 * Executes one VM-owned phased length-framed child session.
 */
@compiler.intrinsic
pub run_length_framed(request: FramedRequest): Result[FramedOutput, ProcessError] ->
    Err(
        ProcessError(
            code = InvalidRequest,
            message = "framed process capability unavailable",
            program = "",
        ),
    ).
