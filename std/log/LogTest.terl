module std.log.LogTest.

import std.core.Unit.
import std.test.Test.{assert_equal}.

@test
pub debug_returns_unit(): Bool ->
    assert_equal(Unit, std.log.Log.debug("debug")).

@test
pub info_returns_unit(): Bool ->
    assert_equal(Unit, std.log.Log.info("info")).

@test
pub warn_returns_unit(): Bool ->
    assert_equal(Unit, std.log.Log.warn("warn")).

@test
pub error_returns_unit(): Bool ->
    assert_equal(Unit, std.log.Log.error("error")).
