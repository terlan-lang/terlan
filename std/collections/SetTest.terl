module std.collections.SetTest.

import std.collections.{List, Set}.
import std.test.Test.{assert, assert_equal}.

@test
pub constructor_packs_unique_values(): Bool ->
    let values = Set(1, 1, 2);
    assert_equal(2, values.size()).

@test
pub from_list_packs_unique_values(): Bool ->
    let source = List(1, 1, 2);
    let values = Set.from_list(source);
    assert_equal(2, values.size()).

@test
pub new_starts_empty(): Bool ->
    let values = Set.new();
    assert(values.is_empty()).

@test
pub add_updates_size_and_membership(): Bool ->
    let values = Set.new();
    values.add(1);
    values.add(1);
    assert_equal(1, values.size()).

@test
pub contains_tracks_mutations(): Bool ->
    let values = Set.new();
    values.add(1);
    assert(values.contains(1)).

@test
pub clear_removes_values(): Bool ->
    let values = Set.new();
    values.add(1);
    values.clear();
    assert(values.is_empty()).

@test
pub enumerable_fold_accumulates_values(): Bool ->
    let values = Set(1, 1, 2);
    assert_equal(2, values.size()).

@test
pub enumerable_map_yields_values(): Bool ->
    let values = Set(1, 1, 2);
    assert(values.contains(2)).
