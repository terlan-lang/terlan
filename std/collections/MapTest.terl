module std.collections.MapTest.

import std.collections.Iterator.{next}.
import std.collections.{List, Map}.
import std.core.Option.{None, Option, Some}.
import std.test.Test.{assert, assert_equal}.

import type std.collections.Iterator.

pub count_entries(iterator: Iterator[{Int, Int}], count: Int, total: Int): {Int, Int} ->
    case next(iterator) {
        Some({value: {key, value}, next: rest}) ->
            count_entries(rest, count + 1, total + key + value);
        None -> {count, total}
    }.

@test
pub constructor_packs_entries(): Bool ->
    let users = Map({"alice", 1}, {"bob", 2});
    assert_equal(2, users.size()).

@test
pub constructor_replaces_duplicate_keys(): Bool ->
    let users = Map({"alice", 1}, {"alice", 2});
    case users.get("alice") {
        Some(found) -> assert_equal(2, found);
        None -> false
    }.

@test
pub sequential_put_matches_bulk_construction(): Bool ->
    let bulk = Map({"alice", 1}, {"bob", 2}, {"alice", 3});
    let sequential = Map.new[String, Int]();
    sequential.put("alice", 1);
    sequential.put("bob", 2);
    sequential.put("alice", 3);
    bulk.size() == sequential.size()
        and bulk.get("alice") == sequential.get("alice")
        and bulk.get("bob") == sequential.get("bob").

@test
pub from_entries_packs_entries(): Bool ->
    let entries = List({"alice", 1});
    let users = Map.from_entries(entries);
    assert_equal(1, users.size()).

@test
pub new_starts_empty(): Bool ->
    let users = Map.new();
    assert(users.is_empty()).

@test
pub put_updates_size_and_lookup(): Bool ->
    let users = Map.new();
    users.put("alice", 1);
    case users.get("alice") {
        Some(found) -> assert_equal(1, found);
        None -> false
    }.

@test
pub contains_key_tracks_mutations(): Bool ->
    let users = Map.new();
    users.put("alice", 1);
    users.remove("alice");
    assert_equal(false, users.contains_key("alice")).

@test
pub take_returns_value_and_persistent_remainder(): Bool ->
    let users = Map({"alice", 1}, {"bob", 2});
    case Map.take(users, "alice") {
        {None, _remaining} -> false;
        {Some(value), remaining} ->
            let selected_value_is_expected = assert_equal(1, value);
            let source_is_unchanged = users.contains_key("alice");
            let selected_key_is_removed = remaining.contains_key("alice") == false;
            let remainder_is_expected = remaining.contains_key("bob") and remaining.size() == 1;
            selected_value_is_expected
                and source_is_unchanged
                and selected_key_is_removed
                and remainder_is_expected
    }.

@test
pub take_missing_key_returns_original_map_value(): Bool ->
    let users = Map({"alice", 1});
    case Map.take(users, "missing") {
        {None, remaining} -> remaining.size() == 1 and remaining.get("alice") == Some(1);
        {Some(_value), _remaining} -> false
    }.

@test
pub clear_removes_entries(): Bool ->
    let users = Map.new();
    users.put("alice", 1);
    users.put("bob", 2);
    users.clear();
    assert_equal(0, users.size()).

@test
pub enumerable_fold_counts_entries(): Bool ->
    let users = Map({"alice", 1}, {"bob", 2});
    assert_equal(2, users.size()).

@test
pub enumerable_map_yields_entry_pairs(): Bool ->
    let users = Map({"alice", 1});
    case users.get("alice") {
        Some(found) -> assert_equal(1, found);
        None -> false
    }.

@test
pub iterator_visits_every_entry_once(): Bool ->
    let values = Map({1, 10}, {2, 20}, {3, 30});
    assert_equal({3, 66}, count_entries(values.iterator(), 0, 0)).
