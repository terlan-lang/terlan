module std.collections.IteratorTest.

import std.collections.Iterator.{each, next}.
import std.core.Option.{None, Some}.
import std.core.Unit.
import std.test.Test.{assert_equal}.

import type std.collections.Iterator.

sum_values(iterator: std.collections.Iterator.Iterator[Int], sum: Int): Int ->
    case next(iterator) {
        None -> sum;
        Some({value: value, next: rest}) -> sum_values(rest, sum + value)
    }.

@test
pub next_yields_value_and_next_iterator(): Bool ->
    let values = [10, 20];
    case values |> iterator() |> next() {
        Some({value: first, next: rest}) -> second_value_is_expected(rest, first);
        None -> false
    }.

second_value_is_expected(iterator: Iterator[Int], first: Int): Bool ->
    case next(iterator) {
        Some({value: second, next: done}) -> iterator_is_done_with_total(done, first + second);
        None -> false
    }.

iterator_is_done_with_total(iterator: Iterator[Int], total: Int): Bool ->
    case next(iterator) {
        None -> assert_equal(30, total);
        Some(_) -> false
    }.

@test
pub next_returns_none_when_iterator_is_exhausted(): Bool ->
    let values = [];
    case values |> iterator() |> next() {
        None -> true;
        Some(_step) -> false
    }.

@test
pub each_returns_unit_after_visiting_values(): Bool ->
    let values = [1, 2, 3];
    assert_equal(Unit, values |> iterator() |> each((_value) -> Unit)).

@test
pub recursive_next_accumulates_values(): Bool ->
    let values = [1, 2, 3];
    assert_equal(6, values |> iterator() |> sum_values(0)).
