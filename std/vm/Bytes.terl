/**
 * Terlan VM byte buffer contract.
 *
 * `std.vm.Bytes` represents binary protocol frames owned by the runtime target.
 * It is intentionally target-specific so daemon and socket tests can exchange
 * exact byte sequences without adding byte-array syntax to portable Terlan.
 */
module std.vm.Bytes.

import type std.collections.List.

/**
 * Byte is an integer interpreted as one unsigned octet.
 *
 * Input: no runtime input.
 * Output: an `Int` value constrained by this module's constructors and
 * operations to the range `0..255`.
 * Transformation: names the protocol-byte intent without creating a new
 * portable numeric primitive.
 */
pub type Byte = Int.

/**
 * Bytes represents a runtime-owned binary byte buffer.
 *
 * Input: no runtime input.
 * Output: an opaque target-owned byte buffer handle.
 * Transformation: keeps runtime binary representation behind the selected VM
 * contract while exposing a typed protocol-frame value in Terlan source.
 */
@target.vm {process_mailbox: true}
pub opaque type Bytes.

/**
 * Builds a byte buffer from unsigned octets.
 *
 * Input: one list of byte values.
 * Output: `Bytes` containing the values in source order.
 * Transformation: asks the selected VM runtime to validate each octet and pack
 * the values into a binary protocol frame.
 */
@target.vm {process_mailbox: true}
pub from_list(values: List[Byte]): Bytes ->
    native.

/**
 * Returns a byte buffer as unsigned octets.
 *
 * Input: one `Bytes` receiver.
 * Output: the byte values in buffer order.
 * Transformation: asks the selected VM runtime to unpack the binary into a
 * typed Terlan list without exposing backend bit syntax.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) to_list(): List[Byte] ->
    native.

/**
 * Returns the byte length of a buffer.
 *
 * Input: one `Bytes` receiver.
 * Output: count of octets in the buffer.
 * Transformation: delegates to the runtime binary size operation while preserving
 * the opaque source-level representation.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) length(): Int ->
    native.

/**
 * Returns whether this buffer begins with the complete prefix buffer.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) starts_with(prefix: Bytes): Bool ->
    native.

/**
 * Returns whether this buffer contains the complete needle buffer.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) contains(needle: Bytes): Bool ->
    native.

/**
 * Returns the first non-ASCII-whitespace byte index, or `-1` when absent.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) first_non_ascii_whitespace(): Int ->
    native.

/**
 * Concatenates two byte buffers.
 *
 * Input: two `Bytes` values.
 * Output: a new buffer with `left` followed by `right`.
 * Transformation: asks the selected VM runtime to join binary buffers without copying
 * byte lists through portable collection code.
 */
@target.vm {process_mailbox: true}
pub concat(left: Bytes, right: Bytes): Bytes ->
    native.

/**
 * Extracts an immutable byte range.
 *
 * Input: a byte buffer, a zero-based start offset, and a byte length.
 * Output: a new `Bytes` value containing exactly the selected octets.
 * Transformation: validates the complete range before copying the selected
 * bytes into VM-owned immutable storage.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) slice(start: Int, length: Int): Bytes ->
    native.

/**
 * Reads one unsigned big-endian integer from an arbitrary bit range.
 *
 * Input: a byte buffer, a zero-based bit offset measured from the most
 * significant bit of the first byte, and a bit width in `1..63`.
 * Output: the selected bits as a non-negative Terlan `Int`.
 * Transformation: validates the complete bit range before accumulating bits in
 * network order without exposing host pointers or backend bit syntax.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) read_uint_be(bit_offset: Int, bit_width: Int): Int ->
    native.

/**
 * Reads one signed big-endian integer from an arbitrary bit range.
 *
 * Input: a byte buffer, a zero-based bit offset measured from the most
 * significant bit of the first byte, and a bit width in `1..63`.
 * Output: the selected bits interpreted as a two's-complement Terlan `Int`.
 * Transformation: validates and accumulates the complete bit range in network
 * order before sign-extending the declared width.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) read_int_be(bit_offset: Int, bit_width: Int): Int ->
    native.

/**
 * Reads one unsigned little-endian integer from an arbitrary bit range.
 *
 * Input: a byte buffer, a zero-based bit offset measured from the most
 * significant bit of the first byte, and a bit width in `1..63`.
 * Output: the selected bits as a non-negative Terlan `Int`.
 * Transformation: reads network-order bits in groups of at most eight and
 * assigns each successive group increasing numeric significance.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) read_uint_le(bit_offset: Int, bit_width: Int): Int ->
    native.

/**
 * Reads one signed little-endian integer from an arbitrary bit range.
 *
 * Input: a byte buffer, a zero-based bit offset measured from the most
 * significant bit of the first byte, and a bit width in `1..63`.
 * Output: the selected little-endian groups interpreted as a two's-complement
 * Terlan `Int`.
 * Transformation: accumulates successive groups from least to most
 * significant before sign-extending the declared width.
 */
@target.vm {process_mailbox: true}
pub (bytes: Bytes) read_int_le(bit_offset: Int, bit_width: Int): Int ->
    native.
