/**
 * Terlan VM distributed storage adapter contract.
 *
 * `std.vm.DistributedStorage` exposes typed descriptors for VM-owned
 * checkpoint storage adapters. `checkpoint` and `Snapshot.restore` capture and
 * restore bounded, versioned logical state. The standalone VM connects durable
 * `open`, `append`, `flush`, `load_snapshot`, and `close` to a sandboxed SQLite
 * worker through explicit `--storage name=/absolute/private/directory` bindings.
 * Atomic batches, compare-and-swap append, schema transitions, and compaction
 * use the same durable worker. Typed outcomes retain transaction-observed
 * conflicts; proofs require acknowledged durable observations. Policy flags
 * cannot grant host authority. Local-only adapters keep bounded volatile state
 * and make no durability claim. Resource validation currently supports pinned,
 * supervisor-authorized `db.NAME` bindings on the standalone Linux VM path.
 * Replication, quorum writes, and automatic failover are unsupported in 0.0.9.
 * Cluster capability queries return false; replication operations return an
 * explicit unsupported outcome without performing a local write. A future
 * storage service will own consensus, not the VM's core scheduling semantics.
 */
module std.vm.DistributedStorage.

/**
 * Mode represents one distributed storage backend class.
 *
 * Input: mode constructor such as local-only, durable, or cluster.
 * Output: an opaque storage mode descriptor.
 * Transformation: keeps backend capability checks inside the VM storage lane.
 */
@target.vm {process_mailbox: true}
pub opaque type Mode.

/**
 * Policy represents one storage adapter policy.
 *
 * Input: adapter name, mode, and availability.
 * Output: an opaque storage policy descriptor.
 * Transformation: validates selected backend behavior without exposing backend
 * internals to Terlan source.
 */
@target.vm {process_mailbox: true}
pub opaque type Policy.

/**
 * Adapter represents one VM-owned storage backend instance.
 *
 * Input: validated storage policy.
 * Output: an opaque adapter descriptor.
 * Transformation: owns lifecycle state and backend access through the VM.
 */
@target.vm {process_mailbox: true}
pub opaque type Adapter.

/**
 * AtomicAppendProof represents an adapter's atomic append sequence boundary.
 *
 * Input: adapter capability state and current sequence.
 * Output: an opaque proof descriptor for append atomicity.
 * Transformation: lets conformance tests prove failed appends do not advance
 * the durable sequence boundary.
 */
@target.vm {process_mailbox: true}
pub opaque type AtomicAppendProof.

/**
 * SnapshotIsolationProof represents one validated isolated checkpoint view.
 *
 * Input: loaded checkpoint id, sequence, and checksum.
 * Output: an opaque proof descriptor for snapshot isolation.
 * Transformation: lets conformance tests prove later adapter mutations do not
 * rewrite an already issued checkpoint view.
 */
@target.vm {process_mailbox: true}
pub opaque type SnapshotIsolationProof.

/**
 * DurableFlushProof represents the last successfully flushed sequence.
 *
 * Input: adapter capability state and flush lifecycle.
 * Output: an opaque proof descriptor for durable flush progress.
 * Transformation: lets conformance tests prove failed or timed-out flushes do
 * not advance the durable replay boundary.
 */
@target.vm {process_mailbox: true}
pub opaque type DurableFlushProof.

/**
 * TransactionalBatchProof represents the last all-or-nothing batch commit.
 *
 * Input: adapter capability state and batch append lifecycle.
 * Output: an opaque proof descriptor for the last committed batch.
 * Transformation: lets conformance tests prove partial batch attempts do not
 * mutate adapter state or advance batch commit metadata.
 */
@target.vm {process_mailbox: true}
pub opaque type TransactionalBatchProof.

/**
 * SchemaMigrationProof represents the current adapter schema version.
 *
 * Input: adapter capability state and schema migration lifecycle.
 * Output: an opaque proof descriptor for schema version and storage sequence.
 * Transformation: lets conformance tests prove stale schema migrations do not
 * mutate adapter schema state or advance schema proof metadata.
 */
@target.vm {process_mailbox: true}
pub opaque type SchemaMigrationProof.

/**
 * ResourceHandleValidationProof represents the last validated handle set.
 *
 * Input: adapter capability state and resource handle validation lifecycle.
 * Output: an opaque proof descriptor for validated handle count and storage
 * sequence.
 * Transformation: lets conformance tests prove missing resource handles do not
 * advance validation proof metadata.
 */
@target.vm {process_mailbox: true}
pub opaque type ResourceHandleValidationProof.

/**
 * CompareAndSwapToken represents one observed adapter sequence.
 *
 * Input: adapter sequence observed before an append attempt.
 * Output: an opaque optimistic concurrency token.
 * Transformation: prevents stale writers from overwriting newer checkpoints
 * without exposing adapter internals.
 */
@target.vm {process_mailbox: true}
pub opaque type CompareAndSwapToken.

/**
 * Snapshot represents one deterministic storage checkpoint descriptor.
 *
 * Input: checkpoint id, sequence, and distributed state snapshot.
 * Output: an opaque storage snapshot descriptor.
 * Transformation: binds state snapshots to storage ordering and checksum
 * validation.
 */
@target.vm {process_mailbox: true}
pub opaque type Snapshot.

/**
 * Outcome represents one storage lifecycle result.
 *
 * Input: storage adapter operation.
 * Output: opened, appended, flushed, compacted, loaded, missing, closed,
 * unavailable, stale, checksum-mismatch, finalize-failed, flush-timed-out,
 * partial-write, or unsupported-operation descriptor.
 * Transformation: makes storage success and failure paths typed at the Terlan
 * boundary.
 */
@target.vm {process_mailbox: true}
pub opaque type Outcome.

/**
 * Builds the local-only storage mode.
 *
 * Input: no runtime input.
 * Output: local-only storage mode.
 * Transformation: selects force-local VM behavior for tests and development.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.local_only}
pub local_only(): Mode ->
    native.

/**
 * Builds the durable storage mode.
 *
 * Input: no runtime input.
 * Output: durable storage mode.
 * Transformation: selects persistence-backed behavior when an adapter is
 * available.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.durable}
pub durable(): Mode ->
    native.

/**
 * Builds the cluster storage mode.
 *
 * Input: no runtime input.
 * Output: cluster storage mode.
 * Transformation: selects replication-aware checkpoint behavior when a backend
 * supports it.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.cluster}
pub cluster(): Mode ->
    native.

/**
 * Builds the default force-local storage policy.
 *
 * Input: no runtime input.
 * Output: local-only available policy.
 * Transformation: creates bounded actor-owned volatile storage without a
 * filesystem binding. Separate adapters do not share state. Actor exit or VM
 * shutdown loses its data; this policy does not support durable-flush proofs.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.force_local}
pub force_local(): Policy ->
    native.

/**
 * Builds a storage policy descriptor.
 *
 * Input: policy name, backend mode, and a requested availability flag.
 * Output: storage policy descriptor.
 * Transformation: durable availability additionally requires a matching
 * supervisor-provided binding; source code cannot grant filesystem authority.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.policy}
pub policy(name: String, mode: Mode, available: Bool): Policy ->
    native.

/**
 * Returns the stable policy name.
 *
 * Input: storage policy descriptor.
 * Output: policy name text.
 * Transformation: exposes adapter selection identity without leaking backend
 * internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.policy_name}
pub policy_name(policy: Policy): String ->
    native.

/**
 * Returns the stable policy mode kind.
 *
 * Input: storage policy descriptor.
 * Output: mode kind text.
 * Transformation: exposes adapter mode selection without leaking backend
 * internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.policy_mode_kind}
pub policy_mode_kind(policy: Policy): String ->
    native.

/**
 * Returns whether the selected backend is available.
 *
 * Input: storage policy descriptor.
 * Output: `true` when the policy points at an available backend.
 * Transformation: exposes deterministic backend availability for validation
 * without opening the adapter.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.policy_available}
pub policy_available(policy: Policy): Bool ->
    native.

/**
 * Returns whether a policy can perform cluster replication.
 *
 * Input: storage policy descriptor.
 * Output: `false` in 0.0.9; no replication provider is supported.
 * Transformation: exposes deterministic capability checks before adapter
 * lifecycle calls.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.policy_can_cluster_replicate}
pub policy_can_cluster_replicate(policy: Policy): Bool ->
    native.

/**
 * Creates a storage adapter from a policy.
 *
 * Input: storage policy.
 * Output: closed adapter descriptor.
 * Transformation: binds lifecycle operations to one VM-owned backend policy.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.adapter}
pub adapter(policy: Policy): Adapter ->
    native.

/**
 * Returns the policy name attached to an adapter.
 *
 * Input: adapter receiver.
 * Output: policy name text.
 * Transformation: exposes adapter selection identity without exposing adapter
 * state or backend internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.adapter_policy_name}
pub (adapter: Adapter) policy_name(): String ->
    native.

/**
 * Returns the policy mode kind attached to an adapter.
 *
 * Input: adapter receiver.
 * Output: mode kind text.
 * Transformation: exposes adapter mode selection without exposing adapter
 * state or backend internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.adapter_policy_mode_kind}
pub (adapter: Adapter) policy_mode_kind(): String ->
    native.

/**
 * Returns whether an adapter's selected backend is available.
 *
 * Input: adapter receiver.
 * Output: `true` when the selected backend is available.
 * Transformation: exposes deterministic backend availability without probing
 * backend internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.adapter_policy_available}
pub (adapter: Adapter) policy_available(): Bool ->
    native.

/**
 * Returns whether an adapter can perform cluster replication.
 *
 * Input: adapter receiver.
 * Output: `false` in 0.0.9, including for configured durable adapters.
 * Transformation: exposes deterministic capability checks before
 * `require_cluster_replication`.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.can_cluster_replicate}
pub (adapter: Adapter) can_cluster_replicate(): Bool ->
    native.

/**
 * Builds a checkpoint descriptor from distributed state.
 *
 * Input: checkpoint id, non-zero sequence, and distributed state snapshot.
 * Output: storage snapshot descriptor.
 * Transformation: attaches deterministic storage metadata to a VM state
 * checkpoint.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.checkpoint}
pub checkpoint(
    checkpoint_id: String,
    sequence: Int,
    state: std.vm.DistributedState.Snapshot,
): Snapshot ->
    native.

/**
 * Restores checkpoint contents as a new actor-owned mutable state store.
 *
 * Input: an immutable logical checkpoint belonging to the calling actor.
 * Output: a new state store with the original scopes, versions, policies, and values.
 * Transformation: decodes the versioned, bounded representation and validates
 * the current image's atom vocabulary. This does not open a durable backend.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.restore}
pub (snapshot: Snapshot) restore(): std.vm.DistributedState.Store ->
    native.

/**
 * Builds a logical checkpoint with an explicit application schema version.
 *
 * Input: checkpoint identity, nonzero sequence, positive schema, and state.
 * Output: an immutable actor-owned storage checkpoint.
 * Transformation: tags the existing logical encoding without transforming
 * application data. The application owns schema meaning and migration; append
 * rejects tags that differ from the durable backend's current schema.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.checkpoint_with_schema}
pub checkpoint_with_schema(
    checkpoint_id: String,
    sequence: Int,
    schema: Int,
    state: std.vm.DistributedState.Snapshot,
): Snapshot ->
    native.

/**
 * Returns the application schema tag of a created or loaded checkpoint.
 *
 * Input: a checkpoint owned by the calling actor.
 * Output: its positive application schema version.
 * Transformation: lets callers select application-level restore handling
 * without conflating their schema with the VM's versioned logical encoding.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.checkpoint_schema}
pub checkpoint_schema(snapshot: Snapshot): Int ->
    native.

/**
 * Opens a storage adapter.
 *
 * Input: adapter receiver.
 * Output: lifecycle outcome descriptor.
 * Transformation: performs deterministic capability and availability checks.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.open}
pub (adapter: Adapter) open(): Outcome ->
    native.

/**
 * Appends a storage snapshot.
 *
 * Input: adapter receiver and snapshot descriptor.
 * Output: appended, partial-write, stale, unavailable, or unsupported outcome
 * descriptor.
 * Transformation: delegates write ordering and stale replay rejection to the VM
 * storage lane.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.append}
pub (adapter: Adapter) append(snapshot: Snapshot): Outcome ->
    native.

/**
 * Requires atomic append support.
 *
 * Input: adapter receiver.
 * Output: opened or unavailable outcome descriptor.
 * Transformation: exposes deterministic append capability checks before
 * writing checkpoints.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_atomic_append}
pub (adapter: Adapter) require_atomic_append(): Outcome ->
    native.

/**
 * Returns the current atomic append proof.
 *
 * Input: adapter receiver.
 * Output: atomic append proof descriptor.
 * Transformation: captures the sequence boundary that failed append attempts
 * must not advance.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.atomic_append_proof}
pub (adapter: Adapter) atomic_append_proof(): AtomicAppendProof ->
    native.

/**
 * Requires snapshot isolation support.
 *
 * Input: adapter receiver.
 * Output: opened or unavailable outcome descriptor.
 * Transformation: exposes deterministic snapshot isolation capability checks
 * before loading checkpoint views.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_snapshot_isolation}
pub (adapter: Adapter) require_snapshot_isolation(): Outcome ->
    native.

/**
 * Returns a snapshot isolation proof for a checkpoint.
 *
 * Input: adapter receiver and checkpoint id.
 * Output: snapshot isolation proof descriptor.
 * Transformation: validates and freezes one checkpoint view before later
 * adapter writes or compaction can occur.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.snapshot_isolation_proof}
pub (adapter: Adapter) snapshot_isolation_proof(checkpoint_id: String): SnapshotIsolationProof ->
    native.

/**
 * Requires durable flush proof support.
 *
 * Input: adapter receiver.
 * Output: opened, unavailable, or unsupported outcome descriptor.
 * Transformation: local-only adapters report unsupported. Durable adapters
 * expose fsync/equivalent durability
 * capability checks before accepting a durable boundary proof.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_durable_flush}
pub (adapter: Adapter) require_durable_flush(): Outcome ->
    native.

/**
 * Returns the current durable flush proof.
 *
 * Input: adapter receiver.
 * Output: durable flush proof descriptor.
 * Transformation: captures the flushed sequence boundary that failed or timed
 * out flush attempts must not advance. Local-only adapters fail explicitly
 * rather than issuing a persistence proof for volatile memory.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.durable_flush_proof}
pub (adapter: Adapter) durable_flush_proof(): DurableFlushProof ->
    native.

/**
 * Requires transactional batch append support.
 *
 * Input: adapter receiver.
 * Output: opened or unavailable outcome descriptor.
 * Transformation: exposes deterministic all-or-nothing batch capability checks
 * before accepting grouped checkpoint writes.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_transactional_batch}
pub (adapter: Adapter) require_transactional_batch(): Outcome ->
    native.

/**
 * Returns the current transactional batch proof.
 *
 * Input: adapter receiver.
 * Output: transactional batch proof descriptor.
 * Transformation: captures the last committed batch boundary that failed
 * partial batch attempts must not advance.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.transactional_batch_proof}
pub (adapter: Adapter) transactional_batch_proof(): TransactionalBatchProof ->
    native.

/**
 * Appends a group of snapshots as one all-or-nothing transaction.
 *
 * Input: adapter receiver and ordered snapshot descriptors.
 * Output: batch-appended, partial-write, stale, checksum-mismatch,
 * unavailable, or unsupported outcome descriptor.
 * Transformation: validates every checkpoint before mutating adapter state so
 * a partial batch cannot become actor-visible.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.transactional_batch_append}
pub (adapter: Adapter) transactional_batch_append(snapshots: List[Snapshot]): Outcome ->
    native.

/**
 * Requires schema migration support.
 *
 * Input: adapter receiver.
 * Output: opened or unavailable outcome descriptor.
 * Transformation: exposes deterministic schema migration capability checks
 * before accepting adapter schema changes.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_schema_migration}
pub (adapter: Adapter) require_schema_migration(): Outcome ->
    native.

/**
 * Returns the current schema migration proof.
 *
 * Input: adapter receiver.
 * Output: schema migration proof descriptor.
 * Transformation: captures the schema version and storage sequence that stale
 * migration attempts must not advance.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.schema_migration_proof}
pub (adapter: Adapter) schema_migration_proof(): SchemaMigrationProof ->
    native.

/**
 * Migrates the adapter schema when the expected version is current.
 *
 * Input: adapter receiver, expected current schema version, and next schema
 * version.
 * Output: schema-migrated or schema-migration-mismatch outcome descriptor.
 * Transformation: makes schema evolution explicit at the storage adapter
 * boundary instead of allowing hidden adapter-specific rewrites.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.migrate_schema}
pub (adapter: Adapter) migrate_schema(expected_schema: Int, next_schema: Int): Outcome ->
    native.

/**
 * Requires resource handle validation support.
 *
 * Input: adapter receiver.
 * Output: opened or unavailable outcome descriptor.
 * Transformation: requires an open adapter and supervisor-configured, identity-
 * pinned database resources. Unconfigured providers return unsupported; this
 * capability check does not itself validate a resource or confer authority.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_resource_handle_validation}
pub (adapter: Adapter) require_resource_handle_validation(): Outcome ->
    native.

/**
 * Returns the current resource handle validation proof.
 *
 * Input: adapter receiver.
 * Output: resource handle validation proof descriptor.
 * Transformation: captures the last validated handle count and storage
 * sequence that missing-handle failures must not advance.
 * Proofs are immutable historical observations, not leases or future liveness
 * guarantees. Unsupported or closed adapters cannot issue these proofs.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.resource_handle_validation_proof}
pub (adapter: Adapter) resource_handle_validation_proof(): ResourceHandleValidationProof ->
    native.

/**
 * Registers a supervisor-authorized resource name with the adapter.
 *
 * Input: adapter receiver and durable resource handle id.
 * Output: resource-handles-validated or resource-handle-validation-failed
 * outcome descriptor.
 * Transformation: db.NAME resolves only to the supervisor's identity-pinned
 * storage binding NAME. The VM asynchronously checks the real worker identity
 * before registering it. Unknown names cannot create authority. Registrations
 * are actor-local and must be re-established and checked after restart; strings
 * restored from a checkpoint never restore authority. Other providers are not
 * currently supported. Volatile adapters do not gain storage durability.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.register_resource_handle}
pub (adapter: Adapter) register_resource_handle(handle: String): Outcome ->
    native.

/**
 * Revalidates registered resource names against their authorized live workers.
 *
 * Input: adapter receiver and durable resource handle ids.
 * Output: resource-handles-validated or resource-handle-validation-failed
 * outcome descriptor.
 * Transformation: checks every resource identity again without blocking the
 * actor owner. At most 16 unique names are accepted; duplicate or oversized
 * lists are invalid. Empty validation succeeds with count zero. Failed checks
 * do not advance the previous proof. Observations are sequential, not an atomic
 * snapshot across resources, and all probes share one bounded deadline.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.validate_resource_handles}
pub (adapter: Adapter) validate_resource_handles(handles: List[String]): Outcome ->
    native.

/**
 * Requests storage snapshot replication, unsupported in 0.0.9.
 *
 * Input: adapter receiver and snapshot descriptor.
 * Output: an unsupported outcome descriptor, never a successful write receipt.
 * Transformation: validates actor-owned arguments and rejects replication
 * without mutating storage. No local append or alternative provider is silently
 * substituted. Rejection coverage is not replication capability coverage.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.replicate_snapshot}
pub (adapter: Adapter) replicate_snapshot(snapshot: Snapshot): Outcome ->
    native.

/**
 * Returns a compare-and-swap append token for the current sequence.
 *
 * Input: adapter receiver.
 * Output: compare-and-swap token descriptor.
 * Transformation: captures the adapter sequence that must still be current
 * before a guarded append can commit.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.compare_and_swap_token}
pub (adapter: Adapter) compare_and_swap_token(): CompareAndSwapToken ->
    native.

/**
 * Appends a storage snapshot if the compare-and-swap token is current.
 *
 * Input: adapter receiver, snapshot descriptor, and compare-and-swap token.
 * Output: appended, stale-token, partial-write, stale, unavailable, or
 * unsupported outcome descriptor.
 * Transformation: makes optimistic concurrency explicit at the storage adapter
 * boundary.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.compare_and_swap_append}
pub (adapter: Adapter) compare_and_swap_append(snapshot: Snapshot, token: CompareAndSwapToken): Outcome ->
    native.

/**
 * Flushes pending storage writes.
 *
 * Input: adapter receiver.
 * Output: flushed, finalize-failed, flush-timed-out, unavailable, or
 * unsupported outcome descriptor.
 * Transformation: durable adapters acknowledge the real storage flush;
 * local-only adapters establish an in-memory ordering barrier only.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.flush}
pub (adapter: Adapter) flush(): Outcome ->
    native.

/**
 * Compacts old storage snapshots.
 *
 * Input: adapter receiver and first sequence to retain.
 * Output: compacted, unavailable, or unsupported outcome descriptor.
 * Transformation: delegates deterministic retention to the VM storage lane.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.compact}
pub (adapter: Adapter) compact(retain_from_sequence: Int): Outcome ->
    native.

/**
 * Loads a checkpoint by id.
 *
 * Input: adapter receiver and checkpoint id.
 * Output: loaded, missing, unavailable, checksum-mismatch, or unsupported
 * outcome descriptor.
 * Transformation: validates checksum and backend capability before exposing the
 * loaded descriptor.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.load_snapshot}
pub (adapter: Adapter) load_snapshot(checkpoint_id: String): Outcome ->
    native.

/**
 * Closes a storage adapter.
 *
 * Input: adapter receiver.
 * Output: closed, unavailable, or unsupported outcome descriptor.
 * Transformation: makes adapter lifecycle shutdown explicit.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.close}
pub (adapter: Adapter) close(): Outcome ->
    native.

/**
 * Checks for cluster replication support, unsupported in 0.0.9.
 *
 * Input: adapter receiver.
 * Output: an unsupported outcome descriptor.
 * Transformation: rejects the unsupported capability regardless of a caller's
 * availability flag or whether a local durable backend has been configured.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.require_cluster_replication}
pub (adapter: Adapter) require_cluster_replication(): Outcome ->
    native.

/**
 * Returns the sequence boundary covered by an atomic append proof.
 *
 * Input: atomic append proof descriptor.
 * Output: observed adapter sequence.
 * Transformation: exposes atomic append conformance without exposing adapter
 * internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.proof_sequence}
pub proof_sequence(proof: AtomicAppendProof): Int ->
    native.

/**
 * Returns the checkpoint id covered by a snapshot isolation proof.
 *
 * Input: snapshot isolation proof descriptor.
 * Output: isolated checkpoint id.
 * Transformation: exposes stable snapshot identity without exposing adapter
 * internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.isolation_checkpoint_id}
pub isolation_checkpoint_id(proof: SnapshotIsolationProof): String ->
    native.

/**
 * Returns the sequence covered by a snapshot isolation proof.
 *
 * Input: snapshot isolation proof descriptor.
 * Output: isolated checkpoint sequence.
 * Transformation: exposes stable snapshot ordering without exposing adapter
 * internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.isolation_sequence}
pub isolation_sequence(proof: SnapshotIsolationProof): Int ->
    native.

/**
 * Returns the checksum covered by a snapshot isolation proof.
 *
 * Input: snapshot isolation proof descriptor.
 * Output: isolated checkpoint checksum.
 * Transformation: exposes stable snapshot integrity evidence without exposing
 * adapter internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.isolation_checksum}
pub isolation_checksum(proof: SnapshotIsolationProof): Int ->
    native.

/**
 * Returns the sequence covered by a durable flush proof.
 *
 * Input: durable flush proof descriptor.
 * Output: last successfully flushed sequence.
 * Transformation: exposes fsync/equivalent conformance without exposing
 * adapter internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.durable_flush_sequence}
pub durable_flush_sequence(proof: DurableFlushProof): Int ->
    native.

/**
 * Returns the first sequence covered by a transactional batch proof.
 *
 * Input: transactional batch proof descriptor.
 * Output: first sequence committed by the last batch.
 * Transformation: exposes all-or-nothing batch conformance without exposing
 * adapter internals.
 */
@target.vm {process_mailbox: true}
@compiler.native {std.vm.distributed_storage.batch_first_sequence}
pub batch_first_sequence(proof: TransactionalBatchProof): Int ->
