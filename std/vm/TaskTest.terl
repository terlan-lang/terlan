module std.vm.TaskTest.

import std.core.Result.
import std.core.Result.{Err, Ok}.
import std.test.Test.{assert_equal}.
import std.vm.Task.

import type std.core.{Error, Result}.
import type std.vm.Task.

pub work(): Int ->
    41 + 1.

pub read_task(task: Task[Int]): Result[Int, Error] ->
    task.result().

pub cancel_after_read(task: Task[Int]): Int ->
    let value =
        task
        |> result()
        |> Result.with_default(0);
    task.cancel();
    value.

@test
pub start_runs_work_and_result_returns_value(): Bool ->
    case Task.start(work) {
        Ok(task) -> assert_equal(42, Result.with_default(read_task(task), 0));
        Err(_reason) -> false
    }.

@test
pub cancel_returns_unit_after_result_is_available(): Bool ->
    case Task.start(work) {
        Ok(task) -> assert_equal(42, cancel_after_read(task));
        Err(_reason) -> false
    }.
