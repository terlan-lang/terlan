module std.vm.TaskTest.

import std.test.Test.{assert_equal}.
import std.vm.{Process, Task}.

import type std.vm.Process.
import type std.vm.Task.{Task, TaskCommand}.

pub work(): Int ->
    41 + 1.

pub spawn_41(): Unit ->
    Task.serve[Int](work()).

pub start_task(): Task[Int] ->
    let entry = Process.entry[TaskCommand[Int]](41);
    let process = Process.spawn[TaskCommand[Int]](entry);
    Task.start[Int](process, 0).

@test
pub result_returns_the_completed_value(): Bool ->
    let task = start_task();
    let value = Task.result[Int](task, 1);
    let _cancelled = Task.cancel[Int](task);
    assert_equal(42, value).

@test
pub repeated_results_are_correlated_before_cancel(): Bool ->
    let task = start_task();
    let first = Task.result[Int](task, 1);
    let second = Task.result[Int](task, 2);
    let _cancelled = Task.cancel[Int](task);
    assert_equal(42, first) and assert_equal(42, second).
