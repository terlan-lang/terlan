/**
 * Typed request servers implemented in Terlan over VM process primitives.
 */
module std.vm.GenServer.

import std.core.Unit.
import std.vm.Process.{ActorMessage}.
import std.vm.{Message, Process}.

import type std.core.Unit.

pub type GenServerCall.

pub type GenServerCast.

pub type GenServerStop.

pub type GenServerTag = Atom["gen_server"].

pub type GenServerCommandTag = Atom["gen_server_command"].

pub type GenServerReplyTag = Atom["gen_server_reply"].

pub type GenServerCallReplyTag = Atom["gen_server_call_reply"].

pub type GenServerCommandKind = GenServerCall | GenServerCast | GenServerStop.

/**
 * State and reply returned by a synchronous request handler.
 */
pub type CallReply[State, Value] = {Atom["gen_server_call_reply"], state: State, reply: Value}.

/**
 * One correlated reply sent from the server to a caller.
 */
pub type GenServerReply[Value] = {Atom["gen_server_reply"], request_id: Int, value: Value}.

/**
 * Calls, casts, and stop requests share one concrete value family so a server
 * has exactly one stable AOT mailbox layout.
 */
pub type GenServerCommand[Value] =
      {
          Atom["gen_server_command"],
          kind: GenServerCommandKind,
          request_id: Int,
          reply_to: std.vm.Process.Process[GenServerReply[Value]],
          value: Value
      }.

/**
 * Typed process handle plus a concrete AOT mailbox witness.
 */
pub type ServerRef[Value] =
      {
          Atom["gen_server"],
          process: std.vm.Process.Process[GenServerCommand[Value]],
          witness: Value
      }.

/**
 * Builds a source-owned service handle after initialization succeeds.
 *
 * The caller creates the statically known entry with `Process.spawn`; this
 * function owns only GenServer policy and never invokes framework magic.
 */
@target.vm {process_mailbox: true}
pub start[Value](
    process: std.vm.Process.Process[GenServerCommand[Value]],
    witness: Value,
): ServerRef[Value] ->
    make_ref[Value](process, witness).

/**
 * Converts a callback's initialization outcome into explicit service policy.
 */
pub init_succeeded(init_ok: Bool): Bool ->
    init_ok.

pub make_ref[Value](
    process: std.vm.Process.Process[GenServerCommand[Value]],
    witness: Value,
): ServerRef[Value] ->
    ServerRef(process, witness).

/**
 * Runs a replacement-policy server loop.
 *
 * Calls reply with the prior state and install their request as the next
 * state; casts install their value without replying; stop replies with the
 * final state and terminates. More elaborate policies compose this typed loop
 * from ordinary Terlan functions rather than VM framework opcodes.
 */
@target.vm {process_mailbox: true}
pub serve[Value](initial: Value): Unit ->
    serve_state[Value](initial).

/**
 * Performs a correlated synchronous request and discards stale replies.
 */
@target.vm {process_mailbox: true}
pub call[Value](server: ServerRef[Value], request_id: Int, request: Value): Value ->
    let reply_to = Process.current[GenServerReply[Value]]();
    case server {
        {GenServerTag, process, witness} ->
            let _sent =
                Process.send[GenServerCommand[Value]](
                    process,
                    Message.wrap[GenServerCommand[Value]](
                        GenServerCommand(GenServerCall, request_id, reply_to, request),
                    ),
                );
            await_reply[Value](request_id, witness)
    }.

/**
 * Queues an asynchronous state-changing event.
 */
@target.vm {process_mailbox: true}
pub cast[Value](server: ServerRef[Value], event: Value): Unit ->
    let reply_to = Process.current[GenServerReply[Value]]();
    case server {
        {GenServerTag, process, _witness} ->
            Process.send[GenServerCommand[Value]](
                process,
                Message.wrap[GenServerCommand[Value]](
                    GenServerCommand(GenServerCast, 0, reply_to, event),
                ),
            )
    }.

/**
 * Stops the loop and returns the value produced by its terminate callback.
 */
@target.vm {process_mailbox: true}
pub stop[Value](server: ServerRef[Value], request_id: Int): Value ->
    let reply_to = Process.current[GenServerReply[Value]]();
    case server {
        {GenServerTag, process, witness} ->
            let _sent =
                Process.send[GenServerCommand[Value]](
                    process,
                    Message.wrap[GenServerCommand[Value]](
                        GenServerCommand(GenServerStop, request_id, reply_to, witness),
                    ),
                );
            await_reply[Value](request_id, witness)
    }.

/**
 * Thin policy wrapper for VM-owned deterministic timers.
 */
@target.vm {process_mailbox: true}
pub timeout(ticks: Int): Unit ->
    Process.sleep(Process.timer(ticks)).

/**
 * Thin policy wrapper for VM-owned symmetric links.
 */
@target.vm {process_mailbox: true}
pub relate_peer[Value](server: ServerRef[Value]): Unit ->
    case server {
        {GenServerTag, process, _witness} -> Process.link[GenServerCommand[Value]](process)
    }.

/**
 * Establishes a VM-owned failure monitor; DOWN delivery remains VM policy.
 */
@target.vm {process_mailbox: true}
pub monitor[Value](server: ServerRef[Value]): Unit ->
    case server {
        {GenServerTag, process, _witness} ->
            let _monitor = Process.monitor[GenServerCommand[Value]](process);
            Unit
    }.

/**
 * Thin policy wrapper for VM-owned cancellation.
 */
@target.vm {process_mailbox: true}
pub cancel[Value](server: ServerRef[Value]): Unit ->
    case server {
        {GenServerTag, process, _witness} -> Process.cancel[GenServerCommand[Value]](process)
    }.

pub serve_state[Value](state: Value): Unit ->
    let message = Process.receive[GenServerCommand[Value]]();
    case Message.unwrap[GenServerCommand[Value]](message) {
        {GenServerCommandTag, kind, request_id, reply_to, value} ->
            if {
                kind == GenServerCall -> let _sent = send_reply[Value](reply_to, request_id, state);
                serve_state[Value](value);
                kind == GenServerCast -> serve_state[Value](value);
                true -> send_reply[Value](reply_to, request_id, state)
            }
    }.

pub send_reply[Value](
    reply_to: std.vm.Process.Process[GenServerReply[Value]],
    request_id: Int,
    reply: Value,
): Unit ->
    Process.send[GenServerReply[Value]](
        reply_to,
        Message.wrap[GenServerReply[Value]](GenServerReply(request_id, reply)),
    ).

pub await_reply[Value](request_id: Int, witness: Value): Value ->
    let message = Process.receive[GenServerReply[Value]]();
    case Message.unwrap[GenServerReply[Value]](message) {
        {GenServerReplyTag, received_id, reply} ->
            if {
                received_id == request_id -> reply;
                true -> await_reply[Value](request_id, witness)
            };
        _unexpected -> await_reply[Value](request_id, witness)
    }.
