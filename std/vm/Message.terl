/**
 * Terlan VM message contract.
 *
 * `std.vm.Message` models typed payloads that can cross runtime process
 * boundaries. It is a target-gated runtime contract and is not part of
 * portable `std.core`.
 */
module std.vm.Message.

import type std.core.Unit.

/**
 * Message represents one typed runtime process message.
 *
 * Input: type parameter `T`.
 * Output: an opaque message wrapper owned by the selected VM runtime.
 * Transformation: keeps source-level message payloads typed while the VM owns
 * the mailbox envelope and transfer metadata.
 */
@target.vm {process_mailbox: true}
pub opaque type Message[T].

/**
 * Wraps a source value as a typed VM message.
 *
 * Input: one payload value.
 * Output: a `Message[T]` carrying that payload.
 * Transformation: marks the payload for typed mailbox delivery without
 * exposing mailbox internals or requiring a source-visible allocation.
 */
@target.vm {process_mailbox: true}
pub wrap[T](value: T): Message[T] ->
    native.

/**
 * Reads a typed payload from a VM message.
 *
 * Input: one `Message[T]`.
 * Output: the original payload value.
 * Transformation: projects the payload after VM-owned receive logic has
 * selected and transferred the typed mailbox envelope.
 */
@target.vm {process_mailbox: true}
pub unwrap[T](message: Message[T]): T ->
    native.

/**
 * MessageCodec defines conversion between source values and runtime messages.
 *
 * Input: source payload type `T`.
 * Output: a trait requiring wrapping and unwrapping operations for `Message[T]`.
 * Transformation: gives VM adapters an ordinary trait surface for message
 * encoding without adding send/receive grammar to Terlan source.
 */
@target.vm {process_mailbox: true}
pub trait MessageCodec[T] {
    wrap(value: T): Message[T].
    unwrap(message: Message[T]): T.
}.
