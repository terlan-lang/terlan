/**
 * VM-owned debugger control surface.
 */
module std.vm.Debugger.

import type std.core.Unit.

/**
 * Stops the current actor at an AOT continuation boundary.
 *
 * The VM resumes this call with `Unit` after a debugger continue, step, next,
 * or finish command. Native code publishes only owned continuation state.
 */
@target.vm {process_mailbox: true}
pub debug(): Unit ->
    native.
