/**
 * Core finite integer range contract.
 *
 * `std.range.Range` represents portable finite `Int` ranges. Language sugar
 * such as `Int..Int` must lower to this public API instead of bypassing the
 * standard library.
 */
module std.range.Range.

import std.core.Result.{Err, Ok, Result}.

import type std.collections.{Iterator, List}.

/**
 * Range represents a finite integer range.
 *
 * Input: start value, stop value, non-zero step, and inclusive/exclusive stop
 * mode.
 * Output: a source-level range value.
 * Transformation: stores the range contract as ordinary Terlan data so VM
 * lowering, comprehensions, guards, and iterator conversion can share one
 * representation.
 */
pub struct Range {
    start: Int,
    stop: Int,
    step: Int,
    inclusive: Bool,
}.

/**
 * Constructs a range from explicit fields.
 *
 * Input: start value, stop value, non-zero step, and inclusive/exclusive stop
 * mode.
 * Output: a `Range` value.
 * Transformation: stores the supplied fields in the transparent range record.
 */
pub constructor Range {
    (start: Int, stop: Int, step: Int, inclusive: Bool): Range ->
        Range {start: start, stop: stop, step: step, inclusive: inclusive}
}.

/**
 * InvalidStep is returned when a range is requested with a zero step.
 */
pub type InvalidStep.

/**
 * RangeError is the typed error returned by checked range constructors.
 */
pub type RangeError = InvalidStep.

/**
 * Creates an inclusive range.
 *
 * Input: start and stop integer bounds.
 * Output: a range that includes `stop` when traversal reaches it.
 * Transformation: chooses `1` for ascending ranges and `-1` for descending
 * ranges.
 */
pub inclusive(start: Int, stop: Int): Range ->
    Range(start, stop, default_step(start, stop), true).

/**
 * Creates an exclusive range.
 *
 * Input: start and stop integer bounds.
 * Output: a range that stops before `stop`.
 * Transformation: chooses `1` for ascending ranges and `-1` for descending
 * ranges.
 */
pub exclusive(start: Int, stop: Int): Range ->
    Range(start, stop, default_step(start, stop), false).

/**
 * Creates a checked stepped range.
 *
 * Input: start and stop integer bounds, an explicit non-zero step, and
 * inclusive/exclusive stop mode.
 * Output: `Ok(range)` for valid steps or `Err(InvalidStep)` for zero.
 * Transformation: validates the step before exposing a range value.
 */
pub stepped(start: Int, stop: Int, step: Int, inclusive: Bool): Result[Range, RangeError] ->
    case step == 0 {
        true -> Err(InvalidStep);
        false -> Ok(Range(start, stop, step, inclusive))
    }.

/**
 * Returns whether a range contains a value.
 *
 * Input: one range and one integer value.
 * Output: `true` when the value is reached by repeatedly applying the range
 * step from `start`; otherwise `false`.
 * Transformation: checks bounds first, then performs bounded step alignment.
 */
pub contains(range: Range, value: Int): Bool ->
    case range.step == 0 {
        true -> false;
        false ->
            if {
                range.step > 0 -> contains_forward(range, value);
                true -> contains_backward(range, value)
            }
    }.

/**
 * Returns the number of values produced by a range.
 *
 * Input: one range.
 * Output: finite range length.
 * Transformation: counts by stepping from `start` until the configured stop
 * condition is reached.
 */
pub length(range: Range): Int ->
    case range.step == 0 {
        true -> 0;
        false -> count_values(range, range.start, 0)
    }.

/**
 * Returns whether a range produces no values.
 */
pub is_empty(range: Range): Bool ->
    length(range) == 0.

/**
 * Converts a range to a list of integers in traversal order.
 *
 * Input: one range.
 * Output: a `std.collections.List.List[Int]`.
 * Transformation: appends every generated value to a portable list.
 */
pub to_list(range: Range): List[Int] ->
    list_values(range, range.start).

/**
 * Returns an iterator over a range.
 *
 * Input: one range.
 * Output: an iterator over the range values.
 * Transformation: delegates through `to_list().iterator()` until the VM owns
 * a direct range iterator lowering path.
 */
pub iterator(range: Range): std.collections.Iterator.Iterator[Int] ->
    to_list(range).iterator().

default_step(start: Int, stop: Int): Int ->
    if {
        start <= stop -> 1;
        true -> -1
    }.

contains_forward(range: Range, value: Int): Bool ->
    if {
        value < range.start -> false;
        after_forward(range, value) -> false;
        true -> aligned_forward(range.start, value, range.step)
    }.

contains_backward(range: Range, value: Int): Bool ->
    if {
        value > range.start -> false;
        after_backward(range, value) -> false;
        true -> aligned_backward(range.start, value, range.step)
    }.

aligned_forward(current: Int, target: Int, step: Int): Bool ->
    if {
        current == target -> true;
        current > target -> false;
        true -> aligned_forward(current + step, target, step)
    }.

aligned_backward(current: Int, target: Int, step: Int): Bool ->
    if {
        current == target -> true;
        current < target -> false;
        true -> aligned_backward(current + step, target, step)
    }.

count_values(range: Range, current: Int, count: Int): Int ->
    if {
        after_stop(range, current) -> count;
        true -> count_values(range, current + range.step, count + 1)
    }.

list_values(range: Range, current: Int): List[Int] ->
    if {
        after_stop(range, current) -> [];
        true -> [current | list_values(range, current + range.step)]
    }.

after_stop(range: Range, value: Int): Bool ->
    if {
        range.step > 0 -> after_forward(range, value);
        true -> after_backward(range, value)
    }.

after_forward(range: Range, value: Int): Bool ->
    if {
        range.inclusive -> value > range.stop;
        true -> value >= range.stop
    }.

after_backward(range: Range, value: Int): Bool ->
    if {
        range.inclusive -> value < range.stop;
        true -> value <= range.stop
    }.
