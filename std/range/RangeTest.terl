module std.range.RangeTest.

import std.collections.Iterator.{next}.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.range.Range.{InvalidStep, contains, exclusive, inclusive, is_empty, iterator, length, stepped, to_list}.
import std.test.Test.{assert, assert_equal}.

import type std.range.Range.

@test
pub inclusive_range_contains_bounds(): Bool ->
    let range = inclusive(1, 3);
    assert(contains(range, 1));
    assert(contains(range, 2));
    assert(contains(range, 3)).

@test
pub exclusive_range_excludes_stop(): Bool ->
    let range = exclusive(1, 3);
    assert(contains(range, 1));
    assert(contains(range, 2));
    assert_equal(false, contains(range, 3)).

@test
pub descending_exclusive_range_excludes_stop(): Bool ->
    let range = exclusive(3, 1);
    assert(contains(range, 3));
    assert(contains(range, 2));
    assert_equal(false, contains(range, 1)).

@test
pub stepped_range_skips_unaligned_values(): Bool ->
    case stepped(1, 7, 2, true) {
        Ok(range) -> stepped_range_skips_unaligned_values_impl(range);
        Err(_reason) -> false
    }.

stepped_range_skips_unaligned_values_impl(range: Range): Bool ->
    let _contains = assert(contains(range, 5));
    assert_equal(false, contains(range, 6)).

@test
pub descending_range_contains_descending_values(): Bool ->
    let range = inclusive(3, 1);
    assert(contains(range, 3));
    assert(contains(range, 2));
    assert(contains(range, 1)).

@test
pub empty_exclusive_range_has_zero_length(): Bool ->
    let range = exclusive(1, 1);
    assert_equal(0, length(range)).

@test
pub singleton_inclusive_range_materializes_one_value(): Bool ->
    let range = inclusive(4, 4);
    assert(contains(range, 4));
    assert_equal(false, is_empty(range));
    assert_equal(1, length(range));
    assert_equal([4], to_list(range)).

@test
pub length_counts_inclusive_and_stepped_values(): Bool ->
    case stepped(1, 7, 2, true) {
        Ok(range) -> assert_equal(4, length(range));
        Err(_reason) -> false
    }.

@test
pub stepped_range_overshoot_excludes_unreached_inclusive_stop(): Bool ->
    case stepped(1, 10, 4, true) {
        Ok(range) ->
            assert_equal([1, 5, 9], to_list(range)) and assert_equal(false, contains(range, 10)) and assert_equal(3, length(range));
        Err(_reason) -> false
    }.

@test
pub descending_stepped_range_materializes_in_order(): Bool ->
    case stepped(7, 1, -2, false) {
        Ok(range) -> assert_equal([7, 5, 3], to_list(range));
        Err(_reason) -> false
    }.

@test
pub step_direction_that_cannot_reach_stop_is_empty(): Bool ->
    case stepped(1, 3, -1, true) {
        Ok(range) -> step_direction_that_cannot_reach_stop_is_empty_impl(range);
        Err(_reason) -> false
    }.

step_direction_that_cannot_reach_stop_is_empty_impl(range: Range): Bool ->
    let empty = assert(is_empty(range));
    empty and assert_equal(0, to_list(range).length()).

@test
pub invalid_step_is_typed_error(): Bool ->
    case stepped(1, 3, 0, true) {
        Err(reason) -> assert_equal(InvalidStep, reason);
        Ok(_range) -> false
    }.

@test
pub to_list_materializes_range_values_in_order(): Bool ->
    let range = inclusive(1, 2);
    assert_equal([1, 2], to_list(range)).

@test
pub range_sugar_supports_ascending_membership(): Bool ->
    assert(2 in 1 .. 3).

@test
pub range_sugar_supports_descending_membership(): Bool ->
    assert(2 in 3 .. 1).

@test
pub range_sugar_constructs_public_range_value(): Bool ->
    assert_equal(inclusive(1, 3), 1 .. 3).

@test
pub range_sugar_feeds_list_comprehension(): Bool ->
    assert_equal([2, 3, 4], [value + 1 | value <- 1 .. 3]).

@test
pub range_sugar_works_inside_guard(): Bool ->
    case 204 {
        status where status in 200 .. 299 -> true;
        _ -> false
    }.

@test
pub range_sugar_supports_direct_iterator_traversal(): Bool ->
    let iterator = iterator(1 .. 2);
    case next(iterator) {
        Some({value: first, next: rest}) ->
            case next(rest) {
                Some({value: second, next: _done}) -> assert_equal(3, first + second);
                None -> false
            };
        None -> false
    }.
