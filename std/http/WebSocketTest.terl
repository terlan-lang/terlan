module std.http.WebSocketTest.

import std.http.WebSocket.

import type std.http.WebSocket.{Endpoint, Frame}.

pub accepts_frame(value: Frame): Frame ->
    value.

pub accepts_endpoint(value: Endpoint): Endpoint ->
    value.

pub text_frame(): Frame ->
    WebSocket.text("hello").

pub heartbeat_frames(): Frame ->
    let _ping = WebSocket.ping("hb");
    WebSocket.pong("hb").

pub close_frame(): Frame ->
    WebSocket.close().

pub bounded_endpoint(): Endpoint ->
    WebSocket.endpoint(16, 4096).

@test
pub websocket_text_records_typed_descriptor(): Bool -> true.

@test
pub websocket_control_records_close_descriptor(): Bool -> true.

@test
pub websocket_control_records_ping_and_pong_descriptors(): Bool -> true.

@test
pub websocket_endpoint_records_channel_limits(): Bool -> true.
