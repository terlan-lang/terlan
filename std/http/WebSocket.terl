/**
 * Portable WebSocket channel contract.
 *
 * `std.http.WebSocket` exposes typed frame and endpoint builders for
 * VM-owned WebSocket channels. The runtime owns socket lifecycle, frame
 * parsing, backpressure, cancellation, and handler scheduling.
 */
module std.http.WebSocket.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.http.WebSocketIdentity.

import type std.collections.List.
import type std.core.{Option, Result}.

/**
 * TextFrame carries one outbound WebSocket text payload.
 *
 * Input: typed text or control-frame metadata.
 * Output: a source-owned tagged text-frame value.
 * Transformation: hides raw WebSocket frame bytes while preserving typed
 * handler code without allocating a connection or native resource.
 */
pub type TextFrame = {Atom["text"], value: String}.

/**
 * PingFrame carries an outbound heartbeat payload.
 *
 * Input: one UTF-8 payload.
 * Output: a source-owned tagged control-frame value.
 * Transformation: records intent; transport admission validates byte limits.
 */
pub type PingFrame = {Atom["ping"], value: String}.

/**
 * PongFrame carries an outbound heartbeat response.
 *
 * Input: one UTF-8 payload.
 * Output: a source-owned tagged control-frame value.
 * Transformation: preserves payload bytes without performing socket I/O.
 */
pub type PongFrame = {Atom["pong"], value: String}.

/**
 * CloseFrame represents a request to close the channel.
 *
 * Input: none.
 * Output: a singleton close intent.
 * Transformation: separates close intent from transport lifecycle execution.
 */
pub type CloseFrame = Atom["close"].

/**
 * Frame is an outbound text or control-frame intent.
 *
 * Input: a text, ping, pong, or close value.
 * Output: a source-owned discriminated union.
 * Transformation: permits ordinary pattern matching without native handles.
 */
pub type Frame = TextFrame | PingFrame | PongFrame | CloseFrame.

/**
 * Endpoint represents one WebSocket route policy.
 *
 * Input: inbound queue and frame-size settings.
 * Output: a source-owned endpoint policy validated when a route is admitted.
 * Transformation: keeps live connection state out of source values while
 * allowing route declarations to install explicit WebSocket limits.
 */
pub struct Endpoint {
    max_pending_frames: Int,
    max_frame_bytes: Int,
    #policies: List[Policy],
}.

type Callbacks =
      {
          Atom["callbacks"],
          open: () -> Unit,
          inbound: (String) -> Unit,
          writable: () -> Unit,
          close: () -> Unit,
          cancellation: (String) -> Unit
      }.

type Pairing =
      {
          Atom["pairing"],
          waiting: String,
          first_matched: String,
          second_matched: String,
          peer_left: String,
          inbound: (String) -> String,
          cancellation: (String) -> Unit
      }.

type StatefulInbound = (String, Int, String, String, String) -> {String, Option[String], Option[String]}.

delivery(payload: String): Option[String] ->
    case payload {
        "" -> None;
        _ -> Some(payload)
    }.

stateful_delivery(
    inbound: (String, Int, String, String, String) -> {String, String, String},
): StatefulInbound ->
    (state: String, role: Int, frame: String, first: String, second: String) ->
        let {next, first_payload, second_payload} = inbound(state, role, frame, first, second);
        {next, delivery(first_payload), delivery(second_payload)}.

type Matched = (String, Int, String, String) -> String.

type Restored = (String, String, Int, String, String) -> String.

type StatefulPairing =
      {
          Atom["stateful_pairing"],
          waiting: String,
          first_matched: String,
          second_matched: String,
          peer_left: String,
          inbound: StatefulInbound,
          cancellation: (String) -> Unit
      }.

type RestorablePairing =
      {
          Atom["restorable_pairing"],
          waiting: () -> String,
          peer_left: () -> String,
          identity: (String) -> Result[Option[{String, Int}], String],
          room_prefix: String,
          retention_ms: Int,
          retained_room_capacity: Int,
          matched: Matched,
          restored: Restored,
          inbound: StatefulInbound,
          cancellation: (String) -> Unit
      }.

type Policy = Callbacks | Pairing | StatefulPairing | RestorablePairing.

append_policy(endpoint: Endpoint, policy: Policy): Endpoint ->
    Endpoint {
        max_pending_frames: endpoint.max_pending_frames,
        max_frame_bytes: endpoint.max_frame_bytes,
        #policies: List.concat(endpoint.#policies, [policy]),
    }.

/**
 * Installs the complete generated callback set for an endpoint.
 *
 * Input: one endpoint and source callbacks for open, inbound frame, writable,
 * graceful close, and cancellation lifecycle events.
 * Output: the endpoint with one callback set attached.
 * Transformation: retains callbacks as ordinary source values without invoking
 * them. Duplicate/conflicting declarations remain visible to route admission.
 */
pub (endpoint: Endpoint) callbacks(
    open: () -> Unit,
    inbound: (String) -> Unit,
    writable: () -> Unit,
    close: () -> Unit,
    cancellation: (String) -> Unit,
): Endpoint ->
    append_policy(endpoint, Callbacks(open, inbound, writable, close, cancellation)).

/**
 * Installs a two-peer session policy with source-owned protocol payloads.
 *
 * The runtime queues the waiting payload for the first peer, delivers the two
 * role-specific match payloads when a second peer arrives, broadcasts each
 * inbound callback result to the pair, and notifies the remaining peer when a
 * connection closes.
 */
pub (endpoint: Endpoint) paired_callbacks(
    waiting: String,
    first_matched: String,
    second_matched: String,
    peer_left: String,
    inbound: (String) -> String,
    cancellation: (String) -> Unit,
): Endpoint ->
    append_policy(
        endpoint,
        Pairing(waiting, first_matched, second_matched, peer_left, inbound, cancellation),
    ).

/**
 * Installs a stateful two-peer session policy.
 *
 * The runtime retains the callback's opaque state string for the lifetime of
 * the pair and serializes transitions from both peers. The callback receives
 * the previous state, the sender role (`1` or `2`), the inbound frame, and the
 * two original HTTP request targets. It returns the next state followed by
 * independently addressed payloads for the first and second peer.
 * An empty payload suppresses delivery to that peer. This source adapter
 * translates that convention into explicit optional transport payloads.
 */
pub (endpoint: Endpoint) stateful_paired_callbacks(
    waiting: String,
    first_matched: String,
    second_matched: String,
    peer_left: String,
    inbound: (String, Int, String, String, String) -> {String, String, String},
    cancellation: (String) -> Unit,
): Endpoint ->
    append_policy(
        endpoint,
        StatefulPairing(
            waiting,
            first_matched,
            second_matched,
            peer_left,
            stateful_delivery(inbound),
            cancellation,
        ),
    ).

/**
 * Installs a restorable stateful two-peer session policy.
 *
 * Fresh pairs receive a runtime-allocated room identifier formed from the
 * source-owned prefix and a monotonic sequence. The matched callback creates
 * each role's entry payload. A later request carrying the declared room and
 * player query parameters can reclaim a disconnected seat; the restored
 * callback receives the retained opaque state and creates its current view.
 * Fully disconnected rooms remain reclaimable for `retention_ms`, with the
 * oldest disconnected room evicted when `retained_room_capacity` is exceeded.
 */
pub (endpoint: Endpoint) restorable_stateful_paired_callbacks(
    waiting: () -> String,
    peer_left: () -> String,
    room_query: String,
    player_query: String,
    room_prefix: String,
    first_player: String,
    second_player: String,
    retention_ms: Int,
    retained_room_capacity: Int,
    matched: (String, Int, String, String) -> String,
    restored: (String, String, Int, String, String) -> String,
    inbound: (String, Int, String, String, String) -> {String, String, String},
    cancellation: (String) -> Unit,
): Endpoint ->
    append_policy(
        endpoint,
        RestorablePairing(
            waiting,
            peer_left,
            (target: String) ->
                WebSocketIdentity.resolve(
                    target,
                    room_query,
                    player_query,
                    first_player,
                    second_player,
                ),
            room_prefix,
            retention_ms,
            retained_room_capacity,
            matched,
            restored,
            stateful_delivery(inbound),
            cancellation,
        ),
    ).

/**
 * Creates an outbound text frame.
 *
 * Input: one UTF-8 text payload.
 * Output: a `Frame` with text payload semantics.
 * Transformation: constructs the ordinary TextFrame variant without encoding wire bytes.
 */
pub text(value: String): Frame ->
    TextFrame(value).

/**
 * Creates an outbound ping control frame.
 *
 * Input: one UTF-8 ping payload.
 * Output: a `Frame` with ping control semantics.
 * Transformation: records typed ping intent while the VM runtime owns wire
 * encoding and payload-size validation.
 */
pub ping(value: String): Frame ->
    PingFrame(value).

/**
 * Creates an outbound pong control frame.
 *
 * Input: one UTF-8 pong payload.
 * Output: a `Frame` with pong control semantics.
 * Transformation: records typed pong intent for heartbeat handlers without
 * exposing protocol bytes.
 */
pub pong(value: String): Frame ->
    PongFrame(value).

/**
 * Creates an outbound close control frame.
 *
 * Input: none.
 * Output: a `Frame` with close control semantics.
 * Transformation: records deterministic close intent while stream shutdown and
 * cleanup remain VM-owned runtime behavior.
 */
pub close(): Frame ->
    CloseFrame.

/**
 * Creates a WebSocket endpoint plan.
 *
 * Input: maximum pending inbound frame count and maximum accepted frame bytes.
 * Output: an `Endpoint` plan for router lowering.
 * Transformation: records explicit channel bounds for the VM HTTP runtime
 * without allocating a live socket at source evaluation time.
 */
pub endpoint(max_pending_frames: Int = 128, max_frame_bytes: Int = 65536): Endpoint ->
    Endpoint {
        max_pending_frames: max_pending_frames,
        max_frame_bytes: max_frame_bytes,
        #policies: [],
    }.
