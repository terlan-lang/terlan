/**
 * Portable HTTP router contract.
 *
 * `std.http.Router` defines the source-level route builder used by Terlan web
 * applications. Ordinary source functions build an immutable declaration
 * sequence without opening transports. Handlers accept `Request` and return
 * `Response`. Serving executes `router/0` once per admitted image generation;
 * the HTTP package validates its returned declarations and callbacks.
 */
module std.http.Router.

import std.collections.List.
import std.core.String.
import std.http.Error.

import type std.collections.List.
import type std.http.Error.HttpError.
import type std.http.{Request, Response}.

/**
 * Router represents an HTTP route table.
 *
 * Input: no type parameter.
 * Output: an immutable route builder with private declaration storage.
 * Transformation: retains callbacks and nested scopes without opening sockets
 * or depending on compiler interpretation of builder names.
 */
pub struct Router {
    #entries: List[Entry],
}.

struct RequestPipeline {
    #callbacks: List[Middleware],
    #execute: List[Middleware],
}.

struct ResponsePipeline {
    #callbacks: List[ResponseMiddleware],
    #execute: List[ResponseMiddleware],
}.

type RouteEntry =
      {
          Atom["route"],
          method: String,
          path: String,
          handler: Handler,
          middleware: RequestPipeline,
          response_middleware: ResponsePipeline
      }.

type SseEntry =
      {
          Atom["sse"],
          path: String,
          endpoint: SseEndpoint,
          middleware: RequestPipeline,
          response_middleware: ResponsePipeline
      }.

type WebSocketEntry =
      {
          Atom["websocket"],
          path: String,
          endpoint: WebSocketEndpoint,
          middleware: RequestPipeline,
          response_middleware: ResponsePipeline
      }.

type MiddlewareEntry = {Atom["middleware"], callback: Middleware}.

type ResponseMiddlewareEntry = {Atom["response_middleware"], callback: ResponseMiddleware}.

type FallbackEntry =
      {
          Atom["fallback"],
          callback: Handler,
          middleware: RequestPipeline,
          response_middleware: ResponsePipeline
      }.

type ErrorEntry = {Atom["error"], callback: (String) -> Response}.

type OverloadEntry = {Atom["overload"], policy: OverloadPolicy, max_pending: Int}.

type LifecycleEntry = {Atom["lifecycle"], callback: LifecycleMiddleware}.

type GroupStartEntry.

type GroupEndEntry.

type Entry =
      RouteEntry
    | SseEntry
    | WebSocketEntry
    | MiddlewareEntry
    | ResponseMiddlewareEntry
    | FallbackEntry
    | ErrorEntry
    | OverloadEntry
    | LifecycleEntry
    | GroupStartEntry
    | GroupEndEntry.

append_entry(router: Router, entry: Entry): Router ->
    Router {#entries: List.concat(router.#entries, [entry])}.

append_target(router: Router, entry: Entry): Router ->
    append_entry(
        router,
        scope_entry(
            entry,
            group_middleware(router.#entries, 0),
            group_response_middleware(router.#entries, 0),
            0,
            0,
        ),
    ).

/**
 * OverloadPolicy selects the VM action when a router's pending-work bound is
 * reached.
 *
 * Input: no direct runtime input.
 * Output: one of `queue`, `reject`, or `spill`.
 * Transformation: keeps overload behavior explicit and closed to unsupported
 * policy atoms before the VM admission layer consumes the router descriptor.
 */
pub type OverloadPolicy = Atom["queue"] | Atom["reject"] | Atom["spill"].

/**
 * LifecycleRequestOutcome describes one completed VM HTTP request.
 *
 * Input: no direct runtime input.
 * Output: a successful status or a typed handler error message.
 * Transformation: keeps request completion observable without exposing host
 * server response objects or scheduler state.
 */
pub type LifecycleRequestOutcome =
      {Atom["response"], status: Int}
    | {Atom["error"], message: String}.

/**
 * LifecycleExitReason describes why a VM HTTP channel stopped.
 *
 * Input: no direct runtime input.
 * Output: the closed VM process-exit reason domain.
 * Transformation: preserves cleanup diagnostics without exposing runtime
 * implementation types.
 */
pub type LifecycleExitReason =
      Atom["normal"]
    | Atom["killed"]
    | {Atom["error"], message: String}
    | {Atom["shutdown_timeout"], timeout_ms: Int}
    | {Atom["memory_limit_exceeded"], requested_bytes: Int, previous_bytes: Int, projected_bytes: Int}.

/**
 * LifecycleEvent is the closed source-visible VM HTTP transition domain.
 *
 * Input: no direct runtime input.
 * Output: one worker, request, channel, or shutdown transition.
 * Transformation: exposes capabilities-only lifecycle metadata while keeping
 * process and stream handles opaque numeric identities.
 */
pub type LifecycleEvent =
      {Atom["worker_start"], process: Int}
    | {Atom["request_start"], process: Int, method: String, path: String}
    | {Atom["request_end"], process: Int, method: String, path: String, outcome: LifecycleRequestOutcome}
    | {Atom["channel_bind"], process: Int, stream: Int}
    | {Atom["channel_unbind"], process: Int, stream: Int, reason: LifecycleExitReason}
    | {Atom["shutdown_handoff"], mode: Atom["drain"] | Atom["immediate"], active_handlers: Int}.

/**
 * Allows one policy-sensitive lifecycle transition.
 *
 * Input: no payload.
 * Output: the singleton `lifecycle_allow` decision.
 * Transformation: authorizes the current transition without changing it.
 */
pub type LifecycleAllow.

/**
 * Rejects one policy-sensitive lifecycle transition with a stable reason.
 *
 * Input: one source-owned diagnostic reason.
 * Output: a tagged rejection decision.
 * Transformation: stops policy-sensitive work before it owns runtime state.
 */
pub type LifecycleReject = {Atom["reject"], reason: String}.

/**
 * Result returned by source lifecycle middleware.
 *
 * Input: no direct runtime input.
 * Output: either allow or reject.
 * Transformation: closes the policy result domain to explicit decisions.
 */
pub type LifecycleDecision = LifecycleAllow | LifecycleReject.

/**
 * Callback invoked once for every VM HTTP lifecycle transition.
 *
 * Input: one typed lifecycle event.
 * Output: one lifecycle decision.
 * Transformation: lets source policy observe transitions without scheduler
 * access.
 */
pub type LifecycleMiddleware = (LifecycleEvent) -> LifecycleDecision.

/**
 * Handler represents one HTTP route handler.
 *
 * Input: one `Request`.
 * Output: one `Response`.
 * Transformation: gives route declarations a single reusable function type so
 * the compiler can validate handler arity and return type.
 */
pub type Handler = (Request) -> Response.

/**
 * Continue advances HTTP dispatch to the next middleware or route handler.
 *
 * Input: no runtime input.
 * Output: the singleton continuation result.
 * Transformation: makes middleware continuation explicit instead of inferring
 * it from an ordinary response value.
 */
pub type Continue.

/**
 * Respond terminates HTTP dispatch with one typed response.
 *
 * Input: one `Response`.
 * Output: a tagged middleware result containing that response.
 * Transformation: gives authorization, recovery, and timeout middleware a
 * typed short-circuit path.
 */
pub type Respond = {Atom["respond"], response: Response}.

/**
 * MiddlewareResult is the complete result domain for HTTP middleware.
 *
 * Input: no direct runtime input.
 * Output: either `Continue` or `Respond(Response)`.
 * Transformation: prevents middleware from accidentally treating an ordinary
 * response as continuation state.
 */
pub type MiddlewareResult = Continue | Respond.

/**
 * Middleware represents one router middleware callback.
 *
 * Input: one `Request`.
 * Output: one explicit `MiddlewareResult`.
 * Transformation: gives middleware registration a typed callback shape with
 * deterministic continuation and short-circuit semantics.
 */
pub type Middleware = (Request) -> MiddlewareResult.

/**
 * ResponseMiddleware represents one router response callback.
 *
 * Input: the original `Request` and the current typed `Response`.
 * Output: the response passed to the next outer response middleware.
 * Transformation: supports deterministic post-processing without exposing
 * transport buffers or weakening the typed response contract.
 */
pub type ResponseMiddleware = (Request, Response) -> Response.

/**
 * ErrorHandler represents one router-level error handler.
 *
 * Input: one `HttpError`.
 * Output: one `Response`.
 * Transformation: gives development and production error rendering a typed
 * callback shape without exposing backend panic, bridge, or server internals.
 */
pub type ErrorHandler = (HttpError) -> Response.

/**
 * GroupBuilder configures a nested router scope.
 *
 * Input: one scoped `Router`.
 * Output: the configured scoped `Router`.
 * Transformation: represents route-group composition as an ordinary typed
 * function value instead of special route-block syntax.
 */
pub type GroupBuilder = (Router) -> Router.

/**
 * WebSocketEndpoint represents one VM-owned WebSocket endpoint plan.
 *
 * Input: a bounded endpoint plan from `std.http.WebSocket`.
 * Output: an opaque endpoint value accepted by `Router.websocket`.
 * Transformation: keeps router declarations independent from concrete socket
 * state while preserving explicit channel endpoint typing.
 */
pub type WebSocketEndpoint = std.http.WebSocket.Endpoint.

/**
 * SseEndpoint represents one VM-owned server-sent event endpoint plan.
 *
 * Input: a bounded endpoint plan from `std.http.Sse`.
 * Output: an opaque endpoint value accepted by `Router.sse`.
 * Transformation: keeps router declarations independent from concrete stream
 * state while preserving explicit channel endpoint typing.
 */
pub type SseEndpoint = std.http.Sse.Endpoint.

/**
 * ChannelEndpoint represents any VM-owned long-lived HTTP channel endpoint.
 *
 * Input: a route endpoint plan from a channel module such as
 * `std.http.WebSocket` or `std.http.Sse`.
 * Output: an opaque endpoint value accepted by channel-aware router helpers.
 * Transformation: documents the shared channel category without erasing the
 * stricter `websocket` and `sse` function signatures.
 */
pub type ChannelEndpoint = WebSocketEndpoint | SseEndpoint.

/**
 * Creates an empty router.
 *
 * Input: no value input.
 * Output: an empty `Router`.
 * Transformation: creates an ordinary source value without allocating any live
 * transport or scheduler state.
 */
pub new(): Router ->
    Router {#entries: []}.

/**
 * Adds a `GET` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) get(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("GET", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a `POST` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) post(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("POST", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a `PUT` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) put(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("PUT", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a `PATCH` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) patch(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("PATCH", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a `DELETE` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) delete(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("DELETE", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a `HEAD` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) head(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("HEAD", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds an `OPTIONS` route.
 *
 * Input: one `Router`, one route pattern, and one handler.
 * Output: the updated `Router`.
 * Transformation: appends a typed route declaration without mutating the earlier
 * router value.
 */
pub (router: Router) options(pattern: String, handler: Handler): Router ->
    append_target(
        router,
        RouteEntry("OPTIONS", pattern, handler, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a WebSocket channel route.
 *
 * Input: one `Router`, one route pattern, and one bounded channel endpoint
 * plan.
 * Output: the updated `Router`.
 * Transformation: appends a typed channel declaration while the serving runtime
 * owns upgrade, frame, and session state.
 */
pub (router: Router) websocket(pattern: String, endpoint: WebSocketEndpoint): Router ->
    append_target(
        router,
        WebSocketEntry(pattern, endpoint, request_pipeline([]), response_pipeline([])),
    ).

/**
 * Adds a server-sent event channel route.
 *
 * Input: one `Router`, one route pattern, and one bounded SSE endpoint plan.
 * Output: the updated `Router`.
 * Transformation: appends a typed channel declaration while the serving runtime
 * owns event-stream state and scheduling.
 */
pub (router: Router) sse(pattern: String, endpoint: SseEndpoint): Router ->
    append_target(router, SseEntry(pattern, endpoint, request_pipeline([]), response_pipeline([]))).

/**
 * Adds middleware to a router scope.
 *
 * Input: one `Router` and one middleware callback.
 * Output: the updated `Router`.
 * Transformation: retains a callback in declaration order for serving-boundary
 * admission.
 */
pub (router: Router) use(middleware: Middleware): Router ->
    let offset = List.length(group_middleware(router.#entries, 0));
    let entries = [scope_entry(entry, [middleware], [], offset, 0) | entry <- router.#entries];
    append_entry(Router {#entries: entries}, MiddlewareEntry(middleware)).

/**
 * Adds response middleware to a router scope.
 *
 * Input: one `Router` and one response middleware callback.
 * Output: the updated `Router`.
 * Transformation: records post-processing that unwinds in reverse declaration
 * order after a handler or short-circuit response is produced.
 */
pub (router: Router) map_response(middleware: ResponseMiddleware): Router ->
    let offset = List.length(group_response_middleware(router.#entries, 0));
    let entries = [scope_entry(entry, [], [middleware], 0, offset) | entry <- router.#entries];
    append_entry(Router {#entries: entries}, ResponseMiddlewareEntry(middleware)).

/**
 * Adds a fallback route.
 *
 * Input: one `Router` and one handler.
 * Output: the updated `Router`.
 * Transformation: records the catch-all handler used when no method-specific
 * route matches the request.
 */
pub (router: Router) fallback(handler: Handler): Router ->
    append_target(router, FallbackEntry(handler, request_pipeline([]), response_pipeline([]))).

/**
 * Adds a router-level error handler.
 *
 * Input: one `Router` and one error handler.
 * Output: the updated `Router`.
 * Transformation: adapts host failure messages into the public HttpError in
 * source, then invokes the user's recovery callback.
 */
pub (router: Router) error(handler: ErrorHandler): Router ->
    append_entry(
        router,
        ErrorEntry(
            (message: String) -> handler(Error.new(Atom["router_execution_failed"], message, 500)),
        ),
    ).

/**
 * Configures bounded pending HTTP work for this router.
 *
 * Input: one `Router`, a closed overload policy, and a positive pending-work
 * limit.
 * Output: the updated `Router`.
 * Transformation: records VM-owned admission metadata without exposing
 * scheduler internals or host-server implementation details.
 */
pub (router: Router) overload(policy: OverloadPolicy, max_pending: Int): Router ->
    append_entry(router, OverloadEntry(policy, max_pending)).

/**
 * Installs source lifecycle middleware for a root router.
 *
 * Input: one `Router` and one typed lifecycle callback.
 * Output: the updated `Router`.
 * Transformation: records a single callback that the VM invokes before
 * policy-sensitive transitions and after non-vetoable cleanup transitions.
 */
pub (router: Router) lifecycle(middleware: LifecycleMiddleware): Router ->
    append_entry(router, LifecycleEntry(middleware)).

/**
 * Adds a nested route group.
 *
 * Input: one `Router`, one path prefix, and one group builder function.
 * Output: the updated `Router`.
 * Transformation: invokes the ordinary group-builder function once on an empty
 * router and retains its declarations under the supplied path prefix.
 */
pub (router: Router) group(prefix: String, configure: GroupBuilder): Router ->
    let child = configure(new());
    let opened = append_entry(router, GroupStartEntry);
    let entries = prefix_entries(prefix, child.#entries);
    let fallbacks = group_fallbacks(prefix, child.#entries, 0);
    let middleware = group_middleware(router.#entries, 0);
    let response_middleware = group_response_middleware(router.#entries, 0);
    let scoped = [scope_entry(entry, middleware, response_middleware, 0, 0) | entry <- List.concat(entries, fallbacks)];
    let grouped = Router {#entries: List.concat(opened.#entries, scoped)};
    let closed = append_entry(grouped, GroupEndEntry);
    let inherited =
        case scope_error(router.#entries, 0) {
            [] -> scope_error(child.#entries, 0);
            _ -> []
        };
    Router {#entries: List.concat(closed.#entries, inherited)}.

scope_error(entries: List[Entry], depth: Int): List[Entry] ->
    case entries {
        [] -> [];
        [GroupStartEntry | rest] -> scope_error(rest, depth + 1);
        [GroupEndEntry | rest] -> scope_error(rest, depth - 1);
        [ErrorEntry(callback) | _] where depth == 0 -> [ErrorEntry(callback)];
        [_ | rest] -> scope_error(rest, depth)
    }.

prefix_entries(prefix: String, entries: List[Entry]): List[Entry] ->
    [prefix_entry(prefix, entry) | entry <- entries].

prefix_entry(prefix: String, entry: Entry): Entry ->
    case entry {
        RouteEntry(method, path, handler, middleware, response_middleware) ->
            RouteEntry(method, prefixed(prefix, path), handler, middleware, response_middleware);
        SseEntry(path, endpoint, middleware, response_middleware) ->
            SseEntry(prefixed(prefix, path), endpoint, middleware, response_middleware);
        WebSocketEntry(path, endpoint, middleware, response_middleware) ->
            WebSocketEntry(prefixed(prefix, path), endpoint, middleware, response_middleware);
        _ -> entry
    }.

group_fallbacks(prefix: String, entries: List[Entry], depth: Int): List[Entry] ->
    case entries {
        [] -> [];
        [GroupStartEntry | rest] -> group_fallbacks(prefix, rest, depth + 1);
        [GroupEndEntry | rest] -> group_fallbacks(prefix, rest, depth - 1);
        [FallbackEntry(handler, middleware, response_middleware) | rest] where depth == 0 ->
            let methods = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"];
            let routes = [method_fallback_route(method, prefixed(prefix, "*"), handler, middleware, response_middleware) | method <- methods];
            List.concat(routes, group_fallbacks(prefix, rest, depth));
        [_ | rest] -> group_fallbacks(prefix, rest, depth)
    }.

method_fallback_route(
    method: String,
    path: String,
    handler: Handler,
    middleware: RequestPipeline,
    response_middleware: ResponsePipeline,
): Entry ->
    RouteEntry(method, path, handler, middleware, response_middleware).

group_middleware(entries: List[Entry], depth: Int): List[Middleware] ->
    case entries {
        [] -> [];
        [GroupStartEntry | rest] -> group_middleware(rest, depth + 1);
        [GroupEndEntry | rest] -> group_middleware(rest, depth - 1);
        [MiddlewareEntry(callback) | rest] where depth == 0 ->
            [callback | group_middleware(rest, depth)];
        [_ | rest] -> group_middleware(rest, depth)
    }.

group_response_middleware(entries: List[Entry], depth: Int): List[ResponseMiddleware] ->
    case entries {
        [] -> [];
        [GroupStartEntry | rest] -> group_response_middleware(rest, depth + 1);
        [GroupEndEntry | rest] -> group_response_middleware(rest, depth - 1);
        [ResponseMiddlewareEntry(callback) | rest] where depth == 0 ->
            [callback | group_response_middleware(rest, depth)];
        [_ | rest] -> group_response_middleware(rest, depth)
    }.

scope_entry(
    entry: Entry,
    middleware: List[Middleware],
    response_middleware: List[ResponseMiddleware],
    middleware_offset: Int,
    response_offset: Int,
): Entry ->
    case entry {
        RouteEntry(method, path, handler, scoped, scoped_response) ->
            RouteEntry(
                method,
                path,
                handler,
                request_pipeline(insert_callbacks(scoped.#callbacks, middleware_offset, middleware)),
                response_pipeline(
                    insert_callbacks(
                        scoped_response.#callbacks,
                        response_offset,
                        response_middleware,
                    ),
                ),
            );
        SseEntry(path, endpoint, scoped, scoped_response) ->
            SseEntry(
                path,
                endpoint,
                request_pipeline(insert_callbacks(scoped.#callbacks, middleware_offset, middleware)),
                response_pipeline(
                    insert_callbacks(
                        scoped_response.#callbacks,
                        response_offset,
                        response_middleware,
                    ),
                ),
            );
        WebSocketEntry(path, endpoint, scoped, scoped_response) ->
            WebSocketEntry(
                path,
                endpoint,
                request_pipeline(insert_callbacks(scoped.#callbacks, middleware_offset, middleware)),
                response_pipeline(
                    insert_callbacks(
                        scoped_response.#callbacks,
                        response_offset,
                        response_middleware,
                    ),
                ),
            );
        FallbackEntry(handler, scoped, scoped_response) ->
            FallbackEntry(
                handler,
                request_pipeline(insert_callbacks(scoped.#callbacks, middleware_offset, middleware)),
                response_pipeline(
                    insert_callbacks(
                        scoped_response.#callbacks,
                        response_offset,
                        response_middleware,
                    ),
                ),
            );
        _ -> entry
    }.

request_pipeline(callbacks: List[Middleware]): RequestPipeline ->
    let execute =
        case callbacks {
            [] -> [];
            _ -> [(request: Request) -> run_request_pipeline(callbacks, request)]
        };
    RequestPipeline {#callbacks: callbacks, #execute: execute}.

run_request_pipeline(callbacks: List[Middleware], request: Request): MiddlewareResult ->
    case callbacks {
        [] -> Continue;
        [callback | rest] ->
            case callback(request) {
                Continue -> run_request_pipeline(rest, request);
                Respond(response) -> Respond(response)
            }
    }.

response_pipeline(callbacks: List[ResponseMiddleware]): ResponsePipeline ->
    let execute =
        case callbacks {
            [] -> [];
            _ ->
                [
                    (request: Request, response: Response) -> run_response_pipeline(callbacks, request, response),
                ]
        };
    ResponsePipeline {#callbacks: callbacks, #execute: execute}.

run_response_pipeline(
    callbacks: List[ResponseMiddleware],
    request: Request,
    response: Response,
): Response ->
    case callbacks {
        [] -> response;
        [callback | rest] -> callback(request, run_response_pipeline(rest, request, response))
    }.

insert_callbacks[T](values: List[T], offset: Int, callbacks: List[T]): List[T] ->
    case {callbacks, offset, values} {
        {[], _, _} -> values;
        {_, 0, _} -> List.concat(callbacks, values);
        {_, _, [head | tail]} -> [head | insert_callbacks(tail, offset - 1, callbacks)];
        _ -> callbacks
    }.

prefixed(prefix: String, path: String): String ->
    let base = trim_group_end(prefix);
    case path {
        "/" ->
            case base {
                "" -> "/";
                _ -> base
            };
        _ -> base + "/" + trim_group_start(path)
    }.

trim_group_end(value: String): String ->
    case value.ends_with("/") {
        true -> trim_group_end(value.utf8_slice(0, value.byte_size() - 1));
        false -> value
    }.

trim_group_start(value: String): String ->
    case value.starts_with("/") {
        true -> trim_group_start(value.utf8_slice(1, value.byte_size() - 1));
        false -> value
    }.
