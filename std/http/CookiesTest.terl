module std.http.CookiesTest.

import std.collections.Map.
import std.core.Option.{None, Some}.
import std.http.Cookies.{Strict, delete_header, set_header, set_header_options, set_header_with_options}.
import std.test.Test.{assert_equal}.

import type std.http.Cookies.{Jar, Options, SameSite}.

pub accepts_same_site(value: SameSite): SameSite ->
    value.

pub accepts_options(value: Options): Options ->
    value.

pub accepts_jar(value: Jar): Jar ->
    value.

pub sample_set_cookie_header(): String ->
    set_header("session", "abc123", "/", true, false).

pub sample_delete_cookie_header(): String ->
    delete_header("session", "/").

pub sample_set_cookie_header_options(options: Options): String ->
    set_header_options("session", "abc123", options).

pub sample_full_set_cookie_header(): String ->
    set_header_with_options("session", "abc123", "/account", "example.com", 3600, true, "Wed, 21 Oct 2026 07:28:00 GMT", true, true, "strict").

pub sample_jar(): Dynamic ->
    {Atom["cookies"], Map({"session", "abc123"})}.

pub option_string_or_empty(value: Dynamic): String ->
    case value {
        Some(text) -> text;
        None -> ""
    }.

@test
pub same_site_strict_marker_round_trips(): Bool ->
    assert_equal(Strict, accepts_same_site(Strict)).

@test
pub cookie_header_builders_serialize_defaults(): Bool ->
    assert_equal("session=abc123; HttpOnly; Path=/", sample_set_cookie_header()) and assert_equal("session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT", sample_delete_cookie_header()).

@test
pub cookie_full_options_header_serializes_attributes(): Bool ->
    assert_equal("session=abc123; HttpOnly; SameSite=Strict; Secure; Path=/account; Domain=example.com; Max-Age=3600; Expires=Wed, 21 Oct 2026 07:28:00 GMT", sample_full_set_cookie_header()).

@test
pub cookie_jar_get_reads_present_and_missing_values(): Bool ->
    let jar = sample_jar();
    assert_equal("abc123", option_string_or_empty(jar.get("session"))) and assert_equal("", option_string_or_empty(jar.get("missing"))).
