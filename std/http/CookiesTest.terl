module std.http.CookiesTest.

import std.collections.Map.
import std.core.Option.{None, Some}.
import std.core.Unit.
import std.http.Cookies.{Lax, None as CrossSite, Options, Strict, delete_header, set_header, set_header_options, set_header_with_options}.
import std.http.{Cookies, Response}.
import std.test.Test.{assert_equal}.

import type std.core.Option.
import type std.http.Cookies.{Jar, Options, SameSite}.
import type std.http.Request.

pub accepts_same_site(value: SameSite): SameSite ->
    value.

pub accepts_options(value: Options): Options ->
    value.

pub accepts_jar(value: Jar): Jar ->
    value.

pub sample_set_cookie_header(): String ->
    set_header("session", "abc123", "/", true, false).

pub sample_delete_cookie_header(): String ->
    delete_header("session", "/").

pub sample_set_cookie_header_options(options: Options): String ->
    set_header_options("session", "abc123", options).

pub sample_full_set_cookie_header(): String ->
    set_header_with_options(
        "session",
        "abc123",
        "/account",
        "example.com",
        3600,
        true,
        "Wed, 21 Oct 2026 07:28:00 GMT",
        true,
        true,
        "strict",
    ).

@compiler.native {std.test.fixture.http_request}
request_fixture(cookie_header: String): Request ->
    native.

pub sample_jar(): Jar ->
    request_fixture("session=abc123").cookies().

pub option_string_or_empty(value: Option[String]): String ->
    case value {
        Some(text) -> text;
        None -> ""
    }.

@test
pub same_site_strict_marker_round_trips(): Bool ->
    assert_equal(Strict, accepts_same_site(Strict)).

@test
pub cookie_header_builders_serialize_defaults(): Bool ->
    assert_equal("session=abc123; HttpOnly; Path=/", sample_set_cookie_header())
        and assert_equal(
    "session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT",
    sample_delete_cookie_header(),
).

@test
pub cookie_defaults_flags_and_deletion_paths_are_source_composition(): Bool ->
    assert_equal("sid=value; Path=/", set_header("sid", "value"))
        and assert_equal("sid=value; HttpOnly; Path=/private", set_header("sid", "value", "/private", true))
        and assert_equal("sid=value; Secure; Path=/", set_header("sid", "value", "/", false, true))
        and assert_equal("sid=value; HttpOnly; Secure; Path=/", set_header("sid", "value", "/", true, true))
        and assert_equal(
    "sid=; Path=/private; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT",
    delete_header("sid", "/private"),
).

@test
pub cookie_full_options_header_serializes_attributes(): Bool ->
    assert_equal(
        "session=abc123; HttpOnly; SameSite=Strict; Secure; Path=/account; Domain=example.com; Max-Age=3600; Expires=Wed, 21 Oct 2026 07:28:00 GMT",
        sample_full_set_cookie_header(),
    ).

@test
pub cookie_jar_get_reads_present_and_missing_values(): Bool ->
    let jar = sample_jar();
    assert_equal("abc123", option_string_or_empty(jar.get("session")))
        and assert_equal("", option_string_or_empty(jar.get("missing"))).

@test
pub source_jar_construction_preserves_empty_values_and_map_snapshots(): Bool ->
    let incoming = Map({"session", "original"}, {"empty", ""});
    let jar = Cookies.from_map(incoming);
    incoming.put("session", "changed");
    assert_equal(Some("original"), jar.get("session"))
        and assert_equal(Some(""), jar.get("empty"))
        and assert_equal(None, jar.get("missing"))
        and assert_equal([], jar.headers())
        and assert_equal(None, Cookies.from_map(Map.new[String, String]()).get("session")).

@test
pub request_cookie_views_do_not_share_pending_mutations(): Bool ->
    let request = request_fixture("session=original");
    let jar = request.cookies();
    jar.set("session", "outgoing");
    let fresh = request.cookies();
    assert_equal([], fresh.headers())
        and assert_equal(Some("original"), fresh.get("session"))
        and assert_equal(Some("original"), request.cookie("session"))
        and assert_equal(["session=outgoing; Path=/"], jar.headers()).

@test
pub typed_cookie_options_serialize_present_and_absent_attributes(): Bool ->
    let options = Options(Some("/account"), Some("example.com"), Some(3600), None, true, true, Some(Strict));
    let defaults = Options(None, None, None, None, false, false, Some(Lax));
    let omitted = Options(None, None, None, None, false, false, None);
    let cross_site = Options(None, None, None, None, false, true, Some(CrossSite));
    assert_equal(
    "session=abc123; HttpOnly; SameSite=Strict; Secure; Path=/account; Domain=example.com; Max-Age=3600",
    sample_set_cookie_header_options(options),
)
        and assert_equal("session=abc123; SameSite=Lax; Path=/", sample_set_cookie_header_options(defaults))
        and assert_equal("session=abc123; Path=/", sample_set_cookie_header_options(omitted))
        and assert_equal(
    "session=abc123; SameSite=None; Secure; Path=/",
    sample_set_cookie_header_options(cross_site),
).

@test
pub cookie_jar_set_threads_response_header(): Bool ->
    let jar = sample_jar();
    let original = jar;
    let done = jar.set("session", "updated", "/account", true, true);
    assert_equal(Unit, done)
        and assert_equal(Response.text("ok"), Response.text("ok").with_cookies(original))
        and assert_equal("abc123", option_string_or_empty(jar.get("session")))
        and assert_equal(
    Response.text("ok")
        .with_header("Set-Cookie", "session=updated; HttpOnly; Secure; Path=/account"),
    Response.text("ok").with_cookies(jar),
).

@test
pub cookie_jar_delete_threads_expiring_response_header(): Bool ->
    let jar = sample_jar();
    let done = jar.delete("session", "/account");
    assert_equal(Unit, done)
        and assert_equal("abc123", option_string_or_empty(jar.get("session")))
        and assert_equal(
    Response.text("ok")
        .with_header(
            "Set-Cookie",
            "session=; Path=/account; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT",
        ),
    Response.text("ok").with_cookies(jar),
).
