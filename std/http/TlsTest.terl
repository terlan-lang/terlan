module std.http.TlsTest.

import std.core.Option.{None, Some}.
import std.http.Tls.{Auto, Internal, LetsEncrypt, Manual, ZeroSsl, auto, internal, manual}.
import std.test.Test.{assert}.

import type std.collections.List.
import type std.core.Option.
import type std.http.Tls.{Config, Mode, Provider}.

pub accepts_mode(value: Mode): Mode ->
    value.

pub accepts_provider(value: Provider): Provider ->
    value.

pub accepts_config(value: Config): Config ->
    value.

pub accepts_domains(value: List[String]): List[String] ->
    value.

pub accepts_optional_provider(value: Option[Provider]): Option[Provider] ->
    value.

/**
 * Confirms automatic TLS helper calls typecheck as `Config`.
 *
 * Input: one list of domain names.
 * Output: automatic TLS `Config`.
 * Transformation: delegates to the public helper so summary consumers verify
 * the imported function return shape.
 */
pub auto_helper_typechecks(domains: List[String]): Config ->
    auto(domains, "admin@example.com").

/**
 * Confirms manual TLS helper calls typecheck as `Config`.
 *
 * Input: no value input.
 * Output: manual certificate TLS `Config`.
 * Transformation: delegates to the public helper with deterministic fixture
 * paths.
 */
pub manual_helper_typechecks(): Config ->
    manual("certs/dev.pem", "certs/dev-key.pem").

/**
 * Confirms internal TLS helper calls typecheck as `Config`.
 *
 * Input: no value input.
 * Output: local/internal TLS `Config`.
 * Transformation: delegates to the public helper with a deterministic local
 * server name.
 */
pub internal_helper_typechecks(): Config ->
    internal("localhost").

pub auto_config_has_defaults(value: Dynamic): Bool ->
    case value {
        {mode: mode, domains: domains, email: Some(email), primary_provider: Some(_primary), fallback_provider: Some(_fallback), cert: None, key: None, trust_local: trust_local} ->
            mode == Auto
                and domains == ["example.com"]
                and email == "admin@example.com"
                and trust_local == false;
        _ -> false
    }.

pub manual_config_has_certificates(value: Dynamic): Bool ->
    case value {
        {mode: mode, domains: domains, email: None, primary_provider: None, fallback_provider: None, cert: Some(cert), key: Some(key), trust_local: trust_local} ->
            mode == Manual
                and domains == []
                and cert == "certs/dev.pem"
                and key == "certs/dev-key.pem"
                and trust_local == false;
        _ -> false
    }.

pub internal_config_has_local_trust(value: Dynamic): Bool ->
    case value {
        {mode: mode, domains: domains, server_name: Some(server_name), trust_local: trust_local} ->
            mode == Internal
                and domains == []
                and server_name == "localhost"
                and trust_local == true;
        _ -> false
    }.

@test
pub tls_auto_config_records_acme_defaults(): Bool ->
    assert(auto_config_has_defaults(auto(["example.com"], "admin@example.com"))).

@test
pub tls_manual_and_internal_configs_record_mode_specific_fields(): Bool ->
    assert(manual_config_has_certificates(manual_helper_typechecks()))
        and assert(internal_config_has_local_trust(internal_helper_typechecks())).
