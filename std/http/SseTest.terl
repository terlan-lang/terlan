module std.http.SseTest.

import std.http.Sse.

import type std.http.Response.
import type std.http.Sse.{Endpoint, Event}.

pub accepts_event(value: Event): Event ->
    value.

pub accepts_endpoint(value: Endpoint): Endpoint ->
    value.

pub accepts_response(value: Response): Response ->
    value.

pub event_with_metadata(): Event ->
    Sse.data("tick").with_id("42").with_name("counter").with_retry_ms(1500).

pub queued_response(): Response ->
    Sse.response([Sse.data("ready")]).

pub bounded_endpoint(): Endpoint ->
    Sse.endpoint_with_keep_alive(16, 4096, 15000).

@test
pub sse_event_metadata_builders_record_typed_descriptor(): Bool -> true.

@test
pub sse_endpoint_records_stream_limits(): Bool -> true.
