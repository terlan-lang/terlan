module std.http.SessionTest.

import std.collections.Map.
import std.core.Option.{None, Some}.
import std.http.Response.
import std.http.Session.{current, with_response}.
import std.test.Test.{assert}.

import type std.core.Option.
import type std.http.{Request, Response, Session}.

pub accepts_session(value: Session): Session ->
    value.

pub sample_current(request: Request): Session ->
    current(request).

pub sample_get(session: Session): Option[String] ->
    session.get("user_id").

pub sample_set(session: Session): Unit ->
    session.set("user_id", "ada").

pub sample_delete(session: Session): Unit ->
    session.delete("user_id").

pub sample_rotate(session: Session): Session ->
    session.rotate().

pub sample_expire(session: Session): Unit ->
    session.expire().

pub sample_with_response(response: Response, session: Session): Response ->
    with_response(response, session).

pub sample_request(): Dynamic ->
    {
        Atom["request"],
        "GET",
        "/account",
        Map(),
        "",
        "",
        Map(),
        Map(),
        Map({"terlan_session", "abc"}),
    }.

pub session_descriptor_has_cookie_id(value: Dynamic): Bool ->
    case value {
        {tag, id, _values, state} ->
            tag == Atom["session"] and id == "abc" and state == Atom["active"];
        _ -> false
    }.

pub missing_session_value_is_none(session: Session): Bool ->
    case session.get("missing") {
        None -> true;
        Some(_value) -> false
    }.

pub response_has_session_cookie_metadata(value: Dynamic): Bool ->
    case value {
        {response_tag, kind, body, {metadata, header}} ->
            response_tag == Atom["response"]
                and kind == Atom["text"]
                and body == "ok"
                and metadata == Atom["set_cookie"]
                and header == "terlan_session=abc; Path=/; HttpOnly; SameSite=Lax";
        _ -> false
    }.

@test
pub session_current_reads_request_cookie(): Bool ->
    assert(session_descriptor_has_cookie_id(current(sample_request()))).

@test
pub session_get_and_response_threading_execute(): Bool ->
    let session = current(sample_request());
    assert(missing_session_value_is_none(session))
        and assert(response_has_session_cookie_metadata(with_response(Response.text("ok"), session))).
