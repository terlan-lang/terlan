/**
 * Portable HTTP response contract.
 *
 * `std.http.Response` exposes response builders used by Terlan HTTP handlers.
 * Terlan owns response storage, builders, and receiver methods. Transport
 * adapters validate protocol metadata and perform file and stream I/O.
 */
module std.http.Response.

import std.collections.List.
import std.core.Int.{to_string}.
import std.core.{String, Unit}.
import std.data.Json.{to_string as json_to_string}.
import std.http.Cookies.{delete_header, headers, set_header, set_header_with_options}.
import std.template.Template.{to_string as html_to_string}.

import type std.collections.List.
import type std.data.Json.
import type std.http.Cookies.Jar.

/**
 * Deny represents the strict frame-ancestor policy for secure responses.
 *
 * Input: no value input.
 * Output: atom-backed frame option marker.
 * Transformation: gives security-header policies a typed source-level value
 * instead of requiring raw `X-Frame-Options` text.
 */
pub type Deny.

/**
 * SameOrigin represents the same-origin frame-ancestor policy.
 *
 * Input: no value input.
 * Output: atom-backed frame option marker.
 * Transformation: narrows frame embedding policy before it is serialized as a
 * response header.
 */
pub type SameOrigin.

/**
 * FrameOptions represents the supported `X-Frame-Options` policy values.
 *
 * Input: no type parameter.
 * Output: one of the supported frame option markers.
 * Transformation: prevents handlers from spelling frame protection headers by
 * hand while keeping the emitted HTTP header predictable.
 */
pub type FrameOptions = Deny | SameOrigin.

/**
 * NoReferrer represents the strictest referrer policy.
 *
 * Input: no value input.
 * Output: atom-backed referrer policy marker.
 * Transformation: makes referrer policy composition a typed choice instead of
 * a raw header string.
 */
pub type NoReferrer.

/**
 * StrictOriginWhenCrossOrigin represents the modern practical referrer policy.
 *
 * Input: no value input.
 * Output: atom-backed referrer policy marker.
 * Transformation: records the source-level policy in a stable value that is
 * later serialized to the HTTP header vocabulary.
 */
pub type StrictOriginWhenCrossOrigin.

/**
 * ReferrerPolicy represents supported `Referrer-Policy` values.
 *
 * Input: no type parameter.
 * Output: one of the supported referrer policy markers.
 * Transformation: narrows response security policy before header emission.
 */
pub type ReferrerPolicy = NoReferrer | StrictOriginWhenCrossOrigin.

/**
 * SecurityHeaders represents the typed secure-header policy for a response.
 *
 * Input: no type parameter.
 * Output: typed response security policy.
 * Transformation: groups the current response security headers so middleware,
 * handlers, and future route manifests can compose one value instead of raw
 * header mutations.
 */
pub struct SecurityHeaders {
    content_type_options: Bool,
    frame_options: FrameOptions,
    referrer_policy: ReferrerPolicy,
    hsts_max_age: Int,
    hsts_include_subdomains: Bool,
}.

/**
 * Constructs a typed secure-header policy.
 *
 * Input: content sniffing flag, frame policy, referrer policy, HSTS max-age,
 * and HSTS subdomain flag.
 * Output: `SecurityHeaders`.
 * Transformation: centralizes public construction so response policy values
 * remain explicit and route-manifest-friendly.
 */
pub constructor SecurityHeaders {
    (content_type_options: Bool, frame_options: FrameOptions, referrer_policy: ReferrerPolicy, hsts_max_age: Int, hsts_include_subdomains: Bool): SecurityHeaders ->
        SecurityHeaders {
            content_type_options: content_type_options,
            frame_options: frame_options,
            referrer_policy: referrer_policy,
            hsts_max_age: hsts_max_age,
            hsts_include_subdomains: hsts_include_subdomains,
        }
}.

/**
 * Returns the conservative development security-header policy.
 *
 * Input: no value input.
 * Output: `SecurityHeaders` without HSTS.
 * Transformation: enables secure defaults for local HTTP without emitting HSTS
 * on non-TLS development origins.
 */
pub default_security_headers(): SecurityHeaders ->
    SecurityHeaders {
        content_type_options: true,
        frame_options: Deny,
        referrer_policy: StrictOriginWhenCrossOrigin,
        hsts_max_age: 0,
        hsts_include_subdomains: false,
    }.

/**
 * Returns the production security-header policy.
 *
 * Input: no value input.
 * Output: `SecurityHeaders` with a one-year HSTS policy.
 * Transformation: gives production routes one typed policy value that can be
 * composed through handlers and future route manifests.
 */
pub production_security_headers(): SecurityHeaders ->
    SecurityHeaders {
        content_type_options: true,
        frame_options: Deny,
        referrer_policy: StrictOriginWhenCrossOrigin,
        hsts_max_age: 31536000,
        hsts_include_subdomains: true,
    }.

/**
 * Response represents one HTTP response returned by a Terlan handler.
 *
 * Input: no type parameter.
 * Output: a source-owned record with private fields.
 * Transformation: stores body and metadata without native resource handles;
 * handlers construct and update it through this module's functions.
 */
pub struct Response {
    #kind: Int,
    #payload: String,
    #status: Int,
    #content_type: String,
    #default_headers: List[{String, String}],
    #headers: List[{String, String}],
    #chunks: List[String],
    #chunk_size: Int,
    #max_pending_writes: Int,
}.

new(kind: Int, payload: String, status: Int, content_type: String): Response ->
    Response {
        #kind: kind,
        #payload: payload,
        #status: status,
        #content_type: content_type,
        #default_headers: default_headers(),
        #headers: [],
        #chunks: [],
        #chunk_size: 0,
        #max_pending_writes: 0,
    }.

default_headers(): List[{String, String}] ->
    [{"Cache-Control", "no-cache"}, {"X-Content-Type-Options", "nosniff"}].

update(
    response: Response,
    status: Int,
    defaults: List[{String, String}],
    headers: List[{String, String}],
): Response ->
    Response {
        #kind: response.#kind,
        #payload: response.#payload,
        #status: status,
        #content_type: response.#content_type,
        #default_headers: defaults,
        #headers: headers,
        #chunks: response.#chunks,
        #chunk_size: response.#chunk_size,
        #max_pending_writes: response.#max_pending_writes,
    }.

/**
 * Creates a JSON response.
 *
 * Input: one `Json` value and an optional HTTP status code.
 * Output: a `Response` containing the serialized JSON body and the platform
 * default JSON content type.
 * Transformation: serializes through the JSON package and composes the text
 * response builder without inspecting the JSON resource representation.
 */
pub json(value: Json, status: Int = 200): Response ->
    json_text(json_to_string(value), status).

/**
 * Creates a JSON response from already serialized JSON text.
 *
 * Input: one UTF-8 JSON string and an optional HTTP status code.
 * Output: a `Response` containing the supplied JSON body and the platform
 * default JSON content type.
 * Transformation: stores serialized bytes and the JSON content type in a
 * private source record, without parsing or re-encoding the supplied text.
 */
pub json_text(value: String, status: Int = 200): Response ->
    new(2, value, status, "application/json; charset=utf-8").

/**
 * Creates a text response.
 *
 * Input: one UTF-8 `String` value and an optional HTTP status code.
 * Output: a `Response` containing the text body and the platform default text
 * content type.
 * Transformation: stores text and its content type in a private source record.
 */
pub text(value: String, status: Int = 200): Response ->
    new(0, value, status, "text/plain; charset=utf-8").

/**
 * Creates an HTML response.
 *
 * Input: one UTF-8 HTML string and an optional HTTP status code.
 * Output: a `Response` containing the HTML body and the platform default HTML
 * content type.
 * Transformation: stores HTML and its content type in a private source record.
 */
pub html(value: String, status: Int = 200): Response ->
    new(1, value, status, "text/html; charset=utf-8").

/**
 * Creates an HTML response from a trusted template fragment.
 *
 * Input: one compiler-validated `Template.Html` fragment and an optional HTTP
 * status code.
 * Output: a `Response` containing the rendered HTML body and the platform
 * default HTML content type.
 * Transformation: extracts the trusted bytes through the template package and
 * composes the ordinary string response builder.
 */
pub html(value: std.template.Template.Html, status: Int = 200): Response ->
    html(html_to_string(value), status).

/**
 * Creates a file response.
 *
 * Input: one package-relative file path, an optional HTTP status code, and an
 * optional content type override.
 * Output: a `Response` that streams the selected file through the runtime HTTP
 * server path.
 * Transformation: delegates file response allocation to the selected HTTP
 * server capability while the compiler may lower constant file responses into
 * generated route manifests.
 */
pub file(path: String, status: Int = 200, content_type: String = ""): Response ->
    new(4, path, status, content_type).

/**
 * Creates a bounded streaming response from available text chunks.
 *
 * Input: ordered UTF-8 chunks, HTTP status, content type, maximum emitted
 * chunk size, and maximum pending write count.
 * Output: a `Response` whose body is emitted through the VM-owned response
 * stream and HTTP transport path.
 * Transformation: records source chunks and explicit queue limits in a typed
 * descriptor; the VM validates the limits, preserves chunk order, applies
 * backpressure, and owns response completion.
 */
pub stream(
    chunks: List[String],
    status: Int,
    content_type: String,
    chunk_size: Int,
    max_pending_writes: Int,
): Response ->
    Response {
        #kind: 5,
        #payload: "",
        #status: status,
        #content_type: content_type,
        #default_headers: default_headers(),
        #headers: [],
        #chunks: chunks,
        #chunk_size: chunk_size,
        #max_pending_writes: max_pending_writes,
    }.

/**
 * Creates a bounded streaming response with conservative defaults.
 *
 * Input: ordered UTF-8 chunks.
 * Output: a `200 application/octet-stream` response with a 16 KiB emitted
 * chunk limit and at most 128 pending writes.
 * Transformation: delegates to the explicit bounded overload so the compact
 * VM descriptor never has to infer omitted integer argument roles.
 */
pub stream(chunks: List[String]): Response ->
    stream(chunks, 200, "application/octet-stream", 16384, 128).

/**
 * Creates a redirect response.
 *
 * Input: one redirect location string and an optional HTTP redirect status.
 * Output: a `Response` with the supplied status and a `Location` header.
 * Transformation: delegates redirect response allocation to the selected HTTP
 * server capability without exposing backend response buffers.
 */
pub redirect(location: String, status: Int = 302): Response ->
    text("", status).with_header("Location", location).

/**
 * Sets the response status.
 *
 * Input: one mutable `Response` receiver and one HTTP status code.
 * Output: the same `Response` value after secure-header metadata is appended.
 * Transformation: updates the target-owned response metadata through the
 * mutable receiver ABI.
 */
pub (mut response: Response) status(code: Int): Unit ->
    update(response, code, response.#default_headers, response.#headers).

/**
 * Sets a response header.
 *
 * Input: one mutable `Response` receiver, one UTF-8 header name, and one UTF-8
 * header value.
 * Output: `Unit`.
 * Transformation: updates the target-owned response metadata through the
 * mutable receiver ABI.
 */
pub (mut response: Response) header(name: String, value: String): Unit ->
    let defaults =
        if {
            name.lowercase() == "cache-control" -> without_cache_default(response.#default_headers);
            true -> response.#default_headers
        };
    update(response, response.#status, defaults, response.#headers.concat([{name, value}])).

without_cache_default(defaults: List[{String, String}]): List[{String, String}] ->
    [{key, value} | {key, value} <- defaults, key.lowercase() != "cache-control"].

/**
 * Returns a response after setting its status.
 *
 * Input: one mutable `Response` receiver and one HTTP status code.
 * Output: the same `Response` value after status metadata has been updated.
 * Transformation: uses the mutable receiver continuation rule so handlers can
 * write expression-style response builders without losing the underlying
 * target-owned mutation path.
 */
pub (mut response: Response) with_status(code: Int): Response ->
    response
    |> status(code).

/**
 * Returns a response after setting one header.
 *
 * Input: one mutable `Response` receiver, one UTF-8 header name, and one UTF-8
 * header value.
 * Output: the same `Response` value after header metadata has been updated.
 * Transformation: uses the mutable receiver continuation rule so handlers can
 * chain header construction while the runtime still owns concrete response
 * storage.
 */
pub (mut response: Response) with_header(name: String, value: String): Response ->
    response
    |> header(name, value).

/**
 * Applies typed secure response headers.
 *
 * Input: one mutable `Response` receiver and one `SecurityHeaders` policy.
 * Output: the same `Response` after applying the selected headers.
 * Transformation: serializes typed policy values into validated response
 * headers through the normal response metadata path.
 */
pub (mut response: Response) security_headers(policy: SecurityHeaders): Response ->
    response
    |> header("X-Frame-Options", frame_options_header(policy.frame_options))
    |> header("Referrer-Policy", referrer_policy_header(policy.referrer_policy))
    |> optional_content_type_options_header(policy.content_type_options)
    |> optional_hsts_header(policy.hsts_max_age, policy.hsts_include_subdomains).

/**
 * Returns a response after applying typed secure response headers.
 *
 * Input: one mutable `Response` receiver and one `SecurityHeaders` policy.
 * Output: the same `Response` value after secure-header metadata is appended.
 * Transformation: keeps expression-style handlers on the typed policy path
 * instead of forcing raw header calls.
 */
pub (mut response: Response) with_security_headers(policy: SecurityHeaders): Response ->
    response
    |> security_headers(policy).

frame_options_header(value: FrameOptions): String ->
    case value {
        Deny -> "DENY";
        SameOrigin -> "SAMEORIGIN"
    }.

referrer_policy_header(value: ReferrerPolicy): String ->
    case value {
        NoReferrer -> "no-referrer";
        StrictOriginWhenCrossOrigin -> "strict-origin-when-cross-origin"
    }.

pub (mut response: Response) optional_content_type_options_header(enabled: Bool): Response ->
    case enabled {
        true -> response.with_header("X-Content-Type-Options", "nosniff");
        false -> response
    }.

pub (mut response: Response) optional_hsts_header(max_age: Int, include_subdomains: Bool): Response ->
    case max_age > 0 {
        true ->
            response
                .with_header("Strict-Transport-Security", hsts_header(max_age, include_subdomains));
        false -> response
    }.

hsts_header(max_age: Int, include_subdomains: Bool): String ->
    case include_subdomains {
        true -> "max-age=" + to_string(max_age) + "; includeSubDomains";
        false -> "max-age=" + to_string(max_age)
    }.

/**
 * Adds a `Set-Cookie` header value.
 *
 * Input: one mutable `Response` receiver and one complete `Set-Cookie` header
 * value.
 * Output: `Unit`.
 * Transformation: appends a `Set-Cookie` header using the current
 * source-level helper. Full typed construction and option validation belong to
 * `std.http.Cookies`.
 */
pub (mut response: Response) set_cookie_header(value: String): Unit ->
    response
    |> header("Set-Cookie", value).

/**
 * Adds a validated `Set-Cookie` header.
 *
 * Input: one mutable `Response` receiver, cookie name, cookie value, optional
 * path, and practical boolean flags.
 * Output: `Unit`.
 * Transformation: builds the cookie header through `std.http.Cookies` and
 * appends it to the response without requiring handler code to assemble raw
 * `Set-Cookie` text.
 */
pub (mut response: Response) cookie(
    name: String,
    value: String,
    path: String = "/",
    http_only: Bool = false,
    secure: Bool = false,
): Unit ->
    response
    |> set_cookie_header(set_header(name, value, path, http_only, secure)).

/**
 * Returns a response after adding a validated `Set-Cookie` header.
 *
 * Input: one mutable `Response` receiver, cookie name, cookie value, optional
 * path, and practical boolean flags.
 * Output: the same `Response` value after cookie metadata has been updated.
 * Transformation: uses the mutable receiver continuation rule so handlers can
 * write expression-style response builders without raw `Set-Cookie` headers.
 */
pub (mut response: Response) with_cookie(
    name: String,
    value: String,
    path: String = "/",
    http_only: Bool = false,
    secure: Bool = false,
): Response ->
    response
    |> cookie(name, value, path, http_only, secure).

/**
 * Adds a validated `Set-Cookie` header with the full option surface.
 *
 * Input: one mutable `Response` receiver, cookie name, cookie value, path,
 * optional domain text, `Max-Age` seconds plus an inclusion flag, optional
 * expires text, practical boolean flags, and optional SameSite text.
 * Output: `Unit`.
 * Transformation: delegates option validation to `std.http.Cookies` and
 * appends the serialized header to the response through the existing mutable
 * response metadata path.
 */
pub (mut response: Response) cookie_with_options(
    name: String,
    value: String,
    path: String = "/",
    domain: String = "",
    max_age: Int = 0,
    include_max_age: Bool = false,
    expires: String = "",
    http_only: Bool = false,
    secure: Bool = false,
    same_site: String = "",
): Unit ->
    response
    |> set_cookie_header(
    set_header_with_options(
        name,
        value,
        path,
        domain,
        max_age,
        include_max_age,
        expires,
        http_only,
        secure,
        same_site,
    ),
).

/**
 * Returns a response after adding a validated `Set-Cookie` header with the
 * full option surface.
 *
 * Input: one mutable `Response` receiver, cookie name, cookie value, path,
 * optional domain text, `Max-Age` seconds plus an inclusion flag, optional
 * expires text, practical boolean flags, and optional SameSite text.
 * Output: the same `Response` value after cookie metadata has been updated.
 * Transformation: keeps expression-style HTTP handlers on the typed cookie
 * serialization path exposed by `std.http.Cookies`.
 */
pub (mut response: Response) with_cookie_options(
    name: String,
    value: String,
    path: String = "/",
    domain: String = "",
    max_age: Int = 0,
    include_max_age: Bool = false,
    expires: String = "",
    http_only: Bool = false,
    secure: Bool = false,
    same_site: String = "",
): Response ->
    response
    |> cookie_with_options(
    name,
    value,
    path,
    domain,
    max_age,
    include_max_age,
    expires,
    http_only,
    secure,
    same_site,
).

/**
 * Adds a validated cookie deletion header.
 *
 * Input: one mutable `Response` receiver, cookie name, and optional path.
 * Output: `Unit`.
 * Transformation: builds the expiring cookie header through `std.http.Cookies`
 * and appends it to the response through the existing mutable response
 * metadata path.
 */
pub (mut response: Response) delete_cookie(name: String, path: String = "/"): Unit ->
    response
    |> set_cookie_header(delete_header(name, path)).

/**
 * Returns a response after adding a validated cookie deletion header.
 *
 * Input: one mutable `Response` receiver, cookie name, and optional path.
 * Output: the same `Response` value after cookie metadata has been updated.
 * Transformation: keeps logout/session-clear handlers on the standard cookie
 * deletion path instead of requiring raw expiring header text.
 */
pub (mut response: Response) with_deleted_cookie(name: String, path: String = "/"): Response ->
    response
    |> delete_cookie(name, path).

/**
 * Returns a response after applying recorded cookie jar mutations.
 *
 * Input: one mutable `Response` receiver and one request-scoped cookie jar.
 * Output: the same `Response` value after all jar mutations have been attached
 * as `Set-Cookie` response metadata.
 * Transformation: lets handlers mutate a `Request.cookies()` jar and then
 * explicitly thread those validated mutations into the returned response.
 */
pub (mut response: Response) with_cookies(jar: Jar): Response ->
    apply_cookie_headers(response, headers(jar)).

apply_cookie_headers(response: Response, pending: List[String]): Response ->
    case pending {
        [] -> response;
        [header | rest] -> apply_cookie_headers(response |> set_cookie_header(header), rest)
    }.
