module std.http.RouterTest.

import std.http.Router.{run_request_pipeline, run_response_pipeline}.
import std.http.{Request, Response, Router, Sse, WebSocket}.

import type std.http.Error.HttpError.
import type std.http.Router.{LifecycleDecision, LifecycleEvent, MiddlewareResult}.
import type std.http.{Request, Response, Router}.

pub home(_request: Request): Response ->
    Response.text("home").

pub not_found(_request: Request): Response ->
    Response.text("not found", status = 404).

pub render_error(_error: HttpError): Response ->
    Response.text("error").

pub require_user(_request: Request): MiddlewareResult -> Atom["continue"].

pub add_response_context(_request: Request, response: Response): Response ->
    response.

pub stop_request(_request: Request): MiddlewareResult ->
    {Atom["respond"], Response.text("stopped")}.

pub should_not_run(_request: Request): MiddlewareResult ->
    {Atom["respond"], Response.text("late")}.

pub inner_response(_request: Request, response: Response): Response ->
    if {
        response == Response.text("start") -> Response.text("middle");
        true -> Response.text("wrong")
    }.

pub outer_response(_request: Request, response: Response): Response ->
    if {
        response == Response.text("middle") -> Response.text("done");
        true -> Response.text("wrong")
    }.

@compiler.native {std.test.fixture.http_request}
request_fixture(cookie_header: String): Request.

pub lifecycle_policy(_event: LifecycleEvent): LifecycleDecision -> Atom["lifecycle_allow"].

pub users(router: Router): Router ->
    router.use(require_user).get("/:id", home).

pub sample_router(): Router ->
    let router = Router.get(Router.new(), "/", home);
    let router_2 = Router.map_response(router, add_response_context);
    let router_3 = Router.options(router_2, "/", home);
    let router_4 = Router.overload(router_3, Atom["reject"], 64);
    let router_5 = Router.lifecycle(router_4, lifecycle_policy);
    let router_6 = Router.sse(router_5, "/events", Sse.endpoint_with_keep_alive(16, 4_096, 15_000));
    let router_7 = Router.websocket(router_6, "/socket", WebSocket.endpoint(16, 4_096));
    let router_8 = Router.group(router_7, "/users", users);
    let router_9 = Router.fallback(router_8, not_found);
    Router.error(router_9, render_error).

@test
pub router_builder_records_route_group_fallback_and_error_steps(): Bool ->
    sample_router() != Router.new().

@test
pub request_pipeline_continues_and_short_circuits_in_order(): Bool ->
    let request = request_fixture("");
    let continued = run_request_pipeline([require_user, require_user], request);
    let stopped = run_request_pipeline([require_user, stop_request, should_not_run], request);
    continued == Atom["continue"]
        and case stopped {
    {Atom["respond"], response} -> response == Response.text("stopped");
    _ -> false
}.

@test
pub response_pipeline_unwinds_in_reverse_order(): Bool ->
    run_response_pipeline([outer_response, inner_response], request_fixture(""), Response.text("start")) == Response.text("done").
