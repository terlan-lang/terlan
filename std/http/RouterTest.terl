module std.http.RouterTest.

import std.http.{Response, Router, Sse, WebSocket}.

import type std.http.Error.HttpError.
import type std.http.Router.{LifecycleDecision, LifecycleEvent, MiddlewareResult}.
import type std.http.{Request, Response, Router}.

pub home(_request: Request): Response ->
    Response.text("home").

pub not_found(_request: Request): Response ->
    Response.text("not found", status = 404).

pub render_error(_error: HttpError): Response ->
    Response.text("error").

pub require_user(_request: Request): MiddlewareResult -> Atom["continue"].

pub add_response_context(_request: Request, response: Response): Response ->
    response.

pub lifecycle_policy(_event: LifecycleEvent): LifecycleDecision -> Atom["lifecycle_allow"].

pub users(router: Router): Router ->
    router
    |> Router.use(require_user)
    |> Router.get("/:id", home).

pub sample_router(): Router ->
    let router = Router.get(Router.new(), "/", home);
    let router_2 = Router.map_response(router, add_response_context);
    let router_3 = Router.options(router_2, "/", home);
    let router_4 = Router.overload(router_3, Atom["reject"], 64);
    let router_5 = Router.lifecycle(router_4, lifecycle_policy);
    let router_6 = Router.sse(router_5, "/events", Sse.endpoint_with_keep_alive(16, 4096, 15000));
    let router_7 = Router.websocket(router_6, "/socket", WebSocket.endpoint(16, 4096));
    let router_8 = Router.group(router_7, "/users", users);
    let router_9 = Router.fallback(router_8, not_found);
    Router.error(router_9, render_error).

@test
pub router_builder_records_route_group_fallback_and_error_steps(): Bool -> true.
