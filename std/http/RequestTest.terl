module std.http.RequestTest.

import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.test.Test.{assert_equal}.

import type std.core.{Error, Option, Result}.
import type std.data.Json.
import type std.http.Cookies.Jar.
import type std.http.Request.

type InvalidBody = Atom["http.body_json"].

pub accepts_request(value: Request): Request ->
    value.

pub sample_method(request: Request): String ->
    request.method().

pub sample_path(request: Request): String ->
    request.path().

pub sample_param(request: Request): Option[String] ->
    request.param("id").

pub sample_query(request: Request): Option[String] ->
    request.query("page").

pub sample_query_string(request: Request): String ->
    request.query_string().

pub sample_header(request: Request): Option[String] ->
    request.header("accept").

pub sample_cookie(request: Request): Option[String] ->
    request.cookie("session").

pub sample_cookies(request: Request): Jar ->
    request.cookies().

pub sample_body_text(request: Request): String ->
    request.body_text().

pub sample_body_file_path(request: Request): String ->
    request.body_file_path().

pub sample_body_json(request: Request): Result[Json, Error] ->
    request.body_json().

/**
 * Called by the HTTP integration fixture with an actual parsed request.
 */
pub request_accessors_report_expected_values(request: Request): Bool ->
    sample_method(request) == "POST"
        and sample_path(request) == "/items/42"
        and sample_param(request) == Some("42")
        and sample_query(request) == Some("2")
        and sample_header(request) == Some("application/json")
        and sample_cookie(request) == Some("test-session")
        and sample_body_text(request) == "{\"item\":42}".

@compiler.native {std.test.fixture.http_request}
request_fixture(cookie_header: String): Request.

@test
pub request_metadata_accessors_read_fixture_values(): Bool ->
    let request = accepts_request(request_fixture("session=abc123"));
    assert_equal("GET", sample_method(request))
        and assert_equal("/", sample_path(request))
        and assert_equal(None, sample_param(request))
        and assert_equal(None, sample_query(request))
        and assert_equal("", sample_query_string(request)).

@test
pub request_headers_and_cookies_read_fixture_values(): Bool ->
    let request = request_fixture("session=abc123");
    assert_equal(Some("session=abc123"), request.header("COOKIE"))
        and assert_equal(None, sample_header(request))
        and assert_equal(Some("abc123"), sample_cookie(request))
        and assert_equal(Some("abc123"), sample_cookies(request).get("session"))
        and assert_equal(None, sample_cookies(request).get("missing")).

@test
pub empty_request_body_has_no_file_and_rejects_json(): Bool ->
    let request = request_fixture("");
    assert_equal("", sample_body_text(request))
        and assert_equal("", sample_body_file_path(request))
        and case sample_body_json(request) {
    Err(reason) -> reason.code == InvalidBody and reason.message != "";
    Ok(_) -> false
}.
