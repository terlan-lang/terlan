/**
 * Portable HTTP cookie contract.
 *
 * `std.http.Cookies` defines the typed cookie option surface for Terlan HTTP
 * handlers. `Request.cookies()` returns a request-scoped jar that can read
 * incoming cookies and record response cookie mutations. Jar construction and
 * pending headers are source-owned; wire codecs remain native.
 */
module std.http.Cookies.

import std.collections.{Enumerable, List, Map}.
import std.core.Option.{None, Some, is_some, with_default}.
import std.core.{String, Unit}.

import type std.core.Option.

/**
 * Lax represents the default practical SameSite cookie policy.
 *
 * Input: no value input.
 * Output: atom-backed SameSite marker.
 * Transformation: gives cookie option records a stable source-visible policy
 * value without exposing backend header formatting.
 */
pub type Lax.

/**
 * Strict represents the strict SameSite cookie policy.
 *
 * Input: no value input.
 * Output: atom-backed SameSite marker.
 * Transformation: gives cookie option records a stable source-visible policy
 * value without exposing backend header formatting.
 */
pub type Strict.

/**
 * None represents the cross-site SameSite cookie policy.
 *
 * Input: no value input.
 * Output: atom-backed SameSite marker.
 * Transformation: gives cookie option records a stable source-visible policy
 * value without exposing backend header formatting.
 */
pub type None.

/**
 * SameSite represents the supported SameSite cookie policies.
 *
 * Input: no type parameter.
 * Output: one of the supported SameSite policy markers.
 * Transformation: narrows cookie policy values before runtime header
 * serialization and validation.
 */
pub type SameSite = Lax | Strict | None.

/**
 * Options represents optional `Set-Cookie` metadata.
 *
 * Input: no type parameter.
 * Output: typed cookie option record.
 * Transformation: keeps cookie mutation options explicit so the runtime
 * cookie jar can validate and serialize them without changing the source API.
 */
pub struct Options {
    path: Option[String],
    domain: Option[String],
    max_age: Option[Int],
    expires: Option[String],
    http_only: Bool,
    secure: Bool,
    same_site: Option[SameSite],
}.

/**
 * Constructs typed cookie options.
 *
 * Input: optional path/domain/max-age/expires values, practical boolean flags,
 * and an optional SameSite policy.
 * Output: an `Options` record.
 * Transformation: centralizes public construction so callers do not raw-build
 * the `Options` struct outside this module.
 */
pub constructor Options {
    (path: Option[String], domain: Option[String], max_age: Option[Int], expires: Option[String], http_only: Bool, secure: Bool, same_site: Option[SameSite]): Options ->
        Options {
            path: path,
            domain: domain,
            max_age: max_age,
            expires: expires,
            http_only: http_only,
            secure: secure,
            same_site: same_site,
        }
}.

/**
 * Jar represents request-scoped cookie state.
 *
 * Input: no type parameter.
 * Output: a source-owned snapshot of incoming cookies and pending headers.
 * Transformation: lets handlers read incoming cookies and record outgoing
 * cookie mutations without manually threading response headers.
 */
pub struct Jar {
    #incoming: Map[String, String],
    #pending: List[String],
}.

/**
 * Creates a jar from already decoded incoming cookies.
 *
 * Each call starts with no pending response headers. Mutations retain this
 * incoming snapshot; use Response.with_cookies to apply pending headers.
 */
pub from_map(incoming: Map[String, String]): Jar ->
    Jar {#incoming: incoming, #pending: []}.

/**
 * Creates a jar from ordered, decoded cookie pairs.
 *
 * The first value for each case-sensitive name wins, including empty values.
 * Source owns this precedence; the maintained parser preserves all pairs.
 */
pub from_pairs(incoming: List[{String, String}]): Jar ->
    from_map(
        Enumerable[List].fold(
            incoming,
            Map.new[String, String](),
            (values, pair) ->
                let {name, value} = pair;
                if {
                    values.contains_key(name) -> values;
                    true -> (values.put(name, value); values)
                },
        ),
    ).

/**
 * Returns pending response headers.
 *
 * Input: one cookie jar receiver.
 * Output: serialized cookie mutations in insertion order.
 * Transformation: exposes an immutable snapshot for response composition.
 */
pub (jar: Jar) headers(): List[String] ->
    jar.#pending.

/**
 * Returns an incoming cookie value.
 *
 * Input: one cookie jar receiver and one cookie name.
 * Output: `Some(value)` when the request included a cookie named `name`,
 * otherwise `None`.
 * Transformation: reads parsed request-cookie metadata from the source-owned
 * jar without exposing the raw `Cookie` header.
 */
pub (jar: Jar) get(name: String): Option[String] ->
    jar.#incoming.get(name).

/**
 * Records a response cookie mutation.
 *
 * Input: one mutable cookie jar receiver, cookie name, cookie value, optional
 * path, and practical boolean flags.
 * Output: `Unit`.
 * Transformation: validates and serializes the mutation through the HTTP
 * adapter so the server can apply the resulting `Set-Cookie` header to the
 * returned response.
 */
pub (mut jar: Jar) set(
    name: String,
    value: String,
    path: String = "/",
    http_only: Bool = false,
    secure: Bool = false,
): Unit ->
    let header = set_header(name, value, path, http_only, secure);
    Jar {#incoming: jar.#incoming, #pending: jar.#pending.concat([header])}.

/**
 * Records a response cookie deletion.
 *
 * Input: one mutable cookie jar receiver, cookie name, and optional path.
 * Output: `Unit`.
 * Transformation: validates the cookie name/path and records an expiring
 * `Set-Cookie` mutation through the HTTP adapter.
 */
pub (mut jar: Jar) delete(name: String, path: String = "/"): Unit ->
    let header = delete_header(name, path);
    Jar {#incoming: jar.#incoming, #pending: jar.#pending.concat([header])}.

/**
 * Builds a `Set-Cookie` header value.
 *
 * Input: cookie name, cookie value, optional path, and practical boolean
 * flags.
 * Output: serialized `Set-Cookie` header value.
 * Transformation: selects omitted optional attributes in source, then delegates
 * validation and serialization to the maintained native cookie codec.
 */
pub set_header(
    name: String,
    value: String,
    path: String = "/",
    http_only: Bool = false,
    secure: Bool = false,
): String ->
    set_header_with_options(name, value, path, "", 0, false, "", http_only, secure, "").

/**
 * Builds a `Set-Cookie` header value with the full option surface.
 *
 * Input: cookie name, cookie value, path, optional domain text, `Max-Age`
 * seconds plus an inclusion flag, optional expires text, practical boolean
 * flags, and optional SameSite text (`"lax"`, `"strict"`, `"none"`, or empty
 * string).
 * Output: serialized `Set-Cookie` header value.
 * Transformation: delegates validation and deterministic serialization to the
 * native cookie codec. Typed `Options` values use `set_header_options` to
 * project into this boundary; wrappers do not assemble wire headers.
 */
pub set_header_with_options(
    name: String,
    value: String,
    path: String = "/",
    domain: String = "",
    max_age: Int = 0,
    include_max_age: Bool = false,
    expires: String = "",
    http_only: Bool = false,
    secure: Bool = false,
    same_site: String = "",
): String ->
    encode(
        name,
        value,
        path,
        optional_text(domain),
        if {
            include_max_age -> Some(max_age);
            true -> None
        },
        optional_text(expires),
        http_only,
        secure,
        optional_text(same_site.lowercase()),
    ).

optional_text(value: String): Option[String] ->
    if {
        value == "" -> None;
        true -> Some(value)
    }.

/**
 * Serializes explicit attributes through the maintained cookie codec.
 * Source selects omission and normalizes policy text before this boundary.
 * Native code validates every supplied attribute before emitting wire text.
 */
@compiler.native {std.http.cookies.encode}
encode(
    name: String,
    value: String,
    path: String,
    domain: Option[String],
    max_age: Option[Int],
    expires: Option[String],
    http_only: Bool,
    secure: Bool,
    same_site: Option[String],
): String ->
    native.

/**
 * Builds a `Set-Cookie` header value from typed options.
 *
 * Input: cookie name, cookie value, and one typed `Options` record.
 * Output: serialized `Set-Cookie` header value.
 * Transformation: projects the typed option record into the current Rust HTTP
 * adapter call shape, preserving `None` as an omitted header attribute and
 * converting `SameSite` markers into the adapter's string vocabulary.
 */
pub set_header_options(name: String, value: String, options: Options): String ->
    set_header_with_options(
        name,
        value,
        with_default(options.path, "/"),
        with_default(options.domain, ""),
        with_default(options.max_age, 0),
        is_some(options.max_age),
        with_default(options.expires, ""),
        options.http_only,
        options.secure,
        same_site_to_string(options.same_site),
    ).

/**
 * Converts optional SameSite policy into runtime header text.
 *
 * Input: optional `SameSite` marker.
 * Output: `"lax"`, `"strict"`, `"none"`, or an empty string when omitted.
 * Transformation: maps source-level policy atoms to the conservative text
 * vocabulary accepted by the Rust HTTP adapter.
 */
same_site_to_string(value: Option[SameSite]): String ->
    case value {
        None -> "";
        Some(Lax) -> "lax";
        Some(Strict) -> "strict";
        Some(None) -> "none"
    }.

/**
 * Builds an expiring `Set-Cookie` header value.
 *
 * Input: cookie name and optional path.
 * Output: serialized `Set-Cookie` header value that expires the cookie.
 * Transformation: source selects an empty value, zero Max-Age, and epoch
 * expiry, then uses the same maintained serializer as other cookie headers.
 */
pub delete_header(name: String, path: String = "/"): String ->
    set_header_with_options(
        name,
        "",
        path,
        "",
        0,
        true,
        "Thu, 01 Jan 1970 00:00:00 GMT",
        false,
        false,
        "",
    ).
