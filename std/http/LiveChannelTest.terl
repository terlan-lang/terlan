module std.http.LiveChannelTest.

import std.http.{Response, Router, Sse, WebSocket}.
import std.test.Test.{assert}.

import type std.http.Router.MiddlewareResult.
import type std.http.{Request, Response, Router}.

pub home(_request: Request): Response ->
    Response.html("<main>live</main>").

pub require_user(_request: Request): MiddlewareResult -> Atom["continue"].

pub counter_events_response(): Response ->
    Sse.response([Sse.data("counter:1").with_id("1").with_name("counter").with_retry_ms(1500), Sse.data("counter:2").with_id("2").with_name("counter")]).

pub counter_events(_request: Request): Response ->
    counter_events_response().

pub live_channels(router: Router): Router ->
    let router = Router.use(router, require_user);
    let router = Router.sse(router, "/events/counter", Sse.endpoint_with_keep_alive(32, 8192, 10000));
    Router.websocket(router, "/ws/counter", WebSocket.endpoint(32, 8192)).

pub application_router(): Router ->
    let router = Router.get(Router.new(), "/", home);
    Router.group(router, "/live", live_channels).

pub live_channel_router_has_expected_shape(value: Dynamic): Bool ->
    case value {
        {tag, {get_tag, get_path, _home}, {group_tag, group_prefix, _builder}} ->
            tag == Atom["router"] and get_tag == Atom["get"] and get_path == "/" and group_tag == Atom["group"] and group_prefix == "/live";
        _ -> false
    }.

pub sse_live_response_has_events(value: Dynamic): Bool ->
    case value {
        {tag, kind, events, status} ->
            tag == Atom["response"] and kind == Atom["sse"] and status == 200 and events == [Sse.data("counter:1").with_id("1").with_name("counter").with_retry_ms(1500), Sse.data("counter:2").with_id("2").with_name("counter")];
        _ -> false
    }.

pub live_channel_group_has_endpoint_steps(value: Dynamic): Bool ->
    case value {
        {tag, {use_tag, _middleware}, {sse_tag, sse_path, sse_endpoint}, {websocket_tag, websocket_path, websocket_endpoint}} ->
            tag == Atom["router"] and use_tag == Atom["use"] and sse_tag == Atom["sse"] and sse_path == "/events/counter" and sse_endpoint == Sse.endpoint_with_keep_alive(32, 8192, 10000) and websocket_tag == Atom["websocket"] and websocket_path == "/ws/counter" and websocket_endpoint == WebSocket.endpoint(32, 8192);
        _ -> false
    }.

@test
pub live_channel_router_records_grouped_channel_routes(): Bool ->
    assert(live_channel_router_has_expected_shape(application_router())).

@test
pub live_channel_sse_handler_records_queued_events(): Bool ->
    assert(sse_live_response_has_events(counter_events_response())).

@test
pub live_channel_group_records_sse_and_websocket_endpoints(): Bool ->
    assert(live_channel_group_has_endpoint_steps(live_channels(Router.new()))).
