module std.http.LiveChannelTest.

import std.http.{Response, Router, Sse, WebSocket}.

import type std.http.Router.MiddlewareResult.
import type std.http.{Request, Response, Router}.

pub home(_request: Request): Response ->
    Response.html("<main>live</main>").

pub require_user(_request: Request): MiddlewareResult -> Atom["continue"].

pub counter_events_response(): Response ->
    Sse.response(
        [
            Sse.data("counter:1").with_id("1").with_name("counter").with_retry_ms(1_500),
            Sse.data("counter:2").with_id("2").with_name("counter"),
        ],
    ).

pub counter_events(_request: Request): Response ->
    counter_events_response().

pub live_channels(router: Router): Router ->
    let routed = Router.use(router, require_user);
    let routed_2 = Router.sse(routed, "/events/counter", Sse.endpoint_with_keep_alive(32, 8_192, 10_000));
    Router.websocket(routed_2, "/ws/counter", WebSocket.endpoint(32, 8_192)).

pub application_router(): Router ->
    let router = Router.get(Router.new(), "/", home);
    Router.group(router, "/live", live_channels).

@test
pub live_channel_sse_handler_records_queued_events(): Bool ->
    counter_events_response() == Response.stream(
    [
        "id: 1\nevent: counter\nretry: 1500\ndata: counter:1\n\n",
        "id: 2\nevent: counter\ndata: counter:2\n\n",
    ],
    200,
    "text/event-stream; charset=utf-8",
    16_384,
    128,
).

@test
pub live_channel_group_records_sse_and_websocket_endpoints(): Bool ->
    let empty = Router.new();
    let sse_only =
        Router.sse(
            Router.use(empty, require_user),
            "/events/counter",
            Sse.endpoint_with_keep_alive(32, 8_192, 10_000),
        );
    let channels = live_channels(empty);
    channels != empty
        and channels != sse_only
        and application_router() != Router.get(Router.new(), "/", home).
