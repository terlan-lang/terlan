/**
 * Portable HTTP session contract.
 *
 * `std.http.Session` exposes actor-backed session helpers used by Terlan HTTP
 * handlers. The HTTP server binds request cookies to VM session actor
 * identity; source code owns the private session record and explicit response
 * threading, identity retry, and lifetime policy. Native operations supply
 * entropy and atomically reserve or replace source-selected identities.
 */
module std.http.Session.

import std.core.Option.{None, Some}.
import std.core.{Effect, String, Unit}.
import std.crypto.Entropy.
import std.encoding.Base64.
import std.http.Cookies.{delete_header, set_header_with_options}.
import std.http.{Request, Response}.

import type std.core.Option.
import type std.http.{Request, Response}.

/**
 * Session represents a source-owned reference to an HTTP session actor.
 *
 * Input: no type parameter.
 * Output: a managed record with private identity, pending-cookie, and lifetime fields.
 * Transformation: hides actor ids, VM table ids, sticky routing metadata, and
 * recovery policy while preserving a stable handler-facing session value.
 */
pub struct Session {
    #identity: String,
    #pending_identity: String,
    #ttl_seconds: Int,
}.

/**
 * Returns the current request session.
 *
 * Input: one HTTP `Request`.
 * Output: the VM-owned session actor bound to the request cookie, creating one
 * when the request has no valid session cookie.
 * Transformation: selects a cookie identity, reuses a live lookup, and requests
 * fresh allocation only on absence. Storage errors propagate without replacement.
 */
pub current(request: Request): Session ->
    let ttl_seconds = 86400;
    let requested =
        case request.cookie("terlan_session") {
            Some(value) -> value.trim();
            None -> ""
        };
    let identity =
        case lookup(requested) {
            Some(existing) -> existing;
            None -> create(requested, ttl_seconds)
        };
    let pending =
        if {
            identity == requested -> "";
            true -> identity
        };
    Session {#identity: identity, #pending_identity: pending, #ttl_seconds: ttl_seconds}.

@compiler.native
lookup(identity: String): Option[String].

create(excluded_identity: String, ttl_seconds: Int): String ->
    allocate(excluded_identity, ttl_seconds, false, 16).

/**
 * Shares bounded identity selection between allocation and rotation. Only
 * explicit collisions retry; entropy and storage failures propagate. The
 * excluded cookie or old identity is never submitted as its replacement.
 */
allocate(excluded_identity: String, ttl_seconds: Int, rotating: Bool, attempts: Int): String ->
    if {
        attempts == 0 -> Effect.run(identity_failure());
        true -> let identity = candidate(32);
        let accepted =
            if {
                identity == excluded_identity -> false;
                rotating -> try_rotate(excluded_identity, identity, ttl_seconds);
                true -> try_create(identity, ttl_seconds)
            };
        if {
            accepted -> identity;
            true -> allocate(excluded_identity, ttl_seconds, rotating, attempts - 1)
        }
    }.

identity_failure(): Effect[String] ->
    Effect.fail(
        "error[http.session.identity_collision]: could not allocate a distinct session identity",
    ).

candidate(byte_count: Int): String ->
    Base64.encode_url_unpadded_bytes(Entropy.bytes(byte_count)).

@compiler.native
try_create(identity: String, ttl_seconds: Int): Bool.

/**
 * Reads one session value.
 *
 * Input: one `Session` receiver and one string key.
 * Output: `Some(value)` when the session contains `key`, otherwise `None`.
 * Transformation: reads VM table state owned by the session actor without
 * exposing the backing table handle.
 */
pub (session: Session) get(key: String): Option[String] ->
    read(session.#identity, key).

@compiler.native {std.http.session.get}
read(identity: String, key: String): Option[String].

/**
 * Writes one session value.
 *
 * Input: one mutable `Session` receiver, one string key, and one string value.
 * Output: `Unit`.
 * Transformation: updates VM table state through the session actor boundary.
 */
pub (mut session: Session) set(key: String, value: String): Unit ->
    let _written = write(session.#identity, key, value);
    session.

@compiler.native {std.http.session.set}
write(identity: String, key: String, value: String): Unit.

/**
 * Deletes one session value.
 *
 * Input: one mutable `Session` receiver and one string key.
 * Output: `Unit`.
 * Transformation: removes VM table state through the session actor boundary.
 */
pub (mut session: Session) delete(key: String): Unit ->
    let _removed = remove(session.#identity, key);
    session.

@compiler.native {std.http.session.delete}
remove(identity: String, key: String): Unit.

/**
 * Rotates the session id.
 *
 * Input: one mutable `Session` receiver.
 * Output: the same VM session actor with a new public session id.
 * Transformation: preserves actor-owned table state while requiring the HTTP
 * runtime to thread a replacement session cookie into the response.
 */
pub (mut session: Session) rotate(): Session ->
    let identity = renew(session.#identity, session.#ttl_seconds);
    Session {#identity: identity, #pending_identity: identity, #ttl_seconds: session.#ttl_seconds}.

renew(identity: String, ttl_seconds: Int): String ->
    allocate(identity, ttl_seconds, true, 16).

@compiler.native
try_rotate(identity: String, replacement: String, ttl_seconds: Int): Bool.

/**
 * Expires the session.
 *
 * Input: one mutable `Session` receiver.
 * Output: `Unit`.
 * Transformation: requests cleanup of the VM session actor and its owned table
 * state; future use of the stale handle must fail through runtime diagnostics.
 */
pub (mut session: Session) expire(): Unit ->
    let _expired = invalidate(session.#identity);
    session.

@compiler.native {std.http.session.expire}
invalidate(identity: String): Unit.

/**
 * Threads session response metadata onto a response.
 *
 * Input: one `Response` and one `Session`.
 * Output: a `Response` carrying any required session cookie mutation.
 * Transformation: makes response cookie threading explicit so handler code does
 * not depend on implicit global response state.
 */
pub with_response(response: Response, session: Session): Response ->
    case response_cookie(session) {
        None -> response;
        Some(header) ->
            let _attached = response.set_cookie_header(header);
            response
    }.

response_cookie(session: Session): Option[String] ->
    case live_identity(session) {
        Some("") -> None;
        Some(identity) ->
            Some(
                set_header_with_options(
                    "terlan_session",
                    identity,
                    "/",
                    "",
                    0,
                    false,
                    "",
                    true,
                    true,
                    "Lax",
                ),
            );
        None -> Some(delete_header("terlan_session", "/"))
    }.

/**
 * Combines an atomic liveness check with the immutable source pending identity.
 *
 * A live session returns its pending identity, including an empty string
 * when no replacement is pending. An expired identity returns None. Source
 * owns the cookie name, attributes, omission, and deletion policy.
 */
live_identity(session: Session): Option[String] ->
    if {
        is_live(session.#identity) -> Some(session.#pending_identity);
        true -> None
    }.

@compiler.native
is_live(identity: String): Bool.
