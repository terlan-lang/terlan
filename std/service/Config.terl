/**
 * Typed references to authoritative Terlan configuration and secrets.
 */
module std.service.Config.

pub struct ValueRef[T] {
    name: String,
}.

/**
 * SecretRef has no display or structured-field conversion surface.
 */
pub struct SecretRef {
    name: String,
}.

pub value(name: String): ValueRef[String] ->
    ValueRef(name = name).

pub secret(name: String): SecretRef ->
    SecretRef(name = name).
