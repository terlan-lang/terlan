module std.sync.ResourceTest.

import std.sync.Resource.
import std.test.Test.{assert_equal}.

import type std.sync.Resource.{Change, ChangeKind, Deleted, Inserted, Resource, Updated}.

pub accepts_resource(value: Resource[Int]): Resource[Int] ->
    value.

pub accepts_change_kind(value: ChangeKind): ChangeKind ->
    value.

pub accepts_change(value: Change[Int]): Change[Int] ->
    value.

pub builds_inserted_change(): Change[Int] ->
    Resource.inserted(1).

pub builds_updated_change(): Change[Int] ->
    Resource.updated(1).

pub builds_deleted_change(): Change[Int] ->
    Resource.deleted(1).

pub reads_change_kind(value: Change[Int]): ChangeKind ->
    Resource.kind(value).

pub reads_change_value(value: Change[Int]): Int ->
    Resource.value(value).

@test
pub inserted_change_has_kind_and_value(): Bool ->
    assert_equal(Inserted, Resource.kind(Resource.inserted(1))) and assert_equal(1, Resource.value(Resource.inserted(1))).

@test
pub updated_and_deleted_changes_have_expected_kinds(): Bool ->
    assert_equal(Updated, Resource.kind(Resource.updated(2))) and assert_equal(Deleted, Resource.kind(Resource.deleted(3))).
