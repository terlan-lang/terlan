module std.core.FloatTest.

import std.core.Float.{abs, acos, acosh, asin, asinh, atan, atan2, atanh, cbrt, ceil, clamp, compare, cos, cosh, degrees, e, equal, exp, exp2, expm1, floor, fract, from_string, hypot, ln10, ln2, log, log10, log1p, log2, log_base, max, min, pi, pow, radians, reciprocal, remainder, root, round, signum, sin, sinh, sqrt, sqrt2, sqrt_half, square, tan, tanh, tau, to_string, trunc}.
import std.core.Option.{None, Some}.
import std.core.Ordering.{Eq, Gt, Lt}.
import std.test.Test.{assert, assert_equal, assert_false}.

import type std.core.Option.
import type std.core.Ordering.Comparison.

pub ordering_compare(left: Float, right: Float): Comparison ->
    compare(left, right).

pub exact_int(value: Float): Option[Int] ->
    value.to_int_exact().

@test
pub equal_accepts_matching_floats(): Bool ->
    assert(equal(1.5, 1.5)).

@test
pub equal_rejects_different_floats(): Bool ->
    assert_false(equal(1.5, 2.5)).

@test
pub min_returns_smaller_float(): Bool ->
    assert_equal(1.5, min(1.5, 2.25)).

@test
pub min_accepts_equal_floats(): Bool ->
    assert_equal(1.5, min(1.5, 1.5)).

@test
pub max_returns_larger_float(): Bool ->
    assert_equal(2.25, max(1.5, 2.25)).

@test
pub max_accepts_equal_floats(): Bool ->
    assert_equal(2.25, max(2.25, 2.25)).

@test
pub abs_keeps_positive_float(): Bool ->
    assert_equal(2.25, abs(2.25)).

@test
pub abs_flips_negative_float(): Bool ->
    assert_equal(2.25, abs(-2.25)).

@test
pub compare_orders_smaller_float_first(): Bool ->
    assert_equal(Lt, compare(1.5, 2.25)).

@test
pub compare_orders_larger_float_after(): Bool ->
    assert_equal(Gt, compare(2.25, 1.5)).

@test
pub compare_accepts_equal_floats(): Bool ->
    assert_equal(Eq, compare(-2.25, -2.25)).

@test
pub ordering_trait_orders_smaller_float_first(): Bool ->
    assert_equal(Lt, ordering_compare(1.5, 2.25)).

@test
pub ordering_trait_orders_larger_float_after(): Bool ->
    assert_equal(Gt, ordering_compare(2.25, 1.5)).

@test
pub to_string_renders_positive_float(): Bool ->
    assert_equal("1.5", to_string(1.5)).

@test
pub to_string_renders_negative_float(): Bool ->
    assert_equal("-2.25", to_string(-2.25)).

@test
pub from_string_parses_positive_float(): Bool ->
    case from_string("1.5") {
        Some(value) -> assert_equal(1.5, value);
        None -> false
    }.

@test
pub from_string_parses_negative_float(): Bool ->
    case from_string("-2.25") {
        Some(value) -> assert_equal(-2.25, value);
        None -> false
    }.

@test
pub from_string_rejects_unknown_text(): Bool ->
    case from_string("nope") {
        None -> true;
        Some(_value) -> false
    }.

@test
pub from_string_accepts_decimal_underflow_as_zero(): Bool ->
    case from_string("1.0e-325") {
        Some(value) -> assert_equal(0.0, value);
        None -> false
    }.

@test
pub from_string_rejects_non_finite_decimal_overflow(): Bool ->
    case from_string("1.0e83291083210") {
        None -> true;
        Some(_value) -> false
    }.

@test
pub floor_rounds_toward_negative_infinity(): Bool ->
    assert_equal(-43.0, floor(-42.1))
        and assert_equal(10.0, floor(10.9))
        and assert_equal(-533.0, floor(-533.0)).

@test
pub ceil_rounds_toward_positive_infinity(): Bool ->
    assert_equal(-42.0, ceil(-42.1))
        and assert_equal(11.0, ceil(10.9))
        and assert_equal(453555.0, ceil(453555.0)).

@test
pub log_returns_natural_logarithm(): Bool ->
    assert_equal(0.0, log(1.0)).

@test
pub atan_returns_principal_radians(): Bool ->
    assert_equal(0.0, atan(0.0)) and assert_equal(0.7853981633974483, atan(1.0)).

@test
pub sqrt_returns_principal_nonnegative_root(): Bool ->
    assert_equal(0.0, sqrt(0.0))
        and assert_equal(3.0, sqrt(9.0))
        and assert_equal(1.4142135623730951, sqrt(2.0)).

@test
pub to_int_exact_accepts_integral_in_range_values(): Bool ->
    when {
        Some(42) <- exact_int(42.0);
        Some(value) <- exact_int(-9000000000000000000.0)
    } else {
        _ -> false
    };
    value == -9_000_000_000_000_000_000.

@test
pub to_int_exact_rejects_fractional_values(): Bool ->
    case exact_int(42.5) {
        None -> true;
        _ -> false
    }.

@test
pub to_int_exact_rejects_values_above_int_range(): Bool ->
    case exact_int(9223372036854776000.0) {
        None -> true;
        _ -> false
    }.

@test
pub graphing_calculator_float_surface_is_native(): Bool ->
    assert_equal(3.0, round(2.5))
        and assert_equal(-2.0, trunc(-2.9))
        and assert_equal(1.0, exp(0.0))
        and assert_equal(3.0, log2(8.0))
        and assert_equal(2.0, log10(100.0))
        and assert_equal(3.0, cbrt(27.0))
        and assert_equal(0.0, sin(0.0))
        and assert_equal(1.0, cos(0.0))
        and assert_equal(0.0, tan(0.0))
        and assert_equal(0.0, asin(0.0))
        and assert_equal(0.0, acos(1.0))
        and assert_equal(0.0, sinh(0.0))
        and assert_equal(1.0, cosh(0.0))
        and assert_equal(0.0, tanh(0.0))
        and assert_equal(0.0, asinh(0.0))
        and assert_equal(0.0, acosh(1.0))
        and assert_equal(0.0, atanh(0.0))
        and assert_equal(8.0, exp2(3.0))
        and assert_equal(1e-16, expm1(1e-16))
        and assert_equal(1e-16, log1p(1e-16))
        and assert_equal(1024.0, pow(2.0, 10.0))
        and assert_equal(0.0, atan2(0.0, 1.0))
        and assert_equal(5.0, hypot(3.0, 4.0)).

@test
pub mathematical_constants_are_binary64_values(): Bool ->
    assert_equal(2.718281828459045, e())
        and assert_equal(3.141592653589793, pi())
        and assert_equal(6.283185307179586, tau())
        and assert_equal(0.6931471805599453, ln2())
        and assert_equal(2.302585092994046, ln10())
        and assert_equal(1.4142135623730951, sqrt2())
        and assert_equal(0.7071067811865476, sqrt_half()).

@test
pub angle_units_convert_explicitly(): Bool ->
    assert_equal(3.141592653589793, radians(180.0))
        and assert_equal(180.0, degrees(3.141592653589793)).

@test
pub derived_power_and_log_operations_are_complete(): Bool ->
    assert_equal(9.0, square(-3.0))
        and assert_equal(0.25, reciprocal(4.0))
        and assert_equal(3.0, log_base(8.0, 2.0))
        and assert_equal(3.0, root(81.0, 4.0)).

@test
pub fractional_calculator_operations_are_complete(): Bool ->
    assert_equal(0.75, fract(2.75))
        and assert_equal(-0.75, fract(-2.75))
        and assert_equal(1.5, remainder(7.5, 2.0))
        and assert_equal(-1.5, remainder(-7.5, 2.0)).

@test
pub signum_covers_negative_zero_and_positive_values(): Bool ->
    assert_equal(-1.0, signum(-2.75))
        and assert_equal(0.0, signum(0.0))
        and assert_equal(1.0, signum(2.75)).

@test
pub clamp_constrains_values(): Bool ->
    case clamp(12.0, 0.0, 10.0) {
        Some(value) -> assert_equal(10.0, value);
        None -> false
    }.

@test
pub clamp_rejects_reversed_bounds(): Bool ->
    case clamp(5.0, 10.0, 0.0) {
        None -> true;
        Some(_invalid) -> false
    }.
