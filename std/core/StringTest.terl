module std.core.StringTest.

import std.core.Option.{None, Some}.
import std.core.Ordering.{Eq, Gt, Lt, Ordering}.
import std.test.Test.{assert, assert_equal, each_result, row}.

import type std.collections.List.
import type std.core.Ordering.Comparison.
import type std.test.Test.{Row}.

pub ordering_compare(left: String, right: String): Comparison ->
    Ordering.compare(left, right).

pub show_unit(value: Unit): String ->
    std.core.Unit.to_string(value).

@test
pub equal_accepts_matching_values(): Bool ->
    assert("hello".equal("hello")).

@test
pub equal_rejects_different_values(): Bool ->
    assert_equal(false, "hello".equal("world")).

@test
pub compare_orders_earlier_text_first(): Bool ->
    assert_equal(Lt, "alpha".compare("beta")).

@test
pub compare_orders_later_text_after(): Bool ->
    assert_equal(Gt, "beta".compare("alpha")).

@test
pub compare_accepts_equal_text(): Bool ->
    assert_equal(Eq, "hello".compare("hello")).

@test
pub ordering_trait_orders_earlier_text_first(): Bool ->
    assert_equal(Lt, ordering_compare("alpha", "beta")).

@test
pub ordering_trait_orders_later_text_after(): Bool ->
    assert_equal(Gt, ordering_compare("beta", "alpha")).

@test
pub to_string_returns_input(): Bool ->
    assert_equal("hello", "hello".to_string()).

@test
pub from_string_returns_input(): Bool ->
    case "hello".from_string() {
        Some(value) -> assert_equal("hello", value);
        None -> false
    }.

@test
pub show_trait_renders_unit(): Bool ->
    assert_equal("unit", show_unit(Unit)).

@test
pub is_empty_accepts_empty_string(): Bool ->
    assert("".is_empty()).

@test
pub is_empty_rejects_non_empty_string(): Bool ->
    assert_equal(false, "hello".is_empty()).

@test
pub append_joins_two_strings(): Bool ->
    assert_equal("helloworld", "hello".append("world")).

@test
pub concat_joins_string_list(): Bool ->
    assert_equal("helloworld", std.core.String.concat(["hello", "world"])).

@test
pub contains_accepts_present_pattern(): Bool ->
    assert("hello".contains("ell")).

@test
pub contains_rejects_missing_pattern(): Bool ->
    assert_equal(false, "hello".contains("xyz")).

@test
pub starts_with_accepts_prefix(): Bool ->
    assert("hello".starts_with("he")).

@test
pub starts_with_rejects_non_prefix(): Bool ->
    assert_equal(false, "hello".starts_with("lo")).

@test
pub ends_with_accepts_suffix(): Bool ->
    assert("hello".ends_with("lo")).

@test
pub ends_with_accepts_empty_suffix(): Bool ->
    assert("hello".ends_with("")).

@test
pub ends_with_rejects_non_suffix(): Bool ->
    assert_equal(false, "hello".ends_with("he")).

@test
pub length_rows_count_text_units(): Bool ->
    each_result(length_boundary_rows(), (value) -> value.length()).

@test
pub byte_size_rows_count_utf8_bytes(): Bool ->
    each_result(byte_size_boundary_rows(), (value) -> value.byte_size()).

@test
pub direct_length_counts_unicode_scalars(): Bool ->
    assert_equal(2, std.core.String.length("éx")).

@test
pub direct_byte_size_counts_utf8_bytes(): Bool ->
    assert_equal(3, std.core.String.byte_size("éx")).

@test
pub lowercase_converts_ascii_text(): Bool ->
    assert_equal("hello", "HELLO".lowercase()).

@test
pub uppercase_converts_ascii_text(): Bool ->
    assert_equal("HELLO", "hello".uppercase()).

@test
pub reverse_reorders_text_units(): Bool ->
    assert_equal("olleh", "hello".reverse()).

@test
pub reverse_preserves_utf8_text_units(): Bool ->
    assert_equal("bå", "åb".reverse()).

@test
pub characters_returns_unicode_scalars_in_order(): Bool ->
    case "aé🙂".characters() {
        ["a", "é", "🙂"] -> true;
        _ -> false
    }.

@test
pub characters_accepts_empty_string(): Bool ->
    case "".characters() {
        [] -> true;
        _ -> false
    }.

@test
pub codepoints_returns_unicode_scalar_numbers_in_order(): Bool ->
    assert_equal([97, 233, 128578], "aé🙂".codepoints()).

@test
pub codepoints_accepts_empty_string(): Bool ->
    assert_equal([], "".codepoints()).

@test
pub utf8_byte_at_reads_encoded_octets(): Bool ->
    assert_equal(195, "éx".utf8_byte_at(0)) and assert_equal(169, "éx".utf8_byte_at(1)).

@test
pub utf8_find_any_byte_returns_byte_offsets_without_splitting_unicode(): Bool ->
    assert_equal(6, "λ🔥 alpha\nnext".utf8_find_any_byte(0, " /\n"))
        and assert_equal(12, "λ🔥 alpha\nnext".utf8_find_any_byte(7, " /\n"))
        and assert_equal(-1, "λ🔥 alpha\nnext".utf8_find_any_byte(13, " /\n")).

@test
pub utf8_slice_preserves_valid_scalar_boundaries(): Bool ->
    assert_equal("é", "aéx".utf8_slice(1, 2)).

@test
pub trim_removes_surrounding_whitespace(): Bool ->
    assert_equal("hello", " hello ".trim()).

@test
pub trim_start_removes_leading_whitespace(): Bool ->
    assert_equal("hello ", " hello ".trim_start()).

@test
pub trim_end_removes_trailing_whitespace(): Bool ->
    assert_equal(" hello", " hello ".trim_end()).

@test
pub replace_rewrites_all_matches(): Bool ->
    assert_equal("hexxo", "hello".replace("l", "x")).

@test
pub replace_keeps_text_without_match(): Bool ->
    assert_equal("hello", "hello".replace("z", "x")).

@test
pub split_returns_all_segments(): Bool ->
    assert_equal(["he", "", "o"], "hello".split("l")).

@test
pub split_once_returns_first_split(): Bool ->
    case "hello".split_once("l") {
        Some(value) -> assert_equal({"he", "lo"}, value);
        None -> false
    }.

@test
pub split_once_rejects_missing_separator(): Bool ->
    case "hello".split_once("z") {
        None -> true;
        Some(_value) -> false
    }.

length_boundary_rows(): List[Row[String, Int]] ->
    [row("empty", "", 0), row("ascii", "hello", 5), row("utf8", "åb", 2)].

byte_size_boundary_rows(): List[Row[String, Int]] ->
    [row("empty", "", 0), row("ascii", "hello", 5), row("utf8", "åb", 3)].
