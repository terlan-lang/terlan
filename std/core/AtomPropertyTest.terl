/**
 * Property-based Atom invariants.
 *
 * `std.core.AtomPropertyTest` validates finite generated atom values against
 * the public Atom API without introducing runtime text-to-atom construction.
 */
module std.core.AtomPropertyTest.

import std.core.Atom.{equal, to_string}.
import std.test.Gen.{atoms, for_all}.
import std.test.Test.{each}.

/**
 * Verifies equality is reflexive for generated atoms.
 *
 * Input: generated finite atom values.
 * Output: `true` when every generated atom equals itself.
 * Transformation: checks the public Atom equality helper over generated input.
 */
@test
pub generated_atoms_equal_is_reflexive(): Bool ->
    for_all(atoms(), (value) -> equal(value, value)).

/**
 * Verifies generated atoms render to the finite generator payload set.
 *
 * Input: generated finite atom values.
 * Output: `true` when every generated atom renders as `"ok"` or `"error"`.
 * Transformation: checks the canonical payload text for the public generator
 * domain.
 */
@test
pub generated_atoms_render_known_payloads(): Bool ->
    for_all(
        atoms(),
        (value) ->
            let rendered = to_string(value);
            rendered == "ok" or rendered == "error",
    ).

/**
 * Verifies atom equality agrees with rendered payload equality.
 *
 * Input: generated finite atom pairs.
 * Output: `true` when `Atom.equal` matches canonical payload equality.
 * Transformation: checks equality consistency without creating atoms from
 * runtime text.
 */
@test
pub generated_atom_pairs_equal_when_payloads_match(): Bool ->
    for_all(
        atoms(),
        (left) ->
            for_all(
                atoms(),
                (right) ->
                    case equal(left, right) {
                        true -> to_string(left) == to_string(right);
                        false -> to_string(left) != to_string(right)
                    },
            ),
    ).
