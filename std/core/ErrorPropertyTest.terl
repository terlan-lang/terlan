/**
 * Property-based Error invariants.
 *
 * `std.core.ErrorPropertyTest` validates generated `(Atom, String)` pairs through
 * the public Error constructors and readers so the core error shape remains stable
 * under the VM property-testing path.
 */
module std.core.ErrorPropertyTest.

import std.core.Error.{code, message, new, to_string}.
import std.test.Gen.{atoms, for_all, pair_of, strings}.
import std.test.Test.{each}.

/**
 * Verifies constructor readers preserve generated fields exactly.
 *
 * Input: generated atom and message pairs.
 * Output: `true` when code and message readers recover the original fields.
 * Transformation: checks `new`, `code`, and `message` are exact inverses for
 * generated pairs.
 */
@test
pub constructor_preserves_generated_fields(): Bool ->
    for_all(pair_of(atoms(), strings()), (pair) -> case pair {
        {error_code, error_message} ->
            let value = new(error_code, error_message);
            code(value) == error_code and message(value) == error_message
    }).

/**
 * Verifies `to_string` is a message projection for generated errors.
 *
 * Input: generated atom and message pairs.
 * Output: `true` when `to_string` returns the original message.
 * Transformation: validates the display contract for stable error roundtrips.
 */
@test
pub generated_errors_to_string_is_message_projection(): Bool ->
    for_all(pair_of(atoms(), strings()), (pair) -> case pair {
        {error_code, error_message} ->
            let value = new(error_code, error_message);
            to_string(value) == error_message
    }).
