module std.core.OrderingTest.

import std.core.Option.{None, Some}.
import std.core.Ordering.{Eq, Gt, Lt, compare, from_string, to_string}.
import std.test.Test.{assert, assert_equal}.

import type std.core.Ordering.Comparison.

pub less(): Comparison ->
    Lt.

pub equal(): Comparison ->
    Eq.

pub greater(): Comparison ->
    Gt.

@test
pub less_is_lt(): Bool ->
    assert(less() == Lt).

@test
pub equal_is_eq(): Bool ->
    assert(equal() == Eq).

@test
pub greater_is_gt(): Bool ->
    assert(greater() == Gt).

@test
pub compare_orders_lt_before_eq(): Bool ->
    assert_equal(Lt, compare(Lt, Eq)).

@test
pub compare_orders_eq_before_gt(): Bool ->
    assert_equal(Lt, compare(Eq, Gt)).

@test
pub compare_orders_gt_after_eq(): Bool ->
    assert_equal(Gt, compare(Gt, Eq)).

@test
pub compare_orders_eq_after_lt(): Bool ->
    assert_equal(Gt, compare(Eq, Lt)).

@test
pub compare_accepts_equal_comparison_values(): Bool ->
    assert_equal(Eq, compare(Gt, Gt)).

@test
pub to_string_renders_lt(): Bool ->
    assert_equal("lt", to_string(Lt)).

@test
pub to_string_renders_eq(): Bool ->
    assert_equal("eq", to_string(Eq)).

@test
pub to_string_renders_gt(): Bool ->
    assert_equal("gt", to_string(Gt)).

@test
pub from_string_parses_lt(): Bool ->
    case from_string("lt") {
        Some(value) -> assert_equal(Lt, value);
        None -> false
    }.

@test
pub from_string_parses_eq(): Bool ->
    case from_string("eq") {
        Some(value) -> assert_equal(Eq, value);
        None -> false
    }.

@test
pub from_string_parses_gt(): Bool ->
    case from_string("gt") {
        Some(value) -> assert_equal(Gt, value);
        None -> false
    }.

@test
pub from_string_rejects_unknown_text(): Bool ->
    case from_string("equal") {
        None -> true;
        Some(_value) -> false
    }.
