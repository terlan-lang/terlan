module std.core.OptionTest.

import std.core.Int.
import std.core.Option.{None, Some, compare, is_none, is_some, with_default}.
import std.core.Ordering.{Eq, Gt, Lt}.
import std.core.Result.{Err, Ok}.
import std.test.Test.{assert, assert_equal}.

import type std.core.Ordering.{Comparison}.
import type std.core.{Option, Result}.

result_option(result: Result[String, Int]): Option[String] ->
    case result {
        Ok(value) ->
            if {
                value == "" -> None;
                true -> Some(value)
            };
        Err(reason) ->
            if {
                reason == 0 -> Some("");
                true -> None
            }
    }.

@test
pub nested_result_none_equals_missing_literal(): Bool ->
    result_option(Err(1)) == None.

@test
pub nested_result_empty_equals_missing_literal(): Bool ->
    result_option(Ok("")) == None.

optional_string(present: Bool): Option[String] ->
    if {
        present -> Some("present");
        true -> None
    }.

@test
pub returned_none_matches_missing_pattern(): Bool ->
    case optional_string(false) {
        None -> true;
        Some(_value) -> false
    }.

@test
pub returned_none_equals_missing_literal(): Bool ->
    optional_string(false) == None.

@test
pub missing_literal_equals_returned_none(): Bool ->
    None == optional_string(false).

@test
pub returned_none_is_not_unequal_to_missing_literal(): Bool ->
    not (optional_string(false) != None).

pub compare_int(left: Int, right: Int): Comparison ->
    std.core.Int.compare(left, right).

@test
pub none_value_matches_none(): Bool ->
    assert(None == None).

@test
pub some_constructor_returns_some_tuple(): Bool ->
    assert(Some(42) == Some(42)).

@test
pub is_some_accepts_present_value(): Bool ->
    assert_equal(true, is_some(Some(42))).

@test
pub is_some_rejects_missing_value(): Bool ->
    assert_equal(false, is_some(None)).

@test
pub is_none_accepts_missing_value(): Bool ->
    assert_equal(true, is_none(None)).

@test
pub is_none_rejects_present_value(): Bool ->
    assert_equal(false, is_none(Some(42))).

@test
pub with_default_uses_default_for_none(): Bool ->
    assert_equal(7, with_default(None, 7)).

@test
pub compare_accepts_two_missing_values(): Bool ->
    assert_equal(Eq, compare(None, None, compare_int)).

@test
pub compare_orders_missing_before_present_value(): Bool ->
    assert_equal(Lt, compare(None, Some(1), compare_int)).

@test
pub compare_orders_present_value_after_missing(): Bool ->
    assert_equal(Gt, compare(Some(1), None, compare_int)).

@test
pub compare_delegates_present_value_ordering(): Bool ->
    assert_equal(Lt, compare(Some(1), Some(2), compare_int)).
