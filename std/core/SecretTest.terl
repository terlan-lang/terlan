module std.core.SecretTest.

import std.core.Secret.{diagnostic, editor_hover, generated_doc, new, panic_error, redacted, support_bundle, to_string, trace}.
import std.test.Test.{assert_equal}.

import type std.core.Secret.

sample_secret(): Secret ->
    new("actual-password").

@test
pub secret_to_string_redacts_value(): Bool ->
    assert_equal(redacted(), to_string(sample_secret())).

@test
pub secret_to_string_does_not_contain_value(): Bool ->
    assert_equal(false, to_string(sample_secret()).contains("actual-password")).

@test
pub secret_redaction_marker_is_stable(): Bool ->
    assert_equal("[secret]", redacted()).

@test
pub secret_diagnostic_redacts_value(): Bool ->
    let rendered = diagnostic(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).

@test
pub secret_editor_hover_redacts_value(): Bool ->
    let rendered = editor_hover(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).

@test
pub secret_generated_doc_redacts_value(): Bool ->
    let rendered = generated_doc(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).

@test
pub secret_support_bundle_redacts_value(): Bool ->
    let rendered = support_bundle(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).

@test
pub secret_trace_redacts_value(): Bool ->
    let rendered = trace(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).

@test
pub secret_panic_error_redacts_value(): Bool ->
    let rendered = panic_error(sample_secret());
    assert_equal(redacted(), rendered) and assert_equal(false, rendered.contains("actual-password")).
