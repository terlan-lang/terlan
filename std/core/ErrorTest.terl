module std.core.ErrorTest.

import std.core.Error.{new, to_string}.
import std.test.Test.{assert_equal}.

import type std.core.Error.

pub type Invalid.

pub sample_error(): Error ->
    new(Invalid, "invalid input").

@test
pub new_populates_error_code(): Bool ->
    assert_equal(Invalid, sample_error().code).

@test
pub new_populates_error_message(): Bool ->
    assert_equal("invalid input", sample_error().message).

@test
pub to_string_returns_error_message(): Bool ->
    assert_equal("invalid input", to_string(sample_error())).
