module std.core.IntTest.

import std.core.Int.{abs, checked_abs, checked_add, checked_div, checked_mul, checked_mul_div, checked_sub, compare, equal, from_string, from_string_base, max, min, to_string, to_string_base}.
import std.core.Option.{None, Some}.
import std.core.Ordering.{Eq, Gt, Lt, Ordering}.
import std.test.Test.{assert, assert_equal, assert_false, each_result, row}.

import type std.core.Ordering.Comparison.

minimum_value(): Int ->
    -9_223_372_036_854_775_807 - 1.

pub ordering_compare(left: Int, right: Int): Comparison ->
    Ordering.compare(left, right).

@test
pub equal_accepts_matching_integers(): Bool ->
    assert(equal(42, 42)).

@test
pub equal_rejects_different_integers(): Bool ->
    assert_false(equal(42, 7)).

@test
pub min_rows_return_expected_integer(): Bool ->
    each_result(
        [row("smaller left", {3, 7}, 3), row("equal values", {3, 3}, 3)],
        (input) ->
            case input {
                {left, right} -> min(left, right)
            },
    ).

@test
pub max_rows_return_expected_integer(): Bool ->
    each_result(
        [row("larger right", {3, 7}, 7), row("equal values", {7, 7}, 7)],
        (input) ->
            case input {
                {left, right} -> max(left, right)
            },
    ).

@test
pub abs_rows_return_expected_integer(): Bool ->
    each_result([row("positive", 7, 7), row("negative", -7, 7)], abs).

@test
pub checked_add_returns_exact_results_and_rejects_overflow(): Bool ->
    assert_equal(Some(7), checked_add(3, 4))
        and assert_equal(Some(-7), checked_add(-3, -4))
        and assert_equal(None, checked_add(9_223_372_036_854_775_807, 1))
        and assert_equal(None, checked_add(minimum_value(), -1)).

@test
pub checked_sub_returns_exact_results_and_rejects_overflow(): Bool ->
    assert_equal(Some(3), checked_sub(7, 4))
        and assert_equal(Some(-3), checked_sub(-7, -4))
        and assert_equal(None, checked_sub(minimum_value(), 1))
        and assert_equal(None, checked_sub(9_223_372_036_854_775_807, -1)).

@test
pub checked_mul_handles_zero_and_every_sign_pair(): Bool ->
    assert_equal(Some(0), checked_mul(0, minimum_value()))
        and assert_equal(Some(12), checked_mul(3, 4))
        and assert_equal(Some(-12), checked_mul(3, -4))
        and assert_equal(Some(-12), checked_mul(-3, 4))
        and assert_equal(Some(12), checked_mul(-3, -4)).

@test
pub checked_mul_rejects_overflow_for_every_sign_pair(): Bool ->
    assert_equal(None, checked_mul(9_223_372_036_854_775_807, 2))
        and assert_equal(None, checked_mul(9_223_372_036_854_775_807, -2))
        and assert_equal(None, checked_mul(minimum_value(), 2))
        and assert_equal(None, checked_mul(minimum_value(), -1)).

@test
pub checked_mul_div_uses_a_widened_intermediate(): Bool ->
    assert_equal(Some(21), checked_mul_div(6, 7, 2))
        and assert_equal(Some(9_223_372_036_854_775_807), checked_mul_div(9_223_372_036_854_775_807, 2, 2))
        and assert_equal(Some(minimum_value()), checked_mul_div(minimum_value(), 2, 2)).

@test
pub checked_mul_div_truncates_and_preserves_sign(): Bool ->
    assert_equal(Some(3), checked_mul_div(7, 1, 2))
        and assert_equal(Some(-3), checked_mul_div(-7, 1, 2))
        and assert_equal(Some(-3), checked_mul_div(7, 1, -2))
        and assert_equal(Some(3), checked_mul_div(-7, 1, -2)).

@test
pub checked_mul_div_rejects_undefined_or_out_of_range_results(): Bool ->
    assert_equal(None, checked_mul_div(1, 1, 0))
        and assert_equal(None, checked_mul_div(9_223_372_036_854_775_807, 2, 1))
        and assert_equal(None, checked_mul_div(minimum_value(), -1, 1))
        and assert_equal(None, checked_mul_div(minimum_value(), 1, -1)).

@test
pub checked_div_rejects_undefined_operations(): Bool ->
    assert_equal(Some(-3), checked_div(7, -2))
        and assert_equal(Some(minimum_value()), checked_div(minimum_value(), 1))
        and assert_equal(None, checked_div(7, 0))
        and assert_equal(None, checked_div(minimum_value(), -1)).

@test
pub checked_abs_rejects_only_minimum_integer(): Bool ->
    assert_equal(Some(7), checked_abs(-7))
        and assert_equal(Some(0), checked_abs(0))
        and assert_equal(Some(9_223_372_036_854_775_807), checked_abs(9_223_372_036_854_775_807))
        and assert_equal(None, checked_abs(minimum_value())).

@test
pub compare_orders_smaller_integer_first(): Bool ->
    assert_equal(Lt, compare(1, 2)).

@test
pub compare_orders_larger_integer_after(): Bool ->
    assert_equal(Gt, compare(2, 1)).

@test
pub compare_accepts_equal_integers(): Bool ->
    assert_equal(Eq, compare(-7, -7)).

@test
pub ordering_trait_orders_smaller_integer_first(): Bool ->
    assert_equal(Lt, ordering_compare(1, 2)).

@test
pub ordering_trait_orders_larger_integer_after(): Bool ->
    assert_equal(Gt, ordering_compare(2, 1)).

@test
pub to_string_renders_positive_integer(): Bool ->
    assert_equal("42", to_string(42)).

@test
pub to_string_renders_negative_integer(): Bool ->
    assert_equal("-7", to_string(-7)).

@test
pub from_string_parses_positive_integer(): Bool ->
    case from_string("42") {
        Some(value) -> assert_equal(42, value);
        None -> false
    }.

@test
pub from_string_parses_negative_integer(): Bool ->
    case from_string("-7") {
        Some(value) -> assert_equal(-7, value);
        None -> false
    }.

@test
pub from_string_rejects_unknown_text(): Bool ->
    case from_string("nope") {
        None -> true;
        Some(_value) -> false
    }.

@test
pub to_string_base_formats_signed_values_and_uppercase_digits(): Bool ->
    when {
        Some(hexadecimal) <- to_string_base(255, 16);
        Some(binary) <- to_string_base(-2, 2)
    } else {
        _ -> false
    };
    assert_equal("FF", hexadecimal) and assert_equal("-10", binary).

@test
pub to_string_base_rejects_out_of_range_bases(): Bool ->
    assert_equal(None, to_string_base(1, 1)) and assert_equal(None, to_string_base(1, 37)).

@test
pub from_string_base_parses_signed_case_insensitive_digits(): Bool ->
    when {
        Some(uppercase) <- from_string_base("FF", 16);
        Some(lowercase) <- from_string_base("ff", 16);
        Some(signed) <- from_string_base("-10", 2)
    } else {
        _ -> false
    };
    assert_equal(255, uppercase) and assert_equal(255, lowercase) and assert_equal(-2, signed).

@test
pub from_string_base_rejects_invalid_text_base_and_overflow(): Bool ->
    assert_equal(None, from_string_base("12x", 10))
        and assert_equal(None, from_string_base("1", 1))
        and assert_equal(None, from_string_base("9223372036854775808", 10)).
