module std.core.IntTest.

import std.core.Int.{abs, compare, equal, from_string, from_string_base, max, min, to_string, to_string_base}.
import std.core.Option.{None, Some}.
import std.core.Ordering.{Eq, Gt, Lt, Ordering}.
import std.test.Test.{assert, assert_equal, assert_false, each_result, row}.

import type std.core.Ordering.Comparison.

pub ordering_compare(left: Int, right: Int): Comparison ->
    Ordering.compare(left, right).

@test
pub equal_accepts_matching_integers(): Bool ->
    assert(equal(42, 42)).

@test
pub equal_rejects_different_integers(): Bool ->
    assert_false(equal(42, 7)).

@test
pub min_rows_return_expected_integer(): Bool ->
    each_result([row("smaller left", {3, 7}, 3), row("equal values", {3, 3}, 3)], (input) -> case input {
        {left, right} -> min(left, right)
    }).

@test
pub max_rows_return_expected_integer(): Bool ->
    each_result([row("larger right", {3, 7}, 7), row("equal values", {7, 7}, 7)], (input) -> case input {
        {left, right} -> max(left, right)
    }).

@test
pub abs_rows_return_expected_integer(): Bool ->
    each_result([row("positive", 7, 7), row("negative", -7, 7)], (value) -> abs(value)).

@test
pub compare_orders_smaller_integer_first(): Bool ->
    assert_equal(Lt, compare(1, 2)).

@test
pub compare_orders_larger_integer_after(): Bool ->
    assert_equal(Gt, compare(2, 1)).

@test
pub compare_accepts_equal_integers(): Bool ->
    assert_equal(Eq, compare(-7, -7)).

@test
pub ordering_trait_orders_smaller_integer_first(): Bool ->
    assert_equal(Lt, ordering_compare(1, 2)).

@test
pub ordering_trait_orders_larger_integer_after(): Bool ->
    assert_equal(Gt, ordering_compare(2, 1)).

@test
pub to_string_renders_positive_integer(): Bool ->
    assert_equal("42", to_string(42)).

@test
pub to_string_renders_negative_integer(): Bool ->
    assert_equal("-7", to_string(-7)).

@test
pub from_string_parses_positive_integer(): Bool ->
    case from_string("42") {
        Some(value) -> assert_equal(42, value);
        None -> false
    }.

@test
pub from_string_parses_negative_integer(): Bool ->
    case from_string("-7") {
        Some(value) -> assert_equal(-7, value);
        None -> false
    }.

@test
pub from_string_rejects_unknown_text(): Bool ->
    case from_string("nope") {
        None -> true;
        Some(_value) -> false
    }.

@test
pub to_string_base_formats_signed_values_and_uppercase_digits(): Bool ->
    case to_string_base(255, 16) {
        Some(hexadecimal) ->
            case to_string_base(-2, 2) {
                Some(binary) -> assert_equal("FF", hexadecimal) and assert_equal("-10", binary);
                None -> false
            };
        None -> false
    }.

@test
pub to_string_base_rejects_out_of_range_bases(): Bool ->
    assert_equal(None, to_string_base(1, 1)) and assert_equal(None, to_string_base(1, 37)).

@test
pub from_string_base_parses_signed_case_insensitive_digits(): Bool ->
    case from_string_base("FF", 16) {
        Some(uppercase) ->
            case from_string_base("ff", 16) {
                Some(lowercase) ->
                    case from_string_base("-10", 2) {
                        Some(signed) ->
                            assert_equal(255, uppercase) and assert_equal(255, lowercase) and assert_equal(-2, signed);
                        None -> false
                    };
                None -> false
            };
        None -> false
    }.

@test
pub from_string_base_rejects_invalid_text_base_and_overflow(): Bool ->
    assert_equal(None, from_string_base("12x", 10)) and assert_equal(None, from_string_base("1", 1)) and assert_equal(None, from_string_base("9223372036854775808", 10)).
