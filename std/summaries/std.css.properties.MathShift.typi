//! The `math-shift` property indicates whether superscripts inside MathML formulas should be raised
//! by a normal or compact shift.
//!
//! Initial: normal. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: normal | compact
//!
//! Specification: https://w3c.github.io/mathml-core/#propdef-math-shift
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/math-shift
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.MathShift.

/// Indicates compact rendering. Superscripts in MathML formulas use the
/// [superscriptShiftUpCramped](https://w3c.github.io/mathml-core/#dfn-superscriptshiftupcramped)
/// parameter from the OpenType MATH table, which is generally smaller.

pub type Compact =
    Atom["compact"].

pub type Css =
    Normal
  | Compact
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// The initial value, indicates normal rendering. Superscripts in MathML formulas use the
/// [superscriptShiftUp](https://w3c.github.io/mathml-core/#dfn-superscriptshiftup) parameter from
/// the OpenType MATH table.

pub type Normal =
    Atom["normal"].

pub struct Property {
    math_shift: Value
}.

pub opaque type Value.

/// Selects a keyword for math-shift. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
