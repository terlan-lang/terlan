//! Portable scoped-span values with host-owned propagation.

module std.service.Trace.
import std.core.Unit.{*}.

pub struct Span {
    name: String,
    status: Atom
}.

pub begin(name: String): Span.

@pure
pub (span: Span) cancel(): Unit.

@pure
pub (span: Span) finish(): Unit.

@pure
pub (span: Span) time_out(): Unit.
