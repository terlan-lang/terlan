/// Overflow content is clipped at the element's padding box. Whether overflowing or not, the element
/// box is always a scroll container displaying scroll bars.

pub type Scroll =
    Atom["scroll"].

/// Overflow content is not clipped and may be visible outside the element's padding box. The element
