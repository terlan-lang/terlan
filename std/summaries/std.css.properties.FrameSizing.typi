/// The `<iframe>` element's `inline-size` is set to the layout size of its embedded document in the
/// inline direction.

pub type ContentInlineSize =
    Atom["content-inline-size"].

/// The `<iframe>` element's `width` is set to the layout width of its embedded document.

pub type ContentWidth =
    Atom["content-width"].

