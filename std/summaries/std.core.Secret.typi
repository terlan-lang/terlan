//! Core non-loggable secret value.
//!
//! `std.core.Secret` is the portable source-level wrapper for values that must
//! not appear in logs, diagnostics, generated docs, support bundles, traces, or
//! panic/error rendering. Code that needs to cross a native boundary should pass
//! the typed `Secret` value instead of converting it to `String`.

module std.core.Secret.

/// Secret carries sensitive text while making the default display path redacted.
///
/// Input: no runtime input; fields are supplied by constructors.
/// Output: a typed secret wrapper.
/// Transformation: stores sensitive text under an explicit core type so generic
/// display and reporting code can reject or redact the value by type instead of
/// accidentally rendering a plain `String`.

pub struct Secret {
    value: String
}.

/// Renders a secret for diagnostics without exposing its sensitive contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value and returns the same
/// marker used by generic display so diagnostics cannot drift into a different
/// accidental rendering path.

@pure
pub diagnostic(secret: Secret): String.

/// Renders a secret for editor hover without exposing its sensitive contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value so editor integrations can
/// show the value shape without placing secret material in hover text.

@pure
pub editor_hover(secret: Secret): String.

/// Renders a secret for generated documentation without exposing its contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value so generated
/// documentation can show that a secret exists without serializing the secret
/// itself into docs artifacts.

@pure
pub generated_doc(secret: Secret): String.

/// Constructs a secret value.
///
/// Input: one sensitive string.
/// Output: a `Secret` wrapper.
/// Transformation: moves the input under the non-loggable secret type.

pub new(value: String): Secret.

/// Renders a secret for panic and error reporting without exposing its contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value so exceptional paths do
/// not become a fallback leak channel.

@pure
pub panic_error(secret: Secret): String.

/// Returns the stable redaction marker used for secret display.
///
/// Input: no value input.
/// Output: the string `"[secret]"`.
/// Transformation: centralizes the default marker so tests, diagnostics, and
/// support-bundle code use the same spelling.

@pure
pub redacted(): String.

/// Renders a secret for support bundles without exposing its sensitive contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value so support-bundle capture
/// can preserve the existence of a secret without storing the secret itself.

@pure
pub support_bundle(secret: Secret): String.

/// Renders a secret without exposing its sensitive contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value and returns
/// `redacted()`.

@pure
pub to_string(secret: Secret): String.

/// Renders a secret for VM traces without exposing its sensitive contents.
///
/// Input: one `Secret` value.
/// Output: the stable redaction marker.
/// Transformation: ignores the wrapped sensitive value so trace capture can
/// preserve value shape without recording secret material.

@pure
pub trace(secret: Secret): String.

pub impl not Equal[Secret].

pub impl not Ordering[Secret].

pub impl not std.core.String.Show[Secret].
