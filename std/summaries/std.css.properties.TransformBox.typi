pub opaque type Value.

/// The nearest `SVG` viewport is used as the reference box. If a `viewBox` attribute is specified
/// for the SVG viewport creating element, the reference box is positioned at the origin of the
/// coordinate system established by the `viewBox` attribute, and the dimension of the reference box
/// is set to the width and height values of the `viewBox` attribute. For elements with associated
/// CSS layout box, acts as `border-box`.

pub type ViewBox =
