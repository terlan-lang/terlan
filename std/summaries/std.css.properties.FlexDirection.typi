//! The `flex-direction` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets how
//! flex items are placed in the flex container defining the main axis and the direction (normal or
//! reversed).
//!
//! Initial: row. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: row | row-reverse | column | column-reverse
//!
//! Specification: https://drafts.csswg.org/css-flexbox-2/#propdef-flex-direction
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/flex-direction
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.FlexDirection.

/// Specifies the flex container's main-axis to be the same as the block-axis.

pub type Column =
    Atom["column"].

/// Behaves the same as `column` but specifies the content direction to be inverted, with the first
/// item placed at the block-end edge.

pub type ColumnReverse =
    Atom["column-reverse"].

pub struct Property {
    flex_direction: Row | RowReverse | Column | ColumnReverse | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
}.

/// Specifies the flex container's main-axis to be the same as the text direction. This is the
/// default value.

pub type Row =
    Atom["row"].

/// Behaves the same as `row` but specifies the content direction to be inverted, with the first item
/// placed at the inline-end edge.

pub type RowReverse =
    Atom["row-reverse"].
