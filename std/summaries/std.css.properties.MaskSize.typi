pub opaque type Value.

/// Sets mask-size from a typed length. Returns Some for amount >= 0; otherwise returns None.

pub length(value: std.css.Values.Length): Option[Value].

/// Sets mask-size from a typed percentage. Returns Some for amount >= 0; otherwise returns None.

pub percentage(value: std.css.Values.Percentage): Option[Value].

