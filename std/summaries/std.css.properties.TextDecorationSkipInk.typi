//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.TextDecorationSkipInk.

/// The browser _must_ interrupt underlines and overlines so that they do not touch or closely
/// approach a glyph. This can be helpful with certain Chinese, Japanese, or Korean (CJK) fonts,
/// where the `auto` behavior might not create interruptions.

pub type All =
    Atom["all"].

/// The default — the browser _may_ interrupt underlines and overlines so that they do not touch or
/// closely approach a glyph. That is, they are interrupted where they would otherwise cross over a
/// glyph.

pub type Auto =
    Atom["auto"].

/// Underlines and overlines are drawn across the full length of the text content, including parts
/// that cross over glyph descenders and ascenders.

pub type None =
    Atom["none"].

pub struct Property {
    text_decoration_skip_ink: Auto | None | All | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
}.
