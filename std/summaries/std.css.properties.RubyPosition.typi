//! The `ruby-position` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property defines the
//! position of a ruby element relative to its base element. It can be positioned over the element
//! (`over`), under it (`under`), or to the right (`inter-character`).
//!
//! Initial: alternate. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: [ alternate || [ over | under ] ] | inter-character
//!
//! Specification: https://drafts.csswg.org/css-ruby-1/#propdef-ruby-position
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/ruby-position
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Additional value descriptions: Microsoft (MIT).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.RubyPosition.

/// Is a keyword indicating that the ruby alternates between over and under, when there are multiple
/// levels of annotation.

pub type Alternate =
    Atom["alternate"].

pub type Css =
    Alternate
  | Over
  | Under
  | InterCharacter
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// Is a keyword indicating that the ruby annotation is placed to the right of the base text
/// characters. This value is intended for bopomofo (zhuyin fuhao) ruby.

pub type InterCharacter =
    Atom["inter-character"].

/// ![Over example](screen_shot_2015-03-04_at_13.02.20.png) Is a keyword indicating that the ruby has
/// to be placed over the main text for horizontal scripts and right to it for vertical scripts.

pub type Over =
    Atom["over"].

pub struct Property {
    ruby_position: Value
}.

/// ![Under example](screen_shot_2015-03-04_at_13.02.07.png) Is a keyword indicating that the ruby
/// has to be placed under the main text for horizontal scripts and left to it for vertical scripts.

pub type Under =
    Atom["under"].

pub opaque type Value.

/// Selects a keyword for ruby-position. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
