//! The `background-attachment` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets
//! whether a background image's position is fixed within the `viewport`, or scrolls with its
//! containing block.
//!
//! Initial: scroll. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: <attachment>#
//!
//! Specification: https://drafts.csswg.org/css-backgrounds-4/#propdef-background-attachment
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/background-attachment
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.BackgroundAttachment.

/// The background is fixed relative to the viewport. Even if an element has a scrolling mechanism,
/// the background doesn't move with the element. If set, the `background-origin` property is
/// ignored.

pub type Fixed =
    Atom["fixed"].

/// The background is fixed relative to the element's contents. If the element has a scrolling
/// mechanism, the background scrolls with the element's contents, and the background painting area
/// and background positioning area are relative to the scrollable area of the element rather than to
/// the border framing them.

pub type Local =
    Atom["local"].

pub struct Property {
    background_attachment: Scroll | Fixed | Local | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
}.

/// The background is fixed relative to the element itself and does not scroll with its contents. (It
/// is effectively attached to the element's border.)

pub type Scroll =
    Atom["scroll"].
