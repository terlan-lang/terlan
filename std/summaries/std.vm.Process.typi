//! Terlan VM process contract.
//!
//! `std.vm.Process` models a typed process handle for runtime-targeted runtime
//! modules. It exists so supervision and native bridges can be expressed as
//! ordinary annotated types and traits instead of source-level actor syntax.

module std.vm.Process.

/// Entry identifies one image-local process entry point.
///
/// Input: type parameter `T` describing the child mailbox payload.
/// Output: an opaque image-owned entry identity.
/// Transformation: prevents source code from confusing an executable entry
/// identity with an arbitrary integer while retaining a fixed transition word.

pub opaque type Entry[T].

/// ExitReason represents one VM-owned abnormal process exit reason.
///
/// Input: a positive application-defined failure code.
/// Output: an opaque exit reason.
/// Transformation: prevents failure codes from being confused with unrelated
/// integers while preserving centralized link and monitor propagation.

pub opaque type ExitReason.

/// Monitor represents one VM-owned process monitor reference.
///
/// Input: type parameter `T` describing the monitored process mailbox.
/// Output: an opaque monitor identity.
/// Transformation: prevents numeric monitor references from entering source
/// code while the VM owns DOWN delivery and cleanup.

pub opaque type Monitor[T].

/// Process represents a typed runtime process handle.
///
/// Input: type parameter `T` describing accepted message payloads.
/// Output: an opaque runtime process handle.
/// Transformation: keeps process identity target-owned while preserving a typed
/// source contract for message routing and supervision.

pub opaque type Process[T].

/// Resource represents one owner-bound VM resource.
///
/// Input: phantom type `K` identifying the resource family.
/// Output: an opaque resource identity.
/// Transformation: keeps host pointers and numeric resource identities outside
/// source code while retaining process-owned cleanup.

pub opaque type Resource[K].

/// ResourceKind identifies one application-defined VM resource family.
///
/// Input: phantom type `K` separating resource families at compile time.
/// Output: an opaque resource-kind descriptor.
/// Transformation: preserves the runtime kind tag without allowing resources
/// from unrelated families to be mixed in source code.

pub opaque type ResourceKind[K].

/// SchedulingClass represents one supported scheduler queue class.
///
/// Input: a compiler-owned class constructor.
/// Output: an opaque scheduling class.
/// Transformation: admits only priority, normal, and background scheduling
/// classes instead of exposing scheduler tags to source code.

pub opaque type SchedulingClass.

/// Timer represents one validated delay owned by the VM clock.
///
/// Input: a positive number of deterministic VM clock ticks.
/// Output: an opaque timer descriptor.
/// Transformation: keeps timer validation and wakeup ordering behind a typed
/// source value without exposing scheduler timer rows.

pub opaque type Timer.

/// Acquires one owner-bound VM resource.
///
/// Input: a typed resource-kind descriptor.
/// Output: an opaque `Resource[K]` owned by the current process.
/// Transformation: creates the VM resource row and cleanup handle without
/// exposing a host pointer or numeric identity.

pub acquire[K](kind: ResourceKind[K]): Resource[K].

/// Returns the VM background scheduling class.

pub background(): SchedulingClass.

/// Requests cancellation of one live VM process.
///
/// Input: a typed process handle.
/// Output: `Unit` after the VM records the cancellation request.
/// Transformation: keeps termination, cleanup, and pre-resume cancellation
/// precedence in the VM scheduler.

pub cancel[T](target: Process[T]): Unit.

/// Returns the typed handle for the currently executing process.
///
/// Input: mailbox payload type `T`.
/// Output: the VM-owned `Process[T]` identity of the calling actor.
/// Transformation: suspends at the scheduler boundary so identity is supplied
/// by the owning execution shard; generated code never manufactures process
/// identifiers.

pub current[T](): Process[T].

/// Builds an image-local typed process entry.
///
/// Input: a positive image entry tag and mailbox payload type `T`.
/// Output: an opaque `Entry[T]` descriptor.
/// Transformation: erases to the image entry identity after type checking so
/// raw entry tags cannot reach lifecycle operations directly.

pub entry[T](tag: Int): Entry[T].

/// Builds one abnormal process exit reason.
///
/// Input: a positive application-defined failure code.
/// Output: an opaque `ExitReason`.
/// Transformation: erases to the validated failure code after type checking.

pub exit_reason(code: Int): ExitReason.

/// Terminates the current process abnormally.
///
/// Input: one typed exit reason.
/// Output: no continuation resumes after the VM accepts the failure.
/// Transformation: centralizes link propagation, monitor delivery, timer
/// cleanup, resource cleanup, and supervision restart in the VM exit pipeline.

pub fail(reason: ExitReason): Unit.

/// Links the current process to one live peer.
///
/// Input: a typed process handle.
/// Output: `Unit` after the VM owns the symmetric failure relationship.
/// Transformation: preserves link cleanup and abnormal-exit propagation in the
/// VM without exposing numeric process identities.

pub link[T](peer: Process[T]): Unit.

/// Monitors one live VM process from the current process.
///
/// Input: a typed target process.
/// Output: an opaque `Monitor[T]` reference.
/// Transformation: keeps monitor identity, DOWN delivery, and cleanup in the VM
/// failure runtime.

pub monitor[T](peer: Process[T]): Monitor[T].

/// Returns the VM normal scheduling class.

pub normal(): SchedulingClass.

/// Returns the VM priority scheduling class.

pub priority(): SchedulingClass.

/// Receives the oldest queued message.
///
/// Input: concrete mailbox payload type `T` selected at the call site.
/// Output: the oldest matching `Message[T]` after the actor resumes.
/// Transformation: receives only from the current actor mailbox, parks when no
/// matching message exists, and resumes with a receiver-owned payload.

pub receive[T](): Message[T].

/// Receives the oldest typed Atom available to the current native process.
///
/// Input: no value; transition ownership identifies the receiving process.
/// Output: the finite image-owned Atom represented by the queued stable index.
/// Transformation: preserves nonmatching mailbox entries and never interns an
/// atom from mailbox data at runtime.

pub receive_atom(): Atom.

/// Receives the oldest typed Binary available to the current native process.
///
/// Input: no value; transition ownership identifies the receiving process.
/// Output: a Binary allocated in the receiver's actor-local managed heap.
/// Transformation: preserves packed bytes and the exact trailing bit length,
/// committing mailbox removal only after receiver-side allocation succeeds.

pub receive_binary(): Binary.

/// Receives the oldest typed Bytes value available to the current native process.
///
/// Input: no value; transition ownership identifies the receiving process.
/// Output: Bytes allocated in the receiver's actor-local managed heap.
/// Transformation: preserves nonmatching mailbox entries and commits removal
/// only after receiver-side allocation succeeds.

pub receive_bytes(): Bytes.

/// Receives the oldest scalar Int available to the current native process.
///
/// Input: no value; the VM resolves the current process from transition ownership.
/// Output: the received Int after VM-owned mailbox accounting.
/// Transformation: exposes the bounded scalar bootstrap for compiled Receive
/// transitions while opaque typed Process and Message values remain the public
/// high-level mailbox API.

pub receive_int(): Int.

/// Receives the oldest typed String available to the current native process.
///
/// Input: no value; transition ownership identifies the receiving process.
/// Output: a String allocated in the receiver's actor-local managed heap.
/// Transformation: preserves nonmatching mailbox entries and commits removal
/// only after receiver-side allocation succeeds.

pub receive_string(): String.

/// Receives the first queued message accepted by a predicate.
///
/// Input: one predicate that accepts a message payload.
/// Output: the first matching message after the current actor resumes.
/// Transformation: scans only the current actor mailbox, preserves skipped
/// messages in order, and parks when no matching payload is available.

pub receive_where[T](predicate: (T) -> Bool): Message[T].

/// Builds a typed application resource kind.
///
/// Input: a positive application-defined kind tag and phantom family `K`.
/// Output: an opaque `ResourceKind[K]`.
/// Transformation: erases to the validated kind tag after type checking.

pub resource_kind[K](tag: Int): ResourceKind[K].

/// Changes the current process scheduling class.
///
/// Input: one compiler-admitted scheduling class.
/// Output: `Unit` after the VM reclassifies and requeues the process.
/// Transformation: keeps queue ownership, weighted selection, and reduction
/// accounting in the VM scheduler without exposing numeric class tags.

pub schedule(class: SchedulingClass): Unit.

/// Sends one typed message to a process descriptor.
///
/// Input: one process handle and one VM message descriptor.
/// Output: `Unit` after the VM accepts ownership of the message.
/// Transformation: transfers the typed payload into the recipient mailbox and
/// never exposes its actor-local representation to the sender.

pub send[T]<ActorMessage[T]>(process: Process[T], message: Message[T]): Unit.

/// Sends one finite image-owned Atom through the typed direct-AOT mailbox boundary.
///
/// Input: a positive VM process identity and an Atom admitted by the image table.
/// Output: `Unit` after the VM has published the stable atom identity.
/// Transformation: rejects dynamic atom creation and carries only the canonical
/// finite-table index between processes.

pub send_atom(recipient: Int, payload: Atom): Unit.

/// Sends an immutable Binary through the typed direct-AOT mailbox boundary.
///
/// Input: a positive VM process identity and an owned Binary value.
/// Output: `Unit` after the VM has copied the packed bits into mailbox ownership.
/// Transformation: preserves the exact bit length while preventing an
/// actor-local binary reference from crossing process ownership.

pub send_binary(recipient: Int, payload: Binary): Unit.

/// Sends immutable Bytes through the typed direct-AOT mailbox boundary.
///
/// Input: a positive VM process identity and an owned Bytes value.
/// Output: `Unit` after the VM has copied the value into mailbox ownership.
/// Transformation: materializes the sender reference before publication so no
/// actor-local heap reference crosses process ownership.

pub send_bytes(recipient: Int, payload: Bytes): Unit.

/// Sends one scalar Int through the direct-AOT transition boundary.
///
/// Input: a positive VM process identity and an Int payload.
/// Output: `Unit` after the VM owns and accounts the mailbox delivery.
/// Transformation: exposes the bounded scalar bootstrap for compiled Send
/// transitions while opaque typed Process and Message values remain the public
/// high-level mailbox API.

pub send_int(recipient: Int, payload: Int): Unit.

/// Sends one immutable String through the typed direct-AOT mailbox boundary.
///
/// Input: a positive VM process identity and an owned immutable String.
/// Output: `Unit` after the VM has copied the value into mailbox ownership.
/// Transformation: materializes the sender reference before publication so no
/// actor-local heap reference crosses process ownership.

pub send_string(recipient: Int, payload: String): Unit.

/// Suspends the current process until a timer expires.
///
/// Input: one typed VM timer descriptor.
/// Output: `Unit` after the VM-owned one-shot timer reaches its deadline.
/// Transformation: keeps clock ordering, parking, and continuation wakeup in
/// the VM scheduler.

pub sleep(timer: Timer): Unit.

/// Starts a local VM process.
///
/// Input: one image-local `Entry[T]` descriptor.
/// Output: a VM-owned `Process[T]` handle.
/// Transformation: spawns a scheduler-visible child without exposing its
/// numeric process identity to source code.

pub spawn[T](entry: Entry[T]): Process[T].

/// Builds a VM timer descriptor.
///
/// Input: a positive deterministic VM tick count.
/// Output: an opaque `Timer`.
/// Transformation: erases to the validated tick count after type checking.

pub timer(ticks: Int): Timer.

/// Voluntarily yields the current process at an AOT continuation boundary.
///
/// Input: no value.
/// Output: `Unit` after the process is selected to resume.
/// Transformation: parks only the current process and transfers a stable typed
/// continuation to the VM scheduler; it never exposes a native stack address.

pub yield_now(): Unit.

/// ActorMessage marks payloads that may enter a local VM process mailbox.
///
/// Input: actor message payload type `T`.
/// Output: an identity proof method used by generic mailbox boundaries.
/// Transformation: keeps local actor messages typed while allowing a concrete
/// `impl not ActorMessage[LocalType]` to prohibit mailbox delivery at compile
/// time.

pub trait ActorMessage[T] {
    message(value: T): T.
}.

/// ProcessLike defines the minimum typed process operations.
///
/// Input: process handle type `P` and message payload type `T`.
/// Output: a trait requiring `send` and `stop` operations.
/// Transformation: models runtime message delivery as receiver-style API surface
/// instead of Terlan-specific process operators.

pub trait ProcessLike[P, T] extends ActorMessage[T] {
    send(process: P, message: Message[T]): Unit.
    stop(process: P): Unit.
}.

pub impl ActorMessage[T] for T {
}.
