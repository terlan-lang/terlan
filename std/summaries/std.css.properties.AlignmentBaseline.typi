//! The `alignment-baseline` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property
//! specifies the specific
//! [baseline](https://developer.mozilla.org/en-US/docs/Glossary/Baseline/Typography) used to align
//! the box's text and inline-level contents. Baseline alignment is the relationship among the
//! baselines of multiple alignment subjects within an alignment context. When performing baseline
//! alignment, the `alignment-baseline` property value specifies which baseline of the box is aligned
//! to the corresponding baseline of its alignment context.
//!
//! Initial: baseline. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: baseline | <baseline-metric>
//!
//! Specification: https://drafts.csswg.org/css-inline-3/#propdef-alignment-baseline
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/alignment-baseline
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.AlignmentBaseline.

/// Used in writing Latin, Cyrillic, Greek, and many other scripts; matches the box's alphabetic
/// baseline to that of its parent, corresponding to the bottom of most, but not all characters.

pub type Alphabetic =
    Atom["alphabetic"].

/// Use the `dominant-baseline` value of the parent.

pub type Baseline =
    Atom["baseline"].

/// Matches the box's central baseline to the central baseline of its parent, corresponding to the
/// ideographic central baseline, halfway between the ideographic-under and ideographic-over
/// baselines.

pub type Central =
    Atom["central"].

pub type Css =
    Baseline
  | TextBottom
  | Alphabetic
  | Ideographic
  | Middle
  | Central
  | Mathematical
  | Hanging
  | TextTop
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

pub type Hanging =
    Atom["hanging"].

/// Matches the box's ideographic character face under-side baseline to that of its parent, with the
/// derived baseline-table constructed using the ideographic baseline-table in the font.

pub type Ideographic =
    Atom["ideographic"].

/// Matches the box's mathematical baseline to that of its parent, corresponding to the center
/// baseline around which mathematical characters are designed.

pub type Mathematical =
    Atom["mathematical"].

/// Aligns the vertical midpoint of the box with the baseline of the parent box plus half the
/// x-height of the parent. Uses the x-middle baselines; except under [`text-orientation:
/// upright;`](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/text-orientation)
/// (where the alphabetic and x-height baselines are essentially meaningless), in which case it uses
/// the `central` baseline instead.

pub type Middle =
    Atom["middle"].

pub struct Property {
    alignment_baseline: Value
}.

/// Matches the bottom of the box to the top of the parent's content area, using the line-under edge
/// of an inline's content box.

pub type TextBottom =
    Atom["text-bottom"].

/// Matches the top of the box to the top of the parent's content area; the line-over edge of an
/// inline's content box.

pub type TextTop =
    Atom["text-top"].

pub opaque type Value.

/// Selects a keyword for alignment-baseline. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
