//! The `white-space-collapse` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property
//! controls how `white space` inside an element is collapsed.
//!
//! Initial: collapse. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: collapse | discard | preserve | preserve-breaks | preserve-spaces | break-spaces
//!
//! Specification: https://drafts.csswg.org/css-text-4/#propdef-white-space-collapse
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/white-space-collapse
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.WhiteSpaceCollapse.

/// The behavior is identical to `preserve`, except that: - Any sequence of preserved white space
/// always takes up space, including at the end of the line. - A line-breaking opportunity exists
/// after every preserved white space character, including between white space characters. -
/// Preserved spaces take up space and do not hang, thus affecting the box's intrinsic sizes
/// (`min-content` size and `max-content` size).

pub type BreakSpaces =
    Atom["break-spaces"].

/// White space sequences are
/// [collapsed](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Text/Whitespace#collapsing_and_transformation).

pub type Collapse =
    Atom["collapse"].

pub type Css =
    Collapse
  | Preserve
  | PreserveBreaks
  | PreserveSpaces
  | BreakSpaces
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

pub struct OptionalProperty {
    white_space_collapse: std.core.Option.Option[Value]
}.

/// White space sequences and segment break characters are preserved.

pub type Preserve =
    Atom["preserve"].

/// White space sequences are collapsed, while segment break characters are preserved.

pub type PreserveBreaks =
    Atom["preserve-breaks"].

/// White space sequences are preserved, while tabs and segment break characters are converted to
/// spaces.

pub type PreserveSpaces =
    Atom["preserve-spaces"].

pub struct Property {
    white_space_collapse: Value
}.

pub opaque type Value.

/// Selects a keyword for white-space-collapse. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
