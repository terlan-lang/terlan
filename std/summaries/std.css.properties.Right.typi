//! The `right` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property participates in
//! specifying the horizontal position of a [positioned
//! element](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/position). This
//! `inset property` has no effect on non-positioned elements.
//!
//! Initial: auto. Inherited: no.
//! Percentages: refer to the width of the containing block.
//!
//! Grammar: auto | <length-percentage> | <anchor()> | <anchor-size()>
//!
//! Specification: https://drafts.csswg.org/css-position-3/#propdef-right
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/right
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.Right.

/// Specifies that: - for _absolutely positioned elements_, the position of the element is based on
/// the `left` property, while `width: auto` is treated as a width based on the content; or if `left`
/// is also `auto`, the element is positioned where it should horizontally be positioned if it were a
/// static element. - for _relatively positioned elements_, the distance of the element from its
/// normal position is based on the `left` property; or if `left` is also `auto`, the element is not
/// moved horizontally at all.

pub type Auto =
    Atom["auto"].

pub type Css =
    Auto
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

pub struct OptionalProperty {
    right: std.core.Option.Option[Value]
}.

pub struct Property {
    right: Value
}.

pub opaque type Value.

/// Sets right from a typed length. Use std.css.Values.px, root_em, em, vw, or vh to choose the unit.

pub length(value: std.css.Values.Length): Value.

/// Sets right from a typed percentage.

pub percentage(value: std.css.Values.Percentage): Value.

/// Selects a keyword for right. CSS-wide choices Inherit, Initial, Unset, Revert, and RevertLayer
/// apply to the entire declaration.

pub value(css: Css): Value.
