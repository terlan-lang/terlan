//! The `shape-rendering` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property provides
//! hints to the renderer about what tradeoffs to make when rendering shapes like paths, circles, or
//! rectangles. It only has an effect on the `circle`, `ellipse`, `line`, `path`, `polygon`,
//! `polyline`, and `rect` elements. If explicitly declared, the value of the CSS property overrides
//! the any values of the element's `shape-rendering` attribute.
//!
//! Initial: auto. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: auto | optimizeSpeed | crispEdges | geometricPrecision
//!
//! Specification: https://w3c.github.io/svgwg/svg2-draft/painting.html#ShapeRenderingProperty
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/shape-rendering
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.ShapeRendering.

/// This value directs the user agents to make tradeoffs in order to balance speed, edge crispness,
/// and geometric precision, with geometric precision given more importance than speed and edge
/// crispness.

pub type Auto =
    Atom["auto"].

/// This value directs the user agent to emphasize edge contrast over geometric precision or
/// rendering speed. The final rendering is likely to skip techniques such as anti-aliasing. It may
/// also adjust line positions and line widths in order to align edges with device pixels.

pub type CrispEdges =
    Atom["crispEdges"].

pub type Css =
    Auto
  | OptimizeSpeed
  | CrispEdges
  | GeometricPrecision
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// This value directs the user agent to emphasize geometric precision over speed or crisp edges. The
/// final rendering may involve techniques such as anti-aliasing.

pub type GeometricPrecision =
    Atom["geometricPrecision"].

/// This value directs the user agent to emphasize rendering speed over geometric precision or edge
/// crispness. The final rendering is likely to skip techniques such as anti-aliasing.

pub type OptimizeSpeed =
    Atom["optimizeSpeed"].

pub struct Property {
    shape_rendering: Value
}.

pub opaque type Value.

/// Selects a keyword for shape-rendering. CSS-wide choices Inherit, Initial, Unset, Revert, and
