//! The `font-weight` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets the
//! weight (or boldness) of the font. The weights available depend on the `font-family` that is
//! currently set.
//!
//! Initial: normal. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: <font-weight-absolute> | bolder | lighter
//!
//! Specification: https://drafts.csswg.org/css-fonts-4/#propdef-font-weight
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/font-weight
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Additional value descriptions: Microsoft (MIT).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.FontWeight.

/// Bold font weight. Same as `700`.

pub type Bold =
    Atom["bold"].

/// One relative font weight heavier than the parent element. Note that only four font weights are
/// considered for relative weight calculation; see the [Meaning of relative
/// weights](#meaning_of_relative_weights) section below.

pub type Bolder =
    Atom["bolder"].

pub opaque type Checked.

/// One relative font weight lighter than the parent element. Note that only four font weights are
/// considered for relative weight calculation; see the [Meaning of relative
/// weights](#meaning_of_relative_weights) section below.

pub type Lighter =
    Atom["lighter"].

/// Normal font weight. Same as `400`.

pub type Normal =
    Atom["normal"].

pub struct Property {
    font_weight: Normal | Bold | Bolder | Lighter | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer | Checked
}.

/// Checks the font-weight number range. Returns Some when amount >= 1 and amount <= 1000; otherwise
/// returns None.

pub number(value: Float): Option[Checked].
