//! Core float conformance helpers.
//!
//! `std.core.Float` provides named operations used by stdlib trait/conformance
//! implementations for primitive `Float`.

module std.core.Float.
import std.core.Option.{*}.
import std.core.Ordering.{*}.

/// Returns the absolute value of a finite `Float`.
///
/// Input: one supported finite `Float` value.
/// Output: the non-negative magnitude of the input.
/// Transformation: returns the input unchanged when it is non-negative;
/// otherwise subtracts it from zero.
///
/// ```terlan
/// module float_abs_example.
///
/// pub demo(): Float ->
///     std.core.Float.abs(-2.25).
/// ```

@pure
pub abs(value: Float): Float.

/// Returns the principal arccosine in radians for a value in `[-1, 1]`.

@pure
pub acos(value: Float): Float.

/// Returns the inverse hyperbolic cosine of a finite value at least one.

@pure
pub acosh(value: Float): Float.

/// Returns the principal arcsine in radians for a value in `[-1, 1]`.

@pure
pub asin(value: Float): Float.

/// Returns the inverse hyperbolic sine of a finite value.

@pure
pub asinh(value: Float): Float.

/// Returns the principal arctangent of a finite Float in radians.
///
/// Input: one finite `Float` value.
/// Output: the finite angle in `[-pi / 2, pi / 2]` whose tangent is the input.
/// Transformation: delegates to the VM-owned binary64 arctangent primitive.
/// Non-finite runtime values fail with the same stable domain diagnostic used
/// by `log`.

@pure
pub atan(value: Float): Float.

/// Returns the principal angle of the finite vector `(x, y)` in radians.

@pure
pub atan2(y: Float, x: Float): Float.

/// Returns the inverse hyperbolic tangent of a finite value in `(-1, 1)`.

@pure
pub atanh(value: Float): Float.

/// Returns the finite real cube root of a finite value.

@pure
pub cbrt(value: Float): Float.

/// Returns the least whole Float not less than the input.
///
/// Input: one finite `Float` value.
/// Output: the mathematical ceiling represented as a `Float`.
/// Transformation: delegates deterministic finite rounding to the VM-owned
/// primitive intrinsic.

@pure
pub ceil(value: Float): Float.

/// Constrains a finite value to inclusive ordered bounds.
///
/// Returns `None` when `lower` is greater than `upper`.

pub clamp(value: Float, lower: Float, upper: Float): Option[Float].

/// Compares two supported finite `Float` values using numeric ordering.
///
/// Input: two supported finite `Float` values.
/// Output: `Lt` when `left` is numerically less than `right`, `Eq` when the
/// values are equal, and `Gt` when `left` is numerically greater than
/// `right`.
/// Transformation: maps the selected finite float ordering relation onto
/// `std.core.Ordering.Comparison`.
///
/// This function is the named implementation hook for compiler-known
/// `std.core.Ordering[Float]` conformance in 0.0.1. Non-finite values
/// are outside the 0.0.1 source contract.
///
/// ```terlan
/// module float_compare_example.
///
/// pub demo(): std.core.Ordering.Comparison ->
///    std.core.Float.compare(1.5, 2.5).
/// ```

@pure
pub compare(left: Float, right: Float): std.core.Ordering.Comparison.

/// Returns the cosine of a finite angle in radians.

@pure
pub cos(value: Float): Float.

/// Returns the hyperbolic cosine of a finite value.

@pure
pub cosh(value: Float): Float.

/// Converts an angle in radians to degrees.

@pure
pub degrees(radians: Float): Float.

/// Returns the nearest binary64 representation of Euler's number.

@pure
pub e(): Float.

/// Returns whether two finite `Float` values are equal.
///
/// Input: two supported finite `Float` values.
/// Output: `true` when both inputs represent the same finite floating-point
/// value; otherwise `false`.
/// Transformation: delegates to exact Terlan equality for the finite float
/// domain selected by the source contract without changing either input.
///
/// ```terlan
/// module float_equal_example.
///
/// pub demo(): Bool ->
///     std.core.Float.equal(1.5, 1.5).
/// ```

@pure
pub equal(left: Float, right: Float): Bool.

/// Returns `e` raised to a finite binary64 exponent.

@pure
pub exp(value: Float): Float.

/// Returns two raised to a finite binary64 exponent.

@pure
pub exp2(value: Float): Float.

/// Returns `exp(value) - 1` without losing precision near zero.

@pure
pub expm1(value: Float): Float.

/// Returns the greatest whole Float not greater than the input.
///
/// Input: one finite `Float` value.
/// Output: the mathematical floor represented as a `Float`.
/// Transformation: delegates deterministic finite rounding to the VM-owned
/// primitive intrinsic.

@pure
pub floor(value: Float): Float.

/// Returns the signed fractional component of a finite value.

@pure
pub fract(value: Float): Float.

/// Parses a canonical UTF-8 `String` into `Float`.
///
/// Input: one `String` value.
/// Output: `Option[Float]`, where supported finite decimal float text returns
/// `Some(value)` and invalid text returns `None`.
/// Transformation: lowers through the compiler-owned `core.float.from_string`
/// intrinsic and accepts only inputs where the full string is consumed.
///
/// ```terlan
/// module float_from_string_example.
///
/// pub demo(): Option[Float] ->
///    std.core.Float.from_string("1.5").
/// ```

@pure
pub from_string(value: String): Option[Float].

/// Returns the finite Euclidean length of a two-dimensional finite vector.

@pure
pub hypot(x: Float, y: Float): Float.

/// Returns the nearest binary64 representation of the natural log of ten.

@pure
pub ln10(): Float.

/// Returns the nearest binary64 representation of the natural log of two.

@pure
pub ln2(): Float.

/// Returns the natural logarithm of a positive finite Float.
///
/// Input: one finite `Float` greater than zero.
/// Output: the finite natural logarithm of the input.
/// Transformation: delegates to the VM-owned binary64 logarithm primitive.
/// Zero, negative, and non-finite runtime values fail with a stable domain
/// diagnostic instead of terminating the runtime.

@pure
pub log(value: Float): Float.

/// Returns the base-ten logarithm of a positive finite value.

@pure
pub log10(value: Float): Float.

/// Returns `log(1 + value)` without losing precision near zero.

@pure
pub log1p(value: Float): Float.

/// Returns the base-two logarithm of a positive finite value.

@pure
pub log2(value: Float): Float.

/// Returns the logarithm of `value` in the supplied positive base.
///
/// The base must be positive and unequal to one. Invalid domains fail through
/// the same finite-scalar contract as the primitive logarithms.

@pure
pub log_base(value: Float, base: Float): Float.

/// Returns the larger of two finite `Float` values.
///
/// Input: two supported finite `Float` values.
/// Output: `left` when it is greater than or equal to `right`; otherwise
/// `right`.
/// Transformation: compares the two inputs with primitive finite-float
/// ordering and returns one original input unchanged.
///
/// ```terlan
/// module float_max_example.
///
/// pub demo(): Float ->
///     std.core.Float.max(2.25, 1.5).
/// ```

@pure
pub max(left: Float, right: Float): Float.

/// Returns the smaller of two finite `Float` values.
///
/// Input: two supported finite `Float` values.
/// Output: `left` when it is less than or equal to `right`; otherwise `right`.
/// Transformation: compares the two inputs with primitive finite-float
/// ordering and returns one original input unchanged.
///
/// ```terlan
/// module float_min_example.
///
/// pub demo(): Float ->
///     std.core.Float.min(1.5, 2.25).
/// ```

@pure
pub min(left: Float, right: Float): Float.

/// Returns the nearest binary64 representation of pi.

@pure
pub pi(): Float.

/// Raises a finite base to a finite exponent and requires a finite real result.

@pure
pub pow(base: Float, exponent: Float): Float.

/// Converts an angle in degrees to radians.

@pure
pub radians(degrees: Float): Float.

/// Returns the multiplicative inverse of a non-zero finite value.

@pure
pub reciprocal(value: Float): Float.

/// Returns the finite remainder after truncating `dividend / divisor`.
///
/// The result has the sign of `dividend`; a zero divisor is rejected by the
/// finite-scalar arithmetic contract.

@pure
pub remainder(dividend: Float, divisor: Float): Float.

/// Returns the positive real `degree`th root of a non-negative value.
///
/// The degree must be non-zero. Use `cbrt` when a negative cube-root input
/// must be supported.

@pure
pub root(value: Float, degree: Float): Float.

/// Returns the nearest whole binary64 value, with halfway cases away from zero.

@pure
pub round(value: Float): Float.

/// Returns `-1.0`, `0.0`, or `1.0` according to a finite value's sign.

@pure
pub signum(value: Float): Float.

/// Returns the sine of a finite angle in radians.

@pure
pub sin(value: Float): Float.

/// Returns the hyperbolic sine of a finite value.

@pure
pub sinh(value: Float): Float.

/// Returns the principal square root of a non-negative finite Float.
///
/// Input: one finite `Float` greater than or equal to zero.
/// Output: the non-negative finite square root of the input.
/// Transformation: delegates to the VM-owned binary64 square-root primitive.
/// Negative and non-finite runtime values fail with the same stable domain
/// diagnostic used by `log`.

@pure
pub sqrt(value: Float): Float.

/// Returns the nearest binary64 representation of the square root of two.

@pure
pub sqrt2(): Float.

/// Returns the nearest binary64 representation of one over square root two.

@pure
pub sqrt_half(): Float.

/// Returns the square of a finite value.
///
/// The finite `Float` contract rejects an overflowing result.

@pure
pub square(value: Float): Float.

/// Returns the tangent of a finite angle in radians.

@pure
pub tan(value: Float): Float.

/// Returns the hyperbolic tangent of a finite value.

@pure
pub tanh(value: Float): Float.

/// Returns the nearest binary64 representation of tau.

@pure
pub tau(): Float.

/// Renders a finite `Float` as its canonical UTF-8 `String`.
///
/// Input: one supported finite `Float` value.
/// Output: the compact decimal string for the input float.
/// Transformation: lowers through the compiler-owned `core.float.to_string`
/// intrinsic with compact decimal formatting for `std.core.String.Show[Float]`.
///
/// ```terlan
/// module float_to_string_example.
///
/// pub demo(): String ->
///    std.core.Float.to_string(1.5).
/// ```

@pure
pub to_string(value: Float): String.

/// Removes the fractional component of a finite binary64 value.

@pure
pub trunc(value: Float): Float.
