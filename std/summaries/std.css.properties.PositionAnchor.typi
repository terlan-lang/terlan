//! The `position-anchor` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property specifies
//! the default anchor element for a positioned element. This default is used by `position-area` and
//! `position-try`, and by anchor functions (`anchor()` and `anchor-size()`) when no `<anchor-name>`
//! argument is provided to those functions.
//!
//! Initial: normal. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: normal | none | auto | <anchor-name> | match-parent
//!
//! Specification: https://drafts.csswg.org/css-anchor-position-1/#propdef-position-anchor
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/position-anchor
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.PositionAnchor.

/// Associates a positioned element with its implicit anchor element, if it has one — for example as
/// set by the non-standard HTML
/// [`anchor`](https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/anchor)
/// attribute.

pub type Auto =
    Atom["auto"].

pub type Css =
