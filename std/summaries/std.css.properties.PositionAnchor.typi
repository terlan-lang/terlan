  | MatchParent
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// Uses the same default anchor element as the parent element, or the originating element if this is
/// a [pseudo-element](https://developer.mozilla.org/en-US/docs/Glossary/Pseudo-element), provided
/// that would be an acceptable anchor element (that is [part of the
/// tree](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Pseudo-elements#tree-abiding_pseudo-elements)).
/// Otherwise, it has no default anchor element.

pub type MatchParent =
    Atom["match-parent"].

/// The positioned element is not associated with an anchor element.

pub type None =
    Atom["none"].

/// If `position-area` is `none`, it behaves as `none`. Otherwise it behaves as `auto`.

pub type Normal =
    Atom["normal"].

pub struct OptionalProperty {
    position_anchor: std.core.Option.Option[Value]
}.

pub struct Property {
    position_anchor: Value
}.

pub opaque type Value.

/// Selects a keyword for position-anchor. CSS-wide choices Inherit, Initial, Unset, Revert, and
