//! The `text-wrap` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS)
//! [shorthand](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Cascade/Shorthand_properties)
//! property controls how text inside an element is wrapped. The different values provide:
//!
//! Initial: wrap. Inherited: yes.
//! Percentages: text-wrap-mode: no; text-wrap-style: no.
//!
//! Grammar: <'text-wrap-mode'> || <'text-wrap-style'>
//!
//! Specification: https://drafts.csswg.org/css-text-4/#propdef-text-wrap
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/text-wrap
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.TextWrap.

/// Text is wrapped in the most performant way for the browser and does not take into account the
/// number of characters.
///
/// Author guide:
/// https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/text-wrap-style

pub type Auto =
    Atom["auto"].

/// Text is wrapped in a way that best balances the number of characters on each line, enhancing
/// layout quality and legibility. Because counting characters and balancing them across multiple
/// lines is computationally expensive, this value is only supported for blocks of text spanning a
/// limited number of lines (six or less for Chromium and ten or less for Firefox).

pub type Balance =
    Atom["balance"].

