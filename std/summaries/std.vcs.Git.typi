//! Typed Git repository identity for deterministic build and release tooling.

module std.vcs.Git.

/// Stable failure returned when a repository cannot be identified.

pub struct GitError {
    code: Atom,
    message: String
}.

/// One full revision and the exact tracked/untracked source-tree digest.

pub struct SourceTreeIdentity {
    revision: String,
    clean: Bool,
    sha256: String
}.

/// Stable code used for every source-tree identity failure.

pub type SourceTreeIdentityFailed =
    Atom["source_tree_identity_failed"].

/// Returns the checked-out revision and byte-exact local source-tree identity.

pub source_tree_identity(root: String): Result[SourceTreeIdentity, GitError].
