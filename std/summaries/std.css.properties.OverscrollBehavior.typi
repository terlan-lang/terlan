  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// Prevents scrolling from continuing outside the scroll container and also prevents overscroll
/// "bounce" effects.

pub type None =
    Atom["none"].

pub struct Property {
