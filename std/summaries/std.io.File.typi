//! Portable filesystem access.
//!
//! `std.io.File` exposes target-neutral file operations. Backends own the
//! runtime calls needed to implement these operations and must map backend
//! errors into the neutral `FileError` values defined here.

module std.io.File.

/// One regular-file copy requested as part of a bounded batch.

pub struct CopyPlan {
    source: String,
    destination: String
}.

/// Portable file error returned by `std.io.File`.
///
/// Input: includes the neutral `code` and `message` fields from
/// `std.core.Error.Error` and adds the target-interpreted path.
/// Output: a typed error value that can be used anywhere `Error`-including values
/// are accepted.
/// Transformation: keeps backend filesystem reasons behind a portable struct
/// instead of exposing backend-specific error atoms directly.

pub struct FileError {
    path: String
}.

/// Portable file error codes returned by `std.io.File`.

pub type FileErrorCode =
    NotFound
  | PermissionDenied
  | InvalidPath
  | Unknown.

/// Portable nanosecond file timestamps.
///
/// Both values are signed Unix-epoch nanoseconds so a caller can snapshot file
/// metadata before a temporary edit and restore it without invoking a platform
/// shell utility. Backends reject timestamps outside their representable range.

pub struct FileTimestamps {
    accessed_unix_ns: Int,
    modified_unix_ns: Int
}.

/// The supplied path cannot be represented by the selected target.

pub type InvalidPath =
    Atom["invalid_path"].

/// The file path did not resolve to an existing file.

pub type NotFound =
    Atom["not_found"].

/// The selected target denied access to the file.

pub type PermissionDenied =
    Atom["permission_denied"].

/// One UTF-8 text file returned by a batch read.
///
/// Input: the requested path and decoded UTF-8 contents.
/// Output: a typed path/content pair.
/// Transformation: keeps each file's identity attached to its contents so
/// validators can scan discovered file sets without positional bookkeeping.

pub struct TextFile {
    path: String,
    contents: String
}.

/// The selected target reported an unclassified filesystem failure.

pub type Unknown =
    Atom["unknown"].

/// Appends UTF-8 text to a file.
///
/// Input: a UTF-8 path string and UTF-8 text content.
/// Output: `Result[Unit, FileError]`.
/// Transformation: lowers through the compiler-owned `runtime.file.append_text`
/// capability. Backend file errors are normalized into `FileError` values, and a
/// successful append returns `Unit`.

pub append_text(path: String, content: String): Result[Unit, FileError].

/// Returns the portable file error code.
///
/// Input: one `FileError`.
/// Output: `Atom` identifying the portable file failure category.
/// Transformation: reads the included `code` field without exposing backend
/// filesystem reason values.

@pure
pub code(error: FileError): Atom.

/// Copies one regular file to a new path while preserving host permissions.
///
/// The destination parent must already exist. The operation rejects directory
/// sources and normalizes host failures into `FileError` without exposing file
/// descriptors or host-language values.

pub copy(source: String, destination: String): Result[Unit, FileError].

/// Copies a bounded ordered set of regular files in one capability call.
///
/// Destinations must be unique and absent. Missing destination parents are
/// created, source permissions are preserved, and files created before a later
/// failure are removed. This avoids one scheduler transition per payload file
/// in deterministic packaging and validation staging.

pub copy_many(plans: List[CopyPlan]): Result[Unit, FileError].

/// Constructs one typed regular-file copy plan.

@pure
pub copy_plan(source: String, destination: String): CopyPlan.

/// Deletes a file.
///
/// Input: one UTF-8 path string interpreted by the selected target runtime.
/// Output: `Result[Unit, FileError]`.
/// Transformation: lowers through the compiler-owned `runtime.file.delete`
/// capability. Backend file errors are normalized into `FileError` values, and a
/// successful delete returns `Unit`.

pub delete(path: String): Result[Unit, FileError].

/// Returns whether a file exists at `path`.
///
/// Input: one UTF-8 path string interpreted by the selected target runtime.
/// Output: `true` when a regular file exists, otherwise `false`.
/// Transformation: lowers through the compiler-owned `runtime.file.exists`
/// capability and keeps backend path checks behind the portable API.

pub exists(path: String): Bool.

/// Reports whether a regular file is executable on the current host.
/// Unix reads the executable mode bits; Windows uses executable extensions.

pub is_executable(path: String): Result[Bool, FileError].

/// Returns the portable file error message.
///
/// Input: one `FileError`.
/// Output: human-readable UTF-8 message.
/// Transformation: reads the included `message` field.

@pure
pub message(error: FileError): String.

/// Builds a portable file error.
///
/// Input: a symbolic file error code, human-readable message, and source path.
/// Output: `FileError`.
/// Transformation: stores the portable code and message included from
/// `std.core.Error.Error` plus file-specific path context.

@pure
pub new(code: Atom, message: String, path: String): FileError.

/// Returns the path associated with a file error.
///
/// Input: one `FileError`.
/// Output: the UTF-8 path supplied to the file operation.
/// Transformation: reads the file-specific `path` field.

@pure
pub path(error: FileError): String.

/// Reads one file without UTF-8 decoding into VM-owned immutable bytes.

pub read_bytes(path: String): Result[Bytes, FileError].

/// Reads a UTF-8 text file.
///
/// Input: one UTF-8 path string interpreted by the selected target runtime.
/// Output: `Result[String, FileError]`.
/// Transformation: lowers through the compiler-owned `runtime.file.read_text`
/// capability. Backend file errors are normalized into `FileError` values, and
/// successful file bytes are decoded as UTF-8 text for Terlan `String`.

pub read_text(path: String): Result[String, FileError].

/// Reads every immediate regular UTF-8 file in one directory.
///
/// Input: one UTF-8 directory path.
/// Output: `Result[List[TextFile], FileError]` sorted by normalized path.
/// Transformation: lowers through the compiler-owned
/// `runtime.file.read_text_directory` capability, omits directories and
/// symlinks, and reports the exact directory entry that first fails. Validators
/// can then select relevant files with pure list and string operations.

pub read_text_directory(path: String): Result[List[TextFile], FileError].

/// Reads an ordered set of UTF-8 text files in one filesystem capability call.
///
/// Input: requested UTF-8 paths in deterministic caller order.
/// Output: `Result[List[TextFile], FileError]` in the same order.
/// Transformation: lowers through the compiler-owned
/// `runtime.file.read_text_many` capability. The runtime stops at the first
/// failure and reports that path through `FileError`. This batch surface lets
/// validators discover paths purely and cross the effect boundary once.

pub read_text_many(paths: List[String]): Result[List[TextFile], FileError].

/// Reads a sorted UTF-8 file tree while pruning exact directory basenames.
///
/// Input: a root path and exact directory basenames to exclude recursively.
/// Output: every remaining regular file as a root-relative path and UTF-8 text,
/// sorted by path, or the first typed filesystem/UTF-8 failure.
/// Transformation: prunes excluded directories before descent and never follows
/// them through a later filtering pass.

pub read_text_tree_excluding(path: String, excluded_directory_names: List[String]): Result[List[TextFile], FileError].

/// Reads matching UTF-8 files from a sorted tree while pruning directories.
///
/// Input: a root path, excluded directory basenames, accepted path suffixes,
/// rejected path suffixes, a zero-based sorted-path offset, and a positive page
/// limit.
/// Output: one bounded page of matching regular files as sorted path/text pairs,
/// or the first typed filesystem/UTF-8 failure. An empty suffix list matches no
/// files; an offset beyond the tree returns an empty page.
/// Transformation: filters and pages paths before reading bytes, so unrelated
/// binary artifacts and out-of-page text never enter the actor heap.

pub read_text_tree_matching(path: String, excluded_directory_names: List[String], included_suffixes: List[String], excluded_suffixes: List[String], offset: Int, limit: Int): Result[List[TextFile], FileError].

/// Changes a regular file's executable marker without rewriting its contents.
/// Unix preserves all non-executable mode bits. On Windows, where executable
/// state is extension-defined, requests inconsistent with the suffix fail.

pub set_executable(path: String, executable: Bool): Result[Unit, FileError].

/// Restores access and modification timestamps for one regular file.
///
/// This operation changes metadata only; it never reads or rewrites contents.

pub set_timestamps(path: String, accessed_unix_ns: Int, modified_unix_ns: Int): Result[Unit, FileError].

/// Returns the logical byte length of one regular file without reading it.
///
/// This metadata operation follows the selected path in the same way as a
/// normal file read, rejects non-files, and never materializes file contents in
/// the actor heap.

pub size(path: String): Result[Int, FileError].

/// Returns the decoded UTF-8 contents stored in a batch-read value.

@pure
pub text_file_contents(file: TextFile): String.

/// Returns the requested path stored in a batch-read value.

@pure
pub text_file_path(file: TextFile): String.

/// Returns access and modification timestamps for one regular file.

pub timestamps(path: String): Result[FileTimestamps, FileError].

/// Writes a UTF-8 text file.
///
/// Input: a UTF-8 path string and UTF-8 text content.
/// Output: `Result[Unit, FileError]`.
/// Transformation: lowers through the compiler-owned `runtime.file.write_text`
/// capability. Backend file errors are normalized into `FileError` values, and a
/// successful write returns `Unit`.

pub write_text(path: String, content: String): Result[Unit, FileError].
