//! The `background-size` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets the
//! size of the element's background image. The image can be left to its natural size, stretched, or
//! constrained to fit the available space.
//!
//! Initial: auto auto. Inherited: no.
//! Percentages: relative to the background positioning area.
//!
//! Grammar: <bg-size>#
//!
//! Specification: https://drafts.csswg.org/css-backgrounds-4/#propdef-background-size
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/background-size
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.BackgroundSize.

/// Scales the background image in the corresponding direction such that its intrinsic proportions
/// are maintained.

pub type Auto =
    Atom["auto"].

pub opaque type Checked.

/// Scales the image as large as possible within its container without cropping or stretching the
/// image. If the container is larger than the image, this will result in image tiling, unless the
/// `background-repeat` property is set to `no-repeat`.

pub type Contain =
    Atom["contain"].

/// Scales the image (while preserving its ratio) to the smallest possible size to fill the container
/// (that is: both its height and width completely _cover_ the container), leaving no empty space. If
/// the proportions of the background differ from the element, the image is cropped either vertically
/// or horizontally.

pub type Cover =
    Atom["cover"].

pub struct Property {
    background_size: Auto | Cover | Contain | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer | Checked
}.

/// Checks the background-size length range. Returns Some when amount >= 0; otherwise returns None.

pub length(value: std.css.Values.Length): Option[Checked].

/// Checks the background-size percentage range. Returns Some when amount >= 0; otherwise returns
