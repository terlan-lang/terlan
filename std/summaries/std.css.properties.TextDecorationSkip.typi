  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// Nothing is skipped. Thus, text decoration is drawn for all text content and across atomic
/// inline-level boxes.

pub type None =
