/// set, it won't be displayed. The `hidden` value is similar to `none`, but `hidden` is not a valid
/// value for outline styles.
///
/// Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/column-rule

pub type Hidden =
