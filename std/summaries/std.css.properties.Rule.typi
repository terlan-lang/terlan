/// Displays a series of short square-ended dashes or line segments. The exact size and length of the
/// segments are not defined by the specification and are implementation-specific.
///
/// Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/column-rule

pub type Dashed =
    Atom["dashed"].

/// Displays a series of round dots. The radius of the dots is half the computed value of the line's
/// width. The spacing of the dots is not defined by the specification and is
/// implementation-specific.
///
/// Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/column-rule

pub type Dotted =
    Atom["dotted"].

/// Displays two straight lines with some space between them. The length of the lines adds up to the
/// pixel size defined by the line's width.
///
/// Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/column-rule

pub type Double =
