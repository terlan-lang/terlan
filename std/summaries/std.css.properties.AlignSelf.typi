/// If the item's cross-size is `auto`, the used size is set to the length necessary to be as close
/// to filling the container as possible, respecting the item's width and height limits. If the item
/// is not auto-sized, this value falls back to `flex-start`, and to `self-start` or `self-end` if
/// the container's `align-content` is `first baseline` (or `baseline`) or `last baseline`.

pub type Stretch =
    Atom["stretch"].

