/// In the case of
/// [anchor-positioned](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Anchor_positioning)
/// elements, aligns the item to the center of the associated anchor element in the block direction.
/// See [Centering on the anchor using
/// `anchor-center`](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Anchor_positioning/Using#centering_on_the_anchor_using_anchor-center).

pub type AnchorCenter =
    Atom["anchor-center"].

/// Computes to the parent's `align-items` value.

pub type Auto =
    Atom["auto"].

/// Specifies participation in first- or last-baseline alignment: aligns the alignment baseline of
/// the box's first or last baseline set with the corresponding baseline in the shared first or last
/// baseline set of all the boxes in its baseline-sharing group. The fallback alignment for `first
/// baseline` is `start`, the one for `last baseline` is `end`.

pub type Baseline =
    Atom["baseline"].

/// The flex item's margin box is centered within the line on the cross-axis. If the cross-size of
/// the item is larger than the flex container, it will overflow equally in both directions.

pub type Center =
    Atom["center"].

pub type Css =
    Auto
