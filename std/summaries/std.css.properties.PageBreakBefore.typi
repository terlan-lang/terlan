/// Initial value. Automatic page breaks (neither forced nor forbidden).

pub type Auto =
    Atom["auto"].

/// Avoid page breaks before the element.

pub type Avoid =
    Atom["avoid"].

/// Force page breaks before the element so that the next page is formatted as a left page. It's the
/// page placed on the left side of the spine of the book or the back side of the page in duplex
/// printing.

pub type Left =
