//! The `text-overflow` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets how
//! hidden overflow content is signaled to users.
//!
//! Initial: clip. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: [ clip | ellipsis | <string> | fade | <fade()> ]{1,2}
//!
//! Specification: https://drafts.csswg.org/css-overflow-4/#propdef-text-overflow
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/text-overflow
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.TextOverflow.

/// The default for this property. This keyword value will truncate the text at the limit of the
/// [content area](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Box_model/Introduction),
/// therefore the truncation can happen in the middle of a character. To clip at the transition
/// between characters you can specify `text-overflow` as an empty string, if that is supported in
/// your target browsers: `text-overflow: '';`.

pub type Clip =
    Atom["clip"].

pub opaque type Component.

pub type ComponentCss =
    Clip
  | Ellipsis.

pub type Css =
    Clip
  | Ellipsis
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// This keyword value will display an ellipsis (`'…'`, `U+2026 HORIZONTAL ELLIPSIS`) to represent
/// clipped text. The ellipsis is displayed inside the [content
/// area](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Box_model/Introduction), decreasing
/// the amount of text displayed. If there is not enough space to display the ellipsis, it is
/// clipped.

pub type Ellipsis =
    Atom["ellipsis"].

pub struct OptionalProperty {
    text_overflow: std.core.Option.Option[Value]
}.

pub struct Property {
    text_overflow: Value
}.

pub opaque type Value.

/// Chooses one text-overflow shorthand component. CSS-wide keywords are accepted only by value(css)
/// for the whole declaration.

pub component(css: ComponentCss): Component.

/// Supplies 2 components in the grammar order shown above.

pub pair(first: Component, second: Component): Value.

/// Supplies 1 components in the grammar order shown above.

pub single(first: Component): Value.

/// Selects a keyword for text-overflow. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
