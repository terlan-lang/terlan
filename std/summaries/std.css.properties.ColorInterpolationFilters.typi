/// Indicates that color interpolation should occur in the linearized RGB color space as described in
/// [the sRGB specification](https://webstore.iec.ch/en/publication/6169). This is the default
/// property value.

pub type LinearRGB =
    Atom["linearRGB"].

pub struct OptionalProperty {
    color_interpolation_filters: std.core.Option.Option[Value]
