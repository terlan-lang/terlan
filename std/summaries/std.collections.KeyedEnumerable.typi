//! Core keyed enumerable trait.
//!
//! `std.collections.KeyedEnumerable` is the portable contract for key-value
//! collection transformations that preserve the key channel.

module std.collections.KeyedEnumerable.

/// KeyedEnumerable connects a binary key-value collection constructor `C[_, _]`
/// to collection-preserving transformations.
///
/// Input: key-value collection constructor `C[_, _]`.
/// Output: a trait requiring effectful consumption and value transformation
/// methods that preserve the key channel.
/// Transformation: maps `C[K, V]` to `C[K, U]` and filters back to `C[K, V]`,
/// avoiding lossy `List` fallback behavior for keyed collections.

pub trait KeyedEnumerable[C[_, _]] {
    each[K, V](collection: C[K, V], cb: ({K, V}) -> Unit): Unit.
    filter[K, V](collection: C[K, V], predicate: ({K, V}) -> Bool): C[K, V].
    fold[K, V, U](collection: C[K, V], initial: U, reducer: (U, {K, V}) -> U): U.
    map[K, V, U](collection: C[K, V], cb: (V) -> U): C[K, U].
}.

pub impl KeyedEnumerable[std.collections.Map.Map] for std.collections.Map.Map {
}.
