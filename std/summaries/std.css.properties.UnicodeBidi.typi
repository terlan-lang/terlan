    unicode_bidi: std.css.keywords.Normal | std.css.keywords.Embed | std.css.keywords.Isolate | std.css.keywords.BidiOverride | std.css.keywords.IsolateOverride | std.css.keywords.Plaintext | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
