/// baseline-aligned.

pub type Baseline =
    Atom["baseline"].

/// Aligns the bottom padding edge of the cell with the bottom of the row.

pub type Bottom =
    Atom["bottom"].

pub type Center =
    Atom["center"].

/// Matches the box's central baseline to the central baseline of its parent, corresponding to the
/// ideographic central baseline, halfway between the ideographic-under and ideographic-over
/// baselines.
///
/// Author guide:
/// https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/alignment-baseline

pub type Central =
