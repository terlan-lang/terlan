//! The `overlay` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property specifies whether
//! an element appearing in the [top
//! layer](https://developer.mozilla.org/en-US/docs/Glossary/Top_layer) (for example, a shown
//! [popover](https://developer.mozilla.org/en-US/docs/Web/API/Popover_API) or modal `dialog`
//! element) is actually rendered in the top layer. This property is only relevant within a list of
//! `transition-property` values, and only if `allow-discrete` is set as the `transition-behavior`.
//!
//! Initial: none. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: none | auto
//!
//! Specification: https://drafts.csswg.org/css-position-4/#propdef-overlay
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/overlay
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.Overlay.

/// The element is rendered in the top layer if it is promoted to the top layer.

pub type Auto =
    Atom["auto"].

/// The element is not rendered in the top layer.

pub type None =
