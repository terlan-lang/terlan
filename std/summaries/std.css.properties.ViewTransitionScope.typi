//! The `view-transition-scope` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property
//! enables the discoverability of elements with `view-transition-name` values set on them (and
//! therefore the creation of view transition
//! [snapshots](https://developer.mozilla.org/en-US/docs/Web/API/View_Transition_API/Using#an_aside_on_snapshots))
//! to be isolated to a specific element subtree.
//!
//! Initial: none. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: none | all
//!
//! Specification: https://drafts.csswg.org/css-view-transitions-2/#propdef-view-transition-scope
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/view-transition-scope
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.ViewTransitionScope.

/// Limits the discoverability of elements to snapshot during a view transition to the subtree of the
/// element on which this property is set. Only elements with a non-`none` `view-transition-name` are
/// considered.

pub type All =
    Atom["all"].

/// The initial value. Discoverability of elements to snapshot during a view transition is not
/// limited to any specific subtree.

pub type None =
    Atom["none"].

pub struct Property {
    view_transition_scope: None | All | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
}.
