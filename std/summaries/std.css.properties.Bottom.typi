module std.css.properties.Bottom.

/// Specifies that: - for _absolutely positioned elements_, the position of the element is based on
/// the `top` property, while `height: auto` is treated as a height based on the content; or if `top`
/// is also `auto`, the element is positioned where it should vertically be positioned if it were a
/// static element. - for _relatively positioned elements_, the distance of the element from its
/// normal position is based on the `top` property; or if `top` is also `auto`, the element is not
/// moved vertically at all.

pub type Auto =
    Atom["auto"].

pub type Css =
    Auto
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

pub struct Property {
    bottom: Value
}.

pub opaque type Value.

/// Sets bottom from a typed length. Use std.css.Values.px, root_em, em, vw, or vh to choose the
/// unit.

pub length(value: std.css.Values.Length): Value.

/// Sets bottom from a typed percentage.

pub percentage(value: std.css.Values.Percentage): Value.

/// Selects a keyword for bottom. CSS-wide choices Inherit, Initial, Unset, Revert, and RevertLayer
