/// Limits the minimum height of the element's [margin
/// box](https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Box_model#parts_of_a_box)
/// to the height of its [containing
/// block](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Display/Containing_block#identifying_the_containing_block).
/// It attempts to make the margin box fill the available space in the containing block, so in a way
/// behaving similar to `100%` but applying the resulting size to the margin box rather than the box
/// determined by
/// [box-sizing](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/box-sizing).

pub type Stretch =
    Atom["stretch"].

pub opaque type Value.

