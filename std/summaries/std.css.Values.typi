//! Shared typed CSS values. Property constructors enforce property-specific ranges.

module std.css.Values.
import std.core.Atom.{*}.
import std.core.Float.{*}.
import std.core.Int.{*}.
import std.core.Option.{*}.

/// A CSS angle with a library-owned unit.

pub struct Angle {
    #amount: Float,
    #unit: Degree
}.

/// A validated CSS color. Arbitrary strings cannot construct this value.

pub struct Color {
    #css: String
}.

pub type ColorCss =
    Transparent
  | CurrentColor.

/// CSS-wide choices accepted by every generated property's Css enum.

pub type CssWide =
    Inherit
  | Initial
  | Unset
  | Revert
  | RevertLayer.

pub type CurrentColor =
    Atom["currentColor"].

pub type Degree =
    Atom["deg"].

pub type Em =
    Atom["em"].

/// Uses the parent element's computed value for this property.

pub type Inherit =
    Atom["inherit"].

/// Uses the initial value defined by the property's specification.

pub type Initial =
    Atom["initial"].

/// A length and its CSS unit. Property constructors enforce permitted ranges.

pub struct Length {
    #amount: Float,
    #unit: LengthUnit
}.

pub type LengthUnit =
    Px
  | Rem
  | Em
  | Vw
  | Vh.

pub type Millisecond =
    Atom["ms"].

/// A percentage; individual properties determine the permitted range.

pub struct Percentage {
    #amount: Float
}.

pub type Px =
    Atom["px"].

pub type Rem =
    Atom["rem"].

/// Rolls back declarations from the current cascade origin.

pub type Revert =
    Atom["revert"].

/// Rolls back declarations from the current cascade layer.

pub type RevertLayer =
    Atom["revert-layer"].

pub type Second =
    Atom["s"].

/// Serialized stylesheet declaration consumed by the compiler's existing CSS
/// pipeline. Property modules accept enums or typed inputs, validate them, and
/// produce this representation behind their checked result types.

pub struct SerializedValue {
    property: String,
    css: String
}.

/// A CSS time with a library-owned unit.

pub struct Time {
    #amount: Float,
    #unit: TimeUnit
}.

pub type TimeUnit =
    Millisecond
  | Second.

pub type Transparent =
    Atom["transparent"].

/// Inherits inherited properties and resets other properties to their initial value.

pub type Unset =
    Atom["unset"].

pub type Vh =
    Atom["vh"].

pub type Vw =
    Atom["vw"].

/// Reads an angle's magnitude for generated range checks.

@pure
pub angle_amount(value: Angle): Float.

/// Serializes an angle.

pub angle_css(value: Angle): String.

/// Serializes a color.

@pure
pub color_css(value: Color): String.

/// Constructs an angle in degrees.

@pure
pub deg(value: Float): Angle.

/// Constructs a font-relative length.

@pure
pub em(value: Float): Length.

/// Reads a length's magnitude for generated range checks.

@pure
pub length_amount(value: Length): Float.

/// Serializes a length without accepting arbitrary CSS text.

pub length_css(value: Length): String.

/// Constructs a time in milliseconds.

@pure
pub ms(value: Float): Time.

/// Constructs a percentage.

@pure
pub percent(value: Float): Percentage.

/// Reads a percentage's magnitude for generated range checks.

@pure
pub percentage_amount(value: Percentage): Float.

/// Serializes a percentage.

pub percentage_css(value: Percentage): String.

/// Constructs a pixel length.

@pure
pub px(value: Float): Length.

/// Validates RGB channels in the inclusive range 0 through 255.

pub rgb(red: Int, green: Int, blue: Int): Option[Color].

/// Constructs a root-font-relative length.

@pure
pub root_em(value: Float): Length.

/// Constructs a time in seconds.

@pure
pub seconds(value: Float): Time.

/// Constructs the wire representation used inside generated property modules.

@pure
pub serialize(property: String, css: String): SerializedValue.

/// Reads a time's magnitude for generated range checks.

@pure
pub time_amount(value: Time): Float.

/// Serializes a time.

pub time_css(value: Time): String.

/// Constructs a viewport-height-relative length.

@pure
pub vh(value: Float): Length.

/// Constructs a viewport-width-relative length.

@pure
pub vw(value: Float): Length.
