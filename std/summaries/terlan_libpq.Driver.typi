//! Generated stable libpq C ABI boundary for the VM Postgres driver.

module terlan_libpq.Driver.

/// VM-confined nonblocking libpq connection.

pub opaque type Connection.

/// Owned libpq query result copied into VM values before disposal.

pub opaque type QueryResult.

/// Cancels work by closing the connection immediately.

pub (connection: Connection) abort(): Unit.

/// Returns command affected-row count.

pub (result: QueryResult) affected_rows(): Int.

/// Clears pending query parameters.

pub (connection: Connection) clear_parameters(): Unit.

/// Returns field count.

pub (result: QueryResult) column_count(): Int.

/// Returns the stable PostgreSQL field type OID.

pub (result: QueryResult) column_oid(column: Int): Int.

/// Consumes currently readable query bytes.

pub (connection: Connection) consume_input(): Unit.

/// Closes and frees a libpq connection.

pub (connection: Connection) dispose_connection(): Unit.

/// Clears and frees a query result.

pub (result: QueryResult) dispose_result(): Unit.

/// Copies current driver error bytes into Rust-owned storage.

pub (connection: Connection) error_bytes(): List[Int].

/// Copies the current driver error into adapter scratch storage.

pub (connection: Connection) error_length(): Int.

/// Reports whether the current query needs more input.

pub (connection: Connection) is_busy(): Bool.

/// Takes the next completed query result.

pub (connection: Connection) next_result(): QueryResult.

/// Advances nonblocking connection setup once.

pub (connection: Connection) poll_connect(): Int.

/// Appends a null query parameter.

pub (connection: Connection) push_null(): Unit.

/// Appends a text-format query parameter.

pub (connection: Connection) push_text(value: String): Unit.

/// Returns tuple count.

pub (result: QueryResult) row_count(): Int.

/// Selects and copies one field name into adapter scratch storage.

pub (result: QueryResult) select_column_name(column: Int): Unit.

/// Selects and copies one result value into adapter scratch storage.

pub (result: QueryResult) select_value(row: Int, column: Int): Unit.

/// Submits a trusted multi-statement SQL batch without parameters.

pub (connection: Connection) send_batch(sql: String): Unit.

/// Submits a parameterized query without blocking.

pub (connection: Connection) send_query(sql: String): Unit.

/// Returns the socket watched by the VM reactor.

pub (connection: Connection) socket(): Int.

/// Starts a nonblocking libpq connection.

pub start(url: String): Connection.

/// Returns the libpq result status.

pub (result: QueryResult) status(): Int.

/// Copies selected value bytes into Rust-owned storage.

pub (result: QueryResult) value_bytes(): List[Int].

/// Reports selected SQL null state.

pub (result: QueryResult) value_is_null(): Bool.

/// Returns selected value byte length.

pub (result: QueryResult) value_length(): Int.
