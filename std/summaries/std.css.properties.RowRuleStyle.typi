    row_rule_style: std.css.keywords.None | std.css.keywords.Hidden | std.css.keywords.Dotted | std.css.keywords.Dashed | std.css.keywords.Solid | std.css.keywords.Double | std.css.keywords.Groove | std.css.keywords.Ridge | std.css.keywords.Inset | std.css.keywords.Outset | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
