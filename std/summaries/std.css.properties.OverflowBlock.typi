//! The `overflow-block` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property sets what
//! shows when content overflows the block start and block end edges of a box. This may be nothing, a
//! scroll bar, or the overflow content.
//!
//! Initial: auto. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: visible | hidden | clip | scroll | auto
//!
//! Specification: https://drafts.csswg.org/css-overflow-3/#propdef-overflow-block
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/overflow-block
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.OverflowBlock.

/// Depends on the user agent. If content fits inside the padding box, it looks the same as
/// `visible`, but still establishes a new block-formatting context.

pub type Auto =
    Atom["auto"].

/// Overflow content is clipped at the element's overflow clip edge that is defined using the
/// `overflow-clip-margin` property.

pub type Clip =
    Atom["clip"].

pub type Css =
    Visible
  | Hidden
  | Clip
  | Scroll
  | Auto
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// Content is clipped if necessary to fit the block dimension in the padding box. No scrollbars are
/// provided.

pub type Hidden =
    Atom["hidden"].

pub struct OptionalProperty {
    overflow_block: std.core.Option.Option[Value]
}.

pub struct Property {
    overflow_block: Value
}.

/// Content is clipped if necessary to fit in the block dimension in the padding box. Browsers
/// display scrollbars whether or not any content is actually clipped. (This prevents scrollbars from
/// appearing or disappearing when the content changes.) Printers may still print overflowing
/// content.

pub type Scroll =
    Atom["scroll"].

pub opaque type Value.

/// Content is not clipped and may be rendered outside the padding box's block start and block end
/// edges.

pub type Visible =
    Atom["visible"].

/// Selects a keyword for overflow-block. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
