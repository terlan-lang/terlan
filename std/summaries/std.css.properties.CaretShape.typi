//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.CaretShape.

/// The default value. The browser determines the caret shape. This typically follows platform
/// conventions and may change based on context.

pub type Auto =
    Atom["auto"].

/// The caret appears as a thin vertical line at the insertion point, positioned between characters
/// rather than over them.

pub type Bar =
    Atom["bar"].

/// The caret appears as a rectangle that overlaps the next character after the insertion point. If
/// no character follows, it appears after the last character.

pub type Block =
