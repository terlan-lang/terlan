//! The `content-visibility` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property
//! controls whether or not an element renders its contents at all, along with forcing a strong set
//! of containments, allowing user agents to potentially omit large swathes of layout and rendering
//! work until it becomes needed. It enables the user agent to skip an element's rendering work
//! (including layout and painting) until it is needed — which makes the initial page load much
//! faster.
//!
//! Initial: visible. Inherited: no.
//! Percentages: not accepted.
//!
//! Grammar: visible | auto | hidden
//!
//! Specification: https://drafts.csswg.org/css-contain-2/#propdef-content-visibility
//!
//! Author guide:
//! https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/content-visibility
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.ContentVisibility.

/// The element turns on layout containment, style containment, and paint containment. If the element
/// is not [relevant to the
/// user](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Containment/Using#relevant_to_the_user),
/// it also skips its contents. Unlike hidden, the skipped contents must still be available as normal
/// to user-agent features such as find-in-page, tab order navigation, etc., and must be focusable
/// and selectable as normal.

pub type Auto =
    Atom["auto"].

/// The element [skips its
/// contents](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Containment/Using#skips_its_contents).
/// The skipped contents must not be accessible to user-agent features, such as find-in-page,
/// tab-order navigation, etc., nor be selectable or focusable. This is similar to giving the
/// contents `display: none`.

pub type Hidden =
    Atom["hidden"].

pub struct Property {
    content_visibility: Visible | Auto | Hidden | std.css.Values.Inherit | std.css.Values.Initial | std.css.Values.Unset | std.css.Values.Revert | std.css.Values.RevertLayer
}.

/// No effect. The element's contents are laid out and rendered as normal. This is the default value.

pub type Visible =
    Atom["visible"].
