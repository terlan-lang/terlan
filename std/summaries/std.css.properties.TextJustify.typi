//!
//! Additional value descriptions: Microsoft (MIT).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.TextJustify.

/// The browser chooses the best type of justification for the current situation based on a balance
/// between performance and quality, but also on what is most appropriate for the language of the
/// text (e.g., English, CJK languages, etc.). This is the default justification used if
/// `text-justify` is not set at all.

pub type Auto =
    Atom["auto"].

pub type Css =
    Auto
  | None
  | InterWord
  | InterCharacter
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

/// The text is justified by adding space between characters (effectively varying `letter-spacing`),
/// which is most appropriate for languages like Japanese.

pub type InterCharacter =
    Atom["inter-character"].

/// The text is justified by adding space between words (effectively varying `word-spacing`), which
/// is most appropriate for languages that separate words using spaces, like English or Korean.

pub type InterWord =
    Atom["inter-word"].

/// The text justification is turned off. This has the same effect as not setting `text-align` at
/// all, although it is useful if you need to turn justification on and off for some reason.

pub type None =
    Atom["none"].

pub struct OptionalProperty {
    text_justify: std.core.Option.Option[Value]
}.

pub struct Property {
    text_justify: Value
}.

pub opaque type Value.

/// Selects a keyword for text-justify. CSS-wide choices Inherit, Initial, Unset, Revert, and
/// RevertLayer apply to the entire declaration.

pub value(css: Css): Value.
