//! The `inset` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS)
//! [shorthand](https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Cascade/Shorthand_properties)
//! property corresponds to the `top`, `right`, `bottom`, and/or `left` properties. It has the same
//! multi-value syntax of the `margin` shorthand.
//!
//! Initial: top: auto; bottom: auto; left: auto; right: auto. Inherited: no.
//! Percentages: relative to the containing block's size in the corresponding axis (e.g. width for
//! left or right, height for top or bottom).
//!
//! Grammar: <'top'>{1,4}
//!
//! Specification: https://drafts.csswg.org/css-position-3/#propdef-inset
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/inset
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.Inset.

/// Specifies that: - for _absolutely positioned elements_, the position of the element is based on
/// the `bottom` property, while `height: auto` is treated as a height based on the content; or if
/// `bottom` is also `auto`, the element is positioned where it should vertically be positioned if it
/// were a static element. - for _relatively positioned elements_, the distance of the element from
/// its normal position is based on the `bottom` property; or if `bottom` is also `auto`, the element
/// is not moved vertically at all.
///
/// Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/top

pub type Auto =
    Atom["auto"].

pub opaque type Component.

pub type ComponentCss =
    Auto.

pub type Css =
    Auto
  | std.css.Values.Inherit
  | std.css.Values.Initial
  | std.css.Values.Unset
  | std.css.Values.Revert
  | std.css.Values.RevertLayer.

pub struct OptionalProperty {
    inset: std.core.Option.Option[Value]
}.

pub struct Property {
    inset: Value
}.

pub opaque type Value.

/// Chooses one inset shorthand component. CSS-wide keywords are accepted only by value(css) for the
/// whole declaration.

pub component(css: ComponentCss): Component.

/// Sets inset shorthand component from a typed length. Use std.css.Values.px, root_em, em, vw, or vh
/// to choose the unit.

pub component_length(value: std.css.Values.Length): Component.

/// Sets inset shorthand component from a typed percentage.

pub component_percentage(value: std.css.Values.Percentage): Component.

/// Sets inset from a typed length. Use std.css.Values.px, root_em, em, vw, or vh to choose the unit.

pub length(value: std.css.Values.Length): Value.

/// First sets top/bottom; second sets left/right.

pub pair(first: Component, second: Component): Value.

/// Sets inset from a typed percentage.

pub percentage(value: std.css.Values.Percentage): Value.

/// Sets top, right, bottom, and left in that order.

pub quad(first: Component, second: Component, third: Component, fourth: Component): Value.

/// Applies to all four sides.

pub single(first: Component): Value.

/// First sets top; second sets left/right; third sets bottom.

pub triple(first: Component, second: Component, third: Component): Value.

/// Selects a keyword for inset. CSS-wide choices Inherit, Initial, Unset, Revert, and RevertLayer
/// apply to the entire declaration.

pub value(css: Css): Value.
