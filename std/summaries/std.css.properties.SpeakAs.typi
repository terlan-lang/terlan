//! The `speak-as` [CSS](https://developer.mozilla.org/en-US/docs/Web/CSS) property is used to define
//! how [HTML](https://developer.mozilla.org/en-US/docs/Web/HTML) content is spoken. The one to three
//! enumerated key terms determine the manner by which elements and text get rendered by aural
//! technologies, such as `screen readers` and digital assistants.
//!
//! Initial: auto. Inherited: yes.
//! Percentages: not accepted.
//!
//! Grammar: normal | spell-out || digits || [ literal-punctuation | no-punctuation ]
//!
//! Specification: https://drafts.csswg.org/css-speech-1/#propdef-speak-as
//!
//! Author guide: https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/speak-as
//!
//! Purpose and value descriptions adapted from MDN contributors (CC-BY-SA-2.5).
//!
//! Generated from @webref/css 8.7.8. Do not edit.

module std.css.properties.SpeakAs.

/// Numbers are pronounced as individual digits. For example, "31" would be pronounced as "three
/// one".

pub type Digits =
    Atom["digits"].

/// Punctuation marks are spelled out literally. For example, "Hello, world!" would be pronounced as
