/**
 * Executable direct-AOT checks for typed Git source identity.
 */
module std.vcs.GitTest.

import std.core.Result.{Err, Ok}.
import std.core.String.
import std.system.Environment.
import std.test.Test.{assert}.
import std.vcs.Git.{SourceTreeIdentityFailed, source_tree_identity}.

@test
pub repository_identity_is_full_and_deterministic(): Bool ->
    let root = Environment.current_directory();
    case {source_tree_identity(root), source_tree_identity(root)} {
        {Ok(first), Ok(second)} ->
            assert(
                String.length(first.revision) == 40
                    and String.length(first.sha256) == 64
                    and first.revision == second.revision
                    and first.clean == second.clean
                    and first.sha256 == second.sha256,
            );
        {Err(_error), _} -> false;
        {_, Err(_error)} -> false
    }.

@test
pub missing_repository_returns_typed_error(): Bool ->
    case source_tree_identity("/__terlan_missing_git_repository_40f27f5d__") {
        Ok(_identity) -> false;
        Err(reason) -> reason.code == SourceTreeIdentityFailed and reason.message != ""
    }.
