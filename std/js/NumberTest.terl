module tests.js.std.NumberTest.

import std.js.Number.{from_float}.

import type std.js.Number.{JsNumber}.

pub accepts_js_number(value: JsNumber): JsNumber ->
    value.

pub converts_to_float(value: JsNumber): Float ->
    value.to_float().

pub converts_from_float(value: Float): JsNumber ->
    from_float(value).

@test
pub number_conversions_preserve_fractional_and_negative_values(): Bool ->
    from_float(3.5).to_float() == 3.5
        and from_float(-12.25).to_float() == -12.25
        and from_float(0.0).to_float() == 0.0.
