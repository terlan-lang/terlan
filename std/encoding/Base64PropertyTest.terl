/**
 * Property coverage for portable Base64 helpers.
 *
 * `std.encoding.Base64PropertyTest` validates generated text and byte
 * roundtrips through the public Base64 APIs on the VM default path.
 */
module std.encoding.Base64PropertyTest.

import std.core.Result.{Ok}.
import std.encoding.Base64.
import std.test.Gen.{for_all, int_range, list_of, strings}.
import std.test.Test.{assert_equal}.
import std.vm.Bytes.{from_list}.

/**
 * Verifies generated text roundtrips through standard Base64.
 *
 * Input: generated deterministic string samples.
 * Output: `true` when every sample decodes back to the original text.
 * Transformation: checks the maintained Base64 adapter through the public
 * encode/decode API rather than hand-picked examples only.
 */
@test
pub generated_text_round_trips_standard_base64(): Bool ->
    for_all(strings(), (text) -> case std.encoding.Base64.decode(std.encoding.Base64.encode(text)) {
        Ok(decoded) -> assert_equal(text, decoded);
        _ -> false
    }).

/**
 * Verifies generated text roundtrips through URL-safe Base64.
 *
 * Input: generated deterministic string samples.
 * Output: `true` when every sample decodes back to the original text.
 * Transformation: checks the URL-safe API with the same generated samples as
 * the standard alphabet path.
 */
@test
pub generated_text_round_trips_url_base64(): Bool ->
    for_all(strings(), (text) -> case std.encoding.Base64.decode_url(std.encoding.Base64.encode_url(text)) {
        Ok(decoded) -> assert_equal(text, decoded);
        _ -> false
    }).

/**
 * Verifies generated byte payloads roundtrip through standard Base64.
 *
 * Input: deterministic empty and every-octet byte lists.
 * Output: `true` when every decoded buffer equals its source buffer.
 * Transformation: packs generated octets into VM-owned `Bytes` before using
 * the public byte encoder and decoder.
 */
@test
pub generated_bytes_round_trip_standard_base64(): Bool ->
    for_all(list_of(int_range(0, 255)), (values) -> let bytes = from_list(values);
    case std.encoding.Base64.decode_bytes(std.encoding.Base64.encode_bytes(bytes)) {
        Ok(decoded) -> assert_equal(bytes, decoded);
        _ -> false
    }).

/**
 * Verifies generated byte payloads roundtrip through URL-safe Base64.
 *
 * Input: deterministic empty and every-octet byte lists.
 * Output: `true` when every decoded buffer equals its source buffer.
 * Transformation: packs generated octets into VM-owned `Bytes` before using
 * the public URL-safe byte encoder and decoder.
 */
@test
pub generated_bytes_round_trip_url_base64(): Bool ->
    for_all(list_of(int_range(0, 255)), (values) -> let bytes = from_list(values);
    case std.encoding.Base64.decode_url_bytes(std.encoding.Base64.encode_url_bytes(bytes)) {
        Ok(decoded) -> assert_equal(bytes, decoded);
        _ -> false
    }).
