/**
 * Executable compatibility checks for `std.encoding.Md5`.
 */
module std.encoding.Md5Test.

import std.encoding.Md5.
import std.test.Test.{assert_equal, each, row}.

@test
pub digest_matches_rfc_vectors(): Bool ->
    each([row("empty", "", "d41d8cd98f00b204e9800998ecf8427e"), row("one byte", "a", "0cc175b9c0f1b6a831c399e269772661"), row("three bytes", "abc", "900150983cd24fb0d6963f7d28e17f72"), row("message", "message digest", "f96b697d7cb7938d525a2f31aaf161d0"), row("alphabet", "abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b")], (current) -> case current {
        {_name, input, expected} -> assert_equal(expected, Md5.digest(input))
    }).

@test
pub digest_uses_exact_utf8_bytes(): Bool ->
    assert_equal("3da186bb5d02b338502d8f6e1e6c7945", Md5.digest("Terlan: λ")).
