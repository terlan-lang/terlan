module std.template.TemplateTest.

import std.collections.List.
import std.template.Template.
import std.test.Test.{assert_equal}.

import type std.collections.List.
import type std.template.Template.Html.

pub accepts_html(value: Html): Html ->
    value.

pub accepts_html_list(value: List[Html]): List[Html] ->
    value.

@test
pub trusted_and_empty_fragments_are_stable(): Bool ->
    assert_equal(
    Template.trusted("<strong>Ada</strong>"),
    Template.trusted("<strong>" + "Ada</strong>"),
)
        and assert_equal(Template.trusted(""), Template.empty()).

@test
pub join_concatenates_trusted_fragments(): Bool ->
    let fragments = List(Template.trusted("<p>"), Template.trusted("Ada"), Template.trusted("</p>"));
    assert_equal(Template.trusted("<p>Ada</p>"), Template.join(fragments)).

@test
pub trusted_bytes_are_preserved(): Bool ->
    assert_equal("<&\"'>", Template.to_string(Template.trusted("<&\"'>")))
        and assert_equal("", Template.to_string(Template.join([]))).
