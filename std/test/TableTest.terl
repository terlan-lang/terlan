/**
 * Table-driven testing helper coverage.
 *
 * `std.test.TableTest` proves the initial table helpers operate as ordinary
 * Terlan library functions on the default VM path.
 */
module std.test.TableTest.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err}.
import std.test.Test.{assert_equal, assert_false, cases, cross_cases, each, each_iterator, each_result, each_result_iterator, each_result_report, row}.

import type std.collections.List.
import type std.core.Result.
import type std.test.Test.{Row}.

/**
 * Verifies named rows compare callback output with expected values.
 *
 * Input: two named doubling rows.
 * Output: `true` when both rows match their expected result.
 * Transformation: uses `each_result` over public `Row` values.
 */
@test
pub named_rows_compare_expected_results(): Bool ->
    let rows = List(row("one doubled", 1, 2), row("two doubled", 2, 4));
    each_result(rows, (value) -> value + value).

/**
 * Verifies `cases` returns table rows unchanged.
 *
 * Input: two named rows.
 * Output: `true` when `cases` preserves row values and order.
 * Transformation: checks the public table entry helper without runner magic.
 */
@test
pub cases_preserve_named_rows(): Bool ->
    let rows = List(row("one", 1, 1), row("two", 2, 2));
    assert_equal(rows, cases(rows)).

@test
pub cases_preserve_empty_named_rows(): Bool ->
    assert_equal(empty_int_rows(), cases(empty_int_rows())).

/**
 * Verifies cross-product cases generate boundary rows.
 *
 * Input: left and right finite value lists.
 * Output: `true` when generated rows are emitted in left-major order.
 * Transformation: checks generated table row construction without adding
 * test-only syntax.
 */
@test
pub cross_cases_generate_left_major_pairs(): Bool ->
    assert_equal([{1, "a"}, {1, "b"}, {2, "a"}, {2, "b"}], cross_cases(List(1, 2), List("a", "b"))).

/**
 * Verifies cross-product generation treats either empty side as no rows.
 *
 * Input: one empty left-side table and one empty right-side table.
 * Output: `true` when both generated tables are empty.
 * Transformation: locks table identity behavior for generated boundary rows.
 */
@test
pub cross_cases_returns_empty_when_either_side_is_empty(): Bool ->
    assert_equal(empty_pair_rows(), cross_cases(empty_int_values(), List("a"))) and assert_equal(empty_pair_rows(), cross_cases(List(1), empty_binary_values())).

/**
 * Verifies anonymous row values can use callback assertions directly.
 *
 * Input: a list of integer rows.
 * Output: `true` when every row satisfies the callback predicate.
 * Transformation: applies `each` without wrapping rows in `Row`.
 */
@test
pub anonymous_rows_use_callback_assertions(): Bool ->
    each(List(1, 2, 3), (value) -> value > 0).

/**
 * Verifies iterator helper entry points match list helper behavior.
 *
 * Input: anonymous rows and named rows converted to iterators.
 * Output: `true` when both iterator helpers accept equivalent rows.
 * Transformation: checks public implementation helpers used by VM std
 * dispatch without bypassing table semantics.
 */
@test
pub iterator_helpers_match_table_helpers(): Bool ->
    let values = List(1, 2, 3);
    let rows = List(row("one", 1, 2), row("two", 2, 4));
    each_iterator(values.iterator(), (value) -> value > 0) and each_result_iterator(rows.iterator(), (value) -> value + value).

/**
 * Verifies generated boundary rows can feed table assertions.
 *
 * Input: rows returned by a helper function.
 * Output: `true` when every boundary value classifies as expected.
 * Transformation: keeps generated row data as normal source values.
 */
@test
pub generated_boundary_rows_compare_expected_results(): Bool ->
    each_result(boundary_rows(), (value) -> classify(value)).

/**
 * Verifies typed expected-error rows compare `Result` values.
 *
 * Input: one success row and one error row.
 * Output: `true` when the callback returns the expected `Result` channel.
 * Transformation: proves table rows can carry typed expected errors without
 * special syntax.
 */
@test
pub typed_expected_error_rows_compare_results(): Bool ->
    let rows = List(row("negative one", -1, Err("negative")), row("negative two", -2, Err("negative")));
    each_result(rows, (value) -> classify_result(value)).

/**
 * Verifies row reports capture the first expected-value mismatch.
 *
 * Input: three named rows where the second row has the wrong expected value.
 * Output: `true` when the report includes row index, row name, expected value,
 * and actual value for the first mismatch.
 * Transformation: checks typed row diagnostics without parsing runner output.
 */
@test
pub each_result_report_records_first_failed_row(): Bool ->
    let rows = List(row("ok", 1, 2), row("bad", 2, 5), row("later", 3, 6));
    assert_equal({false, Some({1, "bad", 5, 4})}, each_result_report(rows, (value) -> value + value)).

/**
 * Verifies an empty expected-result table reports success without failures.
 *
 * Input: an empty typed table.
 * Output: `true` when the report is `{true, None}`.
 * Transformation: locks the empty-table identity behavior for typed row
 * diagnostics.
 */
@test
pub each_result_report_accepts_empty_rows(): Bool ->
    assert_equal({true, None}, each_result_report(empty_int_rows(), (value) -> value + value)).

/**
 * Verifies a failing row produces a failing table assertion.
 *
 * Input: one intentionally mismatched row.
 * Output: `true` when `each_result` returns `false`.
 * Transformation: locks failure propagation for table helpers without relying
 * on runner-specific syntax.
 */
@test
pub failing_row_returns_false(): Bool ->
    let rows = List(row("wrong value", 1, 3));
    assert_false(each_result(rows, (value) -> value + value)).

empty_int_rows(): List[Row[Int, Int]] -> [].

empty_int_values(): List[Int] -> [].

empty_binary_values(): List[Binary] -> [].

empty_pair_rows(): List[{Int, Binary}] -> [].

boundary_rows(): List[Row[Int, Binary]] ->
    List(row("negative", -1, "negative"), row("zero", 0, "zero"), row("positive", 1, "positive")).

classify(value: Int): Binary ->
    if {
    value < 0 -> "negative";
    value == 0 -> "zero";
    true -> "positive"
    }.

classify_result(value: Int): Result[Int, Binary] ->
    if {
    value < 0 -> Err("negative");
    true -> Err("unexpected")
    }.
