module std.test.Test.AssertionsTest.

import std.test.Test.{assert, assert_equal, assert_false, assert_not_equal, assert_true, fail}.

@test
pub assert_accepts_computed_true(): Bool ->
    assert(1 + 1 == 2).

@test
pub assert_returns_false_for_false_condition(): Bool ->
    assert(false) == false.

@test
pub assert_true_accepts_true(): Bool ->
    assert_true(true).

@test
pub assert_true_returns_false_for_false_condition(): Bool ->
    assert_true(false) == false.

@test
pub assert_false_accepts_false(): Bool ->
    assert_false(1 + 1 == 3).

@test
pub assert_false_returns_false_for_true_condition(): Bool ->
    assert_false(true) == false.

@test
pub assert_equal_accepts_equal_values(): Bool ->
    assert_equal(40 + 2, 41 + 1).

@test
pub assert_equal_returns_false_for_different_values(): Bool ->
    assert_equal(42, 7) == false.

@test
pub assert_not_equal_accepts_different_values(): Bool ->
    assert_not_equal(42, 7).

@test
pub assert_not_equal_returns_false_for_equal_values(): Bool ->
    assert_not_equal(42, 42) == false.

@test
pub case_pattern_accepts_matching_value(): Bool ->
    case {"user", 42} {
        {"user", id} -> assert_equal(42, id);
        _ -> false
    }.

@test
pub case_pattern_rejects_nonmatching_value(): Bool ->
    case {"admin", 42} {
        {"user", _id} -> false;
        _ -> true
    }.

@test
pub case_pattern_guard_accepts_matching_value(): Bool ->
    case {"user", 42} {
        {"user", id} where id > 0 -> assert_equal(42, id);
        _ -> false
    }.

@test
pub case_pattern_guard_rejects_failing_guard(): Bool ->
    case {"user", 0} {
        {"user", id} where id > 0 -> false;
        _ -> true
    }.

@test
pub fail_returns_false(): Bool ->
    fail() == false.
