{
  "dependency_files": [
    "proofs/lean/lake-manifest.json",
    "proofs/lean/lakefile.lean",
    "proofs/lean/lean-toolchain"
  ],
  "deterministic_timestamp_strategy": "none",
  "execution_command": [
    "lake",
    "env",
    "lean",
    "std_packages/StdPackages.lean"
  ],
  "family": "std-packages",
  "output_signature": {
    "exit_class": "success",
    "stderr_class": "empty",
    "stdout_class": "empty"
  },
  "schema": "terlan.lean-proof-replay.v2",
  "theorem_names": [
    "Terlan.StdPackages.jsonRoundTrip",
    "Terlan.StdPackages.invalidJsonIsTypedFailure",
    "Terlan.StdPackages.binaryStringConversionPreservesBytes",
    "Terlan.StdPackages.missingOptionReturnsTypedError",
    "Terlan.StdPackages.monotonicTimerAccepted",
    "Terlan.StdPackages.earlyTimerRejected"
  ],
  "toolchain": {
    "elan_channel": "leanprover/lean4:v4.31.0",
    "lake_flags": [
      "env",
      "lean"
    ],
    "lean_version": "4.31.0"
  },
  "working_directory": "proofs/lean",
  "manifests": [
    "std/data/Json.terl"
  ]
}
