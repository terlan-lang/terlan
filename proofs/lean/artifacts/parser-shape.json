{
  "dependency_files": [
    "proofs/lean/lake-manifest.json",
    "proofs/lean/lakefile.lean",
    "proofs/lean/lean-toolchain"
  ],
  "deterministic_timestamp_strategy": "none",
  "execution_command": [
    "lake",
    "env",
    "lean",
    "parser_shape/ParserShape.lean"
  ],
  "family": "parser-shape",
  "output_signature": {
    "exit_class": "success",
    "stderr_class": "empty",
    "stdout_class": "empty"
  },
  "schema": "terlan.lean-proof-replay.v2",
  "theorem_names": [
    "Terlan.ParserShape.canonicalGrammarIdentityIsStable",
    "Terlan.ParserShape.canonicalModuleClassificationAccepted",
    "Terlan.ParserShape.plainAssignmentClassificationRejected",
    "Terlan.ParserShape.multiplicationBindsAboveAddition",
    "Terlan.ParserShape.bitwisePrecedenceIsCanonical",
    "Terlan.ParserShape.generatedFoldIsLeftAssociative",
    "Terlan.ParserShape.tupleOutputWellFormed",
    "Terlan.ParserShape.recordOutputWellFormed",
    "Terlan.ParserShape.listOutputWellFormed",
    "Terlan.ParserShape.mapOutputWellFormed",
    "Terlan.ParserShape.bitstringOutputWellFormed",
    "Terlan.ParserShape.implContractOutputWellFormed",
    "Terlan.ParserShape.capabilityDenyOutputWellFormed",
    "Terlan.ParserShape.loweringPreservesShapeKind",
    "Terlan.ParserShape.loweringPreservesShapeArity",
    "Terlan.ParserShape.loweringPreservesShapeFields",
    "Terlan.ParserShape.checkedCapabilityDenyListHasNoDuplicates",
    "Terlan.ParserShape.acceptedBoundaryCanEnterCheckedLowering"
  ],
  "toolchain": {
    "elan_channel": "leanprover/lean4:v4.31.0",
    "lake_flags": [
      "env",
      "lean"
    ],
    "lean_version": "4.31.0"
  },
  "working_directory": "proofs/lean",
  "manifests": [
    "crates/terlan/src/compiler/syntax/syntax_output.rs",
    "crates/terlan/src/compiler/syntax/terlan_lalrpop.lalrpop",
    "docs/grammar/TERLAN_SYNTAX_SPEC.ebnf"
  ]
}
