{
  "dependency_files": [
    "proofs/lean/lake-manifest.json",
    "proofs/lean/lakefile.lean",
    "proofs/lean/lean-toolchain"
  ],
  "deterministic_timestamp_strategy": "none",
  "execution_command": [
    "lake",
    "env",
    "lean",
    "Terlan/Core/Arithmetic.lean"
  ],
  "family": "coreir-arithmetic",
  "output_signature": {
    "exit_class": "success",
    "stderr_class": "empty",
    "stdout_class": "empty"
  },
  "schema": "terlan.lean-proof-replay.v2",
  "theorem_names": [
    "Terlan.Core.addEvaluationPreservesInteger",
    "Terlan.Core.typedIntegerExpressionEvaluates"
  ],
  "toolchain": {
    "elan_channel": "leanprover/lean4:v4.31.0",
    "lake_flags": [
      "env",
      "lean"
    ],
    "lean_version": "4.31.0"
  },
  "working_directory": "proofs/lean",
  "manifests": [
    "docs/compiler/CORE_IR_LEAN_CONFORMANCE.md",
    "docs/compiler/type_spec/terlan_core_typing_spec.toml"
  ]
}
