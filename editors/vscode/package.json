{
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:terlan",
    "onLanguage:terlan-script",
    "onLanguage:terlan-test",
    "onLanguage:terlan-interface",
    "onLanguage:terlan-template-html",
    "onLanguage:terlan-template-markdown",
    "onLanguage:terlan-template-json",
    "onLanguage:terlan-template-toml",
    "onLanguage:terlan-template-yaml",
    "onLanguage:terlan-template-text",
    "onCommand:terlan.runMain",
    "onCommand:terlan.runCheck",
    "onCommand:terlan.runBuild",
    "onCommand:terlan.runClean",
    "onCommand:terlan.runServe",
    "onCommand:terlan.runWatch",
    "onCommand:terlan.runDoctor",
    "onCommand:terlan.runDebug",
    "onCommand:terlan.runDebugAtCursor",
    "onCommand:terlan.inspectRuntime",
    "onCommand:terlan.addMissingImport",
    "onCommand:terlan.formatDocument",
    "onCommand:terlan.showDiagnostics",
    "onCommand:terlan.runTestFile",
    "onCommand:terlan.runTestAtCursor"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "category": "Terlan",
        "command": "terlan.runMain",
        "icon": "$(play)",
        "title": "Run Terlan Main"
      },
      {
        "category": "Terlan",
        "command": "terlan.runCheck",
        "icon": "$(check)",
        "title": "Check Terlan Workspace"
      },
      {
        "category": "Terlan",
        "command": "terlan.runBuild",
        "icon": "$(package)",
        "title": "Build Terlan Workspace"
      },
      {
        "category": "Terlan",
        "command": "terlan.runClean",
        "icon": "$(trash)",
        "title": "Clean Terlan Workspace"
      },
      {
        "category": "Terlan",
        "command": "terlan.runServe",
        "icon": "$(server)",
        "title": "Serve Terlan Web"
      },
      {
        "category": "Terlan",
        "command": "terlan.runWatch",
        "icon": "$(sync)",
        "title": "Watch Terlan Web"
      },
      {
        "category": "Terlan",
        "command": "terlan.runDoctor",
        "icon": "$(tools)",
        "title": "Run Terlan Doctor"
      },
      {
        "category": "Terlan",
        "command": "terlan.runDebug",
        "icon": "$(debug-alt)",
        "title": "Launch Terlan Debug"
      },
      {
        "category": "Terlan",
        "command": "terlan.runDebugAtCursor",
        "icon": "$(debug-breakpoint)",
        "title": "Debug Terlan at Cursor"
      },
      {
        "category": "Terlan",
        "command": "terlan.runTestFile",
        "icon": "$(beaker)",
        "title": "Run Terlan Test File"
      },
      {
        "category": "Terlan",
        "command": "terlan.runTestAtCursor",
        "icon": "$(play)",
        "title": "Run Terlan Test at Cursor"
      },
      {
        "category": "Terlan",
        "command": "terlan.inspectRuntime",
        "icon": "$(inspect)",
        "title": "Inspect Terlan Runtime"
      },
      {
        "category": "Terlan",
        "command": "terlan.addMissingImport",
        "icon": "$(lightbulb)",
        "title": "Add Missing Terlan Import"
      },
      {
        "category": "Terlan",
        "command": "terlan.formatDocument",
        "icon": "$(symbol-keyword)",
        "title": "Format Terlan Document"
      },
      {
        "category": "Terlan",
        "command": "terlan.showDiagnostics",
        "icon": "$(warning)",
        "title": "Show Terlan Diagnostics"
      }
    ],
    "configuration": {
      "properties": {
        "terlan.lsp.args": {
          "default": [
            "lsp",
            "--stdio"
          ],
          "description": "Arguments passed to the Terlan language-server command.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "terlan.lsp.command": {
          "default": "terlc",
          "description": "Command used to start the Terlan language server.",
          "type": "string"
        },
        "terlan.run.command": {
          "default": "terlc",
          "description": "Command used by the Run Terlan Main button.",
          "type": "string"
        }
      },
      "title": "Terlan"
    },
    "grammars": [
      {
        "language": "terlan-test",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.terlan"
      },
      {
        "language": "terlan",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.terlan"
      },
      {
        "language": "terlan-script",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.terlan"
      },
      {
        "language": "terlan-interface",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.terlan.interface"
      },
      {
        "embeddedLanguages": {
          "source.terlan.embedded": "terlan",
          "text.html.basic": "html"
        },
        "language": "terlan-template-html",
        "path": "./syntaxes/terlan-template-html.tmLanguage.json",
        "scopeName": "text.html.terlan"
      },
      {
        "embeddedLanguages": {
          "source.terlan.embedded": "terlan",
          "text.html.markdown": "markdown"
        },
        "language": "terlan-template-markdown",
        "path": "./syntaxes/terlan-template-markdown.tmLanguage.json",
        "scopeName": "text.html.markdown.terlan"
      },
      {
        "language": "terlan-template-json",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.json.terlan"
      },
      {
        "language": "terlan-template-toml",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.toml.terlan"
      },
      {
        "language": "terlan-template-yaml",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "source.yaml.terlan"
      },
      {
        "language": "terlan-template-text",
        "path": "./syntaxes/terlan.tmLanguage.json",
        "scopeName": "text.terlan"
      }
    ],
    "iconThemes": [
      {
        "id": "terlan-file-icons",
        "label": "Terlan File Icons",
        "path": "./icons/terlan-file-icon-theme.json"
      }
    ],
    "languages": [
      {
        "aliases": [
          "Terlan Test",
          "terlan-test"
        ],
        "configuration": "./language-configuration.json",
        "filenamePatterns": [
          "*Test.terl"
        ],
        "icon": {
          "dark": "./icons/terlan-test-file.svg",
          "light": "./icons/terlan-test-file.svg"
        },
        "id": "terlan-test"
      },
      {
        "aliases": [
          "Terlan",
          "terlan"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan"
      },
      {
        "aliases": [
          "Terlan Script",
          "terlan-script"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terls"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-script"
      },
      {
        "aliases": [
          "Terlan Interface",
          "terli"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terli"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-interface"
      },
      {
        "aliases": [
          "Terlan HTML Template",
          "Terlan HTML",
          "HTML"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.html"
        ],
        "icon": {
          "dark": "./icons/terlan-template-html-file.svg",
          "light": "./icons/terlan-template-html-file.svg"
        },
        "id": "terlan-template-html"
      },
      {
        "aliases": [
          "Terlan Markdown Template"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.md"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-template-markdown"
      },
      {
        "aliases": [
          "Terlan JSON Template"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.json"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-template-json"
      },
      {
        "aliases": [
          "Terlan TOML Template"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.toml"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-template-toml"
      },
      {
        "aliases": [
          "Terlan YAML Template"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.yaml",
          ".terl.yml"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-template-yaml"
      },
      {
        "aliases": [
          "Terlan Text Template"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".terl.txt"
        ],
        "icon": {
          "dark": "./icons/terlan-file.svg",
          "light": "./icons/terlan-file.svg"
        },
        "id": "terlan-template-text"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "terlan.runMain",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runCheck",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runBuild",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runServe",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runWatch",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDoctor",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDebug",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDebugAtCursor",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runClean",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runTestAtCursor",
          "group": "navigation",
          "when": "resourceFilename =~ /Test\\.terl$/"
        },
        {
          "command": "terlan.runTestFile",
          "group": "navigation",
          "when": "resourceFilename =~ /Test\\.terl$/"
        }
      ],
      "explorer/context": [
        {
          "command": "terlan.runMain",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runCheck",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runBuild",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runServe",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runWatch",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDoctor",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDebug",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runDebugAtCursor",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runClean",
          "group": "navigation",
          "when": "resourceFilename =~ /\\.terls?$/"
        },
        {
          "command": "terlan.runTestFile",
          "group": "navigation",
          "when": "resourceFilename =~ /Test\\.terl$/"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "description": "Syntax highlighting and language-server integration for Terlan source files.",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.125.0"
  },
  "displayName": "Terlan",
  "engines": {
    "vscode": "^1.91.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "icons",
    "language-configuration.json",
    "syntaxes",
    "src"
  ],
  "icon": "icons/png/terlan-extension-128.png",
  "license": "Apache-2.0",
  "main": "./src/extension.js",
  "name": "terlan-vscode",
  "publisher": "terlan-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/terlan-lang/terlan.git"
  },
  "scripts": {
    "check": "node -c src/client_config.js && node -c src/run_command.js && node -c src/template_links.js && node -c src/extension.js && node -c test/client_config_test.js && node -c test/run_command_test.js && node -c test/template_links_test.js && node -c test/manifest_test.js && node -c test/package_smoke_test.js && node -c test/diagnostics_smoke_test.js && node -c test/pack_dry_run_test.js && node -c test/textmate_bridge_test.js",
    "check:main": "node -c src/client_config.js && node -c src/run_command.js && node -c src/template_links.js && node -c src/extension.js",
    "pack:dry-run": "npm pack --dry-run --json",
    "test": "npm run test:core && npm run test:diagnostics && npm run test:textmate",
    "test:all": "npm run check && npm test",
    "test:core": "node test/client_config_test.js && node test/run_command_test.js && node test/template_links_test.js && node test/manifest_test.js && node test/package_smoke_test.js",
    "test:diagnostics": "node test/diagnostics_smoke_test.js",
    "test:textmate": "node test/textmate_bridge_test.js"
  },
  "version": "0.0.9"
}
