module std.core.Secret.SecretRejectsOrderingTest.

import std.core.Ordering.{Comparison, Eq, Ordering}.
import std.core.Secret.{Secret, new}.

compare[T](left: T, right: T)[Ordering[T]]: Comparison ->
    Ordering.compare(left, right).

@test
pub secret_rejects_ordering(): Bool ->
    let secret = new("private");
    compare(secret, secret) == Eq.
