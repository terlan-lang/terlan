module tests.language.NullaryConstructorAtomAliasTest.

import std.vm.Cluster.{Disconnected as OfflineTag}.

pub type PauseTag = Atom["pause_work"].

pub type Action = PauseTag | {Atom["resume_work"], Int}.

pub constructor PauseWork {
    (): Action ->
        PauseTag
}.

pub constructor ResumeWork {
    (value: Int): Action ->
        {Atom["resume_work"], value}
}.

pub classify(action: Action): Int ->
    case action {
        PauseWork() -> 0;
        ResumeWork(value) -> value
    }.

pub type Signal = Atom["enabled"] | OfflineTag.

pub constructor Enabled {
    (): Signal ->
        Atom["enabled"]
}.

pub constructor Disconnected {
    (): Signal ->
        OfflineTag
}.

pub enabled(signal: Signal): Bool ->
    case signal {
        Enabled() -> true;
        Disconnected() -> false
    }.

@test
pub local_atom_alias_body_matches(): Bool ->
    classify(PauseWork()) == 0.

@test
pub payload_constructor_still_matches(): Bool ->
    classify(ResumeWork(7)) == 7.

@test
pub literal_atom_body_still_matches(): Bool ->
    enabled(Enabled()).

@test
pub renamed_imported_atom_body_matches(): Bool ->
    not enabled(Disconnected()).
