module tests.language.RepeatedLetSyntaxTest.

import std.core.Result.{Err, Ok, Result}.
import std.test.Test.{assert_equal}.

@test
pub repeated_lets_preserve_order_and_scope(): Bool ->
    let first = 2;
    let second = first + 3;
    let result = first * second;
    assert_equal(10, result).

pub resolve(first: Result[Int, String], second: Result[Int, String]): Result[Int, String] ->
    if {
        Ok(left) <- first;
        Ok(right) <- second
    } else {
        Err(reason) -> Err(reason)
    };
    Ok(left + right).

@test
pub grouped_refutable_if_runs_success_continuations(): Bool ->
    assert_equal(Ok(5), resolve(Ok(2), Ok(3))).

@test
pub grouped_refutable_if_stops_at_first_mismatch(): Bool ->
    assert_equal(Err("first"), resolve(Err("first"), Err("second"))).

@test
pub grouped_refutable_if_handles_later_mismatch(): Bool ->
    assert_equal(Err("second"), resolve(Ok(2), Err("second"))).

pub resolve_without_else(
    first: Result[Int, String],
    second: Result[Int, String],
): Result[Int, String] ->
    Ok(left) <- first;
    Ok(right) <- second;
    Ok(left + right).

@test
pub bare_refutable_runs_success_continuation(): Bool ->
    assert_equal(Ok(5), resolve_without_else(Ok(2), Ok(3))).

@test
pub bare_refutable_propagates_first_mismatch_unchanged(): Bool ->
    assert_equal(Err("first"), resolve_without_else(Err("first"), Err("second"))).

@test
pub bare_refutable_propagates_later_mismatch_unchanged(): Bool ->
    assert_equal(Err("second"), resolve_without_else(Ok(2), Err("second"))).
