module tests.language.PurityEffectsTest.

import std.core.Effect.
import std.test.Test.{assert_equal}.

is_positive(value: Int): Bool ->
    value > 0.

@pure
is_even(value: Int): Bool ->
    value rem 2 == 0.

classify_inferred(value: Int): String ->
    case value {
        candidate where is_positive(candidate) -> "positive";
        _ -> "other"
    }.

classify_asserted(value: Int): String ->
    case value {
        candidate where is_even(candidate) -> "even";
        _ -> "odd"
    }.

@test
pub inferred_and_asserted_helpers_execute_in_guards(): Bool ->
    assert_equal("positive", classify_inferred(7))
        and assert_equal("other", classify_inferred(-1))
        and assert_equal("even", classify_asserted(8))
        and assert_equal("odd", classify_asserted(7)).

@pure
double(value: Int): Int ->
    value * 2.

must_not_run(value: Int): Int ->
    value div 0.

@pure
deferred_plan(value: Int): Effect[Int] ->
    Effect.map(Effect.succeed(value), double).

@test
pub pure_effect_description_executes_only_at_explicit_boundary(): Bool ->
    let _deferred_failure = Effect.map(Effect.succeed(1), must_not_run);
    let planned = deferred_plan(21);
    assert_equal(42, Effect.run(planned)).
