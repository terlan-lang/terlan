module tests.language.ComprehensionGuardsTest.

import std.collections.List.{length}.
import std.collections.{Iterable, Map, Set}.
import std.core.Effect.
import std.core.GuardResult.{GuardResult, from_bool, reject}.
import std.test.Test.{assert_equal}.

@test
pub list_comprehension_yields_transformed_values(): Bool ->
    let values = [1, 2, 3];
    let incremented = [value + 1 | value <- values];
    assert_equal([2, 3, 4], incremented).

@test
pub list_comprehension_applies_stacked_boolean_filters(): Bool ->
    let values = [-1, 0, 1, 2, 10];
    let filtered = [value | value <- values, value > 0 and value < 10];
    assert_equal([1, 2], filtered).

@test
pub list_comprehension_supports_empty_results(): Bool ->
    let values = [1, 2, 3];
    let filtered = [value | value <- values, value > 10];
    assert_equal(0, length(filtered)).

@test
pub list_comprehension_supports_range_membership_filters(): Bool ->
    let values = [0, 1, 2, 3, 4];
    let filtered = [value | value <- values, value in 1 .. 3];
    assert_equal([1, 2, 3], filtered).

@test
pub list_comprehension_accepts_range_sources(): Bool ->
    let doubled = [value * 2 | value <- 1 .. 3];
    assert_equal([2, 4, 6], doubled).

@test
pub list_comprehension_binds_tuple_generator_patterns(): Bool ->
    let pairs = [{1, "skip"}, {2, "keep"}, {3, "keep"}];
    let ids = [id | {id, label} <- pairs, label == "keep"];
    assert_equal([2, 3], ids).

@test
pub list_comprehension_accepts_pure_helper_filters(): Bool ->
    let values = [-1, 0, 1, 2, 10];
    let filtered = [value | value <- values, is_visible(value)];
    assert_equal([1, 2], filtered).

@test
pub list_comprehension_preserves_generator_product_order(): Bool ->
    let left = [1, 2];
    let right = [10, 20];
    let pairs = [{x, y} | x <- left, y <- right];
    assert_equal([{1, 10}, {1, 20}, {2, 10}, {2, 20}], pairs).

@test
pub list_comprehension_later_source_uses_earlier_binding(): Bool ->
    let rows = [[1, 2], [3]];
    let flattened = [value | row <- rows, value <- row];
    assert_equal([1, 2, 3], flattened).

@test
pub list_comprehension_filters_after_all_generators(): Bool ->
    let left = [1, 2, 3];
    let right = [1, 2, 3];
    let pairs = [{x, y} | x <- left, y <- right, x < y];
    assert_equal([{1, 2}, {1, 3}, {2, 3}], pairs).

@test
pub list_comprehension_accepts_completed_guard_results(): Bool ->
    let values = [-1, 0, 1, 2];
    let positives = [value | value <- values, from_bool(value > 0)];
    assert_equal([1, 2], positives).

@test
pub list_comprehension_honors_rejected_guard_results(): Bool ->
    let values = [1, 2, 3];
    let filtered = [value | value <- values, reject()];
    assert_equal(0, length(filtered)).

@test
pub list_comprehension_accepts_set_sources(): Bool ->
    let values = Set(3, 1, 2, 2);
    let filtered = [value | value <- values, value > 1];
    assert_equal([3, 2], filtered).

@test
pub list_comprehension_accepts_map_sources(): Bool ->
    let values = Map({"first", 1}, {"second", 2}, {"third", 3});
    let filtered = [value | {_key, value} <- values, value > 1];
    assert_equal([2, 3], filtered).

@test
pub effectful_comprehension_guard_lifts_and_accepts(): Bool ->
    let values = [1, 2, 3];
    let planned = [value | value <- values, Effect.succeed(value > 1)];
    assert_equal([2, 3], Effect.run(planned)).

@test
pub effectful_comprehension_guard_filters_false_in_source_order(): Bool ->
    let values = [1, 2, 3];
    let planned = [value | value <- values, Effect.succeed(value > 1), Effect.succeed(value < 3)];
    assert_equal([2], Effect.run(planned)).

@test
pub effectful_comprehension_guard_short_circuits_later_pure_failure(): Bool ->
    let values = [1];
    let planned = [value | value <- values, Effect.succeed(false), 1 div value - value == 0];
    assert_equal(0, length(Effect.run(planned))).

is_visible(value: Int): Bool ->
    value > 0 and value < 10.
