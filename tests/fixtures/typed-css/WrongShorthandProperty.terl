module typed_css.WrongShorthandProperty.

import std.css.properties.Margin.{Auto as MarginAuto}.
import std.css.properties.MarginInline.{Auto as InlineAuto}.
import std.css.properties.{Margin, MarginInline}.

pub invalid(): Margin.Value ->
    Margin.pair(MarginInline.component(InlineAuto), Margin.component(MarginAuto)).
