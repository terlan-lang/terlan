module fixture.Adapter.

import type std.core.Result.{Result}.

pub struct Transition[State] {
    current: State,
}.

pub trait Adapter[Implementation, State, Failure] {
    execute(
        implementation: Implementation,
        state: State,
    ): Result[Transition[State], Failure].
}.

pub struct AggregateTransition[State, Observation] {
    previous: State,
    current: State,
    observation: Observation,
}.

pub trait Processor[Implementation, State, Input, Observation, Failure] {
    observe(
        implementation: Implementation,
        state: State,
        input: Input,
    ): Result[AggregateTransition[State, Observation], Failure].
}.
