module terlan.registry.Http.

import std.http.{Response, Router}.

import type std.http.{Request, Response, Router}.

pub router(): Router ->
    let router = Router.get(Router.new(), "/health", health);
    router.get("/packages/:name", package).

pub health(_request: Request): Response ->
    Response.text("ok").

pub package(_request: Request): Response ->
    Response.text("package").
