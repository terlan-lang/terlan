module html_conditionals.

pub type Role = admin | viewer.

pub view(Role: Role): Html[none] ->
    html {
        <div>
            {case Role {
                admin ->
                    html {
                        <span class="admin">
                            Admin
                        </span>
                    };
                viewer ->
                    html {
                        <span>
                            Viewer
                        </span>
                    }
            }}
        </div>
    }.
