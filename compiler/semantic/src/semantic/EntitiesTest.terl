/**
 * Identity preservation, invalidation, and stale-selection rejection.
 */
module semantic.EntitiesTest.

import semantic.{Entities, Snapshot}.
import std.core.Option.{Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Unit}.
import std.data.Json.
import std.io.{Directory, File}.
import std.system.Environment.

import type std.core.Result.
import type std.data.Json.

compiler(): String ->
    case Environment.get("TERLAN_SEMANTIC_TEST_COMPILER") {
        Some(value) -> value;
        _ -> Environment.current_directory() + "/target/debug/terlc"
    }.

text(value: Json, key: String): String ->
    let {
        Ok(field) <- value.get(key);
        Ok(result) <- field.as_string()
    } else {
        _ -> ""
    };
    result.

capture(root: String, source: String): Result[Json, Bool] ->
    let {
        Ok(_) <- File.write_text(root + "/sample.terl", source);
        Ok(snapshot) <-
            Snapshot.capture_file(
                compiler(),
                root + "/sample.terl",
                "src/sample.terl",
                root + "/store",
            );
        Ok(catalog) <- Entities.bindings(root + "/store", text(snapshot, "snapshot_id"));
        Ok(rows) <- catalog.get("entities")
    } else {
        _ -> Err(false)
    };
    Ok(rows).

@test
pub unrelated_insertion_preserves_identity_but_requires_fresh_content(): Bool ->
    let body = "pub value(input: Int): Int -> let local = input + 1; local.\n";
    let {
        Ok(root) <- Directory.create_temporary("terlan-entity-stability-");
        Ok(before) <- capture(root, "module sample.\n" + body);
        Ok(later) <- capture(root, "module sample.\npub unrelated(): Int -> 0.\n" + body);
        Ok(first) <- before.at(1);
        Ok(second) <- later.at(1)
    } else {
        _ -> false
    };
    (let same = text(first, "entity_id") == text(second, "entity_id") and text(first, "name") == "local";
let stale =
    case Entities.resolve_binding(
        root + "/store",
        text(second, "snapshot_id"),
        text(first, "entity_id"),
        text(first, "digest"),
    ) {
        Err(reason) -> reason.code == "semantic.entity.stale";
        _ -> false
    };
let fresh =
    case Entities.resolve_binding(
        root + "/store",
        text(second, "snapshot_id"),
        text(second, "entity_id"),
        text(second, "digest"),
    ) {
        Ok(_) -> true;
        _ -> false
    };
let cleaned = Directory.remove_all(root) == Ok(Unit);
same and stale and fresh and cleaned).

@test
pub renamed_binding_invalidates_old_handle_without_name_fallback(): Bool ->
    let body = "module sample.\npub value(input: Int): Int -> let local = input + 1; local.\n";
    let {
        Ok(root) <- Directory.create_temporary("terlan-entity-rename-");
        Ok(before) <- capture(root, body);
        Ok(later) <- capture(root, body.replace("local", "renamed"));
        Ok(first) <- before.at(1);
        Ok(second) <- later.at(1)
    } else {
        _ -> false
    };
    (let changed = text(first, "entity_id") != text(second, "entity_id");
let absent =
    case Entities.resolve_binding(
        root + "/store",
        text(second, "snapshot_id"),
        text(first, "entity_id"),
        text(first, "digest"),
    ) {
        Err(reason) -> reason.code == "semantic.entity.absent";
        _ -> false
    };
let cleaned = Directory.remove_all(root) == Ok(Unit);
changed and absent and cleaned).

@test
pub invalid_source_cannot_produce_binding_facts(): Bool ->
    let {
        Ok(root) <- Directory.create_temporary("terlan-entity-invalid-");
        Ok(rows) <- capture(root, "module sample.\npub value(): Bool -> 1.\n");
        Ok(count) <- rows.length()
    } else {
        _ -> false
    };
    (let cleaned = Directory.remove_all(root) == Ok(Unit); count == 0 and cleaned).
