{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terlan:semantic:query-result:v1",
  "title": "Terlan semantic query-result v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "terlan.semantic.query-result.v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/snapshot_id"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "minItems": 0
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_used": {
      "type": "integer",
      "minimum": 0
    },
    "result_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "snapshot_id",
    "target",
    "status",
    "facts",
    "limitations",
    "next_cursor",
    "work_used",
    "result_bytes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "maxItems": 0
          },
          "next_cursor": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "facts": {
            "maxItems": 0
          },
          "next_cursor": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^s:[0-9a-f]{64}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^e:[0-9a-f]{64}$"
    },
    "limitation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "binding",
            "function",
            "type",
            "trait",
            "shape",
            "implication",
            "pattern",
            "actor",
            "protocol",
            "message"
          ]
        },
        "expected_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "entity_id",
        "kind",
        "expected_digest"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "origin_entity_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_id"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "value",
        "origin_entity_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "checked_semantic_relation"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/semantic_relation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inferred_binding_type"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/inferred_binding_type"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "checked_call_reference"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/checked_call_reference"
              }
            }
          }
        }
      ]
    },
    "requirement_bound": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "trait"
            },
            "trait_name": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": [
            "kind",
            "trait_name",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "structural_implication"
            },
            "subject": {
              "type": "object"
            },
            "required_shape": {
              "type": "object",
              "properties": {
                "Map": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object"
                          }
                        ]
                      },
                      "required": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "key",
                      "value",
                      "required"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "Map"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "subject",
            "required_shape"
          ],
          "additionalProperties": false
        }
      ]
    },
    "declaration_requirements": {
      "type": "object",
      "properties": {
        "model": {
          "const": "checked-declaration-requirements.v1"
        },
        "kind": {
          "enum": [
            "function",
            "type"
          ]
        },
        "module": {
