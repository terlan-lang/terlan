    "semantic_relation": {
      "type": "object",
      "properties": {
        "relation_kind": {
          "enum": [
            "trait_definition",
            "shape_definition",
            "declaration_requirements",
            "trait_conformance",
            "shape_expansion"
          ]
        },
        "scope": {
          "enum": [
            "selected_declaration",
            "containing_module",
            "selected_pattern"
          ]
        },
        "evidence": {
          "type": "object"
        },
        "resolver_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "satisfaction_at_call_site": {
          "const": "requires_verification"
        },
        "candidate_set_exhaustive": {
          "const": false
        },
        "bound_origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bound_origin"
          }
        }
      },
      "required": [
        "relation_kind",
        "scope",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "relation_kind": {
                "const": "trait_conformance"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "containing_module"
              },
              "evidence": {
                "$ref": "#/$defs/trait_conformance"
              }
            }
          },
          "else": {
            "required": [
              "resolver_bindings",
              "satisfaction_at_call_site",
              "candidate_set_exhaustive"
            ],
            "if": {
              "properties": {
                "relation_kind": {
                  "const": "shape_expansion"
                }
              }
            },
            "then": {
              "properties": {
                "scope": {
                  "const": "selected_pattern"
                },
                "evidence": {
                  "$ref": "#/$defs/shape_expansion_origin"
                }
              }
            },
            "else": {
              "properties": {
                "scope": {
                  "const": "selected_declaration"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation_kind": {
                "const": "shape_definition"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/shape_definition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation_kind": {
                "const": "declaration_requirements"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/declaration_requirements"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation_kind": {
                "const": "trait_definition"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "trait"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "methods": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "super_traits": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "constants": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "is_public": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "methods",
                  "params",
                  "super_traits",
                  "constants",
                  "is_public"
                ]
              }
            }
          }
        }
      ]
