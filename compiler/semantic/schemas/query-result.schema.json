          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arity": {
          "type": "integer",
          "minimum": 0
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        },
        "type_variables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "declaration": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "declaration"
            ],
            "additionalProperties": false
          }
        },
        "parameter_types": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "return_type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_bound"
          }
        }
      },
      "required": [
        "model",
        "kind",
        "module",
        "name",
        "arity",
        "span_start",
        "span_end",
        "type_variables",
        "parameter_types",
        "return_type",
        "bounds"
      ],
      "additionalProperties": false
    },
    "trait_conformance": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "trait_ref": {
          "type": "string",
          "minLength": 1
        },
        "for_type": {
          "type": "string",
          "minLength": 1
        },
        "generic_params": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_negative": {
          "type": "boolean"
        },
        "public": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "implements",
            "explicit_impl"
          ]
        }
      },
      "required": [
        "module",
        "trait_ref",
        "for_type",
        "generic_params",
        "is_negative",
        "public",
