{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terlan:semantic:snapshot:v1",
  "title": "Terlan semantic snapshot v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "terlan.semantic.snapshot.v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/snapshot_id"
    },
    "source_closure_digest": {
      "$ref": "#/$defs/digest"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "interface_digest": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "module",
          "interface_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "compiler": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "binary_digest": {
          "$ref": "#/$defs/digest"
        },
        "ancestry_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "version",
        "binary_digest",
        "ancestry_digest"
      ],
      "additionalProperties": false
    },
    "syntax_digest": {
      "$ref": "#/$defs/digest"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "invalid"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limitation"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "snapshot_id",
    "source_closure_digest",
    "sources",
    "dependencies",
    "compiler",
    "syntax_digest",
    "target",
    "flags",
    "policy_digest",
    "analysis"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "analysis": {
            "properties": {
              "limitations": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "analysis": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^s:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "document_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "digest",
        "document_version"
      ],
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
