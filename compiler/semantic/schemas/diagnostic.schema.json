{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terlan:semantic:diagnostic:v1",
  "title": "Terlan semantic diagnostic v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "terlan.semantic.diagnostic.v1"
    },
    "code": {
      "type": "string",
      "pattern": "^semantic\\.[a-z][a-z0-9_.]*$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "entity_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/entity_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      },
      "minItems": 0
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "$ref": "#/$defs/observation"
    },
    "actual": {
      "$ref": "#/$defs/observation"
    },
    "dependency_chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "minItems": 0
    },
    "repair_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "rename_symbol",
              "add_function",
              "replace_body",
              "implement_trait",
              "resolve_exhaustiveness",
              "add_actor_message",
              "edit_actor_transition"
            ]
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "arguments": {
            "type": "object"
          },
          "preconditions": {
            "$ref": "#/$defs/preconditions"
          },
          "applicability": {
            "type": "string",
            "enum": [
              "automatic",
              "requires_choice"
            ]
          },
          "obligations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/obligation"
            },
            "minItems": 0
          }
        },
        "required": [
          "operation",
          "target",
          "arguments",
          "preconditions",
          "applicability",
          "obligations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "no_repair_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "code",
    "severity",
    "entity_id",
    "ranges",
    "invariant",
    "expected",
    "actual",
    "dependency_chain",
    "limitations",
    "repair_candidates",
    "no_repair_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "repair_candidates": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "no_repair_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "no_repair_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^e:[0-9a-f]{64}$"
    },
    "limitation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "binding",
            "function",
            "type",
            "trait",
            "shape",
            "implication",
            "pattern",
            "actor",
            "protocol",
            "message"
          ]
        },
        "expected_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "entity_id",
        "kind",
        "expected_digest"
      ],
      "additionalProperties": false
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "source_closure_digest": {
          "$ref": "#/$defs/digest"
        },
        "entity_digest": {
          "$ref": "#/$defs/digest"
        },
        "dependency_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "source_closure_digest",
        "entity_digest",
        "dependency_digest",
        "policy_digest"
      ],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "start_byte",
        "end_byte"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/entity_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "entity_id",
        "description"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "unavailable_reason"
      ],
      "additionalProperties": false
    }
  }
}
