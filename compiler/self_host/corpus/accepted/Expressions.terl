module self_host_corpus.Expressions.

pub struct Person {
    name: String,
    age: Int,
}.

pub arithmetic() -> 1 + 2 * 3.

pub tuple_value() -> {1, 2, 3}.

pub list_value() -> [1, 2, 3].

pub cons_value(tail) -> [1 | tail].

pub fixed_array_value() -> #[1, 2, 3].

pub keyed_value() -> {name: "Ada", age: 42}.

pub nominal_value() -> Person{name: "Ada", age: 42}.

pub atom_value() -> Atom["ready"].

pub named_call() -> render(name = "Ada", age = 42).

pub method_call(value) -> value.render("compact").

pub dynamic_call(function) -> function(42).

pub record_access(person) -> person#Person.name.

pub record_update(person) -> person#Person{name = "Grace"}.

pub constructor_chain() -> prepare() with finish().

pub quoted(value) -> quote render(unquote(value)).

pub lambda_value() -> (value) -> value.

pub comprehension(values) -> [value * 2 | value <- values, value > 0].

pub conditional(value) -> if {
    value > 0 -> value;
    true -> 0
}.

pub case_value(value) -> case value {
    0 -> "zero";
    _ -> "other"
}.

pub try_value(value) -> try value {
    result -> result
    catch reason -> reason
    after 0 -> Unit
}.

pub let_value(value) ->
    let doubled = value * 2;
    doubled.

pub refutable(value) ->
    let Some(inner) <- value else {
        None -> 0
    };
    inner.

pub html_value() -> html {<article data-kind="example">Terlan</article>}.

pub raw_macro_value() -> sql{select * from examples where active = true}.
