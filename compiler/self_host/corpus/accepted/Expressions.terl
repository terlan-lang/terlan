module self_host_corpus.Expressions.

pub struct Person {
    name: String,
    age: Int,
}.

pub arithmetic(): Dynamic ->
    1 + 2 * 3.

pub tuple_value(): Dynamic -> {1, 2, 3}.

pub list_value(): Dynamic -> [1, 2, 3].

pub cons_value(tail: Dynamic): Dynamic ->
    [1 | tail].

pub array_value(): Dynamic -> #[1, 2, 3].

pub keyed_value(): Dynamic ->
    {name: "Ada", age: 42}.

pub nominal_value(): Dynamic ->
    Person {name: "Ada", age: 42}.

pub atom_value(): Dynamic -> Atom["ready"].

pub named_call(): Dynamic ->
    render(name = "Ada", age = 42).

pub method_call(value: Dynamic): Dynamic ->
    value.render("compact").

pub dynamic_call(function: Dynamic): Dynamic ->
    function(42).

pub record_access(person: Dynamic): Dynamic ->
    person#Person.name.

pub record_update(person: Dynamic): Dynamic ->
    person#Person{name: "Grace"}.

pub constructor_chain(): Dynamic ->
    prepare() with finish().

pub quoted(value: Dynamic): Dynamic ->
    quote render(unquote(value)).

pub lambda_value(): Dynamic ->
    (value) -> value.

pub comprehension(values: Dynamic): Dynamic ->
    [value * 2 | value <- values, value > 0].

pub conditional(value: Dynamic): Dynamic ->
    if {
        value > 0 -> value;
        true -> 0
    }.

pub case_value(value: Dynamic): Dynamic ->
    case value {
        0 -> "zero";
        _ -> "other"
    }.

pub try_value(value: Dynamic): Dynamic ->
    try value {
        result -> result
        catch reason -> reason
        after 0 -> Unit
    }.

pub let_value(value: Dynamic): Dynamic ->
    let doubled = value * 2;
    doubled.

pub refutable(value: Dynamic): Dynamic ->
    when {
        Some(inner) <- value
    } else {
        None -> 0
    };
    inner.

pub html_value(): Dynamic ->
    html {
        <article data-kind="example">
            Terlan
        </article>
    }.

pub raw_macro_value(): Dynamic ->
    sql {select * from examples where active = true}.
