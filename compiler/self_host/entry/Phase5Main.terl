/** Minimal executable root for Phase 5 Core IR and optimizer authority. */
module self_host.Main.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{String, Unit}.
import std.io.Console.eprintln.
import std.io.Directory.
import std.system.Arguments.
import self_host.ProjectedInterfaceCatalog.
import self_host.SelfHostCoreOptimizeEvidenceTool.
import self_host.SelfHostCoreOptimizeRuntimeTool.
import self_host.SelfHostPath.


report_false(message: String): Bool ->
    let _reported = eprintln(message);
    false.

report_unit(message: String): Unit ->
    let _reported = eprintln(message);
    Unit.

ensure_directory(path: String): Bool ->
    if {
        path == "" -> true;
        true -> case Directory.create_all(path) {
            Ok(_unit) -> true;
            Err(reason) -> report_false(reason.message)
        }
    }.

backend_usage(): Unit ->
    report_unit(
        "usage: terlan-self-host backend-unit <source.terl> <interfaces.manifest> <core-ir.json> <diagnostics>",
    ).

main_backend_unit(): Unit ->
    let Some(source) <- Arguments.get(1) else { None -> backend_usage() };
    let Some(interfaces) <- Arguments.get(2) else { None -> backend_usage() };
    let Some(output) <- Arguments.get(3) else { None -> backend_usage() };
    let Some(diagnostics) <- Arguments.get(4) else { None -> backend_usage() };
    let _completed = ensure_directory(SelfHostPath.parent(output))
        and ensure_directory(SelfHostPath.parent(diagnostics))
        and ProjectedInterfaceCatalog.write_backend(source, interfaces, output, diagnostics);
    Unit.

optimizer_usage(): Unit ->
    report_unit(
        "usage: terlan-self-host optimizer-evidence <artifact-root> <evidence.tsv> <marker>",
    ).

main_optimizer_evidence(): Unit ->
    let Some(root) <- Arguments.get(1) else { None -> optimizer_usage() };
    let Some(output) <- Arguments.get(2) else { None -> optimizer_usage() };
    let Some(marker) <- Arguments.get(3) else { None -> optimizer_usage() };
    let _completed = ensure_directory(SelfHostPath.parent(output))
        and ensure_directory(SelfHostPath.parent(marker))
        and SelfHostCoreOptimizeEvidenceTool.write(root, output, marker);
    Unit.

optimizer_artifacts_usage(): Unit ->
    report_unit(
        "usage: terlan-self-host optimizer-artifacts <source.terl> <interfaces.manifest> <artifact-root>",
    ).

main_optimizer_artifacts(): Unit ->
    let Some(source) <- Arguments.get(1) else { None -> optimizer_artifacts_usage() };
    let Some(interfaces) <- Arguments.get(2) else { None -> optimizer_artifacts_usage() };
    let Some(output) <- Arguments.get(3) else { None -> optimizer_artifacts_usage() };
    let _completed = ProjectedInterfaceCatalog.write_optimizer_artifacts(source, interfaces, output);
    Unit.

main_optimizer_runtime(): Unit ->
    let Some(root) <- Arguments.get(1) else { None -> optimizer_artifacts_usage() };
    let Some(publisher) <- Arguments.get(2) else { None -> optimizer_artifacts_usage() };
    let Some(vm) <- Arguments.get(3) else { None -> optimizer_artifacts_usage() };
    let Some(entry) <- Arguments.get(4) else { None -> optimizer_artifacts_usage() };
    let _completed = SelfHostCoreOptimizeRuntimeTool.write(root, publisher, vm, entry);
    Unit.

main_optimizer_cross_target(): Unit ->
    let Some(source) <- Arguments.get(1) else { None -> optimizer_artifacts_usage() };
    let Some(interfaces) <- Arguments.get(2) else { None -> optimizer_artifacts_usage() };
    let Some(target_a) <- Arguments.get(3) else { None -> optimizer_artifacts_usage() };
    let Some(target_b) <- Arguments.get(4) else { None -> optimizer_artifacts_usage() };
    let Some(output) <- Arguments.get(5) else { None -> optimizer_artifacts_usage() };
    let _completed = ProjectedInterfaceCatalog.write_optimizer_cross_target(
        source,
        interfaces,
        target_a,
        target_b,
        output,
    );
    Unit.

pub main(): Unit ->
    case Arguments.get(0) {
        Some("backend-unit") -> main_backend_unit();
        Some("optimizer-artifacts") -> main_optimizer_artifacts();
        Some("optimizer-runtime") -> main_optimizer_runtime();
        Some("optimizer-cross-target") -> main_optimizer_cross_target();
        Some("optimizer-evidence") -> main_optimizer_evidence();
        _ -> report_unit(
            "usage: terlan-self-host backend-unit ... | optimizer-artifacts ... | optimizer-evidence ...",
        )
    }.
