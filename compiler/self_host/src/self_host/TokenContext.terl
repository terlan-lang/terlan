/** Contextual terminal projection over canonical lexer tokens. */
module self_host.TokenContext.


import std.core.Option.{None, Option, Some}.
import self_host.CanonicalToken.{CanonicalToken, CommentToken, ContextualKeywordToken, DocCommentToken, LowerIdentifierToken, ModuleDocCommentToken, StringToken, TokenCategory, UpperIdentifierToken}.

import std.collections.List.
import std.core.{Int, String}.

@pure
some_token(value: CanonicalToken): Option[CanonicalToken] -> Some(value).

@pure
none_token(): Option[CanonicalToken] -> None.

@pure
is_trivia(category: TokenCategory): Bool ->
    category == CommentToken or category == DocCommentToken or category == ModuleDocCommentToken.

@pure
is_name(category: TokenCategory): Bool ->
    category == LowerIdentifierToken
        or category == UpperIdentifierToken
        or category == ContextualKeywordToken.

@pure
next_significant(tokens: List[CanonicalToken]): Option[CanonicalToken] ->
    case tokens {
        [] -> none_token();
        [token | rest] -> if { is_trivia(token.category) -> next_significant(rest); true -> some_token(token) }
    }.

@pure
with_terminal(token: CanonicalToken, terminal: String): CanonicalToken ->
    CanonicalToken(token.category, terminal, token.text, token.start_byte, token.end_byte).

@pure
previous_is(previous: Option[CanonicalToken], terminal: String): Bool ->
    case previous { Some(token) -> token.terminal == terminal; None -> false }.

@pure
next_is(next: Option[CanonicalToken], terminal: String): Bool ->
    case next { Some(token) -> token.terminal == terminal; None -> false }.

@pure
next_is_category(next: Option[CanonicalToken], category: TokenCategory): Bool ->
    case next { Some(token) -> token.category == category; None -> false }.

@pure
tight_name_after(token: CanonicalToken, next: Option[CanonicalToken]): Bool ->
    case next {
        Some(value) -> token.end_byte == value.start_byte and (is_name(value.category) or value.terminal == "#");
        None -> false
    }.

@pure
nominal_keyed_open(token: CanonicalToken, previous: Option[CanonicalToken]): Bool ->
    case previous {
        Some(value) -> token.terminal == "{" and value.end_byte == token.start_byte and is_name(value.category);
        None -> false
    }.

@pure
balanced_followed_by(
    tokens: List[CanonicalToken],
    opening: String,
    closing: String,
    depth: Int,
    expected: String,
): Bool ->
    case tokens {
        [] -> false;
        [token | rest] -> if {
            is_trivia(token.category) -> balanced_followed_by(rest, opening, closing, depth, expected);
            token.terminal == opening -> balanced_followed_by(rest, opening, closing, depth + 1, expected);
            token.terminal == closing and depth == 1 -> next_is(next_significant(rest), expected);
            token.terminal == closing -> balanced_followed_by(rest, opening, closing, depth - 1, expected);
            true -> balanced_followed_by(rest, opening, closing, depth, expected)
        }
    }.

@pure
previous_is_tight_name(previous: Option[CanonicalToken], token: CanonicalToken): Bool ->
    case previous {
        Some(value) -> is_name(value.category) and value.end_byte == token.start_byte;
        None -> false
    }.

@pure
remote_call_tail(tokens: List[CanonicalToken], phase: Int): Bool ->
    case tokens {
        [] -> false;
        [token | rest] -> if {
            is_trivia(token.category) -> remote_call_tail(rest, phase);
            phase == 0 and is_name(token.category) -> remote_call_tail(rest, 1);
            phase == 1 and (token.terminal == "(" or token.terminal == "[") -> true;
            true -> false
        }
    }.

@pure
token_before(token: CanonicalToken, next: Option[CanonicalToken], terminal: String): Bool ->
    token.terminal == "." and next_is(next, terminal).

@pure
tight_dot(token: CanonicalToken, next: Option[CanonicalToken]): Bool ->
    token.terminal == "." and tight_name_after(token, next).

@pure
closing_semicolon(token: CanonicalToken, next: Option[CanonicalToken]): Bool ->
    token.terminal == ";" and next_is(next, "}").

@pure
asset_keyword(token: CanonicalToken, next: Option[CanonicalToken], keyword: String): Bool ->
    token.text == keyword and next_is_category(next, StringToken).

@pure
negative_impl(token: CanonicalToken, previous: Option[CanonicalToken]): Bool ->
    token.text == "not" and previous_is(previous, "impl").

@pure
remote_call_colon(token: CanonicalToken, previous: Option[CanonicalToken], rest: List[CanonicalToken]): Bool ->
    token.terminal == ":" and previous_is_tight_name(previous, token) and remote_call_tail(rest, 0).

@pure
function_clause_open(token: CanonicalToken, previous: Option[CanonicalToken], rest: List[CanonicalToken]): Bool ->
    token.terminal == "(" and balanced_followed_by(rest, "(", ")", 1, "->") and previous_is_tight_name(previous, token).

@pure
lambda_open(token: CanonicalToken, rest: List[CanonicalToken]): Bool ->
    token.terminal == "(" and balanced_followed_by(rest, "(", ")", 1, "->").

@pure
tight_bracket_followed_by(token: CanonicalToken, previous: Option[CanonicalToken], rest: List[CanonicalToken], expected: String): Bool ->
    token.terminal == "[" and previous_is_tight_name(previous, token) and balanced_followed_by(rest, "[", "]", 1, expected).

@pure
contextualize_one(
    token: CanonicalToken,
    previous: Option[CanonicalToken],
    next: Option[CanonicalToken],
    rest: List[CanonicalToken],
): CanonicalToken ->
    if {
        token.category == StringToken and token.text.utf8_byte_at(0) == 39 ->
            with_terminal(token, "raw-quoted-text");
        token.text == "_" -> with_terminal(token, "placeholder");
        token_before(token, next, "{") -> with_terminal(token, "selector-dot");
        tight_dot(token, next) -> with_terminal(token, "tight-dot");
        closing_semicolon(token, next) -> with_terminal(token, "closing-semicolon");
        asset_keyword(token, next, "file") -> with_terminal(token, "asset-file");
        asset_keyword(token, next, "css") -> with_terminal(token, "asset-css");
        asset_keyword(token, next, "markdown") -> with_terminal(token, "asset-markdown");
        negative_impl(token, previous) -> with_terminal(token, "negative-impl-not");
        remote_call_colon(token, previous, rest) -> with_terminal(token, "remote-call-colon");
        function_clause_open(token, previous, rest) -> with_terminal(token, "function-clause-(");
        lambda_open(token, rest) -> with_terminal(token, "lambda-(");
        tight_bracket_followed_by(token, previous, rest, "{") -> with_terminal(token, "binary-layout-[");
        tight_bracket_followed_by(token, previous, rest, "(") -> with_terminal(token, "generic-call-[");
        nominal_keyed_open(token, previous) -> with_terminal(token, "nominal-keyed-{");
        true -> token
    }.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
project_at(
    tokens: List[CanonicalToken],
    previous: Option[CanonicalToken],
    output: List[CanonicalToken],
): List[CanonicalToken] ->
    case tokens {
        [] -> reverse_at(output, List.new[CanonicalToken]());
        [token | rest] ->
            let rewritten = contextualize_one(token, previous, next_significant(rest), rest);
            let next_previous = if { is_trivia(token.category) -> previous; true -> some_token(token) };
            project_at(rest, next_previous, [rewritten | output])
    }.

/** Projects context-sensitive grammar terminals without changing token spans. */
@pure
pub project(tokens: List[CanonicalToken]): List[CanonicalToken] ->
    project_at(tokens, none_token(), List.new[CanonicalToken]()).
