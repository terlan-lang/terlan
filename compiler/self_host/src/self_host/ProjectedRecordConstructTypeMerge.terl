/** Resolves raw nominal record construction against local struct declarations. */
module self_host.ProjectedRecordConstructTypeMerge.

import self_host.ModuleInterfaceSyntax.ModuleInterface.
import self_host.ProjectedBodySyntax.ProjectedBody.
import self_host.ProjectedExpressionSupportIrPlan.node_size.
import self_host.ProjectedExpressionSyntax.ProjectedExpressionNode.
import self_host.ProjectedFrontendSyntax.ProjectedFrontendModule.
import self_host.ProjectedLocalSemanticSyntax.LocalSemanticResult.
import self_host.ProjectedRecordAccessTypeMerge.
import self_host.ProjectedRecordAccessTypeMerge.{RecordFieldType, RecordLayoutType}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintDiagnostic, TypeConstraintResolution}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.String.

struct ConstructField {
    value_node_id: Int,
    byte_offset: Int,
    value_offset: Int,
    name: String,
}.

constructor ConstructField {
    (value_node_id: Int, byte_offset: Int, value_offset: Int, name: String): ConstructField ->
        ConstructField {
            value_node_id: value_node_id,
            byte_offset: byte_offset,
            value_offset: value_offset,
            name: name,
        }
}.

struct ConstructSite {
    node_id: Int,
    byte_offset: Int,
    type_name: String,
    fields: List[ConstructField],
}.

constructor ConstructSite {
    (node_id: Int, byte_offset: Int, type_name: String, fields: List[ConstructField]): ConstructSite ->
        ConstructSite {
            node_id: node_id,
            byte_offset: byte_offset,
            type_name: type_name,
            fields: fields,
        }
}.

struct ConstructScan {
    next_id: Int,
    sites: List[ConstructSite],
}.

constructor ConstructScan {
    (next_id: Int, sites: List[ConstructSite]): ConstructScan ->
        ConstructScan { next_id: next_id, sites: sites }
}.

append[T](left: List[T], right: List[T]): List[T] ->
    case left { [] -> right; [value | rest] -> [value | append(rest, right)] }.

construct_fields(
    values: List[ProjectedExpressionNode],
    field_id: Int,
): List[ConstructField] ->
    case values {
        [] -> [];
        [field | rest] -> case field.children {
            [value] -> [ConstructField(
                field_id + 1,
                field.start_byte,
                value.start_byte,
                field.text,
            ) | construct_fields(rest, field_id + node_size(field))];
            _ -> construct_fields(rest, field_id + node_size(field))
        }
    }.

construct_site(value: ProjectedExpressionNode, node_id: Int): Option[ConstructSite] ->
    case value.children {
        [type_marker | fields] -> Some(ConstructSite(
            node_id,
            value.start_byte,
            value.text,
            construct_fields(fields, node_id + 1 + node_size(type_marker)),
        ));
        _ -> None
    }.

scan_children(values: List[ProjectedExpressionNode], next_id: Int): ConstructScan ->
    case values {
        [] -> ConstructScan(next_id, []);
        [value | rest] ->
            let current = scan_node(value, next_id);
            let remaining = scan_children(rest, current.next_id);
            ConstructScan(
                remaining.next_id,
                append(current.sites, remaining.sites),
            )
    }.

scan_node(value: ProjectedExpressionNode, node_id: Int): ConstructScan ->
    let nested = scan_children(value.children, node_id + 1);
    if {
        value.kind == "nominal-keyed" -> case construct_site(value, node_id) {
            None -> nested;
            Some(site) -> ConstructScan(nested.next_id, [site | nested.sites])
        };
        true -> nested
    }.

body_sites(values: List[ProjectedBody]): List[ConstructSite] ->
    case values {
        [] -> [];
        [value | rest] -> case value.expression.node {
            None -> body_sites(rest);
            Some(node) -> append(scan_node(node, 0).sites, body_sites(rest))
        }
    }.

layout_at(name: String, values: List[RecordLayoutType]): Option[RecordLayoutType] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.name == name or value.qualified_name == name -> Some(value);
            true -> layout_at(name, rest)
        }
    }.

private_name(name: String): Bool -> String.starts_with(name, "#").

canonical_name(name: String): String ->
    if {
        private_name(name) -> String.utf8_slice(name, 1, String.byte_size(name) - 1);
        true -> name
    }.

field_at(name: String, values: List[RecordFieldType]): Option[RecordFieldType] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.name == canonical_name(name) -> Some(value);
            true -> field_at(name, rest)
        }
    }.

construct_field_at(name: String, values: List[ConstructField]): Option[ConstructField] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            canonical_name(value.name) == name -> Some(value);
            true -> construct_field_at(name, rest)
        }
    }.

fact_type(
    node_id: Int,
    byte_offset: Int,
    values: List[InferredTypeFact],
): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.node_id == node_id and value.byte_offset == byte_offset -> value.type_name;
            true -> fact_type(node_id, byte_offset, rest)
        }
    }.

type_matches(expected: String, actual: String): Bool ->
    expected == actual
        or String.starts_with(expected, String.append(actual, "["))
        or String.starts_with(actual, String.append(expected, "[")).

contains_name(name: String, values: List[String]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> canonical_name(value) == canonical_name(name)
            or contains_name(name, rest)
    }.

field_diagnostics(
    values: List[ConstructField],
    layout: RecordLayoutType,
    facts: List[InferredTypeFact],
    names: List[String],
): List[TypeConstraintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] ->
            let remaining = field_diagnostics(rest, layout, facts, [value.name | names]);
            if {
                contains_name(value.name, names) -> [TypeConstraintDiagnostic(
                    "duplicate-record-field",
                    String.concat(["record construction repeats field: ", value.name]),
                    value.byte_offset,
                ) | remaining];
                true -> case field_at(value.name, layout.fields) {
                    None -> [TypeConstraintDiagnostic(
                        "unknown-record-field",
                        String.concat(["record field is not declared: ", value.name]),
                        value.byte_offset,
                    ) | remaining];
                    Some(field) -> if {
                        private_name(value.name) != field.is_private -> [TypeConstraintDiagnostic(
                            "record-field-visibility",
                            if {
                                field.is_private -> "private record field must be written with #";
                                true -> "public record field must not be written with #"
                            },
                            value.byte_offset,
                        ) | remaining];
                        true -> case field.type_name {
                            None -> [TypeConstraintDiagnostic(
                                "unresolved-record-field-type",
                                "record field type is unresolved",
                                value.byte_offset,
                            ) | remaining];
                            Some(expected) -> case fact_type(
                                value.value_node_id,
                                value.value_offset,
                                facts,
                            ) {
                                None -> [TypeConstraintDiagnostic(
                                    "unresolved-record-field-value",
                                    "record field value type is unresolved",
                                    value.value_offset,
                                ) | remaining];
                                Some(actual) -> if {
                                    type_matches(expected, actual) -> remaining;
                                    true -> [TypeConstraintDiagnostic(
                                        "record-field-type-mismatch",
                                        String.concat([
                                            "record field requires ", expected, ", found ", actual,
                                        ]),
                                        value.value_offset,
                                    ) | remaining]
                                }
                            }
                        }
                    }
                }
            }
    }.

missing_diagnostics(
    values: List[RecordFieldType],
    supplied: List[ConstructField],
    byte_offset: Int,
): List[TypeConstraintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> case construct_field_at(value.name, supplied) {
            Some(_) -> missing_diagnostics(rest, supplied, byte_offset);
            None -> [TypeConstraintDiagnostic(
                "missing-record-field",
                String.concat(["record construction is missing field: ", value.name]),
                byte_offset,
            ) | missing_diagnostics(rest, supplied, byte_offset)]
        }
    }.

site_diagnostics(
    values: List[ConstructSite],
    local: List[RecordLayoutType],
    all: List[RecordLayoutType],
    facts: List[InferredTypeFact],
): List[TypeConstraintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] ->
            let remaining = site_diagnostics(rest, local, all, facts);
            case layout_at(value.type_name, local) {
                Some(layout) -> append(
                    field_diagnostics(value.fields, layout, facts, []),
                    append(missing_diagnostics(layout.fields, value.fields, value.byte_offset), remaining),
                );
                None -> [TypeConstraintDiagnostic(
                    if {
                        layout_at(value.type_name, all) == None -> "unknown-record-type";
                        true -> "raw-imported-record-construction"
                    },
                    if {
                        layout_at(value.type_name, all) == None -> "record type is not declared";
                        true -> "imported structs require an exported constructor"
                    },
                    value.byte_offset,
                ) | remaining]
            }
    }.

site_at(node_id: Int, byte_offset: Int, values: List[ConstructSite]): Option[ConstructSite] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.node_id == node_id and value.byte_offset == byte_offset -> Some(value);
            true -> site_at(node_id, byte_offset, rest)
        }
    }.

merge_facts(values: List[InferredTypeFact], sites: List[ConstructSite]): List[InferredTypeFact] ->
    case values {
        [] -> [];
        [value | rest] -> case site_at(value.node_id, value.byte_offset, sites) {
            None -> [value | merge_facts(rest, sites)];
            Some(site) -> [InferredTypeFact(value.node_id, Some(site.type_name), value.byte_offset)
                | merge_facts(rest, sites)]
        }
    }.

field_offset(byte_offset: Int, values: List[ConstructField]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.byte_offset == byte_offset or field_offset(byte_offset, rest)
    }.

owned_offset(byte_offset: Int, values: List[ConstructSite]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.byte_offset == byte_offset
            or field_offset(byte_offset, value.fields)
            or owned_offset(byte_offset, rest)
    }.

without_deferred(
    values: List[TypeConstraintDiagnostic],
    sites: List[ConstructSite],
): List[TypeConstraintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> if {
            value.code == "unknown-type-constraint" and owned_offset(value.byte_offset, sites) ->
                without_deferred(rest, sites);
            true -> [value | without_deferred(rest, sites)]
        }
    }.

merge_sites(
    value: TypeConstraintResolution,
    sites: List[ConstructSite],
    local: List[RecordLayoutType],
    all: List[RecordLayoutType],
): TypeConstraintResolution -> TypeConstraintResolution(
    merge_facts(value.facts, sites),
    append(
        without_deferred(value.diagnostics, sites),
        site_diagnostics(sites, local, all, value.facts),
    ),
).

pub merge_expression(
    value: TypeConstraintResolution,
    expression: ProjectedExpressionNode,
    local: List[RecordLayoutType],
): TypeConstraintResolution -> merge_sites(value, scan_node(expression, 0).sites, local, local).

pub merge(
    frontend: ProjectedFrontendModule,
    imported_interfaces: List[ModuleInterface],
    semantics: LocalSemanticResult,
): LocalSemanticResult -> LocalSemanticResult(
    semantics.bindings,
    semantics.callables,
    merge_sites(
        semantics.types,
        body_sites(frontend.bodies.values),
        ProjectedRecordAccessTypeMerge.local_catalog(frontend),
        ProjectedRecordAccessTypeMerge.catalog(frontend, imported_interfaces),
    ),
).
