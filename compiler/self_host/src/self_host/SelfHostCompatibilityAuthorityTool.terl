/** Complete-closure bootstrap-workaround removal evidence producer. */
module self_host.SelfHostCompatibilityAuthorityTool.

import std.core.String.

import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{Bool, String}.
import std.io.File.

import self_host.SelfHostCompatibilityAuthority.{CompatibilityBoundary, CompatibilitySource}.
import self_host.SelfHostCompatibilityAuthority.


@pure
manifest_paths(lines: List[String]): List[String] ->
    case lines {
        [] -> [];
        [line | rest] -> let path = String.trim(line);
            if {
                path == "" or String.starts_with(path, "#") -> manifest_paths(rest);
                true -> [path | manifest_paths(rest)]
            }
    }.

read_sources(paths: List[String]): Option[List[CompatibilitySource]] ->
    case paths {
        [] -> Some(List.new[CompatibilitySource]());
        [path | rest] -> case File.read_text(path) {
            Err(_) -> None;
            Ok(source) -> case read_sources(rest) {
                None -> None;
                Some(values) -> Some([CompatibilitySource(path, source) | values])
            }
        }
    }.

write_admitted(
    output_path: String,
    sources: List[CompatibilitySource],
    values: List[CompatibilityBoundary],
): Bool ->
    if {
        not SelfHostCompatibilityAuthority.workarounds_removed(sources, values) -> false;
        true -> case File.write_text(
            output_path,
            SelfHostCompatibilityAuthority.render(sources, values),
        ) {
            Err(_) -> false;
            Ok(_) -> true
        }
    }.

/** Publishes evidence only when the complete closure has no bootstrap workaround. */
pub write(
    source_closure_path: String,
    boundary_manifest_path: String,
    output_path: String,
): Bool ->
    let _removed = File.delete(output_path);
    case File.read_text(source_closure_path) {
        Err(_) -> false;
        Ok(source_manifest) -> case File.read_text(boundary_manifest_path) {
            Err(_) -> false;
            Ok(boundary_manifest) -> case SelfHostCompatibilityAuthority.decode(boundary_manifest) {
                None -> false;
                Some(values) -> case read_sources(manifest_paths(String.split(source_manifest, "\n"))) {
                    None -> false;
                    Some(sources) -> write_admitted(output_path, sources, values)
                }
            }
        }
    }.
