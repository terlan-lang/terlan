/** Recursive projected-token parser for canonical pattern families. */
module self_host.ProjectedPatternParser.


import std.core.Option.{None, Option, Some}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode, ProjectedExpressionResult}.
import self_host.ProjectionSyntax.{ProjectedCanonicalToken}.


import std.collections.List.
import std.core.{Int, String}.


struct TokenSplit {
    found: Bool,
    left: List[ProjectedCanonicalToken],
    right: List[ProjectedCanonicalToken],
}.

constructor TokenSplit {
    (found: Bool, left: List[ProjectedCanonicalToken], right: List[ProjectedCanonicalToken]): TokenSplit ->
        TokenSplit {
            found: found,
            left: left,
            right: right,
        }
}.

struct GroupSlice {
    valid: Bool,
    inner: List[ProjectedCanonicalToken],
    close: Option[ProjectedCanonicalToken],
    rest: List[ProjectedCanonicalToken],
}.

constructor GroupSlice {
    (valid: Bool, inner: List[ProjectedCanonicalToken], close: Option[ProjectedCanonicalToken], rest: List[ProjectedCanonicalToken]): GroupSlice ->
        GroupSlice {
            valid: valid,
            inner: inner,
            close: close,
            rest: rest,
        }
}.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
node(
    kind: String,
    text: String,
    start_byte: Int,
    end_byte: Int,
    children: List[ProjectedExpressionNode],
): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, text, start_byte, end_byte, children).

@pure
first_node_start(values: List[ProjectedExpressionNode]): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> 0 }.

@pure
first_token_start(values: List[ProjectedCanonicalToken]): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> 0 }.

@pure
last_token_end(values: List[ProjectedCanonicalToken]): Int ->
    case values {
        [] -> 0;
        [value] -> value.end_byte;
        [_value | rest] -> last_token_end(rest)
    }.

@pure
has_prefix(value: Option[ProjectedCanonicalToken]): Bool ->
    case value { Some(_token) -> true; None -> false }.

@pure
prefix_text(value: Option[ProjectedCanonicalToken], opening: ProjectedCanonicalToken): String ->
    case value { Some(token) -> token.text; None -> opening.text }.

@pure
prefix_start(value: Option[ProjectedCanonicalToken], opening: ProjectedCanonicalToken): Int ->
    case value { Some(token) -> token.start_byte; None -> opening.start_byte }.

@pure
element_children(value: Option[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case value { Some(node_value) -> node_value.children; None -> List.new[ProjectedExpressionNode]() }.

@pure
token_nodes(values: List[ProjectedCanonicalToken]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] -> [node(
            "pattern-token",
            value.text,
            value.start_byte,
            value.end_byte,
            List.new[ProjectedExpressionNode](),
        ) | token_nodes(rest)]
    }.

@pure
split_at(
    values: List[ProjectedCanonicalToken],
    delimiter: String,
    parens: Int,
    brackets: Int,
    braces: Int,
    output: List[ProjectedCanonicalToken],
): TokenSplit ->
    case values {
        [] -> TokenSplit(found = false, left = reverse(output), right = List.new[ProjectedCanonicalToken]());
        [value | rest]
            where value.text == delimiter and parens == 0 and brackets == 0 and braces == 0 ->
            TokenSplit(found = true, left = reverse(output), right = rest);
        [value | rest] -> split_at(
            rest,
            delimiter,
            if { value.text == "(" -> parens + 1; value.text == ")" -> parens - 1; true -> parens },
            if { value.text == "[" -> brackets + 1; value.text == "]" -> brackets - 1; true -> brackets },
            if { value.text == "{" -> braces + 1; value.text == "}" -> braces - 1; true -> braces },
            [value | output],
        )
    }.

@pure
split(values: List[ProjectedCanonicalToken], delimiter: String): TokenSplit ->
    split_at(values, delimiter, 0, 0, 0, List.new[ProjectedCanonicalToken]()).

@pure
group_at(
    values: List[ProjectedCanonicalToken],
    close_text: String,
    depth: Int,
    output: List[ProjectedCanonicalToken],
): GroupSlice ->
    case values {
        [] -> GroupSlice(valid = false, inner = reverse(output), close = None, rest = List.new[ProjectedCanonicalToken]());
        [value | rest] where value.text == close_text and depth == 1 ->
            GroupSlice(valid = true, inner = reverse(output), close = Some(value), rest = rest);
        [value | rest] -> group_at(
            rest,
            close_text,
            if {
                value.text == "(" or value.text == "[" or value.text == "{" -> depth + 1;
                value.text == ")" or value.text == "]" or value.text == "}" -> depth - 1;
                true -> depth
            },
            [value | output],
        )
    }.

@pure
group(opening: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): GroupSlice ->
    group_at(
        values,
        if { opening.text == "(" -> ")"; opening.text == "[" -> "]"; true -> "}" },
        1,
        List.new[ProjectedCanonicalToken](),
    ).

@pure
pattern_sequence(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
): ProjectedExpressionResult ->
    if {
        values == [] -> let ordered = reverse(output);
            let sequence = node("patterns", "", 0, 0, ordered);
            ProjectedExpressionResult(true, Some(sequence), List.new[ProjectedCanonicalToken](), "");
        true ->
            let comma = split(values, ",");
            let current = parse(comma.left);
            case current.node {
                None -> current;
                Some(value) where comma.found -> pattern_sequence(comma.right, [value | output]);
                Some(value) ->
                    let ordered = reverse([value | output]);
                    let sequence = node(
                            "patterns",
                            "",
                            first_node_start(ordered),
                            value.end_byte,
                            ordered,
                        );
                    ProjectedExpressionResult(current.valid, Some(sequence), current.rest, current.message)
            }
    }.

@pure
keyed_pattern_sequence(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
): ProjectedExpressionResult ->
    if {
        values == [] -> let ordered = reverse(output);
            let fields_node = node("keyed-pattern-fields", "", 0, 0, ordered);
            ProjectedExpressionResult(true, Some(fields_node), List.new[ProjectedCanonicalToken](), "");
        true -> let comma = split(values, ",");
            let field = split(comma.left, ":");
            if {
                not field.found -> ProjectedExpressionResult(false, None, comma.right, "keyed pattern field is missing :");
                true -> let parsed = parse(field.right);
                    case {field.left, parsed.node} {
                        {[name | _], Some(value)} -> let field_node = node(
                            "keyed-pattern-field",
                            name.text,
                            name.start_byte,
                            value.end_byte,
                            [value],
                        );
                        if {
                            comma.found -> keyed_pattern_sequence(comma.right, [field_node | output]);
                            true -> let ordered = reverse([field_node | output]);
                                let fields_node = node(
                                        "keyed-pattern-fields",
                                        "",
                                        first_node_start(ordered),
                                        field_node.end_byte,
                                        ordered,
                                    );
                                ProjectedExpressionResult(parsed.valid, Some(fields_node), parsed.rest, parsed.message)
                        };
                        _ -> ProjectedExpressionResult(false, None, comma.right, "keyed pattern field is invalid")
                    }
            }
    }.

@pure
parse_grouped(
    prefix: Option[ProjectedCanonicalToken],
    opening: ProjectedCanonicalToken,
    values: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    let slice = group(opening, values);
    let pipe = split(slice.inner, "|");
    let colon = split(slice.inner, ":");
    let comma = split(slice.inner, ",");
    case slice.close {
        None -> ProjectedExpressionResult(false, None, slice.rest, "pattern group is unterminated");
        Some(close) where opening.text == "[" and pipe.found ->
            let head = parse(pipe.left);
            let tail = parse(pipe.right);
            case {head.node, tail.node} {
                {Some(head_node), Some(tail_node)} ->
                    let cons_node = node("list-cons-pattern", "|", opening.start_byte, close.end_byte, [head_node, tail_node]);
                    ProjectedExpressionResult(head.valid and tail.valid, Some(cons_node), slice.rest, "");
                _ -> ProjectedExpressionResult(false, None, slice.rest, "list cons pattern is invalid")
            };
        Some(_close) where opening.text == "{" and not has_prefix(prefix) and not colon.found and not comma.found ->
            ProjectedExpressionResult(false, None, slice.rest, "keyed pattern field is missing :");
        Some(close) ->
            let elements = if {
                opening.text == "{" and colon.found -> keyed_pattern_sequence(
                    slice.inner,
                    List.new[ProjectedExpressionNode](),
                );
                true -> pattern_sequence(slice.inner, List.new[ProjectedExpressionNode]())
            };
            let prefixed = has_prefix(prefix);
            let kind = if {
                prefixed and opening.text == "{" -> "struct-pattern";
                prefixed -> "constructor-pattern";
                opening.text == "[" -> "list-pattern";
                opening.text == "{" and colon.found -> "keyed-container-pattern";
                true -> "tuple-pattern"
            };
            let children = element_children(elements.node);
            let grouped_node = node(
                    kind,
                    prefix_text(prefix, opening),
                    prefix_start(prefix, opening),
                    close.end_byte,
                    children,
                );
            ProjectedExpressionResult(slice.valid and elements.valid, Some(grouped_node), slice.rest, elements.message)
    }.

/** Parses one complete pattern into the shared projected tree format. */
@pure
pub parse(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case values {
        [] -> ProjectedExpressionResult(false, None, values, "pattern is empty");
        [value] ->
            let kind = if {
                value.terminal == "typed-lambda-pattern" -> "typed-pattern";
                value.text == "_" -> "wildcard-pattern";
                String.contains(value.text, "${") -> "string-capture-pattern";
                value.terminal == "var" or value.terminal == "atom" -> "binding-pattern";
                value.terminal == "upper-ident" -> "constructor-pattern";
                true -> "literal-pattern"
            };
            let value_node = node(
                kind,
                value.text,
                value.start_byte,
                value.end_byte,
                List.new[ProjectedExpressionNode](),
            );
            ProjectedExpressionResult(true, Some(value_node), List.new[ProjectedCanonicalToken](), "");
        [prefix | [opening | rest]] where opening.text == "(" or opening.text == "{" ->
            let parsed = parse_grouped(Some(prefix), opening, rest);
            ProjectedExpressionResult(parsed.valid and parsed.rest == [], parsed.node, parsed.rest, if { parsed.rest == [] -> parsed.message; true -> "constructor pattern contains trailing tokens" });
        [opening | rest] where opening.text == "(" or opening.text == "[" or opening.text == "{" ->
            parse_grouped(None, opening, rest);
        _ ->
            let children = token_nodes(values);
            let pattern_node = node(
                "pattern",
                "",
                first_token_start(values),
                last_token_end(values),
                children,
            );
            ProjectedExpressionResult(true, Some(pattern_node), List.new[ProjectedCanonicalToken](), "")
    }.
