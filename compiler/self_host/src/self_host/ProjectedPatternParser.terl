/** Recursive projected-token parser for canonical pattern families. */
module self_host.ProjectedPatternParser.


import std.core.Option.{None, Option, Some}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode, ProjectedExpressionResult}.
import self_host.ProjectionSyntax.{ProjectedCanonicalToken}.


import std.collections.List.
import std.core.{Int, String}.


struct TokenSplit {
    found: Bool,
    left: List[ProjectedCanonicalToken],
    right: List[ProjectedCanonicalToken],
}.

constructor TokenSplit {
    (found: Bool, left: List[ProjectedCanonicalToken], right: List[ProjectedCanonicalToken]): TokenSplit ->
        TokenSplit {
            found: found,
            left: left,
            right: right,
        }
}.

struct GroupSlice {
    valid: Bool,
    inner: List[ProjectedCanonicalToken],
    close: Option[ProjectedCanonicalToken],
    rest: List[ProjectedCanonicalToken],
}.

constructor GroupSlice {
    (valid: Bool, inner: List[ProjectedCanonicalToken], close: Option[ProjectedCanonicalToken], rest: List[ProjectedCanonicalToken]): GroupSlice ->
        GroupSlice {
            valid: valid,
            inner: inner,
            close: close,
            rest: rest,
        }
}.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
node(
    kind: String,
    text: String,
    start_byte: Int,
    end_byte: Int,
    children: List[ProjectedExpressionNode],
): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, text, start_byte, end_byte, children).

@pure
first_node_start(values: List[ProjectedExpressionNode]): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> 0 }.

@pure
first_token_start(values: List[ProjectedCanonicalToken]): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> 0 }.

@pure
last_token_end(values: List[ProjectedCanonicalToken]): Int ->
    case values {
        [] -> 0;
        [value] -> value.end_byte;
        [_value | rest] -> last_token_end(rest)
    }.

@pure
prefix_text(found: Bool, value: ProjectedCanonicalToken, opening: ProjectedCanonicalToken): String ->
    if { found -> value.text; true -> opening.text }.

@pure
prefix_start(found: Bool, value: ProjectedCanonicalToken, opening: ProjectedCanonicalToken): Int ->
    if { found -> value.start_byte; true -> opening.start_byte }.

@pure
element_children(value: Option[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case value { Some(node_value) -> node_value.children; None -> List.new[ProjectedExpressionNode]() }.

@pure
token_nodes(values: List[ProjectedCanonicalToken]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] -> [node(
            "pattern-token",
            value.text,
            value.start_byte,
            value.end_byte,
            List.new[ProjectedExpressionNode](),
        ) | token_nodes(rest)]
    }.

@pure
close_parens(text: String, current: Int): Int ->
    if { text == ")" -> current - 1; true -> current }.

@pure
next_parens(text: String, current: Int): Int ->
    if { text == "(" -> current + 1; true -> close_parens(text, current) }.

@pure
close_brackets(text: String, current: Int): Int ->
    if { text == "]" -> current - 1; true -> current }.

@pure
next_brackets(text: String, current: Int): Int ->
    if { text == "[" -> current + 1; true -> close_brackets(text, current) }.

@pure
close_braces(text: String, current: Int): Int ->
    if { text == "}" -> current - 1; true -> current }.

@pure
next_braces(text: String, current: Int): Int ->
    if { text == "{" -> current + 1; true -> close_braces(text, current) }.

@pure
split_continue(value: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken], delimiter: String, parens: Int, brackets: Int, braces: Int, output: List[ProjectedCanonicalToken]): TokenSplit ->
    split_at(rest, delimiter, next_parens(value.text, parens), next_brackets(value.text, brackets), next_braces(value.text, braces), [value | output]).

@pure
split_at(
    values: List[ProjectedCanonicalToken],
    delimiter: String,
    parens: Int,
    brackets: Int,
    braces: Int,
    output: List[ProjectedCanonicalToken],
): TokenSplit ->
    case values {
        [] -> TokenSplit(found = false, left = reverse(output), right = List.new[ProjectedCanonicalToken]());
        [value | rest]
            where value.text == delimiter and parens == 0 and brackets == 0 and braces == 0 ->
            TokenSplit(found = true, left = reverse(output), right = rest);
        [value | rest] -> split_continue(value, rest, delimiter, parens, brackets, braces, output)
    }.

@pure
split(values: List[ProjectedCanonicalToken], delimiter: String): TokenSplit ->
    split_at(values, delimiter, 0, 0, 0, List.new[ProjectedCanonicalToken]()).

@pure
close_group_depth(text: String, depth: Int): Int ->
    if { text == ")" or text == "]" or text == "}" -> depth - 1; true -> depth }.

@pure
next_group_depth(text: String, depth: Int): Int ->
    if { text == "(" or text == "[" or text == "{" -> depth + 1; true -> close_group_depth(text, depth) }.

@pure
group_continue(value: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken], close_text: String, depth: Int, output: List[ProjectedCanonicalToken]): GroupSlice ->
    group_at(rest, close_text, next_group_depth(value.text, depth), [value | output]).

@pure
group_at(
    values: List[ProjectedCanonicalToken],
    close_text: String,
    depth: Int,
    output: List[ProjectedCanonicalToken],
): GroupSlice ->
    case values {
        [] -> GroupSlice(valid = false, inner = reverse(output), close = None, rest = List.new[ProjectedCanonicalToken]());
        [value | rest] where value.text == close_text and depth == 1 ->
            GroupSlice(valid = true, inner = reverse(output), close = Some(value), rest = rest);
        [value | rest] -> group_continue(value, rest, close_text, depth, output)
    }.

@pure
non_paren_close(text: String): String ->
    if { text == "[" -> "]"; true -> "}" }.

@pure
group_close(text: String): String ->
    if { text == "(" -> ")"; true -> non_paren_close(text) }.

@pure
group(opening: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): GroupSlice ->
    group_at(
        values,
        group_close(opening.text),
        1,
        List.new[ProjectedCanonicalToken](),
    ).

@pure
finish_pattern_sequence(current: ProjectedExpressionResult, value: ProjectedExpressionNode, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    let ordered = reverse([value | output]);
    let sequence = node("patterns", "", first_node_start(ordered), value.end_byte, ordered);
    ProjectedExpressionResult(current.valid, Some(sequence), current.rest, current.message).

@pure
continue_pattern_sequence(current: ProjectedExpressionResult, value: ProjectedExpressionNode, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    if { comma.found -> pattern_sequence(comma.right, [value | output]); true -> finish_pattern_sequence(current, value, output) }.

@pure
pattern_sequence_node(current: ProjectedExpressionResult, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    case current.node {
        None -> current;
        Some(value) -> continue_pattern_sequence(current, value, comma, output)
    }.

@pure
nonempty_pattern_sequence(values: List[ProjectedCanonicalToken], output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    let comma = split(values, ",");
    let current = parse(comma.left);
    pattern_sequence_node(current, comma, output).

@pure
pattern_sequence(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
): ProjectedExpressionResult ->
    if {
        values == [] -> let ordered = reverse(output);
            let sequence = node("patterns", "", 0, 0, ordered);
            ProjectedExpressionResult(true, Some(sequence), List.new[ProjectedCanonicalToken](), "");
        true -> nonempty_pattern_sequence(values, output)
    }.

@pure
finish_keyed_pattern(parsed: ProjectedExpressionResult, field_node: ProjectedExpressionNode, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    let ordered = reverse([field_node | output]);
    let fields_node = node("keyed-pattern-fields", "", first_node_start(ordered), field_node.end_byte, ordered);
    ProjectedExpressionResult(parsed.valid, Some(fields_node), parsed.rest, parsed.message).

@pure
continue_keyed_pattern(parsed: ProjectedExpressionResult, field_node: ProjectedExpressionNode, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    if { comma.found -> keyed_pattern_sequence(comma.right, [field_node | output]); true -> finish_keyed_pattern(parsed, field_node, output) }.

@pure
keyed_value(name: ProjectedCanonicalToken, parsed: ProjectedExpressionResult, value: ProjectedExpressionNode, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    let field_node = node("keyed-pattern-field", name.text, name.start_byte, value.end_byte, [value]);
    continue_keyed_pattern(parsed, field_node, comma, output).

@pure
keyed_parsed(name: ProjectedCanonicalToken, parsed: ProjectedExpressionResult, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    case parsed.node {
        Some(value) -> keyed_value(name, parsed, value, comma, output);
        None -> ProjectedExpressionResult(false, None, comma.right, "keyed pattern field is invalid")
    }.

@pure
keyed_name(values: List[ProjectedCanonicalToken], parsed: ProjectedExpressionResult, comma: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    case values {
        [name | _] -> keyed_parsed(name, parsed, comma, output);
        [] -> ProjectedExpressionResult(false, None, comma.right, "keyed pattern field is invalid")
    }.

@pure
keyed_field(comma: TokenSplit, field: TokenSplit, output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    if {
        not field.found -> ProjectedExpressionResult(false, None, comma.right, "keyed pattern field is missing :");
        true -> keyed_name(field.left, parse(field.right), comma, output)
    }.

@pure
nonempty_keyed_pattern(values: List[ProjectedCanonicalToken], output: List[ProjectedExpressionNode]): ProjectedExpressionResult ->
    let comma = split(values, ",");
    keyed_field(comma, split(comma.left, ":"), output).

@pure
keyed_pattern_sequence(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
): ProjectedExpressionResult ->
    if {
        values == [] -> let ordered = reverse(output);
            let fields_node = node("keyed-pattern-fields", "", 0, 0, ordered);
            ProjectedExpressionResult(true, Some(fields_node), List.new[ProjectedCanonicalToken](), "");
        true -> nonempty_keyed_pattern(values, output)
    }.

@pure
list_cons_tail(opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, head: ProjectedExpressionResult, head_node: ProjectedExpressionNode, tail: ProjectedExpressionResult): ProjectedExpressionResult ->
    case tail.node {
        Some(tail_node) -> let cons_node = node("list-cons-pattern", "|", opening.start_byte, close.end_byte, [head_node, tail_node]);
            ProjectedExpressionResult(head.valid and tail.valid, Some(cons_node), slice.rest, "");
        None -> ProjectedExpressionResult(false, None, slice.rest, "list cons pattern is invalid")
    }.

@pure
list_cons_head(opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, head: ProjectedExpressionResult, tail: ProjectedExpressionResult): ProjectedExpressionResult ->
    case head.node {
        Some(head_node) -> list_cons_tail(opening, close, slice, head, head_node, tail);
        None -> ProjectedExpressionResult(false, None, slice.rest, "list cons pattern is invalid")
    }.

@pure
list_cons_pattern(opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, pipe: TokenSplit): ProjectedExpressionResult ->
    let head = parse(pipe.left);
    let tail = parse(pipe.right);
    list_cons_head(opening, close, slice, head, tail).

@pure
group_elements(opening: ProjectedCanonicalToken, colon: TokenSplit, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    if { opening.text == "{" and colon.found -> keyed_pattern_sequence(values, List.new[ProjectedExpressionNode]()); true -> pattern_sequence(values, List.new[ProjectedExpressionNode]()) }.

@pure
non_struct_kind(opening: ProjectedCanonicalToken, colon: TokenSplit): String ->
    if { opening.text == "[" -> "list-pattern"; true -> container_kind(opening, colon) }.

@pure
container_kind(opening: ProjectedCanonicalToken, colon: TokenSplit): String ->
    if { opening.text == "{" and colon.found -> "keyed-container-pattern"; true -> "tuple-pattern" }.

@pure
group_kind(prefix_found: Bool, opening: ProjectedCanonicalToken, colon: TokenSplit): String ->
    if { prefix_found and opening.text == "{" -> "struct-pattern"; true -> prefixed_group_kind(prefix_found, opening, colon) }.

@pure
prefixed_group_kind(prefix_found: Bool, opening: ProjectedCanonicalToken, colon: TokenSplit): String ->
    if { prefix_found -> "constructor-pattern"; true -> non_struct_kind(opening, colon) }.

@pure
regular_group(prefix_found: Bool, prefix: ProjectedCanonicalToken, opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, colon: TokenSplit): ProjectedExpressionResult ->
    let elements = group_elements(opening, colon, slice.inner);
    let grouped_node = node(group_kind(prefix_found, opening, colon), prefix_text(prefix_found, prefix, opening), prefix_start(prefix_found, prefix, opening), close.end_byte, element_children(elements.node));
    ProjectedExpressionResult(slice.valid and elements.valid, Some(grouped_node), slice.rest, elements.message).

@pure
non_list_group(prefix_found: Bool, prefix: ProjectedCanonicalToken, opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, colon: TokenSplit, comma: TokenSplit): ProjectedExpressionResult ->
    if {
        opening.text == "{" and not prefix_found and not colon.found and not comma.found -> ProjectedExpressionResult(false, None, slice.rest, "keyed pattern field is missing :");
        true -> regular_group(prefix_found, prefix, opening, close, slice, colon)
    }.

@pure
closed_group(prefix_found: Bool, prefix: ProjectedCanonicalToken, opening: ProjectedCanonicalToken, close: ProjectedCanonicalToken, slice: GroupSlice, pipe: TokenSplit, colon: TokenSplit, comma: TokenSplit): ProjectedExpressionResult ->
    if { opening.text == "[" and pipe.found -> list_cons_pattern(opening, close, slice, pipe); true -> non_list_group(prefix_found, prefix, opening, close, slice, colon, comma) }.

@pure
parse_grouped(
    prefix_found: Bool,
    prefix: ProjectedCanonicalToken,
    opening: ProjectedCanonicalToken,
    values: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    let slice = group(opening, values);
    let pipe = split(slice.inner, "|");
    let colon = split(slice.inner, ":");
    let comma = split(slice.inner, ",");
    case slice.close {
        None -> ProjectedExpressionResult(false, None, slice.rest, "pattern group is unterminated");
        Some(close) -> closed_group(prefix_found, prefix, opening, close, slice, pipe, colon, comma)
    }.

@pure
literal_pattern_kind(value: ProjectedCanonicalToken): String ->
    if { value.terminal == "upper-ident" -> "constructor-pattern"; true -> "literal-pattern" }.

@pure
binding_pattern_kind(value: ProjectedCanonicalToken): String ->
    if { value.terminal == "var" or value.terminal == "atom" -> "binding-pattern"; true -> literal_pattern_kind(value) }.

@pure
capture_pattern_kind(value: ProjectedCanonicalToken): String ->
    if { String.contains(value.text, "${") -> "string-capture-pattern"; true -> binding_pattern_kind(value) }.

@pure
wildcard_pattern_kind(value: ProjectedCanonicalToken): String ->
    if { value.text == "_" -> "wildcard-pattern"; true -> capture_pattern_kind(value) }.

@pure
single_pattern_kind(value: ProjectedCanonicalToken): String ->
    if { value.terminal == "typed-lambda-pattern" -> "typed-pattern"; true -> wildcard_pattern_kind(value) }.

@pure
single_pattern(value: ProjectedCanonicalToken): ProjectedExpressionResult ->
    let value_node = node(single_pattern_kind(value), value.text, value.start_byte, value.end_byte, List.new[ProjectedExpressionNode]());
    ProjectedExpressionResult(true, Some(value_node), List.new[ProjectedCanonicalToken](), "").

@pure
trailing_pattern_message(parsed: ProjectedExpressionResult): String ->
    if { parsed.rest == [] -> parsed.message; true -> "constructor pattern contains trailing tokens" }.

@pure
prefixed_pattern(prefix: ProjectedCanonicalToken, opening: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let parsed = parse_grouped(true, prefix, opening, rest);
    ProjectedExpressionResult(parsed.valid and parsed.rest == [], parsed.node, parsed.rest, trailing_pattern_message(parsed)).

@pure
multi_pattern_rest(values: List[ProjectedCanonicalToken], first: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken], opening: ProjectedCanonicalToken, tail: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    if { opening.text == "(" or opening.text == "{" -> prefixed_pattern(first, opening, tail); true -> opening_pattern(values, first, rest) }.

@pure
multi_pattern(values: List[ProjectedCanonicalToken], first: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case rest {
        [opening | tail] -> multi_pattern_rest(values, first, rest, opening, tail);
        [] -> single_pattern(first)
    }.

@pure
opening_pattern(values: List[ProjectedCanonicalToken], opening: ProjectedCanonicalToken, rest: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    if { opening.text == "(" or opening.text == "[" or opening.text == "{" -> parse_grouped(false, opening, opening, rest); true -> plain_pattern(values) }.

@pure
plain_pattern(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let children = token_nodes(values);
    let pattern_node = node("pattern", "", first_token_start(values), last_token_end(values), children);
    ProjectedExpressionResult(true, Some(pattern_node), List.new[ProjectedCanonicalToken](), "").

/** Parses one complete pattern into the shared projected tree format. */
@pure
pub parse(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case values {
        [] -> ProjectedExpressionResult(false, None, values, "pattern is empty");
        [first | rest] -> multi_pattern(values, first, rest)
    }.
