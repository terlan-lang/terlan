/** Resolves projected signature types with lexical generic scopes. */
module self_host.ProjectedTypeResolution.

import std.core.String.

import self_host.BackendSyntax.{BackendDeclaration}.
import self_host.ProjectedFrontendSyntax.{ProjectedFrontendModule}.
import self_host.ModuleInterfaceSyntax.{ExportedSymbol, ModuleInterface}.
import self_host.ProjectedImportedTypeCatalog.
import self_host.ProjectedSignatureSyntax.{ProjectedCallableSignature, ProjectedParameterTree, ProjectedTypeConstructorArity, ProjectedTypeDeclarationTree}.
import self_host.ProjectedTypeResolutionSyntax.{ProjectedTypeDiagnostic, ProjectedTypeResolution, TypeIdentityBinding}.
import self_host.ProjectedTypeSyntax.{ProjectedTypeNode}.
import self_host.Syntax.{ConstructorDeclaration, OpaqueTypeDeclaration, ShapeDeclaration, StructDeclaration, TraitDeclaration, TypeDeclaration}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Int, String}.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
append_bindings(
    left: List[TypeIdentityBinding],
    right: List[TypeIdentityBinding],
): List[TypeIdentityBinding] ->
    case left { [] -> right; [value | rest] -> [value | append_bindings(rest, right)] }.

@pure
contains(values: List[String], name: String): Bool ->
    case values { [] -> false; [value | rest] -> value == name or contains(rest, name) }.

@pure
is_builtin(name: String): Bool ->
    name == "Int"
        or name == "Float"
        or name == "Bool"
        or name == "String"
        or name == "Binary"
        or name == "Unit"
        or name == "Dynamic"
        or name == "Atom"
        or name == "Never"
        or name == "Any"
        or name == "List"
        or name == "Map"
        or name == "Set"
        or name == "Vector"
        or name == "Option"
        or name == "Result"
        or name == "Html".

@pure
known(name: String, local: List[String], external: List[String], parameters: List[String]): Bool ->
    name == "_"
        or is_builtin(name)
        or contains(parameters, name)
        or contains(local, name)
        or contains(external, name).

@pure
local_constructor_arity(name: String, declarations: List[ProjectedTypeConstructorArity]): Option[Int] ->
    case declarations {
        [] -> None;
        [value | _rest] where value.name == name -> Some(value.arity);
        [_value | rest] -> local_constructor_arity(name, rest)
    }.

@pure
builtin_constructor_arity(name: String): Option[Int] ->
    if {
        name == "List" or name == "Set" or name == "Vector" or name == "Option" or name == "Atom" -> Some(1);
        name == "Map" or name == "Result" -> Some(2);
        is_builtin(name) -> Some(0);
        true -> None
    }.

@pure
constructor_arity(
    name: String,
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
): Option[Int] ->
    if {
        contains(parameters, name) -> Some(0);
        is_builtin(name) -> builtin_constructor_arity(name);
        true -> local_constructor_arity(name, declarations)
    }.

@pure
arity_message(name: String, expected: Int, found: Int): String ->
    String.concat([
        "type constructor `",
        name,
        "` expects ",
        Int.to_string(expected),
        " type argument(s), found ",
        Int.to_string(found),
    ]).

@pure
resolve_constructor_arity(
    value: ProjectedTypeNode,
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    if {
        value.kind != "generic-type" -> output;
        true -> case constructor_arity(value.text, parameters, declarations) {
            Some(expected) -> let found = value.children.length();
                if {
                    expected == found -> output;
                    true -> [ProjectedTypeDiagnostic(value.text, arity_message(value.text, expected, found)) | output]
                };
            None -> output
        }
    }.

@pure
local_types(values: List[BackendDeclaration]): List[String] ->
    case values {
        [] -> List.new[String]();
        [value | rest]
            where value.class == TypeDeclaration
                or value.class == OpaqueTypeDeclaration
                or value.class == StructDeclaration
                or value.class == ShapeDeclaration
                or value.class == TraitDeclaration ->
            [value.symbol_name | local_types(rest)];
        [_value | rest] -> local_types(rest)
    }.

@pure
local_type_bindings(
    module_name: String,
    values: List[String],
): List[TypeIdentityBinding] ->
    case values {
        [] -> List.new[TypeIdentityBinding]();
        [value | rest] -> [
            TypeIdentityBinding(value, String.concat([module_name, ".", value]))
            | [TypeIdentityBinding(
                String.concat([module_name, ".", value]),
                String.concat([module_name, ".", value]),
            ) | local_type_bindings(module_name, rest)]
        ]
    }.

@pure
identity_bindings(values: List[String]): List[TypeIdentityBinding] ->
    case values {
        [] -> List.new[TypeIdentityBinding]();
        [value | rest] -> [TypeIdentityBinding(value, value) | identity_bindings(rest)]
    }.

@pure
binding_conflict(
    value: TypeIdentityBinding,
    values: List[TypeIdentityBinding],
): Bool ->
    case values {
        [] -> false;
        [candidate | rest] -> if {
            candidate.visible_name == value.visible_name
                and candidate.canonical_name != value.canonical_name -> true;
            true -> binding_conflict(value, rest)
        }
    }.

@pure
binding_diagnostics_at(
    values: List[TypeIdentityBinding],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] -> if {
            binding_conflict(value, rest) -> binding_diagnostics_at(
                rest,
                [ProjectedTypeDiagnostic(
                    value.visible_name,
                    String.append("ambiguous imported type: ", value.visible_name),
                ) | output],
            );
            true -> binding_diagnostics_at(rest, output)
        }
    }.

@pure
canonical_name_at(values: List[TypeIdentityBinding], name: String): Option[String] ->
    case values {
        [] -> None;
        [value | _rest] where value.visible_name == name -> Some(value.canonical_name);
        [_value | rest] -> canonical_name_at(rest, name)
    }.

/** Resolves one admitted source spelling to its package-qualified identity. */
@pure
pub canonical_name(value: ProjectedTypeResolution, name: String): Option[String] ->
    canonical_name_at(value.bindings, name).

@pure
is_type_constructor_class(value: self_host.Syntax.DeclarationClass): Bool ->
    value == TypeDeclaration
        or value == OpaqueTypeDeclaration
        or value == StructDeclaration
        or value == ShapeDeclaration
        or value == TraitDeclaration
        or value == ConstructorDeclaration.

@pure
external_symbol_arities(
    module_name: String,
    values: List[ExportedSymbol],
    visible: List[String],
): List[ProjectedTypeConstructorArity] ->
    case values {
        [] -> List.new[ProjectedTypeConstructorArity]();
        [value | rest] -> if {
            is_type_constructor_class(value.class)
                and (contains(visible, value.name)
                    or contains(visible, String.concat([module_name, ".", value.name]))) -> [
                ProjectedTypeConstructorArity(value.name, value.type_parameters.length())
                | [
                    ProjectedTypeConstructorArity(
                        String.concat([module_name, ".", value.name]),
                        value.type_parameters.length(),
                    )
                    | external_symbol_arities(module_name, rest, visible)
                ]
            ];
            true -> external_symbol_arities(module_name, rest, visible)
        }
    }.

@pure
append_arities(
    left: List[ProjectedTypeConstructorArity],
    right: List[ProjectedTypeConstructorArity],
): List[ProjectedTypeConstructorArity] ->
    case left { [] -> right; [value | rest] -> [value | append_arities(rest, right)] }.

@pure
external_constructor_arities(values: List[ModuleInterface], visible: List[String]): List[ProjectedTypeConstructorArity] ->
    case values {
        [] -> List.new[ProjectedTypeConstructorArity]();
        [value | rest] -> append_arities(
            external_symbol_arities(value.module_name, value.symbols, visible),
            external_constructor_arities(rest, visible),
        )
    }.

@pure
duplicate_parameter_diagnostics(
    values: List[String],
    seen: List[String],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] -> if {
            value == "" -> duplicate_parameter_diagnostics(
                rest,
                seen,
                [ProjectedTypeDiagnostic(value, "generic parameter name is empty") | output],
            );
            contains(seen, value) -> duplicate_parameter_diagnostics(
                rest,
                seen,
                [ProjectedTypeDiagnostic(value, String.append("duplicate generic parameter: ", value)) | output],
            );
            true -> duplicate_parameter_diagnostics(rest, [value | seen], output)
        }
    }.

@pure
resolve_node(
    value: ProjectedTypeNode,
    local: List[String],
    external: List[String],
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    let requires_name = value.kind == "named-type" or value.kind == "generic-type";
    let named = if {
        requires_name and not known(value.text, local, external, parameters) ->
            [ProjectedTypeDiagnostic(value.text, String.append("unknown type: ", value.text)) | output];
        true -> output
    };
    resolve_nodes(
        value.children,
        local,
        external,
        parameters,
        declarations,
        resolve_constructor_arity(value, parameters, declarations, named),
    ).

@pure
resolve_nodes(
    values: List[ProjectedTypeNode],
    local: List[String],
    external: List[String],
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] -> resolve_nodes(
            rest,
            local,
            external,
            parameters,
            declarations,
            resolve_node(value, local, external, parameters, declarations, output),
        )
    }.

@pure
resolve_optional(
    value: Option[ProjectedTypeNode],
    local: List[String],
    external: List[String],
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case value {
        Some(node) -> resolve_node(node, local, external, parameters, declarations, output);
        None -> output
    }.

@pure
resolve_parameters(
    values: List[ProjectedParameterTree],
    local: List[String],
    external: List[String],
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] -> resolve_parameters(
            rest,
            local,
            external,
            parameters,
            declarations,
            resolve_optional(value.annotation, local, external, parameters, declarations, output),
        )
    }.

@pure
resolve_callables(
    values: List[ProjectedCallableSignature],
    local: List[String],
    external: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] ->
            let scoped = duplicate_parameter_diagnostics(
                value.type_parameters,
                List.new[String](),
                output,
            );
            let resolved_parameters = resolve_parameters(
                value.parameters,
                local,
                external,
                value.type_parameters,
                declarations,
                scoped,
            );
            resolve_callables(
                rest,
                local,
                external,
                declarations,
                resolve_optional(
                    value.return_type,
                    local,
                    external,
                    value.type_parameters,
                    declarations,
                    resolved_parameters,
                ),
            )
    }.

@pure
resolve_declarations(
    values: List[ProjectedTypeDeclarationTree],
    local: List[String],
    external: List[String],
    declarations: List[ProjectedTypeConstructorArity],
    output: List[ProjectedTypeDiagnostic],
): List[ProjectedTypeDiagnostic] ->
    case values {
        [] -> output;
        [value | rest] ->
            let scoped = duplicate_parameter_diagnostics(
                value.type_parameters,
                List.new[String](),
                output,
            );
            resolve_declarations(
                rest,
                local,
                external,
                declarations,
                resolve_optional(
                    value.representation,
                    local,
                    external,
                    value.type_parameters,
                    declarations,
                    scoped,
                ),
            )
    }.

/** Resolves one type tree under an explicit generic scope. */
@pure
pub resolve_scoped_type(
    value: ProjectedTypeNode,
    parameters: List[String],
    declarations: List[ProjectedTypeConstructorArity],
): List[ProjectedTypeDiagnostic] ->
    reverse(resolve_node(
        value,
        List.new[String](),
        List.new[String](),
        parameters,
        declarations,
        List.new[ProjectedTypeDiagnostic](),
    )).

/** Validates lexical generic binder uniqueness independently of a declaration. */
@pure
pub validate_generic_parameters(parameters: List[String]): List[ProjectedTypeDiagnostic] ->
    reverse(duplicate_parameter_diagnostics(
        parameters,
        List.new[String](),
        List.new[ProjectedTypeDiagnostic](),
    )).

/** Resolves all projected signature type names for one frontend module. */
@pure
pub resolve(source: ProjectedFrontendModule, external_types: List[String]): ProjectedTypeResolution ->
    resolve_with_interfaces(source, external_types, List.new[ModuleInterface]()).

/** Resolves signatures with imported constructor arity contracts. */
@pure
pub resolve_with_interfaces(
    source: ProjectedFrontendModule,
    external_types: List[String],
    imported_interfaces: List[ModuleInterface],
): ProjectedTypeResolution ->
    let local = local_types(source.backend.declarations);
    let visible_external = ProjectedImportedTypeCatalog.build(source.backend, imported_interfaces);
    let imported_bindings = if {
        imported_interfaces == [] -> identity_bindings(external_types);
        true -> ProjectedImportedTypeCatalog.build_bindings(source.backend, imported_interfaces)
    };
    let bindings = append_bindings(
        local_type_bindings(source.backend.module_name, local),
        imported_bindings,
    );
    let resolved_external = if { imported_interfaces == [] -> external_types; true -> visible_external };
    let constructor_arities = append_arities(
        source.signatures.type_constructors,
        external_constructor_arities(imported_interfaces, resolved_external),
    );
    let callable_diagnostics = resolve_callables(
        source.signatures.callables,
        local,
        resolved_external,
        constructor_arities,
        binding_diagnostics_at(imported_bindings, List.new[ProjectedTypeDiagnostic]()),
    );
    let diagnostics = reverse(resolve_declarations(
        source.signatures.types,
        local,
        resolved_external,
        constructor_arities,
        callable_diagnostics,
    ));
    ProjectedTypeResolution(
        source.valid and diagnostics == [],
        local,
        resolved_external,
        bindings,
        diagnostics,
    ).
