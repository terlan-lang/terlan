/** Adapts canonical lexer tokens to implementation-neutral LR projections. */
module self_host.ProjectionAdapter.


import std.core.Option.{None, Option, Some}.
import self_host.CanonicalToken.{CanonicalToken}.
import self_host.ProjectionSyntax.{AndProjection, ArrowProjection, AsProjection, AtomProjection, BangProjection, BinaryProjection, CastTypeLBracketProjection, ColonProjection, CommaProjection, CommentProjection, ConfigRawDeclarationProjection, DocProjection, DotProjection, EndProjection, ExpressionRawMacroProjection, FloatProjection, FunctionBodyArrowProjection, GtProjection, HeadConstraintListProjection, IfClauseSemicolonProjection, IfProjection, IntProjection, LBraceProjection, LBracketProjection, LParenProjection, LambdaOpeningProjection, LambdaSequenceSemicolonProjection, LetProjection, LtProjection, MinusProjection, ModuleProjection, NativeRawDeclarationProjection, OrProjection, OtherProjection, ProjectedCanonicalToken, ProjectionClass, ProjectionMark, ProjectionOutput, ProjectionToken, ProjectionTokenKind, RBraceProjection, RBracketProjection, RParenProjection, SemicolonProjection, StringProjection, TypedLambdaPatternProjection, VarProjection, WhenProjection, WhereProjection}.


import std.collections.List.
import std.core.{Int, String}.
import self_host.Projection.



@pure
terminal_is(token: CanonicalToken, lower: String, upper: String): Bool ->
    token.terminal == lower or token.terminal == upper.

@pure
choose_kind(condition: Bool, selected: ProjectionTokenKind, fallback: ProjectionTokenKind): ProjectionTokenKind ->
    if { condition -> selected; true -> fallback }.

struct KindCandidate {
    matches: Bool,
    value: ProjectionTokenKind,
}.

constructor KindCandidate {
    (matches: Bool, value: ProjectionTokenKind): KindCandidate ->
        KindCandidate { matches: matches, value: value }
}.

@pure
first_kind(values: List[KindCandidate]): ProjectionTokenKind ->
    case values {
        [] -> OtherProjection;
        [value | rest] -> if { value.matches -> value.value; true -> first_kind(rest) }
    }.

@pure
kind(token: CanonicalToken): ProjectionTokenKind ->
    first_kind([
        KindCandidate(token.text == "(", LParenProjection),
        KindCandidate(token.text == ")", RParenProjection),
        KindCandidate(token.text == "[", LBracketProjection),
        KindCandidate(token.text == "]", RBracketProjection),
        KindCandidate(token.text == "{", LBraceProjection),
        KindCandidate(token.text == "}", RBraceProjection),
        KindCandidate(token.text == "<", LtProjection),
        KindCandidate(token.text == ">", GtProjection),
        KindCandidate(token.text == ":", ColonProjection),
        KindCandidate(token.text == "->", ArrowProjection),
        KindCandidate(token.text == ";", SemicolonProjection),
        KindCandidate(token.text == ".", DotProjection),
        KindCandidate(token.text == ",", CommaProjection),
        KindCandidate(token.text == "-", MinusProjection),
        KindCandidate(token.text == "!", BangProjection),
        KindCandidate(token.text == "module", ModuleProjection),
        KindCandidate(token.text == "let", LetProjection),
        KindCandidate(token.text == "if", IfProjection),
        KindCandidate(token.text == "as", AsProjection),
        KindCandidate(token.text == "where", WhereProjection),
        KindCandidate(token.text == "when", WhenProjection),
        KindCandidate(token.text == "and", AndProjection),
        KindCandidate(token.text == "or", OrProjection),
        KindCandidate(terminal_is(token, "atom", "Atom"), AtomProjection),
        KindCandidate(token.terminal == "upper-ident" or terminal_is(token, "var", "Var"), VarProjection),
        KindCandidate(terminal_is(token, "int", "Int"), IntProjection),
        KindCandidate(terminal_is(token, "float", "Float"), FloatProjection),
        KindCandidate(terminal_is(token, "string", "String"), StringProjection),
        KindCandidate(terminal_is(token, "binary", "Binary"), BinaryProjection),
        KindCandidate(String.contains(token.terminal, "comment") or String.contains(token.terminal, "Comment"), CommentProjection),
        KindCandidate(String.contains(token.terminal, "doc") or String.contains(token.terminal, "Doc"), DocProjection),
        KindCandidate(terminal_is(token, "eof", "EOF") or (token.text == "" and token.start_byte == token.end_byte), EndProjection),
    ]).

@pure
adapt_one(token: CanonicalToken): ProjectionToken ->
    ProjectionToken(kind(token), token.text, token.start_byte, token.end_byte).

/** Converts canonical tokens without changing text or byte spans. */
@pure
adapt_at(values: List[CanonicalToken], output: List[ProjectionToken]): List[ProjectionToken] ->
    case values {
        [] -> reverse_at(output, List.new[ProjectionToken]());
        [value | rest] -> adapt_at(rest, [adapt_one(value) | output])
    }.

@pure
pub adapt(values: List[CanonicalToken]): List[ProjectionToken] ->
    adapt_at(values, List.new[ProjectionToken]()).

@pure
concrete_terminal(value: CanonicalToken): String ->
    if { value.text == "_" -> "_"; true -> value.terminal }.

/** Reproduces the non-collapsing token boundary used by concrete evidence. */
@pure
concrete_tokens_at(
    values: List[CanonicalToken],
    output: List[ProjectedCanonicalToken],
): List[ProjectedCanonicalToken] ->
    case values {
        [] -> reverse_at(output, List.new[ProjectedCanonicalToken]());
        [value | rest]
            where terminal_is(value, "eof", "EOF")
                or (value.text == "" and value.start_byte == value.end_byte) ->
            concrete_tokens_at(rest, output);
        [value | rest] -> concrete_tokens_at(
            rest,
            [ProjectedCanonicalToken(
                concrete_terminal(value),
                value.text,
                value.start_byte,
                value.end_byte,
            )
            | output],
        )
    }.

@pure
pub concrete_tokens(values: List[CanonicalToken]): List[ProjectedCanonicalToken] ->
    concrete_tokens_at(values, List.new[ProjectedCanonicalToken]()).

@pure
prepend(value: Option[ProjectionMark], output: List[ProjectionMark]): List[ProjectionMark] ->
    case value { Some(mark) -> [mark | output]; None -> output }.

@pure
prepend_all(values: List[ProjectionMark], output: List[ProjectionMark]): List[ProjectionMark] ->
    case values { [] -> output; [value | rest] -> prepend_all(rest, [value | output]) }.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
some_projection_token(value: ProjectionToken): Option[ProjectionToken] -> Some(value).

@pure
none_projection_token(): Option[ProjectionToken] -> None.

@pure
some_projection_mark(value: ProjectionMark): Option[ProjectionMark] -> Some(value).

@pure
none_projection_mark(): Option[ProjectionMark] -> None.

@pure
next_nontrivia(values: List[ProjectionToken]): Option[ProjectionToken] ->
    case values {
        [] -> none_projection_token();
        [value | rest]
            where value.kind == CommentProjection or value.kind == DocProjection ->
            next_nontrivia(rest);
        [value | _rest] -> some_projection_token(value)
    }.

@pure
raw_candidate(value: ProjectionToken, rest: List[ProjectionToken]): Bool ->
    case next_nontrivia(rest) {
        Some(next) ->
            ((value.kind == AtomProjection or value.text == "html")
                and next.kind == LBraceProjection)
                or (value.kind == AtomProjection
                    and value.text == "sql"
                    and next.kind == LBracketProjection);
        None -> false
    }.

@pure
raw_marks(value: ProjectionToken, values: List[ProjectionToken], rest: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    if { raw_candidate(value, rest) -> prepend(Projection.expression_raw_macro(values), output); true -> output }.

@pure
native_marks(value: ProjectionToken, values: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    if { value.text == "native" -> prepend(Projection.native_raw_declaration(values), output); true -> output }.

@pure
config_marks(value: ProjectionToken, values: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    if { value.text == "target" -> prepend(Projection.config_raw_declaration(values), output); true -> output }.

@pure
constraint_marks(value: ProjectionToken, previous: Option[ProjectionToken], values: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    if { value.kind == LtProjection -> prepend(Projection.head_constraint_list(previous, values), output); true -> output }.

@pure
lambda_mark(value: ProjectionToken, previous: Option[ProjectionToken], values: List[ProjectionToken], arrows: List[ProjectionMark]): Option[ProjectionMark] ->
    if { value.kind == LParenProjection -> Projection.lambda_opening(previous, values, arrows); true -> none_projection_mark() }.

@pure
sequence_marks(lambda: Option[ProjectionMark], values: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    case lambda {
        Some(_opening) -> prepend_all(Projection.lambda_sequence_semicolons(values), prepend_all(Projection.typed_lambda_patterns(values), output));
        None -> output
    }.

@pure
clause_marks(value: ProjectionToken, values: List[ProjectionToken], output: List[ProjectionMark]): List[ProjectionMark] ->
    if { value.kind == IfProjection or value.text == "case" -> prepend_all(Projection.if_clause_semicolons(values), output); true -> output }.

@pure
collect_value(values: List[ProjectionToken], value: ProjectionToken, rest: List[ProjectionToken], previous: Option[ProjectionToken], arrows: List[ProjectionMark], output: List[ProjectionMark]): List[ProjectionMark] ->
    let raw = raw_marks(value, values, rest, output);
    let native = native_marks(value, values, raw);
    let config = config_marks(value, values, native);
    let constraints = constraint_marks(value, previous, values, config);
    let lambda = lambda_mark(value, previous, values, arrows);
    let sequences = sequence_marks(lambda, values, prepend(lambda, constraints));
    collect_at(rest, some_projection_token(value), arrows, clause_marks(value, values, sequences)).

@pure
collect_at(
    values: List[ProjectionToken],
    previous: Option[ProjectionToken],
    arrows: List[ProjectionMark],
    output: List[ProjectionMark],
): List[ProjectionMark] ->
    case values {
        [] -> output;
        [value | rest]
            where value.kind == CommentProjection or value.kind == DocProjection ->
            collect_at(rest, previous, arrows, output);
        [value | rest] -> collect_value(values, value, rest, previous, arrows, output)
    }.

/** Computes every currently modeled contextual mark from canonical tokens. */
@pure
pub project(values: List[CanonicalToken]): ProjectionOutput ->
    let tokens = adapt(values);
    let arrows = Projection.function_body_arrows(tokens);
    let casts = Projection.cast_type_lbrackets(tokens);
    ProjectionOutput(reverse(collect_at(
        tokens,
        none_projection_token(),
        arrows,
        prepend_all(reverse(casts), reverse(arrows)),
    ))).

@pure
terminal(class: ProjectionClass): String ->
    if { class == FunctionBodyArrowProjection -> "function-body-arrow"; true -> terminal_head(class) }.

@pure
terminal_head(class: ProjectionClass): String ->
    if { class == HeadConstraintListProjection -> "head-constraints"; true -> terminal_lambda(class) }.

@pure
terminal_lambda(class: ProjectionClass): String ->
    if { class == LambdaOpeningProjection -> "lambda-("; true -> terminal_typed(class) }.

@pure
terminal_typed(class: ProjectionClass): String ->
    if { class == TypedLambdaPatternProjection -> "typed-lambda-pattern"; true -> terminal_sequence(class) }.

@pure
terminal_sequence(class: ProjectionClass): String ->
    if { class == LambdaSequenceSemicolonProjection -> "lambda-sequence-semicolon"; true -> terminal_clause(class) }.

@pure
terminal_clause(class: ProjectionClass): String ->
    if { class == IfClauseSemicolonProjection -> "if-clause-semicolon"; true -> terminal_cast(class) }.

@pure
terminal_cast(class: ProjectionClass): String ->
    if { class == CastTypeLBracketProjection -> "cast-type-["; true -> terminal_raw(class) }.

@pure
terminal_raw(class: ProjectionClass): String ->
    if { class == ExpressionRawMacroProjection -> "expression-raw-macro"; true -> terminal_native(class) }.

@pure
terminal_native(class: ProjectionClass): String ->
    if { class == NativeRawDeclarationProjection -> "native-raw-declaration"; true -> "config-raw-declaration" }.

@pure
insert_mark(value: ProjectionMark, values: List[ProjectionMark]): List[ProjectionMark] ->
    case values {
        [] -> [value];
        [head | _rest]
            where value.start_byte < head.start_byte
                or (value.start_byte == head.start_byte and value.end_byte > head.end_byte) ->
            [value | values];
        [head | rest] -> [head | insert_mark(value, rest)]
    }.

@pure
sort_marks_at(values: List[ProjectionMark], output: List[ProjectionMark]): List[ProjectionMark] ->
    case values {
        [] -> output;
        [value | rest] -> sort_marks_at(rest, insert_mark(value, output))
    }.

@pure
sort_marks(values: List[ProjectionMark]): List[ProjectionMark] ->
    sort_marks_at(values, List.new[ProjectionMark]()).

struct MarkSelection {
    mark: Option[ProjectionMark],
    rest: List[ProjectionMark],
}.

constructor MarkSelection {
    (mark: Option[ProjectionMark], rest: List[ProjectionMark]): MarkSelection ->
        MarkSelection {
            mark: mark,
            rest: rest,
        }
}.

@pure
preferred_existing(current: Option[ProjectionMark], existing: ProjectionMark, value: ProjectionMark): Option[ProjectionMark] ->
    if { existing.end_byte >= value.end_byte -> current; true -> some_projection_mark(value) }.

@pure
preferred_mark(current: Option[ProjectionMark], value: ProjectionMark): Option[ProjectionMark] ->
    case current {
        Some(existing) -> preferred_existing(current, existing, value);
        None -> some_projection_mark(value)
    }.

@pure
select_at_or_after(values: List[ProjectionMark], value: ProjectionMark, rest: List[ProjectionMark], start_byte: Int, current: Option[ProjectionMark]): MarkSelection ->
    if { value.start_byte == start_byte -> select_marks(rest, start_byte, preferred_mark(current, value)); true -> MarkSelection(mark = current, rest = values) }.

@pure
select_value(values: List[ProjectionMark], value: ProjectionMark, rest: List[ProjectionMark], start_byte: Int, current: Option[ProjectionMark]): MarkSelection ->
    if { value.start_byte < start_byte -> select_marks(rest, start_byte, current); true -> select_at_or_after(values, value, rest, start_byte, current) }.

@pure
select_marks(
    values: List[ProjectionMark],
    start_byte: Int,
    current: Option[ProjectionMark],
): MarkSelection ->
    case values {
        [] -> MarkSelection(mark = current, rest = List.new[ProjectionMark]());
        [value | rest] -> select_value(values, value, rest, start_byte, current)
    }.

@pure
rewrite_selected(source: String, value: CanonicalToken, rest: List[CanonicalToken], selected: MarkSelection, skip_until: Int, output: List[ProjectedCanonicalToken]): List[ProjectedCanonicalToken] ->
    case selected.mark {
        Some(mark) -> rewrite_at(source, rest, selected.rest, mark.end_byte, [ProjectedCanonicalToken(terminal(mark.class), source.utf8_slice(mark.start_byte, mark.end_byte - mark.start_byte), mark.start_byte, mark.end_byte) | output]);
        None -> rewrite_at(source, rest, selected.rest, skip_until, [ProjectedCanonicalToken(value.terminal, value.text, value.start_byte, value.end_byte) | output])
    }.

@pure
rewrite_value(source: String, value: CanonicalToken, rest: List[CanonicalToken], marks: List[ProjectionMark], skip_until: Int, output: List[ProjectedCanonicalToken]): List[ProjectedCanonicalToken] ->
    rewrite_selected(source, value, rest, select_marks(marks, value.start_byte, none_projection_mark()), skip_until, output).

@pure
rewrite_at(
    source: String,
    values: List[CanonicalToken],
    marks: List[ProjectionMark],
    skip_until: Int,
    output: List[ProjectedCanonicalToken],
): List[ProjectedCanonicalToken] ->
    case values {
        [] -> reverse_at(output, List.new[ProjectedCanonicalToken]());
        [value | rest] where value.start_byte < skip_until ->
            rewrite_at(source, rest, marks, skip_until, output);
        [value | rest] -> rewrite_value(source, value, rest, marks, skip_until, output)
    }.

/** Rewrites canonical lexer tokens into the exact contextual terminal stream. */
@pure
pub rewrite(source: String, values: List[CanonicalToken]): List[ProjectedCanonicalToken] ->
    rewrite_at(
        source,
        values,
        sort_marks(project(values).marks),
        -1,
        List.new[ProjectedCanonicalToken](),
    ).
