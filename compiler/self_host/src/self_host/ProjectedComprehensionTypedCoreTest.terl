/**
 * Comprehension-generated lambda binders retain typed Core identity.
 */
module self_host.ProjectedComprehensionTypedCoreTest.

import self_host.ProjectedExpressionSyntax.ProjectedExpressionNode.
import self_host.{ProjectedComprehensionDesugar, ProjectedExpressionSupportIrPlan}.
import std.collections.List.
import std.core.Option.{None, Some}.

node(
    kind: String,
    text: String,
    children: List[ProjectedExpressionNode],
): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, text, 10, 40, children).

@test
pub generated_lambda_parameter_desugars_to_typed_binding_core(): Bool ->
    let comprehension =
        node(
            "list-comprehension",
            "|",
            [
                node("identifier", "rendered", []),
                node(
                    "generator",
                    "<-",
                    [node("binding-pattern", "item", []), node("identifier", "items", [])],
                ),
            ],
        );
    let projected = ProjectedComprehensionDesugar.expression(comprehension);
    case projected.children {
        [_source, callback] ->
            projected.kind == "list-flat-map"
                and (when {
    {[patterns, _body], [parameter]} <- {callback.children, ProjectedExpressionSupportIrPlan.lambda_parameters(callback)};
    [pattern] <- patterns.children
} else {
    _ -> false
};
(let metadata = ProjectedExpressionSupportIrPlan.shallow_pattern_operands("%subject", pattern);
(when {
    [binding] <-
        ProjectedExpressionSupportIrPlan.shallow_pattern_bindings(
            pattern,
            "%environment",
            [],
            [parameter],
        );
    Some(name) <- binding.result
} else {
    _ -> false
};
pattern.kind == "typed-pattern"
    and parameter.name == "_comprehension_10"
    and parameter.type_name == "Dynamic"
    and name == parameter.name
    and binding.resolved_type == Some(parameter.type_name)
    and metadata == ["%subject", "pattern-v2", "binding-pattern", "_comprehension_10", "0"])));
        _ -> false
    }.
