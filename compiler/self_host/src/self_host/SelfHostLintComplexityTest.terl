/** Positive and negative complexity threshold contracts. */
module self_host.SelfHostLintComplexityTest.

import self_host.SelfHostLintComplexity.{ClauseSpan}.
import self_host.SelfHostLintComplexity.
import std.core.String.

repeat(line: String, count: Int, output: String): String ->
    if {
        count <= 0 -> output;
        true -> repeat(line, count - 1, String.concat([output, line]))
    }.

@test
pub counts_lines_like_rust_source_lines(): Bool ->
    SelfHostLintComplexity.source_line_count("") == 0
        and SelfHostLintComplexity.source_line_count("one") == 1
        and SelfHostLintComplexity.source_line_count("one\n") == 1
        and SelfHostLintComplexity.source_line_count("one\ntwo") == 2.

@test
pub reports_function_clause_over_forty_lines(): Bool ->
    let source = repeat("step();\n", 41, "");
    case SelfHostLintComplexity.function_size(
        "LongFunction.terl",
        source,
        [ClauseSpan(0, String.byte_size(source))],
    ) {
        [value] ->
            value.rule_id == "TL0901"
                and value.rule_name == "complexity.function-size"
                and value.severity == "warning"
                and value.line == 1
                and value.column == 1;
        _ -> false
    }.

@test
pub accepts_function_clause_at_forty_lines(): Bool ->
    let source = repeat("step();\n", 40, "");
    SelfHostLintComplexity.function_size(
        "ShortFunction.terl",
        source,
        [ClauseSpan(0, String.byte_size(source))],
    ) == [].

@test
pub reports_ordinary_source_over_five_hundred_lines(): Bool ->
    let source = repeat("// filler\n", 501, "");
    case SelfHostLintComplexity.file_size("Large.terl", source) {
        [value] -> value.rule_id == "TL0902" and value.line == 1 and value.column == 1;
        _ -> false
    }.

@test
pub accepts_ordinary_source_at_five_hundred_lines(): Bool ->
    SelfHostLintComplexity.file_size(
        "AtThreshold.terl",
        repeat("// filler\n", 500, ""),
    ) == [].

@test
pub exempts_generated_source_only_when_marker_is_in_first_twenty_lines(): Bool ->
    let early = String.concat(["/** @generated true */\n", repeat("// filler\n", 501, "")]);
    let late = String.concat([
        repeat("// ordinary\n", 20, ""),
        "// generated by tool\n",
        repeat("// filler\n", 501, ""),
    ]);
    SelfHostLintComplexity.generated_source(early)
        and not SelfHostLintComplexity.generated_source(late)
        and SelfHostLintComplexity.file_size("Generated.terl", early) == []
        and SelfHostLintComplexity.file_size("Large.terl", late) != [].

case_source(lines: Int): String ->
    String.concat([
        "module sample.\npub run(flag: Bool): Unit ->\n    case flag {\n        true ->\n",
        repeat("            step();\n", lines, ""),
        "        false -> done()\n    }.\n",
    ]).

@test
pub reports_match_arm_over_twenty_counted_lines(): Bool ->
    case SelfHostLintComplexity.match_arm_size("LongArm.terl", case_source(21)) {
        [value] ->
            value.rule_id == "TL0903"
                and value.rule_name == "complexity.match-arm-size"
                and value.severity == "warning"
                and value.line == 4;
        _ -> false
    }.

@test
pub accepts_match_arm_at_twenty_counted_lines(): Bool ->
    SelfHostLintComplexity.match_arm_size("ShortArm.terl", case_source(20)) == [].

@test
pub counts_inline_arm_body_as_one_line(): Bool ->
    let source = String.concat([
        "module sample.\npub run(flag: Bool): Unit ->\n    case flag {\n        true -> first();\n",
        repeat("            step();\n", 20, ""),
        "        false -> done()\n    }.\n",
    ]);
    SelfHostLintComplexity.match_arm_size("InlineArm.terl", source) != [].

@test
pub ignores_blank_comment_and_closing_lines_in_arms(): Bool ->
    let source = String.concat([
        "module sample.\npub run(flag: Bool): Unit ->\n    case flag {\n        true ->\n",
        repeat("\n            // comment\n            * doc line\n", 30, ""),
        "        };\n",
    ]);
    SelfHostLintComplexity.match_arm_size("IgnoredLines.terl", source) == [].

@test
pub tracks_nested_branch_contexts_independently(): Bool ->
    let source = String.concat([
        "module sample.\npub run(flag: Bool): Unit ->\n    case flag {\n        true ->\n            case flag {\n                true ->\n",
        repeat("                    step();\n", 21, ""),
        "                false -> done()\n            };\n        false -> done()\n    }.\n",
    ]);
    case SelfHostLintComplexity.match_arm_size("NestedArm.terl", source) {
        [value] -> value.rule_id == "TL0903" and value.line == 6;
        _ -> false
    }.
