import self_host.SelfHostLintTestsProjection.

@pure
append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

@pure
concat[T](values: List[List[T]]): List[T] ->
    case values {
        [] -> [];
        [value | rest] -> append(value, concat(rest))
    }.

diagnostic_offset(
    source: String,
    target_line: Int,
    target_column: Int,
    offset: Int,
    line: Int,
    column: Int,
): Int ->
    if {
        offset >= String.byte_size(source) -> offset;
        line == target_line and column >= target_column -> offset;
        String.utf8_byte_at(source, offset) == 10 ->
            diagnostic_offset(source, target_line, target_column, offset + 1, line + 1, 1);
        true -> diagnostic_offset(
            source,
            target_line,
            target_column,
            offset + 1,
            line,
            column + 1,
        )
    }.

from_semicolon(
    source: String,
    values: List[self_host.SelfHostLintSemicolon.SemicolonDiagnostic],
): List[LintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] ->
            let start = diagnostic_offset(source, value.line, value.column, 0, 1, 1);
            [LintDiagnostic(
                value.path, value.line, value.column, start, start, value.rule_id,
                value.rule_name, value.severity, value.message, value.fix_available,
            ) | from_semicolon(source, rest)]
    }.

