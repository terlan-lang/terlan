/** Runs all 45 rules in native dispatcher order over one shared document. */
@pure
pub lint(path: String, source: String): LintReport ->
    let document = SelfHostToolingDocument.build(source);
    if {
        not document.valid -> LintReport(false, [], document.message);
        true ->
            let lambda = SelfHostLintLambdaProjection.diagnostics(path, document);
            let readability_source = SelfHostLintReadabilitySource.diagnostics(path, source);
            LintReport(
                true,
                concat([
                    from_semicolon(source, SelfHostLintSemicolon.diagnostics(path, source)),
                    from_complexity(source, SelfHostLintComplexityProjection.diagnostics(path, document)),
                    from_complexity(source, SelfHostLintComplexity.match_arm_size(path, source)),
                    from_complexity(source, SelfHostLintComplexity.file_size(path, source)),
                    from_actor(source, SelfHostLintActorVmProjection.diagnostics(path, document)),
                    from_maintainability(source, SelfHostLintMaintainability.debug_calls(path, source)),
                    from_maintainability(source, SelfHostLintMaintainability.sql_line_width(path, source)),
                    from_consistency(source, SelfHostLintConsistency.diagnostics(path, source)),
                    from_consistency(source, SelfHostLintNamedAtomProjection.diagnostics(path, document)),
                    from_readability(source, SelfHostLintReadabilityDocument.diagnostics(path, document)),
                    from_readability(source, SelfHostLintGroupedBindingProjection.diagnostics(path, document)),
                    from_readability(source, readability_rule(lambda, "TL0010")),
                    from_readability(source, readability_rule(lambda, "TL0003")),
                    from_readability(source, SelfHostLintDestructureProjection.diagnostics(path, document)),
                    from_readability(source, readability_rule(readability_source, "TL0005")),
                    from_readability(source, SelfHostLintPublicDocsSource.diagnostics(path, source)),
                    from_readability(source, readability_rule(readability_source, "TL0007")),
                    from_readability(source, readability_rule(readability_source, "TL0008")),
                    from_pipe(source, SelfHostLintPipeProjection.diagnostics(path, document)),
                    from_tests(source, SelfHostLintTestsProjection.diagnostics(path, document)),
                    SelfHostLintImports.lint(path, document),
                    SelfHostLintImportUsage.lint(path, document),
                    SelfHostLintImportRecommendations.lint(path, document),
                    from_naming(source, SelfHostLintNamingProjection.diagnostics(path, document)),
                    from_generated(source, SelfHostLintGenerated.diagnostics(path, source)),
                    from_targets(source, SelfHostLintTargets.diagnostics(path, source)),
                ]),
                "ok",
            )
    }.

/** Applies authenticated safe fixes in native order. */
@pure
pub fix(source: String): String ->
    let semicolon_fixed = SelfHostLintSemicolon.fix(source);
    let document = SelfHostToolingDocument.build(semicolon_fixed);
    if {
        not document.valid -> semicolon_fixed;
        true -> SelfHostLintPipeProjection.apply(document)
    }.
