readability_rule(
    values: List[self_host.SelfHostLintReadability.ReadabilityDiagnostic],
    rule_id: String,
): List[self_host.SelfHostLintReadability.ReadabilityDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> if {
            value.rule_id == rule_id -> [value | readability_rule(rest, rule_id)];
            true -> readability_rule(rest, rule_id)
        }
    }.

