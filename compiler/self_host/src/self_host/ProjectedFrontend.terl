/** Authoritative composition of projected lexer/parser/typed frontend stages. */
module self_host.ProjectedFrontend.

import self_host.CanonicalToken.{CanonicalToken}.
import self_host.ProjectedFrontendSyntax.{ProjectedFrontendModule}.
import self_host.ProjectionSyntax.{ProjectedCanonicalToken}.

import std.collections.List.
import std.core.{Bool, String}.
import self_host.BackendHandoff.
import self_host.ConcreteSyntaxParser.
import self_host.ProjectionAdapter.
import self_host.ProjectedBodyParser.
import self_host.ProjectedDeclarationLowering.
import self_host.ProjectedParser.
import self_host.ProjectedSignatureParser.
import self_host.SemanticAnalysis.
import self_host.TypedModuleLowering.

@pure
canonical_tokens(values: List[CanonicalToken]): List[ProjectedCanonicalToken] ->
    case values {
        [] -> List.new[ProjectedCanonicalToken]();
        [value | rest] -> [
            ProjectedCanonicalToken(
                value.terminal,
                value.text,
                value.start_byte,
                value.end_byte,
            )
            | canonical_tokens(rest)
        ]
    }.


@pure
frontend_message(concrete_valid: Bool, concrete_message: String, surface_valid: Bool, surface_message: String, signatures_valid: Bool, bodies_valid: Bool, backend_valid: Bool, backend_message: String): String ->
    if {
        not concrete_valid -> concrete_message;
        true -> frontend_message_after_concrete(surface_valid, surface_message, signatures_valid, bodies_valid, backend_valid, backend_message)
    }.

@pure
frontend_message_after_concrete(surface_valid: Bool, surface_message: String, signatures_valid: Bool, bodies_valid: Bool, backend_valid: Bool, backend_message: String): String ->
    if {
        not surface_valid -> surface_message;
        true -> frontend_message_after_surface(signatures_valid, bodies_valid, backend_valid, backend_message)
    }.

@pure
frontend_message_after_surface(signatures_valid: Bool, bodies_valid: Bool, backend_valid: Bool, backend_message: String): String ->
    if {
        not signatures_valid -> "one or more declaration signatures are invalid";
        true -> frontend_message_after_signatures(bodies_valid, backend_valid, backend_message)
    }.

@pure
frontend_message_after_signatures(bodies_valid: Bool, backend_valid: Bool, backend_message: String): String ->
    if {
        not bodies_valid -> "one or more callable bodies are invalid";
        true -> frontend_message_after_bodies(backend_valid, backend_message)
    }.

@pure
frontend_message_after_bodies(backend_valid: Bool, backend_message: String): String ->
    if {
        not backend_valid -> backend_message;
        true -> ""
    }.

/** Runs every self-hosted frontend stage exactly once over one canonical token stream. */
@pure
pub compile(source: String, canonical: List[CanonicalToken]): ProjectedFrontendModule ->
    let tokens = ProjectionAdapter.rewrite(source, canonical);
    let concrete = ConcreteSyntaxParser.parse(canonical_tokens(canonical));
    let surface = ProjectedParser.parse(source, tokens);
    let signatures = ProjectedSignatureParser.parse(tokens, surface.declarations);
    let bodies = ProjectedBodyParser.parse(tokens, surface.declarations);
    let backend = BackendHandoff.lower(SemanticAnalysis.analyze(TypedModuleLowering.lower(
        ProjectedDeclarationLowering.lower(surface),
    )));
    let valid = concrete.valid
        and surface.valid
        and signatures.valid
        and bodies.valid
        and backend.valid;
    ProjectedFrontendModule(
        valid,
        source,
        tokens,
        concrete,
        surface,
        signatures,
        bodies,
        backend,
        frontend_message(
            concrete.valid,
            concrete.message,
            surface.valid,
            surface.message,
            signatures.valid,
            bodies.valid,
            backend.valid,
            backend.message,
        ),
    ).
