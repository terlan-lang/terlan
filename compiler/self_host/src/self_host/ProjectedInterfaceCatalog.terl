/**
 * Bounded, persistent module-interface catalog for self-hosted compilation.
 *
 * Each source is compiled independently to a small interface artifact. Backend
 * units then load those artifacts instead of retaining the complete source and
 * syntax closure in one actor heap.
 */
module self_host.ProjectedInterfaceCatalog.

import std.core.String.

import std.collections.List.
import std.core.{Bool, Int, String}.
import std.core.Option.{None, Option, Some}.
import std.core.Result.{Err, Ok, Result}.
import std.io.File.
import self_host.ModuleInterfaceSyntax.{ExportedStructField, ExportedSymbol, ModuleInterface}.
import self_host.Syntax.{
    AnnotationSchemaDeclaration,
    ConfigDeclaration,
    ConstantDeclaration,
    ConstFunctionDeclaration,
    ConstructorDeclaration,
    DeclarationClass,
    ExportDeclaration,
    FunctionDeclaration,
    ImportDeclaration,
    MethodDeclaration,
    NativeDeclaration,
    OpaqueTypeDeclaration,
    ShapeDeclaration,
    StructDeclaration,
    SyntaxSpan,
    TemplateDeclaration,
    TraitDeclaration,
    TraitImplDeclaration,
    TypeDeclaration,
    UnknownDeclaration
}.

import self_host.CanonicalLexer.
import self_host.Compiler.
import self_host.CompilerPipeline.
import self_host.ProjectedCoreBackendCompile.
import self_host.ProjectedFrontend.
import self_host.SemanticSyntax.{SemanticDiagnostic}.
import self_host.SelfHostCoreOptimizeArtifactTool.


pub struct InterfaceCatalog {
    valid: Bool,
    interfaces: List[ModuleInterface],
    message: String,
}.

pub constructor InterfaceCatalog {
    (valid: Bool, interfaces: List[ModuleInterface], message: String): InterfaceCatalog ->
        InterfaceCatalog {
            valid: valid,
            interfaces: interfaces,
            message: message,
        }
}.


struct InterfaceParse {
    valid: Bool,
    interface: ModuleInterface,
    message: String,
}.

constructor InterfaceParse {
    (valid: Bool, interface: ModuleInterface, message: String): InterfaceParse ->
        InterfaceParse {
            valid: valid,
            interface: interface,
            message: message,
        }
}.

struct ClassEntry {
    name: String,
    declaration_class: DeclarationClass,
}.

constructor ClassEntry {
    (name: String, declaration_class: DeclarationClass): ClassEntry ->
        ClassEntry { name: name, declaration_class: declaration_class }
}.


@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
class_entries(): List[ClassEntry] -> [
    ClassEntry("import", ImportDeclaration),
    ClassEntry("export", ExportDeclaration),
    ClassEntry("constant", ConstantDeclaration),
    ClassEntry("const-function", ConstFunctionDeclaration),
    ClassEntry("type", TypeDeclaration),
    ClassEntry("opaque-type", OpaqueTypeDeclaration),
    ClassEntry("struct", StructDeclaration),
    ClassEntry("constructor", ConstructorDeclaration),
    ClassEntry("function", FunctionDeclaration),
    ClassEntry("method", MethodDeclaration),
    ClassEntry("trait", TraitDeclaration),
    ClassEntry("trait-impl", TraitImplDeclaration),
    ClassEntry("annotation-schema", AnnotationSchemaDeclaration),
    ClassEntry("template", TemplateDeclaration),
    ClassEntry("shape", ShapeDeclaration),
    ClassEntry("config", ConfigDeclaration),
    ClassEntry("native", NativeDeclaration),
    ClassEntry("unknown", UnknownDeclaration),
].

@pure
class_name_entry(value: DeclarationClass, entry: ClassEntry, rest: List[ClassEntry]): String ->
    if { value == entry.declaration_class -> entry.name; true -> class_name_at(value, rest) }.

@pure
class_name_at(value: DeclarationClass, entries: List[ClassEntry]): String ->
    case entries {
        [] -> "unknown";
        [entry | rest] -> class_name_entry(value, entry, rest)
    }.

@pure
class_name(value: DeclarationClass): String ->
    class_name_at(value, class_entries()).

@pure
known_class(value: String): Bool ->
    value == "import"
        or value == "export"
        or value == "constant"
        or value == "const-function"
        or value == "type"
        or value == "opaque-type"
        or value == "struct"
        or value == "constructor"
        or value == "function"
        or value == "method"
        or value == "trait"
        or value == "trait-impl"
        or value == "annotation-schema"
        or value == "template"
        or value == "shape"
        or value == "config"
        or value == "native"
        or value == "unknown".

@pure
class_from_entry(value: String, entry: ClassEntry, rest: List[ClassEntry]): DeclarationClass ->
    if { value == entry.name -> entry.declaration_class; true -> class_from_name_at(value, rest) }.

@pure
class_from_name_at(value: String, entries: List[ClassEntry]): DeclarationClass ->
    case entries {
        [] -> UnknownDeclaration;
        [entry | rest] -> class_from_entry(value, entry, rest)
    }.

@pure
class_from_name(value: String): DeclarationClass ->
    class_from_name_at(value, class_entries()).

@pure
rendered_return_type(value: Option[String]): String ->
    case value { Some(name) -> name; None -> "_" }.

@pure
rendered_parameter_types(values: List[Option[String]]): String ->
    case values {
        [] -> "";
        [value] -> rendered_return_type(value);
        [value | rest] -> String.concat([rendered_return_type(value), ";", rendered_parameter_types(rest)])
    }.

@pure
rendered_type_parameters(values: List[String]): String -> String.join(values, ",").

@pure
render_record_fields(owner: String, values: List[ExportedStructField]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.concat([
            "field\t",
            owner,
            "\t",
            value.name,
            "\t",
            rendered_return_type(value.type_name),
            "\n",
            render_record_fields(owner, rest),
        ])
    }.

@pure
rendered_owner(value: Option[String]): String ->
    case value { Some(name) -> name; None -> "_" }.

@pure
parsed_owner(value: String): Option[String] ->
    if { value == "_" -> None; true -> Some(value) }.

@pure
rendered_default(value: Bool): String -> if { value -> "true"; true -> "false" }.

@pure
parsed_return_type(value: String): Option[String] ->
    if { value == "_" -> None; true -> Some(value) }.

@pure
parsed_parameter_types_at(values: List[String]): List[Option[String]] ->
    case values {
        [] -> List.new[Option[String]]();
        [value | rest] -> [parsed_return_type(value) | parsed_parameter_types_at(rest)]
    }.

@pure
parsed_parameter_types(value: String): List[Option[String]] ->
    if { value == "" -> List.new[Option[String]](); true -> parsed_parameter_types_at(String.split(value, ";")) }.

@pure
parsed_type_parameters(value: String): List[String] ->
    if { value == "" -> List.new[String](); true -> String.split(value, ",") }.

@pure
render_symbols(values: List[ExportedSymbol]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.concat([
            "symbol\t",
            value.name,
            "\t",
            Int.to_string(value.arity),
            "\t",
            class_name(value.class),
            "\t",
            rendered_return_type(value.return_type),
            "\t",
            rendered_type_parameters(value.type_parameters),
            "\t",
            rendered_parameter_types(value.parameter_types),
            "\t",
            rendered_owner(value.owner),
            "\t",
            rendered_default(value.has_default),
            "\t",
            Int.to_string(value.span.start_byte),
            "\t",
            Int.to_string(value.span.end_byte),
            "\t",
            rendered_default(value.receiver_mutable),
            "\n",
            render_record_fields(value.name, value.record_fields),
            render_symbols(rest),
        ])
    }.

/** Serializes every interface field consumed by import and callable analysis. */
@pure
pub render(value: ModuleInterface): String ->
    String.concat([
        "interface\tterlan.self-host.interface-catalog/v5\t",
        value.module_name,
        "\n",
        render_symbols(value.symbols),
    ]).

@pure
invalid_interface(message: String): InterfaceParse ->
    InterfaceParse(false, ModuleInterface("", "", List.new[ExportedSymbol]()), message).

@pure
interface_message(module_name: String): String ->
    if { module_name == "" -> "missing interface header"; true -> "" }.

@pure
finished_interface(module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    InterfaceParse(module_name != "", ModuleInterface("terlan.self-host.interface/v5", module_name, reverse(symbols)), interface_message(module_name)).

@pure
header_name(name: String, tail: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if { tail == [] and module_name == "" and name != "" -> parse_symbols(rest, name, symbols); true -> invalid_interface("invalid interface catalog record") }.

@pure
header_schema(schema: String, tail: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case tail {
        [name | remaining] -> header_schema_name(schema, name, remaining, rest, module_name, symbols);
        [] -> invalid_interface("invalid interface catalog record")
    }.

@pure
header_schema_name(schema: String, name: String, remaining: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if {
        schema == "terlan.self-host.interface-catalog/v5"
            or schema == "terlan.self-host.interface-catalog/v4"
            or schema == "terlan.self-host.interface-catalog/v3" ->
            header_name(name, remaining, rest, module_name, symbols);
        true -> invalid_interface("invalid interface catalog record")
    }.

@pure
receiver_tail_valid(values: List[String]): Bool ->
    values == [] or values == ["true"] or values == ["false"].

@pure
parsed_receiver_mutable(values: List[String]): Bool -> values == ["true"].

@pure
header_parts(values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values {
        [schema | tail] -> header_schema(schema, tail, rest, module_name, symbols);
        [] -> invalid_interface("invalid interface catalog record")
    }.

@pure
parsed_symbol_end(name: String, arity: Int, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, has_default: Bool, receiver_mutable: Bool, start_byte: Int, value: Option[Int], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case value {
        None -> invalid_interface("invalid interface symbol end");
        Some(end_byte) -> parse_symbols(rest, module_name, [ExportedSymbol(name, arity, class_from_name(class_source), parsed_owner(owner_source), has_default, receiver_mutable, parsed_type_parameters(type_parameters_source), parsed_parameter_types(parameter_types_source), parsed_return_type(return_source), SyntaxSpan(start_byte, end_byte)) | symbols])
    }.

@pure
parsed_symbol_start(name: String, arity: Int, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, has_default: Bool, receiver_mutable: Bool, value: Option[Int], end_source: String, rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case value {
        None -> invalid_interface("invalid interface symbol start");
        Some(start_byte) -> parsed_symbol_end(name, arity, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, has_default, receiver_mutable, start_byte, Int.from_string(end_source), rest, module_name, symbols)
    }.

@pure
parsed_symbol_arity(name: String, value: Option[Int], class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, has_default: Bool, receiver_mutable: Bool, start_source: String, end_source: String, rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case value {
        None -> invalid_interface("invalid interface symbol arity");
        Some(arity) -> parsed_symbol_start(name, arity, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, has_default, receiver_mutable, Int.from_string(start_source), end_source, rest, module_name, symbols)
    }.

@pure
symbol_values(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, default_source: String, start_source: String, end_source: String, tail: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if { receiver_tail_valid(tail) and module_name != "" and name != "" and known_class(class_source) and (default_source == "true" or default_source == "false") -> parsed_symbol_arity(name, Int.from_string(arity_source), class_source, return_source, type_parameters_source, parameter_types_source, owner_source, default_source == "true", parsed_receiver_mutable(tail), start_source, end_source, rest, module_name, symbols); true -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_end_part(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, default_source: String, start_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [end_source | tail] -> symbol_values(name, arity_source, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, default_source, start_source, end_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_start_part(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, default_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [start_source | tail] -> symbol_end_part(name, arity_source, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, default_source, start_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_default_part(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, owner_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [default_source | tail] -> symbol_start_part(name, arity_source, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, default_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_owner_part(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, parameter_types_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [owner_source | tail] -> symbol_default_part(name, arity_source, class_source, return_source, type_parameters_source, parameter_types_source, owner_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_parameter_types_part(name: String, arity_source: String, class_source: String, return_source: String, type_parameters_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [parameter_types_source | tail] -> symbol_owner_part(name, arity_source, class_source, return_source, type_parameters_source, parameter_types_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_type_parameters_part(name: String, arity_source: String, class_source: String, return_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [type_parameters_source | tail] -> symbol_parameter_types_part(name, arity_source, class_source, return_source, type_parameters_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_return_part(name: String, arity_source: String, class_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [return_source | tail] -> symbol_type_parameters_part(name, arity_source, class_source, return_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_class_part(name: String, arity_source: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [class_source | tail] -> symbol_return_part(name, arity_source, class_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_arity_part(name: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [arity_source | tail] -> symbol_class_part(name, arity_source, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
symbol_parts(values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [name | tail] -> symbol_arity_part(name, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
non_header_record(kind: String, values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if {
        kind == "symbol" -> symbol_parts(values, rest, module_name, symbols);
        kind == "field" -> field_parts(values, rest, module_name, symbols);
        true -> invalid_interface("invalid interface catalog record")
    }.

@pure
append_record_fields(
    values: List[ExportedStructField],
    field: ExportedStructField,
): List[ExportedStructField] ->
    case values {
        [] -> [field];
        [value | rest] -> [value | append_record_fields(rest, field)]
    }.

@pure
append_record_field(
    value: ExportedSymbol,
    field: ExportedStructField,
): ExportedSymbol -> ExportedSymbol(
    value.name,
    value.arity,
    value.class,
    value.owner,
    value.has_default,
    value.receiver_mutable,
    value.type_parameters,
    value.parameter_types,
    value.return_type,
    value.span,
    append_record_fields(value.record_fields, field),
).

@pure
field_parts(
    values: List[String],
    rest: List[String],
    module_name: String,
    symbols: List[ExportedSymbol],
): InterfaceParse ->
    case {values, symbols} {
        {[owner, name, type_name], [symbol | remaining]}
            where owner == symbol.name and symbol.class == StructDeclaration ->
                parse_symbols(
                    rest,
                    module_name,
                    [append_record_field(
                        symbol,
                        ExportedStructField(name, parsed_return_type(type_name)),
                    ) | remaining],
                );
        _ -> invalid_interface("invalid interface struct field record")
    }.

@pure
record_kind(kind: String, tail: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if { kind == "interface" -> header_parts(tail, rest, module_name, symbols); true -> non_header_record(kind, tail, rest, module_name, symbols) }.

@pure
record_parts(values: List[String], rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    case values { [kind | tail] -> record_kind(kind, tail, rest, module_name, symbols); [] -> invalid_interface("invalid interface catalog record") }.

@pure
parse_line(line: String, rest: List[String], module_name: String, symbols: List[ExportedSymbol]): InterfaceParse ->
    if { String.trim(line) == "" -> parse_symbols(rest, module_name, symbols); true -> record_parts(String.split(line, "\t"), rest, module_name, symbols) }.

@pure
parse_symbols(
    lines: List[String],
    module_name: String,
    symbols: List[ExportedSymbol],
): InterfaceParse ->
    case lines {
        [] -> finished_interface(module_name, symbols);
        [line | rest] -> parse_line(line, rest, module_name, symbols)
    }.

@pure
parse(source: String): InterfaceParse ->
    parse_symbols(String.split(source, "\n"), "", List.new[ExportedSymbol]()).

/** Decodes an in-memory v5 catalog, retaining explicit v3/v4 compatibility. */
@pure
pub decode(source: String): Option[ModuleInterface] ->
    let parsed = parse(source);
    if { parsed.valid -> Some(parsed.interface); true -> None }.

write_rendered_interface(output: String, rendered: String): Bool ->
    case File.write_text(output, rendered) {
        Err(_error) -> false;
        Ok(_unit) -> true
    }.

write_compiled_interface(output: String, valid: Bool, interface: ModuleInterface): Bool ->
    if { not valid -> false; true -> write_rendered_interface(output, render(interface)) }.

write_interface_source(source: String, output: String): Bool ->
    let lexed = CanonicalLexer.lex(source);
    let frontend = ProjectedFrontend.compile(source, lexed.tokens);
    write_compiled_interface(output, lexed.valid and frontend.valid, frontend.backend.interface).

/** Compiles one source and writes its complete public interface artifact. */
pub write_interface(source_path: String, output: String): Bool ->
    case File.read_text(source_path) {
        Err(_error) -> false;
        Ok(source) -> write_interface_source(source, output)
    }.

@pure
semantic_diagnostics(values: List[SemanticDiagnostic]): List[String] ->
    case values {
        [] -> List.new[String]();
        [value | rest] -> [String.concat([
            value.symbol_name,
            "\t",
            Int.to_string(value.span.start_byte),
            "\t",
            Int.to_string(value.span.end_byte),
            "\t",
            value.message,
            "\n",
        ]) | semantic_diagnostics(rest)]
    }.

/** Reports why the canonical compiler cannot emit one source interface. */
pub canonical_diagnostic(source_path: String): String ->
    case File.read_text(source_path) {
        Err(_error) -> "cannot read canonical interface source";
        Ok(source) ->
            let analyzed = CompilerPipeline.analyze(source);
            if {
                analyzed.valid -> "valid";
                not List.is_empty(analyzed.diagnostics) -> String.concat(
                    semantic_diagnostics(analyzed.diagnostics),
                );
                true -> "canonical compiler rejected source without a diagnostic"
            }
    }.

read_interface_source(path: String, source: String, rest: List[String], interfaces: List[ModuleInterface]): InterfaceCatalog ->
    let parsed = parse(source);
    if { not parsed.valid -> InterfaceCatalog(false, List.new[ModuleInterface](), String.concat([String.trim(path), ": ", parsed.message])); true -> read_interfaces(rest, [parsed.interface | interfaces]) }.

read_interface_file(path: String, rest: List[String], interfaces: List[ModuleInterface]): InterfaceCatalog ->
    case File.read_text(String.trim(path)) {
        Err(_error) -> InterfaceCatalog(false, List.new[ModuleInterface](), String.concat(["cannot read interface artifact: ", String.trim(path)]));
        Ok(source) -> read_interface_source(path, source, rest, interfaces)
    }.

read_interface_path(path: String, rest: List[String], interfaces: List[ModuleInterface]): InterfaceCatalog ->
    if { String.trim(path) == "" -> read_interfaces(rest, interfaces); true -> read_interface_file(path, rest, interfaces) }.

read_interfaces(
    paths: List[String],
    interfaces: List[ModuleInterface],
): InterfaceCatalog ->
    case paths {
        [] -> InterfaceCatalog(true, reverse(interfaces), "");
        [path | rest] -> read_interface_path(path, rest, interfaces)
    }.

/** Loads a deterministic newline-delimited manifest of interface artifacts. */
pub load(manifest: String): InterfaceCatalog ->
    case File.read_text(manifest) {
        Err(_error) -> InterfaceCatalog(false, List.new[ModuleInterface](), "cannot read interface manifest");
        Ok(paths) -> read_interfaces(String.split(paths, "\n"), List.new[ModuleInterface]())
    }.

@pure
diagnostics_text(values: List[String]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.concat([value, "\n", diagnostics_text(rest)])
    }.

write_failure(diagnostics_output: String, message: String): Bool ->
    case File.write_text(diagnostics_output, String.concat([message, "\n"])) {
        Err(_error) -> false;
        Ok(_unit) -> false
    }.

write_empty_diagnostics(diagnostics_output: String): Bool ->
    case File.write_text(diagnostics_output, "") {
        Err(_error) -> false;
        Ok(_unit) -> true
    }.

write_envelope(output: String, diagnostics_output: String, json: String): Bool ->
    case File.write_text(output, json) {
        Err(_error) -> write_failure(diagnostics_output, "cannot write ABI-1 envelope");
        Ok(_unit) -> write_empty_diagnostics(diagnostics_output)
    }.

write_backend_json(output: String, diagnostics_output: String, value: Option[String]): Bool ->
    case value {
        None -> write_failure(diagnostics_output, "backend emitted no ABI-1 envelope");
        Some(json) -> write_envelope(output, diagnostics_output, json)
    }.

write_backend_diagnostics(diagnostics_output: String, diagnostic_text: String): Bool ->
    case File.write_text(diagnostics_output, diagnostic_text) {
        Err(_error) -> false;
        Ok(_unit) -> false
    }.

write_diagnostic_result(diagnostics: List[String], json: Option[String], output: String, diagnostics_output: String): Bool ->
    if { not List.is_empty(diagnostics) -> write_backend_diagnostics(diagnostics_output, diagnostics_text(diagnostics)); true -> write_backend_json(output, diagnostics_output, json) }.

write_frontend_result(frontend_valid: Bool, frontend_message: String, diagnostics: List[String], json: Option[String], output: String, diagnostics_output: String): Bool ->
    if { not frontend_valid -> write_failure(diagnostics_output, String.concat(["projected frontend rejected backend source: ", frontend_message])); true -> write_diagnostic_result(diagnostics, json, output, diagnostics_output) }.

write_backend_result(lex_valid: Bool, frontend_valid: Bool, frontend_message: String, diagnostics: List[String], json: Option[String], output: String, diagnostics_output: String): Bool ->
    if { not lex_valid -> write_failure(diagnostics_output, "canonical lexer rejected backend source"); true -> write_frontend_result(frontend_valid, frontend_message, diagnostics, json, output, diagnostics_output) }.

write_backend_source(source: String, interfaces: List[ModuleInterface], output: String, diagnostics_output: String): Bool ->
    let lexed = CanonicalLexer.lex(source);
    let frontend = ProjectedFrontend.compile(source, lexed.tokens);
    let backend = ProjectedCoreBackendCompile.compile(frontend, interfaces, "terlan-vm");
    write_backend_result(lexed.valid, frontend.valid, frontend.message, backend.diagnostics, backend.json, output, diagnostics_output).

read_backend_source(source_path: String, interfaces: List[ModuleInterface], output: String, diagnostics_output: String): Bool ->
    case File.read_text(source_path) {
        Err(_error) -> write_failure(diagnostics_output, "cannot read backend source");
        Ok(source) -> write_backend_source(source, interfaces, output, diagnostics_output)
    }.

/** Compiles one source against a persistent complete-closure interface set. */
pub write_backend_catalog(
    source_path: String,
    catalog: InterfaceCatalog,
    output: String,
    diagnostics_output: String,
): Bool ->
    if {
        not catalog.valid -> write_failure(diagnostics_output, catalog.message);
        true -> read_backend_source(source_path, catalog.interfaces, output, diagnostics_output)
    }.

/** Loads a catalog once for a single-unit compatibility entry point. */
pub write_backend(
    source_path: String,
    interface_manifest: String,
    output: String,
    diagnostics_output: String,
): Bool ->
    write_backend_catalog(source_path, load(interface_manifest), output, diagnostics_output).

write_optimizer_artifacts_source(
    source: String,
    interfaces: List[ModuleInterface],
    target: String,
    output: String,
): Bool ->
    let lexed = CanonicalLexer.lex(source);
    let frontend = ProjectedFrontend.compile(source, lexed.tokens);
    if {
        not lexed.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(
            output,
            "canonical lexer rejected optimizer source",
        );
        not frontend.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(
            output,
            String.concat(["projected frontend rejected optimizer source: ", frontend.message]),
        );
        true -> SelfHostCoreOptimizeArtifactTool.write(
            output,
            ProjectedCoreBackendCompile.compile_optimizer_artifacts(
                frontend,
                interfaces,
                target,
            ),
        )
    }.

read_optimizer_artifacts_source(
    source_path: String,
    interfaces: List[ModuleInterface],
    output: String,
): Bool ->
    case File.read_text(source_path) {
        Err(_error) -> SelfHostCoreOptimizeArtifactTool.write_failure(
            output,
            "cannot read optimizer source",
        );
        Ok(source) -> write_optimizer_artifacts_source(source, interfaces, "terlan-vm", output)
    }.

write_cross_target_source(
    source: String,
    interfaces: List[ModuleInterface],
    target_a: String,
    target_b: String,
    output: String,
): Bool ->
    let lexed = CanonicalLexer.lex(source);
    let frontend = ProjectedFrontend.compile(source, lexed.tokens);
    if {
        not lexed.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(
            output,
            "canonical lexer rejected cross-target optimizer source",
        );
        not frontend.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(
            output,
            String.concat(["projected frontend rejected cross-target optimizer source: ", frontend.message]),
        );
        true -> SelfHostCoreOptimizeArtifactTool.write_cross_target(
            output,
            target_a,
            target_b,
            ProjectedCoreBackendCompile.compile_optimizer_artifacts(
                frontend,
                interfaces,
                target_a,
            ),
            ProjectedCoreBackendCompile.compile_optimizer_artifacts(
                frontend,
                interfaces,
                target_b,
            ),
        )
    }.

/** Proves optimizer output is unchanged across two distinct target requests. */
pub write_optimizer_cross_target(
    source_path: String,
    interface_manifest: String,
    target_a: String,
    target_b: String,
    output: String,
): Bool ->
    let catalog = load(interface_manifest);
    if {
        not catalog.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(output, catalog.message);
        true -> case File.read_text(source_path) {
            Err(_error) -> SelfHostCoreOptimizeArtifactTool.write_failure(
                output,
                "cannot read cross-target optimizer source",
            );
            Ok(source) -> write_cross_target_source(
                source,
                catalog.interfaces,
                target_a,
                target_b,
                output,
            )
        }
    }.

/** Materializes validated pre/post optimizer Core artifacts from one source unit. */
pub write_optimizer_artifacts(
    source_path: String,
    interface_manifest: String,
    output: String,
): Bool ->
    let catalog = load(interface_manifest);
    if {
        not catalog.valid -> SelfHostCoreOptimizeArtifactTool.write_failure(output, catalog.message);
        true -> read_optimizer_artifacts_source(source_path, catalog.interfaces, output)
    }.
