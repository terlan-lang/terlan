/** Filesystem and JSON adapter for self-hosted bootstrap fixed-point comparison. */
module self_host.SelfHostBootstrapTool.



import self_host.SelfHostBootstrapParity.
import self_host.SelfHostBootstrapParity.{BootstrapArtifact}.
import std.core.Option.{None, Option, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{String}.
import std.data.Json.
import std.io.File.

import type std.data.Json.Json.

string_value(value: Json): Option[String] ->
    case value.as_string() {
        Ok(text) -> if { text == "" -> None; true -> Some(text) };
        Err(_reason) -> None
    }.

string_field(document: Json, name: String): Option[String] ->
    case document.get(name) {
        Err(_reason) -> None;
        Ok(value) -> string_value(value)
    }.

decode_backend(document: Json, module_name: String, token_digest: String, syntax_digest: String, semantic_digest: String, actor_digest: String): Option[BootstrapArtifact] ->
    case string_field(document, "backend_digest") {
        Some(backend_digest) -> Some(BootstrapArtifact(module_name, token_digest, syntax_digest, semantic_digest, actor_digest, backend_digest));
        None -> None
    }.

decode_actor(document: Json, module_name: String, token_digest: String, syntax_digest: String, semantic_digest: String): Option[BootstrapArtifact] ->
    case string_field(document, "actor_digest") {
        Some(actor_digest) -> decode_backend(document, module_name, token_digest, syntax_digest, semantic_digest, actor_digest);
        None -> None
    }.

decode_semantic(document: Json, module_name: String, token_digest: String, syntax_digest: String): Option[BootstrapArtifact] ->
    case string_field(document, "semantic_digest") {
        Some(semantic_digest) -> decode_actor(document, module_name, token_digest, syntax_digest, semantic_digest);
        None -> None
    }.

decode_syntax(document: Json, module_name: String, token_digest: String): Option[BootstrapArtifact] ->
    case string_field(document, "syntax_digest") {
        Some(syntax_digest) -> decode_semantic(document, module_name, token_digest, syntax_digest);
        None -> None
    }.

decode_token(document: Json, module_name: String): Option[BootstrapArtifact] ->
    case string_field(document, "token_digest") {
        Some(token_digest) -> decode_syntax(document, module_name, token_digest);
        None -> None
    }.

decode_document(document: Json): Option[BootstrapArtifact] ->
    case string_field(document, "module_name") {
        Some(module_name) -> decode_token(document, module_name);
        None -> None
    }.

decode(text: String): Option[BootstrapArtifact] ->
    case Json.parse(text) {
        Err(_reason) -> None;
        Ok(document) -> decode_document(document)
    }.

read(path: String): Option[BootstrapArtifact] ->
    case File.read_text(path) {
        Err(_reason) -> None;
        Ok(text) -> decode(text)
    }.

marker_text(fixed_point: Bool): String ->
    if { fixed_point -> "fixed-point\n"; true -> "not-fixed-point\n" }.

write_marker(marker: String, fixed_point: Bool): Bool ->
    case File.write_text(marker, marker_text(fixed_point)) {
        Ok(_unit) -> fixed_point;
        Err(_reason) -> false
    }.

compare_candidate(left: BootstrapArtifact, candidate: Option[BootstrapArtifact], marker: String): Bool ->
    case candidate {
        Some(right) -> let parity = SelfHostBootstrapParity.compare(left, right);
            write_marker(marker, parity.fixed_point);
        None -> write_marker(marker, false)
    }.

compare_reference(left: Option[BootstrapArtifact], candidate: String, marker: String): Bool ->
    case left {
        Some(value) -> compare_candidate(value, read(candidate), marker);
        None -> write_marker(marker, false)
    }.

/** Writes an exact marker only when every bootstrap stage digest is equal. */
pub compare_files(reference: String, candidate: String, marker: String): Bool ->
    compare_reference(read(reference), candidate, marker).

compare_generation_candidate(stage0: BootstrapArtifact, stage1: BootstrapArtifact, stage2: Option[BootstrapArtifact], marker: String): Bool ->
    case stage2 {
        Some(value) -> write_marker(marker, converged(stage0, stage1, value));
        None -> write_marker(marker, false)
    }.

/** Returns true only when both consecutive bootstrap transitions are stable. */
@pure
pub converged(stage0: BootstrapArtifact, stage1: BootstrapArtifact, stage2: BootstrapArtifact): Bool ->
    let first = SelfHostBootstrapParity.compare(stage0, stage1);
    let second = SelfHostBootstrapParity.compare(stage1, stage2);
    first.fixed_point and second.fixed_point.

compare_generation_stage1(stage0: BootstrapArtifact, stage1: Option[BootstrapArtifact], stage2: String, marker: String): Bool ->
    case stage1 {
        Some(value) -> compare_generation_candidate(stage0, value, read(stage2), marker);
        None -> write_marker(marker, false)
    }.

compare_generation_stage0(stage0: Option[BootstrapArtifact], stage1: String, stage2: String, marker: String): Bool ->
    case stage0 {
        Some(value) -> compare_generation_stage1(value, read(stage1), stage2, marker);
        None -> write_marker(marker, false)
    }.

/** Requires two consecutive normalized bootstrap transitions to be stable. */
pub compare_generations(stage0: String, stage1: String, stage2: String, marker: String): Bool ->
    compare_generation_stage0(read(stage0), stage1, stage2, marker).
