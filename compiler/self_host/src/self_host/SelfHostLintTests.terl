/** Normalized test lint authority for TL0401-TL0404. */
module self_host.SelfHostLintTests.

import std.core.String.

pub struct FakeTestFinding {
    start_byte: Int,
    message: String,
}.

pub constructor FakeTestFinding {
    (start_byte: Int, message: String): FakeTestFinding ->
        FakeTestFinding { start_byte: start_byte, message: message }
}.

pub struct TestDeclaration {
    name: String,
    start_byte: Int,
    is_test: Bool,
    assertion_count: Int,
    assert_equal_count: Int,
    has_property_runner: Bool,
    fake_findings: List[FakeTestFinding],
}.

pub constructor TestDeclaration {
    (name: String, start_byte: Int, is_test: Bool, assertion_count: Int, assert_equal_count: Int, has_property_runner: Bool, fake_findings: List[FakeTestFinding]): TestDeclaration ->
        TestDeclaration {
            name: name,
            start_byte: start_byte,
            is_test: is_test,
            assertion_count: assertion_count,
            assert_equal_count: assert_equal_count,
            has_property_runner: has_property_runner,
            fake_findings: fake_findings,
        }
}.

pub struct TestDiagnostic {
    path: String,
    line: Int,
    column: Int,
    rule_id: String,
    rule_name: String,
    severity: String,
    message: String,
    fix_available: Bool,
}.

pub constructor TestDiagnostic {
    (path: String, line: Int, column: Int, rule_id: String, rule_name: String, severity: String, message: String, fix_available: Bool): TestDiagnostic ->
        TestDiagnostic {
            path: path,
            line: line,
            column: column,
            rule_id: rule_id,
            rule_name: rule_name,
            severity: severity,
            message: message,
            fix_available: fix_available,
        }
}.

last(values: List[String], value: String): String ->
    case values { [] -> value; [next | rest] -> last(rest, next) }.

pub test_source_path(path: String): Bool ->
    let filename = last(String.split(path, "/"), "");
    String.ends_with(filename, "Test.terl") or String.ends_with(filename, "Test.terli").

pub declaration_only_name(name: String): Bool ->
    name == "surface_is_declared"
        or name == "generated_surface_is_declared"
        or name == "is_declared"
        or String.ends_with(name, "_is_declared")
        or String.ends_with(name, "_surface_is_declared").

pub property_candidate_name(name: String): Bool ->
    String.contains(name, "roundtrip")
        or String.contains(name, "round_trip")
        or String.contains(name, "parse_render")
        or String.contains(name, "render_parse")
        or String.contains(name, "serialize")
        or String.contains(name, "deserialize")
        or String.contains(name, "serialization")
        or String.contains(name, "invariant")
        or (String.contains(name, "parse") and String.contains(name, "to_string"))
        or (
            String.contains(name, "ordering")
                and (
                    String.contains(name, "law")
                        or String.contains(name, "transitive")
                        or String.contains(name, "antisymmetric")
                        or String.contains(name, "reflexive")
                        or String.contains(name, "total")
                )
        ).

pub property_runner(name: String, remote: String): Bool ->
    (
        name == "for_all"
            or name == "for_all_limit"
            or name == "report"
            or name == "run_report"
            or name == "step_report"
            or name == "shrink_failure"
            or name == "shrink_report"
    ) and (remote == "" or remote == "std.test.Gen").

struct SourcePosition {
    line: Int,
    column: Int,
}.

constructor SourcePosition {
    (line: Int, column: Int): SourcePosition ->
        SourcePosition { line: line, column: column }
}.

position_at(source: String, target: Int, offset: Int, line: Int, column: Int): SourcePosition ->
    if {
        offset >= target or offset >= String.byte_size(source) -> SourcePosition(line, column);
        String.utf8_byte_at(source, offset) == 10 ->
            position_at(source, target, offset + 1, line + 1, 1);
        true -> position_at(source, target, offset + 1, line, column + 1)
    }.

diagnostic(
    source: String,
    path: String,
    offset: Int,
    rule_id: String,
    rule_name: String,
    severity: String,
    message: String,
): TestDiagnostic ->
    let position = position_at(source, offset, 0, 1, 1);
    TestDiagnostic(
        path, position.line, position.column, rule_id, rule_name,
        severity, message, false,
    ).

append[T](left: List[T], right: List[T]): List[T] ->
    case left { [] -> right; [value | rest] -> [value | append(rest, right)] }.

fake_diagnostics(
    source: String,
    path: String,
    findings: List[FakeTestFinding],
): List[TestDiagnostic] ->
    case findings {
        [] -> [];
        [value | rest] -> [diagnostic(
            source,
            path,
            value.start_byte,
            "TL0401",
            "tests.fake",
            "error",
            value.message,
        ) | fake_diagnostics(source, path, rest)]
    }.

declaration_diagnostics(
    source: String,
    path: String,
    value: TestDeclaration,
): List[TestDiagnostic] ->
    let name_values = if {
        declaration_only_name(value.name) -> [diagnostic(
            source, path, value.start_byte,
            "TL0401", "tests.fake", "error",
            "declaration-only test name does not prove behavior",
        )];
        true -> []
    };
    let volume_values = if {
        value.assertion_count > 3 -> [diagnostic(
            source, path, value.start_byte,
            "TL0402", "tests.assertion-volume", "suggestion",
            "test has too many assertions; split it or use a table-driven test",
        )];
        true -> []
    };
    let table_values = if {
        value.assert_equal_count >= 3 -> [diagnostic(
            source, path, value.start_byte,
            "TL0403", "tests.table-driven-candidate", "suggestion",
            "repeated assert_equal rows should move to a table-driven test",
        )];
        true -> []
    };
    let property_values = if {
        property_candidate_name(value.name) and not value.has_property_runner -> [diagnostic(
            source, path, value.start_byte,
            "TL0404", "tests.property-candidate", "suggestion",
            "property-shaped test should use std.test.Gen property runners",
        )];
        true -> []
    };
    append(
        name_values,
        append(
            volume_values,
            append(
                table_values,
                append(property_values, fake_diagnostics(source, path, value.fake_findings)),
            ),
        ),
    ).

declarations_at(
    source: String,
    path: String,
    declarations: List[TestDeclaration],
): List[TestDiagnostic] ->
    case declarations {
        [] -> [];
        [value | rest] ->
            if {
                not value.is_test -> declarations_at(source, path, rest);
                true -> append(
                    declaration_diagnostics(source, path, value),
                    declarations_at(source, path, rest),
                )
            }
    }.

/** Emits normalized test diagnostics only for `*Test.terl[i]` sources. */
@pure
pub diagnostics(
    path: String,
    source: String,
    declarations: List[TestDeclaration],
): List[TestDiagnostic] ->
    if { test_source_path(path) -> declarations_at(source, path, declarations); true -> [] }.
