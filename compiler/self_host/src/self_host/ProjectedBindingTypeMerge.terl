/**
 * Propagates typed let sources through resolved lexical references.
 */
module self_host.ProjectedBindingTypeMerge.

import self_host.ProjectedBindingSyntax.{BindingReference, BindingResolution}.
import self_host.ProjectedSemanticEventSyntax.{BindingTypeLink}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintResolution}.
import self_host.{ProjectedBindingSyntax, ProjectedSemanticEventSyntax, ProjectedTypeConstraintSyntax}.
import std.collections.{List, Map}.
import std.core.Option.{None, Option, Some}.

import type std.collections.Map.

some_string(value: String): Option[String] ->
    Some(value).

none_string(): Option[String] ->
    None.

normalize_string(value: Option[String]): Option[String] ->
    case value {
        Some(name) -> some_string(name);
        None -> none_string()
    }.

fact_type(byte_offset: Int, index: Map[Int, Option[String]]): Option[String] ->
    case Map.get(index, byte_offset) {
        Some(value) -> normalize_string(value);
        None -> none_string()
    }.

reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

reverse[T](values: List[T]): List[T] ->
    reverse_at(values, List.new[T]()).

reference_offset(key: Int, index: Map[Int, Option[Int]]): Option[Int] ->
    case Map.get(index, key) {
        Some(value) -> value;
        None -> None
    }.

link_offset(key: Int, index: Map[Int, Int]): Option[Int] ->
    Map.get(index, key).

reference_entries(values: List[BindingReference]): List[{Int, Option[Int]}] ->
    case values {
        [] -> List.new[{Int, Option[Int]}]();
        [value | rest] -> [{value.byte_offset, value.declaration_offset} | reference_entries(rest)]
    }.

index_references(values: List[BindingReference]): Map[Int, Option[Int]] ->
    Map.from_entries(reference_entries(reverse(values))).

link_entries(values: List[BindingTypeLink]): List[{Int, Int}] ->
    case values {
        [] -> List.new[{Int, Int}]();
        [value | rest] -> [{value.declaration_offset, value.source_offset} | link_entries(rest)]
    }.

index_links(values: List[BindingTypeLink]): Map[Int, Int] ->
    Map.from_entries(link_entries(reverse(values))).

fact_entries(values: List[InferredTypeFact]): List[{Int, Option[String]}] ->
    case values {
        [] -> List.new[{Int, Option[String]}]();
        [value | rest] -> [{value.byte_offset, value.type_name} | fact_entries(rest)]
    }.

index_facts(values: List[InferredTypeFact]): Map[Int, Option[String]] ->
    Map.from_entries(fact_entries(values)).

resolve_link(
    value: Option[Int],
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        None -> none_string();
        Some(source_offset) -> resolve_type(source_offset, remaining - 1, facts, references, links)
    }.

resolve_reference(
    value: Option[Int],
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        None -> none_string();
        Some(declaration_offset) ->
            case fact_type(declaration_offset, facts) {
                Some(type_name) -> Some(type_name);
                None ->
                    resolve_link(
                        link_offset(declaration_offset, links),
                        remaining,
                        facts,
                        references,
                        links,
                    )
            }
    }.

outer_fact_type_at(
    values: List[InferredTypeFact],
    byte_offset: Int,
    best_node_id: Int,
    current: Option[String],
): Option[String] ->
    case values {
        [] -> current;
        [value | rest] ->
            if {
                value.byte_offset == byte_offset
                    and value.node_id >= 0
                    and value.type_name != None
                    and (best_node_id < 0 or value.node_id < best_node_id) -> outer_fact_type_at(rest, byte_offset, value.node_id, value.type_name);
                true -> outer_fact_type_at(rest, byte_offset, best_node_id, current)
            }
    }.

linked_source_offset(
    byte_offset: Int,
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[Int] ->
    case link_offset(byte_offset, links) {
        Some(source_offset) where source_offset != byte_offset -> Some(source_offset);
        _ ->
            when {
                Some(declaration_offset) <- reference_offset(byte_offset, references);
                Some(source_offset) <- link_offset(declaration_offset, links);
                true <- source_offset != declaration_offset
            } else {
                _ -> None
            };
            Some(source_offset)
    }.

source_link_fact(
    value: InferredTypeFact,
    all: List[InferredTypeFact],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): InferredTypeFact ->
    if {
        has_more_specific_fact(value, all) -> value;
        true -> when {
            Some(source_offset) <- linked_source_offset(value.byte_offset, references, links);
            Some(type_name) <- outer_fact_type_at(all, source_offset, -1, None)
        } else {
            _ -> value
        };
        InferredTypeFact(value.node_id, Some(type_name), value.byte_offset)
    }.

source_link_facts(
    values: List[InferredTypeFact],
    all: List[InferredTypeFact],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): List[InferredTypeFact] ->
    case values {
        [] -> List.new[InferredTypeFact]();
        [value | rest] ->
            [source_link_fact(value, all, references, links) | source_link_facts(rest, all, references, links)]
    }.

resolve_fact(
    value: Option[String],
    byte_offset: Int,
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        Some(name) -> some_string(name);
        None ->
            resolve_reference(
                reference_offset(byte_offset, references),
                remaining,
                facts,
                references,
                links,
            )
    }.

resolve_type(
    byte_offset: Int,
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    if {
        remaining <= 0 -> none_string();
        true -> resolve_fact(
            fact_type(byte_offset, facts),
            byte_offset,
            remaining,
            facts,
            references,
            links,
        )
    }.

reverse_facts(
    values: List[InferredTypeFact],
    output: List[InferredTypeFact],
): List[InferredTypeFact] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_facts(rest, [value | output])
    }.

has_more_specific_fact(value: InferredTypeFact, values: List[InferredTypeFact]): Bool ->
    case values {
        [] -> false;
        [candidate | rest] ->
            if {
                candidate.byte_offset == value.byte_offset and candidate.node_id > value.node_id -> true;
                true -> has_more_specific_fact(value, rest)
            }
    }.

merged_type(
    value: InferredTypeFact,
    all_facts: List[InferredTypeFact],
    all: Map[Int, Option[String]],
    depth: Int,
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case reference_offset(value.byte_offset, references) {
        Some(declaration_offset) where not has_more_specific_fact(value, all_facts) ->
            normalize_string(
                resolve_reference(Some(declaration_offset), depth, all, references, links),
            );
        _ ->
            case value.type_name {
                Some(name) -> some_string(name);
                None ->
                    if {
                        has_more_specific_fact(value, all_facts) -> none_string();
                        true -> normalize_string(
                            resolve_type(value.byte_offset, depth, all, references, links),
                        )
                    }
            }
    }.

merge_facts(
    values: List[InferredTypeFact],
    all_facts: List[InferredTypeFact],
    all: Map[Int, Option[String]],
    depth: Int,
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
    output: List[InferredTypeFact],
): List[InferredTypeFact] ->
    case values {
        [] -> reverse_facts(output, List.new[InferredTypeFact]());
        [value | rest] ->
            let type_name = merged_type(value, all_facts, all, depth, references, links);
            merge_facts(
                rest,
                all_facts,
                all,
                depth,
                references,
                links,
                [InferredTypeFact(node_id = value.node_id, type_name = type_name, byte_offset = value.byte_offset) | output],
            )
    }.

pub merge(
    types: TypeConstraintResolution,
    bindings: BindingResolution,
    links: List[BindingTypeLink],
): TypeConstraintResolution ->
    let references = index_references(bindings.references);
    let links_by_declaration = index_links(links);
    let facts_by_offset = index_facts(types.facts);
    TypeConstraintResolution(
        facts = merge_facts(
            types.facts,
            types.facts,
            facts_by_offset,
            types.facts.length(),
            references,
            links_by_declaration,
            List.new[InferredTypeFact](),
        ),
        diagnostics = types.diagnostics,
    ).

/**
 * Propagates authoritative initializer types through non-self lexical links.
 */
pub merge_source_links(
    types: TypeConstraintResolution,
    bindings: BindingResolution,
    links: List[BindingTypeLink],
): TypeConstraintResolution ->
    let references = index_references(bindings.references);
    let links_by_declaration = index_links(links);
    TypeConstraintResolution(
        source_link_facts(types.facts, types.facts, references, links_by_declaration),
        types.diagnostics,
    ).
