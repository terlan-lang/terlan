/**
 * Propagates typed let sources through resolved lexical references.
 */
module self_host.ProjectedBindingTypeMerge.



import std.core.Option.{None, Option, Some}.
import std.collections.List.
import std.collections.Map.
import type std.collections.Map.
import self_host.ProjectedBindingSyntax.
import self_host.ProjectedBindingSyntax.{BindingReference, BindingResolution}.
import self_host.ProjectedSemanticEventSyntax.
import self_host.ProjectedSemanticEventSyntax.{BindingTypeLink}.
import self_host.ProjectedTypeConstraintSyntax.

import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintResolution}.

some_string(value: String): Option[String] -> Some(value).

none_string(): Option[String] -> None.

normalize_string(value: Option[String]): Option[String] ->
    case value {
        Some(name) -> some_string(name);
        None -> none_string()
    }.

fact_type(byte_offset: Int, index: Map[Int, Option[String]]): Option[String] ->
    case Map.get(index, byte_offset) {
        Some(value) -> normalize_string(value);
        None -> none_string()
    }.

reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

reference_offset(key: Int, index: Map[Int, Option[Int]]): Option[Int] ->
    case Map.get(index, key) {
        Some(value) -> value;
        None -> None
    }.

link_offset(key: Int, index: Map[Int, Int]): Option[Int] ->
    Map.get(index, key).

reference_entries(values: List[BindingReference]): List[{Int, Option[Int]}] ->
    case values {
        [] -> List.new[{Int, Option[Int]}]();
        [value | rest] -> [
            {value.byte_offset, value.declaration_offset}
            | reference_entries(rest)
        ]
    }.

index_references(values: List[BindingReference]): Map[Int, Option[Int]] ->
    Map.from_entries(reference_entries(reverse(values))).

link_entries(values: List[BindingTypeLink]): List[{Int, Int}] ->
    case values {
        [] -> List.new[{Int, Int}]();
        [value | rest] -> [
            {value.declaration_offset, value.source_offset}
            | link_entries(rest)
        ]
    }.

index_links(values: List[BindingTypeLink]): Map[Int, Int] ->
    Map.from_entries(link_entries(reverse(values))).

fact_entries(values: List[InferredTypeFact]): List[{Int, Option[String]}] ->
    case values {
        [] -> List.new[{Int, Option[String]}]();
        [value | rest] -> [
            {value.byte_offset, value.type_name}
            | fact_entries(rest)
        ]
    }.

index_facts(values: List[InferredTypeFact]): Map[Int, Option[String]] ->
    Map.from_entries(fact_entries(reverse(values))).

resolve_link(
    value: Option[Int],
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        None -> none_string();
        Some(source_offset) -> resolve_type(source_offset, remaining - 1, facts, references, links)
    }.

resolve_reference(
    value: Option[Int],
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        None -> none_string();
        Some(declaration_offset) -> resolve_link(
            link_offset(declaration_offset, links),
            remaining,
            facts,
            references,
            links,
        )
    }.

resolve_fact(
    value: Option[String],
    byte_offset: Int,
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value {
        Some(name) -> some_string(name);
        None -> resolve_reference(reference_offset(byte_offset, references), remaining, facts, references, links)
    }.

resolve_type(
    byte_offset: Int,
    remaining: Int,
    facts: Map[Int, Option[String]],
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    if {
        remaining <= 0 -> none_string();
        true -> resolve_fact(fact_type(byte_offset, facts), byte_offset, remaining, facts, references, links)
    }.

reverse_facts(values: List[InferredTypeFact], output: List[InferredTypeFact]): List[InferredTypeFact] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_facts(rest, [value | output])
    }.

merged_type(
    value: InferredTypeFact,
    all: Map[Int, Option[String]],
    depth: Int,
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
): Option[String] ->
    case value.type_name {
        Some(name) -> some_string(name);
        None -> normalize_string(resolve_type(value.byte_offset, depth, all, references, links))
    }.

merge_facts(
    values: List[InferredTypeFact],
    all: Map[Int, Option[String]],
    depth: Int,
    references: Map[Int, Option[Int]],
    links: Map[Int, Int],
    output: List[InferredTypeFact],
): List[InferredTypeFact] ->
    case values {
        [] -> reverse_facts(output, List.new[InferredTypeFact]());
        [value | rest] -> let type_name = merged_type(value, all, depth, references, links);
        merge_facts(rest, all, depth, references, links, [InferredTypeFact(
            node_id = value.node_id,
            type_name = type_name,
            byte_offset = value.byte_offset,
        ) | output])
    }.

pub merge(
    types: TypeConstraintResolution,
    bindings: BindingResolution,
    links: List[BindingTypeLink],
): TypeConstraintResolution ->
    let references = index_references(bindings.references);
    let links_by_declaration = index_links(links);
    let facts_by_offset = index_facts(types.facts);
    TypeConstraintResolution(
        facts = merge_facts(
            types.facts,
            facts_by_offset,
            types.facts.length(),
            references,
            links_by_declaration,
            List.new[InferredTypeFact](),
        ),
        diagnostics = types.diagnostics,
    ).
