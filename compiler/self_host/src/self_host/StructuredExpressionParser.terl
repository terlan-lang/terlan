/** Structured Terlan expressions layered over canonical operator parsing. */
module self_host.StructuredExpressionParser.


import std.core.Option.{None, Option, Some}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode, ProjectedExpressionResult}.
import self_host.ProjectionSyntax.{ProjectedCanonicalToken}.


import std.collections.List.
import std.core.{Int, String}.
import self_host.ProjectedExpressionParser.
import self_host.ProjectedPatternParser.


struct TokenSplit {
    found: Bool,
    left: List[ProjectedCanonicalToken],
    separator: Option[ProjectedCanonicalToken],
    right: List[ProjectedCanonicalToken],
}.

constructor TokenSplit {
    (found: Bool, left: List[ProjectedCanonicalToken], separator: Option[ProjectedCanonicalToken], right: List[ProjectedCanonicalToken]): TokenSplit ->
        TokenSplit {
            found: found,
            left: left,
            separator: separator,
            right: right,
        }
}.

struct GroupSlice {
    valid: Bool,
    inner: List[ProjectedCanonicalToken],
    close: Option[ProjectedCanonicalToken],
    rest: List[ProjectedCanonicalToken],
}.

constructor GroupSlice {
    (valid: Bool, inner: List[ProjectedCanonicalToken], close: Option[ProjectedCanonicalToken], rest: List[ProjectedCanonicalToken]): GroupSlice ->
        GroupSlice {
            valid: valid,
            inner: inner,
            close: close,
            rest: rest,
        }
}.

struct ClauseParse {
    valid: Bool,
    nodes: List[ProjectedExpressionNode],
    message: String,
}.

constructor ClauseParse {
    (valid: Bool, nodes: List[ProjectedExpressionNode], message: String): ClauseParse ->
        ClauseParse {
            valid: valid,
            nodes: nodes,
            message: message,
        }
}.

struct QualifierParse {
    valid: Bool,
    has_generator: Bool,
    nodes: List[ProjectedExpressionNode],
    message: String,
}.

constructor QualifierParse {
    (valid: Bool, has_generator: Bool, nodes: List[ProjectedExpressionNode], message: String): QualifierParse ->
        QualifierParse {
            valid: valid,
            has_generator: has_generator,
            nodes: nodes,
            message: message,
        }
}.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
append[T](left: List[T], right: List[T]): List[T] ->
    case left { [] -> right; [value | rest] -> [value | append(rest, right)] }.

@pure
append_nodes(
    left: List[ProjectedExpressionNode],
    right: List[ProjectedExpressionNode],
): List[ProjectedExpressionNode] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append_nodes(rest, right)]
    }.

@pure
split_at(
    values: List[ProjectedCanonicalToken],
    delimiter: String,
    parens: Int,
    brackets: Int,
    braces: Int,
    output: List[ProjectedCanonicalToken],
): TokenSplit ->
    case values {
        [] -> TokenSplit(found = false, left = reverse(output), separator = None, right = List.new[ProjectedCanonicalToken]());
        [value | rest]
            where value.text == delimiter and parens == 0 and brackets == 0 and braces == 0 -> TokenSplit(found = true, left = reverse(output), separator = Some(value), right = rest);
        [value | rest] -> split_at(
            rest,
            delimiter,
            if { value.text == "(" -> parens + 1; value.text == ")" -> parens - 1; true -> parens },
            if { value.text == "[" -> brackets + 1; value.text == "]" -> brackets - 1; true -> brackets },
            if { value.text == "{" -> braces + 1; value.text == "}" -> braces - 1; true -> braces },
            [value | output],
        )
    }.

@pure
split(values: List[ProjectedCanonicalToken], delimiter: String): TokenSplit ->
    split_at(values, delimiter, 0, 0, 0, List.new[ProjectedCanonicalToken]()).

@pure
split_case_block_at(
    values: List[ProjectedCanonicalToken],
    parens: Int,
    brackets: Int,
    braces: Int,
    output: List[ProjectedCanonicalToken],
): TokenSplit ->
    case values {
        [] -> TokenSplit(found = false, left = reverse(output), separator = None, right = List.new[ProjectedCanonicalToken]());
        [value | rest]
            where value.text == "{"
                and value.terminal != "string"
                and value.terminal != "atom"
                and parens == 0
                and brackets == 0
                and braces == 0
                and output != [] ->
            TokenSplit(found = true, left = reverse(output), separator = Some(value), right = rest);
        [value | rest] -> split_case_block_at(
            rest,
            if { value.text == "(" -> parens + 1; value.text == ")" -> parens - 1; true -> parens },
            if { value.text == "[" -> brackets + 1; value.text == "]" -> brackets - 1; true -> brackets },
            if { value.text == "{" -> braces + 1; value.text == "}" -> braces - 1; true -> braces },
            [value | output],
        )
    }.

@pure
split_case_block(values: List[ProjectedCanonicalToken]): TokenSplit ->
    split_case_block_at(values, 0, 0, 0, List.new[ProjectedCanonicalToken]()).

@pure
split_terminal_at(
    values: List[ProjectedCanonicalToken],
    delimiter: String,
    parens: Int,
    brackets: Int,
    braces: Int,
    output: List[ProjectedCanonicalToken],
): TokenSplit ->
    case values {
        [] -> TokenSplit(found = false, left = reverse(output), separator = None, right = List.new[ProjectedCanonicalToken]());
        [value | rest]
            where value.terminal == delimiter and parens == 0 and brackets == 0 and braces == 0 -> TokenSplit(found = true, left = reverse(output), separator = Some(value), right = rest);
        [value | rest] -> split_terminal_at(
            rest,
            delimiter,
            if { value.text == "(" -> parens + 1; value.text == ")" -> parens - 1; true -> parens },
            if { value.text == "[" -> brackets + 1; value.text == "]" -> brackets - 1; true -> brackets },
            if { value.text == "{" -> braces + 1; value.text == "}" -> braces - 1; true -> braces },
            [value | output],
        )
    }.

@pure
split_terminal(values: List[ProjectedCanonicalToken], delimiter: String): TokenSplit ->
    split_terminal_at(values, delimiter, 0, 0, 0, List.new[ProjectedCanonicalToken]()).

@pure
group_at(
    values: List[ProjectedCanonicalToken],
    close_text: String,
    depth: Int,
    output: List[ProjectedCanonicalToken],
): GroupSlice ->
    case values {
        [] -> GroupSlice(valid = false, inner = reverse(output), close = None, rest = List.new[ProjectedCanonicalToken]());
        [value | rest] where value.text == close_text and depth == 1 -> GroupSlice(valid = true, inner = reverse(output), close = Some(value), rest = rest);
        [value | rest] -> group_at(
            rest,
            close_text,
            if {
                value.text == "(" or value.text == "[" or value.text == "{" -> depth + 1;
                value.text == ")" or value.text == "]" or value.text == "}" -> depth - 1;
                true -> depth
            },
            [value | output],
        )
    }.

@pure
group(opening: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): GroupSlice ->
    group_at(
        values,
        if { opening.text == "(" -> ")"; opening.text == "[" -> "]"; true -> "}" },
        1,
        List.new[ProjectedCanonicalToken](),
    ).

@pure
node(
    kind: String,
    text: String,
    start_byte: Int,
    end_byte: Int,
    children: List[ProjectedExpressionNode],
): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, text, start_byte, end_byte, children).

@pure
token_nodes(values: List[ProjectedCanonicalToken]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] -> [node(
            "pattern-token",
            value.text,
            value.start_byte,
            value.end_byte,
            List.new[ProjectedExpressionNode](),
        ) | token_nodes(rest)]
    }.

@pure
pattern_children(values: List[ProjectedCanonicalToken]): List[ProjectedExpressionNode] ->
    case ProjectedPatternParser.parse(values).node {
        Some(value) where value.kind == "patterns" -> value.children;
        Some(value) -> [value];
        None -> List.new[ProjectedExpressionNode]()
    }.

@pure
pattern_node(values: List[ProjectedCanonicalToken], start_byte: Int, end_byte: Int): ProjectedExpressionNode ->
    case ProjectedPatternParser.parse(values).node {
        Some(value) -> value;
        None -> node("pattern", "", start_byte, end_byte, List.new[ProjectedExpressionNode]())
    }.

@pure
first_token_start(values: List[ProjectedCanonicalToken], fallback: Int): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> fallback }.

@pure
last_end(values: List[ProjectedExpressionNode], fallback: Int): Int ->
    case values {
        [] -> fallback;
        [value] -> value.end_byte;
        [_value | rest] -> last_end(rest, fallback)
    }.

@pure
first_start(values: List[ProjectedExpressionNode], fallback: Int): Int ->
    case values { [first | _rest] -> first.start_byte; [] -> fallback }.

@pure
invalid(values: List[ProjectedCanonicalToken], message: String): ProjectedExpressionResult ->
    ProjectedExpressionResult(false, None, values, message).

@pure
clause(
    values: List[ProjectedCanonicalToken],
    pattern: Bool,
): ProjectedExpressionResult ->
    let arrow = split(values, "->");
    if {
        not arrow.found -> invalid(values, "structured clause is missing ->");
        true ->
            let body = parse(arrow.right);
            let left = if {
                pattern -> ProjectedPatternParser.parse(arrow.left).node;
                true -> parse(arrow.left).node
            };
            case {left, body.node} {
                {Some(left_node), Some(body_node)} -> ProjectedExpressionResult(body.valid, Some(node(
                        "clause",
                        "->",
                        left_node.start_byte,
                        body_node.end_byte,
                        [left_node, body_node],
                    )), body.rest, body.message);
                _ -> invalid(values, "structured clause is invalid")
            }
    }.

@pure
clauses_at(
    values: List[ProjectedCanonicalToken],
    pattern: Bool,
    contextual: Bool,
    output: List[ProjectedExpressionNode],
): ClauseParse ->
    if {
        values == [] -> ClauseParse(valid = true, nodes = reverse(output), message = "");
        true ->
            let separator = if {
                contextual -> split_terminal(values, "if-clause-semicolon");
                true -> split(values, ";")
            };
            let current = clause(separator.left, pattern);
            case current.node {
                None -> ClauseParse(valid = false, nodes = reverse(output), message = current.message);
                Some(value) where separator.found -> clauses_at(separator.right, pattern, contextual, [value | output]);
                Some(value) -> ClauseParse(valid = current.valid, nodes = reverse([value | output]), message = current.message)
            }
    }.

@pure
parse_if(keyword: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case values {
        [opening | rest] where opening.text == "{" ->
            let slice = group(opening, rest);
            let parsed = clauses_at(slice.inner, false, true, List.new[ProjectedExpressionNode]());
            case slice.close {
                Some(close) -> ProjectedExpressionResult(slice.valid and parsed.valid, Some(node("if", "if", keyword.start_byte, close.end_byte, parsed.nodes)), slice.rest, parsed.message);
                None -> invalid(values, "if expression is missing its closing brace")
            };
        _ -> invalid(values, "if expression is missing its clause block")
    }.

@pure
parse_case(keyword: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let before_block = split_case_block(values);
    case before_block.separator {
        Some(opening) ->
            let subject = parse(before_block.left);
            let slice = group(opening, before_block.right);
            let parsed = clauses_at(slice.inner, true, true, List.new[ProjectedExpressionNode]());
            case {subject.node, slice.close} {
                {Some(subject_node), Some(close)} -> ProjectedExpressionResult(subject.valid and slice.valid and parsed.valid, Some(node(
                        "case",
                        "case",
                        keyword.start_byte,
                        close.end_byte,
                        [subject_node | parsed.nodes],
                    )), slice.rest, if { not subject.valid -> subject.message; true -> parsed.message });
                _ -> invalid(values, "case expression is invalid")
            };
        None -> invalid(values, "case expression is missing its clause block")
    }.

@pure
section(kind: String, values: List[ProjectedExpressionNode], fallback: Int): ProjectedExpressionNode ->
    node(
        kind,
        "",
        first_start(values, fallback),
        last_end(values, fallback),
        values,
    ).

@pure
after_section_nodes(
    value: Option[ProjectedExpressionNode],
    fallback: Int,
): List[ProjectedExpressionNode] ->
    case value {
        Some(after_node) -> [section("after-clause", [after_node], fallback)];
        None -> List.new[ProjectedExpressionNode]()
    }.

@pure
parse_try(keyword: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let before_block = split(values, "{");
    case before_block.separator {
        None -> invalid(values, "try expression is missing its handler block");
        Some(opening) ->
            let body = parse(before_block.left);
            let slice = group(opening, before_block.right);
            let catch_split = split(slice.inner, "catch");
            let after_source = if { catch_split.found -> catch_split.right; true -> slice.inner };
            let after_split = split(after_source, "after");
            let success_tokens = if {
                catch_split.found -> catch_split.left;
                true -> after_split.left
            };
            let catch_tokens = if {
                catch_split.found -> after_split.left;
                true -> List.new[ProjectedCanonicalToken]()
            };
            let success = clauses_at(success_tokens, true, false, List.new[ProjectedExpressionNode]());
            let catches = clauses_at(catch_tokens, true, false, List.new[ProjectedExpressionNode]());
            let after_clause = if {
                after_split.found -> clause(after_split.right, false);
                true -> ProjectedExpressionResult(true, None, List.new[ProjectedCanonicalToken](), "")
            };
            case {body.node, slice.close} {
                {Some(body_node), Some(close)} ->
                    let success_section = section("success-clauses", success.nodes, opening.end_byte);
                    let catch_section = section("catch-clauses", catches.nodes, opening.end_byte);
                    let handler_nodes = [success_section, catch_section];
                    let after_nodes = after_section_nodes(after_clause.node, opening.end_byte);
                    let children = append_nodes([body_node | handler_nodes], after_nodes);
                    let try_node = node(
                        "try",
                        "try",
                        keyword.start_byte,
                        close.end_byte,
                        children,
                    );
                    ProjectedExpressionResult(body.valid
                            and slice.valid
                            and success.valid
                            and catches.valid
                            and after_clause.valid, Some(try_node), slice.rest, if {
                            not body.valid -> body.message;
                            not success.valid -> success.message;
                            not catches.valid -> catches.message;
                            true -> after_clause.message
                        });
                _ -> invalid(values, "try expression is invalid")
            }
    }.

@pure
parse_lambda(opening: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let parameters = group(opening, values);
    case {parameters.close, parameters.rest} {
        {Some(_close), [arrow | body_tokens]} where arrow.text == "->" ->
            let body = parse(body_tokens);
            case body.node {
                Some(body_node) ->
                    let children = pattern_children(parameters.inner);
                    let parameters_node = node(
                        "parameters",
                        "",
                        opening.start_byte,
                        arrow.start_byte,
                        children,
                    );
                    let lambda_node = node(
                        "lambda",
                        "->",
                        opening.start_byte,
                        body_node.end_byte,
                        [parameters_node, body_node],
                    );
                    ProjectedExpressionResult(parameters.valid and body.valid, Some(lambda_node), body.rest, body.message);
                None -> invalid(values, "lambda body is invalid")
            };
        _ -> invalid(values, "lambda is missing -> body")
    }.

@pure
bindings_at(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
): ClauseParse ->
    if {
        values == [] -> ClauseParse(valid = output != [], nodes = reverse(output), message = if { output == [] -> "refutable let group requires at least one binding"; true -> "" });
        true ->
            let separator = split(values, ";");
            let binding = qualifier(separator.left);
            let is_refutable = split(separator.left, "<-").found;
            case binding.node {
                Some(value) where is_refutable and separator.found -> bindings_at(
                    separator.right,
                    [node("binding", "<-", value.start_byte, value.end_byte, value.children) | output],
                );
                Some(value) where is_refutable -> ClauseParse(valid = binding.valid, nodes = reverse([node(
                        "binding",
                        "<-",
                        value.start_byte,
                        value.end_byte,
                        value.children,
                    ) | output]), message = binding.message);
                _ -> ClauseParse(valid = false, nodes = reverse(output), message = "refutable let binding is missing <-")
            }
    }.

@pure
parse_fallback(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case values {
        [else_token | [opening | rest]] where else_token.text == "else" and opening.text == "{" ->
            let slice = group(opening, rest);
            let parsed = clauses_at(slice.inner, true, false, List.new[ProjectedExpressionNode]());
            case slice.close {
                Some(close) where parsed.nodes != [] -> ProjectedExpressionResult(slice.valid and parsed.valid, Some(node(
                        "fallback",
                        "else",
                        else_token.start_byte,
                        close.end_byte,
                        parsed.nodes,
                    )), slice.rest, parsed.message);
                Some(_close) -> invalid(values, "let else requires at least one fallback clause");
                None -> invalid(values, "let else fallback is missing }")
            };
        _ -> invalid(values, "refutable let requires an else fallback")
    }.

@pure
parse_refutable_tail(
    keyword: ProjectedCanonicalToken,
    bindings: List[ProjectedExpressionNode],
    fallback_source: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    let fallback = parse_fallback(fallback_source);
    case {fallback.node, fallback.rest} {
        {Some(fallback_node), [separator | continuation_tokens]} where separator.text == ";" ->
            let continuation = parse(continuation_tokens);
            case continuation.node {
                Some(continuation_node) ->
                    let children = append_nodes(bindings, [fallback_node, continuation_node]);
                    let refutable_node = node(
                        "let-refutable",
                        "let",
                        keyword.start_byte,
                        continuation_node.end_byte,
                        children,
                    );
                    ProjectedExpressionResult(fallback.valid and continuation.valid, Some(refutable_node), continuation.rest, continuation.message);
                None -> invalid(fallback_source, "refutable let continuation is invalid")
            };
        {Some(_fallback), _} -> invalid(fallback_source, "refutable let is missing continuation separator");
        _ -> fallback
    }.

@pure
parse_refutable_group(
    keyword: ProjectedCanonicalToken,
    opening: ProjectedCanonicalToken,
    values: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    let group_slice = group(opening, values);
    let bindings = bindings_at(group_slice.inner, List.new[ProjectedExpressionNode]());
    if {
        not group_slice.valid -> invalid(values, "refutable let binding group is missing }");
        not bindings.valid -> invalid(values, bindings.message);
        true -> parse_refutable_tail(keyword, bindings.nodes, group_slice.rest)
    }.

@pure
parse_refutable_single(
    keyword: ProjectedCanonicalToken,
    values: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    let binding_source = split(values, "<-");
    let fallback_split = split(binding_source.right, "else");
    if {
        not binding_source.found -> invalid(values, "refutable let binding is missing <-");
        not fallback_split.found -> invalid(values, "refutable let requires an else fallback");
        true ->
            let source = parse(fallback_split.left);
            case {source.node, fallback_split.separator} {
                {Some(source_node), Some(else_token)} ->
                    let binding_pattern = pattern_node(binding_source.left, keyword.end_byte, source_node.start_byte);
                    let binding_node = node(
                        "binding",
                        "<-",
                        keyword.end_byte,
                        source_node.end_byte,
                        [binding_pattern, source_node],
                    );
                    parse_refutable_tail(
                        keyword,
                        [binding_node],
                        [else_token | fallback_split.right],
                    );
                _ -> invalid(values, "refutable let source is invalid")
            }
    }.

@pure
parse_let(keyword: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    case values {
        [opening | rest] where opening.text == "{" ->
            let grouped = group(opening, rest);
            case grouped.rest {
                [next | _] where next.text == "else" -> parse_refutable_group(keyword, opening, rest);
                _ ->
                    let assignment = split(values, "=");
                    if {
                        not assignment.found -> invalid(values, "let expression is missing =");
                        true -> parse_ordinary_let(keyword, assignment)
                    }
            };
        _ ->
            let refutable = split(values, "<-");
            if {
                refutable.found -> parse_refutable_single(keyword, values);
                true ->
                    let assignment = split(values, "=");
                    if {
                        not assignment.found -> invalid(values, "let expression is missing =");
                        true -> parse_ordinary_let(keyword, assignment)
                    }
            }
    }.

@pure
parse_ordinary_let(keyword: ProjectedCanonicalToken, assignment: TokenSplit): ProjectedExpressionResult ->
            let separator = split(assignment.right, ";");
            let bound = parse(separator.left);
            let continuation = if {
                separator.found -> parse(separator.right);
                true -> invalid(separator.right, "let expression is missing its continuation")
            };
            case {bound.node, continuation.node} {
                {Some(bound_node), Some(continuation_node)} ->
                    let binding_pattern = pattern_node(assignment.left, keyword.end_byte, bound_node.start_byte);
                    let let_node = node(
                        "let",
                        "let",
                        keyword.start_byte,
                        continuation_node.end_byte,
                        [binding_pattern, bound_node, continuation_node],
                    );
                    ProjectedExpressionResult(bound.valid and continuation.valid, Some(let_node), continuation.rest, if { not bound.valid -> bound.message; true -> continuation.message });
                _ -> invalid(assignment.right, "let expression is invalid")
            }.

@pure
parse_sequence(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let separator = split(values, ";");
    if {
        not separator.found -> ProjectedExpressionParser.parse(values);
        true ->
            let first = parse(separator.left);
            let following = parse(separator.right);
            case {first.node, following.node} {
                {Some(first_node), Some(next_node)} ->
                    let sequence_node = node(
                        "sequence",
                        ";",
                        first_node.start_byte,
                        next_node.end_byte,
                        [first_node, next_node],
                    );
                    ProjectedExpressionResult(first.valid and following.valid, Some(sequence_node), following.rest, if { not first.valid -> first.message; true -> following.message });
                _ -> invalid(values, "expression sequence is invalid")
            }
    }.

@pure
qualifier(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let generator = split(values, "<-");
    if {
        generator.found ->
            let source = parse(generator.right);
            case source.node {
                Some(source_node) ->
                    let generator_pattern = pattern_node(generator.left, source_node.start_byte, source_node.start_byte);
                    let generator_node = node(
                        "generator",
                        "<-",
                        first_token_start(generator.left, source_node.start_byte),
                        source_node.end_byte,
                        [generator_pattern, source_node],
                    );
                    ProjectedExpressionResult(source.valid, Some(generator_node), source.rest, source.message);
                None -> invalid(values, "comprehension generator source is invalid")
            };
        true ->
            let filter = parse(values);
            case filter.node {
                Some(filter_node) ->
                    let filter_result_node = node(
                        "filter",
                        "",
                        filter_node.start_byte,
                        filter_node.end_byte,
                        [filter_node],
                    );
                    ProjectedExpressionResult(filter.valid, Some(filter_result_node), filter.rest, filter.message);
                None -> filter
            }
    }.

@pure
qualifiers_at(
    values: List[ProjectedCanonicalToken],
    output: List[ProjectedExpressionNode],
    has_generator: Bool,
): QualifierParse ->
    if {
        values == [] ->
            let ordered = reverse(output);
            QualifierParse(valid = true, has_generator = has_generator, nodes = ordered, message = "");
        true ->
            let comma = split(values, ",");
            let current = qualifier(comma.left);
            let current_generator = split(comma.left, "<-").found;
            case current.node {
                None ->
                    let ordered = reverse(output);
                    QualifierParse(valid = false, has_generator = has_generator, nodes = ordered, message = current.message);
                Some(value) where comma.found -> qualifiers_at(
                    comma.right,
                    [value | output],
                    has_generator or current_generator,
                );
                Some(value) ->
                    let ordered = reverse([value | output]);
                    QualifierParse(valid = current.valid, has_generator = has_generator or current_generator, nodes = ordered, message = current.message)
            }
    }.

@pure
parse_list_form(opening: ProjectedCanonicalToken, values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let slice = group(opening, values);
    let pipe = split(slice.inner, "|");
    if {
        not slice.valid -> invalid(values, "list expression is missing ]");
        not pipe.found -> ProjectedExpressionParser.parse([opening | values]);
        true ->
            let result = parse(pipe.left);
            let qualifiers = qualifiers_at(pipe.right, List.new[ProjectedExpressionNode](), false);
            case {result.node, slice.close} {
                {Some(result_node), Some(close)} where qualifiers.has_generator -> ProjectedExpressionResult(result.valid and qualifiers.valid, Some(node(
                        "list-comprehension",
                        "|",
                        opening.start_byte,
                        close.end_byte,
                        [result_node | qualifiers.nodes],
                    )), slice.rest, if { not result.valid -> result.message; true -> qualifiers.message });
                {Some(head), Some(close)} ->
                    let tail = parse(pipe.right);
                    case tail.node {
                        Some(tail_node) -> ProjectedExpressionResult(result.valid and tail.valid, Some(node(
                                "list-cons",
                                "|",
                                opening.start_byte,
                                close.end_byte,
                                [head, tail_node],
                            )), slice.rest, if { not result.valid -> result.message; true -> tail.message });
                        None -> invalid(values, "list cons tail is invalid")
                    };
                _ -> invalid(values, "list expression is invalid")
            }
    }.

@pure
parse_macro_call(
    marker: ProjectedCanonicalToken,
    values: List[ProjectedCanonicalToken],
): ProjectedExpressionResult ->
    case values {
        [name | [opening | rest]] where opening.text == "(" ->
            let arguments = group(opening, rest);
            case arguments.close {
                Some(close) -> let children = token_nodes(arguments.inner);
                    ProjectedExpressionResult(arguments.valid, Some(node(
                        "macro-call",
                        name.text,
                        marker.start_byte,
                        close.end_byte,
                        children,
                    )), arguments.rest, if { arguments.valid -> ""; true -> "macro argument list is invalid" });
                None -> invalid(values, "macro call is missing )")
            };
        [name | rest] -> ProjectedExpressionResult(true, Some(node(
                "macro-call",
                name.text,
                marker.start_byte,
                name.end_byte,
                List.new[ProjectedExpressionNode](),
            )), rest, "");
        [] -> invalid(values, "macro marker is missing its name")
    }.

@pure
finish_structured(result: ProjectedExpressionResult): ProjectedExpressionResult ->
    case result.node {
        Some(value) where result.valid and result.rest != [] ->
            ProjectedExpressionParser.continue_from(value, result.rest);
        _ -> result
    }.

/** Parses one structured expression, delegating operator forms to the Pratt parser. */
@pure
pub parse(values: List[ProjectedCanonicalToken]): ProjectedExpressionResult ->
    let initial = case values {
        [keyword | rest] where keyword.text == "let" -> parse_let(keyword, rest);
        [keyword | rest] where keyword.text == "if" -> parse_if(keyword, rest);
        [keyword | rest] where keyword.text == "case" -> parse_case(keyword, rest);
        [keyword | rest] where keyword.text == "try" -> parse_try(keyword, rest);
        [opening | rest] where opening.terminal == "lambda-(" -> parse_lambda(opening, rest);
        [opening | rest] where opening.text == "[" -> parse_list_form(opening, rest);
        [marker | rest] where marker.text == "?" -> parse_macro_call(marker, rest);
        _ -> parse_sequence(values)
    };
    finish_structured(initial).
