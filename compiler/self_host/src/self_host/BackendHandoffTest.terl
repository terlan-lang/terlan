/** Positive and negative end-to-end frontend handoff contracts. */
module self_host.BackendHandoffTest.

import std.core.String.
import std.core.Option.{None, Some}.
import self_host.CanonicalLexer.
import self_host.Compiler.
import self_host.ProjectedBackendEvidence.
import self_host.ProjectedFrontend.

@pure
positive_handoff(): Bool ->
    let result = Compiler.compile(
        "module demo.Backend.\nconst answer: Int = 42.\nvalue(x: Int): Int -> x.\n",
    );
    result.valid
        and result.schema == "terlan.self-host.backend/v1"
        and String.contains(result.text, "module demo.Backend.")
        and String.contains(result.text, "symbol answer.")
        and String.contains(result.text, "symbol value.").

@pure
negative_handoff(): Bool ->
    not Compiler.compile(
        "module demo.Backend.\nstruct User { id: Int }.\ntype User = Int.\n",
    ).valid.

guarded_case_handoff(): Bool ->
    let source = "module demo.Guarded.\npub positive(values: List[Int]): List[Int] -> case values { [] -> []; [value | rest] where value > 0 -> [value | positive(rest)]; [_value | rest] -> positive(rest) }.\n";
    let lexed = CanonicalLexer.lex(source);
    let frontend = ProjectedFrontend.compile(source, lexed.tokens);
    case ProjectedBackendEvidence.document(frontend, "terlan-vm") {
        Some(text) -> frontend.valid and String.contains(text, "root_case_guard_1");
        None -> false
    }.

pub self_test(): Bool -> positive_handoff() and negative_handoff() and guarded_case_handoff().
