/**
 * Propagates case-subject types into refutable pattern bindings before IR lowering.
 */
module self_host.ProjectedPatternBindingTypeMerge.

import self_host.ProjectedBodySyntax.{ProjectedBodies, ProjectedBody}.
import self_host.ProjectedExpressionSyntax.ProjectedExpressionNode.
import self_host.ProjectedPatternAuthority.{PatternAuthorityCatalog, PatternConstructorContract}.
import self_host.ProjectedPatternPayloadTypes.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintDiagnostic, TypeConstraintResolution}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.String.

struct PatternTypeSeed {
    node_id: Int,
    byte_offset: Int,
    type_name: String,
}.

constructor PatternTypeSeed {
    (node_id: Int, byte_offset: Int, type_name: String): PatternTypeSeed ->
        PatternTypeSeed {node_id: node_id, byte_offset: byte_offset, type_name: type_name}
}.

struct PatternScan {
    next_id: Int,
    seeds: List[PatternTypeSeed],
}.

constructor PatternScan {
    (next_id: Int, seeds: List[PatternTypeSeed]): PatternScan ->
        PatternScan {next_id: next_id, seeds: seeds}
}.

append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

node_size(value: ProjectedExpressionNode): Int ->
    1 + nodes_size(value.children).

nodes_size(values: List[ProjectedExpressionNode]): Int ->
    case values {
        [] -> 0;
        [value | rest] -> node_size(value) + nodes_size(rest)
    }.

fact_type(node_id: Int, values: List[InferredTypeFact]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] ->
            if {
                value.node_id == node_id and value.type_name != None -> value.type_name;
                true -> fact_type(node_id, rest)
            }
    }.

last(values: List[String], fallback: String): String ->
    case values {
        [] -> fallback;
        [value | rest] -> last(rest, value)
    }.

type_base(value: String): String ->
    case String.split(value, "[") {
        [base | _rest] -> last(String.split(String.trim(base), "."), "");
        [] -> ""
    }.

list_element_type(value: String): Option[String] ->
    if {
        type_base(value) != "List" or not String.ends_with(value, "]") -> None;
        true -> case String.split(value, "[") {
            [_base, argument] -> Some(argument.utf8_slice(0, argument.byte_size() - 1));
            _ -> None
        }
    }.

find_constructor(
    name: String,
    values: List[PatternConstructorContract],
): Option[PatternConstructorContract] ->
    case values {
        [] -> None;
        [value | rest] ->
            if {
                value.name == name -> Some(value);
                true -> find_constructor(name, rest)
            }
    }.

payload_pattern_seeds(
    patterns: List[ProjectedExpressionNode],
    node_id: Int,
    types: List[Option[String]],
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    case {patterns, types} {
        {[], _} -> [];
        {_, []} -> [];
        {[pattern | pattern_rest], [type_name | type_rest]} ->
            append(
                case type_name {
                    None -> [];
                    Some(name) -> pattern_seeds(pattern, node_id, name, catalog)
                },
                payload_pattern_seeds(
                    pattern_rest,
                    node_id + node_size(pattern),
                    type_rest,
                    catalog,
                ),
            )
    }.

pattern_seeds(
    pattern: ProjectedExpressionNode,
    node_id: Int,
    source_type: String,
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    if {
        pattern.kind == "pattern" -> case pattern.children {
            [child] -> pattern_seeds(child, node_id + 1, source_type, catalog);
            _ -> []
        };
        pattern.kind == "binding-pattern" or pattern.kind == "typed-pattern" -> [PatternTypeSeed(node_id, pattern.start_byte, source_type)];
        pattern.kind == "list-cons-pattern" -> case {pattern.children, list_element_type(source_type)} {
            {[head, tail], Some(element_type)} ->
                append(
                    pattern_seeds(head, node_id + 1, element_type, catalog),
                    pattern_seeds(tail, node_id + 1 + node_size(head), source_type, catalog),
                );
            _ -> []
        };
        pattern.kind == "list-pattern" -> case list_element_type(source_type) {
            None -> [];
            Some(element_type) ->
                pattern_children_seeds(pattern.children, node_id + 1, element_type, catalog)
        };
        pattern.kind == "constructor-pattern" -> case find_constructor(pattern.text, catalog.constructors) {
            None -> [];
            Some(contract) ->
                payload_pattern_seeds(
                    pattern.children,
                    node_id + 1,
                    ProjectedPatternPayloadTypes.instantiate(contract, source_type),
                    catalog,
                )
        };
        true -> []
    }.

pattern_children_seeds(
    values: List[ProjectedExpressionNode],
    node_id: Int,
    source_type: String,
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    case values {
        [] -> [];
        [value | rest] ->
            append(
                pattern_seeds(value, node_id, source_type, catalog),
                pattern_children_seeds(rest, node_id + node_size(value), source_type, catalog),
            )
    }.

clause_seeds(
    clause: ProjectedExpressionNode,
    node_id: Int,
    source_type: String,
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    case clause.children {
        [pattern | _rest] -> pattern_seeds(pattern, node_id + 1, source_type, catalog);
        [] -> []
    }.

clauses_seeds(
    values: List[ProjectedExpressionNode],
    node_id: Int,
    source_type: String,
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    case values {
        [] -> [];
        [value | rest] ->
            append(
                clause_seeds(value, node_id, source_type, catalog),
                clauses_seeds(rest, node_id + node_size(value), source_type, catalog),
            )
    }.

case_seeds(
    value: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    catalog: PatternAuthorityCatalog,
): List[PatternTypeSeed] ->
    if {
        [subject | clauses] <- value.children;
        Some(source_type) <- fact_type(node_id + 1, facts)
    } else {
        _ -> []
    };
    clauses_seeds(clauses, node_id + 1 + node_size(subject), source_type, catalog).

scan_children(
    values: List[ProjectedExpressionNode],
    next_id: Int,
    facts: List[InferredTypeFact],
    catalog: PatternAuthorityCatalog,
): PatternScan ->
    case values {
        [] -> PatternScan(next_id, []);
        [value | rest] ->
            let current = scan_node(value, next_id, facts, catalog);
            let remaining = scan_children(rest, current.next_id, facts, catalog);
            PatternScan(remaining.next_id, append(current.seeds, remaining.seeds))
    }.

scan_node(
    value: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    catalog: PatternAuthorityCatalog,
): PatternScan ->
    let nested = scan_children(value.children, node_id + 1, facts, catalog);
    PatternScan(
        nested.next_id,
        append(
            if {
                value.kind == "case" -> case_seeds(value, node_id, facts, catalog);
                true -> []
            },
            nested.seeds,
        ),
    ).

scan_bodies(
    values: List[ProjectedBody],
    next_id: Int,
    facts: List[InferredTypeFact],
    catalog: PatternAuthorityCatalog,
): PatternScan ->
    case values {
        [] -> PatternScan(next_id, []);
        [value | rest] ->
            case value.expression.node {
                None -> scan_bodies(rest, next_id, facts, catalog);
                Some(node) ->
                    let current = scan_node(node, next_id, facts, catalog);
                    let remaining = scan_bodies(rest, current.next_id, facts, catalog);
                    PatternScan(remaining.next_id, append(current.seeds, remaining.seeds))
            }
    }.

seed_at(node_id: Int, byte_offset: Int, values: List[PatternTypeSeed]): Option[PatternTypeSeed] ->
    case values {
        [] -> None;
        [value | rest] ->
            if {
                value.node_id == node_id or value.byte_offset == byte_offset -> Some(value);
                true -> seed_at(node_id, byte_offset, rest)
            }
    }.

merge_facts(
    values: List[InferredTypeFact],
    seeds: List[PatternTypeSeed],
): List[InferredTypeFact] ->
    case values {
        [] -> [];
        [value | rest] ->
            case seed_at(value.node_id, value.byte_offset, seeds) {
                None -> [value | merge_facts(rest, seeds)];
                Some(seed) ->
                    [InferredTypeFact(value.node_id, Some(seed.type_name), value.byte_offset) | merge_facts(rest, seeds)]
            }
    }.

seed_offset(byte_offset: Int, values: List[PatternTypeSeed]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.byte_offset == byte_offset or seed_offset(byte_offset, rest)
    }.

merge_diagnostics(
    values: List[TypeConstraintDiagnostic],
    seeds: List[PatternTypeSeed],
): List[TypeConstraintDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] ->
            if {
                value.code == "unknown-type-constraint" and seed_offset(value.byte_offset, seeds) -> merge_diagnostics(rest, seeds);
                true -> [value | merge_diagnostics(rest, seeds)]
            }
    }.

/**
 * Adds subject-derived facts for list pattern declarations across all bodies.
 */
pub merge(bodies: ProjectedBodies, value: TypeConstraintResolution): TypeConstraintResolution ->
    merge_with_catalog(bodies, value, PatternAuthorityCatalog([], [])).

/**
 * Adds subject and constructor-payload facts using the visible pattern catalog.
 */
pub merge_with_catalog(
    bodies: ProjectedBodies,
    value: TypeConstraintResolution,
    catalog: PatternAuthorityCatalog,
): TypeConstraintResolution ->
    let seeds = scan_bodies(bodies.values, 0, value.facts, catalog).seeds;
    TypeConstraintResolution(
        merge_facts(value.facts, seeds),
        merge_diagnostics(value.diagnostics, seeds),
    ).
