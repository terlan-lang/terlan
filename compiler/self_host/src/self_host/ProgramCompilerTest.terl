/** End-to-end multi-module frontend contracts. */
module self_host.ProgramCompilerTest.

import self_host.ModuleInterfaceSyntax.{ModuleInterface}.

import std.collections.List.
import self_host.ProgramCompiler.


@pure
local_dependency(): Bool ->
    ProgramCompiler.compile([
        "module demo.Provider.\npub struct User { id: Int }.\n",
        "module demo.Consumer.\nimport type demo.Provider.{User}.\n",
    ], List.new[ModuleInterface]()).valid.

@pure
missing_dependency(): Bool ->
    not ProgramCompiler.compile([
        "module demo.Consumer.\nimport type demo.Missing.{User}.\n",
    ], List.new[ModuleInterface]()).valid.

pub self_test(): Bool -> local_dependency() and missing_dependency().
