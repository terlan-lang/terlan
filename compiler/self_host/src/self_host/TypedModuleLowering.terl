/** Dispatches every surface declaration into the unified typed AST. */
module self_host.TypedModuleLowering.

import self_host.DeclarationSyntax.{DeclarationSyntax, ModuleSyntax}.
import self_host.Syntax.{AnnotationSchemaDeclaration, ConfigDeclaration, ConstFunctionDeclaration, ConstantDeclaration, ConstructorDeclaration, ExportDeclaration, FunctionDeclaration, ImportDeclaration, MethodDeclaration, NativeDeclaration, OpaqueTypeDeclaration, ShapeDeclaration, StructDeclaration, TemplateDeclaration, TraitDeclaration, TraitImplDeclaration, TypeDeclaration}.
import self_host.TypedModuleSyntax.{AnnotationSchemaPayload, ConfigPayload, ConstantPayload, ConstructorPayload, ExportPayload, FunctionPayload, ImportPayload, MethodPayload, NativePayload, ShapePayload, StructPayload, TemplatePayload, TraitImplPayload, TraitPayload, TypePayload, TypedDeclaration, TypedDeclarationPayload, TypedModule, UnsupportedPayload, ValuedUnionPayload}.

import std.collections.List.
import std.core.String.
import self_host.AnnotationSchemaLowering.
import self_host.ConstantLowering.
import self_host.ConfigLowering.
import self_host.ConstructorLowering.
import self_host.DeclarationLowering.
import self_host.DeclarationMetadataLowering.
import self_host.Delimited.
import self_host.FunctionLowering.
import self_host.ExportLowering.
import self_host.ImportLowering.
import self_host.MethodLowering.
import self_host.NativeLowering.
import self_host.Parser.
import self_host.ShapeLowering.
import self_host.StructLowering.
import self_host.TemplateLowering.
import self_host.TraitImplLowering.
import self_host.TraitLowering.
import self_host.TypeDeclarationLowering.
import self_host.ValuedUnionLowering.


@pure
before(value: String, separator: String): String ->
    case String.split(value, separator) { [] -> String.trim(value); [head | _] -> String.trim(head) }.

@pure
without_prefix(value: String, prefix: String): String ->
    if {
        String.starts_with(value, prefix) -> String.trim(value.utf8_slice(prefix.byte_size(), value.byte_size() - prefix.byte_size()));
        true -> value
    }.

@pure
method_name(head: String): String ->
    method_name_parts(String.split(head, ") ")).

@pure
method_name_parts(parts: List[String]): String ->
    case parts {
        [] -> "";
        [_first | rest] -> method_name_tail(rest)
    }.

@pure
method_name_tail(parts: List[String]): String ->
    case parts {
        [] -> "";
        [callable | _rest] -> before(callable, "(")
    }.

/** Returns the source-level symbol introduced by a declaration, if any. */
@pure
pub symbol_name(source: DeclarationSyntax): String ->
    let public_head = Parser.declaration_head(source.body);
    let head = without_prefix(public_head, "pub ");
    symbol_constant(source, head).

@pure
symbol_constant(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == ConstantDeclaration -> before(without_prefix(head, "const "), ":");
        true -> symbol_const_function(source, head)
    }.

@pure
symbol_const_function(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == ConstFunctionDeclaration -> before(without_prefix(head, "const "), "(");
        true -> symbol_function(source, head)
    }.

@pure
symbol_function(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == FunctionDeclaration -> before(head, "(");
        true -> symbol_type(source, head)
    }.

@pure
symbol_type(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == TypeDeclaration -> before(before(before(without_prefix(head, "type "), "["), ":"), "=");
        true -> symbol_opaque_type(source, head)
    }.

@pure
symbol_opaque_type(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == OpaqueTypeDeclaration -> before(before(without_prefix(head, "opaque type "), "["), "=");
        true -> symbol_struct(source, head)
    }.

@pure
symbol_struct(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == StructDeclaration -> before(before(without_prefix(head, "struct "), "["), " ");
        true -> symbol_constructor(source, head)
    }.

@pure
symbol_constructor(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == ConstructorDeclaration -> before(before(without_prefix(head, "constructor "), "["), "(");
        true -> symbol_method(source, head)
    }.

@pure
symbol_method(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == MethodDeclaration -> method_name(head);
        true -> symbol_trait(source, head)
    }.

@pure
symbol_trait(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == TraitDeclaration -> before(before(without_prefix(head, "trait "), "["), " ");
        true -> symbol_annotation(source, head)
    }.

@pure
symbol_annotation(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == AnnotationSchemaDeclaration -> before(before(without_prefix(head, "annotation "), "["), "(");
        true -> symbol_template(source, head)
    }.

@pure
symbol_template(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == TemplateDeclaration -> before(before(without_prefix(head, "template "), "["), "{");
        true -> symbol_shape(source, head)
    }.

@pure
symbol_shape(source: DeclarationSyntax, head: String): String ->
    if {
        source.class == ShapeDeclaration -> before(before(without_prefix(head, "shape "), "["), "(");
        true -> ""
    }.

@pure
semantic_identity(source: DeclarationSyntax): String ->
    if {
        symbol_name(source) == "" -> "";
        true -> String.trim(source.header)
    }.

@pure
is_valued_union(source: DeclarationSyntax): Bool ->
    let colon = Delimited.top_level_byte(source.body, 58);
    let assignment = Delimited.top_level_assignment(source.body);
    colon >= 0 and assignment > colon.

@pure
payload(source: DeclarationSyntax): TypedDeclarationPayload ->
    payload_import(source).

@pure
payload_import(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ImportDeclaration -> ImportPayload(ImportLowering.lower(source));
        true -> payload_config(source)
    }.

@pure
payload_config(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ConfigDeclaration -> ConfigPayload(ConfigLowering.lower(source));
        true -> payload_annotation(source)
    }.

@pure
payload_annotation(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == AnnotationSchemaDeclaration -> AnnotationSchemaPayload(AnnotationSchemaLowering.lower(source));
        true -> payload_export(source)
    }.

@pure
payload_export(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ExportDeclaration -> ExportPayload(ExportLowering.lower(source));
        true -> payload_constant(source)
    }.

@pure
payload_constant(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ConstantDeclaration -> ConstantPayload(ConstantLowering.lower(source));
        true -> payload_const_function(source)
    }.

@pure
payload_const_function(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ConstFunctionDeclaration -> FunctionPayload(FunctionLowering.lower(source));
        true -> payload_function(source)
    }.

@pure
payload_function(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == FunctionDeclaration -> FunctionPayload(FunctionLowering.lower(source));
        true -> payload_type(source)
    }.

@pure
payload_type(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == TypeDeclaration -> payload_type_kind(source);
        true -> payload_opaque_type(source)
    }.

@pure
payload_type_kind(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        is_valued_union(source) -> ValuedUnionPayload(ValuedUnionLowering.lower(source));
        true -> TypePayload(TypeDeclarationLowering.lower(source))
    }.

@pure
payload_opaque_type(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == OpaqueTypeDeclaration -> TypePayload(TypeDeclarationLowering.lower(source));
        true -> payload_struct(source)
    }.

@pure
payload_struct(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == StructDeclaration -> StructPayload(StructLowering.lower(source));
        true -> payload_constructor(source)
    }.

@pure
payload_constructor(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ConstructorDeclaration -> ConstructorPayload(ConstructorLowering.lower(source));
        true -> payload_method(source)
    }.

@pure
payload_method(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == MethodDeclaration -> MethodPayload(MethodLowering.lower(source));
        true -> payload_native(source)
    }.

@pure
payload_native(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == NativeDeclaration -> NativePayload(NativeLowering.lower(source));
        true -> payload_trait(source)
    }.

@pure
payload_trait(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == TraitDeclaration -> TraitPayload(TraitLowering.lower(source));
        true -> payload_trait_impl(source)
    }.

@pure
payload_trait_impl(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == TraitImplDeclaration -> TraitImplPayload(TraitImplLowering.lower(source));
        true -> payload_template(source)
    }.

@pure
payload_template(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == TemplateDeclaration -> TemplatePayload(TemplateLowering.lower(source));
        true -> payload_shape(source)
    }.

@pure
payload_shape(source: DeclarationSyntax): TypedDeclarationPayload ->
    if {
        source.class == ShapeDeclaration -> ShapePayload(ShapeLowering.lower(source));
        true -> UnsupportedPayload(source)
    }.

struct PayloadStatus {
    valid: Bool,
    message: String,
}.

@pure
payload_valid(value: TypedDeclarationPayload): Bool ->
    payload_status(value).valid.

@pure
payload_message(value: TypedDeclarationPayload): String ->
    payload_status(value).message.

@pure
payload_status(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ImportPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_config(value)
    }.

@pure
payload_status_config(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ConfigPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_annotation(value)
    }.

@pure
payload_status_annotation(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        AnnotationSchemaPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_export(value)
    }.

@pure
payload_status_export(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ExportPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_constant(value)
    }.

@pure
payload_status_constant(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ConstantPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_function(value)
    }.

@pure
payload_status_function(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        FunctionPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_type(value)
    }.

@pure
payload_status_type(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        TypePayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_valued_union(value)
    }.

@pure
payload_status_valued_union(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ValuedUnionPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_struct(value)
    }.

@pure
payload_status_struct(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        StructPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_constructor(value)
    }.

@pure
payload_status_constructor(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ConstructorPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_method(value)
    }.

@pure
payload_status_method(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        MethodPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_native(value)
    }.

@pure
payload_status_native(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        NativePayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_trait(value)
    }.

@pure
payload_status_trait(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        TraitPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_trait_impl(value)
    }.

@pure
payload_status_trait_impl(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        TraitImplPayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_template(value)
    }.

@pure
payload_status_template(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        TemplatePayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_shape(value)
    }.

@pure
payload_status_shape(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        ShapePayload(item) -> PayloadStatus(valid = item.valid, message = item.message);
        _ -> payload_status_unsupported(value)
    }.

@pure
payload_status_unsupported(value: TypedDeclarationPayload): PayloadStatus ->
    case value {
        UnsupportedPayload(_item) -> PayloadStatus(valid = false, message = "declaration class is not yet lowered");
        _ -> PayloadStatus(valid = false, message = "declaration class is not yet lowered")
    }.

@pure
declarations_at(values: List[DeclarationSyntax]): List[TypedDeclaration] ->
    case values {
        [] -> List.new[TypedDeclaration]();
        [value | rest] ->
            let prepared = DeclarationMetadataLowering.prepare(value);
            let lowered = payload(prepared.declaration);
            [TypedDeclaration(payload_valid(lowered), lowered, value.class, symbol_name(value), semantic_identity(value), value.is_public, value.body, prepared.metadata.annotations, prepared.metadata.docs, value.span, payload_message(lowered)) | declarations_at(rest)]
    }.

@pure
all_valid(values: List[TypedDeclaration]): Bool ->
    case values { [] -> true; [value | rest] -> value.valid and all_valid(rest) }.

/** Produces the unified typed module from a declaration-level surface module. */
@pure
pub lower(source: ModuleSyntax): TypedModule ->
    let declarations = declarations_at(source.declarations);
    TypedModule(source.valid and all_valid(declarations), source.name, declarations, source.errors).
