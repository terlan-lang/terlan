/** Deterministic UTF-8 lexer implemented entirely in Terlan. */
module self_host.Lexer.

import self_host.Source.{span}.
import self_host.Token.{Identifier, IntegerLiteral, Keyword, LexResult, LexicalError, StringLiteral, Symbol, Token}.

import std.collections.List.
import std.core.Option.{None, Some}.
import std.core.String.


pub struct Take {
    lexeme: String,
    rest: List[String],
    bytes: Int,
}.

pub constructor Take {
    (lexeme: String, rest: List[String], bytes: Int): Take ->
        Take {
            lexeme: lexeme,
            rest: rest,
            bytes: bytes,
        }
}.


pub struct Skip {
    rest: List[String],
    byte: Int,
    line: Int,
    column: Int,
    closed: Bool,
}.

pub constructor Skip {
    (rest: List[String], byte: Int, line: Int, column: Int, closed: Bool): Skip ->
        Skip {
            rest: rest,
            byte: byte,
            line: line,
            column: column,
            closed: closed,
        }
}.


@pure
reverse_tokens(values: List[Token], output: List[Token]): List[Token] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_tokens(rest, [value | output])
    }.

@pure
reverse_errors(values: List[LexicalError], output: List[LexicalError]): List[LexicalError] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_errors(rest, [value | output])
    }.

@pure
point_values(values: std.collections.List.List[Int]): Int ->
    case values.first() {
        Some(value) -> value;
        None -> -1
    }.

@pure
point(character: String): Int -> point_values(character.codepoints()).

@pure
is_ascii_letter(value: Int): Bool ->
    (value >= 65 and value <= 90) or (value >= 97 and value <= 122).

@pure
is_digit(character: String): Bool ->
    let value = point(character);
    value >= 48 and value <= 57.

@pure
is_identifier_start(character: String): Bool ->
    let value = point(character);
    character == "_" or is_ascii_letter(value).

@pure
is_identifier_continue(character: String): Bool ->
    is_identifier_start(character) or is_digit(character).

@pure
is_keyword(value: String): Bool ->
    value == "module"
        or value == "import"
        or value == "type"
        or value == "pub"
        or value == "opaque"
        or value == "struct"
        or value == "trait"
        or value == "impl"
        or value == "constructor"
        or value == "includes"
        or value == "if"
        or value == "case"
        or value == "let"
        or value == "else"
        or value == "true"
        or value == "false"
        or value == "native".

@pure
take_identifier(characters: List[String], value: String, bytes: Int): Take ->
    case characters {
        [] -> Take(value, [], bytes);
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                is_identifier_continue(character) ->
                    take_identifier(
                        rest,
                        String.append(value, character),
                        bytes + width,
                    );
                true -> Take(value, characters, bytes)
            }
    }.

@pure
take_integer(characters: List[String], value: String, bytes: Int): Take ->
    case characters {
        [] -> Take(value, [], bytes);
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                is_digit(character) ->
                    take_integer(rest, String.append(value, character), bytes + width);
                true -> Take(value, characters, bytes)
            }
    }.

@pure
take_string(characters: List[String], bytes: Int, columns: Int, escaped: Bool): Skip ->
    case characters {
        [] -> Skip([], bytes, 0, columns, false);
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                character == "\n" ->
                    Skip(rest, bytes + 1, 1, 1, false);
                character == "\"" and not escaped ->
                    Skip(rest, bytes + width, 0, columns + 1, true);
                character == "\\" and not escaped ->
                    take_string(rest, bytes + width, columns + 1, true);
                true ->
                    take_string(rest, bytes + width, columns + 1, false)
            }
    }.

@pure
skip_line_comment(characters: List[String], byte: Int, line: Int, column: Int): Skip ->
    case characters {
        [] -> Skip([], byte, line, column, true);
        ["\n" | rest] ->
            Skip(rest, byte + 1, line + 1, 1, true);
        [character | rest] ->
            let width = String.byte_size(character);
            skip_line_comment(rest, byte + width, line, column + 1)
    }.

@pure
skip_block_comment(characters: List[String], byte: Int, line: Int, column: Int): Skip ->
    case characters {
        [] -> Skip([], byte, line, column, false);
        ["*" | ["/" | rest]] ->
            Skip(rest, byte + 2, line, column + 2, true);
        ["\n" | rest] -> skip_block_comment(rest, byte + 1, line + 1, 1);
        [character | rest] ->
            let width = String.byte_size(character);
            skip_block_comment(rest, byte + width, line, column + 1)
    }.

@pure
two_character_symbol(first: String, second: String): Bool ->
    (first == "-" and second == ">")
        or (first == "<" and second == "-")
        or (first == "=" and second == "=")
        or (first == "!" and second == "=")
        or (first == "<" and second == "=")
        or (first == ">" and second == "=")
        or (first == ":" and second == ":").

@pure
scan(
    characters: List[String],
    byte: Int,
    line: Int,
    column: Int,
    tokens: List[Token],
    errors: List[LexicalError],
): LexResult ->
    case characters {
        [] ->
            LexResult(reverse_tokens(tokens, []), reverse_errors(errors, []));
        ["\n" | rest] -> scan(rest, byte + 1, line + 1, 1, tokens, errors);
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                character == " " or character == "\t" or character == "\r" ->
                    scan(rest, byte + width, line, column + 1, tokens, errors);
                character == "/" and not List.is_empty(rest) ->
                    scan_slash(characters, byte, line, column, tokens, errors);
                is_identifier_start(character) ->
                    let taken = take_identifier(characters, "", 0);
                    let kind = if {is_keyword(taken.lexeme) -> Keyword; true -> Identifier};
                    scan(
                        taken.rest,
                        byte + taken.bytes,
                        line,
                        column + String.length(taken.lexeme),
                        [
                            Token(kind, taken.lexeme, span(
                                    byte,
                                    byte + taken.bytes,
                                    line,
                                    column,
                                    line,
                                    column + String.length(taken.lexeme),
                                ))
                            | tokens
                        ],
                        errors,
                    );
                is_digit(character) ->
                    let taken = take_integer(characters, "", 0);
                    scan(
                        taken.rest,
                        byte + taken.bytes,
                        line,
                        column + String.length(taken.lexeme),
                        [
                            Token(IntegerLiteral, taken.lexeme, span(byte, byte + taken.bytes, line, column, line, column + String.length(taken.lexeme)))
                            | tokens
                        ],
                        errors,
                    );
                character == "\"" ->
                    let taken = take_string(rest, 1, 1, false);
                    let end_column = column + taken.column;
                    if {
                        taken.closed ->
                            scan(
                                taken.rest,
                                byte + taken.byte,
                                line,
                                end_column,
                                [
                                    Token(StringLiteral, source_slice_string(characters, taken.byte), span(byte, byte + taken.byte, line, column, line, end_column))
                                    | tokens
                                ],
                                errors,
                            );
                        true ->
                            scan(
                                taken.rest,
                                byte + taken.byte,
                                line + taken.line,
                                if {taken.line == 0 -> end_column; true -> taken.column},
                                tokens,
                                [
                                    LexicalError("unterminated_string", "string literal is not terminated", span(byte, byte + taken.byte, line, column, line + taken.line, taken.column))
                                    | errors
                                ],
                            )
                    };
                true -> scan_symbol(characters, byte, line, column, tokens, errors)
            }
    }.

@pure
source_slice_string(characters: List[String], bytes: Int): String ->
    source_slice_string_loop(characters, bytes, "").

@pure
source_slice_string_loop(characters: List[String], bytes: Int, output: String): String ->
    case characters {
        [] -> output;
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                bytes <= 0 -> output;
                true ->
                    source_slice_string_loop(
                        rest,
                        bytes - width,
                        String.append(output, character),
                    )
            }
    }.

@pure
scan_slash(
    characters: List[String],
    byte: Int,
    line: Int,
    column: Int,
    tokens: List[Token],
    errors: List[LexicalError],
): LexResult ->
    case characters {
        ["/" | ["/" | rest]] ->
            let skipped = skip_line_comment(rest, byte + 2, line, column + 2);
            scan(skipped.rest, skipped.byte, skipped.line, skipped.column, tokens, errors);
        ["/" | ["*" | rest]] ->
            let skipped = skip_block_comment(rest, byte + 2, line, column + 2);
            if {
                skipped.closed ->
                    scan(skipped.rest, skipped.byte, skipped.line, skipped.column, tokens, errors);
                true ->
                    scan(
                        skipped.rest,
                        skipped.byte,
                        skipped.line,
                        skipped.column,
                        tokens,
                        [
                            LexicalError("unterminated_comment", "block comment is not terminated", span(byte, skipped.byte, line, column, skipped.line, skipped.column))
                            | errors
                        ],
                    )
            };
        _ -> scan_symbol(characters, byte, line, column, tokens, errors)
    }.

@pure
scan_symbol(
    characters: List[String],
    byte: Int,
    line: Int,
    column: Int,
    tokens: List[Token],
    errors: List[LexicalError],
): LexResult ->
    case characters {
        [first | [second | rest]] ->
            if {
                two_character_symbol(first, second) ->
                    let lexeme = String.append(first, second);
                    scan(
                        rest,
                        byte + 2,
                        line,
                        column + 2,
                        [Token(Symbol, lexeme, span(byte, byte + 2, line, column, line, column + 2)) | tokens],
                        errors,
                    );
                true -> scan_one_symbol(characters, byte, line, column, tokens, errors)
            };
        _ -> scan_one_symbol(characters, byte, line, column, tokens, errors)
    }.

@pure
scan_one_symbol(
    characters: List[String],
    byte: Int,
    line: Int,
    column: Int,
    tokens: List[Token],
    errors: List[LexicalError],
): LexResult ->
    case characters {
        [] -> LexResult(reverse_tokens(tokens, []), reverse_errors(errors, []));
        [character | rest] ->
            let width = String.byte_size(character);
            if {
                String.contains(". , ; : ( ) [ ] { } + - * / = ! < > | @", character) ->
                    scan(
                        rest,
                        byte + width,
                        line,
                        column + 1,
                        [Token(Symbol, character, span(byte, byte + width, line, column, line, column + 1)) | tokens],
                        errors,
                    );
                true ->
                    scan(
                        rest,
                        byte + width,
                        line,
                        column + 1,
                        tokens,
                        [
                            LexicalError("unexpected_character", String.append("unexpected source character: ", character), span(byte, byte + width, line, column, line, column + 1))
                            | errors
                        ],
                    )
            }
    }.

@pure
pub lex(source: String): LexResult ->
    scan(source.characters(), 0, 1, 1, [], []).
