/** Generated-source manifest lint authority for TL0804-TL0806. */
module self_host.SelfHostLintGenerated.

import std.core.String.

pub struct GeneratedDiagnostic {
    path: String,
    line: Int,
    column: Int,
    rule_id: String,
    rule_name: String,
    severity: String,
    message: String,
    fix_available: Bool,
}.

pub constructor GeneratedDiagnostic {
    (path: String, line: Int, column: Int, rule_id: String, rule_name: String, severity: String, message: String, fix_available: Bool): GeneratedDiagnostic ->
        GeneratedDiagnostic {
            path: path,
            line: line,
            column: column,
            rule_id: rule_id,
            rule_name: rule_name,
            severity: severity,
            message: message,
            fix_available: fix_available,
        }
}.

struct MarkerLocation {
    found: Bool,
    line: Int,
    column: Int,
}.

constructor MarkerLocation {
    (found: Bool, line: Int, column: Int): MarkerLocation ->
        MarkerLocation { found: found, line: line, column: column }
}.

generated_marker(line: String): Bool ->
    let lowered = String.lowercase(line);
    String.contains(lowered, "@generated")
        or String.contains(lowered, "generated by")
        or String.contains(lowered, "do not edit")
        or String.contains(lowered, "this file is generated").

first_marker(lines: List[String], line_number: Int): MarkerLocation ->
    case lines {
        [] -> MarkerLocation(false, 0, 0);
        [line | rest] ->
            if {
                generated_marker(line) -> MarkerLocation(
                    true,
                    line_number,
                    String.byte_size(line) - String.byte_size(String.trim_start(line)) + 1,
                );
                true -> first_marker(rest, line_number + 1)
            }
    }.

contains_source_manifest(lines: List[String]): Bool ->
    case lines {
        [] -> false;
        [line | rest] ->
            let lowered = String.lowercase(line);
            if {
                String.contains(lowered, "source-manifest:")
                    or String.contains(lowered, "generated-source:") -> true;
                true -> contains_source_manifest(rest)
            }
    }.

contains_suppression_manifest(lines: List[String]): Bool ->
    case lines {
        [] -> false;
        [line | rest] ->
            let lowered = String.lowercase(line);
            if {
                String.contains(lowered, "lint-suppression-manifest:")
                    or String.contains(lowered, "lint-suppressions:") -> true;
                true -> contains_suppression_manifest(rest)
            }
    }.

contains_skip_manifest(lines: List[String]): Bool ->
    case lines {
        [] -> false;
        [line | rest] ->
            let lowered = String.lowercase(line);
            if {
                String.contains(lowered, "skip-manifest:")
                    or String.contains(lowered, "unsupported-manifest:")
                    or String.contains(lowered, "generated-skips:") -> true;
                true -> contains_skip_manifest(rest)
            }
    }.

inline_suppression(line: String): Bool ->
    let lowered = String.lowercase(line);
    String.contains(lowered, "lint-disable")
        or String.contains(lowered, "terlan-lint-ignore")
        or String.contains(lowered, "nolint")
        or String.contains(lowered, "suppress lint").

unstructured_skip(line: String): Bool ->
    let lowered = String.lowercase(line);
    String.contains(lowered, "unsupported")
        or String.contains(lowered, "skipped")
        or String.contains(lowered, "not generated")
        or String.contains(lowered, "not emitted").

source_manifest(
    path: String,
    lines: List[String],
    marker: MarkerLocation,
): List[GeneratedDiagnostic] ->
    if {
        not marker.found or contains_source_manifest(lines) -> [];
        true -> [GeneratedDiagnostic(
            path,
            marker.line,
            marker.column,
            "TL0804",
            "interop.generated-source-manifest",
            "warning",
            "generated source must include source-manifest metadata",
            false,
        )]
    }.

line_diagnostics(
    path: String,
    lines: List[String],
    line_number: Int,
    suppression: Bool,
): List[GeneratedDiagnostic] ->
    case lines {
        [] -> [];
        [line | rest] ->
            let remaining = line_diagnostics(path, rest, line_number + 1, suppression);
            let matches = if {
                suppression -> inline_suppression(line);
                true -> unstructured_skip(line)
            };
            if {
                not matches -> remaining;
                suppression -> [GeneratedDiagnostic(
                    path,
                    line_number,
                    String.byte_size(line) - String.byte_size(String.trim_start(line)) + 1,
                    "TL0805",
                    "interop.generated-lint-suppression",
                    "warning",
                    "generated lint suppressions must use structured manifest metadata",
                    false,
                ) | remaining];
                true -> [GeneratedDiagnostic(
                    path,
                    line_number,
                    String.byte_size(line) - String.byte_size(String.trim_start(line)) + 1,
                    "TL0806",
                    "interop.generated-skip-manifest",
                    "warning",
                    "generated skipped constructs must use structured skip-manifest metadata",
                    false,
                ) | remaining]
            }
    }.

append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

/** Emits generated manifest rules in public registry order. */
@pure
pub diagnostics(path: String, source: String): List[GeneratedDiagnostic] ->
    let lines = String.split(source, "\n");
    let marker = first_marker(lines, 1);
    let source_values = source_manifest(path, lines, marker);
    let suppression_values = if {
        not marker.found or contains_suppression_manifest(lines) -> [];
        true -> line_diagnostics(path, lines, 1, true)
    };
    let skip_values = if {
        not marker.found or contains_skip_manifest(lines) -> [];
        true -> line_diagnostics(path, lines, 1, false)
    };
    append(source_values, append(suppression_values, skip_values)).
