/**
 * Lowers embedded if/case control flow into semantic block plans.
 */
module self_host.ProjectedEmbeddedControlIrPlan.

import self_host.ProjectedExpressionIrPlan.{lower_expression, matching_plan_result_type}.
import self_host.ProjectedExpressionSupportIrPlan.{ExpressionPlan, concat_blocks, concat_instructions, expression_type, node_size, register, resolved_or_dynamic, shallow_pattern_bindings, shallow_pattern_operands, shallow_pattern_supported, some_string}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedLocalSemanticSyntax.{LocalSemanticResult}.
import self_host.ProjectedNestedControlIrPlan.{ExpressionNodePair, ExpressionNodeQuad, ExpressionNodeTriple, expression_node_pair, expression_node_quad, expression_node_triple, linear_binding}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact}.
import self_host.SelfHostIrSyntax.{IrParameter}.
import self_host.SelfHostSemanticIrSyntax.{SemanticBlockPlan, SemanticInstructionPlan, SemanticTerminatorPlan}.
import self_host.{ProjectedExpressionSyntax, ProjectedNestedControlIrPlan, ProjectedTypeConstraintSyntax, SelfHostIrSyntax, SelfHostSemanticIrSyntax}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Bool, Int, String}.

pub struct EmbeddedBranchPlan {
    blocks: List[SemanticBlockPlan],
    result: String,
    exit_label: String,
}.

pub constructor EmbeddedBranchPlan {
    (blocks: List[SemanticBlockPlan], result: String, exit_label: String): EmbeddedBranchPlan ->
        EmbeddedBranchPlan {blocks: blocks, result: result, exit_label: exit_label}
}.

embedded_label(prefix: String, suffix: String): String ->
    String.append(prefix, suffix).

embedded_if_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case node.children {
        [first_clause, second_clause] ->
            embedded_if_two_direct_clauses(
                [first_clause.children, second_clause.children],
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
                first_clause,
            );
        _ -> None
    }.

embedded_if_two_direct_clauses(
    values: List[List[ProjectedExpressionNode]],
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    first_clause: ProjectedExpressionNode,
): Option[EmbeddedBranchPlan] ->
    case values {
        [first_values, second_values] ->
            embedded_if_two_direct_first(
                expression_node_pair(first_values),
                expression_node_pair(second_values),
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
                first_clause,
            );
        _ -> None
    }.

embedded_if_two_direct_first(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    first_clause: ProjectedExpressionNode,
): Option[EmbeddedBranchPlan] ->
    case first {
        Some(parts) ->
            embedded_if_two_direct_second(
                parts,
                second,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
                first_clause,
            );
        _ -> None
    }.

embedded_if_two_direct_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    first_clause: ProjectedExpressionNode,
): Option[EmbeddedBranchPlan] ->
    case second {
        Some(parts) ->
            embedded_if_two_direct_value(
                first,
                parts,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
                first_clause,
            );
        _ -> None
    }.

embedded_if_two_direct_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    first_clause: ProjectedExpressionNode,
): Option[EmbeddedBranchPlan] ->
    Some(
        embedded_if_two_blocks(
            node,
            node_id,
            first_clause,
            first.first,
            first.second,
            second.first,
            second.second,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        ),
    ).

embedded_if_two_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_id = second_condition_id + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_condition_label = embedded_label(label_prefix, "condition_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let result = register(node_id);
    let result_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            resolved_or_dynamic(expression_type(node, facts, parameters)),
        );
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, first_condition_plan.instructions),
                SemanticTerminatorPlan(
                    "branch",
                    [first_condition_plan.result],
                    [first_body_label, second_condition_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                first_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_condition_label,
                second_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [second_condition_plan.result],
                    [second_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                second_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_if_three_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case expression_node_triple(node.children) {
        Some(clauses) ->
            embedded_if_three_direct_clauses(
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

embedded_if_three_direct_clauses(
    clauses: ExpressionNodeTriple,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    embedded_if_three_direct_first(
        expression_node_pair(clauses.first.children),
        expression_node_pair(clauses.second.children),
        expression_node_pair(clauses.third.children),
        clauses,
        node,
        node_id,
        entry_label,
        label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ).

embedded_if_three_direct_first(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case first {
        Some(parts) ->
            embedded_if_three_direct_second(
                parts,
                second,
                third,
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

embedded_if_three_direct_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case second {
        Some(parts) ->
            embedded_if_three_direct_third(
                first,
                parts,
                third,
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

embedded_if_three_direct_third(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case third {
        Some(parts) ->
            embedded_if_three_direct_value(
                first,
                second,
                parts,
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

embedded_if_three_direct_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: ExpressionNodePair,
    clauses: ExpressionNodeTriple,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    Some(
        embedded_if_three_blocks(
            node,
            node_id,
            clauses.first,
            clauses.second,
            first.first,
            first.second,
            second.first,
            second.second,
            third.first,
            third.second,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        ),
    ).

embedded_if_three_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_condition: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_id = second_condition_id + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let third_id = second_id + node_size(second);
    let third_condition_id = third_id + 1;
    let third_condition_plan = lower_expression(third_condition, third_condition_id, facts, parameters);
    let third_body_id = third_condition_id + node_size(third_condition);
    let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_condition_label = embedded_label(label_prefix, "condition_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let third_condition_label = embedded_label(label_prefix, "condition_2");
    let third_body_label = embedded_label(label_prefix, "body_2");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let result = register(node_id);
    let fallback_type = resolved_or_dynamic(expression_type(node, facts, parameters));
    let first_two_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            fallback_type,
        );
    let result_type = matching_plan_result_type(first_two_type, third_body_plan.result_type, fallback_type);
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, first_condition_plan.instructions),
                SemanticTerminatorPlan(
                    "branch",
                    [first_condition_plan.result],
                    [first_body_label, second_condition_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                first_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_condition_label,
                second_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [second_condition_plan.result],
                    [second_body_label, third_condition_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                second_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                third_condition_label,
                third_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [third_condition_plan.result],
                    [third_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                third_body_label,
                third_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                            third_body_label,
                            third_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_if_four_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case expression_node_quad(node.children) {
        Some(clauses) ->
            embedded_if_four_direct_clauses(
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

embedded_if_four_direct_clauses(
    clauses: ExpressionNodeQuad,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    embedded_if_four_direct_first(
        expression_node_pair(clauses.first.children),
        expression_node_pair(clauses.second.children),
        expression_node_pair(clauses.third.children),
        expression_node_pair(clauses.fourth.children),
        clauses,
        node,
        node_id,
        entry_label,
        label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ).

embedded_if_four_direct_first(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    fourth: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case first {
        Some(parts) ->
            embedded_if_four_direct_second(
                parts,
                second,
                third,
                fourth,
                clauses,
                node,
                node_id,
                entry_label,
                label_prefix,
                entry_instructions,
                join_target,
                facts,
                parameters,
            );
        _ -> None
    }.

