/** Positive and negative token-driven declaration boundary contracts. */
module self_host.TokenSegmenterTest.

import std.collections.List.
import self_host.CanonicalLexer.
import self_host.TokenContext.
import self_host.TokenSegmenter.

@pure
positive_boundaries(): Bool ->
    let source = "module app.Main.\nimport std.core.Option.{Some}.\npub name(user: User): String -> user.name.\npub trait Named { name(value: User): String -> value.name. }.\n";
    let segmented = TokenSegmenter.split(TokenContext.project(CanonicalLexer.lex(source).tokens));
    segmented.valid and List.length(segmented.segments) == 4.

@pure
negative_unterminated(): Bool ->
    let source = "module app.Main.\npub name(user: User): String -> user.name\n";
    let segmented = TokenSegmenter.split(TokenContext.project(CanonicalLexer.lex(source).tokens));
    not segmented.valid and segmented.unterminated_start_byte > 0.

pub self_test(): Bool -> positive_boundaries() and negative_unterminated().

