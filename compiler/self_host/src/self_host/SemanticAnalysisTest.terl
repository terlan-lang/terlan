/** Positive and negative semantic-analysis contracts. */
module self_host.SemanticAnalysisTest.

import std.core.String.
import self_host.CompilerPipeline.

@pure
positive_module(): Bool ->
    CompilerPipeline.analyze(
        "module demo.Semantic.\nconst answer: Int = 42.\nvalue(x: Int): Int -> x.\n",
    ).valid.

@pure
duplicate_module(): Bool ->
    not CompilerPipeline.analyze(
        "module demo.Semantic.\nstruct User { id: Int }.\ntype User = Int.\n",
    ).valid.

@pure
duplicate_callable(): Bool ->
    not CompilerPipeline.analyze(
        "module demo.Semantic.\nvalue(x: Int): Int -> x.\nvalue(other: Int): Int -> other.\n",
    ).valid.

@pure
distinct_callable_overloads(): Bool ->
    CompilerPipeline.analyze(
        "module demo.Semantic.\nvalue(x: Int): Int -> x.\nvalue(text: String): Int -> text.byte_size().\n",
    ).valid.

@pure
distinct_callable_returns(): Bool ->
    CompilerPipeline.analyze(
        "module demo.Semantic.\nvalue(x: Int): Int -> x.\nvalue(other: Int): String -> Int.to_string(other).\n",
    ).valid.

@pure
valid_local_trait_impl(): Bool ->
    CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct User { name: String }.\n",
            "trait Named { name(value: User): String. }.\n",
            "impl Named for User { name(value: User): String -> value.name. }.\n",
        ]),
    ).valid.

@pure
valid_inherited_trait_impl(): Bool ->
    CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct Box[A] { value: A }.\n",
            "trait Parent[F[_]] { inherited[A](value: F[A]): F[A]. }.\n",
            "trait Child[F[_]] extends Parent[F] { own[A](value: F[A]): F[A]. }.\n",
            "impl Child[Box] for Box { ",
            "inherited(value: Box[A]): Box[A] -> value; ",
            "own(value: Box[A]): Box[A] -> value. ",
            "}.\n",
        ]),
    ).valid.

@pure
missing_inherited_trait_method(): Bool ->
    not CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct Box[A] { value: A }.\n",
            "trait Parent[F[_]] { inherited[A](value: F[A]): F[A]. }.\n",
            "trait Child[F[_]] extends Parent[F] { own[A](value: F[A]): F[A]. }.\n",
            "impl Child[Box] for Box { own(value: Box[A]): Box[A] -> value. }.\n",
        ]),
    ).valid.

@pure
missing_trait_method(): Bool ->
    not CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct User { name: String }.\n",
            "trait Named { name(value: User): String. }.\n",
            "impl Named for User { }.\n",
        ]),
    ).valid.

@pure
incompatible_trait_method(): Bool ->
    not CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct User { name: String }.\n",
            "trait Named { name(value: User): String. }.\n",
            "impl Named for User { name(value: User): Int -> 1. }.\n",
        ]),
    ).valid.

@pure
duplicate_trait_method(): Bool ->
    not CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct User { name: String }.\n",
            "trait Named { name(value: User): String. }.\n",
            "impl Named for User { ",
            "name(value: User): String -> value.name; ",
            "name(other: User): String -> other.name. ",
            "}.\n",
        ]),
    ).valid.

@pure
undeclared_trait_method(): Bool ->
    not CompilerPipeline.analyze(
        String.concat([
            "module demo.Semantic.\n",
            "struct User { name: String }.\n",
            "trait Named { name(value: User): String. }.\n",
            "impl Named for User { ",
            "name(value: User): String -> value.name; ",
            "age(value: User): Int -> 1. ",
            "}.\n",
        ]),
    ).valid.

pub self_test(): Bool ->
    positive_module()
        and duplicate_module()
        and duplicate_callable()
        and distinct_callable_overloads()
        and distinct_callable_returns()
        and valid_local_trait_impl()
        and valid_inherited_trait_impl()
        and missing_inherited_trait_method()
        and missing_trait_method()
        and incompatible_trait_method()
        and duplicate_trait_method()
        and undeclared_trait_method().
