/**
 * Applies resolved callable return types to unknown call-expression type facts.
 */
module self_host.ProjectedCallableTypeMerge.



import std.core.Option.{None, Option, Some}.
import std.collections.List.
import self_host.ProjectedCallableSyntax.
import self_host.ProjectedCallableSyntax.{CallableResolution, ResolvedCallableUse}.
import self_host.ProjectedTypeConstraintSyntax.

import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintResolution}.
@pure
return_type_at(
    byte_offset: Int,
    values: List[ResolvedCallableUse],
): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.source.byte_offset == byte_offset -> case value.declaration {
                Some(declaration) -> declaration.return_type;
                None -> None
            };
            true -> return_type_at(byte_offset, rest)
        }
    }.

@pure
merged_type(value: InferredTypeFact, uses: List[ResolvedCallableUse]): Option[String] ->
    case value.type_name {
        Some(name) -> Some(name);
        None -> return_type_at(value.byte_offset, uses)
    }.

@pure
merge_facts(
    values: List[InferredTypeFact],
    uses: List[ResolvedCallableUse],
): List[InferredTypeFact] ->
    case values {
        [] -> List.new[InferredTypeFact]();
        [value | rest] -> [InferredTypeFact(
            node_id = value.node_id,
            type_name = merged_type(value, uses),
            byte_offset = value.byte_offset,
        ) | merge_facts(rest, uses)]
    }.

@pure
pub merge(
    types: TypeConstraintResolution,
    callables: CallableResolution,
): TypeConstraintResolution ->
    TypeConstraintResolution(
        facts = merge_facts(types.facts, callables.uses),
        diagnostics = types.diagnostics,
    ).
