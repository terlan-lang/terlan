/** Builds a balanced, lossless CST from projected canonical terminals. */
module self_host.ConcreteSyntaxParser.


import std.core.Option.{None, Option, Some}.
import self_host.ConcreteSyntaxTree.{ConcreteSyntaxDocument, ConcreteSyntaxNode}.
import self_host.ProjectionSyntax.{ProjectedCanonicalToken}.


import std.collections.List.
import std.core.String.


struct NodeParse {
    valid: Bool,
    nodes: List[ConcreteSyntaxNode],
    rest: List[ProjectedCanonicalToken],
    close: Option[ProjectedCanonicalToken],
    message: String,
}.

constructor NodeParse {
    (valid: Bool, nodes: List[ConcreteSyntaxNode], rest: List[ProjectedCanonicalToken], close: Option[ProjectedCanonicalToken], message: String): NodeParse ->
        NodeParse {
            valid: valid,
            nodes: nodes,
            rest: rest,
            close: close,
            message: message,
        }
}.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values { [] -> output; [value | rest] -> reverse_at(rest, [value | output]) }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
opening_close(text: String): String ->
    if { text == "(" -> ")"; text == "[" -> "]"; text == "{" -> "}"; true -> "" }.

@pure
group_terminal(text: String): String ->
    if { text == "(" -> "group-()"; text == "[" -> "group-[]"; text == "{" -> "group-{}"; true -> "group" }.

@pure
is_closing(text: String): Bool -> text == ")" or text == "]" or text == "}".

@pure
leaf(value: ProjectedCanonicalToken): ConcreteSyntaxNode ->
    ConcreteSyntaxNode(value.terminal, value.text, value.start_byte, value.end_byte, List.new[ConcreteSyntaxNode]()).

@pure
missing_close_message(expected_close: String): String ->
    if {
        expected_close == "" -> "";
        true -> String.append("missing closing delimiter: ", expected_close)
    }.

@pure
nested_failure(nested: NodeParse, output: List[ConcreteSyntaxNode]): NodeParse ->
    NodeParse(valid = false, nodes = reverse(output), rest = nested.rest, close = None, message = nested.message).

@pure
nested_with_close(
    opening: ProjectedCanonicalToken,
    close: ProjectedCanonicalToken,
    nested: NodeParse,
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    if {
        nested.valid -> parse_at(
            nested.rest,
            expected_close,
            [ConcreteSyntaxNode(group_terminal(opening.text), "", opening.start_byte, close.end_byte, nested.nodes) | output],
        );
        true -> nested_failure(nested, output)
    }.

@pure
nested_result(
    opening: ProjectedCanonicalToken,
    nested: NodeParse,
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    case nested.close {
        Some(close) -> nested_with_close(opening, close, nested, expected_close, output);
        None -> nested_failure(nested, output)
    }.

@pure
parse_opening(
    value: ProjectedCanonicalToken,
    rest: List[ProjectedCanonicalToken],
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    let close_text = opening_close(value.text);
    if {
        close_text == "" -> parse_at(rest, expected_close, [leaf(value) | output]);
        true -> nested_result(
            value,
            parse_at(rest, close_text, List.new[ConcreteSyntaxNode]()),
            expected_close,
            output,
        )
    }.

@pure
parse_after_expected_close(
    value: ProjectedCanonicalToken,
    rest: List[ProjectedCanonicalToken],
    values: List[ProjectedCanonicalToken],
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    if {
        is_closing(value.text) -> NodeParse(valid = false, nodes = reverse(output), rest = values, close = None, message = String.append("unexpected closing delimiter: ", value.text));
        true -> parse_opening(value, rest, expected_close, output)
    }.

@pure
parse_token(
    value: ProjectedCanonicalToken,
    rest: List[ProjectedCanonicalToken],
    values: List[ProjectedCanonicalToken],
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    if {
        expected_close != "" and value.text == expected_close -> NodeParse(valid = true, nodes = reverse(output), rest = rest, close = Some(value), message = "");
        true -> parse_after_expected_close(value, rest, values, expected_close, output)
    }.

@pure
parse_at(
    values: List[ProjectedCanonicalToken],
    expected_close: String,
    output: List[ConcreteSyntaxNode],
): NodeParse ->
    case values {
        [] -> NodeParse(expected_close == "", reverse(output), List.new[ProjectedCanonicalToken](), None, missing_close_message(expected_close));
        [value | rest] -> parse_token(value, rest, values, expected_close, output)
    }.

/** Parses every projected token into a delimiter-balanced concrete tree. */
@pure
pub parse(values: List[ProjectedCanonicalToken]): ConcreteSyntaxDocument ->
    let parsed = parse_at(values, "", List.new[ConcreteSyntaxNode]());
    ConcreteSyntaxDocument(parsed.valid, parsed.nodes, parsed.message).
