/** Self-hosted lowering for canonical configuration declaration headers. */
module self_host.ConfigLowering.

import self_host.ConfigSyntax.{ConfigKind, ConfigSyntax, MachineConfig, RawConfig, StaticConfig, TargetConfig}.
import self_host.DeclarationSyntax.{DeclarationSyntax}.
import self_host.Syntax.{ConfigDeclaration}.

import std.core.{Bool, Int, String}.
import self_host.Delimited.


@pure
strip_terminal_dot(source: String): String ->
    let value = String.trim(source);
    if { String.ends_with(value, ".") -> String.trim(value.utf8_slice(0, value.byte_size() - 1)); true -> value }.

@pure
non_machine_prefix_size(kind: ConfigKind): Int ->
    if {
        kind == TargetConfig or kind == StaticConfig -> 7;
        true -> 0
    }.

@pure
prefix_size(kind: ConfigKind): Int ->
    if {
        kind == MachineConfig -> 8;
        true -> non_machine_prefix_size(kind)
    }.

@pure
kind(source: String): ConfigKind ->
    if {
        String.starts_with(source, "target ") -> TargetConfig;
        String.starts_with(source, "machine ") -> MachineConfig;
        String.starts_with(source, "static ") -> StaticConfig;
        true -> RawConfig
    }.

@pure
config_payload(text: String, kind: ConfigKind): String ->
    if {
        kind == RawConfig -> text;
        true -> String.trim(text.utf8_slice(prefix_size(kind), text.byte_size() - prefix_size(kind)))
    }.

@pure
config_adapter_at(payload: String, kind: ConfigKind): Int ->
    if {
        kind == TargetConfig -> Delimited.top_level_text(payload, " with ");
        true -> -1
    }.

@pure
config_name(payload: String, adapter_at: Int): String ->
    if {
        adapter_at < 0 -> payload;
        true -> String.trim(payload.utf8_slice(0, adapter_at))
    }.

@pure
config_adapter(payload: String, adapter_at: Int): String ->
    if {
        adapter_at < 0 -> "";
        true -> String.trim(payload.utf8_slice(adapter_at + 6, payload.byte_size() - adapter_at - 6))
    }.

@pure
config_output_name(kind: ConfigKind, name: String): String ->
    if {
        kind == RawConfig -> "";
        true -> name
    }.

@pure
config_raw_source(kind: ConfigKind, source: String): String ->
    if {
        kind == RawConfig -> source;
        true -> ""
    }.

@pure
config_message_after_name(adapter_at: Int, adapter: String): String ->
    if {
        adapter_at >= 0 and adapter == "" -> "target adapter path is empty";
        true -> ""
    }.

@pure
config_message_after_text(kind: ConfigKind, name: String, adapter_at: Int, adapter: String): String ->
    if {
        kind != RawConfig and name == "" -> "configuration name is empty";
        true -> config_message_after_name(adapter_at, adapter)
    }.

@pure
config_message_after_supported(text: String, kind: ConfigKind, name: String, adapter_at: Int, adapter: String): String ->
    if {
        text == "" -> "configuration declaration is empty";
        true -> config_message_after_text(kind, name, adapter_at, adapter)
    }.

@pure
config_message(supported: Bool, text: String, kind: ConfigKind, name: String, adapter_at: Int, adapter: String): String ->
    if {
        not supported -> "declaration is not configuration";
        true -> config_message_after_supported(text, kind, name, adapter_at, adapter)
    }.

/** Lowers simple config headers and retains raw config declarations exactly. */
@pure
pub lower(source: DeclarationSyntax): ConfigSyntax ->
    let text = strip_terminal_dot(source.body);
    let kind = kind(text);
    let payload = config_payload(text, kind);
    let adapter_at = config_adapter_at(payload, kind);
    let name = config_name(payload, adapter_at);
    let adapter = config_adapter(payload, adapter_at);
    let supported = source.class == ConfigDeclaration;
    ConfigSyntax(
        supported and text != "" and (kind == RawConfig or name != "") and (adapter_at < 0 or adapter != ""),
        kind,
        config_output_name(kind, name),
        adapter,
        adapter_at >= 0,
        config_raw_source(kind, source.body),
        source.span,
        config_message(supported, text, kind, name, adapter_at, adapter),
    ).
