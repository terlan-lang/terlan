/**
 * Converts projected bodies plus local semantic facts into resolved IR plans.
 */
module self_host.ProjectedSemanticIrPlan.

import std.core.String.

import self_host.BackendSyntax.{BackendDeclaration}.
import self_host.DeclarationPayloadSyntax.{StructFieldSyntax}.
import self_host.ProjectedBodySyntax.{ProjectedBody}.
import self_host.ProjectedCallableSyntax.{CallableDeclaration, ResolvedCallableUse}.
import self_host.ProjectedExpressionIrPlan.{lower_expression}.
import self_host.ProjectedComprehensionDesugar.
import self_host.ProjectedExpressionSupportIrPlan.{ExpressionPlan, append_ir_parameters, body_for, concat_blocks, concat_instructions, expression_type, ir_parameters, lambda_body, lambda_body_id, lambda_captures, lambda_parameters, lambda_symbol, node_size, none_string, parameter, parameter_count, register, resolved_or_dynamic, resolved_return, shallow_pattern_bindings, shallow_pattern_operands, shallow_pattern_supported, some_string}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode, ProjectedExpressionResult}.
import self_host.ProjectedFrontendSyntax.{ProjectedFrontendModule}.
import self_host.ProjectedLocalSemanticSyntax.{LocalSemanticResult}.
import self_host.ProjectedEmbeddedControlIrPlan.{EmbeddedBranchPlan, embedded_case_at, embedded_if_any_at, root_embedded_case_blocks, root_embedded_if_blocks, root_refutable_let_blocks}.
import self_host.ProjectedNestedControlIrPlan.{ExpressionNodePair, ExpressionNodeQuad, ExpressionNodeTriple, expression_node_pair, expression_node_quad, expression_node_triple, linear_binding, nested_let_if_blocks}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact}.
import self_host.SelfHostIrSyntax.{IrParameter, IrStructField, IrStructLayout}.
import self_host.SelfHostSemanticIrSyntax.{SemanticBlockPlan, SemanticFunctionPlan, SemanticInstructionPlan, SemanticModulePlan, SemanticRegionPlan, SemanticTerminatorPlan, SemanticTryRegionPlan}.
import self_host.TypedModuleSyntax.{FunctionPayload, MethodPayload, StructPayload}.
import self_host.{BackendSyntax, FunctionSyntax, MethodSyntax, ParameterSyntax, ProjectedBodySyntax, ProjectedEmbeddedControlIrPlan, ProjectedExpressionSupportIrPlan, ProjectedExpressionSyntax, ProjectedFrontendSyntax, ProjectedLocalSemanticSyntax, ProjectedNestedControlIrPlan, ProjectedTypeConstraintSyntax, SelfHostIrSyntax, SelfHostSemanticIrSyntax, TypedModuleSyntax}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Bool, Int, String}.

resolved_callable_at(
    byte_offset: Int,
    name: String,
    values: List[ResolvedCallableUse],
): Option[CallableDeclaration] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            value.source.byte_offset == byte_offset and value.source.name == name -> value.declaration;
            true -> resolved_callable_at(byte_offset, name, rest)
        }
    }.

normalize_expression_children(
    values: List[ProjectedExpressionNode],
    module_name: String,
    callables: List[ResolvedCallableUse],
): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] -> [normalize_expression(value, module_name, callables)
            | normalize_expression_children(rest, module_name, callables)]
    }.

constructor_result_type(declaration: CallableDeclaration): String ->
    case declaration.return_type {
        Some(value) -> value;
        None -> declaration.name
    }.

resolved_call_kind(
    declaration: CallableDeclaration,
    module_name: String,
    method_call: Bool,
): String ->
    if {
        declaration.module_name == module_name and method_call and declaration.receiver_mutable ->
            "resolved-local-mut-method";
        declaration.module_name == module_name and method_call -> "resolved-local-method";
        declaration.module_name == module_name -> "resolved-local-call";
        method_call and declaration.receiver_mutable -> String.append("resolved-import-mut-method:", declaration.module_name);
        method_call -> String.append("resolved-import-method:", declaration.module_name);
        true -> String.append("resolved-import:", declaration.module_name)
    }.

normalize_resolved_callee(
    callee: ProjectedExpressionNode,
    declaration: CallableDeclaration,
    module_name: String,
): ProjectedExpressionNode ->
    ProjectedExpressionNode(
        resolved_call_kind(declaration, module_name, declaration.callable_kind == "method" and instance_callee(callee)),
        declaration.name,
        callee.start_byte,
        callee.end_byte,
        callee.children,
    ).

normalized_call_target(callee: ProjectedExpressionNode): ProjectedExpressionNode ->
    case callee.children {
        [base, argument] where callee.kind == "index" and argument.kind == "binding" -> base;
        _ -> callee
    }.

upper_name(value: String): Bool ->
    if {
        value == "" -> false;
        true -> let byte = value.utf8_byte_at(0); byte >= 65 and byte <= 90
    }.

instance_callee(callee: ProjectedExpressionNode): Bool ->
    let target = normalized_call_target(callee);
    case target.children {
        [base | _] -> target.kind == "field" and not upper_name(base.text);
        [] -> false
    }.

syntactic_constructor(callee: ProjectedExpressionNode): Bool ->
    let target = normalized_call_target(callee);
    target.kind == "constructor" or (target.kind == "field" and upper_name(target.text)).

normalize_syntactic_constructor_call(node: ProjectedExpressionNode): ProjectedExpressionNode ->
    case node.children {
        [callee | arguments] ->
            let target = normalized_call_target(callee);
            let constructor_node = ProjectedExpressionNode(
                callee.kind,
                target.text,
                callee.start_byte,
                callee.end_byte,
                callee.children,
            );
            ProjectedExpressionNode(
                "resolved-constructor-call",
                target.text,
                node.start_byte,
                node.end_byte,
                [constructor_node | arguments],
            );
        [] -> node
    }.

normalize_generic_import_callee(callee: ProjectedExpressionNode): Option[ProjectedExpressionNode] ->
    case callee.children {
        [target | _] where callee.kind == "index" -> case target.children {
            [base | _]
                where target.kind == "field"
                    and upper_name(base.text) -> Some(ProjectedExpressionNode(
                        String.append("resolved-import:", base.text),
                        target.text,
                        callee.start_byte,
                        callee.end_byte,
                        callee.children,
                    ));
            _ -> None
        };
        _ -> None
    }.

normalize_generic_import_call(
    node: ProjectedExpressionNode,
    callee: ProjectedExpressionNode,
    arguments: List[ProjectedExpressionNode],
): ProjectedExpressionNode ->
    case normalize_generic_import_callee(callee) {
        Some(resolved_callee) -> ProjectedExpressionNode(
            node.kind,
            node.text,
            node.start_byte,
            node.end_byte,
            [resolved_callee | arguments],
        );
        None -> if {
            syntactic_constructor(callee) -> normalize_syntactic_constructor_call(node);
            true -> node
        }
    }.

normalize_unresolved_call(node: ProjectedExpressionNode): ProjectedExpressionNode ->
    case node.children {
        [callee | arguments] -> normalize_generic_import_call(node, callee, arguments);
        [] -> node
    }.

normalize_resolved_call_children(
    node: ProjectedExpressionNode,
    declaration: CallableDeclaration,
    module_name: String,
): ProjectedExpressionNode ->
    case node.children {
        [callee | arguments] ->
            let resolved_callee = normalize_resolved_callee(callee, declaration, module_name);
            if {
                declaration.callable_kind == "constructor" ->
                    let result_type = constructor_result_type(declaration);
                    let constructor_callee = if {
                        result_type == declaration.name
                            or result_type.ends_with(String.concat([".", declaration.name])) -> ProjectedExpressionNode(
                            resolved_callee.kind,
                            String.concat([declaration.module_name, ".", declaration.name]),
                            resolved_callee.start_byte,
                            resolved_callee.end_byte,
                            resolved_callee.children,
                        );
                        true -> resolved_callee
                    };
                    ProjectedExpressionNode(
                        "resolved-constructor-call",
                        result_type,
                        node.start_byte,
                        node.end_byte,
                        [constructor_callee | arguments],
                    );
                true -> ProjectedExpressionNode(
                    node.kind,
                    node.text,
                    node.start_byte,
                    node.end_byte,
                    [resolved_callee | arguments],
                )
            };
        [] -> node
    }.

normalize_resolved_call(
    node: ProjectedExpressionNode,
    module_name: String,
    callables: List[ResolvedCallableUse],
): ProjectedExpressionNode ->
    case node.children {
        [callee | _] -> normalize_resolved_call_at(
            node,
            normalized_call_target(callee).text,
            module_name,
            callables,
        );
        [] -> node
    }.

normalize_resolved_call_at(
    node: ProjectedExpressionNode,
    name: String,
    module_name: String,
    callables: List[ResolvedCallableUse],
): ProjectedExpressionNode ->
    case resolved_callable_at(node.start_byte, name, callables) {
        Some(declaration) -> normalize_resolved_call_children(node, declaration, module_name);
        None -> normalize_unresolved_call(node)
    }.

normalize_expression(
    node: ProjectedExpressionNode,
    module_name: String,
    callables: List[ResolvedCallableUse],
): ProjectedExpressionNode ->
    let normalized = ProjectedExpressionNode(
        node.kind,
        node.text,
        node.start_byte,
        node.end_byte,
        normalize_expression_children(node.children, module_name, callables),
    );
    if {
        normalized.kind == "call" -> normalize_resolved_call(normalized, module_name, callables);
        true -> normalized
    }.

normalize_expression_result(
    value: ProjectedExpressionResult,
    module_name: String,
    callables: List[ResolvedCallableUse],
): ProjectedExpressionResult ->
    case value.node {
        Some(node) -> ProjectedExpressionResult(
            value.valid,
            Some(normalize_expression(node, module_name, callables)),
            value.rest,
            value.message,
        );
        None -> value
    }.

normalize_bodies(
    values: List[ProjectedBody],
    module_name: String,
    callables: List[ResolvedCallableUse],
): List[ProjectedBody] ->
    case values {
        [] -> List.new[ProjectedBody]();
        [value | rest] -> [ProjectedBody(
            value.declaration_head,
            value.span,
            normalize_expression_result(value.expression, module_name, callables),
        ) | normalize_bodies(rest, module_name, callables)]
    }.

root_case_one_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_pair(node.children) {
        Some(parts) ->
            root_case_one_direct_clause(
                parts.first,
                expression_node_pair(parts.second.children),
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_direct_clause(
    subject: ProjectedExpressionNode,
    clause: Option[ExpressionNodePair],
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case clause {
        Some(parts) ->
            root_case_one_direct_supported(
                shallow_pattern_supported(parts.first),
                subject,
                parts.first,
                parts.second,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_direct_supported(
    valid: Bool,
    subject: ProjectedExpressionNode,
    pattern: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_one_direct_bound(
                subject,
                pattern,
                body,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_one_direct_bound(
    subject: ProjectedExpressionNode,
    pattern: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let subject_plan = lower_expression(subject, node_id + 1, facts, parameters);
    let clause_id = node_id + 1 + node_size(subject);
    let body_id = clause_id + 1 + node_size(pattern);
    let body_plan = lower_expression(body, body_id, facts, parameters);
    Some(root_case_one_blocks(entry_instructions, subject_plan, pattern, body_plan, facts, parameters)).

root_case_one_blocks(
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    pattern: ProjectedExpressionNode,
    body_plan: ExpressionPlan,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    let environment = "%root_case_environment_0";
    let matched = "%root_case_match_0";
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, subject_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_0",
            [
                SemanticInstructionPlan(
                    "prepare-pattern",
                    some_string(environment),
                    shallow_pattern_operands(subject_plan.result, pattern),
                    some_string("PatternMatch"),
                ),
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(matched),
                    [environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [matched],
                ["root_case_body_0", "root_case_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_0",
            concat_instructions(
                shallow_pattern_bindings(pattern, environment, facts, parameters),
                body_plan.instructions,
            ),
            SemanticTerminatorPlan("return", [body_plan.result], List.new[String]()),
        ),
        SemanticBlockPlan(
            "root_case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
    ].

root_case_one_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "let" -> root_case_one_let_at(node, node_id, entry_instructions, facts, parameters);
        true -> root_case_one_nonlet_at(node, node_id, entry_instructions, facts, parameters)
    }.

root_case_one_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(parts) ->
            root_case_one_let_parts(
                ProjectedExpressionSupportIrPlan.binding_pattern(parts.first),
                parts.first,
                parts.second,
                parts.third,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_let_parts(
    valid: Bool,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_one_let_bound(
                pattern,
                source,
                continuation,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_one_let_bound(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let source_id = node_id + 1 + node_size(pattern);
    let source_plan = lower_expression(source, source_id, facts, parameters);
    root_case_one_at(
        continuation,
        source_id + node_size(source),
        concat_instructions(
            entry_instructions,
            concat_instructions(source_plan.instructions, linear_binding(pattern, source_plan)),
        ),
        facts,
        parameters,
    ).

root_case_one_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_one_direct(node, node_id, entry_instructions, facts, parameters);
        true -> None
    }.

root_case_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(clauses) ->
            root_case_two_direct_clauses(
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_clauses(
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_two_direct_first(
        expression_node_pair(clauses.second.children),
        expression_node_pair(clauses.third.children),
        clauses,
        node_id,
        entry_instructions,
        return_name,
        facts,
        parameters,
    ).

root_case_two_direct_first(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case first {
        Some(parts) ->
            root_case_two_direct_second(
                parts,
                second,
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case second {
        Some(parts) ->
            root_case_two_direct_value(
                first,
                parts,
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_two_direct_supported(
        shallow_pattern_supported(first.first) and shallow_pattern_supported(second.first),
        clauses.first,
        clauses.second,
        first.first,
        first.second,
        second.first,
        second.second,
        node_id,
        entry_instructions,
        return_name,
        facts,
        parameters,
    ).

root_case_two_direct_supported(
    valid: Bool,
    subject: ProjectedExpressionNode,
    first_clause: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_two_direct_bound(
                subject,
                first_clause,
                first_pattern,
                first_body,
                second_pattern,
                second_body,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_two_direct_bound(
    subject: ProjectedExpressionNode,
    first_clause: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let subject_plan = lower_expression(subject, node_id + 1, facts, parameters);
    let first_id = node_id + 1 + node_size(subject);
    let first_body_id = first_id + 1 + node_size(first_pattern);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = first_id + node_size(first_clause);
    let second_body_id = second_id + 1 + node_size(second_pattern);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    root_case_two_prepare(
        first_body,
        first_body_id,
        second_body,
        second_body_id,
        entry_instructions,
        subject_plan,
        first_pattern,
        first_body_plan,
        second_pattern,
        second_body_plan,
        projected_phi_type(return_name),
        facts,
        parameters,
    ).

embedded_case_or_if_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    case_label_prefix: String,
    if_label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case embedded_if_any_at(
        node,
        node_id,
        entry_label,
        if_label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ) {
        Some(embedded) -> Some(embedded);
        None -> embedded_case_at(
            node,
            node_id,
            entry_label,
            case_label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

root_case_two_prepare(
    first_body: ProjectedExpressionNode,
    first_body_id: Int,
    second_body: ProjectedExpressionNode,
    second_body_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    phi_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let first_environment = "%root_case_environment_0";
    let second_environment = "%root_case_environment_1";
    let first_match = "%root_case_match_0";
    let second_match = "%root_case_match_1";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let first_bindings = shallow_pattern_bindings(first_pattern, first_environment, facts, parameters);
    let second_bindings = shallow_pattern_bindings(second_pattern, second_environment, facts, parameters);
    let first_embedded =
        embedded_case_or_if_at(
            first_body,
            first_body_id,
            "root_case_body_0",
            "root_case_body_0_case_",
            "root_case_body_0_if_",
            first_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    let second_embedded =
        embedded_case_or_if_at(
            second_body,
            second_body_id,
            "root_case_body_1",
            "root_case_body_1_case_",
            "root_case_body_1_if_",
            second_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    root_case_two_select_first(
        first_embedded,
        second_embedded,
        entry_instructions,
        subject_plan,
        first_prepare,
        first_match,
        first_bindings,
        first_body_plan,
        second_prepare,
        second_match,
        second_bindings,
        second_body_plan,
        phi_type,
    ).

root_case_two_select_first(
    first_embedded: Option[EmbeddedBranchPlan],
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case first_embedded {
        Some(embedded) ->
            root_case_two_select_both_or_first(
                embedded,
                second_embedded,
                entry_instructions,
                subject_plan,
                first_prepare,
                first_match,
                second_prepare,
                second_match,
                second_bindings,
                second_body_plan,
                phi_type,
            );
        None ->
            root_case_two_select_second(
                second_embedded,
                entry_instructions,
                subject_plan,
                first_prepare,
                first_match,
                first_bindings,
                first_body_plan,
                second_prepare,
                second_match,
                second_bindings,
                second_body_plan,
                phi_type,
            )
    }.

root_case_two_select_both_or_first(
    first_embedded: EmbeddedBranchPlan,
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case second_embedded {
        Some(embedded) -> Some(root_case_two_both_embedded_blocks(
            first_embedded,
            embedded,
            entry_instructions,
            subject_plan,
            first_prepare,
            first_match,
            second_prepare,
            second_match,
            phi_type,
        ));
        None -> Some(root_case_two_first_embedded_blocks(
            first_embedded,
            entry_instructions,
            subject_plan,
            first_prepare,
            first_match,
            second_prepare,
            second_match,
            second_bindings,
            second_body_plan,
            phi_type,
        ))
    }.

root_case_two_select_second(
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case second_embedded {
        Some(embedded) ->
            Some(
                root_case_two_second_embedded_blocks(
                    embedded,
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    phi_type,
                ),
            );
        None ->
            Some(
                root_case_two_linear_blocks(
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    second_bindings,
                    second_body_plan,
                    phi_type,
                ),
            )
    }.

root_case_two_first_embedded_blocks(
    embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat_blocks(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat_blocks(
            embedded.blocks,
            [
                SemanticBlockPlan(
                    "root_case_body_1",
                    concat_instructions(second_bindings, second_body_plan.instructions),
                    SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
                ),
                SemanticBlockPlan(
                    "root_case_unreachable",
                    List.new[SemanticInstructionPlan](),
                    SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                ),
                SemanticBlockPlan(
                    "root_case_join",
                    [
                        SemanticInstructionPlan(
                            "phi",
                            some_string("%root_case_result"),
                            [
                                embedded.exit_label,
                                embedded.result,
                                "root_case_body_1",
                                second_body_plan.result,
                            ],
                            some_string(phi_type),
                        ),
                    ],
                    SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                ),
            ],
        ),
    ).

root_case_two_both_embedded_blocks(
    first_embedded: EmbeddedBranchPlan,
    second_embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat_blocks(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat_blocks(
            first_embedded.blocks,
            concat_blocks(
                second_embedded.blocks,
                [
                    SemanticBlockPlan(
                        "root_case_unreachable",
                        List.new[SemanticInstructionPlan](),
                        SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                    ),
                    SemanticBlockPlan(
                        "root_case_join",
                        [
                            SemanticInstructionPlan(
                                "phi",
                                some_string("%root_case_result"),
                                [
                                    first_embedded.exit_label,
                                    first_embedded.result,
                                    second_embedded.exit_label,
                                    second_embedded.result,
                                ],
                                some_string(phi_type),
                            ),
                        ],
                        SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                    ),
                ],
            ),
        ),
    ).

root_case_two_second_embedded_blocks(
    embedded: EmbeddedBranchPlan,
