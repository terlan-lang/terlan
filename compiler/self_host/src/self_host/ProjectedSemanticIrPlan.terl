    ),
))))).

embedded_if_four_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    third: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_condition: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    fourth_condition: ProjectedExpressionNode,
    fourth_body: ProjectedExpressionNode,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_id = second_condition_id + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let third_id = second_id + node_size(second);
    let third_condition_id = third_id + 1;
    let third_condition_plan = lower_expression(third_condition, third_condition_id, facts, parameters);
    let third_body_id = third_condition_id + node_size(third_condition);
    let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
    let fourth_id = third_id + node_size(third);
    let fourth_condition_id = fourth_id + 1;
    let fourth_condition_plan = lower_expression(fourth_condition, fourth_condition_id, facts, parameters);
    let fourth_body_id = fourth_condition_id + node_size(fourth_condition);
    let fourth_body_plan = lower_expression(fourth_body, fourth_body_id, facts, parameters);
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_condition_label = embedded_label(label_prefix, "condition_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let third_condition_label = embedded_label(label_prefix, "condition_2");
    let third_body_label = embedded_label(label_prefix, "body_2");
    let fourth_condition_label = embedded_label(label_prefix, "condition_3");
    let fourth_body_label = embedded_label(label_prefix, "body_3");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let result = register(node_id);
    let fallback_type = resolved_or_dynamic(expression_type(node, facts, parameters));
    let first_two_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            fallback_type,
        );
    let first_three_type = matching_plan_result_type(first_two_type, third_body_plan.result_type, fallback_type);
    let result_type = matching_plan_result_type(first_three_type, fourth_body_plan.result_type, fallback_type);
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, first_condition_plan.instructions),
                SemanticTerminatorPlan(
                    "branch",
                    [first_condition_plan.result],
                    [first_body_label, second_condition_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                first_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_condition_label,
                second_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [second_condition_plan.result],
                    [second_body_label, third_condition_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                second_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                third_condition_label,
                third_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [third_condition_plan.result],
                    [third_body_label, fourth_condition_label],
                ),
            ),
            SemanticBlockPlan(
                third_body_label,
                third_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                fourth_condition_label,
                fourth_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [fourth_condition_plan.result],
                    [fourth_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                fourth_body_label,
                fourth_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                            third_body_label,
                            third_body_plan.result,
                            fourth_body_label,
                            fourth_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_if_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "let" -> embedded_if_let_at(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> embedded_if_nonlet_at(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

embedded_if_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    let Some(parts) <- expression_triple(node.children) else {
        None -> None
    };
    (let true <- parts.first.kind == "binding-pattern" else {
    false -> None
};
(let source_id = node_id + 1 + node_size(parts.first);
let source_plan = lower_expression(parts.second, source_id, facts, parameters);
embedded_if_at(
    parts.third,
    source_id + node_size(parts.second),
    entry_label,
    label_prefix,
    concat_instructions(
        entry_instructions,
        concat_instructions(source_plan.instructions, linear_binding(parts.first, source_plan)),
    ),
    join_target,
    facts,
    parameters,
))).

embedded_if_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "if" and node.children.length() == 2 -> embedded_if_two_direct(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> embedded_if_after_two(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

embedded_if_after_two(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "if" and node.children.length() == 3 -> embedded_if_three_direct(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> embedded_if_after_three(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

embedded_if_after_three(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "if" and node.children.length() == 4 -> embedded_if_four_direct(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> None
    }.

root_embedded_if_blocks(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case embedded_if_at(
        node,
        0,
        "entry",
        "root_if_",
        List.new[SemanticInstructionPlan](),
        "root_return",
        facts,
        parameters,
    ) {
        Some(embedded) ->
            Some(
                concat(
                    embedded.blocks,
                    [
                        SemanticBlockPlan(
                            "root_return",
                            List.new[SemanticInstructionPlan](),
                            SemanticTerminatorPlan("return", [embedded.result], List.new[String]()),
                        ),
                    ],
                ),
            );
        None -> None
    }.

embedded_case_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    let Some(clauses) <- expression_triple(node.children) else {
        None -> None
    };
    (let Some(first) <- expression_pair(clauses.second.children) else {
    None -> None
};
(let Some(second) <- expression_pair(clauses.third.children) else {
    None -> None
};
(let true <- shallow_pattern_supported(first.first) and shallow_pattern_supported(second.first) else {
    false -> None
};
(let subject_plan = lower_expression(clauses.first, node_id + 1, facts, parameters);
let first_id = node_id + 1 + node_size(clauses.first);
let first_body_id = first_id + 1 + node_size(first.first);
let first_body_plan = lower_expression(first.second, first_body_id, facts, parameters);
let second_id = first_id + node_size(clauses.second);
let second_body_id = second_id + 1 + node_size(second.first);
let second_body_plan = lower_expression(second.second, second_body_id, facts, parameters);
Some(
    embedded_case_two_blocks(
        node,
        node_id,
        subject_plan,
        first.first,
        first_body_plan,
        second.first,
        second_body_plan,
        entry_label,
        label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ),
))))).

embedded_case_two_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_environment = embedded_label("%", embedded_label(label_prefix, "environment_0"));
    let second_environment = embedded_label("%", embedded_label(label_prefix, "environment_1"));
    let first_match = embedded_label("%", embedded_label(label_prefix, "match_0"));
    let second_match = embedded_label("%", embedded_label(label_prefix, "match_1"));
    let first_pattern_label = embedded_label(label_prefix, "pattern_0");
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_pattern_label = embedded_label(label_prefix, "pattern_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let first_bindings = shallow_pattern_bindings(first_pattern, first_environment);
    let second_bindings = shallow_pattern_bindings(second_pattern, second_environment);
    let result = register(node_id);
    let result_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            resolved_or_dynamic(expression_type(node, facts, parameters)),
        );
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), [first_pattern_label]),
            ),
            SemanticBlockPlan(
                first_pattern_label,
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        [first_environment],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    [first_body_label, second_pattern_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                concat_instructions(first_bindings, first_body_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_pattern_label,
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        [second_environment],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    [second_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                concat_instructions(second_bindings, second_body_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_case_two_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "let" -> embedded_case_two_let_at(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> embedded_case_two_nonlet_at(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

embedded_case_two_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    let Some(parts) <- expression_triple(node.children) else {
        None -> None
    };
    (let true <- parts.first.kind == "binding-pattern" else {
    false -> None
};
(let source_id = node_id + 1 + node_size(parts.first);
let source_plan = lower_expression(parts.second, source_id, facts, parameters);
embedded_case_two_at(
    parts.third,
    source_id + node_size(parts.second),
    entry_label,
    label_prefix,
    concat_instructions(
        entry_instructions,
        concat_instructions(source_plan.instructions, linear_binding(parts.first, source_plan)),
    ),
    join_target,
    facts,
    parameters,
))).

embedded_case_two_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    if {
        node.kind == "case" -> embedded_case_two_direct(
            node,
            node_id,
            entry_label,
            label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        );
        true -> None
    }.

root_case_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let Some(clauses) <- expression_triple(node.children) else {
        None -> None
    };
    (let Some(first) <- expression_pair(clauses.second.children) else {
    None -> None
};
(let Some(second) <- expression_pair(clauses.third.children) else {
    None -> None
};
(let true <- shallow_pattern_supported(first.first) and shallow_pattern_supported(second.first) else {
    false -> None
};
(let subject_plan = lower_expression(clauses.first, node_id + 1, facts, parameters);
let first_id = node_id + 1 + node_size(clauses.first);
let first_body_id = first_id + 1 + node_size(first.first);
let first_body_plan = lower_expression(first.second, first_body_id, facts, parameters);
let second_id = first_id + node_size(clauses.second);
let second_body_id = second_id + 1 + node_size(second.first);
let second_body_plan = lower_expression(second.second, second_body_id, facts, parameters);
root_case_two_prepare(
    first.second,
    first_body_id,
    second.second,
    second_body_id,
    entry_instructions,
    subject_plan,
    first.first,
    first_body_plan,
    second.first,
    second_body_plan,
    projected_phi_type(return_name),
    facts,
    parameters,
))))).

root_case_two_prepare(
    first_body: ProjectedExpressionNode,
    first_body_id: Int,
    second_body: ProjectedExpressionNode,
    second_body_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    phi_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let first_environment = "%root_case_environment_0";
    let second_environment = "%root_case_environment_1";
    let first_match = "%root_case_match_0";
    let second_match = "%root_case_match_1";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let first_bindings = shallow_pattern_bindings(first_pattern, first_environment);
    let second_bindings = shallow_pattern_bindings(second_pattern, second_environment);
    let first_embedded =
        embedded_case_two_at(
            first_body,
            first_body_id,
            "root_case_body_0",
            "root_case_body_0_case_",
            first_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    let second_embedded =
        embedded_if_at(
            second_body,
            second_body_id,
            "root_case_body_1",
            "root_case_body_1_if_",
            second_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    root_case_two_select_first(
        first_embedded,
        second_embedded,
        entry_instructions,
        subject_plan,
        first_prepare,
        first_match,
        first_bindings,
        first_body_plan,
        second_prepare,
        second_match,
        second_bindings,
        second_body_plan,
        phi_type,
    ).

root_case_two_select_first(
    first_embedded: Option[EmbeddedBranchPlan],
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case first_embedded {
        Some(embedded) ->
            Some(
                root_case_two_first_embedded_blocks(
                    embedded,
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    second_prepare,
                    second_match,
                    second_bindings,
                    second_body_plan,
                    phi_type,
                ),
            );
        None ->
            root_case_two_select_second(
                second_embedded,
                entry_instructions,
                subject_plan,
                first_prepare,
                first_match,
                first_bindings,
                first_body_plan,
                second_prepare,
                second_match,
                second_bindings,
                second_body_plan,
                phi_type,
            )
    }.

root_case_two_select_second(
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case second_embedded {
        Some(embedded) ->
            Some(
                root_case_two_second_embedded_blocks(
                    embedded,
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    phi_type,
                ),
            );
        None ->
            Some(
                root_case_two_linear_blocks(
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    second_bindings,
                    second_body_plan,
                    phi_type,
                ),
            )
    }.

root_case_two_first_embedded_blocks(
    embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat(
            embedded.blocks,
            [
                SemanticBlockPlan(
                    "root_case_body_1",
                    concat_instructions(second_bindings, second_body_plan.instructions),
                    SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
                ),
                SemanticBlockPlan(
                    "root_case_unreachable",
                    List.new[SemanticInstructionPlan](),
                    SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                ),
                SemanticBlockPlan(
                    "root_case_join",
                    [
                        SemanticInstructionPlan(
                            "phi",
                            some_string("%root_case_result"),
                            [
                                embedded.exit_label,
                                embedded.result,
                                "root_case_body_1",
                                second_body_plan.result,
                            ],
                            some_string(phi_type),
                        ),
                    ],
                    SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                ),
            ],
        ),
    ).

root_case_two_second_embedded_blocks(
    embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_body_0",
                concat_instructions(first_bindings, first_body_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat(
            embedded.blocks,
            [
                SemanticBlockPlan(
                    "root_case_unreachable",
                    List.new[SemanticInstructionPlan](),
                    SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                ),
                SemanticBlockPlan(
                    "root_case_join",
                    [
                        SemanticInstructionPlan(
                            "phi",
                            some_string("%root_case_result"),
                            [
                                "root_case_body_0",
                                first_body_plan.result,
                                embedded.exit_label,
                                embedded.result,
                            ],
                            some_string(phi_type),
                        ),
                    ],
                    SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                ),
            ],
        ),
    ).

root_case_two_linear_blocks(
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, subject_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    ["%root_case_environment_0"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [first_match],
                ["root_case_body_0", "root_case_pattern_1"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_0",
            concat_instructions(first_bindings, first_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    ["%root_case_environment_1"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [second_match],
                ["root_case_body_1", "root_case_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_1",
            concat_instructions(second_bindings, second_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "root_case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%root_case_result"),
                    [
                        "root_case_body_0",
                        first_body_plan.result,
                        "root_case_body_1",
                        second_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
        ),
    ].

root_case_two_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "let" -> root_case_two_let_at(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> root_case_two_nonlet_at(node, node_id, entry_instructions, return_name, facts, parameters)
    }.

root_case_two_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let Some(parts) <- expression_triple(node.children) else {
        None -> None
    };
    (let true <- parts.first.kind == "binding-pattern" else {
    false -> None
};
(let source_id = node_id + 1 + node_size(parts.first);
let source_plan = lower_expression(parts.second, source_id, facts, parameters);
root_case_two_at(
    parts.third,
    source_id + node_size(parts.second),
    concat_instructions(
        entry_instructions,
        concat_instructions(source_plan.instructions, linear_binding(parts.first, source_plan)),
    ),
    return_name,
    facts,
    parameters,
))).

root_case_two_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_two_direct(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> None
    }.

function_plan(
    module_name: String,
    declaration: BackendDeclaration,
    body: ProjectedBody,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body.expression.node {
        Some(node) -> function_plan_for_node(module_name, declaration, node, facts);
        None -> None
    }.

function_plan_for_node(
    module_name: String,
    declaration: BackendDeclaration,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case declaration.payload {
        FunctionPayload(function) ->
            let params = ir_parameters(function.typed_parameters);
            let expression = lower_expression(node, 0, facts, params);
            let return_name =
                if {
                    function.return_type.valid -> function.return_type.syntax.text;
                    true -> ""
                };
            let blocks =
                projected_function_blocks(
                    node,
                    return_name,
                    projected_linear_blocks(expression),
                    facts,
                    params,
                );
            let resolved_return_type =
                if {
                    function.return_type.valid -> resolved_return(function.return_type.syntax.text, expression.result_type);
                    true -> none_string()
                };
            Some(
                SemanticFunctionPlan(
                    module_name = module_name,
                    name = declaration.symbol_name,
                    arity = parameter_count(params),
                    parameters = params,
                    resolved_return_type = resolved_return_type,
                    blocks = blocks,
                    native_symbol = none_string(),
                ),
            );
        MethodPayload(method) ->
            let params = [parameter(method.receiver) | ir_parameters(method.parameters)];
            let expression = lower_expression(node, 0, facts, params);
            let return_name =
                if {
                    method.return_type.valid -> method.return_type.syntax.text;
                    true -> ""
                };
            let blocks =
                projected_function_blocks(
                    node,
                    return_name,
                    projected_linear_blocks(expression),
                    facts,
                    params,
                );
            let resolved_return_type =
                if {
                    method.return_type.valid -> resolved_return(method.return_type.syntax.text, expression.result_type);
                    true -> none_string()
                };
            Some(
                SemanticFunctionPlan(
                    module_name = module_name,
                    name = declaration.symbol_name,
                    arity = parameter_count(params),
                    parameters = params,
                    resolved_return_type = resolved_return_type,
                    blocks = blocks,
                    native_symbol = none_string(),
                ),
            );
        _ -> None
    }.

projected_linear_blocks(expression: ExpressionPlan): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            label = "entry",
            instructions = expression.instructions,
            terminator = SemanticTerminatorPlan(
                opcode = "return",
                operands = [expression.result],
                targets = List.new[String](),
            ),
        ),
    ].

projected_function_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case nested_let_if_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_embedded_or_case_blocks(node, return_name, linear_blocks, facts, parameters)
    }.

projected_embedded_or_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_embedded_if_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_two_or_three_blocks(node, return_name, linear_blocks, facts, parameters)
    }.

projected_case_two_or_three_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_two_at(node, 0, List.new[SemanticInstructionPlan](), return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_three_or_linear_blocks(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            )
    }.

projected_case_three_or_linear_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_three_at(node, return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None -> linear_blocks
    }.

root_case_three_at(
    node: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let true <- node.kind == "case" else {
        false -> None
    };
    (let Some(clauses) <- expression_quad(node.children) else {
    None -> None
};
(let Some(first) <- expression_pair(clauses.second.children) else {
    None -> None
};
(let Some(second) <- expression_pair(clauses.third.children) else {
    None -> None
};
(let Some(third) <- expression_pair(clauses.fourth.children) else {
    None -> None
};
root_case_three_direct(
    clauses.first,
    clauses.second,
    clauses.third,
    first.first,
    first.second,
    second.first,
    second.second,
    third.first,
    third.second,
    return_name,
    facts,
    parameters,
))))).

root_case_three_direct(
    subject: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_pattern: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        shallow_pattern_supported(first_pattern)
            and shallow_pattern_supported(second_pattern)
            and shallow_pattern_supported(third_pattern) -> let subject_plan = lower_expression(subject, 1, facts, parameters);
        let first_id = 1 + node_size(subject);
        let first_body_id = first_id + 1 + node_size(first_pattern);
        let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
        let second_id = first_id + node_size(first);
        let second_body_id = second_id + 1 + node_size(second_pattern);
        let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
        let third_id = second_id + node_size(second);
        let third_body_id = third_id + 1 + node_size(third_pattern);
        let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
        Some(
            root_case_three_blocks(
                subject_plan,
                first_pattern,
                first_body_plan,
                second_pattern,
                second_body_plan,
                third_pattern,
                third_body_plan,
                projected_phi_type(return_name),
            ),
        );
        true -> None
    }.

projected_phi_type(return_name: String): String ->
    if {
        return_name == "" -> "Dynamic";
        true -> return_name
    }.

root_case_three_blocks(
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    third_pattern: ProjectedExpressionNode,
    third_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    let first_environment = "%case_environment_0";
    let second_environment = "%case_environment_1";
    let third_environment = "%case_environment_2";
    let first_match = "%case_match_0";
    let second_match = "%case_match_1";
    let third_match = "%case_match_2";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let third_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(third_environment),
            shallow_pattern_operands(subject_plan.result, third_pattern),
            some_string("PatternMatch"),
        );
    [
        SemanticBlockPlan(
            "entry",
            subject_plan.instructions,
            SemanticTerminatorPlan("jump", List.new[String](), ["case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    [first_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [first_match], ["case_body_0", "case_pattern_1"]),
        ),
        SemanticBlockPlan(
            "case_body_0",
            concat_instructions(
                shallow_pattern_bindings(first_pattern, first_environment),
                first_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    [second_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [second_match], ["case_body_1", "case_pattern_2"]),
        ),
        SemanticBlockPlan(
            "case_body_1",
            concat_instructions(
                shallow_pattern_bindings(second_pattern, second_environment),
                second_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_2",
            [
                third_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(third_match),
                    [third_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [third_match], ["case_body_2", "case_unreachable"]),
        ),
        SemanticBlockPlan(
            "case_body_2",
            concat_instructions(
                shallow_pattern_bindings(third_pattern, third_environment),
                third_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%case_result"),
                    [
                        "case_body_0",
                        first_body_plan.result,
                        "case_body_1",
                        second_body_plan.result,
                        "case_body_2",
                        third_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%case_result"], List.new[String]()),
        ),
    ].

plans(
    module_name: String,
    declarations: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case declarations {
        [] -> List.new[SemanticFunctionPlan]();
        [declaration | rest] ->
            prepend_declaration_plan(
                declaration_plan(module_name, declaration, bodies, facts),
                module_name,
                rest,
                bodies,
                facts,
            )
    }.

declaration_plan(
    module_name: String,
    declaration: BackendDeclaration,
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body_for(declaration.symbol_name, bodies) {
        Some(body) -> function_plan(module_name, declaration, body, facts);
        None -> None
    }.

prepend_declaration_plan(
    plan: Option[SemanticFunctionPlan],
    module_name: String,
    rest: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case plan {
        Some(value) -> [value | plans(module_name, rest, bodies, facts)];
        None -> plans(module_name, rest, bodies, facts)
    }.

pub lower(frontend: ProjectedFrontendModule, semantics: LocalSemanticResult): SemanticModulePlan ->
    SemanticModulePlan(
        name = frontend.backend.module_name,
        functions = plans(
            frontend.backend.module_name,
            frontend.backend.declarations,
            frontend.bodies.values,
            semantics.types.facts,
        ),
    ).
