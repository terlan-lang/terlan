/**
 * Converts projected bodies plus local semantic facts into resolved IR plans.
 */
module self_host.ProjectedSemanticIrPlan.

import self_host.BackendSyntax.{BackendDeclaration}.
import self_host.ProjectedBodySyntax.{ProjectedBody}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedFrontendSyntax.{ProjectedFrontendModule}.
import self_host.ProjectedLocalSemanticSyntax.{LocalSemanticResult}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact}.
import self_host.SelfHostIrSyntax.{IrParameter}.
import self_host.SelfHostSemanticIrSyntax.{SemanticBlockPlan, SemanticFunctionPlan, SemanticInstructionPlan, SemanticModulePlan, SemanticTerminatorPlan}.
import self_host.TypedModuleSyntax.{FunctionPayload, MethodPayload}.
import self_host.{BackendSyntax, ParameterSyntax, ProjectedBodySyntax, ProjectedExpressionSyntax, ProjectedFrontendSyntax, ProjectedLocalSemanticSyntax, ProjectedTypeConstraintSyntax, SelfHostIrSyntax, SelfHostSemanticIrSyntax, TypedModuleSyntax}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Bool, Int, String}.

struct ExpressionPlan {
    next_id: Int,
    result: String,
    result_type: Option[String],
    instructions: List[SemanticInstructionPlan],
}.

constructor ExpressionPlan {
    (next_id: Int, result: String, result_type: Option[String], instructions: List[SemanticInstructionPlan]): ExpressionPlan ->
        ExpressionPlan {
            next_id: next_id,
            result: result,
            result_type: result_type,
            instructions: instructions,
        }
}.

struct ChildrenPlan {
    next_id: Int,
    results: List[String],
    instructions: List[SemanticInstructionPlan],
}.

constructor ChildrenPlan {
    (next_id: Int, results: List[String], instructions: List[SemanticInstructionPlan]): ChildrenPlan ->
        ChildrenPlan {next_id: next_id, results: results, instructions: instructions}
}.

struct ExpressionPair {
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
}.

struct ExpressionTriple {
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    third: ProjectedExpressionNode,
}.

struct ExpressionQuad {
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    third: ProjectedExpressionNode,
    fourth: ProjectedExpressionNode,
}.

expression_pair(values: List[ProjectedExpressionNode]): Option[ExpressionPair] ->
    let Some(first) <- values.first() else {
        None -> None
    };
    (let Some(after_first) <- values.rest() else {
    None -> None
};
(let Some(second) <- after_first.first() else {
    None -> None
};
(let Some(tail) <- after_first.rest() else {
    None -> None
};
(let true <- tail.is_empty() else {
    false -> None
};
Some(ExpressionPair {first: first, second: second}))))).

expression_triple(values: List[ProjectedExpressionNode]): Option[ExpressionTriple] ->
    let Some(first) <- values.first() else {
        None -> None
    };
    (let Some(rest) <- values.rest() else {
    None -> None
};
(let Some(pair) <- expression_pair(rest) else {
    None -> None
};
Some(ExpressionTriple {first: first, second: pair.first, third: pair.second}))).

expression_quad(values: List[ProjectedExpressionNode]): Option[ExpressionQuad] ->
    let Some(first) <- values.first() else {
        None -> None
    };
    (let Some(rest) <- values.rest() else {
    None -> None
};
(let Some(triple) <- expression_triple(rest) else {
    None -> None
};
Some(
    ExpressionQuad {first: first, second: triple.first, third: triple.second, fourth: triple.third},
))).

reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

prepend_reversed[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> prepend_reversed(rest, [value | output])
    }.

concat[T](left: List[T], right: List[T]): List[T] ->
    prepend_reversed(reverse_at(left, List.new[T]()), right).

concat_instructions(
    left: List[SemanticInstructionPlan],
    right: List[SemanticInstructionPlan],
): List[SemanticInstructionPlan] ->
    concat(left, right).

parameter_count(values: List[IrParameter]): Int ->
    case values {
        [] -> 0;
        [_ | rest] -> 1 + parameter_count(rest)
    }.

ir_parameters(values: List[ParameterSyntax]): List[IrParameter] ->
    case values {
        [] -> List.new[IrParameter]();
        [value | rest] -> [parameter(value) | ir_parameters(rest)]
    }.

shallow_pattern_supported(pattern: ProjectedExpressionNode): Bool ->
    case pattern.children {
        [] -> true;
        [first | rest] -> shallow_pattern_supported_tail(first, rest)
    }.

shallow_pattern_supported_tail(
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): Bool ->
    case rest {
        [] -> first.children == [];
        [second | tail] -> shallow_pattern_supported_pair(first, second, tail)
    }.

shallow_pattern_supported_pair(
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): Bool ->
    if {
        rest == [] -> first.children == [] and second.children == [];
        true -> false
    }.

shallow_pattern_operands(subject: String, pattern: ProjectedExpressionNode): List[String] ->
    case pattern.children {
        [] -> [subject, pattern.kind, pattern.text, "0"];
        [first | rest] -> shallow_pattern_operand_tail(subject, pattern, first, rest)
    }.

shallow_pattern_operand_tail(
    subject: String,
    pattern: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): List[String] ->
    case rest {
        [] -> [subject, pattern.kind, pattern.text, "1", first.kind, first.text, "0"];
        [second | tail] -> shallow_pattern_operand_pair(subject, pattern, first, second, tail)
    }.

shallow_pattern_operand_pair(
    subject: String,
    pattern: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): List[String] ->
    if {
        rest == [] -> [
            subject,
            pattern.kind,
            pattern.text,
            "2",
            first.kind,
            first.text,
            "0",
            second.kind,
            second.text,
            "0",
        ];
        true -> List.new[String]()
    }.

shallow_binding(
    value: ProjectedExpressionNode,
    environment: String,
): List[SemanticInstructionPlan] ->
    if {
        value.kind == "binding-pattern" -> [
            SemanticInstructionPlan(
                "get-pattern-binding",
                some_string(value.text),
                [environment, Int.to_string(value.start_byte)],
                some_string("Dynamic"),
            ),
        ];
        true -> List.new[SemanticInstructionPlan]()
    }.

shallow_pattern_bindings(
    pattern: ProjectedExpressionNode,
    environment: String,
): List[SemanticInstructionPlan] ->
    let root = shallow_binding(pattern, environment);
    case pattern.children {
        [] -> root;
        [first | rest] -> shallow_pattern_binding_tail(root, first, rest, environment)
    }.

shallow_pattern_binding_tail(
    root: List[SemanticInstructionPlan],
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
    environment: String,
): List[SemanticInstructionPlan] ->
    case rest {
        [] -> concat_instructions(root, shallow_binding(first, environment));
        [second | tail] -> shallow_pattern_binding_pair(root, first, second, tail, environment)
    }.

shallow_pattern_binding_pair(
    root: List[SemanticInstructionPlan],
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
    environment: String,
): List[SemanticInstructionPlan] ->
    if {
        rest == [] -> concat_instructions(
            root,
            concat_instructions(
                shallow_binding(first, environment),
                shallow_binding(second, environment),
            ),
        );
        true -> List.new[SemanticInstructionPlan]()
    }.

node_size(node: ProjectedExpressionNode): Int ->
    1 + child_sizes(node.children).

child_sizes(values: List[ProjectedExpressionNode]): Int ->
    case values {
        [] -> 0;
        [value | rest] -> node_size(value) + child_sizes(rest)
    }.

register(node_id: Int): String ->
    String.append("%", Int.to_string(node_id)).

indexed_label(prefix: String, index: Int): String ->
    String.append(prefix, Int.to_string(index)).

fact_type(byte_offset: Int, values: List[InferredTypeFact]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> select_fact_type(byte_offset, value, rest)
    }.

select_fact_type(
    byte_offset: Int,
    value: InferredTypeFact,
    rest: List[InferredTypeFact],
): Option[String] ->
    if {
        value.byte_offset == byte_offset -> value.type_name;
        true -> fact_type(byte_offset, rest)
    }.

parameter_type(name: String, values: List[IrParameter]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> select_parameter_type(name, value, rest)
    }.

select_parameter_type(name: String, value: IrParameter, rest: List[IrParameter]): Option[String] ->
    if {
        value.name == name -> Some(value.type_name);
        true -> parameter_type(name, rest)
    }.

some_string(value: String): Option[String] ->
    Some(value).

none_string(): Option[String] ->
    None.

resolved_or_dynamic(value: Option[String]): Option[String] ->
    case value {
        Some(name) -> some_string(name);
        None -> some_string("Dynamic")
    }.

last_expression_type(
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case values {
        [] -> none_string();
        [value] -> expression_type(value, facts, parameters);
        [_ | rest] -> last_expression_type(rest, facts, parameters)
    }.

expression_type(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case fact_type(node.start_byte, facts) {
        Some(name) -> some_string(name);
        None -> expression_type_without_fact(node, facts, parameters)
    }.

expression_type_without_fact(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "identifier" or node.kind == "atom" -> expression_identifier_type(node.text, parameters);
        true -> expression_type_after_identifier(node, facts, parameters)
    }.

expression_identifier_type(text: String, parameters: List[IrParameter]): Option[String] ->
    case parameter_type(text, parameters) {
        Some(name) -> some_string(name);
        None -> some_string("Dynamic")
    }.

expression_type_after_identifier(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "integer" -> some_string("Int");
        true -> expression_type_after_integer(node, facts, parameters)
    }.

expression_type_after_integer(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "float" -> some_string("Float");
        true -> expression_type_after_float(node, facts, parameters)
    }.

expression_type_after_float(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "string" -> some_string("String");
        true -> expression_type_after_string(node, facts, parameters)
    }.

expression_type_after_string(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "constructor" -> some_string(node.text);
        true -> expression_type_after_constructor(node, facts, parameters)
    }.

expression_type_after_constructor(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "primary" and (node.text == "true" or node.text == "false") -> some_string("Bool");
        true -> expression_type_after_boolean(node, facts, parameters)
    }.

expression_type_after_boolean(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "primary" -> some_string("Dynamic");
        true -> expression_type_after_primary(node, facts, parameters)
    }.

expression_type_after_primary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "call" or node.kind == "field" or node.kind == "index" -> some_string("Dynamic");
        true -> expression_type_after_dynamic(node, facts, parameters)
    }.

expression_type_after_dynamic(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "list" or node.kind == "list-cons" or node.kind == "list-comprehension" -> some_string("List");
        true -> expression_type_after_list(node, facts, parameters)
    }.

expression_type_after_list(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "tuple" -> some_string("Tuple");
        true -> expression_type_after_tuple(node, facts, parameters)
    }.

expression_type_after_tuple(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "tuple-or-group" -> tuple_or_group_type(node, facts, parameters);
        true -> expression_type_after_group(node, facts, parameters)
    }.

tuple_or_group_type(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.children.length() == 1 -> last_expression_type(node.children, facts, parameters);
        true -> some_string("Tuple")
    }.

expression_type_after_group(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "cast" -> some_string(node.text);
        true -> expression_type_after_cast(node, facts, parameters)
    }.

expression_type_after_cast(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "sequence"
            or node.kind == "call-arguments"
            or node.kind == "named-argument"
            or node.kind == "let"
            or node.kind == "let-refutable" -> last_expression_type(node.children, facts, parameters);
        true -> expression_type_after_structural(node, facts, parameters)
    }.

expression_type_after_structural(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "binary" and boolean_binary_operator(node.text) -> some_string("Bool");
        true -> expression_type_after_boolean_binary(node, facts, parameters)
    }.

boolean_binary_operator(operator: String): Bool ->
    operator == "=="
        or operator == "!="
        or operator == "<"
        or operator == ">"
        or operator == "<="
        or operator == ">="
        or operator == "in"
        or operator == "and"
        or operator == "or".

expression_type_after_boolean_binary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "binary" -> binary_expression_type(node.children, facts, parameters);
        true -> expression_type_after_binary(node, facts, parameters)
    }.

binary_expression_type(
    children: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case children {
        [left, right] ->
            binary_expression_type_from_left(
                expression_type(left, facts, parameters),
                right,
                facts,
                parameters,
            );
        _ -> some_string("Dynamic")
    }.

binary_expression_type_from_left(
    left_type: Option[String],
    right: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case left_type {
        Some(left_name) ->
            matching_expression_type(left_name, expression_type(right, facts, parameters));
        None -> some_string("Dynamic")
    }.

matching_expression_type(left_name: String, right_type: Option[String]): Option[String] ->
    case right_type {
        Some(right_name) where left_name == right_name -> some_string(left_name);
        _ -> some_string("Dynamic")
    }.

expression_type_after_binary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "unary" and (node.text == "not" or node.text == "!") -> some_string("Bool");
        true -> expression_type_after_boolean_unary(node, facts, parameters)
    }.

expression_type_after_boolean_unary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "unary" -> unary_expression_type(node.children, facts, parameters);
        true -> none_string()
    }.

unary_expression_type(
    children: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case children {
        [operand] -> expression_type(operand, facts, parameters);
        _ -> some_string("Dynamic")
    }.

last_string(values: List[String]): String ->
    case values {
        [] -> "";
        [value] -> value;
        [_ | rest] -> last_string(rest)
    }.

binary_opcode(text: String): String ->
    if {
        text == "+" -> "add-small";
        true -> binary_sub_opcode(text)
    }.

binary_sub_opcode(text: String): String ->
    if {
        text == "-" -> "sub-small";
        true -> binary_mul_opcode(text)
    }.

binary_mul_opcode(text: String): String ->
    if {
        text == "*" -> "mul-small";
        true -> binary_div_opcode(text)
    }.

binary_div_opcode(text: String): String ->
    if {
        text == "/" or text == "div" -> "div-small";
        true -> binary_rem_opcode(text)
    }.

binary_rem_opcode(text: String): String ->
    if {
        text == "rem" -> "rem-small";
        true -> binary_equal_opcode(text)
    }.

binary_equal_opcode(text: String): String ->
    if {
        text == "==" -> "equal";
        true -> binary_less_opcode(text)
    }.

binary_less_opcode(text: String): String ->
    if {
        text == "<" -> "less-small";
        true -> String.append("binary-", text)
    }.

node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "integer"
            or node.kind == "float"
            or node.kind == "string"
            or node.kind == "constructor"
            or node.kind == "primary" -> "load-literal";
        true -> move_node_opcode(node)
    }.

move_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "identifier" or node.kind == "atom" -> "move";
        true -> binary_node_opcode(node)
    }.

binary_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "binary" -> binary_opcode(node.text);
        true -> negative_node_opcode(node)
    }.

negative_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "unary" and node.text == "-" -> "neg-small";
        true -> unary_node_opcode(node)
    }.

unary_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "unary" -> String.append("unary-", node.text);
        true -> list_node_opcode(node)
    }.

list_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "list" or node.kind == "list-cons" or node.kind == "list-comprehension" -> "put-list";
        true -> tuple_node_opcode(node)
    }.

tuple_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "tuple-or-group" or node.kind == "tuple" -> "put-tuple";
        true -> field_node_opcode(node)
    }.

field_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "field" -> "get-map-elements";
        true -> index_node_opcode(node)
    }.

index_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "index" -> "get-tuple-element";
        true -> cast_node_opcode(node)
    }.

cast_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "cast" -> "move";
        true -> String.append("unsupported-", node.kind)
    }.

literal_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "integer"
            or node.kind == "float"
            or node.kind == "string"
            or node.kind == "atom"
            or node.kind == "constructor"
            or node.kind == "primary" -> [node.text];
        true -> identifier_operands(node)
    }.

identifier_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "identifier" -> [node.text];
        true -> field_operands(node)
    }.

field_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "field" -> [node.text];
        true -> List.new[String]()
    }.

lower_children(
    values: List[ProjectedExpressionNode],
    next_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ChildrenPlan ->
    case values {
        [] ->
            ChildrenPlan(
                next_id = next_id,
                results = List.new[String](),
                instructions = List.new[SemanticInstructionPlan](),
            );
        [value | rest] ->
            let lowered = lower_expression(value, next_id, facts, parameters);
            let remaining = lower_children(rest, lowered.next_id, facts, parameters);
            ChildrenPlan(
                next_id = remaining.next_id,
                results = [lowered.result | remaining.results],
                instructions = concat(lowered.instructions, remaining.instructions),
            )
    }.

call_identity(callee: ProjectedExpressionNode): List[String] ->
    if {
        callee.kind == "field" -> field_call_identity(callee, callee.children);
        true -> [callee.text]
    }.

field_call_identity(
    callee: ProjectedExpressionNode,
    values: List[ProjectedExpressionNode],
): List[String] ->
    case values {
        [base | _rest] -> [base.text, callee.text];
        [] -> [callee.text]
    }.

call_opcode(callee: ProjectedExpressionNode): String ->
    if {
        callee.kind == "field" -> "call-import";
        true -> "call-local"
    }.

lower_call_arguments(
    values: List[ProjectedExpressionNode],
    next_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ChildrenPlan ->
    case values {
        [sequence] where sequence.kind == "sequence" or sequence.kind == "call-arguments" ->
            lower_children(sequence.children, next_id + 1, facts, parameters);
        _ -> lower_children(values, next_id, facts, parameters)
    }.

lower_call(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case node.children {
        [callee | arguments] ->
            let argument_start = node_id + 1 + node_size(callee);
            let lowered = lower_call_arguments(arguments, argument_start, facts, parameters);
            let result = register(node_id);
            let instruction_result = some_string(result);
            let resolved_type = expression_type(node, facts, parameters);
            let operands = concat(call_identity(callee), lowered.results);
            let instruction =
                SemanticInstructionPlan(
                    opcode = call_opcode(callee),
                    result = instruction_result,
                    operands = operands,
                    resolved_type = resolved_type,
                );
            let instructions = concat(lowered.instructions, [instruction]);
            ExpressionPlan(
                next_id = node_id + node_size(node),
                result = result,
                result_type = resolved_type,
                instructions = instructions,
            );
        _ ->
            let result = register(node_id);
            let instruction_result = some_string(result);
            ExpressionPlan(
                next_id = node_id + node_size(node),
                result = result,
                result_type = None,
                instructions = [
                    SemanticInstructionPlan(
                        opcode = "unsupported-call",
                        result = instruction_result,
                        operands = List.new[String](),
                        resolved_type = None,
                    ),
                ],
            )
    }.

lower_let(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case node.children {
        [pattern | rest] -> lower_let_source(node, node_id, pattern, rest, facts, parameters);
        [] -> empty_let_plan(node, node_id)
    }.

lower_let_source(
    node: ProjectedExpressionNode,
    node_id: Int,
    pattern: ProjectedExpressionNode,
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case values {
        [source | rest] ->
            lower_let_continuation(node, node_id, pattern, source, rest, facts, parameters);
        [] -> empty_let_plan(node, node_id)
    }.

lower_let_continuation(
    node: ProjectedExpressionNode,
    node_id: Int,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case values {
        [continuation | fallback] ->
            build_lower_let(
                node,
                node_id,
                pattern,
                source,
                continuation,
                fallback,
                facts,
                parameters,
            );
        [] -> empty_let_plan(node, node_id)
    }.

build_lower_let(
    node: ProjectedExpressionNode,
    node_id: Int,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    fallback: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let source_id = node_id + 1 + node_size(pattern);
    let lowered_source = lower_expression(source, source_id, facts, parameters);
    let lowered_continuation = lower_expression(continuation, lowered_source.next_id, facts, parameters);
    let lowered_fallback = lower_children(fallback, lowered_continuation.next_id, facts, parameters);
    let binding = lower_let_binding(pattern, lowered_source);
    ExpressionPlan(
        next_id = node_id + node_size(node),
        result = lowered_continuation.result,
        result_type = expression_type(node, facts, parameters),
        instructions = concat(
            lowered_source.instructions,
            concat(
                binding,
                concat(lowered_continuation.instructions, lowered_fallback.instructions),
            ),
        ),
    ).

lower_let_binding(
    pattern: ProjectedExpressionNode,
    source: ExpressionPlan,
): List[SemanticInstructionPlan] ->
    if {
        pattern.kind == "binding-pattern" -> [
            SemanticInstructionPlan(
                opcode = "move",
                result = some_string(pattern.text),
                operands = [source.result],
                resolved_type = resolved_or_dynamic(source.result_type),
            ),
        ];
        true -> List.new[SemanticInstructionPlan]()
    }.

empty_let_plan(node: ProjectedExpressionNode, node_id: Int): ExpressionPlan ->
    ExpressionPlan(
        next_id = node_id + node_size(node),
        result = register(node_id),
        result_type = None,
        instructions = List.new[SemanticInstructionPlan](),
    ).

leaf_selection_value(node: ProjectedExpressionNode): Bool ->
    node.kind == "integer"
        or node.kind == "float"
        or node.kind == "string"
        or node.kind == "constructor"
        or node.kind == "primary"
        or node.kind == "identifier"
        or node.kind == "atom".

leaf_if_supported(node: ProjectedExpressionNode): Bool ->
    case node.children {
        [first, second] -> leaf_if_first_supported(first, second);
        _ -> false
    }.

leaf_if_first_supported(first: ProjectedExpressionNode, second: ProjectedExpressionNode): Bool ->
    case first.children {
        [_first_condition, first_body] -> leaf_if_second_supported(first_body, second);
        _ -> false
    }.

leaf_if_second_supported(
    first_body: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
): Bool ->
    case second.children {
        [second_condition, second_body] ->
            second_condition.text == "true"
                and leaf_selection_value(first_body)
                and leaf_selection_value(second_body);
        _ -> false
    }.

pure_selection_condition(node: ProjectedExpressionNode): Bool ->
    if {
        leaf_selection_value(node) -> true;
        true -> pure_selection_node(node)
    }.

pure_selection_node(node: ProjectedExpressionNode): Bool ->
    if {
        node.kind == "unary" or node.kind == "tuple-or-group" -> pure_selection_single_child(node.children);
        true -> pure_selection_binary_node(node)
    }.

pure_selection_binary_node(node: ProjectedExpressionNode): Bool ->
    if {
        node.kind == "binary" -> pure_selection_binary_children(node.children);
        true -> false
    }.

pure_selection_single_child(children: List[ProjectedExpressionNode]): Bool ->
    let Some(value) <- children.first() else {
        None -> false
    };
    (let Some(rest) <- children.rest() else {
    None -> false
};
(let true <- rest.is_empty() else {
    false -> false
};
pure_selection_condition(value))).

pure_selection_binary_children(children: List[ProjectedExpressionNode]): Bool ->
    let Some(pair) <- expression_pair(children) else {
        None -> false
    };
    pure_selection_condition(pair.first) and pure_selection_condition(pair.second).

leaf_if_three_supported(node: ProjectedExpressionNode): Bool ->
    let Some(clauses) <- expression_triple(node.children) else {
        None -> false
    };
    (let Some(first) <- expression_pair(clauses.first.children) else {
    None -> false
};
(let Some(second) <- expression_pair(clauses.second.children) else {
    None -> false
};
(let Some(third) <- expression_pair(clauses.third.children) else {
    None -> false
};
third.first.text == "true"
    and pure_selection_condition(first.first)
    and pure_selection_condition(second.first)
    and leaf_selection_value(first.second)
    and leaf_selection_value(second.second)
    and leaf_selection_value(third.second)))).

leaf_if_chain_clauses_supported(values: List[ProjectedExpressionNode]): Bool ->
    let Some(clause) <- values.first() else {
        None -> false
    };
    (let Some(rest) <- values.rest() else {
    None -> false
};
(let Some(parts) <- expression_pair(clause.children) else {
    None -> false
};
if {
    rest.is_empty() -> parts.first.text == "true" and leaf_selection_value(parts.second);
    true -> pure_selection_condition(parts.first)
        and leaf_selection_value(parts.second)
        and leaf_if_chain_clauses_supported(rest)
})).

leaf_if_long_supported(node: ProjectedExpressionNode): Bool ->
    node.children.length() >= 4 and leaf_if_chain_clauses_supported(node.children).

lower_leaf_if(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case node.children {
        [first, second] -> lower_leaf_if_first(node, node_id, first, second, facts, parameters);
        _ -> unsupported_leaf_if_plan(node, node_id)
    }.

lower_leaf_if_first(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case first.children {
        [first_condition, first_body] ->
            lower_leaf_if_second(
                node,
                node_id,
                first,
                second,
                first_condition,
                first_body,
                facts,
                parameters,
            );
        _ -> unsupported_leaf_if_plan(node, node_id)
    }.

lower_leaf_if_second(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    case second.children {
        [second_condition, second_body] ->
            lower_leaf_if_direct(
                node,
                node_id,
                first,
                first_condition,
                first_body,
                second_condition,
                second_body,
                facts,
                parameters,
            );
        _ -> unsupported_leaf_if_plan(node, node_id)
    }.

lower_leaf_if_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_body_id = second_id + 1 + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let result = register(node_id);
    let result_type = nested_if_result_type(node, first_body_plan, second_body_plan, facts, parameters);
    ExpressionPlan(
        node_id + node_size(node),
        result,
        result_type,
        concat_instructions(
            first_condition_plan.instructions,
            concat_instructions(
                first_body_plan.instructions,
                concat_instructions(
                    second_body_plan.instructions,
                    [
                        SemanticInstructionPlan(
                            "select",
                            some_string(result),
                            [
                                first_condition_plan.result,
                                first_body_plan.result,
                                second_body_plan.result,
                            ],
                            result_type,
                        ),
                    ],
                ),
            ),
        ),
    ).

unsupported_leaf_if_plan(node: ProjectedExpressionNode, node_id: Int): ExpressionPlan ->
    ExpressionPlan(
        node_id + node_size(node),
        register(node_id),
        None,
        List.new[SemanticInstructionPlan](),
    ).

lower_leaf_if_three(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let Some(clauses) <- expression_triple(node.children) else {
        None -> unsupported_leaf_if_plan(node, node_id)
    };
    (let Some(first) <- expression_pair(clauses.first.children) else {
    None -> unsupported_leaf_if_plan(node, node_id)
};
(let Some(second) <- expression_pair(clauses.second.children) else {
    None -> unsupported_leaf_if_plan(node, node_id)
};
(let Some(third) <- expression_pair(clauses.third.children) else {
    None -> unsupported_leaf_if_plan(node, node_id)
};
(let first_condition_plan = lower_expression(first.first, node_id + 2, facts, parameters);
let first_body_id = node_id + 2 + node_size(first.first);
let first_body_plan = lower_expression(first.second, first_body_id, facts, parameters);
let second_id = node_id + 1 + node_size(clauses.first);
let second_condition_id = second_id + 1;
let second_condition_plan = lower_expression(second.first, second_condition_id, facts, parameters);
let second_body_id = second_condition_id + node_size(second.first);
let second_body_plan = lower_expression(second.second, second_body_id, facts, parameters);
let third_id = second_id + node_size(clauses.second);
let third_body_id = third_id + 1 + node_size(third.first);
let third_body_plan = lower_expression(third.second, third_body_id, facts, parameters);
let fallback_type = resolved_or_dynamic(expression_type(node, facts, parameters));
let tail_type =
    matching_plan_result_type(
        second_body_plan.result_type,
        third_body_plan.result_type,
        fallback_type,
    );
let result_type = matching_plan_result_type(first_body_plan.result_type, tail_type, fallback_type);
let tail_result = indexed_label("%leaf_if_tail_", node_id);
let result = register(node_id);
ExpressionPlan(
    node_id + node_size(node),
    result,
    result_type,
    concat_instructions(
        first_condition_plan.instructions,
        concat_instructions(
            first_body_plan.instructions,
            concat_instructions(
                second_condition_plan.instructions,
                concat_instructions(
                    second_body_plan.instructions,
                    concat_instructions(
                        third_body_plan.instructions,
                        [
                            SemanticInstructionPlan(
                                "select",
                                some_string(tail_result),
                                [
                                    second_condition_plan.result,
                                    second_body_plan.result,
                                    third_body_plan.result,
                                ],
                                tail_type,
                            ),
                            SemanticInstructionPlan(
                                "select",
                                some_string(result),
                                [first_condition_plan.result, first_body_plan.result, tail_result],
                                result_type,
                            ),
                        ],
                    ),
                ),
            ),
        ),
    ),
))))).

matching_plan_result_type(
    first: Option[String],
    second: Option[String],
    fallback: Option[String],
): Option[String] ->
    case first {
        Some(first_name) -> matching_plan_second_result_type(first_name, second, fallback);
        None -> fallback
    }.

matching_plan_second_result_type(
    first_name: String,
    second: Option[String],
    fallback: Option[String],
): Option[String] ->
    case second {
        Some(second_name) where first_name == second_name -> some_string(first_name);
        _ -> fallback
    }.

lower_leaf_if_clause_chain(
    values: List[ProjectedExpressionNode],
    clause_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let Some(clause) <- values.first() else {
        None ->
            ExpressionPlan(
                clause_id,
                register(clause_id),
                None,
                List.new[SemanticInstructionPlan](),
            )
    };
    (let Some(rest) <- values.rest() else {
    None ->
        ExpressionPlan(clause_id, register(clause_id), None, List.new[SemanticInstructionPlan]())
};
(let Some(parts) <- expression_pair(clause.children) else {
    None -> unsupported_leaf_if_plan(clause, clause_id)
};
if {
    rest.is_empty() -> lower_leaf_if_last_clause(clause, parts.first, parts.second, clause_id, facts, parameters);
    true -> lower_leaf_if_nonlast_clause(
        clause,
        parts.first,
        parts.second,
        rest,
        clause_id,
        facts,
        parameters,
    )
})).

lower_leaf_if_last_clause(
    clause: ProjectedExpressionNode,
    condition: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    clause_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let body_id = clause_id + 1 + node_size(condition);
    let body_plan = lower_expression(body, body_id, facts, parameters);
    ExpressionPlan(
        clause_id + node_size(clause),
        body_plan.result,
        body_plan.result_type,
        body_plan.instructions,
    ).

lower_leaf_if_nonlast_clause(
    clause: ProjectedExpressionNode,
    condition: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
    clause_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let condition_plan = lower_expression(condition, clause_id + 1, facts, parameters);
    let body_id = clause_id + 1 + node_size(condition);
    let body_plan = lower_expression(body, body_id, facts, parameters);
    let tail_plan = lower_leaf_if_clause_chain(rest, clause_id + node_size(clause), facts, parameters);
    let result = indexed_label("%leaf_if_clause_", clause_id);
    let result_type =
        matching_plan_result_type(
            body_plan.result_type,
            tail_plan.result_type,
            some_string("Dynamic"),
        );
    ExpressionPlan(
        tail_plan.next_id,
        result,
        result_type,
        concat_instructions(
            condition_plan.instructions,
            concat_instructions(
                body_plan.instructions,
                concat_instructions(
                    tail_plan.instructions,
                    [
                        SemanticInstructionPlan(
                            "select",
                            some_string(result),
                            [condition_plan.result, body_plan.result, tail_plan.result],
                            result_type,
                        ),
                    ],
                ),
            ),
        ),
    ).

lower_leaf_if_long(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let lowered = lower_leaf_if_clause_chain(node.children, node_id + 1, facts, parameters);
    ExpressionPlan(
        node_id + node_size(node),
        lowered.result,
        lowered.result_type,
        lowered.instructions,
    ).

lower_expression(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    if {
        node.kind == "call" -> lower_call(node, node_id, facts, parameters);
        true -> lower_expression_after_call(node, node_id, facts, parameters)
    }.

lower_expression_after_call(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    if {
        node.kind == "let" or node.kind == "let-refutable" -> lower_let(node, node_id, facts, parameters);
        true -> lower_expression_after_let(node, node_id, facts, parameters)
    }.

lower_expression_after_let(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    if {
        node.kind == "if" and leaf_if_supported(node) -> lower_leaf_if(node, node_id, facts, parameters);
        true -> lower_expression_after_leaf_if(node, node_id, facts, parameters)
    }.

lower_expression_after_leaf_if(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    if {
        node.kind == "if" and leaf_if_three_supported(node) -> lower_leaf_if_three(node, node_id, facts, parameters);
        true -> lower_expression_after_leaf_if_three(node, node_id, facts, parameters)
    }.

lower_expression_after_leaf_if_three(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    if {
        node.kind == "if" and leaf_if_long_supported(node) -> lower_leaf_if_long(node, node_id, facts, parameters);
        true -> lower_generic_expression(node, node_id, facts, parameters)
    }.

lower_generic_expression(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): ExpressionPlan ->
    let children = lower_children(node.children, node_id + 1, facts, parameters);
    let structural = structural_expression(node);
    let result = expression_result(structural, children.results, node_id);
    let result_type = expression_type(node, facts, parameters);
    let operands = concat(literal_operands(node), children.results);
    let instructions =
        expression_instructions(
            structural,
            node,
            result,
            operands,
            result_type,
            children.instructions,
        );
    ExpressionPlan(
        next_id = node_id + node_size(node),
        result = result,
        result_type = result_type,
        instructions = instructions,
    ).

structural_expression(node: ProjectedExpressionNode): Bool ->
    node.kind == "sequence"
        or node.kind == "call-arguments"
        or node.kind == "named-argument"
        or node.kind == "tuple-or-group" and node.children.length() == 1.

expression_result(structural: Bool, results: List[String], node_id: Int): String ->
    if {
        structural -> last_string(results);
        true -> register(node_id)
    }.

expression_instructions(
    structural: Bool,
    node: ProjectedExpressionNode,
    result: String,
    operands: List[String],
    result_type: Option[String],
    child_instructions: List[SemanticInstructionPlan],
): List[SemanticInstructionPlan] ->
    if {
        structural -> child_instructions;
        true -> concat(
            child_instructions,
            [
                SemanticInstructionPlan(
                    opcode = node_opcode(node),
                    result = some_string(result),
                    operands = operands,
                    resolved_type = result_type,
                ),
            ],
        )
    }.

parameter(value: ParameterSyntax): IrParameter ->
    IrParameter(value.name, parameter_annotation_type(value)).

parameter_annotation_type(value: ParameterSyntax): String ->
    if {
        value.has_annotation and value.annotation.valid -> value.annotation.syntax.text;
        true -> "Dynamic"
    }.

resolved_return(declared: String, inferred: Option[String]): Option[String] ->
    if {
        declared == "" -> resolved_or_dynamic(inferred);
        true -> some_string(declared)
    }.

body_for(name: String, values: List[ProjectedBody]): Option[ProjectedBody] ->
    case values {
        [] -> None;
        [value | rest] -> select_body(name, value, rest)
    }.

select_body(
    name: String,
    value: ProjectedBody,
    rest: List[ProjectedBody],
): Option[ProjectedBody] ->
    let direct = String.append(name, "(");
    let qualified = String.append(" ", direct);
    if {
        String.starts_with(value.declaration_head, direct)
            or String.contains(value.declaration_head, qualified) -> Some(value);
        true -> body_for(name, rest)
    }.

nested_if_result_type(
    source: ProjectedExpressionNode,
    first: ExpressionPlan,
    second: ExpressionPlan,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case first.result_type {
        Some(first_name) ->
            nested_if_second_result_type(first_name, second.result_type, source, facts, parameters);
        None -> resolved_or_dynamic(expression_type(source, facts, parameters))
    }.

nested_if_second_result_type(
    first_name: String,
    second_type: Option[String],
    source: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case second_type {
        Some(second_name) where first_name == second_name -> some_string(first_name);
        _ -> resolved_or_dynamic(expression_type(source, facts, parameters))
    }.

nested_if_cfg(
    pattern: ProjectedExpressionNode,
    result: String,
    result_type: Option[String],
    entry_instructions: List[SemanticInstructionPlan],
    first_condition: ExpressionPlan,
    first_body: ExpressionPlan,
    second_condition: ExpressionPlan,
    second_body: ExpressionPlan,
    continuation: ExpressionPlan,
): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, first_condition.instructions),
            SemanticTerminatorPlan(
                "branch",
                [first_condition.result],
                ["nested_if_body_0", "nested_if_condition_1"],
            ),
        ),
        SemanticBlockPlan(
            "nested_if_body_0",
            first_body.instructions,
            SemanticTerminatorPlan("jump", List.new[String](), ["nested_if_join"]),
        ),
        SemanticBlockPlan(
            "nested_if_condition_1",
            second_condition.instructions,
            SemanticTerminatorPlan(
                "branch",
                [second_condition.result],
                ["nested_if_body_1", "nested_if_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "nested_if_body_1",
            second_body.instructions,
            SemanticTerminatorPlan("jump", List.new[String](), ["nested_if_join"]),
        ),
        SemanticBlockPlan(
            "nested_if_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "nested_if_join",
            concat_instructions(
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            "nested_if_body_0",
                            first_body.result,
                            "nested_if_body_1",
                            second_body.result,
                        ],
                        result_type,
                    ),
                    SemanticInstructionPlan(
                        "move",
                        some_string(pattern.text),
                        [result],
                        result_type,
                    ),
                ],
                continuation.instructions,
            ),
            SemanticTerminatorPlan("return", [continuation.result], List.new[String]()),
        ),
    ].

nested_let_if_two(
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    let source_id = node_id + 1 + node_size(pattern);
    let first_condition_plan = lower_expression(first_condition, source_id + 2, facts, parameters);
    let first_body_plan = lower_expression(first_body, source_id + 2 + node_size(first_condition), facts, parameters);
    let second_id = source_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_plan =
        lower_expression(
            second_body,
            second_condition_id + node_size(second_condition),
            facts,
            parameters,
        );
    let continuation_plan = lower_expression(continuation, source_id + node_size(source), facts, parameters);
    let result_type = nested_if_result_type(source, first_body_plan, second_body_plan, facts, parameters);
    nested_if_cfg(
        pattern,
        register(source_id),
        result_type,
        entry_instructions,
        first_condition_plan,
        first_body_plan,
        second_condition_plan,
        second_body_plan,
        continuation_plan,
    ).

linear_binding(
    pattern: ProjectedExpressionNode,
    source: ExpressionPlan,
): List[SemanticInstructionPlan] ->
    if {
        pattern.kind == "binding-pattern" -> [
            SemanticInstructionPlan(
                "move",
                some_string(pattern.text),
                [source.result],
                resolved_or_dynamic(source.result_type),
            ),
        ];
        true -> List.new[SemanticInstructionPlan]()
    }.

nested_let_if_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let true <- node.kind == "let" else {
        false -> None
    };
    (let Some(parts) <- expression_triple(node.children) else {
    None -> None
};
(let true <- parts.first.kind == "binding-pattern" else {
    false -> None
};
nested_let_if_source_at(
    parts.first,
    parts.second,
    parts.third,
    node_id,
    entry_instructions,
    facts,
    parameters,
))).

nested_let_if_source_at(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        source.kind == "if" -> nested_let_if_source_children_at(
            pattern,
            source,
            continuation,
            node_id,
            entry_instructions,
            facts,
            parameters,
        );
        true -> nested_let_if_continuation_at(
            pattern,
            source,
            continuation,
            node_id,
            entry_instructions,
            facts,
            parameters,
        )
    }.

nested_let_if_source_children_at(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case source.children {
        [first, second] ->
            nested_let_if_first_at(
                pattern,
                source,
                continuation,
                first,
                second,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

nested_let_if_first_at(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case first.children {
        [first_condition, first_body] ->
            nested_let_if_second_at(
                pattern,
                source,
                continuation,
                first,
                second,
                first_condition,
                first_body,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

nested_let_if_second_at(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case second.children {
        [second_condition, second_body] ->
            Some(
                nested_let_if_two(
                    node_id,
                    entry_instructions,
                    pattern,
                    source,
                    continuation,
                    first,
                    second,
                    first_condition,
                    first_body,
                    second_condition,
                    second_body,
                    facts,
                    parameters,
                ),
            );
        _ -> None
    }.

nested_let_if_continuation_at(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let source_id = node_id + 1 + node_size(pattern);
    let source_plan = lower_expression(source, source_id, facts, parameters);
    let next_instructions =
        concat_instructions(
            entry_instructions,
            concat_instructions(source_plan.instructions, linear_binding(pattern, source_plan)),
        );
    nested_let_if_at(
        continuation,
        source_id + node_size(source),
        next_instructions,
        facts,
        parameters,
    ).

nested_let_if_blocks(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    nested_let_if_at(node, 0, List.new[SemanticInstructionPlan](), facts, parameters).

struct EmbeddedBranchPlan {
    blocks: List[SemanticBlockPlan],
    result: String,
    exit_label: String,
}.

constructor EmbeddedBranchPlan {
    (blocks: List[SemanticBlockPlan], result: String, exit_label: String): EmbeddedBranchPlan ->
        EmbeddedBranchPlan {blocks: blocks, result: result, exit_label: exit_label}
}.

embedded_label(prefix: String, suffix: String): String ->
    String.append(prefix, suffix).

embedded_if_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    let Some(clauses) <- expression_pair(node.children) else {
        None -> None
    };
    (let Some(first) <- expression_pair(clauses.first.children) else {
    None -> None
};
(let Some(second) <- expression_pair(clauses.second.children) else {
    None -> None
};
Some(
    embedded_if_two_blocks(
        node,
        node_id,
        clauses.first,
        first.first,
        first.second,
        second.first,
        second.second,
        entry_label,
        label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ),
))).

embedded_if_two_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_id = second_condition_id + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_condition_label = embedded_label(label_prefix, "condition_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let result = register(node_id);
    let result_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            resolved_or_dynamic(expression_type(node, facts, parameters)),
        );
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, first_condition_plan.instructions),
                SemanticTerminatorPlan(
                    "branch",
                    [first_condition_plan.result],
                    [first_body_label, second_condition_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                first_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_condition_label,
                second_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [second_condition_plan.result],
                    [second_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                second_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_if_three_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    let Some(clauses) <- expression_triple(node.children) else {
        None -> None
    };
    (let Some(first) <- expression_pair(clauses.first.children) else {
    None -> None
};
(let Some(second) <- expression_pair(clauses.second.children) else {
    None -> None
};
(let Some(third) <- expression_pair(clauses.third.children) else {
    None -> None
};
Some(
    embedded_if_three_blocks(
        node,
        node_id,
        clauses.first,
        clauses.second,
        first.first,
        first.second,
        second.first,
        second.second,
        third.first,
        third.second,
        entry_label,
        label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ),
)))).

embedded_if_three_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_condition: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_condition: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_condition: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    entry_label: String,
    label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): EmbeddedBranchPlan ->
    let first_condition_plan = lower_expression(first_condition, node_id + 2, facts, parameters);
    let first_body_id = node_id + 2 + node_size(first_condition);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = node_id + 1 + node_size(first);
    let second_condition_id = second_id + 1;
    let second_condition_plan = lower_expression(second_condition, second_condition_id, facts, parameters);
    let second_body_id = second_condition_id + node_size(second_condition);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    let third_id = second_id + node_size(second);
    let third_condition_id = third_id + 1;
    let third_condition_plan = lower_expression(third_condition, third_condition_id, facts, parameters);
    let third_body_id = third_condition_id + node_size(third_condition);
    let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
    let first_body_label = embedded_label(label_prefix, "body_0");
    let second_condition_label = embedded_label(label_prefix, "condition_1");
    let second_body_label = embedded_label(label_prefix, "body_1");
    let third_condition_label = embedded_label(label_prefix, "condition_2");
    let third_body_label = embedded_label(label_prefix, "body_2");
    let unreachable_label = embedded_label(label_prefix, "unreachable");
    let join_label = embedded_label(label_prefix, "join");
    let result = register(node_id);
    let fallback_type = resolved_or_dynamic(expression_type(node, facts, parameters));
    let first_two_type =
        matching_plan_result_type(
            first_body_plan.result_type,
            second_body_plan.result_type,
            fallback_type,
        );
    let result_type = matching_plan_result_type(first_two_type, third_body_plan.result_type, fallback_type);
    EmbeddedBranchPlan(
        [
            SemanticBlockPlan(
                entry_label,
                concat_instructions(entry_instructions, first_condition_plan.instructions),
                SemanticTerminatorPlan(
                    "branch",
                    [first_condition_plan.result],
                    [first_body_label, second_condition_label],
                ),
            ),
            SemanticBlockPlan(
                first_body_label,
                first_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                second_condition_label,
                second_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [second_condition_plan.result],
                    [second_body_label, third_condition_label],
                ),
            ),
            SemanticBlockPlan(
                second_body_label,
                second_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                third_condition_label,
                third_condition_plan.instructions,
                SemanticTerminatorPlan(
                    "branch",
                    [third_condition_plan.result],
                    [third_body_label, unreachable_label],
                ),
            ),
            SemanticBlockPlan(
                third_body_label,
                third_body_plan.instructions,
                SemanticTerminatorPlan("jump", List.new[String](), [join_label]),
            ),
            SemanticBlockPlan(
                unreachable_label,
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
            ),
            SemanticBlockPlan(
                join_label,
                [
                    SemanticInstructionPlan(
                        "phi",
                        some_string(result),
                        [
                            first_body_label,
                            first_body_plan.result,
                            second_body_label,
                            second_body_plan.result,
                            third_body_label,
                            third_body_plan.result,
                        ],
                        result_type,
                    ),
                ],
                SemanticTerminatorPlan("jump", List.new[String](), [join_target]),
            ),
        ],
        result,
        join_label,
    ).

embedded_if_four_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
