/**
 * Converts projected bodies plus local semantic facts into resolved IR plans.
 */
module self_host.ProjectedSemanticIrPlan.

import self_host.BackendSyntax.{BackendDeclaration}.
import self_host.ProjectedBodySyntax.{ProjectedBody}.
import self_host.ProjectedExpressionIrPlan.{lower_expression}.
import self_host.ProjectedExpressionSupportIrPlan.{ExpressionPlan, append_ir_parameters, body_for, concat_blocks, concat_instructions, ir_parameters, lambda_body, lambda_body_id, lambda_captures, lambda_parameters, lambda_symbol, node_size, none_string, parameter, parameter_count, resolved_or_dynamic, resolved_return, shallow_pattern_bindings, shallow_pattern_operands, shallow_pattern_supported, some_string}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedFrontendSyntax.{ProjectedFrontendModule}.
import self_host.ProjectedLocalSemanticSyntax.{LocalSemanticResult}.
import self_host.ProjectedEmbeddedControlIrPlan.{EmbeddedBranchPlan, embedded_case_at, embedded_if_any_at, root_embedded_if_blocks, root_refutable_let_blocks}.
import self_host.ProjectedNestedControlIrPlan.{ExpressionNodePair, ExpressionNodeQuad, ExpressionNodeTriple, expression_node_pair, expression_node_quad, expression_node_triple, linear_binding, nested_let_if_blocks}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact}.
import self_host.SelfHostIrSyntax.{IrParameter}.
import self_host.SelfHostSemanticIrSyntax.{SemanticBlockPlan, SemanticFunctionPlan, SemanticInstructionPlan, SemanticModulePlan, SemanticTerminatorPlan}.
import self_host.TypedModuleSyntax.{FunctionPayload, MethodPayload}.
import self_host.{BackendSyntax, FunctionSyntax, MethodSyntax, ParameterSyntax, ProjectedBodySyntax, ProjectedEmbeddedControlIrPlan, ProjectedExpressionSupportIrPlan, ProjectedExpressionSyntax, ProjectedFrontendSyntax, ProjectedLocalSemanticSyntax, ProjectedNestedControlIrPlan, ProjectedTypeConstraintSyntax, SelfHostIrSyntax, SelfHostSemanticIrSyntax, TypedModuleSyntax}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Bool, Int, String}.

root_case_one_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_pair(node.children) {
        Some(parts) ->
            root_case_one_direct_clause(
                parts.first,
                expression_node_pair(parts.second.children),
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_direct_clause(
    subject: ProjectedExpressionNode,
    clause: Option[ExpressionNodePair],
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case clause {
        Some(parts) ->
            root_case_one_direct_supported(
                shallow_pattern_supported(parts.first),
                subject,
                parts.first,
                parts.second,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_direct_supported(
    valid: Bool,
    subject: ProjectedExpressionNode,
    pattern: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_one_direct_bound(
                subject,
                pattern,
                body,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_one_direct_bound(
    subject: ProjectedExpressionNode,
    pattern: ProjectedExpressionNode,
    body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let subject_plan = lower_expression(subject, node_id + 1, facts, parameters);
    let clause_id = node_id + 1 + node_size(subject);
    let body_id = clause_id + 1 + node_size(pattern);
    let body_plan = lower_expression(body, body_id, facts, parameters);
    Some(root_case_one_blocks(entry_instructions, subject_plan, pattern, body_plan)).

root_case_one_blocks(
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    pattern: ProjectedExpressionNode,
    body_plan: ExpressionPlan,
): List[SemanticBlockPlan] ->
    let environment = "%root_case_environment_0";
    let matched = "%root_case_match_0";
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, subject_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_0",
            [
                SemanticInstructionPlan(
                    "prepare-pattern",
                    some_string(environment),
                    shallow_pattern_operands(subject_plan.result, pattern),
                    some_string("PatternMatch"),
                ),
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(matched),
                    [environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [matched],
                ["root_case_body_0", "root_case_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_0",
            concat_instructions(
                shallow_pattern_bindings(pattern, environment),
                body_plan.instructions,
            ),
            SemanticTerminatorPlan("return", [body_plan.result], List.new[String]()),
        ),
        SemanticBlockPlan(
            "root_case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
    ].

root_case_one_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "let" -> root_case_one_let_at(node, node_id, entry_instructions, facts, parameters);
        true -> root_case_one_nonlet_at(node, node_id, entry_instructions, facts, parameters)
    }.

root_case_one_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(parts) ->
            root_case_one_let_parts(
                parts.first.kind == "binding-pattern",
                parts.first,
                parts.second,
                parts.third,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_one_let_parts(
    valid: Bool,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_one_let_bound(
                pattern,
                source,
                continuation,
                node_id,
                entry_instructions,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_one_let_bound(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let source_id = node_id + 1 + node_size(pattern);
    let source_plan = lower_expression(source, source_id, facts, parameters);
    root_case_one_at(
        continuation,
        source_id + node_size(source),
        concat_instructions(
            entry_instructions,
            concat_instructions(source_plan.instructions, linear_binding(pattern, source_plan)),
        ),
        facts,
        parameters,
    ).

root_case_one_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_one_direct(node, node_id, entry_instructions, facts, parameters);
        true -> None
    }.

root_case_two_direct(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(clauses) ->
            root_case_two_direct_clauses(
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_clauses(
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_two_direct_first(
        expression_node_pair(clauses.second.children),
        expression_node_pair(clauses.third.children),
        clauses,
        node_id,
        entry_instructions,
        return_name,
        facts,
        parameters,
    ).

root_case_two_direct_first(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case first {
        Some(parts) ->
            root_case_two_direct_second(
                parts,
                second,
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case second {
        Some(parts) ->
            root_case_two_direct_value(
                first,
                parts,
                clauses,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_direct_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    clauses: ExpressionNodeTriple,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_two_direct_supported(
        shallow_pattern_supported(first.first) and shallow_pattern_supported(second.first),
        clauses.first,
        clauses.second,
        first.first,
        first.second,
        second.first,
        second.second,
        node_id,
        entry_instructions,
        return_name,
        facts,
        parameters,
    ).

root_case_two_direct_supported(
    valid: Bool,
    subject: ProjectedExpressionNode,
    first_clause: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_two_direct_bound(
                subject,
                first_clause,
                first_pattern,
                first_body,
                second_pattern,
                second_body,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_two_direct_bound(
    subject: ProjectedExpressionNode,
    first_clause: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let subject_plan = lower_expression(subject, node_id + 1, facts, parameters);
    let first_id = node_id + 1 + node_size(subject);
    let first_body_id = first_id + 1 + node_size(first_pattern);
    let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
    let second_id = first_id + node_size(first_clause);
    let second_body_id = second_id + 1 + node_size(second_pattern);
    let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
    root_case_two_prepare(
        first_body,
        first_body_id,
        second_body,
        second_body_id,
        entry_instructions,
        subject_plan,
        first_pattern,
        first_body_plan,
        second_pattern,
        second_body_plan,
        projected_phi_type(return_name),
        facts,
        parameters,
    ).

embedded_case_or_if_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_label: String,
    case_label_prefix: String,
    if_label_prefix: String,
    entry_instructions: List[SemanticInstructionPlan],
    join_target: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[EmbeddedBranchPlan] ->
    case embedded_if_any_at(
        node,
        node_id,
        entry_label,
        if_label_prefix,
        entry_instructions,
        join_target,
        facts,
        parameters,
    ) {
        Some(embedded) -> Some(embedded);
        None -> embedded_case_at(
            node,
            node_id,
            entry_label,
            case_label_prefix,
            entry_instructions,
            join_target,
            facts,
            parameters,
        )
    }.

root_case_two_prepare(
    first_body: ProjectedExpressionNode,
    first_body_id: Int,
    second_body: ProjectedExpressionNode,
    second_body_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    phi_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let first_environment = "%root_case_environment_0";
    let second_environment = "%root_case_environment_1";
    let first_match = "%root_case_match_0";
    let second_match = "%root_case_match_1";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let first_bindings = shallow_pattern_bindings(first_pattern, first_environment);
    let second_bindings = shallow_pattern_bindings(second_pattern, second_environment);
    let first_embedded =
        embedded_case_or_if_at(
            first_body,
            first_body_id,
            "root_case_body_0",
            "root_case_body_0_case_",
            "root_case_body_0_if_",
            first_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    let second_embedded =
        embedded_case_or_if_at(
            second_body,
            second_body_id,
            "root_case_body_1",
            "root_case_body_1_case_",
            "root_case_body_1_if_",
            second_bindings,
            "root_case_join",
            facts,
            parameters,
        );
    root_case_two_select_first(
        first_embedded,
        second_embedded,
        entry_instructions,
        subject_plan,
        first_prepare,
        first_match,
        first_bindings,
        first_body_plan,
        second_prepare,
        second_match,
        second_bindings,
        second_body_plan,
        phi_type,
    ).

root_case_two_select_first(
    first_embedded: Option[EmbeddedBranchPlan],
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case first_embedded {
        Some(embedded) ->
            root_case_two_select_both_or_first(
                embedded,
                second_embedded,
                entry_instructions,
                subject_plan,
                first_prepare,
                first_match,
                second_prepare,
                second_match,
                second_bindings,
                second_body_plan,
                phi_type,
            );
        None ->
            root_case_two_select_second(
                second_embedded,
                entry_instructions,
                subject_plan,
                first_prepare,
                first_match,
                first_bindings,
                first_body_plan,
                second_prepare,
                second_match,
                second_bindings,
                second_body_plan,
                phi_type,
            )
    }.

root_case_two_select_both_or_first(
    first_embedded: EmbeddedBranchPlan,
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case second_embedded {
        Some(embedded) -> Some(root_case_two_both_embedded_blocks(
            first_embedded,
            embedded,
            entry_instructions,
            subject_plan,
            first_prepare,
            first_match,
            second_prepare,
            second_match,
            phi_type,
        ));
        None -> Some(root_case_two_first_embedded_blocks(
            first_embedded,
            entry_instructions,
            subject_plan,
            first_prepare,
            first_match,
            second_prepare,
            second_match,
            second_bindings,
            second_body_plan,
            phi_type,
        ))
    }.

root_case_two_select_second(
    second_embedded: Option[EmbeddedBranchPlan],
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): Option[List[SemanticBlockPlan]] ->
    case second_embedded {
        Some(embedded) ->
            Some(
                root_case_two_second_embedded_blocks(
                    embedded,
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    phi_type,
                ),
            );
        None ->
            Some(
                root_case_two_linear_blocks(
                    entry_instructions,
                    subject_plan,
                    first_prepare,
                    first_match,
                    first_bindings,
                    first_body_plan,
                    second_prepare,
                    second_match,
                    second_bindings,
                    second_body_plan,
                    phi_type,
                ),
            )
    }.

root_case_two_first_embedded_blocks(
    embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat_blocks(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat_blocks(
            embedded.blocks,
            [
                SemanticBlockPlan(
                    "root_case_body_1",
                    concat_instructions(second_bindings, second_body_plan.instructions),
                    SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
                ),
                SemanticBlockPlan(
                    "root_case_unreachable",
                    List.new[SemanticInstructionPlan](),
                    SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                ),
                SemanticBlockPlan(
                    "root_case_join",
                    [
                        SemanticInstructionPlan(
                            "phi",
                            some_string("%root_case_result"),
                            [
                                embedded.exit_label,
                                embedded.result,
                                "root_case_body_1",
                                second_body_plan.result,
                            ],
                            some_string(phi_type),
                        ),
                    ],
                    SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                ),
            ],
        ),
    ).

root_case_two_both_embedded_blocks(
    first_embedded: EmbeddedBranchPlan,
    second_embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat_blocks(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat_blocks(
            first_embedded.blocks,
            concat_blocks(
                second_embedded.blocks,
                [
                    SemanticBlockPlan(
                        "root_case_unreachable",
                        List.new[SemanticInstructionPlan](),
                        SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                    ),
                    SemanticBlockPlan(
                        "root_case_join",
                        [
                            SemanticInstructionPlan(
                                "phi",
                                some_string("%root_case_result"),
                                [
                                    first_embedded.exit_label,
                                    first_embedded.result,
                                    second_embedded.exit_label,
                                    second_embedded.result,
                                ],
                                some_string(phi_type),
                            ),
                        ],
                        SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                    ),
                ],
            ),
        ),
    ).

root_case_two_second_embedded_blocks(
    embedded: EmbeddedBranchPlan,
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    phi_type: String,
): List[SemanticBlockPlan] ->
    concat_blocks(
        [
            SemanticBlockPlan(
                "entry",
                concat_instructions(entry_instructions, subject_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_0",
                [
                    first_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(first_match),
                        ["%root_case_environment_0"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [first_match],
                    ["root_case_body_0", "root_case_pattern_1"],
                ),
            ),
            SemanticBlockPlan(
                "root_case_body_0",
                concat_instructions(first_bindings, first_body_plan.instructions),
                SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
            ),
            SemanticBlockPlan(
                "root_case_pattern_1",
                [
                    second_prepare,
                    SemanticInstructionPlan(
                        "pattern-matched",
                        some_string(second_match),
                        ["%root_case_environment_1"],
                        some_string("Bool"),
                    ),
                ],
                SemanticTerminatorPlan(
                    "branch",
                    [second_match],
                    ["root_case_body_1", "root_case_unreachable"],
                ),
            ),
        ],
        concat_blocks(
            embedded.blocks,
            [
                SemanticBlockPlan(
                    "root_case_unreachable",
                    List.new[SemanticInstructionPlan](),
                    SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
                ),
                SemanticBlockPlan(
                    "root_case_join",
                    [
                        SemanticInstructionPlan(
                            "phi",
                            some_string("%root_case_result"),
                            [
                                "root_case_body_0",
                                first_body_plan.result,
                                embedded.exit_label,
                                embedded.result,
                            ],
                            some_string(phi_type),
                        ),
                    ],
                    SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
                ),
            ],
        ),
    ).

root_case_two_linear_blocks(
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, subject_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    ["%root_case_environment_0"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [first_match],
                ["root_case_body_0", "root_case_pattern_1"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_0",
            concat_instructions(first_bindings, first_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    ["%root_case_environment_1"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [second_match],
                ["root_case_body_1", "root_case_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_1",
            concat_instructions(second_bindings, second_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "root_case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%root_case_result"),
                    [
                        "root_case_body_0",
                        first_body_plan.result,
                        "root_case_body_1",
                        second_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
        ),
    ].

root_case_two_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "let" -> root_case_two_let_at(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> root_case_two_nonlet_at(node, node_id, entry_instructions, return_name, facts, parameters)
    }.

root_case_two_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(parts) ->
            root_case_two_let_parts(
                parts.first.kind == "binding-pattern",
                parts.first,
                parts.second,
                parts.third,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_let_parts(
    valid: Bool,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_two_let_bound(
                pattern,
                source,
                continuation,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_two_let_bound(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let source_id = node_id + 1 + node_size(pattern);
    let source_plan = lower_expression(source, source_id, facts, parameters);
    root_case_two_at(
        continuation,
        source_id + node_size(source),
        concat_instructions(
            entry_instructions,
            concat_instructions(source_plan.instructions, linear_binding(pattern, source_plan)),
        ),
        return_name,
        facts,
        parameters,
    ).

root_case_two_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_two_direct(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> None
    }.

function_plan(
    module_name: String,
    declaration: BackendDeclaration,
    body: ProjectedBody,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body.expression.node {
        Some(node) -> function_plan_for_node(module_name, declaration, node, facts);
        None -> None
    }.

function_plan_for_node(
    module_name: String,
    declaration: BackendDeclaration,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case declaration.payload {
        FunctionPayload(function) ->
            function_plan_for_function(module_name, declaration, function, node, facts);
        MethodPayload(method) ->
            function_plan_for_method(module_name, declaration, method, node, facts);
        _ -> None
    }.

declared_return_name(valid: Bool, text: String): String ->
    case valid {
        true -> text;
        false -> ""
    }.

declared_return_type(valid: Bool, text: String, fallback: Option[String]): Option[String] ->
    case valid {
        true -> resolved_return(text, fallback);
        false -> none_string()
    }.

has_annotation(
    values: List[self_host.DeclarationMetadataSyntax.AnnotationUse],
    expected: String,
): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.path == expected or has_annotation(rest, expected)
    }.

native_declaration(declaration: BackendDeclaration, node: ProjectedExpressionNode): Bool ->
    has_annotation(declaration.annotations, "compiler.intrinsic")
        or node.kind == "primary" and node.text == "native".

symbol_base_at(value: String, index: Int): String ->
    if {
        index == value.byte_size() -> value;
        value.utf8_byte_at(index) == 91 -> value.utf8_slice(0, index);
        true -> symbol_base_at(value, index + 1)
    }.

symbol_base(value: String): String -> symbol_base_at(value, 0).

native_symbol_byte(byte: Int): Bool ->
    byte >= 48 and byte <= 57
        or byte >= 65 and byte <= 90
        or byte >= 97 and byte <= 122
        or byte == 95.

hex_digit(value: Int): String -> "0123456789abcdef".utf8_slice(value, 1).

escaped_native_symbol_at(value: String, index: Int, output: String): String ->
    if {
        index == value.byte_size() -> output;
        native_symbol_byte(value.utf8_byte_at(index)) -> escaped_native_symbol_at(
            value,
            index + 1,
            String.append(output, value.utf8_slice(index, 1)),
        );
        true ->
            let byte = value.utf8_byte_at(index);
            escaped_native_symbol_at(
                value,
                index + 1,
                String.append(
                    output,
                    String.append("_", String.append(hex_digit(byte div 16), hex_digit(byte rem 16))),
                ),
            )
    }.

native_symbol_name(module_name: String, name: String, arity: Int): String ->
    let identity = String.append(
        module_name,
        String.append(".", String.append(symbol_base(name), String.append("/", Int.to_string(arity)))),
    );
    String.append("terlan_native_", escaped_native_symbol_at(identity, 0, "")).

native_symbol_for(
    native: Bool,
    module_name: String,
    name: String,
    arity: Int,
): Option[String] ->
    if {
        native -> Some(native_symbol_name(module_name, name, arity));
        true -> none_string()
    }.

native_blocks(native: Bool, blocks: List[SemanticBlockPlan]): List[SemanticBlockPlan] ->
    blocks.

function_plan_for_function(
    module_name: String,
    declaration: BackendDeclaration,
    function: FunctionSyntax,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    let params = ir_parameters(function.typed_parameters);
    let arity = parameter_count(params);
    let native = native_declaration(declaration, node);
    let expression = lower_expression(node, 0, facts, params);
    let return_name = declared_return_name(function.return_type.valid, function.return_type.syntax.text);
    let blocks =
        projected_function_blocks(
            node,
            return_name,
            projected_linear_blocks(expression),
            facts,
            params,
        );
    let resolved_return_type =
        declared_return_type(
            function.return_type.valid,
            function.return_type.syntax.text,
            expression.result_type,
        );
    Some(
        SemanticFunctionPlan(
            module_name = module_name,
            name = declaration.symbol_name,
            arity = parameter_count(params),
            parameters = params,
            resolved_return_type = resolved_return_type,
            blocks = native_blocks(native, blocks),
            native_symbol = native_symbol_for(native, module_name, declaration.symbol_name, arity),
        ),
    ).

function_plan_for_method(
    module_name: String,
    declaration: BackendDeclaration,
    method: MethodSyntax,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    let params = [parameter(method.receiver) | ir_parameters(method.parameters)];
    let arity = parameter_count(params);
    let native = native_declaration(declaration, node);
    let expression = lower_expression(node, 0, facts, params);
    let return_name = declared_return_name(method.return_type.valid, method.return_type.syntax.text);
    let blocks =
        projected_function_blocks(
            node,
            return_name,
            projected_linear_blocks(expression),
            facts,
            params,
        );
    let resolved_return_type =
        declared_return_type(
            method.return_type.valid,
            method.return_type.syntax.text,
            expression.result_type,
        );
    Some(
        SemanticFunctionPlan(
            module_name = module_name,
            name = declaration.symbol_name,
            arity = parameter_count(params),
            parameters = params,
            resolved_return_type = resolved_return_type,
            blocks = native_blocks(native, blocks),
            native_symbol = native_symbol_for(native, module_name, declaration.symbol_name, arity),
        ),
    ).

projected_linear_blocks(expression: ExpressionPlan): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            label = "entry",
            instructions = expression.instructions,
            terminator = SemanticTerminatorPlan(
                opcode = "return",
                operands = [expression.result],
                targets = List.new[String](),
            ),
        ),
    ].

projected_function_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_refutable_let_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            case nested_let_if_blocks(node, facts, parameters) {
                Some(blocks) -> blocks;
                None ->
                    projected_embedded_or_case_blocks(node, return_name, linear_blocks, facts, parameters)
            }
    }.

projected_embedded_or_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_embedded_if_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_blocks(node, return_name, linear_blocks, facts, parameters)
    }.

projected_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_one_at(node, 0, List.new[SemanticInstructionPlan](), facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_two_or_three_blocks(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            )
    }.

projected_case_two_or_three_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_two_at(node, 0, List.new[SemanticInstructionPlan](), return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_three_or_linear_blocks(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            )
    }.

projected_case_three_or_linear_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_three_at(node, return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None -> linear_blocks
    }.

root_case_three_at(
    node: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_three_clauses(node.children, return_name, facts, parameters);
        true -> None
    }.

root_case_three_clauses(
    values: List[ProjectedExpressionNode],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_quad(values) {
        Some(clauses) ->
            root_case_three_parts(
                expression_node_pair(clauses.second.children),
                expression_node_pair(clauses.third.children),
                expression_node_pair(clauses.fourth.children),
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case first {
        Some(parts) ->
            root_case_three_parts_second(
                parts,
                second,
                third,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case second {
        Some(parts) ->
            root_case_three_parts_third(
                first,
                parts,
                third,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_third(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case third {
        Some(parts) ->
            root_case_three_parts_value(
                first,
                second,
                parts,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: ExpressionNodePair,
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_three_direct(
        clauses.first,
        clauses.second,
        clauses.third,
        first.first,
        first.second,
        second.first,
        second.second,
        third.first,
        third.second,
        return_name,
        facts,
        parameters,
    ).

root_case_three_direct(
    subject: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_pattern: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        shallow_pattern_supported(first_pattern)
            and shallow_pattern_supported(second_pattern)
            and shallow_pattern_supported(third_pattern) -> let subject_plan = lower_expression(subject, 1, facts, parameters);
        let first_id = 1 + node_size(subject);
        let first_body_id = first_id + 1 + node_size(first_pattern);
        let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
        let second_id = first_id + node_size(first);
        let second_body_id = second_id + 1 + node_size(second_pattern);
        let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
        let third_id = second_id + node_size(second);
        let third_body_id = third_id + 1 + node_size(third_pattern);
        let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
        Some(
            root_case_three_blocks(
                subject_plan,
                first_pattern,
                first_body_plan,
                second_pattern,
                second_body_plan,
                third_pattern,
                third_body_plan,
                projected_phi_type(return_name),
            ),
        );
        true -> None
    }.

projected_phi_type(return_name: String): String ->
    if {
        return_name == "" -> "Dynamic";
        true -> return_name
    }.

root_case_three_blocks(
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    third_pattern: ProjectedExpressionNode,
    third_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    let first_environment = "%case_environment_0";
    let second_environment = "%case_environment_1";
    let third_environment = "%case_environment_2";
    let first_match = "%case_match_0";
    let second_match = "%case_match_1";
    let third_match = "%case_match_2";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let third_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(third_environment),
            shallow_pattern_operands(subject_plan.result, third_pattern),
            some_string("PatternMatch"),
        );
    [
        SemanticBlockPlan(
            "entry",
            subject_plan.instructions,
            SemanticTerminatorPlan("jump", List.new[String](), ["case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    [first_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [first_match], ["case_body_0", "case_pattern_1"]),
        ),
        SemanticBlockPlan(
            "case_body_0",
            concat_instructions(
                shallow_pattern_bindings(first_pattern, first_environment),
                first_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    [second_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [second_match], ["case_body_1", "case_pattern_2"]),
        ),
        SemanticBlockPlan(
            "case_body_1",
            concat_instructions(
                shallow_pattern_bindings(second_pattern, second_environment),
                second_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_2",
            [
                third_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(third_match),
                    [third_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [third_match], ["case_body_2", "case_unreachable"]),
        ),
        SemanticBlockPlan(
            "case_body_2",
            concat_instructions(
                shallow_pattern_bindings(third_pattern, third_environment),
                third_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%case_result"),
                    [
                        "case_body_0",
                        first_body_plan.result,
                        "case_body_1",
                        second_body_plan.result,
                        "case_body_2",
                        third_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%case_result"], List.new[String]()),
        ),
    ].

plans(
    module_name: String,
    declarations: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case declarations {
        [] -> List.new[SemanticFunctionPlan]();
        [declaration | rest] ->
            prepend_declaration_plan(
                declaration_plan(module_name, declaration, bodies, facts),
                declaration,
                module_name,
                rest,
                bodies,
                facts,
            )
    }.

declaration_plan(
    module_name: String,
    declaration: BackendDeclaration,
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body_for(declaration.symbol_name, bodies) {
        Some(body) -> function_plan(module_name, declaration, body, facts);
        None -> None
    }.

prepend_declaration_plan(
    plan: Option[SemanticFunctionPlan],
    declaration: BackendDeclaration,
    module_name: String,
    rest: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case plan {
        Some(value) -> [value | concat_function_plans(
            declaration_lambda_plans(module_name, declaration, bodies, facts),
            plans(module_name, rest, bodies, facts),
        )];
        None -> plans(module_name, rest, bodies, facts)
    }.

concat_function_plans(
    left: List[SemanticFunctionPlan],
    right: List[SemanticFunctionPlan],
): List[SemanticFunctionPlan] ->
    case left {
        [] -> right;
        [value | rest] -> [value | concat_function_plans(rest, right)]
    }.

declaration_ir_parameters(declaration: BackendDeclaration): List[IrParameter] ->
    case declaration.payload {
        FunctionPayload(function) -> ir_parameters(function.typed_parameters);
        MethodPayload(method) -> [parameter(method.receiver) | ir_parameters(method.parameters)];
        _ -> List.new[IrParameter]()
    }.

lambda_function_plan(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case lambda_body(node) {
        Some(body) ->
            let captures = lambda_captures(node, outer_parameters);
            let parameters = append_ir_parameters(captures, lambda_parameters(node));
            let body_id = lambda_body_id(node, node_id);
            let expression = lower_expression(body, body_id, facts, parameters);
            Some(SemanticFunctionPlan(
                module_name = module_name,
                name = lambda_symbol(node),
                arity = parameter_count(parameters),
                parameters = parameters,
                resolved_return_type = resolved_or_dynamic(expression.result_type),
                blocks = projected_function_blocks(
                    body,
                    "",
                    projected_linear_blocks(expression),
                    facts,
                    parameters,
                ),
                native_symbol = none_string(),
            ));
        None -> None
    }.

lambda_nested_plans(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case lambda_body(node) {
        Some(body) ->
            let parameters = append_ir_parameters(
                lambda_captures(node, outer_parameters),
                lambda_parameters(node),
            );
            lambda_plans_at(module_name, body, lambda_body_id(node, node_id), parameters, facts);
        None -> List.new[SemanticFunctionPlan]()
    }.

prepend_lambda_plan(
    plan: Option[SemanticFunctionPlan],
    nested: List[SemanticFunctionPlan],
): List[SemanticFunctionPlan] ->
    case plan {
        Some(value) -> [value | nested];
        None -> nested
    }.

lambda_plans_at(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    if {
        node.kind == "lambda" -> prepend_lambda_plan(
            lambda_function_plan(module_name, node, node_id, outer_parameters, facts),
            lambda_nested_plans(module_name, node, node_id, outer_parameters, facts),
        );
        true -> lambda_child_plans(
            module_name,
            node.children,
            node_id + 1,
            outer_parameters,
            facts,
        )
    }.

lambda_child_plans(
    module_name: String,
    values: List[ProjectedExpressionNode],
    child_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case values {
        [] -> List.new[SemanticFunctionPlan]();
        [value | rest] -> concat_function_plans(
            lambda_plans_at(module_name, value, child_id, outer_parameters, facts),
            lambda_child_plans(
                module_name,
                rest,
                child_id + node_size(value),
                outer_parameters,
                facts,
            ),
        )
    }.

declaration_lambda_plans(
    module_name: String,
    declaration: BackendDeclaration,
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case body_for(declaration.symbol_name, bodies) {
        Some(body) ->
            case body.expression.node {
                Some(node) -> lambda_plans_at(
                    module_name,
                    node,
                    0,
                    declaration_ir_parameters(declaration),
                    facts,
                );
                None -> List.new[SemanticFunctionPlan]()
            };
        None -> List.new[SemanticFunctionPlan]()
    }.

pub lower(frontend: ProjectedFrontendModule, semantics: LocalSemanticResult): SemanticModulePlan ->
    SemanticModulePlan(
        name = frontend.backend.module_name,
        functions = plans(
            frontend.backend.module_name,
            frontend.backend.declarations,
            frontend.bodies.values,
            semantics.types.facts,
        ),
    ).
