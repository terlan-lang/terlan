};
(let Some(third) <- expression_pair(clauses.third.children) else {
    None -> None
};
(let Some(fourth) <- expression_pair(clauses.fourth.children) else {
    None -> None
};
Some(
    embedded_if_four_blocks(
        node,
        node_id,
        clauses.first,
        clauses.second,
        clauses.third,
        first.first,
        first.second,
        second.first,
        second.second,
