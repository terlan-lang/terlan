root_case_two_linear_blocks(
    entry_instructions: List[SemanticInstructionPlan],
    subject_plan: ExpressionPlan,
    first_prepare: SemanticInstructionPlan,
    first_match: String,
    first_bindings: List[SemanticInstructionPlan],
    first_body_plan: ExpressionPlan,
    second_prepare: SemanticInstructionPlan,
    second_match: String,
    second_bindings: List[SemanticInstructionPlan],
    second_body_plan: ExpressionPlan,
    phi_type: String,
): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            "entry",
            concat_instructions(entry_instructions, subject_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    ["%root_case_environment_0"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [first_match],
                ["root_case_body_0", "root_case_pattern_1"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_0",
            concat_instructions(first_bindings, first_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    ["%root_case_environment_1"],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan(
                "branch",
                [second_match],
                ["root_case_body_1", "root_case_unreachable"],
            ),
        ),
        SemanticBlockPlan(
            "root_case_body_1",
            concat_instructions(second_bindings, second_body_plan.instructions),
            SemanticTerminatorPlan("jump", List.new[String](), ["root_case_join"]),
        ),
        SemanticBlockPlan(
            "root_case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "root_case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%root_case_result"),
                    [
                        "root_case_body_0",
                        first_body_plan.result,
                        "root_case_body_1",
                        second_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%root_case_result"], List.new[String]()),
        ),
    ].

root_case_two_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "let" -> root_case_two_let_at(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> root_case_two_nonlet_at(node, node_id, entry_instructions, return_name, facts, parameters)
    }.

root_case_two_let_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_triple(node.children) {
        Some(parts) ->
            root_case_two_let_parts(
                ProjectedExpressionSupportIrPlan.binding_pattern(parts.first),
                parts.first,
                parts.second,
                parts.third,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_two_let_parts(
    valid: Bool,
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case valid {
        true ->
            root_case_two_let_bound(
                pattern,
                source,
                continuation,
                node_id,
                entry_instructions,
                return_name,
                facts,
                parameters,
            );
        false -> None
    }.

root_case_two_let_bound(
    pattern: ProjectedExpressionNode,
    source: ProjectedExpressionNode,
    continuation: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let source_id = node_id + 1 + node_size(pattern);
    let source_plan = lower_expression(source, source_id, facts, parameters);
    root_case_two_at(
        continuation,
        source_id + node_size(source),
        concat_instructions(
            entry_instructions,
            concat_instructions(source_plan.instructions, linear_binding(pattern, source_plan)),
        ),
        return_name,
        facts,
        parameters,
    ).

root_case_two_nonlet_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    entry_instructions: List[SemanticInstructionPlan],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_two_direct(node, node_id, entry_instructions, return_name, facts, parameters);
        true -> None
    }.

function_plan(
    module_name: String,
    declaration: BackendDeclaration,
    body: ProjectedBody,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body.expression.node {
        Some(node) -> function_plan_for_node(module_name, declaration, node, facts);
        None -> None
    }.

function_plan_for_node(
    module_name: String,
    declaration: BackendDeclaration,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case declaration.payload {
        FunctionPayload(function) ->
            function_plan_for_function(module_name, declaration, function, node, facts);
        MethodPayload(method) ->
            function_plan_for_method(module_name, declaration, method, node, facts);
        _ -> None
    }.

declared_return_name(valid: Bool, text: String): String ->
    case valid {
        true -> text;
        false -> ""
    }.

declared_return_type(valid: Bool, text: String, fallback: Option[String]): Option[String] ->
    case valid {
        true -> resolved_return(text, fallback);
        false -> none_string()
    }.

has_annotation(
    values: List[self_host.DeclarationMetadataSyntax.AnnotationUse],
    expected: String,
): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.path == expected or has_annotation(rest, expected)
    }.

native_declaration(declaration: BackendDeclaration, node: ProjectedExpressionNode): Bool ->
    has_annotation(declaration.annotations, "compiler.intrinsic")
        or node.text == "native".

symbol_base_at(value: String, index: Int): String ->
    if {
        index == value.byte_size() -> value;
        value.utf8_byte_at(index) == 91 -> value.utf8_slice(0, index);
        true -> symbol_base_at(value, index + 1)
    }.

symbol_base(value: String): String -> symbol_base_at(value, 0).

native_symbol_byte(byte: Int): Bool ->
    byte >= 48 and byte <= 57
        or byte >= 65 and byte <= 90
        or byte >= 97 and byte <= 122
        or byte == 95.

hex_digit(value: Int): String -> "0123456789abcdef".utf8_slice(value, 1).

escaped_native_symbol_at(value: String, index: Int, output: String): String ->
    if {
        index == value.byte_size() -> output;
        native_symbol_byte(value.utf8_byte_at(index)) -> escaped_native_symbol_at(
            value,
            index + 1,
            String.append(output, value.utf8_slice(index, 1)),
        );
        true ->
            let byte = value.utf8_byte_at(index);
            escaped_native_symbol_at(
                value,
                index + 1,
                String.append(
                    output,
                    String.append("_", String.append(hex_digit(byte div 16), hex_digit(byte rem 16))),
                ),
            )
    }.

native_symbol_name(module_name: String, name: String, arity: Int): String ->
    let identity = String.append(
        module_name,
        String.append(".", String.append(symbol_base(name), String.append("/", Int.to_string(arity)))),
    );
    String.append("terlan_native_", escaped_native_symbol_at(identity, 0, "")).

native_symbol_for(
    native: Bool,
    module_name: String,
    name: String,
    arity: Int,
): Option[String] ->
    if {
        native -> Some(native_symbol_name(module_name, name, arity));
        true -> none_string()
    }.

native_blocks(native: Bool, blocks: List[SemanticBlockPlan]): List[SemanticBlockPlan] ->
    blocks.

function_plan_for_function(
    module_name: String,
    declaration: BackendDeclaration,
    function: FunctionSyntax,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    let params = ir_parameters(function.typed_parameters);
    let arity = parameter_count(params);
    let native = native_declaration(declaration, node);
    let expression = lower_expression(node, 0, facts, params);
    let return_name = declared_return_name(function.return_type.valid, function.return_type.syntax.text);
    let blocks =
        projected_function_blocks(
            node,
            return_name,
            projected_linear_blocks(expression),
            facts,
            params,
        );
    let resolved_return_type =
        declared_return_type(
            function.return_type.valid,
            function.return_type.syntax.text,
            expression.result_type,
        );
    Some(
        SemanticFunctionPlan(
            module_name = module_name,
            name = symbol_base(declaration.symbol_name),
            arity = parameter_count(params),
            parameters = params,
            resolved_return_type = resolved_return_type,
            blocks = native_blocks(native, blocks),
            native_symbol = native_symbol_for(native, module_name, declaration.symbol_name, arity),
        ),
    ).

function_plan_for_method(
    module_name: String,
    declaration: BackendDeclaration,
    method: MethodSyntax,
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    let params = [parameter(method.receiver) | ir_parameters(method.parameters)];
    let arity = parameter_count(params);
    let native = native_declaration(declaration, node);
    let expression = lower_expression(node, 0, facts, params);
    let return_name = declared_return_name(method.return_type.valid, method.return_type.syntax.text);
    let blocks =
        projected_function_blocks(
            node,
            return_name,
            projected_linear_blocks(expression),
            facts,
            params,
        );
    let resolved_return_type =
        declared_return_type(
            method.return_type.valid,
            method.return_type.syntax.text,
            expression.result_type,
        );
    Some(
        SemanticFunctionPlan(
            module_name = module_name,
            name = symbol_base(declaration.symbol_name),
            arity = parameter_count(params),
            parameters = params,
            resolved_return_type = resolved_return_type,
            blocks = native_blocks(native, blocks),
            native_symbol = native_symbol_for(native, module_name, declaration.symbol_name, arity),
        ),
    ).

projected_linear_blocks(expression: ExpressionPlan): List[SemanticBlockPlan] ->
    [
        SemanticBlockPlan(
            label = "entry",
            instructions = expression.instructions,
            terminator = SemanticTerminatorPlan(
                opcode = "return",
                operands = [expression.result],
                targets = List.new[String](),
            ),
        ),
    ].

try_type_name(value: Option[String]): String ->
    case value {
        Some(name) -> name;
        None -> ""
    }.

returned_result(blocks: List[SemanticBlockPlan], fallback: String): String ->
    case blocks {
        [] -> fallback;
        [block | rest] -> if {
            block.terminator.opcode == "return" -> case block.terminator.operands {
                [result | _] -> result;
                [] -> returned_result(rest, fallback)
            };
            true -> returned_result(rest, fallback)
        }
    }.

try_case(
    container: ProjectedExpressionNode,
    parameter: IrParameter,
): ProjectedExpressionNode ->
    let subject = ProjectedExpressionNode(
        "identifier",
        parameter.name,
        container.start_byte,
        container.start_byte,
        List.new[ProjectedExpressionNode](),
    );
    ProjectedExpressionNode(
        "case",
        "case",
        container.start_byte,
        container.end_byte,
        [subject | container.children],
    ).

handler_region(
    label: String,
    prefix: String,
    container: ProjectedExpressionNode,
    node_id: Int,
    parameter: IrParameter,
    result_type: Option[String],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[SemanticRegionPlan] ->
    let return_label = prefix + "return";
    let case_node = try_case(container, parameter);
    case embedded_case_at(
        case_node,
        node_id,
        "entry",
        prefix,
        List.new[SemanticInstructionPlan](),
        return_label,
        facts,
        append_ir_parameters(parameters, [parameter]),
    ) {
        None -> None;
        Some(embedded) ->
            let region_parameters = append_ir_parameters(parameters, [parameter]);
            Some(SemanticRegionPlan(
                label,
                [parameter],
                concat_blocks(
                    lift_try_blocks(
                        case_node,
                        node_id,
                        embedded.blocks,
                        facts,
                        region_parameters,
                    ),
                    [SemanticBlockPlan(
                        return_label,
                        List.new[SemanticInstructionPlan](),
                        SemanticTerminatorPlan(
                            "return",
                            [embedded.result],
                            List.new[String](),
                        ),
                    )],
                ),
                embedded.result,
                result_type,
            ))
    }.

success_region(
    container: ProjectedExpressionNode,
    node_id: Int,
    protected_type: String,
    result_type: Option[String],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[SemanticRegionPlan] ->
    let parameter = IrParameter("%try_success_value", protected_type);
    if {
        container.children == [] -> Some(SemanticRegionPlan(
            "success",
            [parameter],
            [SemanticBlockPlan(
                "entry",
                List.new[SemanticInstructionPlan](),
                SemanticTerminatorPlan("return", [parameter.name], List.new[String]()),
            )],
            parameter.name,
            result_type,
        ));
        true -> handler_region(
            "success",
            "try_success_case_",
            container,
            node_id,
            parameter,
            result_type,
            facts,
            parameters,
        )
    }.

failure_region(
    container: ProjectedExpressionNode,
    node_id: Int,
    result_type: Option[String],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[SemanticRegionPlan] ->
    handler_region(
        "failure",
        "try_failure_case_",
        container,
        node_id,
        IrParameter("%try_failure_status", "Int"),
        result_type,
        facts,
        parameters,
    ).

redirect_region_returns(
    blocks: List[SemanticBlockPlan],
    target: String,
): List[SemanticBlockPlan] ->
    case blocks {
        [] -> List.new[SemanticBlockPlan]();
        [block | rest] -> [SemanticBlockPlan(
            block.label,
            block.instructions,
            if {
                block.terminator.opcode == "return" -> SemanticTerminatorPlan(
                    "branch",
                    List.new[String](),
                    [target],
                );
                true -> block.terminator
            },
        ) | redirect_region_returns(rest, target)]
    }.

last_try_node(
    values: List[ProjectedExpressionNode],
    fallback: ProjectedExpressionNode,
): ProjectedExpressionNode ->
    case values {
        [] -> fallback;
        [value | rest] -> last_try_node(rest, value)
    }.

cleanup_regions(
    values: List[ProjectedExpressionNode],
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticRegionPlan] ->
    case values {
        [] -> List.new[SemanticRegionPlan]();
        [container | _] ->
            let cleanup = last_try_node(container.children, container);
            let plan = lower_expression(cleanup, node_id, facts, parameters);
            let return_label = "try_cleanup_return";
            let unit = "%try_cleanup_unit_" + Int.to_string(node_id);
            let blocks = projected_function_blocks(
                cleanup,
                "Unit",
                projected_linear_blocks(plan),
                facts,
                parameters,
            );
            [SemanticRegionPlan(
                "cleanup",
                List.new[IrParameter](),
                concat_blocks(
                    redirect_region_returns(blocks, return_label),
                    [SemanticBlockPlan(
                        return_label,
                        [SemanticInstructionPlan(
                            "load-literal",
                            Some(unit),
                            ["Unit"],
                            Some("Unit"),
                        )],
                        SemanticTerminatorPlan("return", [unit], List.new[String]()),
                    )],
                ),
                unit,
                Some("Unit"),
            )]
    }.

try_blocks_with_handlers(
    node: ProjectedExpressionNode,
    node_id: Int,
    body: ProjectedExpressionNode,
    success: ProjectedExpressionNode,
    catches: ProjectedExpressionNode,
    cleanup: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    let body_id = node_id + 1;
    let success_id = body_id + node_size(body);
    let catch_id = success_id + node_size(success);
    let cleanup_id = catch_id + node_size(catches);
    let body_plan = lower_expression(body, body_id, facts, parameters);
    let body_blocks = projected_function_blocks(
        body,
        try_type_name(body_plan.result_type),
        projected_linear_blocks(body_plan),
        facts,
        parameters,
    );
    let protected = SemanticRegionPlan(
        "protected",
        List.new[IrParameter](),
        body_blocks,
        returned_result(body_blocks, body_plan.result),
        body_plan.result_type,
    );
    let result_type = expression_type(node, facts, parameters);
    case success_region(
        success,
        success_id,
        try_type_name(body_plan.result_type),
        result_type,
        facts,
        parameters,
    ) {
        None -> None;
        Some(success_plan) -> case failure_region(
            catches,
            catch_id,
            result_type,
            facts,
            parameters,
        ) {
            None -> None;
            Some(failure_plan) ->
                let result = register(node_id);
                Some([SemanticBlockPlan(
                    "entry",
                    [SemanticInstructionPlan(
                        "try-region",
                        Some(result),
                        List.new[String](),
                        List.new[Option[String]](),
                        result_type,
                        None,
                        Some(SemanticTryRegionPlan(
                            protected,
                            success_plan,
                            failure_plan,
                            cleanup_regions(cleanup, cleanup_id, facts, parameters),
                        )),
                    )],
                    SemanticTerminatorPlan("return", [result], List.new[String]()),
                )])
        }
    }.

/** Lowers a function-root try through structured ABI-1.6 regions. */
pub root_try_blocks(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind != "try" -> None;
        true -> case node.children {
            [body | [success | [catches | cleanup]]] -> try_blocks_with_handlers(
                node,
                0,
                body,
                success,
                catches,
                cleanup,
                facts,
                parameters,
            );
            _ -> None
        }
    }.

struct TryInstructionLift {
    start_id: Int,
    end_id: Int,
    instruction: SemanticInstructionPlan,
}.

constructor TryInstructionLift {
    (
        start_id: Int,
        end_id: Int,
        instruction: SemanticInstructionPlan,
    ): TryInstructionLift -> TryInstructionLift {
        start_id: start_id,
        end_id: end_id,
        instruction: instruction,
    }
}.

concat_try_lifts(
    left: List[TryInstructionLift],
    right: List[TryInstructionLift],
): List[TryInstructionLift] ->
    case left {
        [] -> right;
        [value | rest] -> [value | concat_try_lifts(rest, right)]
    }.

first_try_instruction(
    blocks: List[SemanticBlockPlan],
): Option[SemanticInstructionPlan] ->
    case blocks {
        [] -> None;
        [block | rest] -> case block.instructions {
            [] -> first_try_instruction(rest);
            [instruction | _] -> if {
                instruction.opcode == "try-region" -> Some(instruction);
                true -> first_try_instruction(rest)
            }
        }
    }.

try_instruction_at(
    node: ProjectedExpressionNode,
    node_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[SemanticInstructionPlan] ->
    if {
        node.kind != "try" -> None;
        true -> case node.children {
            [body | [success | [catches | cleanup]]] -> first_try_instruction(
                case try_blocks_with_handlers(
                    node,
                    node_id,
                    body,
                    success,
                    catches,
                    cleanup,
                    facts,
                    parameters,
                ) {
                    Some(blocks) -> blocks;
                    None -> List.new[SemanticBlockPlan]()
                },
            );
            _ -> None
        }
    }.

top_level_try_lifts(
    values: List[ProjectedExpressionNode],
    next_id: Int,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[TryInstructionLift] ->
    case values {
        [] -> List.new[TryInstructionLift]();
        [value | rest] ->
            let size = node_size(value);
            let current = if {
                value.kind == "try" -> case try_instruction_at(
                    value,
                    next_id,
                    facts,
                    parameters,
                ) {
                    Some(instruction) -> [TryInstructionLift(
                        next_id,
                        next_id + size,
                        instruction,
                    )];
                    None -> List.new[TryInstructionLift]()
                };
                true -> top_level_try_lifts(
                    value.children,
                    next_id + 1,
                    facts,
                    parameters,
                )
            };
            concat_try_lifts(
                current,
                top_level_try_lifts(rest, next_id + size, facts, parameters),
            )
    }.

lift_for_start(
    result: String,
    values: List[TryInstructionLift],
): Option[SemanticInstructionPlan] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            result == register(value.start_id) -> Some(value.instruction);
            true -> lift_for_start(result, rest)
        }
    }.

register_in_interval(
    result: String,
    current: Int,
    end: Int,
): Bool ->
    if {
        current >= end -> false;
        result == register(current) -> true;
        true -> register_in_interval(result, current + 1, end)
    }.

covered_by_try_lift(
    result: String,
    values: List[TryInstructionLift],
): Bool ->
    case values {
        [] -> false;
        [value | rest] -> register_in_interval(
            result,
            value.start_id,
            value.end_id,
        ) or covered_by_try_lift(result, rest)
    }.

lift_try_instructions(
    instructions: List[SemanticInstructionPlan],
    lifts: List[TryInstructionLift],
): List[SemanticInstructionPlan] ->
    case instructions {
        [] -> List.new[SemanticInstructionPlan]();
        [instruction | rest] -> case instruction.result {
            None -> [instruction | lift_try_instructions(rest, lifts)];
            Some(result) -> case lift_for_start(result, lifts) {
                Some(replacement) -> [replacement | lift_try_instructions(rest, lifts)];
                None -> if {
                    covered_by_try_lift(result, lifts) -> lift_try_instructions(rest, lifts);
                    true -> [instruction | lift_try_instructions(rest, lifts)]
                }
            }
        }
    }.

lift_try_block_list(
    blocks: List[SemanticBlockPlan],
    lifts: List[TryInstructionLift],
): List[SemanticBlockPlan] ->
    case blocks {
        [] -> List.new[SemanticBlockPlan]();
        [block | rest] -> [SemanticBlockPlan(
            block.label,
            lift_try_instructions(block.instructions, lifts),
            block.terminator,
        ) | lift_try_block_list(rest, lifts)]
    }.

lift_try_blocks(
    node: ProjectedExpressionNode,
    node_id: Int,
    blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    lift_try_block_list(
        blocks,
        top_level_try_lifts(node.children, node_id + 1, facts, parameters),
    ).

projected_function_blocks_without_root_try(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_refutable_let_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            case nested_let_if_blocks(node, facts, parameters) {
                Some(blocks) -> blocks;
                None ->
                    projected_embedded_or_case_blocks(
                        node,
                        return_name,
                        linear_blocks,
                        facts,
                        parameters,
                    )
            }
    }.

projected_function_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_try_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None -> lift_try_blocks(
            node,
            0,
            projected_function_blocks_without_root_try(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            ),
            facts,
            parameters,
        )
    }.

/** Lowers one expression to function-shaped blocks with nested structured tries lifted. */
pub expression_blocks_with_try(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    let expression = lower_expression(node, 0, facts, parameters);
    projected_function_blocks(
        node,
        try_type_name(expression.result_type),
        projected_linear_blocks(expression),
        facts,
        parameters,
    ).

projected_embedded_or_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_embedded_if_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_blocks(node, return_name, linear_blocks, facts, parameters)
    }.

projected_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_embedded_case_blocks(node, facts, parameters) {
        Some(blocks) -> blocks;
        None -> projected_legacy_case_blocks(node, return_name, linear_blocks, facts, parameters)
    }.

projected_legacy_case_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_one_at(node, 0, List.new[SemanticInstructionPlan](), facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_two_or_three_blocks(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            )
    }.

projected_case_two_or_three_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_two_at(node, 0, List.new[SemanticInstructionPlan](), return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None ->
            projected_case_three_or_linear_blocks(
                node,
                return_name,
                linear_blocks,
                facts,
                parameters,
            )
    }.

projected_case_three_or_linear_blocks(
    node: ProjectedExpressionNode,
    return_name: String,
    linear_blocks: List[SemanticBlockPlan],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    case root_case_three_at(node, return_name, facts, parameters) {
        Some(blocks) -> blocks;
        None -> linear_blocks
    }.

root_case_three_at(
    node: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        node.kind == "case" -> root_case_three_clauses(node.children, return_name, facts, parameters);
        true -> None
    }.

root_case_three_clauses(
    values: List[ProjectedExpressionNode],
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case expression_node_quad(values) {
        Some(clauses) ->
            root_case_three_parts(
                expression_node_pair(clauses.second.children),
                expression_node_pair(clauses.third.children),
                expression_node_pair(clauses.fourth.children),
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts(
    first: Option[ExpressionNodePair],
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case first {
        Some(parts) ->
            root_case_three_parts_second(
                parts,
                second,
                third,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_second(
    first: ExpressionNodePair,
    second: Option[ExpressionNodePair],
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case second {
        Some(parts) ->
            root_case_three_parts_third(
                first,
                parts,
                third,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_third(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: Option[ExpressionNodePair],
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    case third {
        Some(parts) ->
            root_case_three_parts_value(
                first,
                second,
                parts,
                clauses,
                return_name,
                facts,
                parameters,
            );
        _ -> None
    }.

root_case_three_parts_value(
    first: ExpressionNodePair,
    second: ExpressionNodePair,
    third: ExpressionNodePair,
    clauses: ExpressionNodeQuad,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    root_case_three_direct(
        clauses.first,
        clauses.second,
        clauses.third,
        first.first,
        first.second,
        second.first,
        second.second,
        third.first,
        third.second,
        return_name,
        facts,
        parameters,
    ).

root_case_three_direct(
    subject: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    first_pattern: ProjectedExpressionNode,
    first_body: ProjectedExpressionNode,
    second_pattern: ProjectedExpressionNode,
    second_body: ProjectedExpressionNode,
    third_pattern: ProjectedExpressionNode,
    third_body: ProjectedExpressionNode,
    return_name: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[List[SemanticBlockPlan]] ->
    if {
        return_name != ""
            and shallow_pattern_supported(first_pattern)
            and shallow_pattern_supported(second_pattern)
            and shallow_pattern_supported(third_pattern) -> let subject_plan = lower_expression(subject, 1, facts, parameters);
        let first_id = 1 + node_size(subject);
        let first_body_id = first_id + 1 + node_size(first_pattern);
        let first_body_plan = lower_expression(first_body, first_body_id, facts, parameters);
        let second_id = first_id + node_size(first);
        let second_body_id = second_id + 1 + node_size(second_pattern);
        let second_body_plan = lower_expression(second_body, second_body_id, facts, parameters);
        let third_id = second_id + node_size(second);
        let third_body_id = third_id + 1 + node_size(third_pattern);
        let third_body_plan = lower_expression(third_body, third_body_id, facts, parameters);
        Some(
            root_case_three_blocks(
                subject_plan,
                first_pattern,
                first_body_plan,
                second_pattern,
                second_body_plan,
                third_pattern,
                third_body_plan,
                projected_phi_type(return_name),
                facts,
                parameters,
            ),
        );
        true -> None
    }.

projected_phi_type(return_name: String): String ->
    return_name.

root_case_three_blocks(
    subject_plan: ExpressionPlan,
    first_pattern: ProjectedExpressionNode,
    first_body_plan: ExpressionPlan,
    second_pattern: ProjectedExpressionNode,
    second_body_plan: ExpressionPlan,
    third_pattern: ProjectedExpressionNode,
    third_body_plan: ExpressionPlan,
    phi_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticBlockPlan] ->
    let first_environment = "%case_environment_0";
    let second_environment = "%case_environment_1";
    let third_environment = "%case_environment_2";
    let first_match = "%case_match_0";
    let second_match = "%case_match_1";
    let third_match = "%case_match_2";
    let first_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(first_environment),
            shallow_pattern_operands(subject_plan.result, first_pattern),
            some_string("PatternMatch"),
        );
    let second_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(second_environment),
            shallow_pattern_operands(subject_plan.result, second_pattern),
            some_string("PatternMatch"),
        );
    let third_prepare =
        SemanticInstructionPlan(
            "prepare-pattern",
            some_string(third_environment),
            shallow_pattern_operands(subject_plan.result, third_pattern),
            some_string("PatternMatch"),
        );
    [
        SemanticBlockPlan(
            "entry",
            subject_plan.instructions,
            SemanticTerminatorPlan("jump", List.new[String](), ["case_pattern_0"]),
        ),
        SemanticBlockPlan(
            "case_pattern_0",
            [
                first_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(first_match),
                    [first_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [first_match], ["case_body_0", "case_pattern_1"]),
        ),
        SemanticBlockPlan(
            "case_body_0",
            concat_instructions(
                shallow_pattern_bindings(first_pattern, first_environment, facts, parameters),
                first_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_1",
            [
                second_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(second_match),
                    [second_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [second_match], ["case_body_1", "case_pattern_2"]),
        ),
        SemanticBlockPlan(
            "case_body_1",
            concat_instructions(
                shallow_pattern_bindings(second_pattern, second_environment, facts, parameters),
                second_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_pattern_2",
            [
                third_prepare,
                SemanticInstructionPlan(
                    "pattern-matched",
                    some_string(third_match),
                    [third_environment],
                    some_string("Bool"),
                ),
            ],
            SemanticTerminatorPlan("branch", [third_match], ["case_body_2", "case_unreachable"]),
        ),
        SemanticBlockPlan(
            "case_body_2",
            concat_instructions(
                shallow_pattern_bindings(third_pattern, third_environment, facts, parameters),
                third_body_plan.instructions,
            ),
            SemanticTerminatorPlan("jump", List.new[String](), ["case_join"]),
        ),
        SemanticBlockPlan(
            "case_unreachable",
            List.new[SemanticInstructionPlan](),
            SemanticTerminatorPlan("unreachable", List.new[String](), List.new[String]()),
        ),
        SemanticBlockPlan(
            "case_join",
            [
                SemanticInstructionPlan(
                    "phi",
                    some_string("%case_result"),
                    [
                        "case_body_0",
                        first_body_plan.result,
                        "case_body_1",
                        second_body_plan.result,
                        "case_body_2",
                        third_body_plan.result,
                    ],
                    some_string(phi_type),
                ),
            ],
            SemanticTerminatorPlan("return", ["%case_result"], List.new[String]()),
        ),
    ].

plans(
    module_name: String,
    declarations: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case declarations {
        [] -> List.new[SemanticFunctionPlan]();
        [declaration | rest] ->
            prepend_declaration_plan(
                declaration_plan(module_name, declaration, bodies, facts),
                declaration,
                module_name,
                rest,
                bodies,
                facts,
            )
    }.

declaration_plan(
    module_name: String,
    declaration: BackendDeclaration,
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case body_for(declaration.symbol_name, bodies) {
        Some(body) -> function_plan(module_name, declaration, body, facts);
        None -> None
    }.

prepend_declaration_plan(
    plan: Option[SemanticFunctionPlan],
    declaration: BackendDeclaration,
    module_name: String,
    rest: List[BackendDeclaration],
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case plan {
        Some(value) -> [value | concat_function_plans(
            declaration_lambda_plans(module_name, declaration, bodies, facts),
            plans(module_name, rest, bodies, facts),
        )];
        None -> plans(module_name, rest, bodies, facts)
    }.

concat_function_plans(
    left: List[SemanticFunctionPlan],
    right: List[SemanticFunctionPlan],
): List[SemanticFunctionPlan] ->
    case left {
        [] -> right;
        [value | rest] -> [value | concat_function_plans(rest, right)]
    }.

declaration_ir_parameters(declaration: BackendDeclaration): List[IrParameter] ->
    case declaration.payload {
        FunctionPayload(function) -> ir_parameters(function.typed_parameters);
        MethodPayload(method) -> [parameter(method.receiver) | ir_parameters(method.parameters)];
        _ -> List.new[IrParameter]()
    }.

lambda_function_plan(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): Option[SemanticFunctionPlan] ->
    case lambda_body(node) {
        Some(body) ->
            let captures = lambda_captures(node, outer_parameters);
            let parameters = append_ir_parameters(captures, lambda_parameters(node));
            let body_id = lambda_body_id(node, node_id);
            let expression = lower_expression(body, body_id, facts, parameters);
            Some(SemanticFunctionPlan(
                module_name = module_name,
                name = lambda_symbol(node),
                arity = parameter_count(parameters),
                capture_count = parameter_count(captures),
                receiver_mutable = false,
                receiver_command = false,
                parameters = parameters,
                resolved_return_type = resolved_or_dynamic(expression.result_type),
                blocks = projected_function_blocks(
                    body,
                    "",
                    projected_linear_blocks(expression),
                    facts,
                    parameters,
                ),
                native_symbol = none_string(),
            ));
        None -> None
    }.

lambda_nested_plans(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case lambda_body(node) {
        Some(body) ->
            let parameters = append_ir_parameters(
                lambda_captures(node, outer_parameters),
                lambda_parameters(node),
            );
            lambda_plans_at(module_name, body, lambda_body_id(node, node_id), parameters, facts);
        None -> List.new[SemanticFunctionPlan]()
    }.

prepend_lambda_plan(
    plan: Option[SemanticFunctionPlan],
    nested: List[SemanticFunctionPlan],
): List[SemanticFunctionPlan] ->
    case plan {
        Some(value) -> [value | nested];
        None -> nested
    }.

lambda_plans_at(
    module_name: String,
    node: ProjectedExpressionNode,
    node_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    if {
        node.kind == "lambda" -> prepend_lambda_plan(
            lambda_function_plan(module_name, node, node_id, outer_parameters, facts),
            lambda_nested_plans(module_name, node, node_id, outer_parameters, facts),
        );
        true -> lambda_child_plans(
            module_name,
            node.children,
            node_id + 1,
            outer_parameters,
            facts,
        )
    }.

lambda_child_plans(
    module_name: String,
    values: List[ProjectedExpressionNode],
    child_id: Int,
    outer_parameters: List[IrParameter],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case values {
        [] -> List.new[SemanticFunctionPlan]();
        [value | rest] -> concat_function_plans(
            lambda_plans_at(module_name, value, child_id, outer_parameters, facts),
            lambda_child_plans(
                module_name,
                rest,
                child_id + node_size(value),
                outer_parameters,
                facts,
            ),
        )
    }.

declaration_lambda_plans(
    module_name: String,
    declaration: BackendDeclaration,
    bodies: List[ProjectedBody],
    facts: List[InferredTypeFact],
): List[SemanticFunctionPlan] ->
    case body_for(declaration.symbol_name, bodies) {
        Some(body) ->
            case body.expression.node {
                Some(node) -> lambda_plans_at(
                    module_name,
                    node,
                    0,
                    declaration_ir_parameters(declaration),
                    facts,
                );
                None -> List.new[SemanticFunctionPlan]()
            };
        None -> List.new[SemanticFunctionPlan]()
    }.

struct_fields(values: List[StructFieldSyntax]): List[IrStructField] ->
    case values {
        [] -> List.new[IrStructField]();
        [value | rest] -> [IrStructField(
            value.name,
            if { value.annotation.valid -> value.annotation.syntax.text; true -> "" },
        ) | struct_fields(rest)]
    }.

struct_layouts(module_name: String, values: List[BackendDeclaration]): List[IrStructLayout] ->
    case values {
        [] -> List.new[IrStructLayout]();
        [value | rest] -> case value.payload {
            StructPayload(layout) -> [IrStructLayout(
                name = String.concat([module_name, ".", layout.name]),
                fields = struct_fields(layout.fields),
            ) | struct_layouts(module_name, rest)];
            _ -> struct_layouts(module_name, rest)
        }
    }.

pub lower(frontend: ProjectedFrontendModule, semantics: LocalSemanticResult): SemanticModulePlan ->
    SemanticModulePlan(
        name = frontend.backend.module_name,
        structs = struct_layouts(frontend.backend.module_name, frontend.backend.declarations),
        functions = plans(
            frontend.backend.module_name,
            frontend.backend.declarations,
            normalize_bodies(
                ProjectedComprehensionDesugar.bodies_with_facts(
                    frontend.bodies,
                    semantics.types.facts,
                ).values,
                frontend.backend.module_name,
                semantics.callables.uses,
            ),
            semantics.types.facts,
        ),
    ).
