/** Stable preorder evidence for projected operator expression trees. */
module self_host.ProjectedExpressionEvidence.


import std.core.Option.{None, Option, Some}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode, ProjectedExpressionResult}.


import std.collections.List.
import std.core.{Int, String}.

struct ExpressionEvidenceTask {
    node: ProjectedExpressionNode,
    depth: Int,
}.

constructor ExpressionEvidenceTask {
    (node: ProjectedExpressionNode, depth: Int): ExpressionEvidenceTask -> ExpressionEvidenceTask {
        node: node,
        depth: depth,
    }
}.

@pure
reverse_strings_at(values: List[String], output: List[String]): List[String] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_strings_at(rest, [value | output])
    }.

@pure
prepend_children(
    values: List[ProjectedExpressionNode],
    depth: Int,
    output: List[ExpressionEvidenceTask],
): List[ExpressionEvidenceTask] ->
    case values {
        [] -> output;
        [value | rest] -> [ExpressionEvidenceTask(value, depth) | prepend_children(rest, depth, output)]
    }.

@pure
rows_at(work: List[ExpressionEvidenceTask], output: List[String]): String ->
    case work {
        [] -> String.concat(reverse_strings_at(output, List.new[String]()));
        [task | rest] -> rows_at(
            prepend_children(task.node.children, task.depth + 1, rest),
            [String.concat([
                Int.to_string(task.depth), "\t", task.node.kind, "\t", task.node.text, "\t",
                Int.to_string(task.node.start_byte), "\t", Int.to_string(task.node.end_byte), "\n",
            ]) | output],
        )
    }.

@pure
rows(value: ProjectedExpressionNode): String ->
    rows_at([ExpressionEvidenceTask(value, 0)], List.new[String]()).

@pure
node_rows(value: Option[ProjectedExpressionNode]): String ->
    case value {
        Some(node) -> rows(node);
        None -> ""
    }.

@pure
pub document(value: ProjectedExpressionResult): String ->
    String.concat([
        "schema terlan.self-host.expression-tree/v1\nvalid\t",
        if { value.valid -> "true"; true -> "false" },
        "\ndepth\tkind\ttext\tstart\tend\n",
        node_rows(value.node),
    ]).
