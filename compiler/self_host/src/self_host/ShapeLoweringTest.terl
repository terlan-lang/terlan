/** Positive and negative contracts for shape payload lowering. */
module self_host.ShapeLoweringTest.

import self_host.PatternSyntax.{MapPattern}.

import std.collections.List.
import self_host.DeclarationLowering.
import self_host.Parser.
import self_host.ShapeLowering.

@pure
positive_shape(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Shape.\npub shape Named(name) = {name: name} where name != \"\".\n",
    ));
    case lowered_module.declarations {
        [declaration] ->
            let shape = ShapeLowering.lower(declaration);
            shape.valid
                and shape.has_guard
                and List.length(shape.parameters) == 1
                and shape.body.syntax.class == MapPattern;
        _ -> false
    }.

@pure
negative_shape(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Shape.\npub shape Broken(name) = {name}.\n",
    ));
    case lowered_module.declarations {
        [declaration] -> not ShapeLowering.lower(declaration).valid;
        _ -> false
    }.

@pure
invalid_uppercase_parameter(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Shape.\npub shape Broken(Name) = {name: Name}.\n",
    ));
    case lowered_module.declarations {
        [declaration] ->
            let shape = ShapeLowering.lower(declaration);
            not shape.valid and shape.message == "invalid shape parameter `Name`";
        _ -> false
    }.

@pure
duplicate_parameter(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Shape.\npub shape Broken(value, value) = {value: value}.\n",
    ));
    case lowered_module.declarations {
        [declaration] ->
            let shape = ShapeLowering.lower(declaration);
            not shape.valid and shape.message == "duplicate shape parameter `value`";
        _ -> false
    }.

@pure
duplicate_body_binding(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Shape.\npub shape Pair(value) = {value, value}.\n",
    ));
    case lowered_module.declarations {
        [declaration] ->
            let shape = ShapeLowering.lower(declaration);
            not shape.valid
                and shape.message == "shape `Pair` binds `value` more than once; duplicate shape bindings are ambiguous";
        _ -> false
    }.

pub self_test(): Bool ->
    positive_shape()
        and negative_shape()
        and invalid_uppercase_parameter()
        and duplicate_parameter()
        and duplicate_body_binding().

