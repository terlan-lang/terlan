/**
 * Deterministic JSON encoding for self-host backend IR ABI 1.
 */
module self_host.SelfHostIrJson.




import std.core.Result.{Ok, Result}.
import std.core.Option.{None, Option, Some}.
import std.core.Int.
import std.core.String.
import std.data.Json.
import std.collections.List.
import type std.data.Json.{Json, JsonError}.
import self_host.SelfHostIrSyntax.

import self_host.SelfHostIrSyntax.{BackendEnvelope, IrBlock, IrFunction, IrInstruction, IrModule, IrParameter, IrRegion, IrStructField, IrStructLayout, IrTerminator, IrTryRegion}.
string_array_at(values: List[String], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> string_array_at(rest, output.push(Json.string(value)))
    }.

string_array(values: List[String]): Json ->
    string_array_at(values, Json.array()).

optional_string(value: Option[String]): Json ->
    case value {
        None -> Json.null();
        Some(text) -> Json.string(text)
    }.

optional_int(value: Option[Int]): Json ->
    case value {
        None -> Json.null();
        Some(number) -> Json.int(number)
    }.

optional_string_array_at(values: List[Option[String]], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> optional_string_array_at(rest, output.push(optional_string(value)))
    }.

optional_string_array(values: List[Option[String]]): Json ->
    optional_string_array_at(values, Json.array()).

optional_try_region(value: Option[IrTryRegion]): Json ->
    case value {
        None -> Json.null();
        Some(region_value) -> try_region(region_value)
    }.

region(value: IrRegion): Json ->
    Json.object()
        .put("label", Json.string(value.label))
        .put("parameters", parameters(value.parameters))
        .put("blocks", blocks(value.blocks))
        .put("result", Json.string(value.result))
        .put("type_name", Json.string(value.type_name)).

regions_at(values: List[IrRegion], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> regions_at(rest, output.push(region(value)))
    }.

regions(values: List[IrRegion]): Json ->
    regions_at(values, Json.array()).

try_region(value: IrTryRegion): Json ->
    Json.object()
        .put("protected", region(value.protected))
        .put("success", region(value.success))
        .put("failure", region(value.failure))
        .put("cleanup", regions(value.cleanup)).

parameter(value: IrParameter): Json ->
    Json.object()
        .put("name", Json.string(value.name))
        .put("type_name", Json.string(value.type_name)).

parameters_at(values: List[IrParameter], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> parameters_at(rest, output.push(parameter(value)))
    }.

parameters(values: List[IrParameter]): Json ->
    parameters_at(values, Json.array()).

instruction(value: IrInstruction): Json ->
    Json.object()
        .put("opcode", Json.string(value.opcode))
        .put("result", optional_string(value.result))
        .put("operands", string_array(value.operands))
        .put("operand_types", optional_string_array(value.operand_types))
        .put("type_name", Json.string(value.type_name))
        .put("continuation_ordinal", optional_int(value.continuation_ordinal))
        .put("try_region", optional_try_region(value.try_region)).

instructions_at(values: List[IrInstruction], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> instructions_at(rest, output.push(instruction(value)))
    }.

instructions(values: List[IrInstruction]): Json ->
    instructions_at(values, Json.array()).

terminator(value: IrTerminator): Json ->
    Json.object()
        .put("opcode", Json.string(value.opcode))
        .put("operands", string_array(value.operands))
        .put("targets", string_array(value.targets)).

block(value: IrBlock): Json ->
    Json.object()
        .put("label", Json.string(value.label))
        .put("instructions", instructions(value.instructions))
        .put("terminator", terminator(value.terminator)).

blocks_at(values: List[IrBlock], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> blocks_at(rest, output.push(block(value)))
    }.

blocks(values: List[IrBlock]): Json ->
    blocks_at(values, Json.array()).

function(value: IrFunction): Json ->
    Json.object()
        .put("module_name", Json.string(value.module_name))
        .put("name", Json.string(value.name))
        .put("arity", Json.int(value.arity))
        .put("capture_count", Json.int(value.capture_count))
        .put("receiver_mutable", Json.bool(value.receiver_mutable))
        .put("receiver_command", Json.bool(value.receiver_command))
        .put("parameters", parameters(value.parameters))
        .put("return_type", Json.string(value.return_type))
        .put("blocks", blocks(value.blocks))
        .put("native_symbol", optional_string(value.native_symbol)).

functions_at(values: List[IrFunction], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> functions_at(rest, output.push(function(value)))
    }.

functions(values: List[IrFunction]): Json ->
    functions_at(values, Json.array()).

struct_layout(value: IrStructLayout): Json ->
    Json.object()
        .put("name", Json.string(value.name))
        .put("fields", struct_fields(value.fields)).

struct_field(value: IrStructField): Json ->
    Json.object()
        .put("name", Json.string(value.name))
        .put("type_name", Json.string(value.type_name)).

struct_fields_at(values: List[IrStructField], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> struct_fields_at(rest, output.push(struct_field(value)))
    }.

struct_fields(values: List[IrStructField]): Json ->
    struct_fields_at(values, Json.array()).

struct_layouts_at(values: List[IrStructLayout], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> struct_layouts_at(rest, output.push(struct_layout(value)))
    }.

struct_layouts(values: List[IrStructLayout]): Json ->
    struct_layouts_at(values, Json.array()).

ir_module_json(value: IrModule): Json ->
    Json.object()
        .put("name", Json.string(value.name))
        .put("structs", struct_layouts(value.structs))
        .put("functions", functions(value.functions)).

pub to_json(envelope: BackendEnvelope): Json ->
    Json.object()
        .put("abi_major", Json.int(envelope.abi_major))
        .put("abi_minor", Json.int(envelope.abi_minor))
        .put("target", Json.string(envelope.target))
        .put("module", ir_module_json(envelope.ir_module)).

@pure
quoted(value: String): String ->
    Json.quote_string(value).

@pure
optional_string_text(value: Option[String]): String ->
    case value {
        Some(text) -> quoted(text);
        None -> "null"
    }.

@pure
optional_int_text(value: Option[Int]): String ->
    case value {
        Some(number) -> Int.to_string(number);
        None -> "null"
    }.

@pure
string_items(values: List[String], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> string_items(
            rest,
            String.concat([output, separator, quoted(value)]),
            ",",
        )
    }.

@pure
string_array_text(values: List[String]): String ->
    String.concat(["[", string_items(values, "", ""), "]"]).

@pure
optional_string_items(
    values: List[Option[String]],
    output: String,
    separator: String,
): String ->
    case values {
        [] -> output;
        [value | rest] -> optional_string_items(
            rest,
            String.concat([output, separator, optional_string_text(value)]),
            ",",
        )
    }.

@pure
optional_string_array_text(values: List[Option[String]]): String ->
    String.concat(["[", optional_string_items(values, "", ""), "]"]).

@pure
optional_try_region_text(value: Option[IrTryRegion]): String ->
    case value {
        None -> "null";
        Some(region_value) -> try_region_text(region_value)
    }.

@pure
region_text(value: IrRegion): String ->
    String.concat([
        "{\"label\":", quoted(value.label),
        ",\"parameters\":", parameter_array_text(value.parameters),
        ",\"blocks\":", block_array_text(value.blocks),
        ",\"result\":", quoted(value.result),
        ",\"type_name\":", quoted(value.type_name),
        "}",
    ]).

@pure
region_items(values: List[IrRegion], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> region_items(
            rest,
            String.concat([output, separator, region_text(value)]),
            ",",
        )
    }.

@pure
region_array_text(values: List[IrRegion]): String ->
    String.concat(["[", region_items(values, "", ""), "]"]).

@pure
try_region_text(value: IrTryRegion): String ->
    String.concat([
        "{\"protected\":", region_text(value.protected),
        ",\"success\":", region_text(value.success),
        ",\"failure\":", region_text(value.failure),
        ",\"cleanup\":", region_array_text(value.cleanup),
        "}",
    ]).

@pure
parameter_text(value: IrParameter): String ->
    String.concat([
        "{\"name\":", quoted(value.name),
        ",\"type_name\":", quoted(value.type_name),
        "}",
    ]).

@pure
parameter_items(values: List[IrParameter], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> parameter_items(
            rest,
            String.concat([output, separator, parameter_text(value)]),
            ",",
        )
    }.

@pure
parameter_array_text(values: List[IrParameter]): String ->
    String.concat(["[", parameter_items(values, "", ""), "]"]).

@pure
instruction_text(value: IrInstruction): String ->
    String.concat([
        "{\"opcode\":", quoted(value.opcode),
        ",\"result\":", optional_string_text(value.result),
        ",\"operands\":", string_array_text(value.operands),
        ",\"operand_types\":", optional_string_array_text(value.operand_types),
        ",\"type_name\":", quoted(value.type_name),
        ",\"continuation_ordinal\":", optional_int_text(value.continuation_ordinal),
        ",\"try_region\":", optional_try_region_text(value.try_region),
        "}",
    ]).

@pure
instruction_items(values: List[IrInstruction], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> instruction_items(
            rest,
            String.concat([output, separator, instruction_text(value)]),
            ",",
        )
    }.

@pure
instruction_array_text(values: List[IrInstruction]): String ->
    String.concat(["[", instruction_items(values, "", ""), "]"]).

@pure
terminator_text(value: IrTerminator): String ->
    String.concat([
        "{\"opcode\":", quoted(value.opcode),
        ",\"operands\":", string_array_text(value.operands),
        ",\"targets\":", string_array_text(value.targets),
        "}",
    ]).

@pure
block_text(value: IrBlock): String ->
    String.concat([
        "{\"label\":", quoted(value.label),
        ",\"instructions\":", instruction_array_text(value.instructions),
        ",\"terminator\":", terminator_text(value.terminator),
        "}",
    ]).

@pure
block_items(values: List[IrBlock], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> block_items(
            rest,
            String.concat([output, separator, block_text(value)]),
            ",",
        )
    }.

@pure
block_array_text(values: List[IrBlock]): String ->
    String.concat(["[", block_items(values, "", ""), "]"]).

@pure
function_text(value: IrFunction): String ->
    String.concat([
        "{\"module_name\":", quoted(value.module_name),
        ",\"name\":", quoted(value.name),
        ",\"arity\":", Int.to_string(value.arity),
        ",\"capture_count\":", Int.to_string(value.capture_count),
        ",\"receiver_mutable\":", if { value.receiver_mutable -> "true"; true -> "false" },
        ",\"receiver_command\":", if { value.receiver_command -> "true"; true -> "false" },
        ",\"parameters\":", parameter_array_text(value.parameters),
        ",\"return_type\":", quoted(value.return_type),
        ",\"blocks\":", block_array_text(value.blocks),
        ",\"native_symbol\":", optional_string_text(value.native_symbol),
        "}",
    ]).

@pure
function_items(values: List[IrFunction], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> function_items(
            rest,
            String.concat([output, separator, function_text(value)]),
            ",",
        )
    }.

@pure
function_array_text(values: List[IrFunction]): String ->
    String.concat(["[", function_items(values, "", ""), "]"]).

@pure
struct_layout_text(value: IrStructLayout): String ->
    String.concat([
        "{\"name\":", quoted(value.name),
        ",\"fields\":", struct_field_array_text(value.fields),
        "}",
    ]).

@pure
struct_field_text(value: IrStructField): String ->
    String.concat([
        "{\"name\":", quoted(value.name),
        ",\"type_name\":", quoted(value.type_name),
        "}",
    ]).

@pure
struct_field_items(values: List[IrStructField], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> struct_field_items(
            rest,
            String.concat([output, separator, struct_field_text(value)]),
            ",",
        )
    }.

@pure
struct_field_array_text(values: List[IrStructField]): String ->
    String.concat(["[", struct_field_items(values, "", ""), "]"]).

@pure
struct_layout_items(values: List[IrStructLayout], output: String, separator: String): String ->
    case values {
        [] -> output;
        [value | rest] -> struct_layout_items(
            rest,
            String.concat([output, separator, struct_layout_text(value)]),
            ",",
        )
    }.

@pure
struct_layout_array_text(values: List[IrStructLayout]): String ->
    String.concat(["[", struct_layout_items(values, "", ""), "]"]).

@pure
module_text(value: IrModule): String ->
    String.concat([
        "{\"name\":", quoted(value.name),
        ",\"structs\":", struct_layout_array_text(value.structs),
        ",\"functions\":", function_array_text(value.functions),
        "}",
    ]).

/** Canonical target-neutral Core module encoding for optimizer equivalence evidence. */
@pure
pub encode_module(value: IrModule): String -> module_text(value).

@pure
envelope_text(envelope: BackendEnvelope): String ->
    String.concat([
        "{\"abi_major\":", Int.to_string(envelope.abi_major),
        ",\"abi_minor\":", Int.to_string(envelope.abi_minor),
        ",\"target\":", quoted(envelope.target),
        ",\"module\":", module_text(envelope.ir_module),
        "}",
    ]).

pub encode(envelope: BackendEnvelope): Result[String, JsonError] ->
    Ok(envelope_text(envelope)).
