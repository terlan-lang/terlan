/** Resolves dynamic-call results after binding and callable types are final. */
module self_host.ProjectedDynamicCallTypeMerge.

import std.core.String.

import std.collections.List.
import std.core.Option.{None, Option, Some}.
import self_host.ProjectedBodySyntax.{ProjectedBodies, ProjectedBody}.
import self_host.ProjectedExpressionSyntax.ProjectedExpressionNode.
import self_host.ProjectedTypeConstraintResolution.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintDiagnostic, TypeConstraintResolution}.
import self_host.ProjectedTypeEquivalence.

struct DynamicCallSite {
    call_node_id: Int,
    call_offset: Int,
    callee_node_id: Int,
    callee_offset: Int,
    argument_node_ids: List[Int],
    argument_offsets: List[Int],
}.

constructor DynamicCallSite {
    (call_offset: Int, callee_offset: Int, argument_offsets: List[Int]): DynamicCallSite ->
        DynamicCallSite {
            call_node_id: -1,
            call_offset: call_offset,
            callee_node_id: -1,
            callee_offset: callee_offset,
            argument_node_ids: List.new[Int](),
            argument_offsets: argument_offsets,
        };
    (call_node_id: Int, call_offset: Int, callee_node_id: Int, callee_offset: Int, argument_node_ids: List[Int], argument_offsets: List[Int]): DynamicCallSite ->
        DynamicCallSite {
            call_node_id: call_node_id,
            call_offset: call_offset,
            callee_node_id: callee_node_id,
            callee_offset: callee_offset,
            argument_node_ids: argument_node_ids,
            argument_offsets: argument_offsets,
        }
}.

struct DynamicScan {
    next_id: Int,
    sites: List[DynamicCallSite],
}.

constructor DynamicScan {
    (next_id: Int, sites: List[DynamicCallSite]): DynamicScan ->
        DynamicScan { next_id: next_id, sites: sites }
}.

append[T](left: List[T], right: List[T]): List[T] ->
    case left { [] -> right; [value | rest] -> [value | append(rest, right)] }.

argument_offset(value: ProjectedExpressionNode): Int ->
    if {
        value.kind == "named-argument" -> case value.children {
            [expression] -> expression.start_byte;
            _ -> value.start_byte
        };
        true -> value.start_byte
    }.

argument_offsets(values: List[ProjectedExpressionNode]): List[Int] ->
    case values {
        [] -> [];
        [value | rest] -> [argument_offset(value) | argument_offsets(rest)]
    }.

call_argument_offsets(values: List[ProjectedExpressionNode]): List[Int] ->
    case values {
        [_callee | [arguments | _rest]] -> argument_offsets(arguments.children);
        _ -> []
    }.

node_size(value: ProjectedExpressionNode): Int ->
    1 + nodes_size(value.children).

nodes_size(values: List[ProjectedExpressionNode]): Int ->
    case values {
        [] -> 0;
        [value | rest] -> node_size(value) + nodes_size(rest)
    }.

argument_node_id(value: ProjectedExpressionNode, node_id: Int): Int ->
    if {
        value.kind == "named-argument" and value.children != [] -> node_id + 1;
        true -> node_id
    }.

argument_node_ids(values: List[ProjectedExpressionNode], node_id: Int): List[Int] ->
    case values {
        [] -> [];
        [value | rest] -> [argument_node_id(value, node_id)
            | argument_node_ids(rest, node_id + node_size(value))]
    }.

call_argument_node_ids(values: List[ProjectedExpressionNode], node_id: Int): List[Int] ->
    case values {
        [callee | [arguments | _rest]] -> argument_node_ids(
            arguments.children,
            node_id + 1 + node_size(callee) + 1,
        );
        _ -> []
    }.

scan_children(values: List[ProjectedExpressionNode], next_id: Int): DynamicScan ->
    case values {
        [] -> DynamicScan(next_id, []);
        [value | rest] -> let current = scan_node(value, next_id);
            let remaining = scan_children(rest, current.next_id);
            DynamicScan(
                remaining.next_id,
                append(current.sites, remaining.sites),
            )
    }.

scan_node(value: ProjectedExpressionNode, node_id: Int): DynamicScan ->
    let nested = scan_children(value.children, node_id + 1);
    if {
        value.kind == "dynamic-call" -> case value.children {
            [callee | _arguments] -> DynamicScan(nested.next_id, [DynamicCallSite(
                node_id,
                value.start_byte,
                node_id + 1,
                callee.start_byte,
                call_argument_node_ids(value.children, node_id),
                call_argument_offsets(value.children),
            ) | nested.sites]);
            _ -> nested
        };
        true -> nested
    }.

node_sites(value: ProjectedExpressionNode): List[DynamicCallSite] ->
    scan_node(value, 0).sites.

body_scan(values: List[ProjectedBody], next_id: Int): DynamicScan ->
    case values {
        [] -> DynamicScan(next_id, []);
        [value | rest] -> case value.expression.node {
            Some(node) -> let current = scan_node(node, next_id);
                let remaining = body_scan(rest, current.next_id);
                DynamicScan(
                    remaining.next_id,
                    append(current.sites, remaining.sites),
                );
            None -> body_scan(rest, next_id)
        }
    }.

body_sites(values: List[ProjectedBody]): List[DynamicCallSite] ->
    body_scan(values, 0).sites.

fact_type(node_id: Int, byte_offset: Int, values: List[InferredTypeFact]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            (node_id >= 0 and value.node_id == node_id)
                or (node_id < 0 and value.byte_offset == byte_offset) -> case value.type_name {
                Some(name) -> Some(name);
                None -> fact_type(node_id, byte_offset, rest)
            };
            true -> fact_type(node_id, byte_offset, rest)
        }
    }.

result_fact_type(
    node_id: Int,
    byte_offset: Int,
    values: List[InferredTypeFact],
    current: Option[String],
): Option[String] ->
    case values {
        [] -> current;
        [value | rest] -> if {
            ((node_id >= 0 and value.node_id == node_id)
                or (node_id < 0 and value.byte_offset == byte_offset))
                and value.type_name != None -> value.type_name;
            true -> result_fact_type(node_id, byte_offset, rest, current)
        }
    }.

site_at(node_id: Int, byte_offset: Int, values: List[DynamicCallSite]): Option[DynamicCallSite] ->
    case values {
        [] -> None;
        [value | rest] -> if {
            (node_id >= 0 and value.call_node_id == node_id)
                or (node_id < 0 and value.call_node_id < 0 and value.call_offset == byte_offset) -> Some(value);
            true -> site_at(node_id, byte_offset, rest)
        }
    }.

merge_fact(
    value: InferredTypeFact,
    sites: List[DynamicCallSite],
    all: List[InferredTypeFact],
): InferredTypeFact ->
    case value.type_name {
        Some(_known) -> value;
        None -> case site_at(value.node_id, value.byte_offset, sites) {
        None -> value;
        Some(site) -> case fact_type(site.callee_node_id, site.callee_offset, all) {
            None -> value;
            Some(callable_type) -> case ProjectedTypeConstraintResolution.function_return(callable_type) {
                None -> value;
                Some(return_type) -> InferredTypeFact(
                    value.node_id,
                    Some(return_type),
                    value.byte_offset,
                )
            }
        }
        }
    }.

merge_facts(
    values: List[InferredTypeFact],
    sites: List[DynamicCallSite],
    all: List[InferredTypeFact],
): List[InferredTypeFact] ->
    case values {
        [] -> [];
        [value | rest] -> [merge_fact(value, sites, all) | merge_facts(rest, sites, all)]
    }.

diagnostic_exists(
    code: String,
    byte_offset: Int,
    values: List[TypeConstraintDiagnostic],
): Bool ->
    case values {
        [] -> false;
        [value | rest] ->
            (value.byte_offset == byte_offset and value.code == code)
                or diagnostic_exists(code, byte_offset, rest)
    }.

size[T](values: List[T]): Int ->
    case values { [] -> 0; [_value | rest] -> 1 + size(rest) }.

type_matches(expected: String, actual: String): Bool ->
    ProjectedTypeEquivalence.matches(expected, actual).

argument_diagnostics(
    expected: List[String],
    node_ids: List[Int],
    offsets: List[Int],
    facts: List[InferredTypeFact],
    existing: List[TypeConstraintDiagnostic],
): List[TypeConstraintDiagnostic] ->
    case {expected, offsets} {
        {[], _} -> [];
        {_, []} -> [];
        {[expected_type | expected_rest], [offset | offset_rest]} ->
            let node_id = case node_ids { [value | _rest] -> value; [] -> -1 };
            let remaining_ids = case node_ids { [_value | rest] -> rest; [] -> [] };
            let rest = argument_diagnostics(expected_rest, remaining_ids, offset_rest, facts, existing);
            case result_fact_type(node_id, offset, facts, None) {
                None -> if {
                    diagnostic_exists("unresolved-call-argument-type", offset, existing) -> rest;
                    true -> [TypeConstraintDiagnostic(
                        "unresolved-call-argument-type",
                        "call argument type is unresolved",
                        offset,
                    ) | rest]
                };
                Some(actual_type) -> if {
                    type_matches(expected_type, actual_type)
                        or diagnostic_exists("call-argument-type-mismatch", offset, existing) -> rest;
                    true -> [TypeConstraintDiagnostic(
                        "call-argument-type-mismatch",
                        String.concat([
                            "call argument type mismatch: expected ",
                            expected_type,
                            ", found ",
                            actual_type,
                        ]),
                        offset,
                    ) | rest]
                }
            }
    }.

callable_diagnostics(
    site: DynamicCallSite,
    callable_type: String,
    facts: List[InferredTypeFact],
    existing: List[TypeConstraintDiagnostic],
): List[TypeConstraintDiagnostic] ->
    case ProjectedTypeConstraintResolution.function_parameters(callable_type) {
        None -> if {
            diagnostic_exists("invalid-dynamic-call-target", site.call_offset, existing) -> [];
            true -> [TypeConstraintDiagnostic(
                "invalid-dynamic-call-target",
                "dynamic call target does not have a function type",
                site.call_offset,
            )]
        };
        Some(expected) -> if {
            size(expected) != size(site.argument_offsets) -> if {
                diagnostic_exists("dynamic-call-arity-mismatch", site.call_offset, existing) -> [];
                true -> [TypeConstraintDiagnostic(
                    "dynamic-call-arity-mismatch",
                    "dynamic call argument count does not match the function type",
                    site.call_offset,
                )]
            };
            true -> argument_diagnostics(
                expected,
                site.argument_node_ids,
                site.argument_offsets,
                facts,
                existing,
            )
        }
    }.

site_diagnostics(
    sites: List[DynamicCallSite],
    facts: List[InferredTypeFact],
    existing: List[TypeConstraintDiagnostic],
): List[TypeConstraintDiagnostic] ->
    case sites {
        [] -> [];
        [value | rest] -> case fact_type(value.callee_node_id, value.callee_offset, facts) {
            Some(callable_type) -> append(
                callable_diagnostics(value, callable_type, facts, existing),
                site_diagnostics(rest, facts, existing),
            );
            None -> site_diagnostics(rest, facts, existing)
        }
    }.

merge_sites(
    value: TypeConstraintResolution,
    sites: List[DynamicCallSite],
): TypeConstraintResolution -> TypeConstraintResolution(
    merge_facts(value.facts, sites, value.facts),
    append(
        value.diagnostics,
        site_diagnostics(sites, value.facts, value.diagnostics),
    ),
).

/** Testable single-expression merge boundary. */
pub merge_expression(
    value: TypeConstraintResolution,
    expression: ProjectedExpressionNode,
): TypeConstraintResolution -> merge_sites(value, node_sites(expression)).

/** Applies dependent dynamic-call typing to every projected body. */
pub merge(
    value: TypeConstraintResolution,
    bodies: ProjectedBodies,
): TypeConstraintResolution -> merge_sites(value, body_sites(bodies.values)).
