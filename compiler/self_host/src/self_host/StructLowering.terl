/** Self-hosted lowering for struct declarations and typed field defaults. */
module self_host.StructLowering.

import std.core.String.

import self_host.DeclarationPayloadSyntax.{StructFieldSyntax, StructSyntax}.
import self_host.DeclarationSyntax.{DeclarationSyntax}.
import self_host.ExpressionSyntax.{ExpressionParse}.
import self_host.Syntax.{StructDeclaration}.
import self_host.TypeSyntax.{TypeParse}.

import std.collections.List.
import std.core.{Bool, Int, String}.
import self_host.Delimited.
import self_host.ExpressionParser.
import self_host.TypeParser.


@pure
drop_terminal_empty(values: List[String]): List[String] ->
    case values {
        [] -> List.new[String]();
        [""] -> List.new[String]();
        [value | rest] -> [value | drop_terminal_empty(rest)]
    }.

@pure
field_name(source: String, colon: Int): String ->
    let name = String.trim(source.utf8_slice(0, colon));
    if {
        String.starts_with(name, "#") -> String.trim(name.utf8_slice(1, name.byte_size() - 1));
        true -> name
    }.

@pure
field_type_end(normalized: String, assignment: Int): Int ->
    if {
        assignment < 0 -> normalized.byte_size();
        true -> assignment
    }.

@pure
field_annotation(normalized: String, colon: Int, type_end: Int): TypeParse ->
    if {
        colon < 0 -> TypeParser.parse("");
        true -> TypeParser.parse(String.trim(normalized.utf8_slice(colon + 1, type_end - colon - 1)))
    }.

@pure
field_default(normalized: String, assignment: Int): ExpressionParse ->
    if {
        assignment < 0 -> ExpressionParser.parse("");
        true -> ExpressionParser.parse(String.trim(normalized.utf8_slice(assignment + 1, normalized.byte_size() - assignment - 1)))
    }.

@pure
field_name_or_empty(normalized: String, colon: Int): String ->
    if {
        colon < 0 -> "";
        true -> field_name(normalized, colon)
    }.

@pure
field_message_after_annotation(assignment: Int, default_valid: Bool, default_message: String): String ->
    if {
        assignment >= 0 and not default_valid -> default_message;
        true -> ""
    }.

@pure
field_message_after_colon(annotation_valid: Bool, annotation_message: String, assignment: Int, default_valid: Bool, default_message: String): String ->
    if {
        not annotation_valid -> annotation_message;
        true -> field_message_after_annotation(assignment, default_valid, default_message)
    }.

@pure
field_message(colon: Int, annotation_valid: Bool, annotation_message: String, assignment: Int, default_valid: Bool, default_message: String): String ->
    if {
        colon < 0 -> "struct field is missing its type annotation";
        true -> field_message_after_colon(annotation_valid, annotation_message, assignment, default_valid, default_message)
    }.

@pure
lower_field(source: String): StructFieldSyntax ->
    let normalized = String.trim(source);
    let colon = Delimited.top_level_byte(normalized, 58);
    let assignment = Delimited.top_level_assignment(normalized);
    let type_end = field_type_end(normalized, assignment);
    let annotation = field_annotation(normalized, colon, type_end);
    let default_value = field_default(normalized, assignment);
    let valid = colon >= 0 and annotation.valid and (assignment < 0 or default_value.valid);
    StructFieldSyntax(
        valid,
        field_name_or_empty(normalized, colon),
        annotation,
        assignment >= 0,
        default_value,
        String.starts_with(normalized, "#"),
        field_message(colon, annotation.valid, annotation.message, assignment, default_value.valid, default_value.message),
    ).

@pure
pub lower_fields(values: List[String]): List[StructFieldSyntax] ->
    case values {
        [] -> List.new[StructFieldSyntax]();
        [value | rest] -> [lower_field(value) | lower_fields(rest)]
    }.

@pure
pub fields_valid(values: List[StructFieldSyntax]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> value.valid and fields_valid(rest)
    }.

@pure
pub first_error(values: List[StructFieldSyntax]): String ->
    case values {
        [] -> "";
        [value | rest] -> if { value.valid -> first_error(rest); true -> value.message }
    }.

@pure
contains_field_name(values: List[StructFieldSyntax], name: String): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value.name == name or contains_field_name(rest, name)
    }.

@pure
first_duplicate_field(values: List[StructFieldSyntax]): String ->
    case values {
        [] -> "";
        [value | rest] -> if {
            contains_field_name(rest, value.name) -> value.name;
            true -> first_duplicate_field(rest)
        }
    }.

@pure
struct_field_text(source: DeclarationSyntax, open: Int, body_valid: Bool): String ->
    if {
        body_valid -> source.body.utf8_slice(open + 1, source.body.byte_size() - open - 3);
        true -> ""
    }.

@pure
strip_comments_at(
    source: String,
    index: Int,
    copy_start: Int,
    comment: Int,
    quote_byte: Int,
    escaped: Bool,
    output: String,
): String ->
    if {
        index >= source.byte_size() -> if {
            comment == 0 -> String.append(
                output,
                source.utf8_slice(copy_start, source.byte_size() - copy_start),
            );
            true -> output
        };
        comment == 1
            and index + 1 < source.byte_size()
            and source.utf8_byte_at(index) == 42
            and source.utf8_byte_at(index + 1) == 47 -> strip_comments_at(
                source,
                index + 2,
                index + 2,
                0,
                0,
                false,
                String.append(output, " "),
            );
        comment == 1 -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            comment,
            quote_byte,
            escaped,
            output,
        );
        comment == 2 and source.utf8_byte_at(index) == 10 -> strip_comments_at(
            source,
            index,
            index,
            0,
            0,
            false,
            output,
        );
        comment == 2 -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            comment,
            quote_byte,
            escaped,
            output,
        );
        quote_byte != 0 and escaped -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            0,
            quote_byte,
            false,
            output,
        );
        quote_byte != 0 and source.utf8_byte_at(index) == 92 -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            0,
            quote_byte,
            true,
            output,
        );
        quote_byte != 0 and source.utf8_byte_at(index) == quote_byte -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            0,
            0,
            false,
            output,
        );
        quote_byte != 0 -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            0,
            quote_byte,
            false,
            output,
        );
        source.utf8_byte_at(index) == 34 or source.utf8_byte_at(index) == 39 ->
            strip_comments_at(
                source,
                index + 1,
                copy_start,
                0,
                source.utf8_byte_at(index),
                false,
                output,
            );
        index + 1 < source.byte_size()
            and source.utf8_byte_at(index) == 47
            and source.utf8_byte_at(index + 1) == 42 -> strip_comments_at(
                source,
                index + 2,
                index + 2,
                1,
                0,
                false,
                String.append(output, source.utf8_slice(copy_start, index - copy_start)),
            );
        index + 1 < source.byte_size()
            and source.utf8_byte_at(index) == 47
            and source.utf8_byte_at(index + 1) == 47 -> strip_comments_at(
                source,
                index + 2,
                index + 2,
                2,
                0,
                false,
                String.append(output, source.utf8_slice(copy_start, index - copy_start)),
            );
        true -> strip_comments_at(
            source,
            index + 1,
            copy_start,
            0,
            0,
            false,
            output,
        )
    }.

@pure
strip_comments(source: String): String ->
    strip_comments_at(source, 0, 0, 0, 0, false, "").

@pure
struct_fields(field_text: String, body_valid: Bool): List[StructFieldSyntax] ->
    if {
        body_valid -> lower_fields(drop_terminal_empty(Delimited.split_top_level(
            strip_comments(field_text),
            44,
        )));
        true -> List.new[StructFieldSyntax]()
    }.

@pure
struct_message_after_fields(fields: List[StructFieldSyntax], duplicate_field: String): String ->
    if {
        not fields_valid(fields) -> first_error(fields);
        duplicate_field != "" -> String.concat(["duplicate field \`", duplicate_field, "\` in struct declaration"]);
        true -> ""
    }.

@pure
struct_message_after_supported(body_valid: Bool, fields: List[StructFieldSyntax], duplicate_field: String): String ->
    if {
        not body_valid -> "struct body is incomplete";
        true -> struct_message_after_fields(fields, duplicate_field)
    }.

@pure
struct_message(supported: Bool, body_valid: Bool, fields: List[StructFieldSyntax], duplicate_field: String): String ->
    if {
        not supported -> "declaration is not a struct";
        true -> struct_message_after_supported(body_valid, fields, duplicate_field)
    }.

@pure
pub lower(source: DeclarationSyntax): StructSyntax ->
    let open = Delimited.top_level_byte(source.body, 123);
    let supported = source.class == StructDeclaration;
    let body_valid = open >= 0 and String.ends_with(String.trim(source.body), "}.");
    let field_text = struct_field_text(source, open, body_valid);
    let fields = struct_fields(field_text, body_valid);
    let duplicate_field = first_duplicate_field(fields);
    StructSyntax(
        supported and body_valid and fields_valid(fields) and duplicate_field == "",
        source.name,
        fields,
        source.is_public,
        source.span,
        struct_message(supported, body_valid, fields, duplicate_field),
    ).
