/** Normalized type, pattern, and expression trees used by Phase 2 parity gates. */
module self_host.ProjectedFragmentEvidence.


import std.core.Option.{None, Option, Some}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedTypeSyntax.{ProjectedTypeNode}.

import self_host.ProjectedExpressionParser.
import self_host.ProjectedPatternParser.
import self_host.ProjectedTypeParser.
import self_host.ProjectionAdapter.
import std.collections.List.
import std.core.{Bool, Int, String}.
import self_host.CanonicalToken.{CanonicalToken}.

@pure
without_eof(values: List[CanonicalToken]): List[CanonicalToken] ->
    case values {
        [] -> List.new[CanonicalToken]();
        [value | rest] -> if {
            value.terminal == "eof" -> without_eof(rest);
            true -> [value | without_eof(rest)]
        }
    }.

@pure
expression_constructor_chain(kind: String): String ->
    if { kind == "constructor-chain" -> "constructor_chain"; true -> String.replace(kind, "-", "_") }.

@pure
expression_record_update(kind: String): String ->
    if { kind == "record-update" -> "record_update"; true -> expression_constructor_chain(kind) }.

@pure
expression_record_access(kind: String): String ->
    if { kind == "record-access" -> "record_access"; true -> expression_record_update(kind) }.

@pure
expression_atom_literal(kind: String): String ->
    if { kind == "atom-literal" -> "atom_literal"; true -> expression_record_access(kind) }.

@pure
expression_fixed_array(kind: String): String ->
    if { kind == "fixed-array" -> "fixed_array"; true -> expression_atom_literal(kind) }.

@pure
expression_dynamic_call(kind: String): String ->
    if { kind == "dynamic-call" -> "call"; true -> expression_fixed_array(kind) }.

@pure
expression_field(kind: String): String ->
    if { kind == "field" -> "field_access"; true -> expression_dynamic_call(kind) }.

@pure
expression_keyed_field(kind: String): String ->
    if { kind == "keyed-field" -> "map_field"; true -> expression_field(kind) }.

@pure
expression_keyed(kind: String): String ->
    if { kind == "keyed-container" or kind == "nominal-keyed" -> "map"; true -> expression_keyed_field(kind) }.

@pure
expression_group(kind: String): String ->
    if { kind == "tuple-or-group" or kind == "tuple" -> "group"; true -> expression_keyed(kind) }.

@pure
expression_binding(kind: String): String ->
    if { kind == "identifier" or kind == "constructor" or kind == "atom" -> "binding"; true -> expression_group(kind) }.

@pure
expression_kind(kind: String): String ->
    if { kind == "integer" -> "int"; true -> expression_binding(kind) }.

@pure
pattern_keyed_field(kind: String): String ->
    if { kind == "keyed-pattern-field" -> "pattern_field"; true -> expression_kind(kind) }.

@pure
pattern_map(kind: String): String ->
    if { kind == "keyed-pattern" or kind == "struct-pattern" or kind == "keyed-container-pattern" -> "pattern_map"; true -> pattern_keyed_field(kind) }.

@pure
pattern_list_cons(kind: String): String ->
    if { kind == "list-cons-pattern" -> "pattern_list_cons"; true -> pattern_map(kind) }.

@pure
pattern_list(kind: String): String ->
    if { kind == "list-pattern" -> "pattern_list"; true -> pattern_list_cons(kind) }.

@pure
pattern_tuple(kind: String): String ->
    if { kind == "tuple-pattern" -> "pattern_tuple"; true -> pattern_list(kind) }.

@pure
pattern_constructor(kind: String): String ->
    if { kind == "constructor-pattern" -> "pattern_constructor"; true -> pattern_tuple(kind) }.

@pure
pattern_kind(kind: String): String ->
    if {
        kind == "binding-pattern" or kind == "wildcard-pattern"
            or kind == "literal-pattern" or kind == "typed-pattern"
            or kind == "string-capture-pattern" or kind == "pattern-token" -> "pattern";
        true -> pattern_constructor(kind)
    }.

@pure
type_field_kind(kind: String): String ->
    if { kind == "field" or kind == "item" -> "type_field"; true -> String.replace(kind, "-", "_") }.

@pure
type_aggregate_kind(kind: String): String ->
    if { kind == "tuple-type" or kind == "record-or-tuple-type" -> "type_aggregate"; true -> type_field_kind(kind) }.

@pure
type_existential_kind(kind: String): String ->
    if { kind == "existential-type" -> "type_existential"; true -> type_aggregate_kind(kind) }.

@pure
type_arrow_kind(kind: String): String ->
    if { kind == "function-type" -> "type_arrow"; true -> type_existential_kind(kind) }.

@pure
type_union_kind(kind: String): String ->
    if { kind == "union-type" -> "type_union"; true -> type_arrow_kind(kind) }.

@pure
type_kind(kind: String): String ->
    if { kind == "named-type" or kind == "atom-type" or kind == "generic-type" -> "type"; true -> type_union_kind(kind) }.

@pure
row(depth: Int, kind: String, start_byte: Int, end_byte: Int): String ->
    String.concat([
        Int.to_string(depth), "\t", kind, "\t", Int.to_string(start_byte), "\t",
        Int.to_string(end_byte), "\n",
    ]).

@pure
expression_wrapper(value: ProjectedExpressionNode): Bool ->
    value.kind == "call-arguments" or value.kind == "keyed-fields"
        or value.kind == "keyed-pattern-fields" or value.kind == "patterns"
        or (value.kind == "sequence" and value.text == ",").

@pure
expression_rows(values: List[ProjectedExpressionNode], depth: Int): String ->
    case values {
        [] -> "";
        [value | rest] where expression_wrapper(value) -> String.concat([
            expression_rows(value.children, depth), expression_rows(rest, depth),
        ]);
        [value | rest] -> String.concat([
            row(depth, expression_kind(value.kind), value.start_byte, value.end_byte),
            expression_rows(value.children, depth + 1), expression_rows(rest, depth),
        ])
    }.

@pure
pattern_regular_row(value: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], depth: Int): String ->
    String.concat([
        row(depth, pattern_kind(value.kind), value.start_byte, value.end_byte),
        pattern_rows(value.children, depth + 1), pattern_rows(rest, depth),
    ]).

@pure
pattern_field_row(value: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], depth: Int): String ->
    if {
        value.kind == "pattern-field" or value.kind == "keyed-pattern-field" -> String.concat([
            row(depth, "map_field", value.start_byte, value.end_byte),
            pattern_field_rows(value.children, depth + 1), pattern_rows(rest, depth),
        ]);
        true -> pattern_regular_row(value, rest, depth)
    }.

@pure
pattern_value_row(value: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], depth: Int): String ->
    if {
        value.kind == "patterns" or value.kind == "keyed-pattern-fields" -> String.concat([
            pattern_rows(value.children, depth), pattern_rows(rest, depth),
        ]);
        true -> pattern_field_row(value, rest, depth)
    }.

@pure
pattern_rows(values: List[ProjectedExpressionNode], depth: Int): String ->
    case values {
        [] -> "";
        [value | rest] -> pattern_value_row(value, rest, depth)
    }.

@pure
pattern_field_kind(kind: String): String ->
    if { kind == "binding-pattern" or kind == "pattern-token" -> "binding"; true -> pattern_kind(kind) }.

@pure
pattern_field_rows(values: List[ProjectedExpressionNode], depth: Int): String ->
    case values {
        [] -> "";
        [value | rest] -> String.concat([
            row(depth, pattern_field_kind(value.kind), value.start_byte, value.end_byte),
            pattern_rows(value.children, depth + 1), pattern_field_rows(rest, depth),
        ])
    }.

@pure
type_rows(values: List[ProjectedTypeNode], depth: Int): String ->
    case values {
        [] -> "";
        [value | rest] where value.kind == "types" or value.kind == "fields" or value.kind == "item" -> String.concat([
            type_rows(value.children, depth), type_rows(rest, depth),
        ]);
        [value | rest] -> String.concat([
            row(depth, type_kind(value.kind), value.start_byte, value.end_byte),
            type_rows(value.children, depth + 1), type_rows(rest, depth),
        ])
    }.

@pure
expression_document_rows(value: Option[ProjectedExpressionNode]): String ->
    case value { Some(node_value) -> expression_rows([node_value], 0); None -> "" }.

@pure
pattern_document_rows(value: Option[ProjectedExpressionNode]): String ->
    case value { Some(node_value) -> pattern_rows([node_value], 0); None -> "" }.

@pure
type_document_rows(value: Option[ProjectedTypeNode]): String ->
    case value { Some(node_value) -> type_rows([node_value], 0); None -> "" }.

@pure
header(mode: String, valid: Bool, message: String): String ->
    String.concat([
        "schema terlan.self-host.fragment-syntax/v1\nmode\t", mode, "\nvalid\t",
        if { valid -> "true"; true -> "false" }, "\nmessage_bytes\t",
        Int.to_string(String.byte_size(message)), "\ndepth\tkind\tstart\tend\n",
    ]).

/** Parses one source fragment and emits its normalized structural evidence. */
@pure
pub document(mode: String, source: String, lex_valid: Bool, values: List[CanonicalToken]): Option[String] ->
    let projected = ProjectionAdapter.rewrite(source, without_eof(values));
    if {
        mode == "expression" -> let parsed = ProjectedExpressionParser.parse(projected);
            Some(String.concat([
                header(mode, lex_valid and parsed.valid, parsed.message),
                expression_document_rows(parsed.node),
            ]));
        mode == "pattern" -> let parsed = ProjectedPatternParser.parse(projected);
            Some(String.concat([
                header(mode, lex_valid and parsed.valid, parsed.message),
                pattern_document_rows(parsed.node),
            ]));
        mode == "type" -> let parsed = ProjectedTypeParser.parse(projected);
            Some(String.concat([
                header(mode, lex_valid and parsed.valid, parsed.message),
                type_document_rows(parsed.node),
            ]));
        true -> None
    }.
