/** Self-hosted lowering for reusable shape patterns and guards. */
module self_host.ShapeLowering.

import std.core.String.

import self_host.DeclarationSyntax.{DeclarationSyntax}.
import self_host.PatternSyntax.{ConstructorPattern, GroupedPattern, ListConsPattern, ListPattern, MapPattern, NamePattern, NominalKeyedPattern, PatternClass, PatternParse, TuplePattern, WildcardPattern}.
import self_host.ShapeSyntax.{ShapeSyntax}.
import self_host.Syntax.{ShapeDeclaration}.

import std.collections.List.
import std.core.{Bool, Int, String}.
import self_host.Delimited.
import self_host.ExpressionParser.
import self_host.PatternParser.


@pure
drop_terminal_empty(values: List[String]): List[String] ->
    case values {
        [] -> List.new[String]();
        [""] -> List.new[String]();
        [value | rest] -> [value | drop_terminal_empty(rest)]
    }.

@pure
parse_patterns(values: List[String]): List[PatternParse] ->
    case values {
        [] -> List.new[PatternParse]();
        [value | rest] -> [PatternParser.parse(value) | parse_patterns(rest)]
    }.

@pure
patterns_valid(values: List[PatternParse]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> value.valid and patterns_valid(rest)
    }.

@pure
valid_shape_parameter(value: PatternParse): Bool ->
    value.valid
        and (value.syntax.class == NamePattern or value.syntax.class == WildcardPattern)
        and value.syntax.text == value.syntax.text.lowercase().

@pure
shape_parameters_valid(values: List[PatternParse]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> valid_shape_parameter(value) and shape_parameters_valid(rest)
    }.

@pure
contains_parameter(values: List[String], name: String): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value == name or contains_parameter(rest, name)
    }.

@pure
has_duplicate_parameter(values: List[PatternParse], seen: List[String]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> if {
            contains_parameter(seen, value.syntax.text) -> true;
            true -> has_duplicate_parameter(rest, [value.syntax.text | seen])
        }
    }.

@pure
first_invalid_shape_parameter(values: List[PatternParse]): String ->
    case values {
        [] -> "";
        [value | rest] -> if {
            valid_shape_parameter(value) -> first_invalid_shape_parameter(rest);
            true -> value.syntax.text
        }
    }.

@pure
first_duplicate_shape_parameter(values: List[PatternParse], seen: List[String]): String ->
    case values {
        [] -> "";
        [value | rest] -> if {
            contains_parameter(seen, value.syntax.text) -> value.syntax.text;
            true -> first_duplicate_shape_parameter(rest, [value.syntax.text | seen])
        }
    }.

@pure
append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

@pure
keyed_pattern_value(source: String): String ->
    let colon = Delimited.top_level_byte(source, 58);
    if {
        colon < 0 -> source;
        true -> String.trim(source.utf8_slice(colon + 1, source.byte_size() - colon - 1))
    }.

@pure
pattern_parts_are_keyed(class: PatternClass): Bool ->
    class == MapPattern or class == NominalKeyedPattern.

@pure
pattern_part_bindings(part: String, keyed: Bool): List[String] ->
    if {
        keyed -> pattern_bindings(PatternParser.parse(keyed_pattern_value(part)));
        true -> pattern_bindings(PatternParser.parse(part))
    }.

@pure
pattern_parts_bindings(parts: List[String], keyed: Bool): List[String] ->
    case parts {
        [] -> List.new[String]();
        [part | rest] -> append(
            pattern_part_bindings(part, keyed),
            pattern_parts_bindings(rest, keyed),
        )
    }.

@pure
pattern_has_nested_bindings(class: PatternClass): Bool ->
    class == ConstructorPattern
        or class == TuplePattern
        or class == MapPattern
        or class == ListPattern
        or class == ListConsPattern
        or class == NominalKeyedPattern
        or class == GroupedPattern.

@pure
pattern_bindings(value: PatternParse): List[String] ->
    if {
        value.syntax.class == NamePattern -> [value.syntax.text];
        pattern_has_nested_bindings(value.syntax.class) ->
            pattern_parts_bindings(
                value.syntax.parts,
                pattern_parts_are_keyed(value.syntax.class),
            );
        true -> List.new[String]()
    }.

@pure
first_duplicate_binding(values: List[String], seen: List[String]): String ->
    case values {
        [] -> "";
        [value | rest] -> if {
            contains_parameter(seen, value) -> value;
            true -> first_duplicate_binding(rest, [value | seen])
        }
    }.

@pure
shape_binding_message(name: String, duplicate: String): String ->
    String.concat([
        "shape `",
        name,
        "` binds `",
        duplicate,
        "` more than once; duplicate shape bindings are ambiguous",
    ]).

@pure
final_shape_message(name: String, duplicate: String, fallback: String): String ->
    if {
        fallback != "" -> fallback;
        duplicate == "" -> "";
        true -> shape_binding_message(name, duplicate)
    }.

@pure
first_pattern_error(values: List[PatternParse]): String ->
    case values {
        [] -> "";
        [value | rest] -> if { value.valid -> first_pattern_error(rest); true -> value.message }
    }.

@pure
strip_terminal_dot(source: String): String ->
    let value = String.trim(source);
    if {
        String.ends_with(value, ".") -> String.trim(value.utf8_slice(0, value.byte_size() - 1));
        true -> value
    }.

@pure
failure(source: DeclarationSyntax, message: String): ShapeSyntax ->
    ShapeSyntax(false, source.name, List.new[PatternParse](), PatternParser.parse(""), false, ExpressionParser.parse(""), source.is_public, source.span, message).

@pure
shape_parameter_text(parameter_region: String, parameters_closed: Bool): String ->
    if {
        parameters_closed -> String.trim(parameter_region.utf8_slice(0, parameter_region.byte_size() - 1));
        true -> ""
    }.

@pure
shape_body_text(right: String, guard_at: Int): String ->
    if {
        guard_at < 0 -> right;
        true -> String.trim(right.utf8_slice(0, guard_at))
    }.

@pure
shape_guard_text(right: String, guard_at: Int): String ->
    if {
        guard_at < 0 -> "";
        true -> String.trim(right.utf8_slice(guard_at + 7, right.byte_size() - guard_at - 7))
    }.

@pure
shape_message_after_body(guard_at: Int, guard_valid: Bool, guard_message: String): String ->
    if {
        guard_at >= 0 and not guard_valid -> guard_message;
        true -> ""
    }.

@pure
shape_message_after_parameters(body_valid: Bool, body_message: String, guard_at: Int, guard_valid: Bool, guard_message: String): String ->
    if {
        not body_valid -> body_message;
        true -> shape_message_after_body(guard_at, guard_valid, guard_message)
    }.

@pure
shape_message_after_closed(parameters: List[PatternParse], body_valid: Bool, body_message: String, guard_at: Int, guard_valid: Bool, guard_message: String): String ->
    if {
        not patterns_valid(parameters) -> first_pattern_error(parameters);
        not shape_parameters_valid(parameters) -> String.concat(["invalid shape parameter `", first_invalid_shape_parameter(parameters), "`"]);
        has_duplicate_parameter(parameters, List.new[String]()) -> String.concat(["duplicate shape parameter `", first_duplicate_shape_parameter(parameters, List.new[String]()), "`"]);
        true -> shape_message_after_parameters(body_valid, body_message, guard_at, guard_valid, guard_message)
    }.

@pure
shape_message(parameters_closed: Bool, parameters: List[PatternParse], body_valid: Bool, body_message: String, guard_at: Int, guard_valid: Bool, guard_message: String): String ->
    if {
        not parameters_closed -> "shape parameter list is incomplete";
        true -> shape_message_after_closed(parameters, body_valid, body_message, guard_at, guard_valid, guard_message)
    }.

@pure
pub lower(source: DeclarationSyntax): ShapeSyntax ->
    let open = Delimited.top_level_byte(source.body, 40);
    let assignment = Delimited.top_level_assignment(source.body);
    if {
        source.class != ShapeDeclaration -> failure(source, "declaration is not a shape");
        open < 0 or assignment < 0 or open >= assignment -> failure(source, "shape declaration is incomplete");
        true ->
            let parameter_region = String.trim(source.body.utf8_slice(open + 1, assignment - open - 1));
            let parameters_closed = String.ends_with(parameter_region, ")");
            let parameter_text = shape_parameter_text(parameter_region, parameters_closed);
            let parameters = parse_patterns(drop_terminal_empty(Delimited.split_top_level(parameter_text, 44)));
            let right = strip_terminal_dot(source.body.utf8_slice(assignment + 1, source.body.byte_size() - assignment - 1));
            let guard_at = Delimited.top_level_text(right, " where ");
            let body_text = shape_body_text(right, guard_at);
            let guard_text = shape_guard_text(right, guard_at);
            let body = PatternParser.parse(body_text);
            let guard = ExpressionParser.parse(guard_text);
            let duplicate_binding = first_duplicate_binding(
                pattern_bindings(body),
                List.new[String](),
            );
            let valid = parameters_closed
                and patterns_valid(parameters)
                and shape_parameters_valid(parameters)
                and not has_duplicate_parameter(parameters, List.new[String]())
                and body.valid
                and duplicate_binding == ""
                and (guard_at < 0 or guard.valid);
            ShapeSyntax(
                valid,
                source.name,
                parameters,
                body,
                guard_at >= 0,
                guard,
                source.is_public,
                source.span,
                final_shape_message(
                    source.name,
                    duplicate_binding,
                    shape_message(parameters_closed, parameters, body.valid, body.message, guard_at, guard.valid, guard.message),
                ),
            )
    }.
