        )
    }.

run_backend_unit(
    input: String,
    interface_manifest: String,
    output: String,
    diagnostics: String,
): Unit ->
    let _completed = ensure_directory(parent(output))
        and ensure_directory(parent(diagnostics))
        and ProjectedInterfaceCatalog.write_backend(
            input,
            interface_manifest,
            output,
            diagnostics,
        );
    Unit.

run_backend_units(index: Int, catalog: self_host.ProjectedInterfaceCatalog.InterfaceCatalog): Bool ->
    case {
        Arguments.get(index),
        Arguments.get(index + 1),
        Arguments.get(index + 2)
    } {
        {Some(input), Some(output), Some(diagnostics)} ->
            let completed = ensure_directory(parent(output))
                and ensure_directory(parent(diagnostics))
                and ProjectedInterfaceCatalog.write_backend_catalog(
                    input,
                    catalog,
                    output,
                    diagnostics,
                );
            completed and run_backend_units(index + 3, catalog);
        {None, None, None} -> true;
        _ -> false
    }.

main_backend_units(): Unit ->
    case Arguments.get(1) {
        Some(interface_manifest) -> let catalog = ProjectedInterfaceCatalog.load(interface_manifest);
            let _completed = run_backend_units(2, catalog);
            Unit;
        None -> report_unit(
            "usage: terlan-self-host backend-units <interfaces.manifest> [<source.terl> <output> <diagnostics>]...",
        )
    }.

parallel_worker_limit(value: String): Option[Int] ->
    case Json.parse(value) {
        Err(_) -> None;
        Ok(json) -> case json.as_int() {
            Err(_) -> None;
            Ok(limit) -> if { limit > 0 -> Some(limit); true -> None }
        }
    }.

parallel_backend_jobs(index: Int): Result[List[BackendWorkerJob], String] ->
    case {
        Arguments.get(index),
        Arguments.get(index + 1),
        Arguments.get(index + 2),
        Arguments.get(index + 3)
    } {
        {Some(identity), Some(input), Some(output), Some(diagnostics)} -> if {
            not ensure_directory(parent(output)) or not ensure_directory(parent(diagnostics)) ->
                Err("cannot create parallel backend output directories");
            true -> case parallel_backend_jobs(index + 4) {
                Err(reason) -> Err(reason);
                Ok(rest) -> Ok([BackendWorkerJob(identity, input, output, diagnostics) | rest])
            }
        };
        {None, None, None, None} -> Ok(List.new[BackendWorkerJob]());
        _ -> Err("parallel backend jobs must contain identity/source/output/diagnostics groups")
    }.

parallel_backend_usage(): Unit ->
    report_unit(
        "usage: terlan-self-host parallel-backend-units <interfaces.manifest> <worker-limit> [<identity> <source.terl> <output> <diagnostics>]...",
    ).

main_parallel_backend_units(): Unit ->
    case { Arguments.get(1), Arguments.get(2) } {
        {Some(interface_manifest), Some(limit_text)} -> case parallel_worker_limit(limit_text) {
            None -> parallel_backend_usage();
            Some(worker_limit) -> case parallel_backend_jobs(3) {
                Err(reason) -> report_unit(reason);
                Ok(jobs) -> let catalog = ProjectedInterfaceCatalog.load(interface_manifest);
                if {
                    SelfHostParallelBackendDriver.run(jobs, catalog, worker_limit) -> Unit;
                    true -> report_unit("parallel backend compilation failed")
                }
            }
        };
        _ -> parallel_backend_usage()
    }.

