    ).

main_lint_parity_tail(
    native_diagnostics: String,
    self_host_diagnostics: String,
    native_fixed: String,
    self_host_fixed: String,
): Unit ->
    case {
        Arguments.get(5),
        Arguments.get(6),
        Arguments.get(7),
        Arguments.get(8),
        Arguments.get(9),
    } {
        {
            Some(native_corpus),
            Some(self_host_corpus),
            Some(bootstrap_marker),
            Some(evidence),
            Some(marker),
        } -> let _completed =
            ensure_directory(parent(evidence))
                and ensure_directory(parent(marker))
                and SelfHostLintParityTool.write(
                    native_diagnostics,
                    self_host_diagnostics,
                    native_fixed,
                    self_host_fixed,
                    native_corpus,
                    self_host_corpus,
                    bootstrap_marker,
                    evidence,
                    marker,
                );
            Unit;
        _ -> lint_parity_unit_usage()
    }.

main_lint_parity_unit(): Unit ->
    case {
