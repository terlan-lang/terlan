        Arguments.get(3),
        Arguments.get(4),
    } {
        {
            Some(native_diagnostics),
            Some(self_host_diagnostics),
            Some(native_fixed),
            Some(self_host_fixed),
        } -> main_lint_parity_tail(
            native_diagnostics,
            self_host_diagnostics,
            native_fixed,
            self_host_fixed,
        );
        _ -> lint_parity_unit_usage()
    }.

