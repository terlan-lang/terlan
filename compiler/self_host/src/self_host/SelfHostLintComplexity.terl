/** Complexity lint authority for TL0901 and TL0902. */
module self_host.SelfHostLintComplexity.

import std.core.String.

pub struct ClauseSpan {
    start_byte: Int,
    end_byte: Int,
}.

pub constructor ClauseSpan {
    (start_byte: Int, end_byte: Int): ClauseSpan ->
        ClauseSpan { start_byte: start_byte, end_byte: end_byte }
}.

pub struct ComplexityDiagnostic {
    path: String,
    line: Int,
    column: Int,
    rule_id: String,
    rule_name: String,
    severity: String,
    message: String,
    fix_available: Bool,
}.

pub constructor ComplexityDiagnostic {
    (path: String, line: Int, column: Int, rule_id: String, rule_name: String, severity: String, message: String, fix_available: Bool): ComplexityDiagnostic ->
        ComplexityDiagnostic {
            path: path,
            line: line,
            column: column,
            rule_id: rule_id,
            rule_name: rule_name,
            severity: severity,
            message: message,
            fix_available: fix_available,
        }
}.

newline_count(source: String, offset: Int, count: Int): Int ->
    if {
        offset >= String.byte_size(source) -> count;
        String.utf8_byte_at(source, offset) == 10 ->
            newline_count(source, offset + 1, count + 1);
        true -> newline_count(source, offset + 1, count)
    }.

/** Matches Rust `str::lines().count()` for LF-delimited source. */
pub source_line_count(source: String): Int ->
    if {
        source == "" -> 0;
        String.ends_with(source, "\n") -> newline_count(source, 0, 0);
        true -> newline_count(source, 0, 0) + 1
    }.

clamp(value: Int, minimum: Int, maximum: Int): Int ->
    if { value < minimum -> minimum; value > maximum -> maximum; true -> value }.

span_line_count(source: String, span: ClauseSpan): Int ->
    let size = String.byte_size(source);
    let start = clamp(span.start_byte, 0, size);
    let end0 = clamp(span.end_byte, 0, size);
    let end = if { end0 < start -> start; true -> end0 };
    let count = source_line_count(String.utf8_slice(source, start, end - start));
    if { count < 1 -> 1; true -> count }.

struct SourcePosition {
    line: Int,
    column: Int,
}.

constructor SourcePosition {
    (line: Int, column: Int): SourcePosition ->
        SourcePosition { line: line, column: column }
}.

position_at(source: String, target: Int, offset: Int, line: Int, column: Int): SourcePosition ->
    if {
        offset >= target or offset >= String.byte_size(source) -> SourcePosition(line, column);
        String.utf8_byte_at(source, offset) == 10 ->
            position_at(source, target, offset + 1, line + 1, 1);
        true -> position_at(source, target, offset + 1, line, column + 1)
    }.

function_size_at(
    path: String,
    source: String,
    spans: List[ClauseSpan],
): List[ComplexityDiagnostic] ->
    case spans {
        [] -> [];
        [span | rest] ->
            let remaining = function_size_at(path, source, rest);
            if {
                span_line_count(source, span) <= 40 -> remaining;
                true ->
                    let start = clamp(span.start_byte, 0, String.byte_size(source));
                    let position = position_at(source, start, 0, 1, 1);
                    [ComplexityDiagnostic(
                        path,
                        position.line,
                        position.column,
                        "TL0901",
                        "complexity.function-size",
                        "warning",
                        "function clause exceeds the maintainability line threshold",
                        false,
                    ) | remaining]
            }
    }.

/** Reports function and method clause spans over 40 lines. */
@pure
pub function_size(
    path: String,
    source: String,
    spans: List[ClauseSpan],
): List[ComplexityDiagnostic] -> function_size_at(path, source, spans).

generated_at(lines: List[String], remaining: Int): Bool ->
    if {
        remaining <= 0 -> false;
        true ->
            case lines {
                [] -> false;
                [line | rest] ->
                    let lowered = String.lowercase(line);
                    if {
                        String.contains(lowered, "@generated")
                            or String.contains(lowered, "generated by")
                            or String.contains(lowered, "do not edit")
                            or String.contains(lowered, "this file is generated") -> true;
                        true -> generated_at(rest, remaining - 1)
                    }
            }
    }.

/** Matches the first-20-line generated-source exemption. */
pub generated_source(source: String): Bool ->
    generated_at(String.split(source, "\n"), 20).

/** Reports ordinary source files over 500 lines. */
@pure
pub file_size(path: String, source: String): List[ComplexityDiagnostic] ->
    if {
        generated_source(source) or source_line_count(source) <= 500 -> [];
        true -> [ComplexityDiagnostic(
            path,
            1,
            1,
            "TL0902",
            "complexity.file-size",
            "warning",
            "ordinary source file exceeds the maintainability line threshold",
            false,
        )]
    }.

struct BranchArm {
    line: Int,
    column: Int,
    line_count: Int,
}.

constructor BranchArm {
    (line: Int, column: Int, line_count: Int): BranchArm ->
        BranchArm { line: line, column: column, line_count: line_count }
}.

struct BranchContext {
    branch_depth: Int,
    active: List[BranchArm],
}.

constructor BranchContext {
    (branch_depth: Int, active: List[BranchArm]): BranchContext ->
        BranchContext { branch_depth: branch_depth, active: active }
}.

struct ArmScan {
    contexts: List[BranchContext],
    diagnostics: List[ComplexityDiagnostic],
}.

constructor ArmScan {
    (contexts: List[BranchContext], diagnostics: List[ComplexityDiagnostic]): ArmScan ->
        ArmScan { contexts: contexts, diagnostics: diagnostics }
}.

append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

comment_line(trimmed: String): Bool ->
    String.starts_with(trimmed, "//") or String.starts_with(trimmed, "*").

counted_arm_line(trimmed: String): Bool ->
    trimmed != ""
        and not comment_line(trimmed)
        and trimmed != "}"
        and trimmed != "};".

find_arrow(line: String, offset: Int): Int ->
    if {
        offset + 1 >= String.byte_size(line) -> -1;
        String.utf8_byte_at(line, offset) == 45
            and String.utf8_byte_at(line, offset + 1) == 62 -> offset + 1;
        true -> find_arrow(line, offset + 1)
    }.

arrow_column(line: String): Int ->
    if { comment_line(String.trim_start(line)) -> -1; true -> find_arrow(line, 0) }.

arrow_has_inline_body(line: String): Bool ->
    let column = arrow_column(line);
    if {
        column < 0 -> false;
        true ->
            let start = column + 1;
            String.trim(String.utf8_slice(
                line,
                start,
                String.byte_size(line) - start,
            )) != ""
    }.

depth_at(characters: List[String], depth: Int): Int ->
    case characters {
        [] -> depth;
        [character | rest] ->
            if {
                character == "{" -> depth_at(rest, depth + 1);
                character == "}" -> depth_at(rest, if { depth > 0 -> depth - 1; true -> 0 });
                true -> depth_at(rest, depth)
            }
    }.

update_depth(depth: Int, line: String): Int ->
    depth_at(String.characters(line), depth).

opens_branch(trimmed: String): Bool ->
    not comment_line(trimmed)
        and String.contains(trimmed, "{")
        and (
            String.starts_with(trimmed, "if {")
                or String.contains(trimmed, "case ")
        ).

finish_context(
    path: String,
    context: BranchContext,
): List[ComplexityDiagnostic] ->
    case context.active {
        [arm] ->
            if {
                arm.line_count <= 20 -> [];
                true -> [ComplexityDiagnostic(
                    path,
                    arm.line,
                    arm.column,
                    "TL0903",
                    "complexity.match-arm-size",
                    "warning",
                    "case or if arm exceeds the maintainability line threshold",
                    false,
                )]
            };
        _ -> []
    }.

increment_active(context: BranchContext): BranchContext ->
    case context.active {
        [arm] -> BranchContext(
            context.branch_depth,
            [BranchArm(arm.line, arm.column, arm.line_count + 1)],
        );
        _ -> context
    }.

update_top(
    path: String,
    contexts: List[BranchContext],
    diagnostics: List[ComplexityDiagnostic],
    depth: Int,
    line_number: Int,
    line: String,
): ArmScan ->
    case contexts {
        [] -> ArmScan([], diagnostics);
        [context | rest] ->
            let arrow = arrow_column(line);
            if {
                depth == context.branch_depth and arrow >= 0 ->
                    ArmScan(
                        [BranchContext(
                            context.branch_depth,
                            [BranchArm(
                                line_number,
                                arrow,
                                if { arrow_has_inline_body(line) -> 1; true -> 0 },
                            )],
                        ) | rest],
                        append(diagnostics, finish_context(path, context)),
                    );
                context.active != [] and counted_arm_line(String.trim(line)) ->
                    ArmScan([increment_active(context) | rest], diagnostics);
                true -> ArmScan(contexts, diagnostics)
            }
    }.

pop_closed(
    path: String,
    state: ArmScan,
    depth: Int,
): ArmScan ->
    case state.contexts {
        [] -> state;
        [context | rest] ->
            if {
                depth < context.branch_depth -> pop_closed(
                    path,
                    ArmScan(
                        rest,
                        append(state.diagnostics, finish_context(path, context)),
                    ),
                    depth,
                );
                true -> state
            }
    }.

finish_all(path: String, state: ArmScan): List[ComplexityDiagnostic] ->
    case state.contexts {
        [] -> state.diagnostics;
        [context | rest] -> finish_all(
            path,
            ArmScan(
                rest,
                append(state.diagnostics, finish_context(path, context)),
            ),
        )
    }.

match_arms_at(
    path: String,
    lines: List[String],
    line_number: Int,
    depth: Int,
    state: ArmScan,
): List[ComplexityDiagnostic] ->
    case lines {
        [] -> finish_all(path, state);
        [line | rest] ->
            let updated = update_top(
                path,
                state.contexts,
                state.diagnostics,
                depth,
                line_number,
                line,
            );
            let next_depth = update_depth(depth, line);
            let trimmed = String.trim(line);
            let opened = if {
                opens_branch(trimmed) and next_depth > depth ->
                    ArmScan(
                        [BranchContext(next_depth, []) | updated.contexts],
                        updated.diagnostics,
                    );
                true -> updated
            };
            let closed = pop_closed(path, opened, next_depth);
            match_arms_at(path, rest, line_number + 1, next_depth, closed)
    }.

/** Reports case and if arms with more than 20 counted body lines. */
@pure
pub match_arm_size(path: String, source: String): List[ComplexityDiagnostic] ->
    match_arms_at(
        path,
        String.split(source, "\n"),
        1,
        0,
        ArmScan([], []),
    ).
