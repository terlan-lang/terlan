/** Computes callable arity from a canonical declaration header. */
module self_host.CallableArity.


import std.core.Option.{None, Option, Some}.
import self_host.TypedModuleSyntax.{FunctionPayload, MethodPayload, TypedDeclaration}.


import std.collections.List.
import std.core.{Int, String}.
import self_host.Delimited.


@pure
length_at[T](values: List[T], count: Int): Int ->
    case values {
        [] -> count;
        [_ | rest] -> length_at(rest, count + 1)
    }.

@pure
length[T](values: List[T]): Int -> length_at(values, 0).


@pure
count_nonempty_parameters(value: String): Int ->
    let comma = Delimited.top_level_byte(value, 44);
    if {
        comma < 0 -> 1;
        true -> 1 + count_parameters(String.trim(value.utf8_slice(
            comma + 1,
            value.byte_size() - comma - 1,
        )))
    }.

@pure
count_parameters(source: String): Int ->
    let value = String.trim(source);
    if {
        value == "" -> 0;
        true -> count_nonempty_parameters(value)
    }.

@pure
join_parenthesized(values: List[String]): String ->
    case values {
        [] -> "";
        [value] -> value;
        [value | rest] -> String.append(value, String.append("(", join_parenthesized(rest)))
    }.

@pure
callable_head(header: String, colon: Int): String ->
    if {
        colon < 0 -> "";
        true -> String.trim(header.utf8_slice(0, colon))
    }.

@pure
parenthesized_arity(joined: String): Option[Int] ->
    if {
        String.ends_with(joined, ")") -> Some(count_parameters(joined.utf8_slice(
            0,
            joined.byte_size() - 1,
        )));
        true -> None
    }.

@pure
arity_after_name(values: List[String]): Option[Int] ->
    case values {
        [] -> None;
        [parameters | nested] -> parenthesized_arity(join_parenthesized([parameters | nested]))
    }.

@pure
arity_parts(values: List[String]): Option[Int] ->
    case values {
        [] -> None;
        [_name | rest] -> arity_after_name(rest)
    }.

@pure
function_arity(header: String): Option[Int] ->
    let colon = Delimited.top_level_byte(header, 58);
    arity_parts(String.split(callable_head(header, colon), "(")).

/** Interface export summaries identify ordinary functions by name and arity. */
@pure
pub of(source: TypedDeclaration): Option[Int] ->
    case source.payload {
        FunctionPayload(function) -> Some(length(function.typed_parameters));
        MethodPayload(method) -> Some(length(method.parameters) + 1);
        _ -> None
    }.
