/** Closed-world registry for self-hosted lint policy authority. */
module self_host.SelfHostLintRegistry.

import std.core.String.

pub struct LintRuleAuthority {
    rule_id: String,
    rule_name: String,
    severity: String,
    policy_module: String,
    projection_required: Bool,
    fix_available: Bool,
}.

pub constructor LintRuleAuthority {
    (
        rule_id: String,
        rule_name: String,
        severity: String,
        policy_module: String,
        projection_required: Bool,
        fix_available: Bool,
    ): LintRuleAuthority -> LintRuleAuthority {
        rule_id: rule_id,
        rule_name: rule_name,
        severity: severity,
        policy_module: policy_module,
        projection_required: projection_required,
        fix_available: fix_available,
    }
}.

rule(
    rule_id: String,
    rule_name: String,
    severity: String,
    policy_module: String,
    projection_required: Bool,
    fix_available: Bool,
): LintRuleAuthority ->
    LintRuleAuthority(
        rule_id,
        rule_name,
        severity,
        policy_module,
        projection_required,
        fix_available,
    ).

/** Every active lint rule in canonical registry order. */
pub rules(): List[LintRuleAuthority] -> [
    rule("TL0001", "syntax.semicolon", "error", "self_host.SelfHostLintSemicolon", false, true),
    rule("TL0002", "readability.deep-expression", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0003", "readability.callback-name", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0004", "readability.unused-destructure-binding", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0005", "readability.redundant-comment", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0006", "readability.public-docs", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0007", "readability.doc-comment-spacing", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0008", "readability.boolean-heavy-branch", "warning", "self_host.SelfHostLintReadability", false, false),
    rule("TL0009", "readability.grouped-binding", "error", "self_host.SelfHostLintReadability", false, false),
    rule("TL0010", "readability.function-reference", "error", "self_host.SelfHostLintReadability", false, false),
    rule("TL0301", "naming.function-snake-case", "warning", "self_host.SelfHostLintNamingDiagnostics", false, false),
    rule("TL0302", "naming.type-upper-camel", "warning", "self_host.SelfHostLintNamingDiagnostics", false, false),
    rule("TL0303", "naming.case-underscore-collision", "warning", "self_host.SelfHostLintNamingDiagnostics", false, false),
    rule("TL0304", "naming.binding-snake-case", "warning", "self_host.SelfHostLintNamingDiagnostics", false, false),
    rule("TL0401", "tests.fake", "error", "self_host.SelfHostLintTests", false, false),
    rule("TL0402", "tests.assertion-volume", "suggestion", "self_host.SelfHostLintTests", false, false),
    rule("TL0403", "tests.table-driven-candidate", "suggestion", "self_host.SelfHostLintTests", false, false),
