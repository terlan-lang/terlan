    rule("TL0501", "consistency.module-order", "warning", "self_host.SelfHostLintConsistency", false, false),
    rule("TL0502", "consistency.import-order", "warning", "self_host.SelfHostLintConsistency", false, false),
    rule("TL0503", "consistency.single-module", "error", "self_host.SelfHostLintConsistency", false, false),
