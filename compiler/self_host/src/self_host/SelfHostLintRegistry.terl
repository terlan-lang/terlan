    rule("TL1002", "format-boundary.pipe-fix", "suggestion", "self_host.SelfHostLintPipe", false, true),
].

ids(values: List[LintRuleAuthority]): List[String] ->
    case values {
        [] -> [];
        [value | rest] -> [value.rule_id | ids(rest)]
    }.

pub rule_ids(): List[String] -> ids(rules()).

contains(values: List[String], expected: String): Bool ->
    case values {
        [] -> false;
        [value | rest] -> value == expected or contains(rest, expected)
    }.

unique(values: List[String]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> not contains(rest, value) and unique(rest)
    }.

valid_rule(value: LintRuleAuthority): Bool ->
    String.starts_with(value.rule_id, "TL")
        and value.rule_name != ""
        and value.policy_module != ""
        and (
            value.severity == "error"
                or value.severity == "warning"
                or value.severity == "suggestion"
        ).

all_valid(values: List[LintRuleAuthority]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> valid_rule(value) and all_valid(rest)
    }.

/** Rejects duplicate IDs and incomplete metadata before authority admission. */
pub valid(): Bool ->
    let values = rules();
    unique(ids(values)) and all_valid(values).

count_projection(values: List[LintRuleAuthority], count: Int): Int ->
    case values {
        [] -> count;
        [value | rest] -> count_projection(
            rest,
            if { value.projection_required -> count + 1; true -> count },
        )
    }.

/** Number of policies still waiting for shared frontend fact projection. */
pub projection_rule_count(): Int -> count_projection(rules(), 0).

render_rows(values: List[LintRuleAuthority]): String ->
    case values {
        [] -> "";
        [value | rest] ->
            value.rule_id
                + "\t"
                + value.rule_name
                + "\t"
                + value.severity
                + "\t"
                + value.policy_module
                + "\t"
                + if { value.projection_required -> "projected"; true -> "source" }
                + "\t"
                + if { value.fix_available -> "fix"; true -> "diagnostic" }
                + "\n"
                + render_rows(rest)
    }.

/** Versioned production evidence consumed by lint authority gates. */
pub render(): String ->
    "terlan.self-host.lint-registry/v1\n"
        + "rule_id\trule_name\tseverity\tpolicy_module\tinput\tcapability\n"
        + render_rows(rules()).
