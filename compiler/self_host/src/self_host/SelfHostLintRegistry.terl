    rule("TL0609", "imports.default-could-be-selected", "suggestion", "self_host.SelfHostLintImportRecommendations", false, false),
    rule("TL0702", "targets.conflict", "error", "self_host.SelfHostLintTargets", false, false),
    rule("TL0804", "generated.source-manifest", "error", "self_host.SelfHostLintGenerated", false, false),
    rule("TL0805", "generated.lint-suppression-manifest", "error", "self_host.SelfHostLintGenerated", false, false),
    rule("TL0806", "generated.skip-manifest", "error", "self_host.SelfHostLintGenerated", false, false),
    rule("TL0901", "complexity.function-size", "warning", "self_host.SelfHostLintComplexity", false, false),
