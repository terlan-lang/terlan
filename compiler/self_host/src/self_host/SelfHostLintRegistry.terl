    rule("TL0601", "imports.duplicate", "warning", "self_host.SelfHostLintImports", false, false),
    rule("TL0602", "imports.duplicate-selected", "warning", "self_host.SelfHostLintImports", false, false),
    rule("TL0603", "imports.sort-order", "warning", "self_host.SelfHostLintImports", false, false),
    rule("TL0604", "imports.selected-sort-order", "warning", "self_host.SelfHostLintImports", false, false),
    rule("TL0605", "imports.grouped-selected", "warning", "self_host.SelfHostLintImportUsage", false, false),
    rule("TL0606", "imports.unused-selected", "warning", "self_host.SelfHostLintImportUsage", false, false),
