/**
 * Adapts generic projected expression trees into local semantic event streams.
 */
module self_host.ProjectedSemanticEventAdapter.



import std.core.Option.{None, Option, Some}.
import std.collections.List.
import std.core.String.
import self_host.ProjectedBindingSyntax.
import self_host.ProjectedBindingSyntax.{BindingEvent}.
import self_host.ProjectedBodySyntax.
import self_host.ProjectedBodySyntax.{ProjectedBodies, ProjectedBody}.
import self_host.ProjectedCallableSyntax.
import self_host.ProjectedCallableSyntax.{CallableUse}.
import self_host.ProjectedExpressionSyntax.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedSemanticEventSyntax.
import self_host.ProjectedSemanticEventSyntax.{BindingTypeLink, ProjectedSemanticEvents}.
import self_host.ProjectedSignatureSyntax.{ProjectedCallableSignature, ProjectedParameterTree, ProjectedSignatureDocument}.
import self_host.ProjectedTypeConstraintSyntax.

import self_host.ProjectedTypeConstraintSyntax.{TypeConstraintEvent}.
struct TypeWalk {
    next_id: Int,
    node_id: Int,
    child_ids: List[Int],
    events: List[TypeConstraintEvent],
}.

constructor TypeWalk {
    (next_id: Int, node_id: Int, child_ids: List[Int], events: List[TypeConstraintEvent]): TypeWalk ->
        TypeWalk {
            next_id: next_id,
            node_id: node_id,
            child_ids: child_ids,
            events: events,
        }
}.

struct NumberedExpressionNode {
    node: ProjectedExpressionNode,
    node_id: Int,
    child_ids: List[Int],
    children_reversed: List[NumberedExpressionNode],
}.

constructor NumberedExpressionNode {
    (
        node: ProjectedExpressionNode,
        node_id: Int,
        child_ids: List[Int],
        children_reversed: List[NumberedExpressionNode],
    ): NumberedExpressionNode -> NumberedExpressionNode {
        node: node,
        node_id: node_id,
        child_ids: child_ids,
        children_reversed: children_reversed,
    }
}.

struct NumberedChildren {
    next_id: Int,
    values_reversed: List[NumberedExpressionNode],
    ids: List[Int],
}.

constructor NumberedChildren {
    (
        next_id: Int,
        values_reversed: List[NumberedExpressionNode],
        ids: List[Int],
    ): NumberedChildren -> NumberedChildren {
        next_id: next_id,
        values_reversed: values_reversed,
        ids: ids,
    }
}.

struct NumberedWalk {
    next_id: Int,
    value: NumberedExpressionNode,
}.

constructor NumberedWalk {
    (next_id: Int, value: NumberedExpressionNode): NumberedWalk -> NumberedWalk {
        next_id: next_id,
        value: value,
    }
}.

@pure
prepend_reversed[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> prepend_reversed(rest, [value | output])
    }.

@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
concat[T](left: List[T], right: List[T]): List[T] ->
    prepend_reversed(reverse(left), right).

@pure
concat_nodes(
    left: List[ProjectedExpressionNode],
    right: List[ProjectedExpressionNode],
): List[ProjectedExpressionNode] ->
    case left {
        [] -> right;
        [value | rest] -> [value | concat_nodes(rest, right)]
    }.

@pure
task(kind: String, node: ProjectedExpressionNode): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, node.text, node.start_byte, node.end_byte, [node]).

@pure
scope_task(kind: String, node: ProjectedExpressionNode): ProjectedExpressionNode ->
    ProjectedExpressionNode(kind, "", node.start_byte, node.end_byte, List.new[ProjectedExpressionNode]()).

@pure
pub pattern_binding_name(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "binding-pattern" -> node.text;
        node.kind == "typed-pattern" or node.kind == "string-capture-segment" ->
            case String.split(node.text, ":") {
                [name | _rest] -> String.trim(name);
                [] -> ""
            };
        true -> ""
    }.

@pure
pattern_event_output(node: ProjectedExpressionNode, output: List[BindingEvent]): List[BindingEvent] ->
    let name = pattern_binding_name(node);
    if {
        name != "" and name != "_" -> [BindingEvent(kind = "declare", name = name, binding_kind = "pattern", byte_offset = node.start_byte) | output];
        true -> output
    }.

@pure
pattern_events_at(
    work: List[ProjectedExpressionNode],
    output: List[BindingEvent],
): List[BindingEvent] ->
    case work {
        [] -> output;
        [node | rest] -> pattern_events_at(
            concat_nodes(node.children, rest),
            pattern_event_output(node, output),
        )
    }.

@pure
ordinary_binding_output(node: ProjectedExpressionNode, output: List[BindingEvent]): List[BindingEvent] ->
    if {
        node.kind == "identifier" or node.kind == "binding" or node.kind == "atom" -> [BindingEvent(kind = "use", name = node.text, binding_kind = "value", byte_offset = node.start_byte) | output];
        true -> output
    }.

@pure
ordinary_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    binding_events_at(concat_nodes(node.children, rest), ordinary_binding_output(node, output)).

@pure
record_access_binding_events(values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [base | _] -> binding_events_at([base | rest], output);
        [] -> binding_events_at(rest, output)
    }.

@pure
generator_patterns(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] where value.kind == "generator" -> case value.children {
            [pattern | _] -> [pattern | generator_patterns(rest)];
            [] -> generator_patterns(rest)
        };
        [_value | rest] -> generator_patterns(rest)
    }.

@pure
generator_sources(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] where value.kind == "generator" -> case value.children {
            [_pattern, source] -> [source | generator_sources(rest)];
            _ -> generator_sources(rest)
        };
        [_value | rest] -> generator_sources(rest)
    }.

@pure
non_generator_nodes(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] where value.kind == "generator" -> non_generator_nodes(rest);
        [value | rest] -> [value | non_generator_nodes(rest)]
    }.

@pure
comprehension_nodes(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    concat_nodes(generator_sources(values), non_generator_nodes(values)).

@pure
comprehension_pattern_task(node: ProjectedExpressionNode): ProjectedExpressionNode ->
    task("$pattern", ProjectedExpressionNode(
        "comprehension-patterns",
        "",
        node.start_byte,
        node.end_byte,
        generator_patterns(node.children),
    )).

@pure
list_comprehension_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    binding_events_at(concat_nodes(
        [scope_task("$enter-scope", node), comprehension_pattern_task(node)],
        concat_nodes(comprehension_nodes(node.children), [scope_task("$leave-scope", node) | rest]),
    ), output).

@pure
if_clauses(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] -> [ProjectedExpressionNode(
            "if-clause",
            value.text,
            value.start_byte,
            value.end_byte,
            value.children,
        ) | if_clauses(rest)]
    }.

@pure
if_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    binding_events_at(concat_nodes(if_clauses(node.children), rest), output).

@pure
refutable_binding_tasks(value: ProjectedExpressionNode): List[ProjectedExpressionNode] ->
    case value.children {
        [pattern, source] -> [source, task("$pattern", pattern)];
        _ -> [value]
    }.

@pure
refutable_tasks(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [] -> List.new[ProjectedExpressionNode]();
        [value | rest] where value.kind == "binding" and value.text == "<-" ->
            concat_nodes(refutable_binding_tasks(value), refutable_tasks(rest));
        [value | rest] -> [value | refutable_tasks(rest)]
    }.

@pure
refutable_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    binding_events_at(concat_nodes(
        [scope_task("$enter-scope", node)],
        concat_nodes(refutable_tasks(node.children), [scope_task("$leave-scope", node) | rest]),
    ), output).

@pure
callee_field_children(values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [base | _] -> binding_events_at([base | rest], output);
        [] -> binding_events_at(rest, output)
    }.

@pure
callee_single(callee: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if {
        callee.kind == "primary" and callee.text == "function" -> binding_events_at(rest, [BindingEvent(
            kind = "use",
            name = callee.text,
            binding_kind = "value",
            byte_offset = callee.start_byte,
        ) | output]);
        callee.kind == "identifier" or callee.kind == "binding" or callee.kind == "atom" or callee.kind == "constructor" -> binding_events_at(rest, output);
        true -> callee_non_binding(callee, rest, output)
    }.

@pure
callee_non_binding(callee: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { callee.kind == "field" -> callee_field_children(callee.children, rest, output); true -> binding_events_at([callee | rest], output) }.

@pure
callee_tail(callee: ProjectedExpressionNode, tail: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { tail == [] -> callee_single(callee, rest, output); true -> binding_events_at(rest, output) }.

@pure
callee_events(values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [] -> binding_events_at(rest, output);
        [callee | tail] -> callee_tail(callee, tail, rest, output)
    }.

@pure
call_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case node.children {
        [] -> binding_events_at(rest, output);
        [callee | arguments] -> binding_events_at([task("$callee", callee) | concat_nodes(arguments, rest)], output)
    }.

@pure
let_continuation(node: ProjectedExpressionNode, pattern: ProjectedExpressionNode, source: ProjectedExpressionNode, values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [] -> binding_events_at(concat_nodes(node.children, rest), output);
        [continuation | fallback] -> binding_events_at(concat_nodes([source, scope_task("$enter-scope", node), task("$pattern", pattern), continuation], concat_nodes(fallback, [scope_task("$leave-scope", node) | rest])), output)
    }.

@pure
let_source(node: ProjectedExpressionNode, pattern: ProjectedExpressionNode, values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [] -> binding_events_at(concat_nodes(node.children, rest), output);
        [source | tail] -> let_continuation(node, pattern, source, tail, rest, output)
    }.

@pure
let_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case node.children {
        [] -> binding_events_at(rest, output);
        [pattern | tail] -> let_source(node, pattern, tail, rest, output)
    }.

@pure
clause_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case node.children {
        [] -> binding_events_at(rest, output);
        [pattern | body] -> binding_events_at(concat_nodes([scope_task("$enter-scope", node), task("$pattern", pattern)], concat_nodes(body, [scope_task("$leave-scope", node) | rest])), output)
    }.

@pure
lambda_body(node: ProjectedExpressionNode, patterns: ProjectedExpressionNode, values: List[ProjectedExpressionNode], rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case values {
        [] -> binding_events_at(concat_nodes(node.children, rest), output);
        [body | trailing] -> binding_events_at(concat_nodes([scope_task("$enter-scope", node), task("$pattern", patterns), body], concat_nodes(trailing, [scope_task("$leave-scope", node) | rest])), output)
    }.

@pure
lambda_binding_events(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    case node.children {
        [] -> binding_events_at(rest, output);
        [patterns | tail] -> lambda_body(node, patterns, tail, rest, output)
    }.

@pure
binding_lambda(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "lambda" -> lambda_binding_events(node, rest, output); true -> binding_comprehension(node, rest, output) }.

@pure
binding_comprehension(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "list-comprehension" -> list_comprehension_binding_events(node, rest, output); true -> binding_record_access(node, rest, output) }.

@pure
binding_record_access(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "record_access" or node.kind == "record-access" -> record_access_binding_events(node.children, rest, output); true -> ordinary_binding_events(node, rest, output) }.

@pure
binding_clause(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "clause" -> clause_binding_events(node, rest, output); true -> binding_lambda(node, rest, output) }.

@pure
binding_let(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "let" -> let_binding_events(node, rest, output); true -> binding_refutable(node, rest, output) }.

@pure
binding_refutable(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "let-refutable" -> refutable_binding_events(node, rest, output); true -> binding_clause(node, rest, output) }.

@pure
binding_call(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "call" -> call_binding_events(node, rest, output); true -> binding_if(node, rest, output) }.

@pure
binding_if(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "if" -> if_binding_events(node, rest, output); true -> binding_let(node, rest, output) }.

@pure
binding_callee(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "$callee" -> callee_events(node.children, rest, output); true -> binding_call(node, rest, output) }.

@pure
binding_pattern_task(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "$pattern" -> binding_events_at(rest, pattern_events_at(node.children, output)); true -> binding_callee(node, rest, output) }.

@pure
binding_leave(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "$leave-scope" -> binding_events_at(rest, [BindingEvent(kind = "leave-scope", name = "", binding_kind = "", byte_offset = node.end_byte) | output]); true -> binding_pattern_task(node, rest, output) }.

@pure
binding_node(node: ProjectedExpressionNode, rest: List[ProjectedExpressionNode], output: List[BindingEvent]): List[BindingEvent] ->
    if { node.kind == "$enter-scope" -> binding_events_at(rest, [BindingEvent(kind = "enter-scope", name = "", binding_kind = "", byte_offset = node.start_byte) | output]); true -> binding_leave(node, rest, output) }.

@pure
binding_events_at(
    work: List[ProjectedExpressionNode],
    output: List[BindingEvent],
): List[BindingEvent] ->
    case work {
        [] -> reverse(output);
        [node | rest] -> binding_node(node, rest, output)
    }.

@pure
binding_events(node: ProjectedExpressionNode): List[BindingEvent] ->
    binding_events_at([node], List.new[BindingEvent]()).

@pure
fixed_binding_offsets_at(
    values: List[BindingEvent],
    byte_offset: Int,
    output: List[BindingEvent],
): List[BindingEvent] ->
    case values {
        [] -> reverse(output);
        [value | rest] -> fixed_binding_offsets_at(rest, byte_offset, [BindingEvent(
            kind = value.kind,
            name = value.name,
            binding_kind = value.binding_kind,
            byte_offset = byte_offset,
        ) | output])
    }.

@pure
fixed_binding_offsets(values: List[BindingEvent], byte_offset: Int): List[BindingEvent] ->
    fixed_binding_offsets_at(values, byte_offset, List.new[BindingEvent]()).

@pure
parameter_pattern_output(node: ProjectedExpressionNode, byte_offset: Int, output: List[BindingEvent]): List[BindingEvent] ->
    let name = pattern_binding_name(node);
    if {
        name != "" and name != "_" -> [BindingEvent(kind = "declare", name = name, binding_kind = "parameter", byte_offset = byte_offset) | output];
        true -> output
    }.

@pure
parameter_pattern_events_at(
    work: List[ProjectedExpressionNode],
    byte_offset: Int,
    output: List[BindingEvent],
): List[BindingEvent] ->
    case work {
        [] -> output;
        [node | rest] -> parameter_pattern_events_at(
            concat_nodes(node.children, rest),
            byte_offset,
            parameter_pattern_output(node, byte_offset, output),
        )
    }.

@pure
parameter_events(value: Option[ProjectedExpressionNode], rest: List[ProjectedParameterTree], byte_offset: Int, output: List[BindingEvent]): List[BindingEvent] ->
    case value {
        None -> parameter_events_at(rest, byte_offset, output);
        Some(pattern) -> parameter_events_at(rest, byte_offset, parameter_pattern_events_at([pattern], byte_offset, output))
    }.

@pure
parameter_events_at(
    values: List[ProjectedParameterTree],
    byte_offset: Int,
    output: List[BindingEvent],
): List[BindingEvent] ->
    case values {
        [] -> reverse(output);
        [value | rest] -> parameter_events(value.pattern, rest, byte_offset, output)
    }.

@pure
callable_binding_events(
    body: ProjectedBody,
    parameters: List[ProjectedParameterTree],
    guard: Option[ProjectedExpressionNode],
    node: ProjectedExpressionNode,
): List[BindingEvent] ->
    let byte_offset = if {
        String.starts_with(body.declaration_head, "pub ") -> body.span.start_byte + 4;
        true -> body.span.start_byte
    };
    concat(
        [BindingEvent(
            kind = "enter-scope",
            name = "",
            binding_kind = "",
            byte_offset = byte_offset,
        )],
        concat(
            parameter_events_at(parameters, byte_offset, List.new[BindingEvent]()),
            concat(
                guard_binding_events(guard, byte_offset),
                concat(
                    fixed_binding_offsets(binding_events(node), byte_offset),
                    [BindingEvent(
                        kind = "leave-scope",
                        name = "",
                        binding_kind = "",
                        byte_offset = byte_offset,
                    )],
                ),
            ),
        ),
    ).

@pure
guard_binding_events(value: Option[ProjectedExpressionNode], byte_offset: Int): List[BindingEvent] ->
    case value {
        None -> List.new[BindingEvent]();
        Some(node) -> fixed_binding_offsets(binding_events(node), byte_offset)
    }.

@pure
head_parameters(values: List[ProjectedCallableSignature]): List[ProjectedParameterTree] ->
    case values {
        [] -> List.new[ProjectedParameterTree]();
        [value | _] -> value.parameters
    }.

@pure
head_guard(values: List[ProjectedCallableSignature]): Option[ProjectedExpressionNode] ->
    case values {
        [] -> None;
        [value | _] -> value.guard
    }.

@pure
remaining_signatures(values: List[ProjectedCallableSignature]): List[ProjectedCallableSignature] ->
    case values {
        [] -> List.new[ProjectedCallableSignature]();
        [_ | rest] -> rest
    }.

@pure
node_count_at(values: List[ProjectedExpressionNode], count: Int): Int ->
    case values {
        [] -> count;
        [_ | rest] -> node_count_at(rest, count + 1)
    }.

@pure
node_count(values: List[ProjectedExpressionNode]): Int -> node_count_at(values, 0).

@pure
argument_count(values: List[ProjectedExpressionNode]): Int ->
    case values {
        [value] where value.kind == "sequence" or value.kind == "call-arguments" -> node_count(value.children);
        _ -> node_count(values)
    }.

@pure
some_string(value: String): Option[String] -> Some(value).

@pure
none_string(): Option[String] -> None.

@pure
field_module(values: List[ProjectedExpressionNode]): Option[String] ->
    case values {
        [base | _] -> if {
            module_name(base.text) -> some_string(base.text);
            true -> none_string()
        };
        [] -> none_string()
    }.

@pure
module_name(value: String): Bool ->
    if {
        value == "" -> false;
        true -> let byte = value.utf8_byte_at(0); byte >= 65 and byte <= 90
    }.

@pure
call_module(callee: ProjectedExpressionNode): Option[String] ->
    if { callee.kind == "field" -> field_module(callee.children); true -> none_string() }.

@pure
call_target(callee: ProjectedExpressionNode): ProjectedExpressionNode ->
    case callee.children {
        [base, argument] where callee.kind == "index" and argument.kind == "binding" -> base;
        _ -> callee
    }.

@pure
call_arity(callee: ProjectedExpressionNode, arguments: List[ProjectedExpressionNode]): Int ->
    case call_module(callee) {
        Some(_) -> argument_count(arguments);
        None -> if {
            callee.kind == "field" -> argument_count(arguments) + 1;
            true -> argument_count(arguments)
        }
    }.

@pure
argument_nodes(values: List[ProjectedExpressionNode]): List[ProjectedExpressionNode] ->
    case values {
        [value] where value.kind == "sequence" or value.kind == "call-arguments" -> value.children;
        _ -> values
    }.

@pure
argument_offsets(values: List[ProjectedExpressionNode]): List[Int] ->
    case values {
        [] -> List.new[Int]();
        [value | rest] -> [value.start_byte | argument_offsets(rest)]
    }.

@pure
receiver_offsets(callee: ProjectedExpressionNode, arguments: List[Int]): List[Int] ->
    case callee.children {
        [receiver | _rest] -> [receiver.start_byte | arguments];
        [] -> arguments
    }.

@pure
call_argument_offsets(
    callee: ProjectedExpressionNode,
    arguments: List[ProjectedExpressionNode],
): List[Int] ->
    let offsets = argument_offsets(argument_nodes(arguments));
    case call_module(callee) {
        Some(_module) -> offsets;
        None -> if { callee.kind == "field" -> receiver_offsets(callee, offsets); true -> offsets }
    }.

@pure
call_use_children(node: ProjectedExpressionNode, output: List[CallableUse]): List[CallableUse] ->
    case node.children {
        [callee | arguments] ->
            let target = call_target(callee);
            [CallableUse(module_name = call_module(target), name = target.text, arity = call_arity(target, arguments), argument_offsets = call_argument_offsets(target, arguments), byte_offset = node.start_byte) | output];
        [] -> output
    }.

@pure
call_use_output(
    node: ProjectedExpressionNode,
    output: List[CallableUse],
): List[CallableUse] ->
    if {
        node.kind != "call" -> output;
        true -> call_use_children(node, output)
    }.

@pure
call_uses_at(
    work: List[ProjectedExpressionNode],
    output: List[CallableUse],
): List[CallableUse] ->
    case work {
        [] -> reverse(output);
        [node | rest] -> call_uses_at(
            concat_nodes(node.children, rest),
            call_use_output(node, output),
        )
    }.

@pure
call_uses(node: ProjectedExpressionNode): List[CallableUse] ->
    call_uses_at([node], List.new[CallableUse]()).

@pure
binding_type_link_output(
    node: ProjectedExpressionNode,
    output: List[BindingTypeLink],
): List[BindingTypeLink] ->
    if { node.kind == "let" or node.kind == "let-refutable" -> binding_type_link_children(node.children, output); true -> output }.

@pure
binding_type_link_value(pattern: ProjectedExpressionNode, source: ProjectedExpressionNode, output: List[BindingTypeLink]): List[BindingTypeLink] ->
    let name = pattern_binding_name(pattern);
    if {
        (pattern.kind == "binding-pattern" or pattern.kind == "typed-pattern")
            and name != "" and name != "_" ->
            [BindingTypeLink(declaration_offset = pattern.start_byte, source_offset = source.start_byte) | output];
        true -> output
    }.

@pure
binding_type_link_source(pattern: ProjectedExpressionNode, values: List[ProjectedExpressionNode], output: List[BindingTypeLink]): List[BindingTypeLink] ->
    case values {
        [source | _] -> binding_type_link_value(pattern, source, output);
        [] -> output
    }.

@pure
binding_type_link_children(values: List[ProjectedExpressionNode], output: List[BindingTypeLink]): List[BindingTypeLink] ->
    case values {
        [pattern | rest] -> binding_type_link_source(pattern, rest, output);
        [] -> output
    }.

@pure
binding_type_links_at(
    work: List[ProjectedExpressionNode],
    output: List[BindingTypeLink],
): List[BindingTypeLink] ->
    case work {
        [] -> reverse(output);
        [node | rest] -> binding_type_links_at(
            concat_nodes(node.children, rest),
            binding_type_link_output(node, output),
        )
    }.

@pure
binding_type_links(node: ProjectedExpressionNode): List[BindingTypeLink] ->
    binding_type_links_at([node], List.new[BindingTypeLink]()).

@pure
child_id(values: List[Int], index: Int): Int ->
    case values {
        [] -> -1;
        [value | rest] -> if { index == 0 -> value; true -> child_id(rest, index - 1) }
    }.

@pure
last_child_id(values: List[Int]): Int ->
    case values {
        [] -> -1;
        [value] -> value;
        [_ | rest] -> last_child_id(rest)
    }.

@pure
constraint_kind(node: ProjectedExpressionNode): String ->
    if { node.kind == "binary" and (node.text == "and" or node.text == "or") -> "logical"; true -> comparison_constraint_kind(node) }.

@pure
comparison_constraint_kind(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "binary" and (node.text == "==" or node.text == "!=" or node.text == "<" or node.text == ">" or node.text == "<=" or node.text == ">=" or node.text == "in") -> "compare-same";
        true -> binary_constraint_kind(node)
    }.

@pure
binary_constraint_kind(node: ProjectedExpressionNode): String ->
    if { node.kind == "binary" -> "same"; true -> propagation_constraint_kind(node) }.

@pure
propagation_constraint_kind(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "unary" or node.kind == "field" or node.kind == "index" or node.kind == "sequence" or node.kind == "let" or node.kind == "let-refutable" or node.kind == "call-arguments" or node.kind == "named-argument" or node.kind == "clause" or node.kind == "constructor-chain" -> "propagate";
        true -> "unknown"
    }.

@pure
known_constraint(node: ProjectedExpressionNode, node_id: Int, name: String): TypeConstraintEvent ->
    TypeConstraintEvent(
            kind = "known",
            node_id = node_id,
            left_node = -1,
            right_node = -1,
            type_name = name,
            byte_offset = node.start_byte,
        ).

@pure
propagated_child(node: ProjectedExpressionNode, child_ids: List[Int]): Int ->
    if {
        node.kind == "sequence" or node.kind == "call-arguments" or node.kind == "named-argument" or node.kind == "clause" or node.kind == "constructor-chain" -> last_child_id(child_ids);
        true -> child_id(child_ids, 0)
    }.

@pure
constraint_left(node: ProjectedExpressionNode, child_ids: List[Int]): Int ->
    if { node.kind == "let" or node.kind == "let-refutable" -> child_id(child_ids, 2); true -> propagated_child(node, child_ids) }.

@pure
unknown_constraint(
    node: ProjectedExpressionNode,
    node_id: Int,
    child_ids: List[Int],
): TypeConstraintEvent ->
    TypeConstraintEvent(
            kind = constraint_kind(node),
            node_id = node_id,
            left_node = constraint_left(node, child_ids),
            right_node = child_id(child_ids, 1),
            type_name = "",
            byte_offset = node.start_byte,
        ).

@pure
list_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if {
        node.kind == "list"
            or node.kind == "list-cons"
            or node.kind == "list-comprehension"
            or node.kind == "list-flat-map" -> known_constraint(node, node_id, "List");
        true -> unknown_constraint(node, node_id, child_ids)
    }.

@pure
unit_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if { node.kind == "primary" and node.text == "Unit" -> known_constraint(node, node_id, "Unit"); true -> list_constraint(node, node_id, child_ids) }.

@pure
bool_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if { node.kind == "primary" and (node.text == "true" or node.text == "false") -> known_constraint(node, node_id, "Bool"); true -> unit_constraint(node, node_id, child_ids) }.

@pure
string_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if {
        node.kind == "string" -> known_constraint(node, node_id, "String");
        node.kind == "html-raw-block" -> known_constraint(node, node_id, "Html");
        true -> bool_constraint(node, node_id, child_ids)
    }.

@pure
float_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if { node.kind == "float" -> known_constraint(node, node_id, "Float"); true -> string_constraint(node, node_id, child_ids) }.

@pure
node_constraint(node: ProjectedExpressionNode, node_id: Int, child_ids: List[Int]): TypeConstraintEvent ->
    if {
        node.kind == "dynamic-call" -> TypeConstraintEvent(
            kind = "call-result",
            node_id = node_id,
            left_node = child_id(child_ids, 0),
            right_node = -1,
            type_name = "",
            byte_offset = node.start_byte,
        );
        node.kind == "integer" -> known_constraint(node, node_id, "Int");
        true -> float_constraint(node, node_id, child_ids)
    }.

@pure
propagate_child_constraint(
    node: ProjectedExpressionNode,
    node_id: Int,
    child: Int,
): TypeConstraintEvent ->
    TypeConstraintEvent(
        kind = "propagate",
        node_id = node_id,
        left_node = child,
        right_node = -1,
        type_name = "",
        byte_offset = node.start_byte,
    ).

@pure
same_children_constraint(
    node: ProjectedExpressionNode,
    node_id: Int,
    left: Int,
    right: Int,
): TypeConstraintEvent ->
    TypeConstraintEvent(
        kind = "same",
        node_id = node_id,
        left_node = left,
        right_node = right,
        type_name = "",
        byte_offset = node.start_byte,
    ).

@pure
remaining_branch_constraints(
    node: ProjectedExpressionNode,
    node_id: Int,
    child_ids: List[Int],
): List[TypeConstraintEvent] ->
    case child_ids {
        [] -> List.new[TypeConstraintEvent]();
        [child | rest] -> [same_children_constraint(node, node_id, node_id, child)
            | remaining_branch_constraints(node, node_id, rest)]
    }.

@pure
branch_constraints_after_first(
    node: ProjectedExpressionNode,
    node_id: Int,
    first: Int,
    child_ids: List[Int],
): List[TypeConstraintEvent] ->
    case child_ids {
        [] -> [propagate_child_constraint(node, node_id, first)];
        [second | rest] -> [same_children_constraint(node, node_id, first, second)
            | remaining_branch_constraints(node, node_id, rest)]
    }.

@pure
branch_constraints(
    node: ProjectedExpressionNode,
    node_id: Int,
    child_ids: List[Int],
): List[TypeConstraintEvent] ->
    case child_ids {
        [] -> [node_constraint(node, node_id, child_ids)];
        [first | rest] -> branch_constraints_after_first(node, node_id, first, rest)
    }.

@pure
case_clause_ids(child_ids: List[Int]): List[Int] ->
    case child_ids {
        [] -> List.new[Int]();
        [_subject | clauses] -> clauses
    }.

@pure
node_constraints(
    node: ProjectedExpressionNode,
    node_id: Int,
    child_ids: List[Int],
): List[TypeConstraintEvent] ->
    if {
        node.kind == "if" -> branch_constraints(node, node_id, child_ids);
        node.kind == "case" -> branch_constraints(node, node_id, case_clause_ids(child_ids));
        true -> [node_constraint(node, node_id, child_ids)]
    }.

@pure
number_children(
    values: List[ProjectedExpressionNode],
    next_id: Int,
    values_reversed: List[NumberedExpressionNode],
    ids_reversed: List[Int],
): NumberedChildren ->
    case values {
        [] -> NumberedChildren(
            next_id = next_id,
            values_reversed = values_reversed,
            ids = reverse(ids_reversed),
        );
        [value | rest] -> let walked = number_node(value, next_id);
            number_children(
                rest,
                walked.next_id,
                [walked.value | values_reversed],
                [walked.value.node_id | ids_reversed],
            )
    }.

@pure
number_node(node: ProjectedExpressionNode, node_id: Int): NumberedWalk ->
    let children = number_children(
        node.children,
        node_id + 1,
        List.new[NumberedExpressionNode](),
        List.new[Int](),
    );
    NumberedWalk(
        next_id = children.next_id,
        value = NumberedExpressionNode(
            node = node,
            node_id = node_id,
            child_ids = children.ids,
            children_reversed = children.values_reversed,
        ),
    ).

@pure
prepend_numbered_children(
    values_reversed: List[NumberedExpressionNode],
    output: List[TypeConstraintEvent],
): List[TypeConstraintEvent] ->
    case values_reversed {
        [] -> output;
        [value | rest] -> prepend_numbered_children(rest, prepend_numbered_events(value, output))
    }.

@pure
prepend_numbered_events(
    value: NumberedExpressionNode,
    output: List[TypeConstraintEvent],
): List[TypeConstraintEvent] ->
    prepend_numbered_children(
        value.children_reversed,
        concat(node_constraints(value.node, value.node_id, value.child_ids), output),
    ).

@pure
walk_type(node: ProjectedExpressionNode, node_id: Int): TypeWalk ->
    let numbered = number_node(node, node_id);
    TypeWalk(
        next_id = numbered.next_id,
        node_id = node_id,
        child_ids = numbered.value.child_ids,
        events = prepend_numbered_events(numbered.value, List.new[TypeConstraintEvent]()),
    ).

@pure
body_node_events(body: ProjectedBody, rest: List[ProjectedBody], signatures: List[ProjectedCallableSignature], next_id: Int, node: ProjectedExpressionNode, bindings: List[BindingEvent], calls: List[CallableUse], constraints: List[TypeConstraintEvent], links: List[BindingTypeLink]): ProjectedSemanticEvents ->
    let typed = walk_type(node, next_id);
    body_events_at(
        rest,
        remaining_signatures(signatures),
        typed.next_id,
        prepend_reversed(callable_binding_events(body, head_parameters(signatures), head_guard(signatures), node), bindings),
        prepend_reversed(call_uses(node), calls),
        prepend_reversed(typed.events, constraints),
        prepend_reversed(binding_type_links(node), links),
    ).

@pure
body_expression_events(body: ProjectedBody, rest: List[ProjectedBody], signatures: List[ProjectedCallableSignature], next_id: Int, value: Option[ProjectedExpressionNode], bindings: List[BindingEvent], calls: List[CallableUse], constraints: List[TypeConstraintEvent], links: List[BindingTypeLink]): ProjectedSemanticEvents ->
    case value {
        None -> body_events_at(rest, remaining_signatures(signatures), next_id, bindings, calls, constraints, links);
        Some(node) -> body_node_events(body, rest, signatures, next_id, node, bindings, calls, constraints, links)
    }.

@pure
body_events_at(
    values: List[ProjectedBody],
    signatures: List[ProjectedCallableSignature],
    next_id: Int,
    bindings: List[BindingEvent],
    calls: List[CallableUse],
    constraints: List[TypeConstraintEvent],
    links: List[BindingTypeLink],
): ProjectedSemanticEvents ->
    case values {
        [] -> ProjectedSemanticEvents(
            binding_events = reverse(bindings),
            callable_uses = reverse(calls),
            type_constraints = reverse(constraints),
            binding_type_links = reverse(links),
        );
        [body | rest] -> body_expression_events(body, rest, signatures, next_id, body.expression.node, bindings, calls, constraints, links)
    }.

@pure
pub adapt(bodies: ProjectedBodies, signatures: ProjectedSignatureDocument): ProjectedSemanticEvents ->
    ProjectedSemanticEvents(
        binding_events = adapt_binding_events(bodies, signatures),
        callable_uses = adapt_callable_uses(bodies),
        type_constraints = adapt_type_constraints(bodies),
        binding_type_links = adapt_binding_type_links(bodies),
    ).

@pure
binding_body_events_at(
    values: List[ProjectedBody],
    signatures: List[ProjectedCallableSignature],
    output: List[BindingEvent],
): List[BindingEvent] ->
    case values {
        [] -> reverse(output);
        [body | rest] -> case body.expression.node {
            None -> binding_body_events_at(rest, remaining_signatures(signatures), output);
            Some(node) -> binding_body_events_at(
                rest,
                remaining_signatures(signatures),
                prepend_reversed(
                    callable_binding_events(
                        body,
                        head_parameters(signatures),
                        head_guard(signatures),
                        node,
                    ),
                    output,
                ),
            )
        }
    }.

@pure
pub adapt_binding_events(
    bodies: ProjectedBodies,
    signatures: ProjectedSignatureDocument,
): List[BindingEvent] ->
    binding_body_events_at(
        bodies.values,
        signatures.callables,
        List.new[BindingEvent](),
    ).

@pure
callable_body_events_at(
    values: List[ProjectedBody],
    output: List[CallableUse],
): List[CallableUse] ->
    case values {
        [] -> reverse(output);
        [body | rest] -> case body.expression.node {
            None -> callable_body_events_at(rest, output);
            Some(node) -> callable_body_events_at(
                rest,
                prepend_reversed(call_uses(node), output),
            )
        }
    }.

@pure
pub adapt_callable_uses(bodies: ProjectedBodies): List[CallableUse] ->
    callable_body_events_at(bodies.values, List.new[CallableUse]()).

@pure
type_body_events_at(
    values: List[ProjectedBody],
    next_id: Int,
    output: List[TypeConstraintEvent],
): List[TypeConstraintEvent] ->
    case values {
        [] -> reverse(output);
        [body | rest] -> case body.expression.node {
            None -> type_body_events_at(rest, next_id, output);
            Some(node) ->
                let typed = walk_type(node, next_id);
                type_body_events_at(
                    rest,
                    typed.next_id,
                    prepend_reversed(typed.events, output),
                )
        }
    }.

@pure
pub adapt_type_constraints(bodies: ProjectedBodies): List[TypeConstraintEvent] ->
    type_body_events_at(bodies.values, 0, List.new[TypeConstraintEvent]()).

@pure
binding_type_link_body_events_at(
    values: List[ProjectedBody],
    output: List[BindingTypeLink],
): List[BindingTypeLink] ->
    case values {
        [] -> reverse(output);
        [body | rest] -> case body.expression.node {
            None -> binding_type_link_body_events_at(rest, output);
            Some(node) -> binding_type_link_body_events_at(
                rest,
                prepend_reversed(binding_type_links(node), output),
            )
        }
    }.

@pure
pub adapt_binding_type_links(bodies: ProjectedBodies): List[BindingTypeLink] ->
    binding_type_link_body_events_at(bodies.values, List.new[BindingTypeLink]()).
