/** Complete projected type rendering regressions. */
module self_host.ProjectedTypeRenderTest.

import self_host.ProjectedTypeRender.
import self_host.ProjectedTypeSyntax.ProjectedTypeNode.

named(value: String): ProjectedTypeNode ->
    ProjectedTypeNode("named-type", value, 0, 0, []).

@test
pub nested_generic_arguments_are_preserved(): Bool ->
    ProjectedTypeRender.render(ProjectedTypeNode(
        "generic-type",
        "List",
        0,
        0,
        [ProjectedTypeNode("generic-type", "Option", 0, 0, [named("Int")])],
    )) == "List[Option[Int]]".

pub self_test(): Bool -> nested_generic_arguments_are_preserved().
