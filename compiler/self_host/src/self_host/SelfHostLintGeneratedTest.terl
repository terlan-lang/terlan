/** Positive and negative generated-source manifest contracts. */
module self_host.SelfHostLintGeneratedTest.

import self_host.SelfHostLintGenerated.

@test
pub reports_missing_source_manifest_at_first_generated_marker(): Bool ->
    case SelfHostLintGenerated.diagnostics(
        "Generated.terl",
        "/**\n * @generated\n * Generated by terlc bind.\n */\nmodule generated.Sample.\n",
    ) {
        [value] ->
            value.rule_id == "TL0804"
                and value.rule_name == "interop.generated-source-manifest"
                and value.severity == "warning"
                and value.line == 2
                and value.column == 2;
        _ -> false
    }.

@test
pub accepts_explicit_source_manifest(): Bool ->
    SelfHostLintGenerated.diagnostics(
        "Generated.terl",
        "/**\n * @generated\n * source-manifest: typescript:lib.dom.d.ts#Window\n */\nmodule generated.Sample.\n",
    ) == [].

@test
pub reports_unstructured_suppression_and_skip_in_rule_order(): Bool ->
    let values = SelfHostLintGenerated.diagnostics(
        "Generated.terl",
        "/**\n * @generated\n * source-manifest: source\n * lint-disable TL0006\n * skipped unsupported mapped type\n */\n",
    );
    case values {
        [suppression, skip] ->
            suppression.rule_id == "TL0805"
                and suppression.line == 4
                and skip.rule_id == "TL0806"
                and skip.line == 5;
        _ -> false
    }.

@test
pub accepts_structured_suppression_and_skip_manifests(): Bool ->
    SelfHostLintGenerated.diagnostics(
        "Generated.terl",
        "/**\n * @generated\n * source-manifest: source\n * lint-suppression-manifest: lint.json\n * skip-manifest: skips.json\n * lint-disable TL0006\n * skipped unsupported mapped type\n */\n",
    ) == [].

@test
pub ignores_generated_policy_terms_in_handwritten_source(): Bool ->
    SelfHostLintGenerated.diagnostics(
        "Sample.terl",
        "module sample.\n// lint-disable and unsupported are documented here.\n",
    ) == [].
