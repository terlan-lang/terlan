/** Precedence-aligned, lossless parser for complete Terlan expressions. */
module self_host.ExpressionParser.

import self_host.ExpressionSyntax.{AddExpression, AndExpression, AssignmentExpression, BinaryExpression, BinaryLayoutExpression, CallExpression, CaseExpression, CastExpression, CompareExpression, ConstructorChainExpression, ExpressionClass, ExpressionParse, ExpressionSyntax, FixedArrayExpression, FloatExpression, GroupExpression, IfExpression, IntegerExpression, InvalidExpression, LambdaExpression, LetExpression, ListComprehensionExpression, ListConsExpression, ListExpression, MacroExpression, MapExpression, MultiplyExpression, NameExpression, NominalKeyedExpression, OrExpression, PipeExpression, QuoteExpression, RefutableLetExpression, SequenceExpression, StringExpression, TryExpression, TupleExpression, UnaryExpression, UnquoteExpression}.

import std.collections.List.
import std.core.{Int, String}.
import self_host.Delimited.


@pure
drop_terminal_empty(values: List[String]): List[String] ->
    case values {
        [] -> List.new[String]();
        [""] -> List.new[String]();
        [value | rest] -> [value | drop_terminal_empty(rest)]
    }.

@pure
all_nonempty(values: List[String]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> value != "" and all_nonempty(rest)
    }.

@pure
inner(source: String): String ->
    source.utf8_slice(1, source.byte_size() - 2).

@pure
starts_digit(source: String): Bool ->
    source != "" and source.utf8_byte_at(0) >= 48 and source.utf8_byte_at(0) <= 57.

@pure
is_quoted(source: String): Bool ->
    source.byte_size() >= 2
        and ((source.utf8_byte_at(0) == 34 and source.utf8_byte_at(source.byte_size() - 1) == 34)
            or (source.utf8_byte_at(0) == 39 and source.utf8_byte_at(source.byte_size() - 1) == 39)).

@pure
has_compare(source: String): Bool ->
    Delimited.top_level_text(source, " == ") >= 0
        or Delimited.top_level_text(source, " != ") >= 0
        or Delimited.top_level_text(source, " >= ") >= 0
        or Delimited.top_level_text(source, " > ") >= 0
        or Delimited.top_level_text(source, " <= ") >= 0
        or Delimited.top_level_text(source, " < ") >= 0
        or Delimited.top_level_text(source, " in ") >= 0.

@pure
is_refutable_let(source: String): Bool ->
    if {
        not String.starts_with(source, "let ") -> false;
        true -> Delimited.top_level_pair(source, 60, 45) >= 0
    }.

@pure
is_lambda(source: String): Bool ->
    if {
        not String.starts_with(source, "(") -> false;
        true -> Delimited.top_level_pair(source, 45, 62) >= 0
    }.

@pure
is_binary_layout(source: String): Bool ->
    if {
        String.contains(source, "]{") -> true;
        true -> String.contains(source, "] {")
    }.

@pure
is_nominal_keyed(source: String): Bool ->
    if {
        String.starts_with(source, "{") -> false;
        true -> String.contains(source, "{")
    }.

@pure
is_add(source: String): Bool ->
    if {
        Delimited.top_level_text(source, " + ") >= 0 -> true;
        Delimited.top_level_text(source, " - ") >= 0 -> true;
        true -> Delimited.top_level_pair(source, 46, 46) >= 0
    }.

@pure
is_multiply(source: String): Bool ->
    if {
        Delimited.top_level_text(source, " * ") >= 0 -> true;
        Delimited.top_level_text(source, " / ") >= 0 -> true;
        Delimited.top_level_text(source, " div ") >= 0 -> true;
        true -> Delimited.top_level_text(source, " rem ") >= 0
    }.

@pure
is_unary(source: String): Bool ->
    if {
        String.starts_with(source, "-") -> true;
        String.starts_with(source, "!") -> true;
        true -> String.starts_with(source, "not ")
    }.

@pure
is_float_number(source: String): Bool ->
    if {
        not starts_digit(source) -> false;
        String.contains(source, ".") -> true;
        String.contains(source, "e") -> true;
        true -> String.contains(source, "E")
    }.

@pure
classify_braced(source: String): ExpressionClass ->
    let contents = inner(source);
    if {
        String.trim(contents) == "" or Delimited.top_level_byte(contents, 58) >= 0 -> MapExpression;
        Delimited.top_level_byte(contents, 44) >= 0 -> TupleExpression;
        true -> InvalidExpression
    }.

@pure
classify_list(source: String): ExpressionClass ->
    let contents = inner(source);
    let pipe = Delimited.top_level_byte(contents, 124);
    if {
        pipe < 0 -> ListExpression;
        Delimited.top_level_pair(contents, 60, 45) >= 0 -> ListComprehensionExpression;
        true -> ListConsExpression
    }.

@pure
classify_call(source: String): ExpressionClass ->
    if { String.contains(source, "(") and String.ends_with(source, ")") -> CallExpression; true -> NameExpression }.

@pure
classify_group(source: String): ExpressionClass ->
    if { String.starts_with(source, "(") -> GroupExpression; true -> classify_call(source) }.

@pure
classify_integer(source: String): ExpressionClass ->
    if { starts_digit(source) -> IntegerExpression; true -> classify_group(source) }.

@pure
classify_float(source: String): ExpressionClass ->
    if { is_float_number(source) -> FloatExpression; true -> classify_integer(source) }.

@pure
classify_unary(source: String): ExpressionClass ->
    if { is_unary(source) -> UnaryExpression; true -> classify_float(source) }.

@pure
classify_cast(source: String): ExpressionClass ->
    if { Delimited.top_level_text(source, " as ") >= 0 -> CastExpression; true -> classify_unary(source) }.

@pure
classify_multiply(source: String): ExpressionClass ->
    if { is_multiply(source) -> MultiplyExpression; true -> classify_cast(source) }.

@pure
classify_add(source: String): ExpressionClass ->
    if { is_add(source) -> AddExpression; true -> classify_multiply(source) }.

@pure
classify_compare(source: String): ExpressionClass ->
    if { has_compare(source) -> CompareExpression; true -> classify_add(source) }.

@pure
classify_and(source: String): ExpressionClass ->
    if { Delimited.top_level_text(source, " and ") >= 0 -> AndExpression; true -> classify_compare(source) }.

@pure
classify_or(source: String): ExpressionClass ->
    if { Delimited.top_level_text(source, " or ") >= 0 -> OrExpression; true -> classify_and(source) }.

@pure
classify_pipe(source: String): ExpressionClass ->
    if { Delimited.top_level_pair(source, 124, 62) >= 0 -> PipeExpression; true -> classify_or(source) }.

@pure
classify_constructor_chain(source: String): ExpressionClass ->
    if { Delimited.top_level_text(source, " with ") >= 0 -> ConstructorChainExpression; true -> classify_pipe(source) }.

@pure
classify_assignment(source: String): ExpressionClass ->
    if { Delimited.top_level_assignment(source) >= 0 -> AssignmentExpression; true -> classify_constructor_chain(source) }.

@pure
classify_sequence(source: String, sequence: List[String]): ExpressionClass ->
    if { List.length(sequence) > 1 -> SequenceExpression; true -> classify_assignment(source) }.

@pure
classify_braces(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "{") -> classify_braced(source); true -> classify_sequence(source, sequence) }.

@pure
classify_square(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "[") -> classify_list(source); true -> classify_braces(source, sequence) }.

@pure
classify_nominal(source: String, sequence: List[String]): ExpressionClass ->
    if { is_nominal_keyed(source) -> NominalKeyedExpression; true -> classify_square(source, sequence) }.

@pure
classify_layout(source: String, sequence: List[String]): ExpressionClass ->
    if { is_binary_layout(source) -> BinaryLayoutExpression; true -> classify_nominal(source, sequence) }.

@pure
classify_fixed_array(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "#[") -> FixedArrayExpression; true -> classify_layout(source, sequence) }.

@pure
classify_binary(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "<<") -> BinaryExpression; true -> classify_fixed_array(source, sequence) }.

@pure
classify_string(source: String, sequence: List[String]): ExpressionClass ->
    if { is_quoted(source) -> StringExpression; true -> classify_binary(source, sequence) }.

@pure
classify_macro(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "?") -> MacroExpression; true -> classify_string(source, sequence) }.

@pure
classify_unquote(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "unquote(") -> UnquoteExpression; true -> classify_macro(source, sequence) }.

@pure
classify_if(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "if {") -> IfExpression; true -> classify_unquote(source, sequence) }.

@pure
classify_try(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "try ") -> TryExpression; true -> classify_if(source, sequence) }.

@pure
classify_case(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "case ") -> CaseExpression; true -> classify_try(source, sequence) }.

@pure
classify_quote(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "quote ") -> QuoteExpression; true -> classify_case(source, sequence) }.

@pure
classify_lambda(source: String, sequence: List[String]): ExpressionClass ->
    if { is_lambda(source) -> LambdaExpression; true -> classify_quote(source, sequence) }.

@pure
classify_let(source: String, sequence: List[String]): ExpressionClass ->
    if { String.starts_with(source, "let ") -> LetExpression; true -> classify_lambda(source, sequence) }.

@pure
classify(source: String): ExpressionClass ->
    let sequence = Delimited.split_top_level(source, 59);
    if { is_refutable_let(source) -> RefutableLetExpression; true -> classify_let(source, sequence) }.

@pure
parts_comprehension(source: String, class: ExpressionClass): List[String] ->
    if { class == ListComprehensionExpression -> Delimited.split_top_level(inner(source), 124); true -> List.new[String]() }.

@pure
parts_cons(source: String, class: ExpressionClass): List[String] ->
    if { class == ListConsExpression -> Delimited.split_top_level(inner(source), 124); true -> parts_comprehension(source, class) }.

@pure
parts_list(source: String, class: ExpressionClass): List[String] ->
    if { class == ListExpression -> drop_terminal_empty(Delimited.split_top_level(inner(source), 44)); true -> parts_cons(source, class) }.

@pure
parts_map(source: String, class: ExpressionClass): List[String] ->
    if { class == MapExpression -> drop_terminal_empty(Delimited.split_top_level(inner(source), 44)); true -> parts_list(source, class) }.

@pure
parts_tuple(source: String, class: ExpressionClass): List[String] ->
    if { class == TupleExpression -> drop_terminal_empty(Delimited.split_top_level(inner(source), 44)); true -> parts_map(source, class) }.

@pure
parts_for(source: String, class: ExpressionClass): List[String] ->
    if { class == SequenceExpression -> drop_terminal_empty(Delimited.split_top_level(source, 59)); true -> parts_tuple(source, class) }.

@pure
invalid(source: String, message: String): ExpressionParse ->
    ExpressionParse(false, ExpressionSyntax(InvalidExpression, source, List.new[String]()), message).

@pure
parse_comprehension(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { class == ListComprehensionExpression and List.length(parts) != 2 -> invalid(source, "list comprehension requires a value and qualifiers"); true -> ExpressionParse(true, ExpressionSyntax(class, normalized, parts), "") }.

@pure
parse_cons(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { class == ListConsExpression and List.length(parts) != 2 -> invalid(source, "list-cons expression requires one head and one tail"); true -> parse_comprehension(source, normalized, class, parts) }.

@pure
parse_tuple(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { class == TupleExpression and List.length(parts) < 2 -> invalid(source, "tuple expression requires at least two items"); true -> parse_cons(source, normalized, class, parts) }.

@pure
parse_parts(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { not all_nonempty(parts) -> invalid(source, "expression contains an empty component"); true -> parse_tuple(source, normalized, class, parts) }.

@pure
parse_class(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { class == InvalidExpression -> invalid(source, "braced expression must be a tuple or keyed map"); true -> parse_parts(source, normalized, class, parts) }.

@pure
parse_balanced(source: String, normalized: String, class: ExpressionClass, parts: List[String]): ExpressionParse ->
    if { not Delimited.balanced(normalized) -> invalid(source, "expression has unbalanced delimiters"); true -> parse_class(source, normalized, class, parts) }.

/** Parses one complete expression and preserves immediate precedence components. */
@pure
pub parse(source: String): ExpressionParse ->
    let normalized = String.trim(source);
    let class = classify(normalized);
    let parts = parts_for(normalized, class);
    if { normalized == "" -> invalid(source, "expression is empty"); true -> parse_balanced(source, normalized, class, parts) }.
