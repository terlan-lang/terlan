/**
 * Builds exact-arity callable catalogs from typed backend declarations and interfaces.
 */
module self_host.ProjectedCallableCatalog.



import std.core.Option.{None, Option, Some}.
import std.collections.List.
import self_host.BackendSyntax.
import self_host.BackendSyntax.{BackendDeclaration, BackendModule}.
import self_host.ConstructorSyntax.
import self_host.ConstructorSyntax.{ConstructorClauseSyntax, ConstructorSyntax}.
import self_host.DeclarationClass.
import self_host.Syntax.{ConstFunctionDeclaration, ConstructorDeclaration, FunctionDeclaration, MethodDeclaration}.
import self_host.ModuleInterfaceSyntax.
import self_host.ModuleInterfaceSyntax.{ExportedSymbol, ModuleInterface}.
import self_host.ProjectedCallableSyntax.
import self_host.ProjectedCallableSyntax.{CallableDeclaration}.
import self_host.TypedModuleSyntax.

import self_host.TypedModuleSyntax.{ConstructorPayload, FunctionPayload, MethodPayload, TypedDeclarationPayload}.

some_return_type(value: String): Option[String] -> Some(value).

none_return_type(): Option[String] -> None.

callable(
    module_name: String,
    name: String,
    arity: Int,
    callable_kind: String,
    return_type: Option[String],
    byte_offset: Int,
): CallableDeclaration ->
    CallableDeclaration(
        module_name = module_name,
        name = name,
        arity = arity,
        callable_kind = callable_kind,
        return_type = return_type,
        byte_offset = byte_offset,
    ).

declaration_offset(value: BackendDeclaration): Int ->
    if {
        value.is_public -> value.span.start_byte + 4;
        true -> value.span.start_byte
    }.

constructor_clauses(
    module_name: String,
    name: String,
    values: List[ConstructorClauseSyntax],
    byte_offset: Int,
): List[CallableDeclaration] ->
    case values {
        [] -> List.new[CallableDeclaration]();
        [value | rest] -> [constructor_callable(module_name, name, value, byte_offset)
            | constructor_clauses(module_name, name, rest, byte_offset)]
    }.

constructor_callable(
    module_name: String,
    name: String,
    value: ConstructorClauseSyntax,
    byte_offset: Int,
): CallableDeclaration ->
    callable(
        module_name,
        name,
        value.parameters.length(),
        "constructor",
        selected_return_type(value.return_type.valid, value.return_type.syntax.text),
        byte_offset,
    ).

selected_return_type(valid: Bool, text: String): Option[String] ->
    if {
        valid -> some_return_type(text);
        true -> none_return_type()
    }.

function_kind(is_const: Bool): String ->
    if {
        is_const -> "const-function";
        true -> "function"
    }.

local_declaration(
    module_name: String,
    value: BackendDeclaration,
): List[CallableDeclaration] ->
    local_function_payload(module_name, value, value.payload).

local_function_payload(
    module_name: String,
    value: BackendDeclaration,
    payload: TypedDeclarationPayload,
): List[CallableDeclaration] ->
    case payload {
        FunctionPayload(function) -> [callable(
            module_name,
            value.symbol_name,
            function.typed_parameters.length(),
            function_kind(function.is_const),
            selected_return_type(function.return_type.valid, function.return_type.syntax.text),
            declaration_offset(value),
        )];
        _ -> local_method_payload(module_name, value, payload)
    }.

local_method_payload(
    module_name: String,
    value: BackendDeclaration,
    payload: TypedDeclarationPayload,
): List[CallableDeclaration] ->
    case payload {
        MethodPayload(method) -> [callable(
            module_name,
            value.symbol_name,
            method.parameters.length(),
            "method",
            selected_return_type(method.return_type.valid, method.return_type.syntax.text),
            declaration_offset(value),
        )];
        _ -> local_constructor_payload(module_name, value, payload)
    }.

local_constructor_payload(
    module_name: String,
    value: BackendDeclaration,
    payload: TypedDeclarationPayload,
): List[CallableDeclaration] ->
    case payload {
        ConstructorPayload(constructor_payload) -> constructor_clauses(
            module_name,
            value.symbol_name,
            constructor_payload.clauses,
            declaration_offset(value),
        );
        _ -> List.new[CallableDeclaration]()
    }.

prepend_all(
    values: List[CallableDeclaration],
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    case values {
        [] -> output;
        [value | rest] -> prepend_all(rest, [value | output])
    }.

reverse_at(
    values: List[CallableDeclaration],
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

reverse(values: List[CallableDeclaration]): List[CallableDeclaration] ->
    reverse_at(values, List.new[CallableDeclaration]()).

local_at(
    module_name: String,
    values: List[BackendDeclaration],
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    case values {
        [] -> output;
        [value | rest] -> local_at(
            module_name,
            rest,
            prepend_all(
            local_declaration(module_name, value),
                output,
            ),
        )
    }.

is_callable_class(value: DeclarationClass): Bool ->
    case value {
        FunctionDeclaration -> true;
        _ -> is_const_callable_class(value)
    }.

is_const_callable_class(value: DeclarationClass): Bool ->
    case value {
        ConstFunctionDeclaration -> true;
        _ -> is_method_callable_class(value)
    }.

is_method_callable_class(value: DeclarationClass): Bool ->
    case value {
        MethodDeclaration -> true;
        _ -> is_constructor_callable_class(value)
    }.

is_constructor_callable_class(value: DeclarationClass): Bool ->
    case value {
        ConstructorDeclaration -> true;
        _ -> false
    }.

class_kind(value: DeclarationClass): String ->
    case value {
        ConstFunctionDeclaration -> "const-function";
        _ -> method_class_kind(value)
    }.

method_class_kind(value: DeclarationClass): String ->
    case value {
        MethodDeclaration -> "method";
        _ -> constructor_class_kind(value)
    }.

constructor_class_kind(value: DeclarationClass): String ->
    case value {
        ConstructorDeclaration -> "constructor";
        _ -> "function"
    }.

interface_symbols(
    module_name: String,
    values: List[ExportedSymbol],
): List[CallableDeclaration] ->
    case values {
        [] -> List.new[CallableDeclaration]();
        [value | rest] -> interface_symbol(module_name, value, rest)
    }.

interface_symbol(
    module_name: String,
    value: ExportedSymbol,
    rest: List[ExportedSymbol],
): List[CallableDeclaration] ->
    if {
        is_callable_class(value.class) -> [interface_callable(module_name, value)
            | interface_symbols(module_name, rest)];
        true -> interface_symbols(module_name, rest)
    }.

interface_callable(module_name: String, value: ExportedSymbol): CallableDeclaration ->
    callable(
        module_name,
        value.name,
        value.arity,
        class_kind(value.class),
        value.return_type,
        value.span.start_byte,
    ).

interface_symbols_at(
    module_name: String,
    values: List[ExportedSymbol],
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    case values {
        [] -> output;
        [value | rest] -> interface_symbols_at(
            module_name,
            rest,
            interface_output(module_name, value, output),
        )
    }.

interface_output(
    module_name: String,
    value: ExportedSymbol,
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    if {
        is_callable_class(value.class) -> [interface_callable(module_name, value) | output];
        true -> output
    }.

interfaces_at(
    values: List[ModuleInterface],
    output: List[CallableDeclaration],
): List[CallableDeclaration] ->
    case values {
        [] -> output;
        [value | rest] -> interfaces_at(
            rest,
            interface_symbols_at(value.module_name, value.symbols, output),
        )
    }.

pub local(current_module: BackendModule): List[CallableDeclaration] ->
    reverse(local_at(
        current_module.module_name,
        current_module.declarations,
        List.new[CallableDeclaration](),
    )).

pub build(
    current_module: BackendModule,
    imported_interfaces: List[ModuleInterface],
): List[CallableDeclaration] ->
    prepend_all(
        local_at(
            current_module.module_name,
            current_module.declarations,
            List.new[CallableDeclaration](),
        ),
        reverse(interfaces_at(imported_interfaces, List.new[CallableDeclaration]())),
    ).
