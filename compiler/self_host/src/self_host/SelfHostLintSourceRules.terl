/** Ordered aggregation boundary for self-hosted source-only lint families. */
module self_host.SelfHostLintSourceRules.

import self_host.SelfHostLintActorVm.{ActorFunction, ActorVmDiagnostic}.
import self_host.SelfHostLintActorVm.
import self_host.SelfHostLintComplexity.{ClauseSpan, ComplexityDiagnostic}.
import self_host.SelfHostLintComplexity.
import self_host.SelfHostLintConsistency.{ConsistencyDiagnostic}.
import self_host.SelfHostLintConsistency.
import self_host.SelfHostLintGenerated.{GeneratedDiagnostic}.
import self_host.SelfHostLintGenerated.
import self_host.SelfHostLintMaintainability.{MaintainabilityDiagnostic}.
import self_host.SelfHostLintMaintainability.
import self_host.SelfHostLintPipe.{PipeCandidate}.
import self_host.SelfHostLintPipeFix.
import self_host.SelfHostLintSemicolon.{SemicolonDiagnostic}.
import self_host.SelfHostLintSemicolon.
import self_host.SelfHostLintTargets.{TargetDiagnostic}.
import self_host.SelfHostLintTargets.

pub struct SourceDiagnostic {
    path: String,
    line: Int,
    column: Int,
    rule_id: String,
    rule_name: String,
    severity: String,
    message: String,
    fix_available: Bool,
}.

pub constructor SourceDiagnostic {
    (path: String, line: Int, column: Int, rule_id: String, rule_name: String, severity: String, message: String, fix_available: Bool): SourceDiagnostic ->
        SourceDiagnostic {
            path: path,
            line: line,
            column: column,
            rule_id: rule_id,
            rule_name: rule_name,
            severity: severity,
            message: message,
            fix_available: fix_available,
        }
}.

append[T](left: List[T], right: List[T]): List[T] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append(rest, right)]
    }.

from_semicolon(values: List[SemicolonDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_semicolon(rest)]
    }.

from_complexity(values: List[ComplexityDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_complexity(rest)]
    }.

from_actor(values: List[ActorVmDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_actor(rest)]
    }.

from_maintainability(values: List[MaintainabilityDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_maintainability(rest)]
    }.

from_generated(values: List[GeneratedDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_generated(rest)]
    }.

from_consistency(values: List[ConsistencyDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_consistency(rest)]
    }.

from_targets(values: List[TargetDiagnostic]): List[SourceDiagnostic] ->
    case values {
        [] -> [];
        [value | rest] -> [SourceDiagnostic(
            value.path, value.line, value.column, value.rule_id, value.rule_name,
            value.severity, value.message, value.fix_available,
        ) | from_targets(rest)]
    }.

/** Aggregates implemented source-only rules in public Rust registry order. */
pub diagnostics(
    path: String,
    source: String,
    clause_spans: List[ClauseSpan],
): List[SourceDiagnostic] -> diagnostics_with_actor(path, source, clause_spans, []).

/** Aggregates source rules with normalized actor declarations at the registry position. */
pub diagnostics_with_actor(
    path: String,
    source: String,
    clause_spans: List[ClauseSpan],
    actor_functions: List[ActorFunction],
): List[SourceDiagnostic] ->
    append(
        from_semicolon(SelfHostLintSemicolon.diagnostics(path, source)),
        append(
            from_complexity(SelfHostLintComplexity.function_size(path, source, clause_spans)),
            append(
                from_complexity(SelfHostLintComplexity.match_arm_size(path, source)),
                append(
                    from_complexity(SelfHostLintComplexity.file_size(path, source)),
                    append(
                        from_actor(SelfHostLintActorVm.diagnostics(path, source, actor_functions)),
                        append(
                            from_maintainability(SelfHostLintMaintainability.debug_calls(path, source)),
                            append(
                                from_maintainability(SelfHostLintMaintainability.sql_line_width(path, source)),
                                append(
                                    from_consistency(SelfHostLintConsistency.diagnostics(path, source)),
                                    append(
                                        from_generated(SelfHostLintGenerated.diagnostics(path, source)),
                                        from_targets(SelfHostLintTargets.diagnostics(path, source)),
                                    ),
                                ),
                            ),
                        ),
                    ),
                ),
            ),
        ),
    ).

/** Applies safe fixes in public order; pipe candidates belong to semicolon-fixed source. */
pub fix(source: String, pipe_candidates: List[PipeCandidate]): String ->
    SelfHostLintPipeFix.apply(SelfHostLintSemicolon.fix(source), pipe_candidates).
