module self_host.LexerTest.

import self_host.Token.{Identifier, IntegerLiteral, Keyword, StringLiteral, Symbol}.

import self_host.Lexer.
import std.collections.List.

lexemes(tokens: List[self_host.Token.Token], output: List[String]): List[String] ->
    case tokens {
        [] -> output;
        [token | rest] -> [token.lexeme | lexemes(rest, output)]
    }.

@test
pub lexer_accepts_module_function_and_unicode_string(): Bool ->
    let result = Lexer.lex("module sample.Main.\npub answer(): String -> \"café\".\n");
    List.is_empty(result.errors)
        and lexemes(result.tokens, [])
            == ["module", "sample", ".", "Main", ".", "pub", "answer", "(", ")", ":", "String", "->", "\"café\"", "."].

@test
pub lexer_rejects_unicode_identifier(): Bool ->
    let result = Lexer.lex("pub café(): String -> \"ok\".");
    not List.is_empty(result.errors).

@test
pub lexer_records_complete_string_columns(): Bool ->
    let result = Lexer.lex("\"abc\"");
    case result.tokens {
        [value] -> value.span.start_column == 1 and value.span.end_column == 6;
        _ -> false
    }.

@test
pub lexer_classifies_representative_tokens(): Bool ->
    let result = Lexer.lex("module name 42 \"text\" ->");
    case result.tokens {
        [keyword, identifier, integer, string, symbol] ->
            keyword.kind == Keyword
                and identifier.kind == Identifier
                and integer.kind == IntegerLiteral
                and string.kind == StringLiteral
                and symbol.kind == Symbol;
        _ -> false
    }.

@test
pub lexer_reports_unterminated_string(): Bool ->
    let result = Lexer.lex("\"unterminated");
    List.length(result.errors) == 1 and List.is_empty(result.tokens).

@test
pub lexer_reports_unterminated_comment(): Bool ->
    let result = Lexer.lex("/* unterminated");
    List.length(result.errors) == 1 and List.is_empty(result.tokens).

@test
pub lexer_skips_complete_comments(): Bool ->
    let result = Lexer.lex("// line\n/* block */module sample.Main.");
    List.is_empty(result.errors)
        and lexemes(result.tokens, []) == ["module", "sample", ".", "Main", "."].
