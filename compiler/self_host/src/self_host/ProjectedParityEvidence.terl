/**
 * Compact parser-parity artifact shared with the canonical Rust oracle.
 */
module self_host.ProjectedParityEvidence.


import std.core.Result.{Result}.
import std.data.Json.
import std.collections.List.
import type std.data.Json.{Json, JsonError}.
import self_host.BackendAbi.
import self_host.BackendSyntax.

import self_host.BackendSyntax.{BackendDeclaration, BackendModule}.
import self_host.DeclarationSyntax.{DeclarationSyntax, ModuleSyntax}.
import self_host.ProjectedParserSyntax.{ProjectedSurfaceDeclaration, ProjectedSurfaceModule}.
import self_host.Syntax.{AnnotationSchemaDeclaration, ConfigDeclaration, ConstFunctionDeclaration, ConstantDeclaration, ConstructorDeclaration, DeclarationClass, ExportDeclaration, FunctionDeclaration, ImportDeclaration, MethodDeclaration, NativeDeclaration, OpaqueTypeDeclaration, ShapeDeclaration, StructDeclaration, TemplateDeclaration, TraitDeclaration, TraitImplDeclaration, TypeDeclaration}.
import self_host.Parser.

surface_class_native(value: DeclarationClass): String ->
    if { value == NativeDeclaration -> "NativeDecl"; true -> "UnknownDecl" }.

surface_class_config(value: DeclarationClass): String ->
    if { value == ConfigDeclaration -> "ConfigDecl"; true -> surface_class_native(value) }.

surface_class_shape(value: DeclarationClass): String ->
    if { value == ShapeDeclaration -> "ShapeDecl"; true -> surface_class_config(value) }.

surface_class_template(value: DeclarationClass): String ->
    if { value == TemplateDeclaration -> "TemplateDecl"; true -> surface_class_shape(value) }.

surface_class_annotation(value: DeclarationClass): String ->
    if { value == AnnotationSchemaDeclaration -> "AnnotationSchemaDecl"; true -> surface_class_template(value) }.

surface_class_impl(value: DeclarationClass): String ->
    if { value == TraitImplDeclaration -> "TraitImplDecl"; true -> surface_class_annotation(value) }.

surface_class_trait(value: DeclarationClass): String ->
    if { value == TraitDeclaration -> "TraitDecl"; true -> surface_class_impl(value) }.

surface_class_method(value: DeclarationClass): String ->
    if { value == MethodDeclaration -> "MethodDecl"; true -> surface_class_trait(value) }.

surface_class_function(value: DeclarationClass): String ->
    if { value == FunctionDeclaration -> "FunctionDecl"; true -> surface_class_method(value) }.

surface_class_constructor(value: DeclarationClass): String ->
    if { value == ConstructorDeclaration -> "ConstructorDecl"; true -> surface_class_function(value) }.

surface_class_struct(value: DeclarationClass): String ->
    if { value == StructDeclaration -> "StructDecl"; true -> surface_class_constructor(value) }.

surface_class_type(value: DeclarationClass): String ->
    if { value == TypeDeclaration -> "TypeDecl"; true -> surface_class_struct(value) }.

surface_class_opaque(value: DeclarationClass): String ->
    if { value == OpaqueTypeDeclaration -> "OpaqueTypeDecl"; true -> surface_class_type(value) }.

surface_class_const_function(value: DeclarationClass): String ->
    if { value == ConstFunctionDeclaration -> "ConstFunctionDecl"; true -> surface_class_opaque(value) }.

surface_class_constant(value: DeclarationClass): String ->
    if { value == ConstantDeclaration -> "ConstantDecl"; true -> surface_class_const_function(value) }.

surface_class_export(value: DeclarationClass): String ->
    if { value == ExportDeclaration -> "ExportDecl"; true -> surface_class_constant(value) }.

surface_class_import(value: DeclarationClass): String ->
    if { value == ImportDeclaration -> "ImportDecl"; true -> surface_class_export(value) }.

surface_class_name(value: DeclarationClass): String ->
    surface_class_import(value).

declaration(value: BackendDeclaration): Json ->
    Json.object()
        .put("class", Json.string(surface_class_name(value.class)))
        .put("symbol_name", Json.string(value.symbol_name))
        .put("is_public", Json.bool(value.is_public)).

declarations_at(values: List[BackendDeclaration], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> declarations_at(rest, output.push(declaration(value)))
    }.

pub document_with_validity(value: BackendModule, valid: Bool): Json ->
    Json.object()
        .put("schema", Json.string("terlan.self_host.surface.v1"))
        .put("valid", Json.bool(valid))
        .put("module_name", Json.string(value.module_name))
        .put("declarations", declarations_at(value.declarations, Json.array())).

pub document(value: BackendModule): Json ->
    document_with_validity(value, value.valid).

pub encode(value: BackendModule): Result[String, JsonError] ->
    Json.stringify_pretty(document(value)).

pub encode_with_validity(value: BackendModule, valid: Bool): Result[String, JsonError] ->
    Json.stringify_pretty(document_with_validity(value, valid)).

projected_surface_declaration(value: ProjectedSurfaceDeclaration): Json ->
    Json.object()
        .put("class", Json.string(surface_class_name(value.class)))
        .put("symbol_name", Json.string(Parser.declaration_head(value.text)))
        .put("is_public", Json.bool(value.is_public)).

projected_surface_declarations_at(values: List[ProjectedSurfaceDeclaration], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] ->
            projected_surface_declarations_at(rest, output.push(projected_surface_declaration(value)))
    }.

pub projected_surface_document(value: ProjectedSurfaceModule): Json ->
    Json.object()
        .put("schema", Json.string("terlan.self_host.surface.v1"))
        .put("valid", Json.bool(value.valid))
        .put("module_name", Json.string(value.name))
        .put("declarations", projected_surface_declarations_at(value.declarations, Json.array())).

pub encode_projected_surface(value: ProjectedSurfaceModule): Result[String, JsonError] ->
    Json.stringify_pretty(projected_surface_document(value)).

surface_declaration(value: DeclarationSyntax): Json ->
    Json.object()
        .put("class", Json.string(surface_class_name(value.class)))
        .put("symbol_name", Json.string(value.name))
        .put("is_public", Json.bool(value.is_public)).

surface_declarations_at(values: List[DeclarationSyntax], output: Json): Json ->
    case values {
        [] -> output;
        [value | rest] -> surface_declarations_at(rest, output.push(surface_declaration(value)))
    }.

pub surface_document_with_validity(value: ModuleSyntax, valid: Bool): Json ->
    Json.object()
        .put("schema", Json.string("terlan.self_host.surface.v1"))
        .put("valid", Json.bool(valid))
        .put("module_name", Json.string(value.name))
        .put("declarations", surface_declarations_at(value.declarations, Json.array())).

pub surface_document(value: ModuleSyntax): Json ->
    surface_document_with_validity(value, value.valid).

pub encode_surface(value: ModuleSyntax): Result[String, JsonError] ->
    Json.stringify_pretty(surface_document(value)).

pub encode_surface_with_validity(value: ModuleSyntax, valid: Bool): Result[String, JsonError] ->
    Json.stringify_pretty(surface_document_with_validity(value, valid)).
