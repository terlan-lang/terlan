/** Filesystem writer for deterministic multi-module ABI-1 packages. */
module self_host.ProjectedPackageWriter.

import std.core.String.



import self_host.ProjectedPackageCompile.
import self_host.SelfHostDiagnosticRendering.
import self_host.ModuleInterfaceSyntax.{ModuleInterface}.
import self_host.ProjectedPackageSyntax.{ProjectedPackageArtifact, ProjectedPackageCompilation}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.Result.{Err, Ok}.
import std.core.{String}.
import std.io.Directory.
import std.io.File.


@pure
reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

@pure
reverse[T](values: List[T]): List[T] -> reverse_at(values, List.new[T]()).

@pure
source_manifest_entries_at(paths: List[String], output: List[String]): List[String] ->
    case paths {
        [] -> reverse(output);
        [path | rest] -> let normalized = String.trim(path);
            if {
                normalized == "" or String.starts_with(normalized, "#") ->
                    source_manifest_entries_at(rest, output);
                true -> source_manifest_entries_at(rest, [normalized | output])
            }
    }.

/** Returns normalized source paths in their declared manifest order. */
@pure
pub source_manifest_entries(paths: String): List[String] ->
    source_manifest_entries_at(String.split(paths, "\n"), List.new[String]()).


read_source_file(normalized: String, rest: List[String], output: List[String]): Option[List[String]] ->
    case File.read_text(normalized) {
        Ok(source) -> read_sources(rest, [source | output]);
        Err(_reason) -> None
    }.

read_sources(paths: List[String], output: List[String]): Option[List[String]] ->
    case paths {
        [] -> Some(reverse(output));
        [path | rest] -> read_source_file(path, rest, output)
    }.

@pure
artifact_value(value: ProjectedPackageArtifact, rest: List[ProjectedPackageArtifact], output: String): Option[String] ->
    case value.json {
        None -> None;
        Some(json) -> artifact_bundle(rest, String.concat([output, json, "\n"]))
    }.

@pure
artifact_bundle(values: List[ProjectedPackageArtifact], output: String): Option[String] ->
    case values {
        [] -> Some(output);
        [value | rest] -> artifact_value(value, rest, output)
    }.

@pure
package_bundle(package: ProjectedPackageCompilation): Option[String] ->
    if {
        not package.valid -> None;
        true -> artifact_bundle(
            package.artifacts,
            "schema\tterlan.self-host.abi-package/v1\n",
        )
    }.

render_paths(paths: String): Option[String] ->
    case read_sources(source_manifest_entries(paths), List.new[String]()) {
        None -> None;
        Some(sources) -> package_bundle(ProjectedPackageCompile.compile(
            sources,
            List.new[ModuleInterface](),
            "terlan-vm",
        ))
    }.

/** Reads a source manifest and renders one validated canonical envelope bundle. */
pub render(manifest: String): Option[String] ->
    case File.read_text(manifest) {
        Err(_reason) -> None;
        Ok(paths) -> render_paths(paths)
    }.

write_bundle(output: String, bundle: String): Bool ->
    case File.write_text(String.append(output, "/package.abi1.bundle"), bundle) {
        Err(_reason) -> false;
        Ok(_unit) -> true
    }.

write_diagnostics(output: String, diagnostics: String): Bool ->
    case File.write_text(String.append(output, "/package.diagnostics"), diagnostics) {
        Err(_reason) -> false;
        Ok(_unit) -> true
    }.

write_marker(output: String): Bool ->
    case File.write_text(String.append(output, "/package.complete"), "complete\n") {
        Err(_reason) -> false;
        Ok(_unit) -> true
    }.

write_failure(output: String, message: String): Bool ->
    let _diagnostics = write_diagnostics(
        output,
        SelfHostDiagnosticRendering.render_messages("package", [message]),
    );
    false.

write_success(output: String, bundle: String): Bool ->
    if {
        not write_bundle(output, bundle) -> write_failure(output, "cannot write package bundle");
        not write_diagnostics(output, "") -> false;
        true -> write_marker(output)
    }.

/** Writes a stale-safe package publication with its completion marker last. */
pub write(manifest: String, output: String): Bool ->
    let _created = Directory.create_all(output);
    let _removed = File.delete(String.append(output, "/package.complete"));
    case render(manifest) {
        None -> write_failure(output, "cannot render package manifest");
        Some(bundle) -> write_success(output, bundle)
    }.
