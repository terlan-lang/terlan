/** Source-level pattern binding type propagation regressions. */
module self_host.ProjectedPatternBindingTypeMergeTest.

import self_host.CanonicalLexer.
import self_host.ProjectedFrontend.
import self_host.ProjectedSemanticAnalysis.
import std.collections.List.
import std.core.String.

@test
pub list_head_and_tail_bindings_retain_subject_types(): Bool ->
    let source = String.concat([
        "module demo.PatternBinding.\n",
        "pub select(values: List[Int]): List[Int] -> case values {\n",
        "    [] -> values;\n",
        "    [value | rest] -> if { value > 0 -> rest; true -> values }\n",
        "}.\n",
    ]);
    let lexed = CanonicalLexer.lex(source);
    ProjectedSemanticAnalysis.analyze(
        ProjectedFrontend.compile(source, lexed.tokens),
        List.new[String](),
    ).expression_typecheck.valid.

pub self_test(): Bool -> list_head_and_tail_bindings_retain_subject_types().
