/**
 * Provides pure expression-plan, typing, pattern, and opcode support.
 */
module self_host.ProjectedExpressionSupportIrPlan.

import std.core.String.

import self_host.BackendSyntax.{BackendDeclaration}.
import self_host.ProjectedBodySyntax.{ProjectedBody}.
import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact}.
import self_host.SelfHostIrSyntax.{IrParameter}.
import self_host.SelfHostSemanticIrSyntax.{SemanticBlockPlan, SemanticInstructionPlan}.
import self_host.{BackendSyntax, ParameterSyntax, ProjectedBodySyntax, ProjectedExpressionSyntax, ProjectedTypeConstraintSyntax, SelfHostIrSyntax, SelfHostSemanticIrSyntax}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Bool, Float, Int, String}.

pub struct ExpressionPlan {
    next_id: Int,
    result: String,
    result_type: Option[String],
    instructions: List[SemanticInstructionPlan],
}.

pub constructor ExpressionPlan {
    (next_id: Int, result: String, result_type: Option[String], instructions: List[SemanticInstructionPlan]): ExpressionPlan ->
        ExpressionPlan {
            next_id: next_id,
            result: result,
            result_type: result_type,
            instructions: instructions,
        }
}.

reverse_at[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> reverse_at(rest, [value | output])
    }.

prepend_reversed[T](values: List[T], output: List[T]): List[T] ->
    case values {
        [] -> output;
        [value | rest] -> prepend_reversed(rest, [value | output])
    }.

concat[T](left: List[T], right: List[T]): List[T] ->
    prepend_reversed(reverse_at(left, List.new[T]()), right).

pub concat_instructions(
    left: List[SemanticInstructionPlan],
    right: List[SemanticInstructionPlan],
): List[SemanticInstructionPlan] ->
    concat(left, right).

pub concat_blocks(
    left: List[SemanticBlockPlan],
    right: List[SemanticBlockPlan],
): List[SemanticBlockPlan] ->
    concat(left, right).

pub parameter_count(values: List[IrParameter]): Int ->
    case values {
        [] -> 0;
        [_ | rest] -> 1 + parameter_count(rest)
    }.

pub parameter_named(name: String, values: List[IrParameter]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> if {
            value.name == name -> true;
            true -> parameter_named(name, rest)
        }
    }.

pub append_ir_parameters(
    left: List[IrParameter],
    right: List[IrParameter],
): List[IrParameter] ->
    case left {
        [] -> right;
        [value | rest] -> [value | append_ir_parameters(rest, right)]
    }.

pub parameter_names(values: List[IrParameter]): List[String] ->
    case values {
        [] -> List.new[String]();
        [value | rest] -> [value.name | parameter_names(rest)]
    }.

lambda_pattern_name(pattern: ProjectedExpressionNode): String ->
    case String.split(pattern.text, ":") {
        [name | _rest] -> String.trim(name);
        [] -> pattern.text
    }.

lambda_pattern_type(pattern: ProjectedExpressionNode): String ->
    case String.split(pattern.text, ":") {
        [_name, type_name] -> String.trim(type_name);
        _ -> ""
    }.

lambda_parameter(pattern: ProjectedExpressionNode): IrParameter ->
    IrParameter(lambda_pattern_name(pattern), lambda_pattern_type(pattern)).

lambda_parameter_nodes(values: List[ProjectedExpressionNode]): List[IrParameter] ->
    case values {
        [] -> List.new[IrParameter]();
        [value | rest] -> [lambda_parameter(value) | lambda_parameter_nodes(rest)]
    }.

pub lambda_parameters(node: ProjectedExpressionNode): List[IrParameter] ->
    case node.children {
        [patterns, _body] -> lambda_parameter_nodes(patterns.children);
        _ -> List.new[IrParameter]()
    }.

pub lambda_body(node: ProjectedExpressionNode): Option[ProjectedExpressionNode] ->
    case node.children {
        [_patterns, body] -> Some(body);
        _ -> None
    }.

pub lambda_body_id(node: ProjectedExpressionNode, node_id: Int): Int ->
    case node.children {
        [patterns, _body] -> node_id + 1 + node_size(patterns);
        _ -> node_id + 1
    }.

pub lambda_symbol(node: ProjectedExpressionNode): String ->
    String.concat(["$lambda$", Int.to_string(node.start_byte)]).

node_references(name: String, node: ProjectedExpressionNode): Bool ->
    if {
        (node.kind == "identifier" or node.kind == "atom") and node.text == name -> true;
        true -> children_reference(name, node.children)
    }.

children_reference(name: String, values: List[ProjectedExpressionNode]): Bool ->
    case values {
        [] -> false;
        [value | rest] -> if {
            node_references(name, value) -> true;
            true -> children_reference(name, rest)
        }
    }.

lambda_capture_parameters(
    body: ProjectedExpressionNode,
    local: List[IrParameter],
    outer: List[IrParameter],
): List[IrParameter] ->
    case outer {
        [] -> List.new[IrParameter]();
        [value | rest] -> if {
            not parameter_named(value.name, local) and node_references(value.name, body) ->
                [value | lambda_capture_parameters(body, local, rest)];
            true -> lambda_capture_parameters(body, local, rest)
        }
    }.

pub lambda_captures(
    node: ProjectedExpressionNode,
    outer: List[IrParameter],
): List[IrParameter] ->
    case lambda_body(node) {
        Some(body) -> lambda_capture_parameters(body, lambda_parameters(node), outer);
        None -> List.new[IrParameter]()
    }.

pub ir_parameters(values: List[ParameterSyntax]): List[IrParameter] ->
    case values {
        [] -> List.new[IrParameter]();
        [value | rest] -> [parameter(value) | ir_parameters(rest)]
    }.

pub shallow_pattern_supported(pattern: ProjectedExpressionNode): Bool ->
    pattern_children_supported(pattern.children).

pattern_children_supported(values: List[ProjectedExpressionNode]): Bool ->
    case values {
        [] -> true;
        [value | rest] -> shallow_pattern_supported(value) and pattern_children_supported(rest)
    }.

shallow_pattern_supported_tail(
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): Bool ->
    case rest {
        [] -> first.children == [];
        [second | tail] -> shallow_pattern_supported_pair(first, second, tail)
    }.

shallow_pattern_supported_pair(
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): Bool ->
    if {
        rest == [] -> first.children == [] and second.children == [];
        true -> false
    }.

pub shallow_pattern_operands(subject: String, pattern: ProjectedExpressionNode): List[String] ->
    [subject | ["pattern-v2" | pattern_operands(pattern)]].

pub binding_pattern(pattern: ProjectedExpressionNode): Bool ->
    pattern.kind == "binding-pattern"
        or typed_binding_pattern(pattern)
        or string_capture_binding(pattern)
        or implicit_binding_pattern(pattern).

string_capture_name(pattern: ProjectedExpressionNode): String ->
    case String.split(pattern.text, ":") {
        [name | _rest] -> String.trim(name);
        [] -> ""
    }.

string_capture_type(pattern: ProjectedExpressionNode): String ->
    case String.split(pattern.text, ":") {
        [_name, type_name] -> String.trim(type_name);
        [_name] -> "String";
        _ -> ""
    }.

string_capture_binding(pattern: ProjectedExpressionNode): Bool ->
    pattern.kind == "string-capture-segment"
        and string_capture_name(pattern) != ""
        and string_capture_name(pattern) != "_"
        and string_capture_type(pattern) != ""
        and binding_initial(string_capture_name(pattern).utf8_byte_at(0)).

typed_binding_pattern(pattern: ProjectedExpressionNode): Bool ->
    pattern.kind == "typed-pattern"
        and lambda_pattern_name(pattern) != ""
        and lambda_pattern_name(pattern) != "_"
        and lambda_pattern_type(pattern) != ""
        and binding_initial(lambda_pattern_name(pattern).utf8_byte_at(0)).

typed_wildcard_pattern(pattern: ProjectedExpressionNode): Bool ->
    pattern.kind == "typed-pattern"
        and lambda_pattern_name(pattern) == "_"
        and lambda_pattern_type(pattern) != "".

implicit_binding_pattern(pattern: ProjectedExpressionNode): Bool ->
    if {
        pattern.kind != "literal-pattern" -> false;
        pattern.text == "true" or pattern.text == "false" or pattern.text == "" -> false;
        true -> binding_initial(pattern.text.utf8_byte_at(0))
    }.

binding_initial(value: Int): Bool ->
    value == 95 or (value >= 97 and value <= 122).

pattern_ir_kind(pattern: ProjectedExpressionNode): String ->
    if {
        pattern.kind == "string-capture-segment" -> pattern.kind;
        binding_pattern(pattern) -> "binding-pattern";
        typed_wildcard_pattern(pattern) -> "wildcard-pattern";
        true -> pattern.kind
    }.

pattern_ir_text(pattern: ProjectedExpressionNode): String ->
    if {
        typed_binding_pattern(pattern) or typed_wildcard_pattern(pattern) ->
            lambda_pattern_name(pattern);
        true -> pattern.text
    }.

pattern_binding_name(pattern: ProjectedExpressionNode): String ->
    if {
        pattern.kind == "string-capture-segment" -> string_capture_name(pattern);
        true -> pattern_ir_text(pattern)
    }.

pattern_binding_type(
    pattern: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        pattern.kind == "string-capture-segment" -> Some(string_capture_type(pattern));
        pattern.kind == "typed-pattern" and lambda_pattern_type(pattern) != "" -> Some(lambda_pattern_type(pattern));
        true -> expression_type(pattern, facts, parameters)
    }.

list_element_type(value: String): String ->
    if {
        String.starts_with(value, "List[") and String.ends_with(value, "]") ->
            value.utf8_slice(5, value.byte_size() - 6);
        true -> "Dynamic"
    }.

pattern_child_source_type(kind: String, index: Int, source_type: String): String ->
    if {
        kind == "list-cons-pattern" and index == 0 -> list_element_type(source_type);
        kind == "list-cons-pattern" and index == 1 -> source_type;
        kind == "list-pattern" -> list_element_type(source_type);
        true -> "Dynamic"
    }.

resolved_pattern_binding_type(
    pattern: ProjectedExpressionNode,
    source_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case pattern_binding_type(pattern, facts, parameters) {
        Some(type_name) -> Some(type_name);
        None -> Some(source_type)
    }.

pattern_operands(pattern: ProjectedExpressionNode): List[String] ->
    concat(
        [pattern_ir_kind(pattern), pattern_ir_text(pattern), Int.to_string(pattern.children.length())],
        pattern_children_operands(pattern.children),
    ).

pattern_children_operands(values: List[ProjectedExpressionNode]): List[String] ->
    case values {
        [] -> List.new[String]();
        [value | rest] -> concat(pattern_operands(value), pattern_children_operands(rest))
    }.

shallow_pattern_operand_tail(
    subject: String,
    pattern: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): List[String] ->
    case rest {
        [] -> [subject, pattern.kind, pattern.text, "1", first.kind, first.text, "0"];
        [second | tail] -> shallow_pattern_operand_pair(subject, pattern, first, second, tail)
    }.

shallow_pattern_operand_pair(
    subject: String,
    pattern: ProjectedExpressionNode,
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
): List[String] ->
    if {
        rest == [] -> [
            subject,
            pattern.kind,
            pattern.text,
            "2",
            first.kind,
            first.text,
            "0",
            second.kind,
            second.text,
            "0",
        ];
        true -> List.new[String]()
    }.

shallow_binding(
    value: ProjectedExpressionNode,
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticInstructionPlan] ->
    if {
        binding_pattern(value) -> [
            SemanticInstructionPlan(
                "get-pattern-binding",
                some_string(pattern_binding_name(value)),
                [environment, Int.to_string(value.start_byte)],
                pattern_binding_type(value, facts, parameters),
            ),
        ];
        true -> List.new[SemanticInstructionPlan]()
    }.

struct IndexedPatternBindings {
    instructions: List[SemanticInstructionPlan],
    next_index: Int,
}.

constructor IndexedPatternBindings {
    (
        instructions: List[SemanticInstructionPlan],
        next_index: Int,
    ): IndexedPatternBindings -> IndexedPatternBindings {
        instructions: instructions,
        next_index: next_index,
    }
}.

indexed_binding(
    value: ProjectedExpressionNode,
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    index: Int,
    source_type: String,
    pattern_metadata: List[String],
): IndexedPatternBindings ->
    if {
        binding_pattern(value) -> IndexedPatternBindings(
            [SemanticInstructionPlan(
                "get-pattern-binding",
                some_string(pattern_binding_name(value)),
                concat(
                    [environment, Int.to_string(index), source_type],
                    pattern_metadata,
                ),
                resolved_pattern_binding_type(value, source_type, facts, parameters),
            )],
            index + 1,
        );
        true -> IndexedPatternBindings(List.new[SemanticInstructionPlan](), index)
    }.

indexed_pattern_bindings(
    pattern: ProjectedExpressionNode,
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    index: Int,
    source_type: String,
    pattern_metadata: List[String],
): IndexedPatternBindings ->
    let root = indexed_binding(
        pattern, environment, facts, parameters, index, source_type, pattern_metadata,
    );
    let children = indexed_pattern_children(
        pattern.children,
        pattern.kind,
        environment,
        facts,
        parameters,
        root.next_index,
        0,
        source_type,
        pattern_metadata,
    );
    IndexedPatternBindings(
        concat_instructions(root.instructions, children.instructions),
        children.next_index,
    ).

indexed_pattern_children(
    values: List[ProjectedExpressionNode],
    parent_kind: String,
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    index: Int,
    child_index: Int,
    source_type: String,
    pattern_metadata: List[String],
): IndexedPatternBindings ->
    case values {
        [] -> IndexedPatternBindings(List.new[SemanticInstructionPlan](), index);
        [value | rest] ->
            let first = indexed_pattern_bindings(
                value,
                environment,
                facts,
                parameters,
                index,
                pattern_child_source_type(parent_kind, child_index, source_type),
                pattern_metadata,
            );
            let remaining = indexed_pattern_children(
                rest,
                parent_kind,
                environment,
                facts,
                parameters,
                first.next_index,
                child_index + 1,
                source_type,
                pattern_metadata,
            );
            IndexedPatternBindings(
                concat_instructions(first.instructions, remaining.instructions),
                remaining.next_index,
            )
    }.

pub shallow_pattern_bindings(
    pattern: ProjectedExpressionNode,
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticInstructionPlan] ->
    indexed_pattern_bindings(
        pattern,
        environment,
        facts,
        parameters,
        0,
        case expression_type(pattern, facts, parameters) {
            Some(name) -> name;
            None -> "Dynamic"
        },
        pattern_operands(pattern),
    ).instructions.

pub shallow_pattern_bindings_with_source(
    pattern: ProjectedExpressionNode,
    environment: String,
    source_type: Option[String],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticInstructionPlan] ->
    indexed_pattern_bindings(
        pattern,
        environment,
        facts,
        parameters,
        0,
        case source_type { Some(name) -> name; None -> "Dynamic" },
        pattern_operands(pattern),
    ).instructions.

pattern_parameters_at(
    pattern: ProjectedExpressionNode,
    source_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[IrParameter] ->
    if {
        binding_pattern(pattern) -> case resolved_pattern_binding_type(pattern, source_type, facts, parameters) {
            Some(type_name) -> [IrParameter(pattern_binding_name(pattern), type_name)];
            None -> List.new[IrParameter]()
        };
        true -> pattern_child_parameters(
            pattern.children,
            pattern.kind,
            0,
            source_type,
            facts,
            parameters,
        )
    }.

pattern_child_parameters(
    values: List[ProjectedExpressionNode],
    parent_kind: String,
    child_index: Int,
    source_type: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[IrParameter] ->
    case values {
        [] -> List.new[IrParameter]();
        [value | rest] -> append_ir_parameters(
            pattern_parameters_at(
                value,
                pattern_child_source_type(parent_kind, child_index, source_type),
                facts,
                parameters,
            ),
            pattern_child_parameters(
                rest,
                parent_kind,
                child_index + 1,
                source_type,
                facts,
                parameters,
            ),
        )
    }.

pub pattern_parameters(
    pattern: ProjectedExpressionNode,
    source_type: Option[String],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[IrParameter] ->
    pattern_parameters_at(
        pattern,
        case source_type { Some(name) -> name; None -> "Dynamic" },
        facts,
        parameters,
    ).

pattern_children_bindings(
    values: List[ProjectedExpressionNode],
    environment: String,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): List[SemanticInstructionPlan] ->
    case values {
        [] -> List.new[SemanticInstructionPlan]();
        [value | rest] -> concat_instructions(
            shallow_pattern_bindings(value, environment, facts, parameters),
            pattern_children_bindings(rest, environment, facts, parameters),
        )
    }.

shallow_pattern_binding_tail(
    root: List[SemanticInstructionPlan],
    first: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
    environment: String,
): List[SemanticInstructionPlan] ->
    case rest {
        [] -> concat_instructions(root, shallow_binding(first, environment));
        [second | tail] -> shallow_pattern_binding_pair(root, first, second, tail, environment)
    }.

shallow_pattern_binding_pair(
    root: List[SemanticInstructionPlan],
    first: ProjectedExpressionNode,
    second: ProjectedExpressionNode,
    rest: List[ProjectedExpressionNode],
    environment: String,
): List[SemanticInstructionPlan] ->
    if {
        rest == [] -> concat_instructions(
            root,
            concat_instructions(
                shallow_binding(first, environment),
                shallow_binding(second, environment),
            ),
        );
        true -> List.new[SemanticInstructionPlan]()
    }.

pub node_size(node: ProjectedExpressionNode): Int ->
    1 + child_sizes(node.children).

child_sizes(values: List[ProjectedExpressionNode]): Int ->
    case values {
        [] -> 0;
        [value | rest] -> node_size(value) + child_sizes(rest)
    }.

pub register(node_id: Int): String ->
    String.append("%", Int.to_string(node_id)).

pub indexed_label(prefix: String, index: Int): String ->
    String.append(prefix, Int.to_string(index)).

fact_type(byte_offset: Int, values: List[InferredTypeFact]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> select_fact_type(byte_offset, value, rest)
    }.

select_fact_type(
    byte_offset: Int,
    value: InferredTypeFact,
    rest: List[InferredTypeFact],
): Option[String] ->
    if {
        value.byte_offset == byte_offset -> case value.type_name {
            Some(name) -> Some(name);
            None -> fact_type(byte_offset, rest)
        };
        true -> fact_type(byte_offset, rest)
    }.

parameter_type(name: String, values: List[IrParameter]): Option[String] ->
    case values {
        [] -> None;
        [value | rest] -> select_parameter_type(name, value, rest)
    }.

select_parameter_type(name: String, value: IrParameter, rest: List[IrParameter]): Option[String] ->
    if {
        value.name == name -> Some(value.type_name);
        true -> parameter_type(name, rest)
    }.

pub some_string(value: String): Option[String] ->
    Some(value).

pub none_string(): Option[String] ->
    None.

pub resolved_or_dynamic(value: Option[String]): Option[String] ->
    value.

last_expression_type(
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case values {
        [] -> none_string();
        [value] -> expression_type(value, facts, parameters);
        [_ | rest] -> last_expression_type(rest, facts, parameters)
    }.

pub expression_type(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        String.starts_with(node.text, "$type:") -> Some(String.utf8_slice(
            node.text,
            6,
            String.byte_size(node.text) - 6,
        ));
        node.kind == "identifier" or node.kind == "atom" or node.kind == "binding" or node.kind == "primary" -> case parameter_type(node.text, parameters) {
            Some(name) -> Some(name);
            None -> case fact_type(node.start_byte, facts) {
                Some(name) -> Some(name);
                None -> expression_type_without_fact(node, facts, parameters)
            }
        };
        true -> case fact_type(node.start_byte, facts) {
            Some(name) -> some_string(name);
            None -> expression_type_without_fact(node, facts, parameters)
        }
    }.

expression_type_without_fact(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "identifier" or node.kind == "atom" or node.kind == "binding" -> expression_identifier_type(node.text, parameters);
        true -> expression_type_after_identifier(node, facts, parameters)
    }.

expression_identifier_type(text: String, parameters: List[IrParameter]): Option[String] ->
    case parameter_type(text, parameters) {
        Some(name) -> some_string(name);
        None -> none_string()
    }.

expression_type_after_identifier(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "atom-literal" -> some_string("Atom");
        true -> expression_type_after_atom_literal(node, facts, parameters)
    }.

expression_type_after_atom_literal(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "integer" -> some_string("Int");
        true -> expression_type_after_integer(node, facts, parameters)
    }.

expression_type_after_integer(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "float" -> some_string("Float");
        true -> expression_type_after_float(node, facts, parameters)
    }.

expression_type_after_float(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "string" -> some_string("String");
        true -> expression_type_after_string(node, facts, parameters)
    }.

expression_type_after_string(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "constructor" -> some_string(node.text);
        true -> expression_type_after_constructor(node, facts, parameters)
    }.

expression_type_after_constructor(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "primary" and (node.text == "true" or node.text == "false") -> some_string("Bool");
        node.kind == "primary" and String.starts_with(node.text, "\"") -> some_string("String");
        node.kind == "primary" and Int.from_string(node.text) != None -> some_string("Int");
        node.kind == "primary" and Float.from_string(node.text) != None -> some_string("Float");
        true -> expression_type_after_boolean(node, facts, parameters)
    }.

expression_type_after_boolean(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "primary" -> none_string();
        true -> expression_type_after_primary(node, facts, parameters)
    }.

expression_type_after_primary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "call" or node.kind == "field" or node.kind == "index" -> none_string();
        true -> expression_type_after_dynamic(node, facts, parameters)
    }.

expression_type_after_dynamic(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "list" or node.kind == "list-cons" or node.kind == "list-comprehension" -> some_string("List");
        true -> expression_type_after_list(node, facts, parameters)
    }.

expression_type_after_list(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "tuple" -> some_string("Tuple");
        true -> expression_type_after_tuple(node, facts, parameters)
    }.

expression_type_after_tuple(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "tuple-or-group" -> tuple_or_group_type(node, facts, parameters);
        true -> expression_type_after_group(node, facts, parameters)
    }.

tuple_or_group_type(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.children.length() == 1 -> last_expression_type(node.children, facts, parameters);
        true -> some_string("Tuple")
    }.

expression_type_after_group(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "cast" -> some_string(node.text);
        true -> expression_type_after_cast(node, facts, parameters)
    }.

expression_type_after_cast(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "sequence"
            or node.kind == "call-arguments"
            or node.kind == "named-argument"
            or node.kind == "let"
            or node.kind == "let-refutable" -> last_expression_type(node.children, facts, parameters);
        node.kind == "if" -> branch_expression_types(node.children, facts, parameters, None);
        node.kind == "case" -> case_expression_type(node.children, facts, parameters);
        true -> expression_type_after_structural(node, facts, parameters)
    }.

clause_expression_type(
    value: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        value.kind == "clause" -> last_expression_type(value.children, facts, parameters);
        true -> expression_type(value, facts, parameters)
    }.

merge_expression_type(current: Option[String], next: Option[String]): Option[String] ->
    case current {
        None -> next;
        Some(current_name) -> case next {
            Some(next_name) where current_name == next_name -> Some(current_name);
            Some(next_name) where String.starts_with(current_name, String.append(next_name, "[")) -> Some(current_name);
            Some(next_name) where String.starts_with(next_name, String.append(current_name, "[")) -> Some(next_name);
            _ -> None
        }
    }.

branch_expression_types(
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
    current: Option[String],
): Option[String] ->
    case values {
        [] -> current;
        [value | rest] -> branch_expression_types(
            rest,
            facts,
            parameters,
            merge_expression_type(current, clause_expression_type(value, facts, parameters)),
        )
    }.

case_expression_type(
    values: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case values {
        [] -> None;
        [_subject | clauses] -> branch_expression_types(clauses, facts, parameters, None)
    }.

expression_type_after_structural(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "binary" and boolean_binary_operator(node.text) -> some_string("Bool");
        true -> expression_type_after_boolean_binary(node, facts, parameters)
    }.

boolean_binary_operator(operator: String): Bool ->
    operator == "=="
        or operator == "!="
        or operator == "<"
        or operator == ">"
        or operator == "<="
        or operator == ">="
        or operator == "in"
        or operator == "and"
        or operator == "or".

expression_type_after_boolean_binary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "binary" -> binary_expression_type(node.children, facts, parameters);
        true -> expression_type_after_binary(node, facts, parameters)
    }.

binary_expression_type(
    children: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case children {
        [left, right] ->
            binary_expression_type_from_left(
                expression_type(left, facts, parameters),
                right,
                facts,
                parameters,
            );
        _ -> none_string()
    }.

binary_expression_type_from_left(
    left_type: Option[String],
    right: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case left_type {
        Some(left_name) ->
            matching_expression_type(left_name, expression_type(right, facts, parameters));
        None -> none_string()
    }.

matching_expression_type(left_name: String, right_type: Option[String]): Option[String] ->
    case right_type {
        Some(right_name) where left_name == right_name -> some_string(left_name);
        _ -> none_string()
    }.

expression_type_after_binary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "unary" and (node.text == "not" or node.text == "!") -> some_string("Bool");
        true -> expression_type_after_boolean_unary(node, facts, parameters)
    }.

expression_type_after_boolean_unary(
    node: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    if {
        node.kind == "unary" -> unary_expression_type(node.children, facts, parameters);
        true -> none_string()
    }.

unary_expression_type(
    children: List[ProjectedExpressionNode],
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case children {
        [operand] -> expression_type(operand, facts, parameters);
        _ -> none_string()
    }.

pub last_string(values: List[String]): String ->
    case values {
        [] -> "";
        [value] -> value;
        [_ | rest] -> last_string(rest)
    }.

binary_opcode(text: String): String ->
    if {
        text == "+" -> "add-small";
        true -> binary_sub_opcode(text)
    }.

binary_sub_opcode(text: String): String ->
    if {
        text == "-" -> "sub-small";
        true -> binary_mul_opcode(text)
    }.

binary_mul_opcode(text: String): String ->
    if {
        text == "*" -> "mul-small";
        true -> binary_div_opcode(text)
    }.

binary_div_opcode(text: String): String ->
    if {
        text == "/" or text == "div" -> "div-small";
        true -> binary_rem_opcode(text)
    }.

binary_rem_opcode(text: String): String ->
    if {
        text == "rem" -> "rem-small";
        true -> binary_equal_opcode(text)
    }.

binary_equal_opcode(text: String): String ->
    if {
        text == "==" -> "equal";
        true -> binary_less_opcode(text)
    }.

binary_less_opcode(text: String): String ->
    if {
        text == "<" -> "less-small";
        true -> String.append("binary-", text)
    }.

pub node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "integer"
            or node.kind == "float"
            or node.kind == "string"
            or node.kind == "atom-literal"
            or node.kind == "constructor"
            or node.kind == "primary" and (node.text == "true" or node.text == "false") ->
            "load-literal";
        true -> move_node_opcode(node)
    }.

move_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "identifier" or node.kind == "atom" or node.kind == "binding" or node.kind == "primary" -> "move";
        true -> binary_node_opcode(node)
    }.

binary_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "binary" -> binary_opcode(node.text);
        true -> negative_node_opcode(node)
    }.

negative_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "unary" and node.text == "-" -> "neg-small";
        true -> unary_node_opcode(node)
    }.

unary_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "unary" -> String.append("unary-", node.text);
        true -> list_node_opcode(node)
    }.

list_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "list" -> "put-list";
        node.kind == "list-cons" -> "put-list-cons";
        node.kind == "list-comprehension" -> "unsupported-list-comprehension";
        true -> tuple_node_opcode(node)
    }.

tuple_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "tuple-or-group" or node.kind == "tuple" -> "put-tuple";
        true -> field_node_opcode(node)
    }.

field_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "field" -> "get-map-elements";
        true -> index_node_opcode(node)
    }.

index_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "index" -> "get-tuple-element";
        true -> cast_node_opcode(node)
    }.

cast_node_opcode(node: ProjectedExpressionNode): String ->
    if {
        node.kind == "cast" -> "move";
        true -> String.append("unsupported-", node.kind)
    }.

pub literal_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "integer"
            or node.kind == "float"
            or node.kind == "string"
            or node.kind == "atom-literal"
            or node.kind == "atom"
            or node.kind == "constructor"
            or node.kind == "primary" -> [node.text];
        true -> identifier_operands(node)
    }.

identifier_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "identifier" or node.kind == "binding" -> [node.text];
        true -> field_operands(node)
    }.

field_operands(node: ProjectedExpressionNode): List[String] ->
    if {
        node.kind == "field" -> [node.text];
        true -> List.new[String]()
    }.

pub parameter(value: ParameterSyntax): IrParameter ->
    IrParameter(value.name, parameter_annotation_type(value)).

parameter_annotation_type(value: ParameterSyntax): String ->
    if {
        value.has_annotation and value.annotation.valid -> value.annotation.syntax.text;
        true -> ""
    }.

pub resolved_return(declared: String, inferred: Option[String]): Option[String] ->
    if {
        declared == "" -> resolved_or_dynamic(inferred);
        true -> some_string(declared)
    }.

pub body_for(name: String, values: List[ProjectedBody]): Option[ProjectedBody] ->
    case values {
        [] -> None;
        [value | rest] -> select_body(name, value, rest)
    }.

select_body(
    name: String,
    value: ProjectedBody,
    rest: List[ProjectedBody],
): Option[ProjectedBody] ->
    let direct = String.append(name, "(");
    let qualified = String.append(" ", direct);
    if {
        String.starts_with(value.declaration_head, direct)
            or String.contains(value.declaration_head, qualified) -> Some(value);
        true -> body_for(name, rest)
    }.

pub nested_if_result_type(
    source: ProjectedExpressionNode,
    first: ExpressionPlan,
    second: ExpressionPlan,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case first.result_type {
        Some(first_name) ->
            nested_if_second_result_type(first_name, second.result_type, source, facts, parameters);
        None -> resolved_or_dynamic(expression_type(source, facts, parameters))
    }.

nested_if_second_result_type(
    first_name: String,
    second_type: Option[String],
    source: ProjectedExpressionNode,
    facts: List[InferredTypeFact],
    parameters: List[IrParameter],
): Option[String] ->
    case second_type {
        Some(second_name) where first_name == second_name -> some_string(first_name);
        _ -> resolved_or_dynamic(expression_type(source, facts, parameters))
    }.
