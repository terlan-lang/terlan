/** Positive and negative import-lowering contracts. */
module self_host.ImportLoweringTest.


import std.core.Option.{None, Option}.
import self_host.ImportSyntax.{FileImport, ModuleImport}.


import std.collections.List.
import self_host.DeclarationLowering.
import self_host.ImportLowering.
import self_host.Parser.

@pure
positive_imports(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface(
        "module demo.Imports.\nimport type std.core.Result.\nimport std.core.Option.{Some as Present, None}.\nimport file \"./schema.json\" as Schema.\n",
    ));
    case lowered_module.declarations {
        [type_import_decl, selected_decl, asset_decl] ->
            let type_import = ImportLowering.lower(type_import_decl);
            let selected = ImportLowering.lower(selected_decl);
            let asset = ImportLowering.lower(asset_decl);
            type_import.valid
                and type_import.kind == ModuleImport
                and type_import.is_type
                and type_import.module_name == "std.core.Result"
                and selected.valid
                and selected.is_selected
                and List.length(selected.items) == 2
                and asset.valid
                and asset.kind == FileImport
                and asset.source_path == "./schema.json"
                and asset.alias == "Schema";
        _ -> false
    }.

@pure
negative_import(): Bool ->
    let lowered_module = DeclarationLowering.lower(Parser.parse_surface("module demo.Imports.\nimport file \"./schema.json\".\n"));
    case lowered_module.declarations { [declaration] -> not ImportLowering.lower(declaration).valid; _ -> false }.

pub self_test(): Bool -> positive_imports() and negative_import().

