/** Resolved callable argument type contracts. */
module self_host.ProjectedCallableArgumentTypecheckTest.

import self_host.ProjectedCallableArgumentTypecheck.
import self_host.ProjectedCallableSyntax.{CallableDeclaration, CallableResolution, CallableUse, ResolvedCallableUse}.
import self_host.ProjectedTypeConstraintSyntax.{InferredTypeFact, TypeConstraintResolution}.
import std.collections.List.
import std.core.Option.{None, Some}.

@pure
resolution(parameters: List[String], expected: List[Option[String]]): CallableResolution ->
    let declaration = CallableDeclaration("test", "call", 2, "function", parameters, expected, Some("Unit"), 0);
    let use_site = CallableUse(None, "call", 2, [10, 20], 5);
    CallableResolution([ResolvedCallableUse(use_site, Some(declaration))], []).

@pure
facts(left: String, right: String): TypeConstraintResolution ->
    TypeConstraintResolution([
        InferredTypeFact(1, Some(left), 10),
        InferredTypeFact(2, Some(right), 20),
    ], []).

@pure
identified_resolution(): CallableResolution ->
    let declaration = CallableDeclaration("test", "call", 2, "function", List.new[String](), [Some("String"), Some("Int")], Some("Unit"), 0);
    let use_site = CallableUse(None, "call", 2, [10, 10], 5, 9, [2, 3]);
    CallableResolution([ResolvedCallableUse(use_site, Some(declaration))], []).

@pure
concrete_mismatch_is_rejected(): Bool ->
    ProjectedCallableArgumentTypecheck.check(
        resolution(List.new[String](), [Some("String"), Some("Bool")]),
        facts("String", "Int"),
    ).diagnostics.length() == 1.

@pure
repeated_generic_must_unify(): Bool ->
    ProjectedCallableArgumentTypecheck.check(
        resolution(["Value"], [Some("Value"), Some("Value")]),
        facts("String", "Int"),
    ).diagnostics.length() == 1.

@pure
matching_arguments_pass(): Bool ->
    ProjectedCallableArgumentTypecheck.check(
        resolution(List.new[String](), [Some("String"), Some("Int")]),
        facts("String", "Int"),
    ).diagnostics == [].

@pure
outer_expression_fact_wins_shared_byte_offset(): Bool ->
    ProjectedCallableArgumentTypecheck.check(
        resolution(List.new[String](), [Some("String"), Some("Int")]),
        TypeConstraintResolution([
            InferredTypeFact(1, Some("String"), 10),
            InferredTypeFact(2, Some("Int"), 10),
            InferredTypeFact(3, Some("Int"), 20),
        ], []),
    ).diagnostics == [].

@pure
node_identity_disambiguates_shared_byte_offsets(): Bool ->
    ProjectedCallableArgumentTypecheck.check(
        identified_resolution(),
        TypeConstraintResolution([
            InferredTypeFact(1, Some("Bool"), 10),
            InferredTypeFact(2, Some("String"), 10),
            InferredTypeFact(3, Some("Int"), 10),
        ], []),
    ).diagnostics == [].

pub self_test(): Bool ->
    concrete_mismatch_is_rejected()
        and repeated_generic_must_unify()
        and matching_arguments_pass()
        and outer_expression_fact_wins_shared_byte_offset()
        and node_identity_disambiguates_shared_byte_offsets().
