/**
 * Stable signature/type declaration evidence for parser parity.
 */
module self_host.ProjectedSignatureEvidence.

import self_host.ProjectedExpressionSyntax.{ProjectedExpressionNode}.
import self_host.ProjectedSignatureSyntax.{ProjectedCallableSignature, ProjectedParameterTree, ProjectedSignatureDocument, ProjectedTypeDeclarationTree}.
import self_host.ProjectedTypeRender.
import self_host.ProjectedTypeSyntax.{ProjectedTypeNode}.
import std.collections.List.
import std.core.Option.{None, Option, Some}.
import std.core.{Int, String}.

@pure
callable_row(value: ProjectedCallableSignature): String ->
    String.concat(
        [
            "callable\t",
            value.declaration_head,
            "\t",
            Int.to_string(List.length(value.parameters)),
            "\t",
            if {
                value.valid -> "valid";
                true -> "invalid"
            },
            "\n",
        ],
    ).

@pure
callable_rows(values: List[ProjectedCallableSignature]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.append(callable_row(value), callable_rows(rest))
    }.

@pure
type_row(value: ProjectedTypeDeclarationTree): String ->
    String.concat(
        [
            "type\t",
            value.declaration_head,
            "\t",
            if {
                value.is_opaque -> "opaque";
                true -> "transparent"
            },
            "\t",
            if {
                value.valid -> "valid";
                true -> "invalid"
            },
            "\n",
        ],
    ).

@pure
type_rows(values: List[ProjectedTypeDeclarationTree]): String ->
    case values {
        [] -> "";
        [value | rest] -> String.append(type_row(value), type_rows(rest))
    }.

@pure
pub document(value: ProjectedSignatureDocument): String ->
    String.concat(
        [
            "schema terlan.self-host.signatures/v1\nvalid\t",
            if {
                value.valid -> "true";
                true -> "false"
            },
            "\nkind\thead\tshape\tstatus\n",
            callable_rows(value.callables),
            type_rows(value.types),
        ],
    ).

@pure
pattern_kind(value: Option[ProjectedExpressionNode]): String ->
    case value {
        None -> "";
        Some(node) -> node.kind
    }.

@pure
pattern_text(value: Option[ProjectedExpressionNode]): String ->
    case value {
        None -> "";
        Some(node) -> node.text
    }.

@pure
annotation_kind(value: Option[ProjectedTypeNode]): String ->
    case value {
        None -> "";
        Some(node) -> node.kind
    }.

@pure
annotation_text(value: Option[ProjectedTypeNode]): String ->
    case value {
        None -> "";
        Some(node) -> ProjectedTypeRender.render(node)
    }.

@pure
annotation_arity(value: Option[ProjectedTypeNode]): Int ->
    case value {
        None -> 0;
        Some(node) -> node.children.length()
    }.

@pure
parameter_rows_for(callable_name: String, values: List[ProjectedParameterTree]): String ->
    case values {
        [] -> "";
        [value | rest] ->
            String.concat(
                [
                    "parameter\t",
                    callable_name,
                    "\t",
                    pattern_kind(value.pattern),
                    "\t",
                    pattern_text(value.pattern),
                    "\t",
                    annotation_kind(value.annotation),
                    "\t",
                    annotation_text(value.annotation),
                    "\t",
                    Int.to_string(annotation_arity(value.annotation)),
                    "\n",
                    parameter_rows_for(callable_name, rest),
                ],
            )
    }.

@pure
parameter_rows(values: List[ProjectedCallableSignature]): String ->
    case values {
        [] -> "";
        [value | rest] ->
            String.append(parameter_rows_for(value.name, value.parameters), parameter_rows(rest))
    }.

/**
 * Renders callable-owned parameter details without positional catalog joins.
 */
@pure
pub details(value: ProjectedSignatureDocument): String ->
    String.concat(
        [
            "schema terlan.self-host.signature-details/v1\n",
            "kind\tcallable\tpattern_kind\tpattern_text\ttype_kind\ttype_text\ttype_children\n",
            parameter_rows(value.callables),
        ],
    ).
